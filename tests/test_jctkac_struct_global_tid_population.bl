// A top-level struct global was registered through set_var_struct with the mono
// carrier (Box_Int) on the flat sname channel but no type id, so every field
// read on the global recovered the carrier through the flat sname alone. The
// top-level-let struct/enum branch now also stamps a generic struct instance
// global's tid (guarded to the reader's mono-name round-trip, and excluding
// enums), so sv_struct_tid_first recovers the instance from the tid. This is a
// tid-population step: the emitted C is unchanged; the tests guard that a struct
// global still resolves its field access across the generic-instance,
// two-param, and plain shapes.
type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }
type Q { x: Int }

let g_box: Box[Int] = Box { value: 7 }
let g_pair: Pair[Int, Int] = Pair { first: 3, second: 9 }
let g_q: Q = Q { x: 5 }

test "generic struct instance global resolves field access" {
    assert_eq(g_box.value, 7)
}

test "two-param generic struct instance global resolves both fields" {
    assert_eq(g_pair.first, 3)
    assert_eq(g_pair.second, 9)
}

test "plain struct global still resolves field access" {
    assert_eq(g_q.x, 5)
}
