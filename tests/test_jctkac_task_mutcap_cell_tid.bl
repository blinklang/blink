// jctkac: the async.spawn task-body emitter declared a mutable-capture cell from the raw
// flat kind (c_type_str(tp_get_kind(cap.tp_id))). The flat kind cannot name an aggregate —
// c_type_str(CT_STRUCT) is "void", and a data enum lowers to a struct too — so a task that
// mutably captured a struct or a data enum declared a `void* cell` and its body deref
// (`(*cell).field`, or passing `*cell` to a fn) failed to compile. Spell the cell through the
// tid-first capture_cell_c_type, the same channel the closure-body mut-cap emitter already
// uses, so the cell carries the real nominal type.

type Point { x: Int, y: Int }

type Shape { Circle(Int), Square(Int) }

fn area(s: Shape) -> Int {
    match s {
        Circle(r) => r * r
        Square(w) => w * w * 2
    }
}

test "spawn mutably capturing a struct types the cell by the tid" {
    let mut p = Point { x: 1, y: 2 }
    let h = async.spawn(fn() {
        p = Point { x: 10, y: 20 }
        p.x + p.y
    })
    assert_eq(h.await, 30)
}

test "spawn mutably capturing a data enum types the cell by the tid" {
    let mut s = Circle(5)
    let h = async.spawn(fn() {
        s = Square(3)
        area(s)
    })
    assert_eq(h.await, 18)
}
