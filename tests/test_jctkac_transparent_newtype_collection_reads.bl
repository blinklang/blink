// Every collection READ of a transparent-newtype value (`Errno`, the language's only one)
// must materialize the value BY VALUE as a bare int64_t — never as a struct-pointer cast or
// a struct deref. Errno lowers to a bare int64_t and is stored inline in a list/map slot, so
// its Option carrier's `.value`, a for-in binder, and a for-(k,v) tuple field are all scalar.
// Reading the inline scalar through `({c_type_c_name(X)}*)` (a struct pointer) or
// `*({c_type_c_name(X)}*)` (a struct deref) is invalid C. The nominal Errno identity for a
// body `match e { Errno(rc) => }` still rides the enum/tid channel — only the C read differs.
// Sibling shapes of the Map.get transparent-value fix (same defect class, different read
// sites: List.get, List.pop, for-in over List/Set, m.values(), for-(k,v) over a Map).
// Written in the corpus so the shapes are the real self-hosted build, not a compile_and_run
// string (feedback_corpus_sweep_is_not_coverage).

import std.errno.{Errno}

test "a List[Errno] reads a transparent element back through get()" {
    let xs: List[Errno] = [Errno(5), Errno(9)]
    let e = xs.get(0).unwrap()
    let ra = match e { Errno(rc) => rc }
    assert_eq(ra, 5)
    let f = xs.get(1).unwrap()
    let rb = match f { Errno(rc) => rc }
    assert_eq(rb, 9)
}

test "a List[Errno] reads a transparent element back through pop()" {
    let mut xs: List[Errno] = [Errno(3), Errno(7)]
    let last = xs.pop().unwrap()
    let rl = match last { Errno(rc) => rc }
    assert_eq(rl, 7)
    let first = xs.pop().unwrap()
    let rf = match first { Errno(rc) => rc }
    assert_eq(rf, 3)
}

test "a for-in over a List[Errno] binds each transparent element by value" {
    let xs: List[Errno] = [Errno(1), Errno(2), Errno(4)]
    let mut sum = 0
    for e in xs {
        let rc = match e { Errno(code) => code }
        sum = sum + rc
    }
    assert_eq(sum, 7)
}

test "m.values() over a Map[Str, Errno] iterates transparent values by value" {
    let mut m: Map[Str, Errno] = Map()
    m.insert("a", Errno(6))
    m.insert("b", Errno(8))
    let mut sum = 0
    for v in m.values() {
        let rc = match v { Errno(code) => code }
        sum = sum + rc
    }
    assert_eq(sum, 14)
}
