// A tuple-typed variable's carrier name (Tuple2_int_int) must be spelled from the
// var's own tid via tc_tid_tuple_sname, so sv_struct_tid_first / get_list_elem_struct
// lead with the tid instead of the flat sname / sname2 channel. tc_tid_struct declines
// tuples (Struct/Enum-only), so before this a tuple var always fell to flat; the tuple
// arm uses the DEDICATED tuple speller (full carrier name, NOT tid_inner_struct's bare
// Tuple2 tag — the map-value /cr trap). Covers a plain int tuple, a tuple with a struct
// element, and a list of tuples, read back via .0/.1 field access and for-in. The change
// is emit-C byte-identical corpus-wide, so this is a behavioral guard that the tuple
// carrier name survives the tid path, not a channel-attribution test. Guards the tuple
// reader arm of the tid-sole-authority migration.

type TPoint { x: Int, y: Int }

fn int_tuple_fields() -> Int {
    let p: (Int, Int) = (3, 4)
    p.0 + p.1
}

fn struct_elem_tuple() -> Int {
    let p: (TPoint, Int) = (TPoint { x: 5, y: 6 }, 7)
    let a = p.0
    a.x + a.y + p.1
}

fn list_of_tuples() -> Int {
    let mut xs: List[(Int, Int)] = []
    xs.push((10, 20))
    xs.push((1, 2))
    let mut acc = 0
    for t in xs {
        acc = acc + t.0 + t.1
    }
    acc
}

test "int tuple var names its carrier via the tid on field access" {
    assert_eq(int_tuple_fields(), 7)
}

test "struct-element tuple var names its carrier via the tid" {
    assert_eq(struct_elem_tuple(), 18)
}

test "list of tuples names its element carrier via the tid on for-in" {
    assert_eq(list_of_tuples(), 33)
}
