// Bug jkdywb: an inline-keyed Set[Int]/Map[Int,_] reached through a generic-
// tuple element (or a struct field) lost its inner element/key type at the
// tuple boundary. resolve_tuple_ann type-erased the element to a bare
// "set"/"map" tag (is_compound_ct excludes CT_SET; the CT_MAP else-branch
// emits bare "map"), and the read block in emit_expr never re-recorded the
// element/key CT on expr_result_str. Downstream emit_set_method/emit_map_method
// then defaulted the key type to CT_STRING, so kops_is_inline_key returned 0
// and `t.0.contains(3)` / `t.0.get(5)` emitted a BARE int to
// blink_set_contains/blink_map_get(const void*) — C error "makes pointer from
// integer without a cast". Str keys were unaffected (already pointer-shaped).
//
// The fix threads the element type from typecheck's node->tid memo
// (tc_lookup_node_tid) rather than the type-erased tuple carrier: the carrier
// name is SHARED across monomorphizations ((Set[Int],Int) and (Set[Str],Int)
// compile to the same blink_Tuple2_set_int), so the inner type CANNOT live on
// any carrier-keyed structure — only the per-node tid holds it. The read block
// now calls set_set_elem_type/set_map_types with the CT recovered from the tid.
//
// Red before the fix (all six cases fail at cc); green after. The Str-keyed
// cases prove the default path stays undisturbed. The collision case guards
// against a future regression to a carrier-keyed fix.

type NineBox { n: Int }
type SetField { s: Set[Int] }
type MapVField { m: Map[Int, NineBox] }

@derive(Hash, Eq)
type Point { x: Int, y: Int }

// Bug vbhc4x: a Set[T]/Map[K,_] element reached through a GENERIC-STRUCT field
// (typecheck does not monomorphize struct instances, so the FieldAccess tid is
// Set[<typevar>]) lost its element/key type — the field access defaulted to
// CT_STRING, so an int/struct element boxed through the wrong kops table and
// emitted a bare int to blink_set_contains(const void*). The concrete Int lives
// ONLY on the method-argument node's memoized tid (insert(3) → 3 infers TYPE_INT);
// codegen recovers it via tc_lookup_node_tid on the arg (recover_elem_ct_from_arg),
// gated on "still the erased default" so Set[Str]/concrete Set[Int] are untouched.
//
// FLOOR PROBE (nqq29j): the vbhc4x cases are also a type-IDENTITY guard — they
// already passed at runtime while GBoxSet[Int]/[Str]/[Point] all collapsed onto one
// blink_GBoxSet_Void typedef (and GBoxMap onto blink_GBoxMap_Void). Expected _Void
// count for this file:
//   blink build --emit c tests/test_jkdywb_tuple_inline_container.bl -o .tmp/f
//   grep -c '_Void' .tmp/f.c
// must be 0 (was 14); they now spell GBoxSet_Int / _Str / _Point and GBoxMap_Int.
// Set[Point] is the bare-struct slot case: tc_struct_slot_encodable's TK_STRUCT/TK_ENUM
// arm (src/typecheck.bl:11253-11266) admits it because tc_tid_to_c_tag spells a bare
// struct exactly as the string path does. Grep _Void:
// the retired csvresolve channel was only a lower bound — GBoxSet_Void was emitted with
// ZERO hits on it. GBoxMap[K] here was also one of the last two string-CSV holdouts,
// closed by resolving the bound-metavar slot in mono_instance_arg_tids_from_tid.
type GBoxSet[T] { s: Set[T] }
type GBoxMap[K] { m: Map[K, NineBox] }

fn wrap[T](x: T) -> (T, Int) { (x, 1) }

fn make_set() -> (Set[Int], Int) {
    let mut s: Set[Int] = Set()
    s.insert(3)
    (s, 1)
}

test "generic-tuple Set[Int] preserves inner key through tuple boundary" {
    let mut s: Set[Int] = Set()
    s.insert(3)
    let t = wrap(s)
    assert(t.0.contains(3))
    assert(!t.0.contains(9))
}

test "generic-tuple Map[Int,Str] preserves inner key through tuple boundary" {
    let m: Map[Int, Str] = Map()
    m.insert(5, "five")
    let t = wrap(m)
    assert_eq(t.0.get(5).unwrap(), "five")
}

test "spelled (Set[Int], Int) preserves inner key through tuple boundary" {
    let t = make_set()
    assert(t.0.contains(3))
}

test "generic-tuple Map[Int,Struct] threads value struct through tuple boundary" {
    let m: Map[Int, NineBox] = Map()
    m.insert(5, NineBox { n: 9 })
    let t = wrap(m)
    assert_eq(t.0.get(5).unwrap().n, 9)
}

test "struct-field Set[Int] preserves inner key" {
    let mut b = SetField { s: Set() }
    b.s.insert(3)
    assert(b.s.contains(3))
    assert(!b.s.contains(9))
}

test "struct-field Map[Int,Struct] preserves inner key (sibling, already worked)" {
    let b = MapVField { m: Map() }
    b.m.insert(5, NineBox { n: 9 })
    assert_eq(b.m.get(5).unwrap().n, 9)
}

test "carrier collision: (Set[Int],Int) and (Set[Str],Int) keep distinct inner types" {
    let mut si: Set[Int] = Set()
    si.insert(3)
    let mut ss: Set[Str] = Set()
    ss.insert("x")
    let ti = wrap(si)
    let ts = wrap(ss)
    assert(ti.0.contains(3))
    assert(ts.0.contains("x"))
}

test "string-keyed Set stays undisturbed (default path)" {
    let mut s: Set[Str] = Set()
    s.insert("x")
    let t = wrap(s)
    assert(t.0.contains("x"))
}

// The following two threaded a struct inner (not just a scalar) through the
// tuple boundary. Recovering the struct NAME (not just the CT) via the tid
// memo — set_set_elem_struct for the Set element, set_map_key_struct for the
// Map key — is what makes the kops table resolve. Added when a code review
// found the CT_MAP branch dropped the key struct name (jkdywb review pass).
test "generic-tuple Set[Struct] threads element struct through tuple boundary" {
    let mut s: Set[Point] = Set()
    s.insert(Point { x: 1, y: 2 })
    let t = wrap(s)
    assert(t.0.contains(Point { x: 1, y: 2 }))
    assert(!t.0.contains(Point { x: 9, y: 9 }))
}

test "generic-tuple Map[Struct,V] threads key struct through tuple boundary" {
    let m: Map[Point, Int] = Map()
    m.insert(Point { x: 1, y: 2 }, 9)
    let t = wrap(m)
    assert_eq(t.0.get(Point { x: 1, y: 2 }).unwrap(), 9)
}

// ---- vbhc4x: generic-struct field Set/Map element recovery from arg tid ----

test "vbhc4x generic-struct Set[Int] recovers Int elem from insert arg" {
    let mut b = GBoxSet { s: Set() }
    b.s.insert(3)
    assert(b.s.contains(3))
    assert(!b.s.contains(9))
}

test "vbhc4x generic-struct Map[Int,Struct] recovers Int key from insert arg" {
    let b = GBoxMap { m: Map() }
    b.m.insert(5, NineBox { n: 9 })
    assert(b.m.contains_key(5))
    assert_eq(b.m.get(5).unwrap().n, 9)
}

test "vbhc4x generic-struct Set[Point] recovers struct elem via tc_tid_struct" {
    let mut b = GBoxSet { s: Set() }
    b.s.insert(Point { x: 1, y: 2 })
    assert(b.s.contains(Point { x: 1, y: 2 }))
    assert(!b.s.contains(Point { x: 9, y: 9 }))
}

// ---- xskbvh: pin the mono-key collapse the tid path must not read identity out of ----
//
// `wrap[T]` is instantiated here at Set[Int], Set[Str] and Set[Point]. tc_tid_to_c_tag
// erases a container's type arguments (TK_SET -> bare "Set"), so all three spell the same
// CSV segment and share ONE mono registry entry, "wrap"/"Set" — and that sharing is CORRECT,
// because all three ARE blink_set* and emit ONE C function (blink_wrap_Set). What the shared
// entry cannot carry is per-instantiation type identity: its single stored arg_tids holds one
// of the three element tids, and the other two instantiations would box through the wrong
// kops table if any consumer read that slot as identity. This file IS the measured DIFF-TYPE
// population — all 18 monodedup slot-conflict-class DIFF-TYPE rows on the corpus are here
// (the pins below account for 8 of them; rows come in pairs because register_mono_fn and
// register_mono_instance both join the same key):
//
//   BLINK_TRACE_CHANNELS=monodedup build/blink build --emit c \
//       tests/test_jkdywb_tuple_inline_container.bl 2>&1 | grep slot-conflict-class
//
// tc_tid_seg_injective is the predicate that refuses such a slot (false for TK_SET/TK_MAP/
// TK_LIST/...), and br qnpb2d — which makes tid_native_args outrank target_args at the
// struct-literal mono seam — is the consumer it gates. These two tests are the runtime pin:
// all three instantiations are alive SIMULTANEOUSLY, so one shared element/key type cannot
// satisfy them. The failure mode is the hnyqe4 silent-hash shape, not a cc error — an Int
// element hashed through the Str kops table (or vice versa) gives a wrong `contains`/`get`
// answer, or segfaults on the pointer deref, while the emitted C compiles cleanly.
test "xskbvh collapse pin: one blink_wrap_Set serves Set[Int], Set[Str] and Set[Point]" {
    let mut si: Set[Int] = Set()
    si.insert(3)
    let mut ss: Set[Str] = Set()
    ss.insert("x")
    let mut sp: Set[Point] = Set()
    sp.insert(Point { x: 1, y: 2 })

    let ti = wrap(si)
    let ts = wrap(ss)
    let tp = wrap(sp)

    assert(ti.0.contains(3))
    assert(!ti.0.contains(9))
    assert(ts.0.contains("x"))
    assert(!ts.0.contains("y"))
    assert(tp.0.contains(Point { x: 1, y: 2 }))
    assert(!tp.0.contains(Point { x: 9, y: 9 }))
}

test "xskbvh collapse pin: one blink_wrap_Map serves Map[Int,Str], Map[Int,Struct] and Map[Point,Int]" {
    let mis: Map[Int, Str] = Map()
    mis.insert(5, "five")
    let min: Map[Int, NineBox] = Map()
    min.insert(5, NineBox { n: 9 })
    let mpi: Map[Point, Int] = Map()
    mpi.insert(Point { x: 1, y: 2 }, 9)

    let tis = wrap(mis)
    let tin = wrap(min)
    let tpi = wrap(mpi)

    assert_eq(tis.0.get(5).unwrap(), "five")
    assert_eq(tin.0.get(5).unwrap().n, 9)
    assert_eq(tpi.0.get(Point { x: 1, y: 2 }).unwrap(), 9)
    assert(!tpi.0.contains_key(Point { x: 9, y: 9 }))
}

// GREEN control: generic-struct Set[Str] must stay on the natural pointer path —
// the recovery gate ("still erased default") must NOT override a Str element.
test "vbhc4x generic-struct Set[Str] stays undisturbed (default path)" {
    let mut b = GBoxSet { s: Set() }
    b.s.insert("x")
    assert(b.s.contains("x"))
    assert(!b.s.contains("y"))
}
