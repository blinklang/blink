// A UE handler op returning `Option[GenericStruct[T]]` must spell its inner carrier with the
// mono stem (QBox_0Int -> blink_Option_QBox_0Int / blink_QBox_0Int) on BOTH sides. The
// handler-side boundary box and the typedef already use the mono stem, but the perform-site
// erased-ptr->concrete conversion recorded the UeMethod inner as the BASE name (QBox), emitting
// the undeclared blink_Option_QBox / (blink_QBox*). Two spellers; the perform site must resolve
// the mono stem from the return annotation, matching the typedef side.

import compile_test_helpers

fn generic_struct_src() -> Str {
    #"import std.io

type QBox[T] {
    val: T
    tag: Int
}

effect Store {
    effect Lookup {
        fn find(name: Str) -> Option[QBox[Int]]
    }
}

fn lookup(name: Str) -> Option[QBox[Int]] ! Store.Lookup {
    store.find(name)
}

fn main() {
    with handler Store {
        fn find(name: Str) -> Option[QBox[Int]] {
            Some(QBox { val: 42, tag: 7 })
        }
    } {
        let b = lookup("x").unwrap()
        io.println("val={b.val} tag={b.tag}")
    }
}
"#
}

test "a UE-handler Option[GenericStruct[Int]] op round-trips through the mono stem" {
    let r = compile_test_helpers.compile_and_run(generic_struct_src(), "jmqevm_generic_struct")
    if !r.out.contains("val=42 tag=7") { compile_test_helpers.expect_contains(r.out, "val=42 tag=7", "generic-struct inner — got '{r.err_out}'") }
    assert(r.out.contains("val=42 tag=7"))
    assert_eq(r.exit_code, 0)
}
