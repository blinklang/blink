// br jqb7gj — a `let` inside a block expression in CALL-ARGUMENT position was never
// walked by typecheck, so a binding like `let mut s1: Set[Int] = Set()` inside the block
// lost its type and the argument miscompiled. The call-argument block is now walked, so
// the inner let typechecks and the block's tail value flows to the parameter.

fn take_int(x: Int) -> Int { x }

test "a let inside a call-argument block expression is typechecked and runs" {
    let b = take_int({
        let mut s1: Set[Int] = Set()
        s1.insert(2)
        s1.len()
    })
    assert_eq(b, 1)
}
