// br jv4zvw — a mono generic-struct FIELD whose type is a compound carrier
// (Option[Set[T]], Result[Float,Str], Option[Float]) embeds that carrier's
// typedef BY VALUE. emit_mono_struct_typedef only QUEUED the carrier typedef for
// a later end-of-file flush, so a carrier that nothing else pre-emits landed
// AFTER the struct that references it — a cc forward reference:
//
//     typedef struct { blink_Option_set f; } blink_Box_Int;   // f not declared yet
//     typedef struct { int tag; blink_set* value; } blink_Option_set;
//
// The pre-pass that already forces a by-value tuple/struct field's typedef now
// also forces the carrier (emit_carrier_typedef_for_tag) before the struct opens.
// Box[Int] compiled only because blink_Result_int_str / blink_Option_int are
// ubiquitous common carriers; the rare inner CTs (Set, Float) hit it directly.

type SetBox[T] { f: Option[Set[T]] }
type ResBox[T] { r: Result[T, Str] }
type OptBox[T] { o: Option[T] }

test "mono struct Option[Set[T]] field keeps its carrier typedef ordered" {
    let mut s = Set()
    s.insert(1)
    s.insert(2)
    let b = SetBox { f: Some(s) }
    let mut total = 0
    for x in b.f.unwrap() { total = total + x }
    assert_eq(total, 3)
}

test "mono struct Result[Float,Str] field keeps its carrier typedef ordered" {
    let b = ResBox { r: Ok(3.5) }
    let v = b.r.unwrap()
    assert_eq(v + 0.5, 4.0)
}

test "mono struct Option[Float] field keeps its carrier typedef ordered" {
    let b = OptBox { o: Some(2.5) }
    let v = b.o.unwrap()
    assert_eq(v + 0.5, 3.0)
}
