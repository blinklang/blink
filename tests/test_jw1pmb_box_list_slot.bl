}

fn src_r9() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let a: Box[Set[Int]] = Box \{ v: Set() }\n")
    s = s.concat("    let b: Box[Int] = Box \{ v: 7 }\n")
    s = s.concat("    assert(a.v.insert(1))\n")
    s = s.concat("    assert(a.v.contains(1))\n")
    s = s.concat("    assert(b.v == 7)\n")
    s = s.concat("}\n")
    s
}

test "R9 GREEN CONTROL: neighbouring Box[Set[..]]/Box[Int] slots are undisturbed" {
    let r = compile_test_helpers.compile_and_run(src_r9(), "jw1pmb_r9_run")
    if r.exit_code != 0 { io.println("FAIL: R9 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

fn src_r10() -> Str {
    let mut s = box_decl()
    s = s.concat("fn unwrap_box[T](b: Box[T]) -> T \{\n")
    s = s.concat("    b.v\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let a: Box[List[Str]] = Box \{ v: [\"a\"] }\n")
    s = s.concat("    let xs = unwrap_box(a)\n")
    s = s.concat("    assert(xs.get(0).unwrap() == \"a\")\n")
    s = s.concat("}\n")
    s
}

test "R10: a generic fn's List[T]-bound type param resolves through the same predicate" {
    let r = compile_test_helpers.compile_and_run(src_r10(), "jw1pmb_r10_run")
    if r.exit_code != 0 { io.println("FAIL: R10 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}
