// @derive(Debug/Ord/Clone/Serialize) on a generic type must emit a derive fn
// per mono instance, keyed on the concrete instance name the call sites spell
// (blink_Box_0Int_debug), not a single fn over the bare, never-typedef'd base
// (blink_Box_debug). Hash/Eq already carry this generic-base->mono-instance
// join; the other four derive kinds regressed to the bare-base name and failed
// C compilation with 'unknown type name blink_Box' + an implicit declaration of
// the mono-instance fn. Direct mono instance, no struct field — independent of
// the field-nesting path.

@derive(Debug, Ord, Clone, Serialize)
type Box[T] { v: T }

// A generic @derive(Debug) type with a CONTAINER field renders that field
// through a nested walker (blink_debug_List_Int). The walker is only reachable
// once the mono instance (Wrapper_0Int) joins the real debug list during fn-body
// emission, so its queue + forward-decl + definition need a supplemental sweep
// after bodies — a scalar-only field never exercises this (it renders inline).
@derive(Debug)
type Wrapper[T] { items: List[T] }

fn wdbg() -> Str { Wrapper { items: [1, 2, 3] }.debug() }

fn dbg() -> Str { Box { v: 3 }.debug() }
fn cl() -> Int { Box { v: 5 }.clone().v }
fn js() -> Str { Box { v: 7 }.to_json() }
fn lt() -> Bool { Box { v: 1 } < Box { v: 2 } }

test "derive Debug on a generic mono instance" {
    assert_eq(dbg(), #"Box { v: 3 }"#)
}

test "derive Debug on a generic mono instance with a container field" {
    assert_eq(wdbg(), #"Wrapper { items: [1, 2, 3] }"#)
}

test "derive Clone on a generic mono instance" {
    assert_eq(cl(), 5)
}

test "derive Serialize on a generic mono instance" {
    assert_eq(js(), #"{"v":7}"#)
}

test "derive Ord on a generic mono instance" {
    assert_eq(lt(), true)
}
