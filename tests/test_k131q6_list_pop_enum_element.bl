type Color { Red, Green, Blue }

fn main() {
    let mut xs: List[Color] = []
    xs.push(Color.Red)
    xs.push(Color.Green)
    xs.push(Color.Blue)

    let last = xs.pop()
    match last {
        Some(c) => assert_eq(c == Color.Blue, true)
        None => assert_eq(1, 0)
    }

    let mid = xs.pop()
    match mid {
        Some(c) => assert_eq(c == Color.Green, true)
        None => assert_eq(1, 0)
    }

    let first = xs.pop()
    match first {
        Some(c) => assert_eq(c == Color.Red, true)
        None => assert_eq(1, 0)
    }

    let empty = xs.pop()
    match empty {
        Some(_c) => assert_eq(1, 0)
        None => assert_eq(1, 1)
    }
}
