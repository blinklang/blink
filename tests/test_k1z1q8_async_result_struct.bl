// An async task returning Result[Struct, E] must carry the struct ok-type all the way through the
// spawn wrapper and the await unbox. Before the fix, emit_async_spawn_closure's CT_RESULT branch (and
// the matching await branch) ran the ok-type name through type_from_name, which erases a user struct
// to void — so the wrapper was emitted as blink_Result_void_str while its body returned
// blink_Result_Point_str, and the C did not compile. These rows spawn Result-returning tasks whose ok
// payload is a struct, await them, and read a field off the unwrapped struct.

type Point {
    x: Int
    y: Int
}

type Fail {
    Bad
    Worse
}

// ── Result[Struct, Str] Ok → await → unwrap → read a struct field ────────────────────────
test "an async handle of Result[Struct, Str] unwraps the ok struct" {
    let h = async.spawn(fn() -> Result[Point, Str] {
        Ok(Point { x: 3, y: 4 })
    })
    let r = h.await
    assert_eq(r.unwrap().x, 3)
}

// ── Result[Struct, Str] Err → await → is_err round-trips the wrapper ─────────────────────
test "an async handle of Result[Struct, Str] carries the err arm" {
    let h = async.spawn(fn() -> Result[Point, Str] {
        Err("nope")
    })
    let r = h.await
    assert_eq(r.is_err(), true)
}

// ── Result[Struct, Enum] → await → unwrap the ok struct (struct ok + enum err) ───────────
test "an async handle of Result[Struct, Enum] unwraps the ok struct" {
    let h = async.spawn(fn() -> Result[Point, Fail] {
        Ok(Point { x: 8, y: 9 })
    })
    let r = h.await
    assert_eq(r.unwrap().y, 9)
}
