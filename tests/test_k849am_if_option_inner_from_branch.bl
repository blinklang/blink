// Regression for k849am (repro A): an if-expr whose branches are `None` / `Some(value)`,
// bound to a let inside a Result-returning fn, took its Option inner type from the
// enclosing fn's Ok struct (`Parsed`) instead of the actual Some-branch element (`Str`).
// The if-expr temp was mis-declared `blink_Option_Parsed` and the assignment from the
// real `blink_Option_str` value produced incompatible-type C. `blink check` passed;
// only `blink build`/`blink test` surfaced the broken C.
//
// Found in libs/pg's parse_url.

type Parsed { host: Str, password: Option[Str] }

fn parse() -> Result[Parsed, Str] {
    let s = "user:pw"
    let colon = s.index_of(":")
    let password = if colon < 0 {
        None
    } else {
        Some(s.slice(colon + 1, s.len()))
    }
    Ok(Parsed { host: "h", password: password })
}

fn parse_no_colon() -> Result[Parsed, Str] {
    let s = "user"
    let colon = s.index_of(":")
    let password = if colon < 0 {
        None
    } else {
        Some(s.slice(colon + 1, s.len()))
    }
    Ok(Parsed { host: "h", password: password })
}

test "if-expr with Option[Str] in struct return — Some branch round-trips" {
    let p = parse().unwrap()
    assert_eq(p.password.is_some(), true)
    assert_eq(p.password.unwrap(), "pw")
}

test "if-expr with Option[Str] in struct return — None branch" {
    let p = parse_no_colon().unwrap()
    assert_eq(p.password.is_none(), true)
}
