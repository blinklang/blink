// A builtin container constructor may take its type arguments in brackets (03_types.md:1311):
// `Map[Str, Int]()` names the types the empty constructor cannot learn from its arguments.
// The list binds the constructor's own parameters, so its length is exact.

import compile_test_helpers
import std.io

fn expect_runs_printing(src: Str, tag: Str, want: Str) {
    let r = compile_test_helpers.compile_and_run(src, tag)
    if r.exit_code != 0 || r.out.trim() != want {
        io.println("FAIL: {tag} exit={r.exit_code} out={r.out} err={r.err_out}")
    }
    assert(r.exit_code == 0)
    assert(r.out.trim() == want)
}

// A rejected program must stop at a front-end code, never at an ICE from a later stage.
fn expect_rejected(src: Str, tag: Str, code: Str) -> Str {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "\"code\":\"{code}\"", tag)
    assert(!out.contains("\"severity\":\"ice\""))
    out
}

test "an empty map takes its key and value types from the brackets" {
    expect_runs_printing(#"fn main() {
    let m = Map[Str, Int]()
    io.println("{m.len()}")
}
"#, "_keyed_ctor_map", "0")
}

test "an empty set takes its element type from the brackets" {
    expect_runs_printing(#"fn main() {
    let s = Set[Int]()
    io.println("{s.len()}")
}
"#, "_keyed_ctor_set", "0")
}

test "a map given one type argument is rejected with the count" {
    let out = expect_rejected(#"fn main() {
    let m = Map[Str]()
    io.println("{m.len()}")
}
"#, "_keyed_ctor_map_arity", "E0307")
    compile_test_helpers.expect_contains(out, "expects 2 type argument(s), 1 given", "Map arity message")
}

test "Map.new takes its key and value types from the brackets" {
    expect_runs_printing(#"fn main() {
    let m = Map.new[Str, Int]()
    io.println("{m.len()}")
}
"#, "_keyed_ctor_map_new", "0")
}

test "List.new takes its element type from the brackets" {
    expect_runs_printing(#"fn main() {
    let l = List.new[Int]()
    io.println("{l.len()}")
}
"#, "_keyed_ctor_list_new", "0")
}

// List is a type with no call form, so brackets before a call on it name no constructor.
test "List with brackets and a call is an unknown callee that names the empty list literal" {
    let out = expect_rejected(#"fn main() {
    let l = List[Int]()
    io.println("{l.len()}")
}
"#, "_keyed_ctor_list_call", "E0504")
    compile_test_helpers.expect_contains(out, "`[]`", "List help names the empty list literal")
    assert(!out.contains("\"code\":\"E0307\""))
}

test "List with two type arguments is the same unknown callee" {
    let out = expect_rejected(#"fn main() {
    let l = List[Int, Str]()
    io.println("{l.len()}")
}
"#, "_keyed_ctor_list_two", "E0504")
    assert(!out.contains("\"code\":\"E0307\""))
}
