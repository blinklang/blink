// A keyword argument binds to the parameter its label names, whatever order the call writes
// the labels in, and a keyword parameter the call leaves out takes its declared default.
// Spec: sections/02_syntax.md §2.13.

fn transfer(amount: Int, -- from: Str, to: Str) -> Str {
    "{from} sends {amount} to {to}"
}

fn greet(name: Str, -- greeting: Str = "hi", punct: Str = "!") -> Str {
    "{greeting} {name}{punct}"
}

fn endpoint(-- host: Str, port: Int) -> Str {
    "{host}:{port}"
}

fn pair_of[T](first: T, -- second: T) -> List[T] {
    [first, second]
}

fn apply_both(-- to_int: fn(Int) -> Int, to_len: fn(Str) -> Int) -> Int {
    to_int(1) + to_len("abc")
}

type Account {
    id: Int
}

trait Sender {
    fn send(self, amount: Int, -- to: Str, memo: Str) -> Str
}

impl Sender for Account {
    fn send(self, amount: Int, -- to: Str, memo: Str = "none") -> Str {
        "{self.id}:{amount}:{to}:{memo}"
    }
}

test "labels written in declaration order bind in order" {
    assert_eq(transfer(100, from: "alice", to: "bob"), "alice sends 100 to bob")
}

test "labels written out of order bind by name" {
    assert_eq(transfer(100, to: "bob", from: "alice"), "alice sends 100 to bob")
}

test "a function with only keyword parameters binds every label" {
    assert_eq(endpoint(port: 8080, host: "0.0.0.0"), "0.0.0.0:8080")
}

test "an omitted keyword parameter takes its default" {
    assert_eq(greet("b", punct: "?"), "hi b?")
    assert_eq(greet("c", punct: ".", greeting: "yo"), "yo c.")
}

test "two calls that omit the same defaults both take them" {
    assert_eq(greet("a"), "hi a!")
    assert_eq(greet("z"), "hi z!")
}

test "a generic function binds its keyword argument by label" {
    let xs = pair_of(1, second: 2)
    assert_eq(xs.len(), 2)
    assert_eq(xs.get(1).unwrap(), 2)
}

test "closure arguments bind to the parameters their labels name" {
    assert_eq(apply_both(to_len: fn(s) { s.len() }, to_int: fn(k) { k + 1 }), 5)
}

test "a method binds its keyword arguments by label and fills a default" {
    let a = Account { id: 7 }
    assert_eq(a.send(5, to: "x"), "7:5:x:none")
    assert_eq(a.send(5, memo: "m", to: "y"), "7:5:y:m")
}
