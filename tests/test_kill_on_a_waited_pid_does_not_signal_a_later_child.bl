// A waited child is reaped, so kill and send_signal on its handle return -1. The runtime once
// let the next spawn take the waited slot, so the old handle signalled the new child instead.

import std.process.{spawn, SIGTERM, ChildEnd}

test "kill and send_signal on a waited pid return -1 and do not touch a later child" {
    let a = spawn("echo", ["a"])
    let _ = a.wait()
    let b = spawn("sh", ["-c", "sleep 1; echo b"])
    assert_eq(a.kill(0), -1)
    assert_eq(a.send_signal(SIGTERM), -1)
    let rb = b.wait()
    assert_eq(rb.end, ChildEnd.Exited(0))
    assert_eq(rb.out.trim(), "b")
}
