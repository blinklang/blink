// kjpq9p: `let e = Errno(5); let x: Option[Errno] = Some(e)` in a test body
// (cg_current_fn_node == -1) must spell the RHS Some(...) carrier from the live
// let annotation. emit_let_binding lowers `e` to a bare int64_t and clears its
// enum tracking, so transparent_newtype_arg_enum sees only a CT_INT Ident; the
// existing fn-return recovery requires cg_current_fn_node != -1, which a test
// body clears to -1, dropping Some to the scalar branch (blink_Option_int)
// while the declaration is structured (blink_Option_std_errno_Errno) — C
// "invalid initializer". Sibling of t5nvd4; same coupled edit.

import std.errno { Errno }

test "let-annotated Option[Errno] = Some(var) in a test body stays Option_Errno" {
    let e = Errno(5)
    let x: Option[Errno] = Some(e)
    assert_eq(x.is_some(), true)
}

// Regression guard: the call form (Some(Errno(5))) already resolved correctly
// via transparent_newtype_arg_enum — must stay green and byte-identical.
test "let-annotated Option[Errno] = Some(Errno(5)) call form stays green" {
    let y: Option[Errno] = Some(Errno(5))
    assert_eq(y.is_some(), true)
}

// Regression guard: no annotation at all — scalar branch must be untouched.
test "Some(5) with no annotation stays on the scalar branch" {
    let z = Some(5)
    assert_eq(z.is_some(), true)
}
