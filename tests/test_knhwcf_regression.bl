// knhwcf regression: `blink test` rejected `?` inside test blocks even
// though `blink check` accepted them. Spec §2.20 elaborates a test body
// using `?` to Result[Void, TestError]. After the fix, the same code
// must compile and run on the `test` path.

fn ok42() -> Result[Int, Str] {
    Ok(42)
}

test "knhwcf: ? in test body compiles and runs" {
    let n = ok42()?
    assert_eq(n, 42)
}
