// br kwnp6p — tuple-element twin of xnacxw site-3. A match on a TUPLE whose
// element is a top-level Result carrier over a compound inner —
// `match (wrap(m), 1) { ... }` where wrap[K,V](m) -> Result[Map[K,V], Str] —
// materialized the element temp from the flat erased channels
// (blink_Result_map_str) while the Ok(m) value spelled the faithful
// blink_Result_Map_str_int_str, a same-TU invalid-initializer cc error. The
// non-tuple scrutinee branch was fixed by xnacxw; this separate tuple branch
// had the identical latent defect. The node tid leads for a compound inner.

fn wrap[K, V](m: Map[K, V]) -> Result[Map[K, V], Str] { Ok(m) }

test "tuple-element top-level Result carrier keeps its Map inner K,V" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 7)
    let mut got = 0
    match (wrap(m), 1) {
        (Ok(inner), _) => { got = inner.get("k").unwrap() }
        (Err(_), _) => { got = -1 }
    }
    assert_eq(got, 7)
}

fn opt_wrap[K, V](m: Map[K, V]) -> Option[Map[K, V]] { Some(m) }

test "tuple-element Option carrier keeps its Map inner K,V" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 9)
    let mut got = 0
    match (opt_wrap(m), 1) {
        (Some(inner), _) => { got = inner.get("k").unwrap() }
        (None, _) => { got = -1 }
    }
    assert_eq(got, 9)
}
