// The struct and enum closure-param arms read the annotation's tid; the else arm falls to
// c_type_str(type_from_name(ptype)), which answers "void" for every name it cannot map — a
// type parameter among them. `void x` is not a legal C parameter, so this one fails loudly at
// cc rather than miscompiling, but it fails on code the language accepts.
//
// Same pairing rule as the return side: the definition's param list and the call-site cast are
// one ABI, so both rows below have to agree or the closure is called through the wrong shape.

import compile_test_helpers
import std.io

fn assert_lacks(c: Str, needle: Str, label: Str) {
    if c.contains(needle) { io.println("FAIL: {label} — forbidden '{needle}' present") }
    assert(!c.contains(needle))
}

fn tparam_param_src() -> Str {
    #"import std.io

fn apply[T](v: T) -> Int {
    let f = fn(x: T) -> Int { 5 }
    f(v)
}

fn main() {
    io.println("r={apply(1.5)}")
}
"#
}

test "a closure parameter typed by a type parameter is not spelled void" {
    let c = compile_test_helpers.compile_and_emit_c(tparam_param_src(), "kx3m7p_def")
    assert_lacks(c, "void x)", "the definition must not declare a void parameter")
    assert_lacks(c, "const blink_closure*, void)", "the call-site cast must not name a void parameter")
}

test "a closure parameter typed by a type parameter compiles and runs" {
    let r = compile_test_helpers.compile_and_run(tparam_param_src(), "kx3m7p_run")
    if !r.out.contains("r=5") { io.println("FAIL: tparam closure param — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("r=5"))
}

// A Str parameter takes the same else arm and already works. It is the control that proves the
// fix reads the tid rather than widening the arm into a guess.
fn str_param_src() -> Str {
    #"import std.io

fn main() {
    let f = fn(s: Str) -> Int { s.len() }
    io.println("n={f(\"abcd\")}")
}
"#
}

test "an ordinary parameter on the same arm keeps working" {
    let r = compile_test_helpers.compile_and_run(str_param_src(), "kx3m7p_str_run")
    if !r.out.contains("n=4") { io.println("FAIL: Str closure param — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("n=4"))
}
