// br kxe0s2 — an Instant or a Duration inside a container keeps its identity.
//
// THE MVCE, verbatim from the ticket:
//
//     let d = Duration.ms(50)
//     let o = Some(d)
//     let d2 = o.unwrap()
//     io.println("ms={d2.to_ms()}")
//
//   error[UnresolvedMethod]: unresolved method '.to_ms' on type Duration in 'main'
//
// and with the method call removed so codegen got that far, cc:
//
//   error: unknown type name 'blink_Option_void'
//     const blink_Option_void o = (blink_Option_void){.tag = 1, .value = d};
//
// TWO SYMPTOMS, ONE CAUSE. `Instant` and `Duration` are ordinary `pub type` structs
// (lib/std/time.bl:21,:25) whose methods are ordinary value-receiver free functions
// (`pub fn Duration_to_ms(d: Duration) -> Int`). They ALSO carry their own flat CTs,
// CT_INSTANT and CT_DURATION. Every carrier site decides struct-vs-scalar by asking
// whether a struct NAME is present, and these two never present one — so they took the
// scalar side, where the carrier is named from `c_type_tag`, which had no arm for either
// and answered its `else { "void" }` default. `emit_option_typedef` returns early on
// exactly `tag == "void"`, so `blink_Option_void` was REFERENCED and never TYPEDEF'D.
// The unwrapped value then came back a bare `int64_t`, and the method blocks that spell
// `Duration_to_ms` are gated on the flat CT, so the retrieved value could no longer do
// anything a Duration can do.
//
// WHY THIS HID FOR SO LONG: `rg '\[(Instant|Duration)\]' src/ lib/ tests/ examples/` finds
// NOTHING. Not one Instant or Duration appears as a type argument anywhere in the repo, so
// the carrier was an entirely unexercised tap — a zero-hit sweep is not coverage
// (feedback_corpus_sweep_is_not_coverage), so every shape below is constructed by hand.
// The other half of the camouflage is that both types are `{ nanos: Int }` and int64_t-shaped
// in C, so flooring one to Int LOOKS like a legitimate scalar. It is wrong twice: once in the
// carrier name and once in what the retrieved value can do.
//
// THE FIX routes them to the struct carrier that already works — the same path
// `Some(some_point)` has always taken — rather than inventing a by-value carrier with a
// struct-derived tag. That choice matters beyond tidiness: List-of-struct, Map-value-struct,
// Result-of-struct and tuple-of-struct machinery is fully built out, so one routing decision
// covers every container below instead of needing a per-container arm each.
//
// EVERY ROW ASSERTS ON A VALUE. `.to_ms()` returning 50 cannot be faked by an erased
// carrier: an int64_t-shaped Duration that lost its type reaches the UnresolvedMethod
// backstop and the file does not compile at all, and a mis-boxed one reads through the
// wrong indirection and prints garbage. Nothing here ends in `assert(true)`.

test "kxe0s2 option-wrapped Duration keeps to_ms — the MVCE" {
    let d = Duration.ms(50)
    let o = Some(d)
    let d2 = o.unwrap()
    assert_eq(d2.to_ms(), 50)
}

test "kxe0s2 Some() over a Duration EXPRESSION receiver" {
    // No ScopeVar for the inner at all — the carrier decision has only the flat CT to go
    // on, which is the channel the fix reads. The let-ladder row above could in principle
    // have been rescued by a per-variable name channel; this one could not.
    let a = Some(Duration.ms(50))
    assert_eq(a.unwrap().to_ms(), 50)
}

test "kxe0s2 explicitly annotated Option[Duration]" {
    let o: Option[Duration] = Some(Duration.seconds(2))
    assert_eq(o.unwrap().to_seconds(), 2)
}

test "kxe0s2 Option[Duration] as a function return type" {
    assert_eq(kx_mk_dur().unwrap().to_ms(), 7)
}

test "kxe0s2 the None side of an Option[Duration]" {
    let n = kx_no_dur()
    assert(n.is_none())
    assert(n.is_some() == false)
}

test "kxe0s2 a retrieved Duration is still nominally a Duration" {
    // The point of the whole ticket: identity, not just a readable field. Every one of
    // these is gated on the receiver's flat CT being CT_DURATION, so an erased element
    // fails to compile rather than computing something wrong.
    let d = Some(Duration.seconds(3)).unwrap()
    assert_eq(d.to_ms(), 3000)
    assert_eq(d.to_nanos(), 3000000000)
    assert_eq(d.add(Duration.seconds(2)).to_seconds(), 5)
    assert_eq(d.sub(Duration.seconds(1)).to_seconds(), 2)
    assert_eq(d.scale(2).to_seconds(), 6)
    assert(d.is_zero() == false)
}

test "kxe0s2 field access through the carrier" {
    // `d2.nanos` used to interpolate the literal string "<value>" — a field read on an
    // erased var degrades silently instead of failing, which is why an output assert and
    // not a compile-only check is the guard here.
    let d2 = Some(Duration.ms(2)).unwrap()
    assert_eq(d2.nanos, 2000000)
}

test "kxe0s2 option-wrapped Instant keeps since()" {
    let i = Instant.from_epoch_secs(105)
    let o = Some(i)
    let e = o.unwrap().since(Instant.from_epoch_secs(100))
    assert_eq(e.to_seconds(), 5)
}

test "kxe0s2 a retrieved Instant is still nominally an Instant" {
    let t = Some(Instant.from_epoch_secs(1735689600)).unwrap()
    assert_eq(t.to_unix_secs(), 1735689600)
    assert_eq(t.to_unix_ms(), 1735689600000)
    assert(t.to_rfc3339().len() > 0)
    assert_eq(t.add(Duration.seconds(400)).to_unix_secs(), 1735690000)
}

test "kxe0s2 List[Duration] element" {
    let ds = [Duration.ms(7), Duration.ms(9)]
    assert_eq(ds.get(0).unwrap().to_ms(), 7)
    assert_eq(ds.get(1).unwrap().to_ms(), 9)
    assert(ds.get(5).is_none())
}

test "kxe0s2 List[Instant] element" {
    let ts = [Instant.from_epoch_secs(100), Instant.from_epoch_secs(200)]
    assert_eq(ts.get(1).unwrap().to_unix_secs(), 200)
}

test "kxe0s2 Map[Str, Duration] value" {
    let mut m: Map[Str, Duration] = Map()
    m.insert("a", Duration.ms(9))
    m.insert("b", Duration.seconds(1))
    assert_eq(m.get("a").unwrap().to_ms(), 9)
    assert_eq(m.get("b").unwrap().to_ms(), 1000)
    assert(m.get("zz").is_none())
}

test "kxe0s2 Result[Duration, Str] ok side" {
    let r = kx_dur_ok()
    assert(r.is_ok())
    assert_eq(r.unwrap().to_ms(), 3)
}

test "kxe0s2 Result[Duration, Str] err side" {
    let r = kx_dur_err()
    assert(r.is_err())
    assert_eq(r.unwrap_err(), "nope")
}

test "kxe0s2 two Durations in one container stay distinct" {
    // A carrier that erases its inner is happy to hand back the same bytes for both; a
    // carrier that boxes them wrongly hands back the LAST one twice. Two different values
    // read back in order is what separates "compiles" from "works".
    let a = Some(Duration.ms(11))
    let b = Some(Duration.ms(22))
    assert_eq(a.unwrap().to_ms(), 11)
    assert_eq(b.unwrap().to_ms(), 22)
}

test "kxe0s2 an Instant and a Duration are not interchangeable in carriers" {
    // Both are `{ nanos: Int }`, so a carrier keyed on layout rather than name would let
    // these two share one typedef and one set of methods. They must not.
    let oi = Some(Instant.from_epoch_secs(7))
    let od = Some(Duration.seconds(7))
    assert_eq(oi.unwrap().to_unix_secs(), 7)
    assert_eq(od.unwrap().to_seconds(), 7)
}

fn kx_mk_dur() -> Option[Duration] {
    Some(Duration.ms(7))
}

fn kx_no_dur() -> Option[Duration] {
    None
}

fn kx_dur_ok() -> Result[Duration, Str] {
    Ok(Duration.ms(3))
}

fn kx_dur_err() -> Result[Duration, Str] {
    Err("nope")
}
