// The value under a call-site label is an ordinary expression, so its names resolve the
// same as a positional argument's: an undefined name is UndefinedVariable, not an
// untyped node that reaches the end of type checking.

import compile_test_helpers

fn label_prelude() -> Str {
    #"
fn run(-- h: Int) -> Int { h }
type Srv { base: Int }
trait Serve {
    fn serve(self, -- port: Int) -> Int
}
impl Serve for Srv {
    fn serve(self, -- port: Int) -> Int { self.base + port }
}
"#
}

// expect_compiles_clean does not count an internal compiler error, so this checks for one.
fn expect_no_ice(out: Str, tag: Str) {
    let ice = out.contains("\"severity\":\"ice\"")
    if ice { io.println("FAIL: {tag}: internal compiler error") }
    assert(!ice)
}

fn expect_undefined(src: Str, tag: Str) {
    let out = compile_test_helpers.compile_and_capture(label_prelude().concat(src), tag)
    compile_test_helpers.expect_error(out, "UndefinedVariable", "{tag}: undefined name under a label is UndefinedVariable")
    expect_no_ice(out, tag)
}

test "an undefined name under a function call label is UndefinedVariable" {
    expect_undefined(#"
fn main() {
    let _n = run(h: nope_call)
}
"#, "_label_nr_call")
}

test "an undefined name under a method call label is UndefinedVariable" {
    expect_undefined(#"
fn main() {
    let s = Srv { base: 1 }
    let _n = s.serve(port: nope_method)
}
"#, "_label_nr_method")
}

test "a defined name under a label compiles" {
    let out = compile_test_helpers.compile_and_capture(label_prelude().concat(#"
fn main() {
    let k = 3
    let s = Srv { base: 1 }
    assert_eq(run(h: k) + s.serve(port: k), 7)
}
"#), "_label_nr_defined")
    compile_test_helpers.expect_compiles_clean(out, "_label_nr_defined: compiles with no error")
    expect_no_ice(out, "_label_nr_defined")
}
