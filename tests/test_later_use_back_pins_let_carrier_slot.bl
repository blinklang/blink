// A let-bound Option/Result carrier whose element slot is under-determined at the
// let (None, or Ok/Err naming only one side) is still determinable by a later
// declared return, an annotated re-binding, or an assignment. That later use must
// back-pin the slot so E0301 does not false-fire on these solvable programs.

fn ret_result() -> Result[Int, Str] {
    let x = Ok(3)
    x
}

fn ret_option() -> Option[Int] {
    let x = None
    x
}

fn annotated_let() -> Int {
    let x = Ok(3)
    let y: Result[Int, Str] = x
    match y { Ok(v) => v Err(_) => 0 - 1 }
}

fn mut_assign() -> Int {
    let mut x = Ok(3)
    x = Err("boom")
    match x { Ok(v) => v Err(e) => e.len() }
}

test "a declared Result return back-pins an intermediate let carrier slot" {
    match ret_result() { Ok(v) => assert_eq(v, 3) Err(_) => assert(false) }
}

test "a declared Option return back-pins a None let carrier slot" {
    assert(ret_option().is_none())
}

test "an annotated let back-pins the Result carrier slot" {
    assert_eq(annotated_let(), 3)
}

test "an assignment back-pins the mut Result carrier slot" {
    assert_eq(mut_assign(), 4)
}
