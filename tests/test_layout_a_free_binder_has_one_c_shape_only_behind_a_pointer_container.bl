// Typecheck reads tid_has_c_shape to decide if an impl body over a built-in type can be one
// body for every binder value. A pointer container holds any child as one runtime type, but a
// carrier's C name spells each argument, so a free binder anywhere under one has no shape.

import std.fs
import std.io
import typecheck.{tc_type_str, tc_lookup_node_tid, check_types}
import layout.{tid_has_c_shape, layout_reset}
import parser.{node_count}
import compiler.{compile_to_program}

fn probe_src() -> Str {
    #"type Bx[T] { v: T }
fn f[T](x: T) -> Int {
    let a: List[T] = [x]
    let b: Map[Str, T] = Map()
    let c: Option[T] = Some(x)
    let d: Option[List[T]] = Some(a)
    let e: (List[T], Int) = (a, 1)
    let g: List[Bx[T]] = []
    let h: Bx[List[T]] = Bx { v: a }
    let i: Option[Int] = None
    a.len() + b.len() + g.len() + h.v.len() + e.1
}
fn main() {
    assert(f(1) == 3)
}
"#
}

// The probe is deleted before any assertion so a red row never leaks the file.
fn harvest_type_tids() -> Map[Str, Int] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete, Env.Exit, Env.Read, FS.Read, IO, FS.Write {
    let path = "build/layout_free_binder_shape_probe_src.bl"
    fs.write(path, probe_src()).unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    layout_reset()
    let _ = fs.delete(path)
    let mut m: Map[Str, Int] = Map()
    let mut idx = 0
    while idx < node_count() {
        let tid = tc_lookup_node_tid(idx)
        if tid >= 0 { m.insert(tc_type_str(tid), tid) }
        idx = idx + 1
    }
    m
}

fn shape_of(m: Map[Str, Int], key: Str) -> Bool ! IO.Print {
    let tid = m.get(key) ?? -1
    if tid == -1 { io.println("FAIL: the probe has no tid for '{key}'") }
    assert(tid != -1)
    tid_has_c_shape(tid)
}

test "a free binder held by a pointer container has one C shape" {
    let m = harvest_type_tids()
    assert(shape_of(m, "List[T]"))
    assert(shape_of(m, "Map[Str, T]"))
    assert(shape_of(m, "List[Bx[T]]"))
}

test "a free binder anywhere under a carrier or a user type has no C shape" {
    let m = harvest_type_tids()
    assert(!shape_of(m, "T"))
    assert(!shape_of(m, "Option[T]"))
    assert(!shape_of(m, "Option[List[T]]"))
    assert(!shape_of(m, "(List[T], Int)"))
    assert(!shape_of(m, "Bx[List[T]]"))
}

test "a type with no free binder has its C shape" {
    let m = harvest_type_tids()
    assert(shape_of(m, "Option[Int]"))
    assert(shape_of(m, "Int"))
}
