// Bool is a C `int` in every position the emitted C holds one: the runtime's Bool entry
// points take and return `int`, and every struct field, parameter and return the pinned
// compiler ever emitted for a Bool is `int`. The key table the runtime hands a Bool-keyed
// map or set has to copy and hash that same width, so this pins the width the table must match.
import layout.{layout_of, address_layout_of, layout_reset, Position, SlotForm}
import cname_test_helpers.{assert_eq_str, tid_of, compile_probe}

fn probe_src() -> Str {
    #"fn main() {
    let b: Bool = true
    assert(b)
}
"#
}

fn bool_tid() -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let m = compile_probe("layout_bool_width", probe_src())
    layout_reset()
    tid_of(m, "Bool")
}

test "a Bool value is an int wherever it is held by value" {
    let b = bool_tid()
    assert_eq_str("local", layout_of(b, Position.Local).c_spelling, "int")
    assert_eq_str("field", layout_of(b, Position.Field).c_spelling, "int")
    assert_eq_str("param", layout_of(b, Position.Param).c_spelling, "int")
    assert_eq_str("return", layout_of(b, Position.Return).c_spelling, "int")
    assert_eq_str("tuple elem", layout_of(b, Position.TupleElem).c_spelling, "int")
    assert_eq_str("vtable slot", layout_of(b, Position.VtableSlot).c_spelling, "int")
}

test "a Bool key is a word held inline and its address is a pointer to an int" {
    let b = bool_tid()
    let local = layout_of(b, Position.Local)
    assert(local.slot_form == SlotForm.InlineWord)
    assert_eq_str("key table", local.kops_table, "blink_kops_bool")
    assert(local.kops_inline_key)
    assert_eq_str("key address", address_layout_of(b, Position.Local).c_spelling, "int*")
}
