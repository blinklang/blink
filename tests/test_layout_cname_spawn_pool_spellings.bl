// The C names async.spawn's runtime plumbing reads: the submission pair every spawned
// thunk's task wrapper unpacks its argument through, the function-pointer shape a task
// entry point is passed as, the pool's own pointer type, the program's one pool global,
// and an async.scope's own handle list. One producer per name so a spawn call site, its
// task wrapper, and the pool global's own declaration cannot drift apart.

import layout.{spawn_pair_spelling, task_entry_spelling, pool_spelling, async_scope_handles_spelling}
import cname.{c_pool_global}
import cname_test_helpers.{assert_eq_str}

test "the spawn pair struct has a fixed name" {
    assert_eq_str("pair", spawn_pair_spelling(), "blink_spawn_pair")
}

test "a task wrapper's own entry-point type is fixed" {
    assert_eq_str("task entry", task_entry_spelling(), "void(*)(void*)")
}

test "the runtime pool's pointer type is fixed" {
    assert_eq_str("pool type", pool_spelling(), "blink_threadpool*")
}

test "the program's one pool global has a fixed name" {
    assert_eq_str("pool global", c_pool_global(), "__blink_pool")
}

test "an async.scope's own handle list has a fixed name" {
    assert_eq_str("async scope handles", async_scope_handles_spelling(), "blink_list*")
}
