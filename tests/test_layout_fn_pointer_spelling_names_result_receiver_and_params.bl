import std.io
import lower_test_helpers.{probe, let_node_of, fn_decl_of, assert_eq_str, assert_ice_saying, ice_count}
import typecheck.{tc_lookup_node_tid, make_fn_type, make_metavar}
import layout.{fn_pointer_spelling_of, closure_self_spelling}
import parser.{node_params, sublist_get}

fn probe_src() -> Str {
    #"type Point { x: Int, y: Int }
fn ident[T](g: fn(T) -> T) -> Int { 1 }
fn main() {
    let f1: fn(Int) -> Int = fn(a: Int) -> Int { a }
    let f2: fn(Str, Float) -> Void = fn(s: Str, d: Float) -> Void { }
    let f0: fn() -> Int = fn() -> Int { 1 }
    let fp: fn(Point) -> Point = fn(p: Point) -> Point { p }
    let fo: fn(Int) -> Option[Int] = fn(c: Int) -> Option[Int] { Some(c) }
    let fb: fn(Bool) -> Bool = fn(b: Bool) -> Bool { b }
    let n: Int = 1
    assert(n == 1)
}
"#
}

fn tid_of_let(name: Str) -> Int {
    let tid = tc_lookup_node_tid(let_node_of(name))
    if tid < 0 { io.println("FAIL: no tid on let '{name}'") }
    assert(tid >= 0)
    tid
}

// The tid of the first parameter of `fn <name>`, which is where a bare type variable
// reaches a Fn type in a program real inference typed.
fn first_param_tid_of(name: Str) -> Int {
    let ps = node_params(fn_decl_of(name))
    let tid = tc_lookup_node_tid(sublist_get(ps, 0))
    if tid < 0 { io.println("FAIL: no tid on the first parameter of '{name}'") }
    assert(tid >= 0)
    tid
}

test "a one-parameter Fn spells its result, the receiver word, then the parameter" {
    let program = probe("layout_fnptr_one", probe_src())
    assert(program >= 0)
    let node = let_node_of("f1")
    assert_eq_str("fn(Int) -> Int", fn_pointer_spelling_of(tid_of_let("f1"), node),
        "int64_t(*)(const blink_closure*, int64_t)")
}

test "the receiver word is spelled as a pointer to the closure record" {
    assert_eq_str("receiver", closure_self_spelling(), "const blink_closure*")
}

test "parameters keep declaration order and a Void result spells void" {
    let program = probe("layout_fnptr_two", probe_src())
    assert(program >= 0)
    let node = let_node_of("f2")
    assert_eq_str("fn(Str, Float) -> Void", fn_pointer_spelling_of(tid_of_let("f2"), node),
        "void(*)(const blink_closure*, const char*, double)")
}

test "a Fn with no parameters still takes the receiver" {
    let program = probe("layout_fnptr_zero", probe_src())
    assert(program >= 0)
    let node = let_node_of("f0")
    assert_eq_str("fn() -> Int", fn_pointer_spelling_of(tid_of_let("f0"), node),
        "int64_t(*)(const blink_closure*)")
}

test "a nominal, a carrier and a Bool are spelled at their param and return layouts" {
    let program = probe("layout_fnptr_shapes", probe_src())
    assert(program >= 0)
    assert_eq_str("fn(Point) -> Point", fn_pointer_spelling_of(tid_of_let("fp"), let_node_of("fp")),
        "blink_Point(*)(const blink_closure*, blink_Point)")
    assert_eq_str("fn(Int) -> Option[Int]", fn_pointer_spelling_of(tid_of_let("fo"), let_node_of("fo")),
        "blink_Option_int(*)(const blink_closure*, int64_t)")
    assert_eq_str("fn(Bool) -> Bool", fn_pointer_spelling_of(tid_of_let("fb"), let_node_of("fb")),
        "int(*)(const blink_closure*, int)")
}

test "a Fn over a bare type variable is refused by name, never spelled" {
    let program = probe("layout_fnptr_typevar", probe_src())
    assert(program >= 0)
    let before = ice_count()
    let got = fn_pointer_spelling_of(first_param_tid_of("ident"), fn_decl_of("ident"))
    assert_eq_str("typevar spelling", got, "")
    assert_ice_saying("typevar", -1, "UnspellableFnPointer", "free type variable T")
    assert_eq(ice_count(), before + 1)
}

test "a Fn holding an unbound metavariable is refused by name, never spelled" {
    let program = probe("layout_fnptr_metavar", probe_src())
    assert(program >= 0)
    let fn_tid = make_fn_type(make_metavar(), [tid_of_let("n")])
    let before = ice_count()
    let got = fn_pointer_spelling_of(fn_tid, let_node_of("n"))
    assert_eq_str("metavar spelling", got, "")
    assert_ice_saying("metavar", -1, "UnspellableFnPointer", "unbound metavariable")
    assert_eq(ice_count(), before + 1)
}

test "a tid that is not a Fn is refused by name" {
    let program = probe("layout_fnptr_notfn", probe_src())
    assert(program >= 0)
    let before = ice_count()
    let got = fn_pointer_spelling_of(tid_of_let("n"), let_node_of("n"))
    assert_eq_str("Int as Fn", got, "")
    assert_ice_saying("not a Fn", -1, "NotAFnType", "Int")
    assert_eq(ice_count(), before + 1)
}

test "a parameter that declines is refused even when the result spells" {
    let program = probe("layout_fnptr_param_metavar", probe_src())
    assert(program >= 0)
    let fn_tid = make_fn_type(tid_of_let("n"), [make_metavar()])
    let before = ice_count()
    let got = fn_pointer_spelling_of(fn_tid, let_node_of("n"))
    assert_eq_str("metavar param spelling", got, "")
    assert_ice_saying("metavar param", -1, "UnspellableFnPointer", "unbound metavariable")
    assert_eq(ice_count(), before + 1)
}
