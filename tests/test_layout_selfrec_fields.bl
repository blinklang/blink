import std.fs
import std.io
import typecheck.{tc_type_str, tc_lookup_node_tid, check_types, make_enum_instance_type, make_struct_instance_type, make_tuple_type}
import layout.{field_embeds_owner, field_layout_of, layout_of, layout_reset, Position, SlotForm}
import parser.{nodes}
import compiler.{compile_to_program}
import cname_test_helpers.{assert_eq_str}

fn slot_form_name(f: SlotForm) -> Str {
    match f {
        SlotForm.Inline => "Inline"
        SlotForm.PointerBoxed => "PointerBoxed"
        SlotForm.InlineWord => "InlineWord"
    }
}

// Tree and Pair reach themselves (directly and through a tuple); LL is the non-generic
// shape; Holder embeds the same instances without being recursive itself.
fn probe_src() -> Str {
    #"type Tree[T] { Leaf(v: T), Node(l: Tree[T], r: Tree[T]) }
type Pair[T] { One(v: T), Two(p: (Pair[T], Pair[T])) }
type LL { Nil, Cons(h: Int, t: LL) }
type Box[T] { inner: T }
type Holder { t: Tree[Int], p: Pair[Int], l: LL }
fn main() {
    let i: Int = 1
    let ll: LL = LL.Nil
    let t: Tree[Int] = Tree.Leaf(1)
    let p: Pair[Int] = Pair.One(2)
    let bb: Box[Box[Int]] = Box { inner: Box { inner: 7 } }
    let h = Holder { t: t, p: p, l: ll }
    io.println("{i} {h.t.is_leaf()} {bb.inner.inner}")
}
"#
}

fn harvest_type_tids() -> Map[Str, Int] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/layout_selfrec_probe_src.bl"
    write_file(path, probe_src())
    let program = compile_to_program(path, 1)
    check_types(program)
    layout_reset()
    let _ = fs.delete(path)
    let mut m: Map[Str, Int] = Map()
    let mut idx = 0
    while idx < nodes.len() {
        let tid = tc_lookup_node_tid(idx)
        if tid >= 0 { m.insert(tc_type_str(tid), tid) }
        idx = idx + 1
    }
    m
}

fn expect_tid(m: Map[Str, Int], key: Str) -> Int {
    let tid = m.get(key) ?? -1
    if tid == -1 {
        io.println("FAIL: harvested map has no tid for rendered type string '{key}'")
    }
    assert(tid != -1)
    tid
}

fn assert_field(label: Str, owner_tid: Int, field_tid: Int, want_form: SlotForm, want_spelling: Str) {
    let rec = field_layout_of(owner_tid, field_tid)
    assert_eq_str("{label} decline", rec.decline_reason, "")
    assert_eq_str("{label} form", slot_form_name(rec.slot_form), slot_form_name(want_form))
    assert_eq_str("{label} spelling", rec.c_spelling, want_spelling)
}

// The same instance tid is boxed in its own enum and held by value anywhere else.
test "a self-recursive generic enum field is boxed only inside its own enum" {
    let m = harvest_type_tids()
    let tree_int = make_enum_instance_type("Tree", [expect_tid(m, "Int")])
    assert_field("Tree.Node.l in Tree", tree_int, tree_int, SlotForm.PointerBoxed, "int64_t")
    assert_field("Holder.t", expect_tid(m, "Holder"), tree_int, SlotForm.Inline, "blink_Tree_0Int")
    assert_eq_str("plain Field position is by value", layout_of(tree_int, Position.Field).c_spelling, "blink_Tree_0Int")
}

// A non-generic enum follows the same rule on its bare tid.
test "a self-recursive non-generic enum field is boxed only inside its own enum" {
    let m = harvest_type_tids()
    let ll = expect_tid(m, "LL")
    assert_field("LL.Cons.t in LL", ll, ll, SlotForm.PointerBoxed, "int64_t")
    assert_field("LL.Cons.h in LL", ll, expect_tid(m, "Int"), SlotForm.InlineWord, "int64_t")
    assert_field("Holder.l", expect_tid(m, "Holder"), ll, SlotForm.Inline, "blink_LL")
}

// A tuple that reaches the owner at any depth embeds it by value, so it is boxed too.
test "a tuple field that reaches its own enum is boxed only inside that enum" {
    let m = harvest_type_tids()
    let pair_int = make_enum_instance_type("Pair", [expect_tid(m, "Int")])
    let tup = make_tuple_type([pair_int, pair_int])
    let nested = make_tuple_type([expect_tid(m, "Int"), tup])
    assert_field("Pair.Two.p in Pair", pair_int, tup, SlotForm.PointerBoxed, "int64_t")
    assert_field("nested tuple in Pair", pair_int, nested, SlotForm.PointerBoxed, "int64_t")
    assert_field("same tuple in Holder", expect_tid(m, "Holder"), tup, SlotForm.Inline, "blink_Tuple2_Pair_0Int_Pair_0Int")
    assert_field("Pair.One.v in Pair", pair_int, expect_tid(m, "Int"), SlotForm.InlineWord, "int64_t")
}

// Box[Box[Int]] and Box[Int] share one declaration and are two types. The outer one is
// finite: it holds the inner one, which holds an Int and stops. So the member is held by
// value, and asking the question of the DECLARATION cannot tell that from real recursion,
// which is why the owner is named by its own tid.
test "a member at another instance of the owner's own declaration is held by value" {
    let m = harvest_type_tids()
    let box_int = make_struct_instance_type("Box", [expect_tid(m, "Int")])
    let box_box = make_struct_instance_type("Box", [box_int])
    assert_field("Box[Box[Int]].inner", box_box, box_int, SlotForm.Inline, "blink_Box_0Int")
    assert_field("Box[Int].inner", box_int, expect_tid(m, "Int"), SlotForm.InlineWord, "int64_t")
    assert_field("a box inside itself", box_int, box_int, SlotForm.PointerBoxed, "int64_t")
}

// The typedef emitter asks the same question to decide when a member's carriers may be
// written: a member that embeds its owner names the owner by value inside its carrier, so
// that carrier waits for the owner's typedef. One rule answers both.
test "field_embeds_owner agrees with the boxed field layout" {
    let m = harvest_type_tids()
    let pair_int = make_enum_instance_type("Pair", [expect_tid(m, "Int")])
    let tup = make_tuple_type([pair_int, pair_int])
    let nested = make_tuple_type([expect_tid(m, "Int"), tup])
    let holder = expect_tid(m, "Holder")
    assert(field_embeds_owner(pair_int, tup))
    assert(field_embeds_owner(pair_int, nested))
    assert(!field_embeds_owner(holder, tup))
    assert(!field_embeds_owner(pair_int, expect_tid(m, "Int")))
    assert(!field_embeds_owner(-1, tup))
}
