// The unit type is what `()` and an omitted return type both name. The spec calls it
// ordinary, inhabited and encodable: it has a value and a representation, so it can be
// returned, stored in a field, and used as a generic argument.
//
// Those are two different storage questions about one tid. As a return type the unit
// carries nothing a caller reads, so the C function answers void. Inside a carrier the
// unit is a stored member like any other, and it takes the one word the unit constant
// already emits. A member that declined here would leave `Result[(), Str]` with an Ok
// side that has no shape to write into.
import std.io
import layout.{layout_of, carrier_member_layout, layout_reset, Position, Slot, SlotForm}
import cname_test_helpers.{compile_probe, tid_of, assert_eq_str}
import typecheck.{TYPE_VOID}

fn src() -> Str {
    #"fn step() -> Result[(), Str] {
    Ok(())
}
fn done() -> () { }
fn main() {
    let r = step()
    let d = done()
}
"#
}

fn probe() -> Map[Str, Int] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let m = compile_probe("layout_unit", src())
    layout_reset()
    m
}

test "the unit type answers C void as a return type" {
    let _m = probe()
    assert_eq_str("unit return", layout_of(TYPE_VOID, Position.Return).c_spelling, "void")
}

test "the unit type is stored as one word inside a carrier" {
    let m = probe()
    let rec = carrier_member_layout(tid_of(m, "Result[Void, Str]"), Slot.Inner1)
    assert_eq_str("ok-side decline", rec.decline_reason, "")
    assert_eq_str("ok-side spelling", rec.c_spelling, "int64_t")
    assert(rec.slot_form == SlotForm.InlineWord)
}

test "the carrier's error side is unchanged beside a unit payload" {
    let m = probe()
    let rec = carrier_member_layout(tid_of(m, "Result[Void, Str]"), Slot.Inner2)
    assert_eq_str("err-side decline", rec.decline_reason, "")
    assert_eq_str("err-side spelling", rec.c_spelling, "const char*")
}
