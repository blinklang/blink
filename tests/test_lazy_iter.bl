// This file predates the two-worlds split (§3c.1). It once round-tripped through the lazy
// world with a trailing `.collect()`; under the eager collection surface those adapters
// (map/filter/take/skip/chain) are "collection in, collection out" and return a List
// directly, so the `.collect()` steps are gone and every test below is eager. The genuine
// lazy world (`.into_iter()...collect()`) is covered by test_iterator_lazy_world.bl.

test "eager map returns a list" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let doubled = nums.map(fn(x: Int) -> Int { x * 2 })
    assert_eq(doubled.len(), 5)
    assert_eq(doubled.get(0).unwrap(), 2)
}

test "eager filter returns a list" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let evens = nums.filter(fn(x: Int) -> Bool { x % 2 == 0 })
    assert_eq(evens.len(), 2)
}

test "chained eager adapters return a list" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let result = nums.map(fn(x: Int) -> Int { x * 2 }).filter(fn(x: Int) -> Bool { x > 6 })
    assert_eq(result.len(), 2)
}

test "chained eager adapters then fold" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let sum = nums.map(fn(x: Int) -> Int { x * 2 }).filter(fn(x: Int) -> Bool { x > 6 }).fold(0, fn(acc: Int, x: Int) -> Int { acc + x })
    assert_eq(sum, 18)
}

test "eager take returns a list" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let first3 = nums.take(3)
    assert_eq(first3.len(), 3)
}

test "eager skip returns a list" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let after2 = nums.skip(2)
    assert_eq(after2.len(), 3)
}

test "4-way eager adapter chain map filter take" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let chain4 = nums.map(fn(x: Int) -> Int { x * 10 }).filter(fn(x: Int) -> Bool { x > 20 }).take(2)
    assert_eq(chain4.len(), 2)
    assert_eq(chain4.get(0).unwrap(), 30)
}

test "count on an eager filter result" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    let c = nums.filter(fn(x: Int) -> Bool { x > 3 }).count()
    assert_eq(c, 2)
}

test "any over an eager map result" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    assert(nums.map(fn(x: Int) -> Int { x * 10 }).any(fn(x: Int) -> Bool { x == 30 }))
}

test "all over an eager filter result" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    assert(nums.filter(fn(x: Int) -> Bool { x > 2 }).all(fn(x: Int) -> Bool { x > 2 }))
}
