import compile_test_helpers

// A block value is first inferred from outside its own scope, where its block-locals are unbound,
// so a tail built from a block-local comes back partly open (`Option[?]`). The in-scope walk knows
// the full type. Codegen reads the type on the block node itself, so the full type has to land
// there, not only on the binding the block initializes.

test "an Option tail built from a block-local keeps its inner type" {
    let opt = {
        let p = "v"
        Some(p.concat("-a"))
    }
    assert_eq(opt.unwrap(), "v-a")
}

test "a Result tail built from a block-local keeps its ok type" {
    let r: Result[Str, Str] = {
        let p = "v"
        Ok(p.concat("-a"))
    }
    assert_eq(r.unwrap().len(), 3)
}

test "a List tail built from a block-local keeps its element type" {
    let xs = {
        let p = "v"
        [p.concat("-a"), p.concat("-b")]
    }
    assert_eq(xs.get(1).unwrap(), "v-b")
}

fn block_then_return() -> Option[Str] {
    let o = {
        let p = "v"
        Some(p.concat("-r"))
    }
    o
}

test "a let block whose binding is returned keeps its inner type" {
    assert_eq(block_then_return().unwrap(), "v-r")
}

// The in-scope walk cannot fill a hole the program never fills, so a truly open tail must still
// be reported, not quietly accepted.

test "an empty List tail with no later use still reports E0301" {
    let src = "fn main() \{\n    let xs = \{\n        let p = \"v\"\n        let _q = p.len()\n        []\n    }\n    io.println(\"\{xs.len()}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "let_block_tail_open_list", "E0301")
}

test "a None tail with no later use still reports E0301" {
    let src = "fn main() \{\n    let o = \{\n        let p = \"v\"\n        let _q = p.len()\n        None\n    }\n    io.println(\"\{o.is_some()}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "let_block_tail_open_none", "E0301")
}
