// A block expression used as a call ARGUMENT (here, an if-expr branch passed
// directly to a call) leaves its inner `let` binding and that let's nodes untyped,
// tripping the end-of-inference NodeCarriesNoType stamp check. The identical block
// shape typechecks fine when it is NOT in argument position (bound to a `let`
// first). This is a different mechanism from
// tests/test_unannotated_hof_closure_in_if_branch_argument.bl, whose gap is
// specific to an unannotated HOF closure inside the if-branch (tc_walk_nested_hof_bodies
// has no IfExpr arm) -- here there is no closure at all, just a plain `let` and its use.

import compile_test_helpers.{compile_and_run}

test "a let inside an if-branch used as a call argument is typed" {
    let src = #"
import std.io

fn take(n: Int) -> Int { n }

fn main() {
    let c = true
    let r = take(if c { let a = 2
        a + 1 } else { 0 })
    io.println("{r}")
}
"#
    let r = compile_and_run(src, "_let_inside_if_branch_call_argument")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
