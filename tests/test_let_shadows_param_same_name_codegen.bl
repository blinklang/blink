import compile_test_helpers

fn shadow_param_src() -> Str {
    #"fn norm(name: Str) -> Str {
    let name = name.concat("!")
    name
}

fn main() {
    io.println(norm("a"))
}
"#
}

test.failing(
    "a let that shadows a parameter of the same name compiles to valid C",
    reason: "codegen declares the let's C local in the same C scope as the parameter, so the emitted C redeclares the name as a different kind of symbol and cc rejects the program even though typecheck accepted it",
    ticket: "aehv7y",
) {
    let r = compile_test_helpers.compile_and_run(shadow_param_src(), "_shadow_param_same_name")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("a!"), "expected shadowed value in output: out={r.out}")
}
