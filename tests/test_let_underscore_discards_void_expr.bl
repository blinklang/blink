// `let _ = <expression of type Void>` compiles as a plain discard: the call
// still runs for its side effect, no invalid C declaration is emitted for it.

test "let _ discards a Void expression's value and still runs its side effect" {
    let mut n = 0
    let bump = fn() -> Void { n = n + 1 }
    let _ = bump()
    assert_eq(n, 1)
}
