// A let-bound generic-fn call returning Result[Void, E] must keep the
// Result[Void, E] carrier for the local, not collapse the Void arg to Int.

fn identity[T](x: T) -> T { x }

test "let-bound generic-fn call returning Result[Void, E] keeps the Void carrier" {
    let v: Result[Void, Str] = Ok(())
    let r = identity(v)
    assert(r.is_ok())
}
