// A lexer or parse error in an imported module is reported against that module's file and
// line, not against the entry file the build started from.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/imported_module_error_file"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn check_with_base(base_src: Str) -> ProcessResult {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"imported_module_error_file\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/src/base.bl", base_src)
    write_file("{DIR}/src/main.bl", ["import base.\{b\}", "", "fn main() \{", "    io.println(b())", "}", ""].join("\n"))
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && $B check --json src/main.bl")
    let _ = sh("rm -rf {DIR}")
    r
}

test "a lexer error in an imported module names that module's file" {
    let r = check_with_base(["pub fn b() -> Str \{", #"    "a\qb""#, "}", ""].join("\n"))
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains(#""code":"E1123""#), r.err_out)
    assert(r.err_out.contains(#""span":{"file":"src/base.bl","line":2,"col":7,"#), r.err_out)
}

test "a parse error in an imported module names that module's file" {
    let r = check_with_base(["pub fn b() -> Str \{", #"    "b""#, "}", "", "pub 5", ""].join("\n"))
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains(#""span":{"file":"src/base.bl","line":5,"#), r.err_out)
    assert(!r.err_out.contains(#""file":"src/main.bl","line""#), r.err_out)
}
