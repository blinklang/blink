// No @allow, [lints] entry or --strict setting suppresses or demotes a lexer error
// (sections/02_syntax.md §2.4, "Recovery"). A [lints] level of "off" or "warn", keyed by name
// or by code, leaves each one an error, and so does @allow on the enclosing function.

import compile_test_helpers
import std.process.{ProcessResult}

fn program() -> Str {
    [
        "@allow(UnexpectedCharacter, UnknownEscape, EmptyCharLiteral)",
        "fn main() \{",
        "    let x = 3;",
        #"    let s = "a\qb""#,
        #"    let c = ''"#,
        #"    io.println("{x}{s}{c.to_int()}")"#,
        "}",
        "",
    ].join("\n")
}

fn error_rows(output: Str, code: Str) -> Int {
    let mut n = 0
    for row in output.split("\n") {
        if row.contains("\"code\":\"{code}\"") && row.contains("\"severity\":\"error\"") { n = n + 1 }
    }
    n
}

test "a [lints] level of off or warn leaves each lexer error an error" {
    let lints = [
        "UnexpectedCharacter = \"off\"",
        "UnknownEscape = \"warn\"",
        "E1124 = \"off\"",
    ].join("\n")
    let out = compile_test_helpers.compile_pkg_and_capture(program(), lints, "lexer_lints_off")
    let _ = process_run("rm", ["-rf", ".tmp/lexer_lints_off"])
    assert_eq(error_rows(out, "E1113"), 1)
    assert_eq(error_rows(out, "E1123"), 1)
    assert_eq(error_rows(out, "E1124"), 1)
}

test "@allow and --strict leave each lexer error an error" {
    let path = ".tmp/_lexer_allow_strict.bl"
    write_file(path, program())
    let r = process_run("build/blink", ["check", "--json", "--strict", path])
    fs_remove(path)
    assert_eq(r.exit_code, 1)
    assert_eq(error_rows(r.err_out, "E1113"), 1)
    assert_eq(error_rows(r.err_out, "E1123"), 1)
    assert_eq(error_rows(r.err_out, "E1124"), 1)
}
