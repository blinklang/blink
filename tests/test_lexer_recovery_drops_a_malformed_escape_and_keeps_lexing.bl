// After a lexer error the lexer still emits the literal's token and keeps lexing (sections/
// 02_syntax.md §2.4, "Recovery"). In a string, a malformed escape is dropped whole, backslash
// and escaped char both, and the text after it stays. A bad char literal is one CharLit token
// holding U+FFFD, and the tokens after it are lexed as usual.

import lexer.{lex, token_count, tokens}
import tokens.{TokenKind, token_kind_name}
import diagnostics.{diag_reset, diag_count}

// Each token as "KIND [value]", joined by spaces, NEWLINE and EOF left out.
fn token_text() -> Str {
    let mut parts: List[Str] = []
    let mut i = 0
    while i < token_count() {
        let k = tokens.kinds.get(i).unwrap()
        if k != TokenKind.Newline && k != TokenKind.EOF {
            parts.push("{token_kind_name(k)} [{tokens.values.get(i).unwrap()}]")
        }
        i = i + 1
    }
    parts.join(" ")
}

test "a string with an unknown escape drops the whole escape and keeps the text after it" {
    diag_reset()
    lex(#"let s = "a\qb""#)
    assert_eq(diag_count, 1)
    assert_eq(token_text(), "let [let] IDENT [s] = [=] STRING_START [\"] STRING_PART [ab] STRING_END [\"]")
}

test "an unknown escape of a multi-byte char drops the whole char" {
    diag_reset()
    lex(#"let s = "x\éy""#)
    assert_eq(diag_count, 1)
    assert_eq(token_text(), "let [let] IDENT [s] = [=] STRING_START [\"] STRING_PART [xy] STRING_END [\"]")
}

test "a malformed numeric escape is dropped with its digits" {
    diag_reset()
    lex(#"let s = "a\x1bA\u{12g}b""#)
    assert_eq(diag_count, 2)
    assert_eq(token_text(), "let [let] IDENT [s] = [=] STRING_START [\"] STRING_PART [aAb] STRING_END [\"]")
}

test "a bad char literal is one CharLit holding U+FFFD and the next token still lexes" {
    diag_reset()
    lex(#"let c = 'ab' + 1"#)
    assert_eq(diag_count, 1)
    assert_eq(token_text(), "let [let] IDENT [c] = [=] CHAR_LIT [65533] + [+] INT [1]")
}

test "a char literal of a 2-byte or 4-byte character is one CharLit with its code point" {
    diag_reset()
    lex("let a = 'é'\nlet b = '😀'")
    assert_eq(diag_count, 0)
    assert_eq(token_text(), "let [let] IDENT [a] = [=] CHAR_LIT [233] let [let] IDENT [b] = [=] CHAR_LIT [128512]")
}
