// test_lint_overrides.bl — blink.toml [lints] severity overrides (spec §4.16.8)
//
// Each test stages a package under .tmp/<tag>/ and compiles the entry via
// blinkc with cwd at the repo root, so the manifest must be resolved from the
// package root of the compiled file, not the cwd (bug mxhpfj). Covers both
// W-code keys (the documented syntax) and PascalCase name keys.
import compile_test_helpers

// W0551-firing fixture: save/restore of `counter` plus an unrestored sibling
// mutation via set_name (same shape as test_mutation_analysis.bl).
fn w0551_src() -> Str {
    "let mut counter: Int = 0\nlet mut name: Str = \"\"\nfn increment() \{\n    counter = counter + 1\n}\nfn set_name(s: Str) \{\n    name = s\n}\nfn bad() \{\n    let saved_counter = counter\n    increment()\n    counter = saved_counter\n    set_name(\"oops\")\n}\nfn main() \{\n}\n"
}

test "code-keyed [lints] override upgrades W0551 to error" {
    let output = compile_test_helpers.compile_pkg_and_capture(w0551_src(), "W0551 = \"error\"", "lints_code_error")
    assert(output.contains("UnrestoredMutation"))
    assert(output.contains("\"severity\":\"error\""))
}

test "code-keyed [lints] override silences W0551" {
    let output = compile_test_helpers.compile_pkg_and_capture(w0551_src(), "W0551 = \"off\"", "lints_code_off")
    assert(!output.contains("UnrestoredMutation"))
}

test "name-keyed [lints] override upgrades W0551 to error" {
    let output = compile_test_helpers.compile_pkg_and_capture(w0551_src(), "UnrestoredMutation = \"error\"", "lints_name_error")
    assert(output.contains("UnrestoredMutation"))
    assert(output.contains("\"severity\":\"error\""))
}

test "@allow wins over code-keyed error override" {
    let src = w0551_src().replace("fn bad()", "@allow(UnrestoredMutation)\nfn bad()")
    let output = compile_test_helpers.compile_pkg_and_capture(src, "W0551 = \"error\"", "lints_allow_wins")
    assert(!output.contains("UnrestoredMutation"))
}
