// List.slice and Bytes.slice follow the one range rule of spec §3.2.1: a start below 0
// reads as 0, an end past the length reads as the length, and start >= end gives an empty
// result with no swap. A range read never panics on an out-of-range index.

fn bytes_of(xs: List[Int]) -> Bytes {
    let b = Bytes.new()
    for x in xs {
        b.push(x)
    }
    b
}

fn bytes_list(b: Bytes) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    while i < b.len() {
        out.push(b.get(i).unwrap())
        i = i + 1
    }
    out
}

test "List.slice gives the elements between in-range bounds" {
    let xs = [1, 2, 3, 4]
    assert_eq(xs.slice(1, 3), [2, 3])
    assert_eq(xs.slice(0, 4), xs)
}

test "List.slice reads an end past the length as the length" {
    let xs = [1, 2, 3]
    assert_eq(xs.slice(1, 99), [2, 3])
    assert_eq(xs.slice(0, 4), [1, 2, 3])
}

test "List.slice reads a negative start as zero, not from the end" {
    let xs = [1, 2, 3]
    assert_eq(xs.slice(-1, 2), [1, 2])
    assert_eq(xs.slice(-99, 99), [1, 2, 3])
}

test "List.slice gives an empty list when start >= end" {
    let xs = [1, 2, 3]
    let empty: List[Int] = []
    assert_eq(xs.slice(2, 1), empty)
    assert_eq(xs.slice(3, 0), empty)
    assert_eq(xs.slice(1, 1), empty)
    assert_eq(xs.slice(5, 9), empty)
    assert_eq(xs.slice(0, -1), empty)
}

test "List.slice of the empty list is empty" {
    let empty: List[Int] = []
    assert_eq(empty.slice(0, 3), empty)
    assert_eq(empty.slice(-1, 1), empty)
}

test "Bytes.slice gives the bytes between in-range bounds" {
    let b = bytes_of([10, 20, 30, 40])
    assert_eq(bytes_list(b.slice(1, 3)), [20, 30])
    assert_eq(bytes_list(b.slice(0, 4)), [10, 20, 30, 40])
}

test "Bytes.slice reads an end past the length as the length" {
    let b = bytes_of([10, 20, 30])
    assert_eq(bytes_list(b.slice(1, 99)), [20, 30])
    assert_eq(bytes_list(b.slice(0, 4)), [10, 20, 30])
}

test "Bytes.slice reads a negative start as zero, not from the end" {
    let b = bytes_of([10, 20, 30])
    assert_eq(bytes_list(b.slice(-1, 2)), [10, 20])
    assert_eq(bytes_list(b.slice(-99, 99)), [10, 20, 30])
}

test "Bytes.slice gives empty bytes when start >= end" {
    let b = bytes_of([10, 20, 30])
    assert_eq(b.slice(2, 1).len(), 0)
    assert_eq(b.slice(3, 0).len(), 0)
    assert_eq(b.slice(1, 1).len(), 0)
    assert_eq(b.slice(5, 9).len(), 0)
    assert_eq(b.slice(0, -1).len(), 0)
}

test "Bytes.slice of empty bytes is empty" {
    let b = Bytes.new()
    assert_eq(b.slice(0, 3).len(), 0)
    assert_eq(b.slice(-1, 1).len(), 0)
}
