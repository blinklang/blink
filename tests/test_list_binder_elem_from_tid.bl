// A match-arm binder over a List, where the scrutinee is a call-returned temp with no
// ScopeVar, fills its element channels through stamp_binder_elems_from_tid_if_unset. That
// filler used to ask a raw flat "was an element recorded?" signal off ScopeVar.inner1; the
// binder's own list tid, stamped one line earlier by pat_measure, already carries the element,
// so the tid is the honest signal. These rows exercise each list-element kind through such a
// binder and read the element back, so a filler that dropped or mis-typed the element on the
// tid-only path reads back corrupted.

@derive(Eq)
type Item { id: Int, tag: Str }

fn mk_ints() -> Option[List[Int]] {
    let mut l: List[Int] = []
    l.push(10)
    l.push(20)
    Some(l)
}

test "match binder over List[Int] from a call temp keeps the scalar element" {
    match mk_ints() {
        Some(xs) => {
            assert(xs.len() == 2)
            assert(xs.get(0).unwrap() == 10)
            assert(xs.get(1).unwrap() == 20)
        }
        None => { assert(false) }
    }
}

fn mk_opts() -> Option[List[Option[Int]]] {
    let mut l: List[Option[Int]] = []
    l.push(Some(7))
    l.push(None)
    Some(l)
}

test "match binder over List[Option[Int]] keeps the carrier element" {
    match mk_opts() {
        Some(xs) => {
            assert(xs.len() == 2)
            assert(xs.get(0).unwrap().unwrap() == 7)
            assert(xs.get(1).unwrap().is_none())
        }
        None => { assert(false) }
    }
}

fn mk_structs() -> Option[List[Item]] {
    let mut l: List[Item] = []
    l.push(Item { id: 1, tag: "a" })
    l.push(Item { id: 2, tag: "b" })
    Some(l)
}

test "match binder over List[Item] keeps the struct element" {
    match mk_structs() {
        Some(xs) => {
            assert(xs.len() == 2)
            assert(xs.get(0).unwrap().id == 1)
            assert(xs.get(1).unwrap().tag == "b")
        }
        None => { assert(false) }
    }
}

fn mk_tups() -> Option[List[(Int, Str)]] {
    let mut l: List[(Int, Str)] = []
    l.push((7, "seven"))
    Some(l)
}

test "match binder over List[(Int, Str)] keeps both tuple fields" {
    match mk_tups() {
        Some(xs) => {
            assert(xs.len() == 1)
            let first = xs.get(0).unwrap()
            assert(first.0 == 7)
            assert(first.1 == "seven")
        }
        None => { assert(false) }
    }
}
