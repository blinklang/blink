// sections/03_types.md §3.4 — "Blink has no index operator", and element access is `.get()`.
// Bracket-index syntax on a List is therefore not a valid program, and an invalid program must
// get a normal compile-time diagnostic, never an internal compiler error.

import compile_test_helpers.{compile_and_capture}

test "bracket-indexing a List is rejected with a normal diagnostic, not an internal compiler error" {
    let src = #"
import std.io

fn main() {
    let xs: List[Int] = [1, 2, 3]
    let y = xs[1]
    io.println("{y}")
}
"#
    let output = compile_and_capture(src, "_list_bracket_index_syntax_rejected_not_ice")
    assert(!output.contains("\"severity\":\"ice\""), "must not internal-compiler-error: {output}")
    assert(output.contains("\"severity\":\"error\""), "bracket indexing is not valid Blink and must be rejected: {output}")
    assert(output.contains("E0313"), "the rejection is NoIndexOperator: {output}")
}
