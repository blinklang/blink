// A List whose element is a carrier (List[Option[Point]] / List[Result[Point, Str]])
// holds the carrier in each slot, so get_list_elem_struct must NOT surface the inner
// struct name: a non-empty return means "this slot is a pointer-boxed struct — deref
// it", which would mis-type the carrier element. The inner struct is resolved through
// the unwrapped carrier, not through the list-element reader. These guard that field
// access through a list-of-carrier element still resolves across the
// List[Option[plain-struct]], List[Result[plain-struct, scalar]], and
// List[Option[generic-instance]] shapes.
type Point { x: Int, y: Int }
type Box[T] { value: T }

test "list of option plain-struct carrier resolves inner field access" {
    let xs: List[Option[Point]] = [Some(Point { x: 3, y: 7 })]
    let p = xs.get(0).unwrap().unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 7)
}

test "list of result plain-struct ok carrier resolves inner field access" {
    let xs: List[Result[Point, Str]] = [Ok(Point { x: 5, y: 9 })]
    match xs.get(0).unwrap() {
        Ok(p) => {
            assert_eq(p.x, 5)
            assert_eq(p.y, 9)
        }
        Err(_e) => assert_eq(0, 1)
    }
}

test "list of option generic-instance carrier resolves inner field access" {
    let xs: List[Option[Box[Int]]] = [Some(Box { value: 42 })]
    let b = xs.get(0).unwrap().unwrap()
    assert_eq(b.value, 42)
}
