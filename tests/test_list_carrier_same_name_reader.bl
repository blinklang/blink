// Locks the List-element compound-carrier readers against the name-reuse shape a
// tid-led reader guard changes behavior on. When a callee param reuses a caller
// local's name with a different List element type, the element readers
// (elem-type, elem-struct, elem-option-inner-tp, elem-result-ok-tp,
// elem-map-val-tp) must answer for the binding in scope at each read, never a
// stale outer one. Each row re-binds the list through `let g = <list>` so the
// deep element carries across via copy_list_compound_elem, then reads it back.
//
// The block-scoped counterpart (an inner block shadowing an outer list with a
// different element type) is a separate open codegen bug and is deliberately not
// exercised here — see the tracked ticket.

type Tag { label: Str }

fn opt_elem_label(xs: List[Option[Tag]]) -> Str {
    let g = xs
    g.get(0).unwrap().unwrap().label
}

fn mapval_elem(xs: List[Map[Str, Int]]) -> Int {
    let g = xs
    g.get(0).unwrap().get("k").unwrap()
}

fn result_elem_ok(xs: List[Result[Tag, Str]]) -> Str {
    let g = xs
    g.get(0).unwrap().unwrap().label
}

test "a callee list-of-option param named like a caller local reads its own inner" {
    let mut g: List[Int] = [1]
    let xs: List[Option[Tag]] = [Some(Tag { label: "t" })]
    assert_eq(opt_elem_label(xs), "t")
    assert_eq(g.get(0).unwrap(), 1)
}

test "a callee list-of-map param named like a caller local reads its own value" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 9)
    let mut g: List[Int] = [2]
    let xs: List[Map[Str, Int]] = [m]
    assert_eq(mapval_elem(xs), 9)
    assert_eq(g.get(0).unwrap(), 2)
}

test "a callee list-of-result param named like a caller local reads its ok struct" {
    let xs: List[Result[Tag, Str]] = [Ok(Tag { label: "r" })]
    let mut g: List[Int] = [3]
    assert_eq(result_elem_ok(xs), "r")
    assert_eq(g.get(0).unwrap(), 3)
}
