// The deep element type of a List whose element is itself a container
// (List[Map[K,V]], List[Option[T]], List[Result[O,E]], and nests of these)
// must survive a get()/for-in read. This shape historically lived only in the
// codegen tp_id cache — the flat inner1/inner2 ScopeVar slots cannot hold
// list -> map -> {k, v}. These rows pin the value/inner type the deep reader
// must reproduce so the tid alone can carry it. A lost inner mis-spells the
// nested get/unwrap and reads back the wrong value or fails to compile.

type LcPt { x: Int, y: Int }
type LcColor { Red, Green, Blue }

test "List[Map[Str,Int]] carries the scalar value through get" {
    let mut xs: List[Map[Str, Int]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 5)
    xs.push(m)
    let got = xs.get(0).unwrap()
    assert_eq(got.get("k").unwrap(), 5)
}

test "List[Map[Str,Int]] carries the value through a pushed untyped Map()" {
    let mut xs: List[Map[Str, Int]] = []
    let mut m = Map()
    m.insert("k", 9)
    xs.push(m)
    let got = xs.get(0).unwrap()
    assert_eq(got.get("k").unwrap(), 9)
}

test "List[Map[Str,Struct]] carries the struct value through get" {
    let mut xs: List[Map[Str, LcPt]] = []
    let mut m: Map[Str, LcPt] = Map()
    m.insert("o", LcPt { x: 1, y: 2 })
    xs.push(m)
    let p = xs.get(0).unwrap().get("o").unwrap()
    assert_eq(p.x, 1)
    assert_eq(p.y, 2)
}

test "List[Map[Str,Enum]] carries the enum value through get" {
    let mut xs: List[Map[Str, LcColor]] = []
    let mut m: Map[Str, LcColor] = Map()
    m.insert("c", LcColor.Green)
    xs.push(m)
    let ok = match xs.get(0).unwrap().get("c").unwrap() {
        LcColor.Green => { true }
        _ => { false }
    }
    assert(ok)
}

test "List[Option[Int]] carries the inner through get" {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(7))
    assert_eq(xs.get(0).unwrap().unwrap(), 7)
}

test "List[Option[Struct]] carries the struct inner through get" {
    let mut xs: List[Option[LcPt]] = []
    xs.push(Some(LcPt { x: 3, y: 4 }))
    let p = xs.get(0).unwrap().unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "List[Result[Int,Str]] carries both arms through get" {
    let mut xs: List[Result[Int, Str]] = []
    xs.push(Ok(11))
    xs.push(Err("bad"))
    let a = xs.get(0).unwrap()
    let ok = match a {
        Ok(v) => { v }
        Err(_) => { -1 }
    }
    assert_eq(ok, 11)
}

test "nested List[Option[Map[Int,Str]]] carries the inner map value" {
    let mut xs: List[Option[Map[Int, Str]]] = []
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "one")
    xs.push(Some(m))
    let inner = xs.get(0).unwrap().unwrap()
    assert_eq(inner.get(1).unwrap(), "one")
}

test "for-in over List[Map[Str,Int]] reads the scalar value" {
    let mut xs: List[Map[Str, Int]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 3)
    xs.push(m)
    let mut total = 0
    for row in xs {
        total = total + row.get("k").unwrap()
    }
    assert_eq(total, 3)
}

test "spread-copied List[Map[Str,Int]] keeps the value type" {
    let mut xs: List[Map[Str, Int]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 8)
    xs.push(m)
    let ys: List[Map[Str, Int]] = [..xs]
    assert_eq(ys.get(0).unwrap().get("k").unwrap(), 8)
}

test "an untyped empty Map() pushed first does not downgrade a List[Map[Str,Struct]] value" {
    let mut xs: List[Map[Str, LcPt]] = []
    xs.push(Map())
    let mut m2: Map[Str, LcPt] = Map()
    m2.insert("o", LcPt { x: 5, y: 6 })
    xs.push(m2)
    let p = xs.get(1).unwrap().get("o").unwrap()
    assert_eq(p.x, 5)
    assert_eq(p.y, 6)
}
