// gemr3z: a List whose element is itself a COMPOUND (Option/Result) erased the
// compound's inner type in codegen, producing invalid C. `List[List[Int]]`
// (nested container) worked, but `List[Option[Int]]` / `List[Result[T,E]]`
// emitted an undefined `blink_Option_option` iterator carrier and flattened the
// element's own compound level away at `.get()`.
//
// These are runtime asserts: they compile and run only if the element compound's
// inner type survives through get(), iteration, and nested match — reaching the
// asserts proves the element decode is correct.

test "List[Option[Int]] get + nested unwrap" {
    let c: List[Option[Int]] = [Some(9)]
    let outer = c.get(0)
    let inner = outer.unwrap()
    assert_eq(inner.unwrap(), 9)
}

test "List[Option[Int]] iteration + match" {
    let c: List[Option[Int]] = [Some(9), None, Some(4)]
    let mut sum = 0
    let mut nones = 0
    for item in c {
        match item {
            Some(v) => sum = sum + v
            None => nones = nones + 1
        }
    }
    assert_eq(sum, 13)
    assert_eq(nones, 1)
}

test "List[Option[Str]] iteration" {
    let c: List[Option[Str]] = [Some("a"), None, Some("b")]
    let mut acc = ""
    for item in c {
        match item {
            Some(s) => acc = acc.concat(s)
            None => acc = acc.concat("_")
        }
    }
    assert_eq(acc, "a_b")
}

test "List[Result[Int, Str]] iteration + match" {
    let c: List[Result[Int, Str]] = [Ok(7), Err("bad"), Ok(3)]
    let mut sum = 0
    let mut errs = 0
    for item in c {
        match item {
            Ok(v) => sum = sum + v
            Err(_e) => errs = errs + 1
        }
    }
    assert_eq(sum, 10)
    assert_eq(errs, 1)
}

test "List[Option[Int]] index + unwrap" {
    let c: List[Option[Int]] = [Some(42)]
    let g = c.get(0)
    match g {
        Some(inner) => {
            match inner {
                Some(v) => assert_eq(v, 42)
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Option[Int]] pop + nested unwrap" {
    let mut c: List[Option[Int]] = [Some(3), Some(9)]
    let popped = c.pop()
    let inner = popped.unwrap()
    assert_eq(inner.unwrap(), 9)
}

test "List[Result[Int, Str]] pop + match" {
    let mut c: List[Result[Int, Str]] = [Ok(1), Err("boom")]
    let popped = c.pop()
    match popped {
        Some(r) => match r {
            Ok(_v) => assert(false)
            Err(e) => assert_eq(e, "boom")
        }
        None => assert(false)
    }
}

test "List[Option[Int]] push then iterate + match" {
    let mut c: List[Option[Int]] = []
    c.push(Some(9))
    c.push(None)
    let mut sum = 0
    for item in c {
        match item {
            Some(v) => sum = sum + v
            None => sum = sum + 100
        }
    }
    assert_eq(sum, 109)
}

type IterPt { x: Int }

test "List[Option[struct]] iteration + match" {
    let c: List[Option[IterPt]] = [Some(IterPt { x: 7 }), None, Some(IterPt { x: 3 })]
    let mut sum = 0
    for item in c {
        match item {
            Some(p) => sum = sum + p.x
            None => sum = sum + 100
        }
    }
    assert_eq(sum, 110)
}
