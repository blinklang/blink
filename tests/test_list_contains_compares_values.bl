// `List[T].contains` answers whether some element is `==` to the one asked for, so it
// compares by the element type's own `==` (sections/03_types.md, *Container Equality*):
// by value for a nested collection, a tuple and an enum with no derive, by the derived or
// written method for a struct, and with NaN equal to NaN for a Float.

@derive(Eq)
type Point {
    x: Int
    y: Int
}

type Shape {
    Circle(r: Int)
    Label(text: Str)
    Dot
}

type Celsius {
    C(deg: Int)
}

impl Eq for Celsius {
    fn eq(self, other: Celsius) -> Bool {
        match self {
            Celsius.C(a) => match other {
                Celsius.C(b) => a / 10 == b / 10
            }
        }
    }
}

fn has[T: Eq](xs: List[T], x: T) -> Bool {
    xs.contains(x)
}

test "a list of structs that derive Eq compares fields" {
    let xs = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    assert(xs.contains(Point { x: 3, y: 4 }))
    assert(!xs.contains(Point { x: 3, y: 5 }))
    let empty: List[Point] = []
    assert(!empty.contains(Point { x: 1, y: 2 }))
}

test "a list of a type with a written Eq uses that method" {
    let xs = [Celsius.C(21)]
    assert(xs.contains(Celsius.C(25)))
    assert(!xs.contains(Celsius.C(31)))
}

test "a list of enums with no derive compares tag and payload" {
    let xs = [Shape.Dot, Shape.Circle(2), Shape.Label("a")]
    assert(xs.contains(Shape.Circle(2)))
    assert(!xs.contains(Shape.Circle(3)))
    assert(xs.contains(Shape.Label("a".concat(""))))
    assert(!xs.contains(Shape.Label("b")))
    assert([Shape.Circle(1)].contains(Shape.Circle(1)))
    assert(![Shape.Circle(1)].contains(Shape.Dot))
}

test "a list of lists compares each inner list by value" {
    let xs = [[1, 2], [3]]
    assert(xs.contains([3]))
    assert(xs.contains([1, 2]))
    assert(!xs.contains([2, 1]))
    assert(!xs.contains([]))
}

test "a list of maps ignores insertion order" {
    let mut a: Map[Str, Int] = Map()
    a.insert("x", 1)
    a.insert("y", 2)
    let mut b: Map[Str, Int] = Map()
    b.insert("y", 2)
    b.insert("x", 1)
    let mut c: Map[Str, Int] = Map()
    c.insert("x", 1)
    c.insert("y", 3)
    let xs = [a]
    assert(xs.contains(b))
    assert(!xs.contains(c))
}

test "a list of sets ignores insertion order" {
    let mut a: Set[Int] = Set()
    a.insert(1)
    a.insert(2)
    let mut b: Set[Int] = Set()
    b.insert(2)
    b.insert(1)
    let mut c: Set[Int] = Set()
    c.insert(1)
    c.insert(3)
    let xs = [a]
    assert(xs.contains(b))
    assert(!xs.contains(c))
}

test "a list of options compares the payload and finds None" {
    let xs: List[Option[Int]] = [Some(1), None]
    assert(xs.contains(Some(1)))
    assert(!xs.contains(Some(2)))
    let none: Option[Int] = None
    assert(xs.contains(none))
    let only_some: List[Option[Int]] = [Some(1)]
    assert(!only_some.contains(none))
    let lists: List[Option[List[Int]]] = [Some([1, 2])]
    assert(lists.contains(Some([1, 2])))
    assert(!lists.contains(Some([1])))
}

test "a list of tuples compares element by element" {
    let xs = [(1, "a"), (2, "b")]
    assert(xs.contains((2, "b")))
    assert(xs.contains((1, "a".concat(""))))
    assert(!xs.contains((2, "a")))
}

test "a list of floats finds NaN, since NaN == NaN" {
    let nan = 0.0 / 0.0
    let xs = [1.5, nan]
    assert(nan == nan)
    assert(xs.contains(nan))
    assert(xs.contains(1.5))
    assert(!xs.contains(2.5))
    assert(![1.5].contains(nan))
}

test "the four primitive element types still compare by value" {
    assert([1, 2, 3].contains(2))
    assert(![1, 2, 3].contains(4))
    assert([true].contains(true))
    assert(![true].contains(false))
    assert(["a", "b"].contains("b".concat("")))
    assert(!["a", "b"].contains("c"))
}

test "contains under a bounded type parameter compares by value" {
    assert(has([[1], [2]], [2]))
    assert(!has([[1], [2]], [3]))
    assert(has([Point { x: 1, y: 1 }], Point { x: 1, y: 1 }))
    assert(has([1, 2], 2))
}

test "the qualified spelling answers the same" {
    let xs = [Point { x: 1, y: 2 }]
    assert(ListOps.contains(xs, Point { x: 1, y: 2 }))
    assert(!ListOps.contains(xs, Point { x: 2, y: 1 }))
}
