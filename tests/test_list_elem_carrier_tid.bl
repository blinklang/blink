// A List whose ELEMENT is an Option/Result carrier must keep the element typed as
// the carrier (not collapsed to its inner leaf) across both access paths, so
// .unwrap()/match still resolve on the bound element. get_list_elem_struct must
// stay empty for a by-value carrier element — a non-empty answer marks a boxed
// struct handle and retypes the element to its inner leaf, which is wrong here.
// Behavioral guard for that boundary in the tid-sole-authority migration.

fn opt_elem_get() -> Int {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(7))
    xs.push(None)
    xs.get(0).unwrap().unwrap()
}

fn opt_elem_forin() -> Int {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(3))
    xs.push(Some(4))
    let mut acc = 0
    for o in xs {
        acc = acc + o.unwrap()
    }
    acc
}

fn res_elem_get() -> Int {
    let mut xs: List[Result[Int, Str]] = []
    xs.push(Ok(10))
    match xs.get(0).unwrap() {
        Ok(v) => v
        Err(_) => -1
    }
}

fn res_elem_forin() -> Int {
    let mut xs: List[Result[Int, Str]] = []
    xs.push(Ok(5))
    xs.push(Err("nope"))
    let mut acc = 0
    for r in xs {
        match r {
            Ok(v) => acc = acc + v
            Err(_) => acc = acc + 100
        }
    }
    acc
}

test "a List[Option[Int]] element carrier survives on get" {
    assert_eq(opt_elem_get(), 7)
}

test "a List[Option[Int]] element carrier survives on for-in" {
    assert_eq(opt_elem_forin(), 7)
}

test "a List[Result[Int, Str]] element carrier survives on get" {
    assert_eq(res_elem_get(), 10)
}

test "a List[Result[Int, Str]] element carrier survives on for-in" {
    assert_eq(res_elem_forin(), 105)
}
