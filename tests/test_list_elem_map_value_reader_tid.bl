// get_list_elem_map_val_struct now recovers a List[Map[K,V]] element-map value
// name from the list tid whenever the var carries one — the flat pool child2_sname
// stays only as the fallback for a no-tid projection temp. The tid path spells all
// three value shapes the pool used to catch, so the pool no longer answers for a
// tid-carrying var:
//
//   * a plain (non-generic) struct value — tc_tid_map_val_struct_mono declines
//     (params_count==0), so the struct HEAD reader answers.
//   * a generic-instance struct value (Box[Int]) — the mono stem answers.
//   * a tuple value — mono and head both decline, the tuple tag reader answers.
//
// Each row builds a List[Map[Str, V]], pushes a map, then reads the value back
// through .get()/.pop() + field access, driving the push carry, the List[Map].get()
// Option recovery, and the pop recovery. They must spell the value's C type from
// the tid path.

type Point { x: Int }
type Box[T] { value: T }

test "a plain-struct map value survives the List[Map].get chain" {
    let mut frames: List[Map[Str, Point]] = []
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 42 })
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get("k").unwrap().x, 42)
}

test "a plain-struct map value survives push-only inline construction" {
    let mut frames: List[Map[Str, Point]] = []
    let mut m = Map()
    m.insert("k", Point { x: 7 })
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get("k").unwrap().x, 7)
}

test "a generic-instance map value survives the List[Map].get chain" {
    let mut frames: List[Map[Str, Box[Int]]] = []
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 9 })
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get("k").unwrap().value, 9)
}

test "a tuple map value survives the List[Map].get chain" {
    let mut frames: List[Map[Str, (Int, Int)]] = []
    let mut m: Map[Str, (Int, Int)] = Map()
    m.insert("k", (3, 4))
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get("k").unwrap().0, 3)
}

test "a plain-struct map value survives the List[Map].pop chain" {
    let mut frames: List[Map[Str, Point]] = []
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 55 })
    frames.push(m)
    let popped = frames.pop().unwrap()
    assert_eq(popped.get("k").unwrap().x, 55)
}
