// Guards the tid-first list-element binding accessors get_list_elem_type /
// get_list_elem_struct (codegen_types.bl). The tid now leads on both the
// element CT and the element struct name, ceding to the flat tp_pool only on
// decline. Covers a plain-struct element, an aliased-scalar element (the tid
// peels the transparent alias), a generic-struct instance element (the tid
// leads with the mono stem Box_0Int, never the bare-head fallback), and a
// plain-enum element (stored by ordinal, then lifted by `.get` into a by-VALUE
// nominal Option carrier recovered from the result tid — get_list_elem_type
// keeps declining CT_ENUM so the flat ordinal arm still stands underneath).

type Point { x: Int, y: Int }
type Port = Int

type Color { Red, Green, Blue }

type Box[T] { value: T }

test "list of plain struct elems" {
    let mut ps: List[Point] = []
    ps.push(Point { x: 1, y: 2 })
    ps.push(Point { x: 3, y: 4 })
    assert_eq(ps.get(0).unwrap().x, 1)
    assert_eq(ps.get(1).unwrap().y, 4)
}

test "list of aliased-int elems" {
    let mut ports: List[Port] = []
    ports.push(8080)
    ports.push(443)
    assert_eq(ports.get(0).unwrap(), 8080)
    assert_eq(ports.get(1).unwrap(), 443)
}

test "list of generic struct instance elems" {
    let mut bs: List[Box[Int]] = []
    bs.push(Box { value: 10 })
    bs.push(Box { value: 20 })
    assert_eq(bs.get(0).unwrap().value, 10)
    assert_eq(bs.get(1).unwrap().value, 20)
}

test "list of plain enum elems" {
    let mut cs: List[Color] = []
    cs.push(Color.Green)
    cs.push(Color.Blue)
    let ok = match cs.get(0).unwrap() {
        Color.Red => 0
        Color.Green => 1
        Color.Blue => 2
    }
    assert_eq(ok, 1)
}
