// Regression: a list-element pattern binder ([f, ..]) used to declare f from
// one authority and unbox the element with a cast from another, so the two
// disagreed for every element kind except a scalar (struct: decl int64_t,
// cast a non-scalar pointer cast instead of a deref; Option: decl void; List:
// decl blink_list* vs an int64_t cast). Confirmed fixed on the pinned
// compiler for a struct element, an Option element, and a List element.

import compile_test_helpers.{compile_and_run}

test "a list-element pattern binder over a struct element reads its field correctly" {
    let src = #"
import std.io
type Cfg { port: Int, host: Str }
fn main() ! IO {
    let lc: List[Cfg] = [Cfg { port: 5, host: "h" }]
    match lc {
        [f, ..] => { io.println("{f.port}") }
        _ => { io.println("no") }
    }
}
"#
    let r = compile_and_run(src, "_list_element_pattern_binder_struct")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}

test "a list-element pattern binder over an Option element unwraps correctly" {
    let src = #"
import std.io
fn main() ! IO {
    let ol: List[Option[Int]] = [Some(1)]
    match ol {
        [g, ..] => { io.println("{g.unwrap()}") }
        _ => { io.println("no") }
    }
}
"#
    let r = compile_and_run(src, "_list_element_pattern_binder_option")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}

test "a list-element pattern binder over a List element reads its length correctly" {
    let src = #"
import std.io
fn main() ! IO {
    let ll: List[List[Int]] = [[1, 2, 3]]
    match ll {
        [h, ..] => { io.println("{h.len()}") }
        _ => { io.println("no") }
    }
}
"#
    let r = compile_and_run(src, "_list_element_pattern_binder_list")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
