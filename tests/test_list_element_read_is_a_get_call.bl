// Blink reads a List element with `.get(i)`, which answers an Option (sections/03_types.md §3.4
// *Postfix Brackets That Are Not a Type Application*). The bracket spelling `xs[1]` is E0313;
// the same read written as a method call runs and gives the element.

import std.io

fn main() {
    let xs: List[Int] = [1, 2, 3]
    let y = xs.get(1).unwrap()
    io.println("{y}")
}

test "a List element read through .get gives the element" {
    let xs: List[Int] = [1, 2, 3]
    assert_eq(xs.get(1).unwrap(), 2)
    assert_eq(xs.get(3), None)
}
