// `==` on lists reads both lengths again each turn, because an element's written Eq can change
// either list through an alias. The compare then has no fault to report, and a list that changed
// size under it is not equal to the other side.

type Clears { l: List[Clears] }

impl Eq for Clears {
    fn eq(self, _other: Clears) -> Bool {
        self.l.clear()
        true
    }
}

type ClearsOther { l: List[ClearsOther] }

impl Eq for ClearsOther {
    fn eq(self, other: ClearsOther) -> Bool {
        other.l.clear()
        true
    }
}

type Grows { l: List[Grows] }

impl Eq for Grows {
    fn eq(self, _other: Grows) -> Bool {
        self.l.push(self)
        true
    }
}

fn clears_on(xs: List[Clears]) -> List[Clears] {
    xs.push(Clears { l: xs })
    xs.push(Clears { l: xs })
    xs
}

test "a left list that shrinks in the compare is not equal to the right" {
    let xs = clears_on([])
    let inert: List[Clears] = []
    let ys = [Clears { l: inert }, Clears { l: inert }]
    assert_eq(xs == ys, false)
    assert_eq(xs.len(), 0)
}

test "a right list that shrinks in the compare is not equal to the left" {
    let inert: List[ClearsOther] = []
    let xs = [ClearsOther { l: inert }, ClearsOther { l: inert }]
    let mut ys: List[ClearsOther] = []
    ys.push(ClearsOther { l: ys })
    ys.push(ClearsOther { l: ys })
    assert_eq(xs == ys, false)
    assert_eq(ys.len(), 0)
}

test "a list compared with itself stops when it shrinks" {
    let xs = clears_on([])
    assert_eq(xs == xs, true)
}

test "a list that grows in the compare is not equal to the other side" {
    let mut xs: List[Grows] = []
    xs.push(Grows { l: xs })
    xs.push(Grows { l: xs })
    let inert: List[Grows] = []
    let ys = [Grows { l: inert }, Grows { l: inert }]
    assert_eq(xs == ys, false)
}

test "a shrink inside a nested list makes the outer compare false" {
    let xs = clears_on([])
    let inert: List[Clears] = []
    let ys = [Clears { l: inert }, Clears { l: inert }]
    assert_eq([xs] == [ys], false)
}

test "lists that do not change compare by their elements" {
    assert_eq([1, 2, 3] == [1, 2, 3], true)
    assert_eq([1, 2, 3] == [1, 2, 4], false)
    assert_eq([1, 2] == [1, 2, 3], false)
    let empty: List[Int] = []
    assert_eq(empty == [], true)
}
