// List[Errno].get() returns Option[Errno] over the std.errno transparent
// newtype. The element-carrier typedef for that Option instance must be
// emitted and the returned value must keep the Errno tag, not collapse to a
// bare Option[Int].

import std.errno.{Errno}

test "List[Errno].get() keeps the transparent-newtype Option carrier" {
    let xs = [Errno(3), Errno(4)]
    match xs.get(1) {
        Some(e) => match e {
            Errno(rc) => assert_eq(rc, 4)
        }
        None => assert(false)
    }
}
