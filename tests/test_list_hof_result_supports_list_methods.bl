// The result of List[T].filter()/.map() is a List[T] and supports every
// List method directly, without needing .collect() first.

test "filter() result supports .len() and .count()" {
    let ints = [1, 2, 3]
    let ki = ints.filter(fn(x: Int) -> Bool { x > 1 })
    assert_eq(ki.len(), 2)
    assert_eq(ints.filter(fn(x: Int) -> Bool { x > 1 }).len(), 2)
    assert_eq(ki.count(), 2)
}

test "map() result supports .get() and .len()" {
    let xs: List[Int] = [3, 1, 2]
    let dbl = xs.map(fn(v: Int) -> Int { v * 2 })
    let g = dbl.get(0)
    let n = dbl.len()
    assert_eq(n, 3)
    assert_eq(g.unwrap(), 6)
}
