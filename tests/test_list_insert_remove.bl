// List.insert(index, value) shifts the tail right; List.remove(index) shifts it left and
// returns the removed element (sections/03_types.md, the ListOps trait). remove answers a
// bare T rather than an Option, so an index out of range panics, with the same message an
// out-of-range `xs[i]` gives.

fn list_ints_text(xs: List[Int]) -> Str {
    xs.map(fn(x: Int) -> Str { "{x}" }).join(",")
}

test "insert at 0 shifts every element right" {
    let mut xs: List[Int] = [1, 2, 3]
    xs.insert(0, 9)
    assert_eq(list_ints_text(xs), "9,1,2,3")
}

test "insert in the middle shifts only the tail" {
    let mut xs: List[Int] = [1, 2, 3]
    xs.insert(1, 9)
    assert_eq(list_ints_text(xs), "1,9,2,3")
}

test "insert at len appends" {
    let mut xs: List[Int] = [1, 2, 3]
    xs.insert(3, 9)
    assert_eq(list_ints_text(xs), "1,2,3,9")
}

test "insert into an empty list at 0" {
    let mut xs: List[Int] = []
    xs.insert(0, 7)
    assert_eq(list_ints_text(xs), "7")
}

test "insert past the starting capacity grows the list" {
    let mut xs: List[Int] = List.with_capacity(1)
    let mut i = 0
    while i < 20 {
        xs.insert(0, i)
        i = i + 1
    }
    assert_eq(xs.len(), 20)
    assert_eq(xs[0], 19)
    assert_eq(xs[19], 0)
}

test "remove at 0 returns the head and shifts left" {
    let mut xs: List[Int] = [1, 2, 3]
    let r = xs.remove(0)
    assert_eq(r, 1)
    assert_eq(list_ints_text(xs), "2,3")
}

test "remove in the middle returns that element" {
    let mut xs: List[Int] = [1, 2, 3]
    let r = xs.remove(1)
    assert_eq(r, 2)
    assert_eq(list_ints_text(xs), "1,3")
}

test "remove the last element" {
    let mut xs: List[Int] = [1, 2, 3]
    let r = xs.remove(2)
    assert_eq(r, 3)
    assert_eq(list_ints_text(xs), "1,2")
}

test "remove on a List[Str] returns the Str" {
    let mut xs: List[Str] = ["a", "b", "c"]
    let r = xs.remove(0)
    assert_eq(r, "a")
    assert_eq(xs.join(","), "b,c")
}

test "insert on a List[Str]" {
    let mut xs: List[Str] = ["a", "c"]
    xs.insert(1, "b")
    assert_eq(xs.join(","), "a,b,c")
}

type ListIrPoint {
    x: Int
    y: Int
}

test "insert and remove on a list of structs keep each field" {
    let mut xs: List[ListIrPoint] = [ListIrPoint { x: 1, y: 2 }, ListIrPoint { x: 5, y: 6 }]
    xs.insert(1, ListIrPoint { x: 3, y: 4 })
    let r = xs.remove(0)
    assert_eq(r.x, 1)
    assert_eq(r.y, 2)
    assert_eq(xs.len(), 2)
    assert_eq(xs[0].x, 3)
    assert_eq(xs[0].y, 4)
    assert_eq(xs[1].x, 5)
}

test "insert then remove round-trips" {
    let mut xs: List[Int] = [1, 2, 3]
    xs.insert(2, 8)
    let r = xs.remove(2)
    assert_eq(r, 8)
    assert_eq(list_ints_text(xs), "1,2,3")
}

test "insert past len panics" {
    assert_panics(matching: "list index out of bounds: idx=4 len=3") {
        let mut xs: List[Int] = [1, 2, 3]
        xs.insert(4, 9)
    }
}

test "insert at a negative index panics" {
    assert_panics(matching: "list index out of bounds: idx=-1 len=3") {
        let mut xs: List[Int] = [1, 2, 3]
        xs.insert(-1, 9)
    }
}

test "remove at len panics" {
    assert_panics(matching: "list index out of bounds: idx=3 len=3") {
        let mut xs: List[Int] = [1, 2, 3]
        let _r = xs.remove(3)
    }
}

test "remove at a negative index panics" {
    assert_panics(matching: "list index out of bounds: idx=-1 len=3") {
        let mut xs: List[Int] = [1, 2, 3]
        let _r = xs.remove(-1)
    }
}

test "remove on an empty list panics" {
    assert_panics(matching: "list index out of bounds: idx=0 len=0") {
        let mut xs: List[Int] = []
        let _r = xs.remove(0)
    }
}
