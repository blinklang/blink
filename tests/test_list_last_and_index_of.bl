// `List[T].last` answers the last element and `List[T].index_of` the index of the first
// element `==` to the one asked for (sections/03_types.md, *The `ListOps` Trait*). Neither
// mutates, so an immutable binding is enough, and neither panics: an empty list, or no
// element equal, answers None.

@derive(Eq)
type Point {
    x: Int
    y: Int
}

type Celsius {
    C(deg: Int)
}

impl Eq for Celsius {
    fn eq(self, other: Celsius) -> Bool {
        match self {
            Celsius.C(a) => match other {
                Celsius.C(b) => a / 10 == b / 10
            }
        }
    }
}

fn find_in[T: Eq](xs: List[T], x: T) -> Option[Int] {
    xs.index_of(x)
}

test "last and index_of on an immutable list of Ints" {
    let xs: List[Int] = [3, 1, 2]
    assert_eq(xs.last(), Some(2))
    assert_eq(xs.index_of(1), Some(1))
    assert_eq(xs.index_of(3), Some(0))
    assert_eq(xs.index_of(2), Some(2))
}

test "last and index_of on an immutable list of Strs" {
    let xs = ["a", "b", "c"]
    assert_eq(xs.last(), Some("c"))
    assert_eq(xs.index_of("b"), Some(1))
    assert_eq(xs.index_of("b".concat("")), Some(1))
}

test "an empty list answers None for both" {
    let ints: List[Int] = []
    assert_eq(ints.last(), None)
    assert_eq(ints.index_of(1), None)
    let strs: List[Str] = []
    assert_eq(strs.last(), None)
    assert_eq(strs.index_of("a"), None)
}

test "index_of answers None when no element is equal" {
    let xs = [1, 2, 3]
    assert_eq(xs.index_of(4), None)
    assert_eq(["a"].index_of("b"), None)
}

test "index_of answers the first of several equal elements" {
    let xs = [5, 7, 5, 7]
    assert_eq(xs.index_of(7), Some(1))
    assert_eq(xs.index_of(5), Some(0))
}

test "last on a single element list answers that element" {
    let xs = [9]
    assert_eq(xs.last(), Some(9))
}

test "last reads the element and leaves the list as it was" {
    let xs = [1, 2]
    let _ = xs.last()
    assert_eq(xs.len(), 2)
    assert_eq(xs.last(), Some(2))
}

test "index_of on a list of structs that derive Eq compares fields" {
    let xs = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 3, y: 4 }]
    assert_eq(xs.index_of(Point { x: 3, y: 4 }), Some(1))
    assert_eq(xs.index_of(Point { x: 3, y: 5 }), None)
}

test "last on a list of structs answers the last struct" {
    let xs = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let p = xs.last().unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
    let empty: List[Point] = []
    assert(empty.last().is_none())
}

test "index_of uses a written Eq" {
    let xs = [Celsius.C(5), Celsius.C(21)]
    assert_eq(xs.index_of(Celsius.C(25)), Some(1))
    assert_eq(xs.index_of(Celsius.C(31)), None)
}

test "a list of floats finds NaN, since NaN == NaN" {
    let nan = 0.0 / 0.0
    let xs = [1.5, nan, 2.5]
    assert_eq(xs.index_of(nan), Some(1))
    assert_eq(xs.index_of(2.5), Some(2))
    assert_eq([1.5].index_of(nan), None)
    assert(xs.last().unwrap() == 2.5)
}

test "last on a list of floats answers the float" {
    let xs = [1.5, 2.25]
    assert(xs.last().unwrap() == 2.25)
}

test "index_of through an Eq bound" {
    assert_eq(find_in([4, 5, 6], 6), Some(2))
    assert_eq(find_in(["x"], "y"), None)
}

test "the argument to index_of is evaluated once" {
    let mut calls = 0
    let xs = [1, 2, 3, 4]
    let i = xs.index_of({
        calls = calls + 1
        4
    })
    assert_eq(i, Some(3))
    assert_eq(calls, 1)
}

test "the qualified spelling answers the same" {
    let xs = [3, 1, 2]
    assert_eq(ListOps.last(xs), Some(2))
    assert_eq(ListOps.index_of(xs, 1), Some(1))
}

test "last and index_of on wider elements: tuples, options and lists" {
    let pairs = [(1, "a"), (2, "b")]
    let p = pairs.last().unwrap()
    assert_eq(p.0, 2)
    assert_eq(pairs.index_of((2, "b")), Some(1))
    let opts: List[Option[Int]] = [Some(1), None]
    assert_eq(opts.last(), Some(None))
    assert_eq(opts.index_of(None), Some(1))
    let nested = [[1], [2, 3]]
    assert_eq(nested.last().unwrap().len(), 2)
    assert_eq(nested.index_of([2, 3]), Some(1))
}
