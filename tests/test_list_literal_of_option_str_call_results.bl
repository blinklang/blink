// A list literal whose elements are calls that answer Option[Str] holds each element in a
// temp of the element's own type when a later element needs statements run ahead of it.

test "a list literal of env.var results builds" {
    let xs = [env.var("BLINK_TEST_UNSET_A"), env.var("BLINK_TEST_UNSET_B")]
    assert_eq(xs, [None, None])
}

test "a list literal mixing a set and an unset variable keeps each element" {
    let xs = [env.var("PATH"), env.var("BLINK_TEST_UNSET_C"), env.var("PATH")]
    assert(xs.get(0).unwrap().is_some())
    assert(xs.get(1).unwrap().is_none())
    assert_eq(xs.get(0).unwrap(), xs.get(2).unwrap())
}
