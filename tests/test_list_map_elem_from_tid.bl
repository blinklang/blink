// A List[Map[K,V]]'s value type used to be recorded on a flat element-map channel by
// set_list_elem_map_types / set_list_elem_map_ann, fed from the Map[K,V] element annotation
// and re-derived on every push so an untyped Map() literal would not collapse V to Int. The
// authoritative list tid now carries the whole list->map->{k,v} shape, so those flat writers
// were write-only-dead. These rows exercise the shapes that path fed — a typed push, a bare
// Map() push into an annotated list, a struct-valued map, a copy, and an unannotated rebind —
// and read V back, so a lost value type reads as a collapsed element or fails to compile.

@derive(Eq)
type Item { id: Int, tag: Str }

test "annotated List[Map[Int,Str]] keeps its value type through a typed push" {
    let mut l: List[Map[Int, Str]] = []
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "one")
    l.push(m)
    assert(l.get(0).unwrap().get(1).unwrap() == "one")
}

test "annotated List[Map[Int,Str]] keeps V when a bare Map() is pushed" {
    let mut l: List[Map[Int, Str]] = []
    l.push(Map())
    l.get(0).unwrap().insert(9, "nine")
    assert(l.get(0).unwrap().get(9).unwrap() == "nine")
}

test "annotated List[Map[Int,Item]] keeps a struct value type" {
    let mut l: List[Map[Int, Item]] = []
    let mut m: Map[Int, Item] = Map()
    m.insert(1, Item { id: 7, tag: "seven" })
    l.push(m)
    assert(l.get(0).unwrap().get(1).unwrap().tag == "seven")
}

fn mk_maps() -> List[Map[Int, Str]] {
    let mut l: List[Map[Int, Str]] = []
    let mut m: Map[Int, Str] = Map()
    m.insert(2, "two")
    l.push(m)
    l
}

test "unannotated rebind of a List[Map[Int,Str]] keeps V" {
    let x = mk_maps()
    assert(x.get(0).unwrap().get(2).unwrap() == "two")
    let y = x
    assert(y.get(0).unwrap().get(2).unwrap() == "two")
}
