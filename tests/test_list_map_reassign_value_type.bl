// d7es5j: `= []` reassignment of an already-annotated List[Map[K,V]] var must
// not erase the element-map value type recorded at declaration.
//
// The element-map value type is recorded from the `List[Map[Str,Str]]`
// annotation at declaration. A bare `= []` Assignment resets the var's tp_id to
// a bare List, dropping the Map value type. When the list is then populated with
// an EMPTY `Map()` (no value type to re-derive on push), frames.get(i).unwrap()
// recovers Map[Str,Int] (value defaults to Int), so `frame.get(k) ?? ""` emits a
// const char* = int64_t mismatch (-Wint-conversion) — same class as wx184m, but
// on the reassignment path where the original annotation no longer covers.
//
// Pushing an empty Map() (not an annotated map) is load-bearing: an annotated
// pushed map re-records the element-map type via the push carry and masks the
// bug. This mirrors src/escape.bl ea_ptr_origin_frames, whose `= []` + push(Map())
// pattern needed a workaround annotation before this fix. Compiles AND runs.

let mut frames: List[Map[Str, Str]] = []

fn reset_frames() {
    frames = []
}

fn populate() {
    frames.push(Map())
    let top = frames.len() - 1
    let mut frame = frames.get(top).unwrap()
    frame.insert("k", "hello")
}

fn probe() -> Str {
    reset_frames()
    populate()
    let mut i = frames.len() - 1
    while i >= 0 {
        let frame = frames.get(i).unwrap()
        if frame.contains_key("k") {
            return frame.get("k") ?? "MISSING"
        }
        i = i - 1
    }
    "EMPTY"
}

test "module-level List[Map] survives '= []' reassignment with empty-map push" {
    assert_eq(probe(), "hello")
}
