// mvfd3m: a struct map-value type must survive the
// List[Map[K,Struct]].get().unwrap().get().unwrap() chain. Without the fix the
// struct value name never travels through set_list_elem_map_types / the push
// carry / the List[Map].get() recovery, so the recovered Map is typed
// Map[Str,Int] and `frame.get("k").unwrap().x` emits
// "request for member 'x' in something not a structure or union" in C.

type Point { x: Int }

// Annotated path: `let mut m: Map[Str, Point]` records the value struct on m,
// resolve_push_struct/push carry must forward it onto frames.
fn probe_annotated() -> Int {
    let mut frames: List[Map[Str, Point]] = []
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 42 })
    frames.push(m)
    let frame = frames.get(0).unwrap()
    let p = frame.get("k").unwrap()
    return p.x
}

// Push-only path: no `let`-typed `m`; the map is built inline so the list
// element struct value can only come from the push carry reading the pushed
// map's own value-struct metadata.
fn probe_push_only() -> Int {
    let mut frames: List[Map[Str, Point]] = []
    let mut m = Map()
    m.insert("k", Point { x: 7 })
    frames.push(m)
    let frame = frames.get(0).unwrap()
    let p = frame.get("k").unwrap()
    return p.x
}

test "List[Map[Str,Struct]] value type survives get/unwrap chain" {
    assert_eq(probe_annotated(), 42)
}

test "List[Map[Str,Struct]] value survives push-only construction" {
    assert_eq(probe_push_only(), 7)
}
