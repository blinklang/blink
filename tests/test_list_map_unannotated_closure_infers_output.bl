// A `map` / `flat_map` closure with no `-> U` produces the type its body computes, and the
// compiled program agrees: the list it builds holds that type, not the receiver's element.

fn chars2(s: Str) -> List[Str] { [s, s] }

fn wrap_all[T](xs: List[T]) -> List[Option[T]] { xs.map(fn(x) { Some(x) }) }

fn lengths_of(groups: List[List[Str]]) -> List[Int] {
    groups.map(fn(g) { g.map(fn(s) { s.len() }).fold(0, fn(a, n) { a + n }) })
}

test "a Str-producing map joins" {
    let s = [1, 2, 3].map(fn(v) { "n{v}" })
    assert_eq(s.join(","), "n1,n2,n3")
}

test "a tuple-producing map destructures in a for loop" {
    let pairs = ["a", "bb"].map(fn(w) { (w, w.len()) })
    let mut out = ""
    for (w, c) in pairs { out = "{out}{w}={c};" }
    assert_eq(out, "a=1;bb=2;")
}

test "a named fn passed to map keeps its return type" {
    let mut out = ""
    for row in ["ab", "c"].map(chars2) {
        for (i, c) in row.enumerate() { out = "{out}{i}{c} " }
    }
    assert_eq(out, "0ab 1ab 0c 1c ")
}

test "an unannotated flat_map flattens to the closure's element" {
    let parts = [1, 2].flat_map(fn(v) { ["{v}a", "{v}b"] })
    assert_eq(parts.join(","), "1a,1b,2a,2b")
}

test "an iterator map collects to the closure's type" {
    let got = [1, 2].into_iter().map(fn(v) { "<{v}>" }).collect()
    assert_eq(got.join(""), "<1><2>")
}

test "a chained map reads the first map's output" {
    let got = [1, 2].map(fn(v) { "{v}" }).map(fn(s) { s.len() + 10 })
    assert_eq(got.fold(0, fn(a, n) { a + n }), 22)
}

test "a map nested inside a closure infers its own output" {
    assert_eq(lengths_of([["a", "bb"], ["ccc"]]), [3, 3])
}

test "a generic body maps to an Option of its typevar" {
    let got = wrap_all([4, 5])
    assert_eq(got.len(), 2)
    assert_eq(got.get(1).unwrap().unwrap(), 5)
    let names = wrap_all(["x"])
    assert_eq(names.get(0).unwrap() ?? "none", "x")
}
