// wx184m: the Map VALUE type must survive List[Map[K,V]].get(i).unwrap().
// Without the inner-Map value-type metadata propagating through get()->unwrap(),
// the unwrapped Map is treated as Map[K,Int], so frame.get("k") is typed
// Option[Int] and `?? "default"` emits a pointer/integer mismatch in C
// (const char* = (tag==1 ? int_value : "default") -> -Wint-conversion).
//
// The MVCE deliberately omits the `let frame: Map[Str,Str]` annotation that
// masks the bug (the annotation forces value-type recovery via set_map_types).
// This is a codegen bug, so the test compiles AND runs to exercise the C build.

fn probe() -> Str {
    let mut frames: List[Map[Str, Str]] = []
    let mut m: Map[Str, Str] = Map()
    m.insert("k", "hello")
    frames.push(m)
    let mut i = frames.len() - 1
    while i >= 0 {
        let frame = frames.get(i).unwrap()
        if frame.contains_key("k") {
            return frame.get("k") ?? "MISSING"
        }
        i = i - 1
    }
    "EMPTY"
}

test "List[Map[Str,Str]].get().unwrap() preserves Str value type through ??" {
    assert_eq(probe(), "hello")
}
