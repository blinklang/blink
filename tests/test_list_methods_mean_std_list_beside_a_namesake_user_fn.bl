// A List method that stands for a std.list generic keeps meaning that generic when the
// program declares its own fn under the generic's name. Each pair below calls both: the
// method must run std.list's body, and the direct call must run the program's.

import std.map

fn list_flat_map[T, U](xs: List[T], f: fn(T) -> List[U]) -> List[U] {
    let mut out: List[U] = []
    for x in xs {
        for y in f(x) { out.push(y) }
    }
    out.push(f(xs.get(0).unwrap()).get(0).unwrap())
    out
}

fn list_map[T, U](xs: List[T], f: fn(T) -> U) -> List[U] {
    let mut out: List[U] = []
    for x in xs { out.push(f(x)) }
    out.push(f(xs.get(0).unwrap()))
    out
}

fn list_filter[T](xs: List[T], keep: fn(T) -> Bool) -> List[T] {
    let mut out: List[T] = []
    for x in xs {
        if !keep(x) { out.push(x) }
    }
    out
}

fn list_fold[T, U](xs: List[T], init: U, f: fn(U, T) -> U) -> U {
    let _ = xs
    let _ = f
    init
}

fn list_sort[T: Ord](xs: List[T]) -> List[T] { xs }

fn list_enumerate[T](xs: List[T]) -> List[(Int, T)] {
    let mut out: List[(Int, T)] = []
    for x in xs { out.push((-1, x)) }
    out
}

fn map_entries[K, V](m: Map[K, V]) -> List[(K, V)] {
    let _ = m
    []
}

test "an eager List adapter runs std.list beside a namesake fn" {
    let xs = [1, 2, 3]
    assert_eq(xs.flat_map(fn(x) { [x, x * 10] }).len(), 6)
    assert_eq(list_flat_map(xs, fn(x) { [x, x * 10] }).len(), 7)
    assert_eq(["a", "b"].flat_map(fn(s) { [s, s] }).len(), 4)
    assert_eq(list_flat_map(["a"], fn(s) { [s, s] }).len(), 3)
    assert_eq([3, 1, 2].sort().get(0) ?? 0, 1)
    assert_eq(list_sort([3, 1, 2]).get(0) ?? 0, 3)
    assert_eq(["x"].enumerate().get(0).unwrap().0, 0)
    assert_eq(list_enumerate(["x"]).get(0).unwrap().0, -1)
}

test "a sealed List HOF runs std.list beside a namesake fn" {
    let xs = [1, 2, 3]
    assert_eq(xs.map(fn(x) { x * 2 }).len(), 3)
    assert_eq(list_map(xs, fn(x) { x * 2 }).len(), 4)
    assert_eq(["a"].map(fn(s) { "{s}!" }).get(0) ?? "", "a!")
    assert_eq(xs.filter(fn(x) { x > 1 }).len(), 2)
    assert_eq(list_filter(xs, fn(x) { x > 1 }).len(), 1)
    assert_eq(xs.fold(0, fn(acc, x) { acc + x }), 6)
    assert_eq(list_fold(xs, 0, fn(acc, x) { acc + x }), 0)
}

test "a Map adapter runs std.map beside a namesake fn" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 1)
    assert_eq(m.entries().len(), 1)
    assert_eq(map_entries(m).len(), 0)
}
