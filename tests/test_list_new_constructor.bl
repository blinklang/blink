// `List.new()` builds an empty list (03_types.md:306). Its element type comes from the
// context or from later use, as an empty `[]` does (03_types.md:1435), and a binding that
// nothing pins is an under-determined type.

import compile_test_helpers
import std.io

fn expect_runs_printing(src: Str, tag: Str, want: Str) {
    let r = compile_test_helpers.compile_and_run(src, tag)
    if r.exit_code != 0 || r.out.trim() != want {
        io.println("FAIL: {tag} exit={r.exit_code} out={r.out} err={r.err_out}")
    }
    assert(r.exit_code == 0)
    assert(r.out.trim() == want)
}

// A rejected program must stop at a front-end code, never at an ICE from a later stage.
fn expect_rejected(src: Str, tag: Str, code: Str) -> Str {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "\"code\":\"{code}\"", tag)
    assert(!out.contains("\"severity\":\"ice\""))
    out
}

test "List.new takes its element type from the annotation" {
    expect_runs_printing(#"fn main() {
    let l: List[Int] = List.new()
    io.println("{l.len()}")
}
"#, "_list_new_annotated", "0")
}

test "List.new takes its element type from a later push" {
    expect_runs_printing(#"fn main() {
    let mut xs = List.new()
    xs.push(7)
    xs.push(35)
    let mut total = 0
    for x in xs {
        total = total + x
    }
    io.println("{xs.len()} {total}")
}
"#, "_list_new_push", "2 42")
}

test "List.new takes its element type from the declared return" {
    expect_runs_printing(#"fn names() -> List[Str] {
    let mut out = List.new()
    out.push("ada")
    out
}

fn main() {
    io.println(names().join(","))
}
"#, "_list_new_return", "ada")
}

test "List.new with nothing to pin its element type is under-determined" {
    expect_rejected(#"fn main() {
    let l = List.new()
    io.println("{l.len()}")
}
"#, "_list_new_unpinned", "E0301")
}

test "List.new given two type arguments is rejected with the count" {
    let out = expect_rejected(#"fn main() {
    let l = List.new[Int, Str]()
    io.println("{l.len()}")
}
"#, "_list_new_type_arg_arity", "E0307")
    compile_test_helpers.expect_contains(out, "expects 1 type argument(s), 2 given", "List.new arity message")
}

test "List.new given an argument is rejected before codegen" {
    expect_rejected(#"fn main() {
    let l: List[Int] = List.new(5)
    io.println("{l.len()}")
}
"#, "_list_new_value_arity", "E0300")
}

test "List.new is not a const expression" {
    expect_rejected(#"const EMPTY: List[Int] = List.new()

fn main() {
    io.println("{EMPTY.len()}")
}
"#, "_list_new_const", "E0533")
}

// The compiler's own constructor answers before any declaration, so a program that declares
// the function the qualified spelling names cannot make the call typed as one and built as another.
test "a declared List_new does not take over the builtin constructor" {
    expect_runs_printing(#"fn List_new() -> List[Int] {
    [1, 2, 3]
}

fn main() {
    let l: List[Int] = List.new()
    io.println("{l.len()}")
}
"#, "_list_new_namesake", "0")
}

test "List with brackets and a call names List.new in its help" {
    let out = expect_rejected(#"fn main() {
    let l = List[Int]()
    io.println("{l.len()}")
}
"#, "_list_new_help", "E0504")
    compile_test_helpers.expect_contains(out, "`List.new()`", "List help names List.new")
    compile_test_helpers.expect_contains(out, "`[]`", "List help still names the empty list literal")
}
