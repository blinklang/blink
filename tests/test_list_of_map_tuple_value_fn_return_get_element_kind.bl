// A List[Map[Str,(Int,Int)]] value returned directly from a fn (a projection
// temp with no ScopeVar tid) has its element type defaulted to Int by .get(),
// because the upstream receiver stamp bails for a tuple map value, leaving the
// flat element-type channel unset. The following .unwrap() then declares
// blink_Option_map = blink_Option_int, which the C compiler rejects.

import compile_test_helpers.{compile_and_run}

test.failing(
    "List of Map with a tuple value returned from a fn keeps Map as the .get() element kind",
    reason: "for a List[Map[Str,(Int,Int)]] value returned directly from a fn, the receiver stamp that records the list element kind bails for a tuple map value, so .get() defaults the element kind to Int (blink_Option_int) instead of Map (blink_Option_map), and the following .unwrap() declares a mismatched carrier, causing a C compile error",
    ticket: "4sbf3a",
) {
    let src = #"
import std.io

fn frames() -> List[Map[Str, (Int, Int)]] {
    let mut fs: List[Map[Str, (Int, Int)]] = []
    let mut m: Map[Str, (Int, Int)] = Map()
    m.insert("k", (3, 4))
    fs.push(m)
    fs
}

fn main() ! IO {
    let frame = frames().get(0).unwrap()
    let v = frame.get("k").unwrap().0
    io.println("{v}")
}
"#
    let r = compile_and_run(src, "_list_of_map_tuple_value_fn_return_get_element_kind")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
