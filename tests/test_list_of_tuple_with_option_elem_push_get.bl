// A List whose element is a tuple containing a compound (Option) member
// supports push/get/unwrap like any other List element type.

test "push and get on List[(Int, Option[Int])] resolves methods and keeps the Option payload" {
    let mut l: List[(Int, Option[Int])] = []
    l.push((2, Some(3)))
    let e = l.get(0).unwrap()
    assert_eq(e.0, 2)
    assert_eq(e.1.unwrap(), 3)
}
