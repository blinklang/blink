// A List[Option[T]] where T is an @ffi.opaque NPO type must construct and
// list-pattern-match the same as any other Option element: the None slot is
// a bare null pointer, gated by a null check, never a `.tag` read on the
// pointer itself.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a list of Option of opaque list-pattern match reads the null-pointer niche, not dot-tag",
    reason: "scrut_opaque_inner never fires for a list element, so the NPO guard is skipped and the match reads `.tag` directly on the bare opaque pointer, which cc rejects",
    ticket: "1a2hk6",
) {
    let src = #"
import std.io

@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile

fn main() ! IO {
    let xs: List[Option[CFile]] = [None, None]
    match xs {
        [Some(h), None] => io.println("some")
        _ => io.println("no")
    }
}
"#
    let r = compile_and_run(src, "_list_option_ffi_opaque_pattern_match")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "no\n")
}
