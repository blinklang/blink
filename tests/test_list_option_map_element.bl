// A List whose element is Option[Map[K,V]] is a carrier-over-carrier-over-Map.
// The list-get spelled its result Option-carrier with the Map inner ERASED to the
// bare head (blink_Option_Option_int) while the .unwrap() chain demanded
// blink_Option_Option_map, so the deref hit a non-struct scalar and cc rejected it.
// The Map value nested two carriers deep (List -> Option -> Map) must keep its
// identity at the get producer site, not collapse to Int.

fn get_it() -> Int {
    let mut xs: List[Option[Map[Str, Int]]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 9)
    xs.push(Some(m))
    xs.get(0).unwrap().unwrap().get("k").unwrap()
}

test "List[Option[Map[Str,Int]]] element keeps its Map inner through get/unwrap" {
    assert_eq(get_it(), 9)
}
