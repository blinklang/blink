// tavvwj (declined, already fixed): a let bound to List[Option[T]].get()/.pop()
// must keep the inner Option, so both .unwrap()-chaining and match binding see
// Option[T], not a flattened one-level Option. Guards the reader-flip-sensitive
// two-level Option shape against silent latent-imprecision regression.

test "List[Option].get() let keeps the inner Option for method chaining" {
    let mut ys: List[Option[Int]] = []
    ys.push(Some(7))
    let outer = ys.get(0)
    let inner = outer.unwrap()
    assert_eq(inner.is_some(), true)
    assert_eq(inner.unwrap(), 7)
}

test "List[Option].pop() let keeps the inner Option for nested match binding" {
    let mut ys: List[Option[Int]] = []
    ys.push(Some(7))
    let outer = ys.pop()
    let mut got = 0
    match outer {
        Some(inner) => {
            match inner {
                Some(v) => { got = v }
                None => { got = -1 }
            }
        }
        None => { got = -2 }
    }
    assert_eq(got, 7)
}
