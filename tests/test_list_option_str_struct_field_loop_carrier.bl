// Reading a List[Option[Str]] STRUCT FIELD through a for-loop must keep the
// Option[Str] carrier for the loop variable, not degrade it to Option[Int].
// The same shape works fine as a bare local; the degradation is specific to
// reaching the list through a struct field.

import compile_test_helpers.{compile_and_run}

test.failing(
    "for-loop over a struct field's List[Option[Str]] keeps the Str carrier",
    reason: "the loop variable's carrier is lowered as blink_Option_int instead of blink_Option_str, so cc rejects the emitted assignment",
    ticket: "95zr3e",
) {
    let src = #"
type H { xs: List[Option[Str]] }
fn main() ! IO {
    let h: H = H { xs: [None, Some("wxyz")] }
    let mut seen = ""
    for o in h.xs {
        if o.is_some() { seen = o.unwrap() }
    }
    io.println(seen)
}
"#
    let r = compile_and_run(src, "_list_option_str_struct_field_loop_carrier")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "wxyz\n")
}
