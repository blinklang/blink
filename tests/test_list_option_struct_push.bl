// `List[Option[Struct]].push(Some(struct))` must keep the struct inner on the list element
// carrier. The flat `set_list_elem_type(CT_OPTION)` the push ran collapsed the element Option's
// inner back to the default Int, so a later `.get(i)` minted `blink_Option_Option_int` (reading
// the boxed `blink_Option_Item*` as an int) and `.unwrap().unwrap().<field>` read garbage.
// The push must thread the pushed value's Option inner (struct/enum) onto the list element,
// mirroring the CT_MAP / CT_SET carries that already sit alongside it.

import compile_test_helpers

// Annotated list: the annotation already recorded Option[Item]; the push must not clobber it.
fn annotated_src() -> Str {
    #"import std.io

type Item {
    name: Str
    count: Int
}

fn main() {
    let mut xs: List[Option[Item]] = []
    xs.push(Some(Item { name: "plum", count: 3 }))
    let r = xs.get(0).unwrap()
    io.println("n={r.unwrap().name} c={r.unwrap().count}")
}
"#
}

test "push onto an annotated List[Option[Struct]] keeps the struct inner" {
    let r = compile_test_helpers.compile_and_run(annotated_src(), "bbbwsx_annotated")
    if !r.out.contains("n=plum c=3") { compile_test_helpers.expect_contains(r.out, "n=plum c=3", "annotated push — got '{r.err_out}'") }
    assert(r.out.contains("n=plum c=3"))
    assert_eq(r.exit_code, 0)
}

// Unannotated list built purely by push: the pushed value's Option inner is the only source.
fn inferred_src() -> Str {
    #"import std.io

type Item {
    name: Str
    count: Int
}

fn main() {
    let mut xs = []
    xs.push(Some(Item { name: "kiwi", count: 9 }))
    let r = xs.get(0).unwrap()
    io.println("n={r.unwrap().name} c={r.unwrap().count}")
}
"#
}

test "push onto an inferred List[Option[Struct]] records the struct inner" {
    let r = compile_test_helpers.compile_and_run(inferred_src(), "bbbwsx_inferred")
    if !r.out.contains("n=kiwi c=9") { compile_test_helpers.expect_contains(r.out, "n=kiwi c=9", "inferred push — got '{r.err_out}'") }
    assert(r.out.contains("n=kiwi c=9"))
    assert_eq(r.exit_code, 0)
}

// A data-enum inner exercises the same carrier through the enum arm.
fn enum_src() -> Str {
    #"import std.io

type Shape {
    Circle(Int)
    Square(Int)
}

fn main() {
    let mut xs: List[Option[Shape]] = []
    xs.push(Some(Circle(7)))
    let r = xs.get(0).unwrap()
    let out = match r.unwrap() {
        Circle(n) => "circle {n}"
        Square(n) => "square {n}"
    }
    io.println("shape={out}")
}
"#
}

test "push onto a List[Option[Enum]] keeps the enum inner" {
    let r = compile_test_helpers.compile_and_run(enum_src(), "bbbwsx_enum")
    if !r.out.contains("shape=circle 7") { compile_test_helpers.expect_contains(r.out, "shape=circle 7", "enum push — got '{r.err_out}'") }
    assert(r.out.contains("shape=circle 7"))
    assert_eq(r.exit_code, 0)
}
