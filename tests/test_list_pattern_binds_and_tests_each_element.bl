// A list pattern in a match arm tests the list's length, then reads each named position.
// The length test runs first, so no element read reaches past the end of a shorter list.

type P { x: Int }

test "an exact-length list pattern binds each element" {
    let xs = [4, 5]
    let r = match xs {
        [a, b] => a * 10 + b
        _ => -1
    }
    assert_eq(r, 45)
}

test "an exact-length list pattern refuses a longer list" {
    let xs = [4, 5, 6]
    let r = match xs {
        [a, b] => a + b
        _ => -1
    }
    assert_eq(r, -1)
}

test "a rest list pattern binds the leading elements of a longer list" {
    let xs = [1, 2, 3]
    let r = match xs {
        [a, b, ..] => a + b
        _ => -1
    }
    assert_eq(r, 3)
}

test "a rest list pattern refuses an empty list before reading an element" {
    let xs: List[Int] = []
    let r = match xs {
        [a, ..] => a
        _ => -1
    }
    assert_eq(r, -1)
}

test "an empty list pattern matches only the empty list" {
    let e: List[Int] = []
    let f = [1]
    let re = match e {
        [] => 1
        _ => 0
    }
    let rf = match f {
        [] => 1
        _ => 0
    }
    assert_eq(re * 10 + rf, 10)
}

// A literal inside a carrier element makes that element's test read the element twice:
// once for its tag, once for its payload.
test "a list pattern tests a carrier element's tag and payload" {
    let xs: List[Option[Int]] = [Some(7), Some(8)]
    let ys: List[Option[Int]] = [Some(6), Some(8)]
    let rx = match xs {
        [Some(7), Some(b)] => b
        _ => -1
    }
    let ry = match ys {
        [Some(7), Some(b)] => b
        _ => -1
    }
    assert_eq(rx * 100 + ry, 799)
}

test "a list pattern binds a boxed struct element" {
    let xs = [P { x: 6 }, P { x: 7 }]
    let r = match xs {
        [a, b] => a.x * 10 + b.x
        _ => -1
    }
    assert_eq(r, 67)
}

test "a list pattern binds a nested list element" {
    let xs = [[1, 2], [3]]
    let r = match xs {
        [a, b] => a.len() * 10 + b.len()
        _ => -1
    }
    assert_eq(r, 21)
}

test "an as-pattern over a list pattern binds the whole list and its elements" {
    let xs = [2, 3, 9]
    let r = match xs {
        w as [a, ..] => w.len() * 10 + a
        _ => -1
    }
    assert_eq(r, 32)
}

test "a closure in the arm reads a list-pattern binder" {
    let xs = [5, 6]
    let r = match xs {
        [a, b] => {
            let f = fn(k: Int) -> Int { k + a + b }
            f(1)
        }
        _ => -1
    }
    assert_eq(r, 12)
}
