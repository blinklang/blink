// A list pattern's binder DECLARATION is spelled from the sub-pattern's own tid
// (c_type_from_tid, via the IdentPattern arm), while its INITIALIZER cast came from the
// scrutinee's flat elem_type/elem_struct channels. Two producers for one initializer, so the
// two disagree for every element the flat pair cannot spell:
//
//     blink_list* b       = (int64_t)(intptr_t)blink_list_get(_scrut_3, 1);
//     blink_Option_int b  = (int64_t)(intptr_t)blink_list_get(_scrut_3, 1);
//     blink_P b           = (blink_P)(intptr_t)blink_list_get(_scrut_5, 1);
//
// all cc errors. The struct row is not a regression from the tid flip — the flat `elem_struct`
// arm that spells it has never produced a legal cast, because a list stores an aggregate
// BOXED and reads it back through `*(T*)`, which the `(T)(intptr_t)` form cannot express.
//
// Int and Str are the only two element shapes that ever worked, and they are the controls.

import compile_test_helpers

fn nested_list_src() -> Str {
    #"import std.io

fn main() {
    let xs: List[List[Int]] = [[1, 2], [3]]
    match xs {
        [a, b] => io.println("v={a.get(0).unwrap()}{b.len()}")
        _ => io.println("no")
    }
}
"#
}

test "a list pattern over List[List[T]] binds the element" {
    let r = compile_test_helpers.compile_and_run(nested_list_src(), "t8xr2m_nested")
    if !r.out.contains("v=11") { compile_test_helpers.expect_contains(r.out, "v=11", "List[List[Int]] pattern — got '{r.err_out}'") }
    assert(r.out.contains("v=11"))
}

fn option_elem_src() -> Str {
    #"import std.io

fn main() {
    let xs: List[Option[Int]] = [Some(4), Some(5)]
    match xs {
        [a, b] => io.println("v={a.unwrap()}{b.unwrap()}")
        _ => io.println("no")
    }
}
"#
}

test "a list pattern over List[Option[T]] binds the element" {
    let r = compile_test_helpers.compile_and_run(option_elem_src(), "t8xr2m_option")
    if !r.out.contains("v=45") { compile_test_helpers.expect_contains(r.out, "v=45", "List[Option[Int]] pattern — got '{r.err_out}'") }
    assert(r.out.contains("v=45"))
}

fn struct_elem_src() -> Str {
    #"import std.io

type P {
    x: Int
}

fn main() {
    let xs: List[P] = [P { x: 6 }, P { x: 7 }]
    match xs {
        [a, b] => io.println("v={a.x}{b.x}")
        _ => io.println("no")
    }
}
"#
}

test "a list pattern over List[Struct] binds the element" {
    let r = compile_test_helpers.compile_and_run(struct_elem_src(), "t8xr2m_struct")
    if !r.out.contains("v=67") { compile_test_helpers.expect_contains(r.out, "v=67", "List[P] pattern — got '{r.err_out}'") }
    assert(r.out.contains("v=67"))
}

fn map_elem_src() -> Str {
    #"import std.io

fn main() {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 8)
    let xs: List[Map[Str, Int]] = [m]
    match xs {
        [a] => io.println("v={a.get("k").unwrap()}")
        _ => io.println("no")
    }
}
"#
}

test "a list pattern over List[Map[K, V]] binds the element" {
    let r = compile_test_helpers.compile_and_run(map_elem_src(), "t8xr2m_map")
    if !r.out.contains("v=8") { compile_test_helpers.expect_contains(r.out, "v=8", "List[Map] pattern — got '{r.err_out}'") }
    assert(r.out.contains("v=8"))
}

// The two element shapes the flat pair could already spell. They pin that the tid-driven
// unbox keeps producing the inline `(int64_t)(intptr_t)` form for a scalar and the direct
// `(const char*)` form for a string, rather than boxing either.
fn scalar_src() -> Str {
    #"import std.io

fn main() {
    let xs: List[Int] = [1, 2]
    let ss: List[Str] = ["p", "q"]
    match xs {
        [a, b] => io.println("i={a}{b}")
        _ => io.println("no")
    }
    match ss {
        [c, d] => io.println("s={c}{d}")
        _ => io.println("no")
    }
}
"#
}

test "Int and Str list patterns keep working" {
    let r = compile_test_helpers.compile_and_run(scalar_src(), "t8xr2m_scalar")
    if !r.out.contains("i=12") { compile_test_helpers.expect_contains(r.out, "i=12", "List[Int] pattern — got '{r.err_out}'") }
    assert(r.out.contains("i=12"))
    assert(r.out.contains("s=pq"))
}
