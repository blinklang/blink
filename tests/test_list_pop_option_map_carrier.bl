// A List[Option[Map[K,V]]] popped to Option[Option[Map[K,V]]] must keep the nested
// Map's K/V through both carrier layers so the inner unwrap decodes the map value. This
// is the compound-inner Option carrier whose deep inner type the flat inner1/sname
// channels erase two carriers deep; the carrier's identity has to survive pop -> match ->
// unwrap. Locks the round-trip so the tid-authority migration of the Option inner-tp
// channel cannot silently regress a Map inner.

test "List[Option[Map]] pop keeps the nested map value type" {
    let mut xs: List[Option[Map[Str, Int]]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    m.insert("b", 2)
    xs.push(Some(m))
    let popped = xs.pop()
    match popped {
        Some(inner) => {
            match inner {
                Some(mm) => {
                    assert_eq(mm.get("a").unwrap(), 1)
                    assert_eq(mm.get("b").unwrap(), 2)
                }
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Option[Map]] get keeps the nested map value type" {
    let mut xs: List[Option[Map[Str, Int]]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 9)
    xs.push(Some(m))
    match xs.get(0).unwrap() {
        Some(mm) => assert_eq(mm.get("k").unwrap(), 9)
        None => assert(false)
    }
}
