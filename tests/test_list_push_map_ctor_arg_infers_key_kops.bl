// A fresh Map() constructor passed as a call argument (List.push) must pick up
// its key type from the declared List[Map[K,V]] element type, not default to
// string-keyed comparison.

test "push(Map()) into a declared List[Map[Int,Str]] infers Int-keyed kops" {
    let mut l: List[Map[Int, Str]] = []
    l.push(Map())
    l.get(0).unwrap().insert(256, "lo")
    l.get(0).unwrap().insert(512, "hi")

    let m = l.get(0).unwrap()
    assert_eq(m.len(), 2)
    assert_eq(m.get(256).unwrap(), "lo")
    assert_eq(m.get(512).unwrap(), "hi")
}
