import compile_test_helpers.{compile_and_run, compile_and_run_test_json_opt}

// The runtime's list reads (index, `.get(i)`, `.len()`) are inlined into the program that
// calls them rather than called in the stdlib archive. Every row here compiles against the
// archive, the way `blink build` links a program, so it reads the inlined copies: they must
// answer the same values, panic with the same text, and exit with the same code.

test "an out-of-bounds list index panics with the exact message and exit code" {
    let src = #"
fn pick(xs: List[Int], i: Int) -> Int { xs[i] }
fn main() ! IO {
    let xs: List[Int] = [10, 20, 30]
    io.println("{pick(xs, 1)}")
    io.println("{pick(xs, 5)}")
}
"#
    let r = compile_and_run(src, "_list_reads_archive_oob_high")
    assert_eq(r.exit_code, 1)
    assert_eq(r.out, "20\n")
    assert_eq(r.err_out, "blink: list index out of bounds: idx=5 len=3\n")
}

test "a negative list index panics with the exact message and exit code" {
    let src = #"
fn pick(xs: List[Str], i: Int) -> Str { xs[i] }
fn main() ! IO {
    let xs: List[Str] = ["a", "b"]
    io.println(pick(xs, 0 - 1))
}
"#
    let r = compile_and_run(src, "_list_reads_archive_oob_negative")
    assert_eq(r.exit_code, 1)
    assert_eq(r.out, "")
    assert_eq(r.err_out, "blink: list index out of bounds: idx=-1 len=2\n")
}

test "indexing an empty list panics with len 0" {
    let src = #"
fn pick(xs: List[Int], i: Int) -> Int { xs[i] }
fn main() ! IO {
    let xs: List[Int] = []
    io.println("{pick(xs, 0)}")
}
"#
    let r = compile_and_run(src, "_list_reads_archive_oob_empty")
    assert_eq(r.exit_code, 1)
    assert_eq(r.err_out, "blink: list index out of bounds: idx=0 len=0\n")
}

test "in-range reads, checked reads at each edge, and lengths answer as before" {
    let src = #"
fn show(o: Option[Int]) -> Str {
    match o {
        Some(v) => "Some({v})"
        None => "None"
    }
}
fn main() ! IO {
    let xs: List[Int] = [10, 20, 30]
    let empty: List[Int] = []
    let words: List[Str] = ["x", "yy"]
    io.println("{xs[0]} {xs[2]} {words[1]}")
    io.println("{show(xs.get(0))} {show(xs.get(2))} {show(xs.get(3))} {show(xs.get(0 - 1))} {show(empty.get(0))}")
    io.println("{xs.len()} {empty.len()} {words.len()}")
    let s = "hello"
    let blank = ""
    io.println("{s.len()} {blank.len()} {words[1].len()}")
}
"#
    let r = compile_and_run(src, "_list_reads_archive_in_range")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "10 30 yy\nSome(10) Some(30) None None None\n3 0 2\n5 0 2\n")
}

// At -O2 the read is inlined into the test body itself, so the panic must still reach
// the dispatch an armed assert_panics catches.
test "an inlined out-of-bounds read at -O2 is still caught by assert_panics" {
    let src = "fn pick(xs: List[Int], i: Int) -> Int \{ xs[i] }\ntest \"t\" \{\n    assert_panics(matching: \"list index out of bounds: idx=3 len=3\") \{\n        let xs: List[Int] = [1, 2, 3]\n        let _v = pick(xs, 3)\n    }\n}\n"
    let r = compile_and_run_test_json_opt(src, "_list_reads_archive_oob_caught", "-O2")
    assert(r.out.contains("\"status\":\"passed\""), "{r.out}{r.err_out}")
}
