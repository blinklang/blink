import compile_test_helpers.{compile_and_run, expect_compile_error}

// The runtime's list reads (`.get(i)`, `.len()`) are inlined into the program that calls
// them rather than called in the stdlib archive. The in-range row compiles against the
// archive, the way `blink build` links a program, so it reads the inlined copies: they must
// answer the same values. Blink has no index operator, so the rows that once read past the
// end with `xs[i]` are now NoIndexOperator (E0313) before any read is built.

test "an out-of-bounds list index is NoIndexOperator at compile time" {
    let src = #"
fn pick(xs: List[Int], i: Int) -> Int { xs[i] }
fn main() ! IO {
    let xs: List[Int] = [10, 20, 30]
    io.println("{pick(xs, 1)}")
    io.println("{pick(xs, 5)}")
}
"#
    expect_compile_error(src, "_list_reads_archive_oob_high", "E0313")
}

test "a negative list index is NoIndexOperator at compile time" {
    let src = #"
fn pick(xs: List[Str], i: Int) -> Str { xs[i] }
fn main() ! IO {
    let xs: List[Str] = ["a", "b"]
    io.println(pick(xs, 0 - 1))
}
"#
    expect_compile_error(src, "_list_reads_archive_oob_negative", "E0313")
}

test "indexing an empty list is NoIndexOperator at compile time" {
    let src = #"
fn pick(xs: List[Int], i: Int) -> Int { xs[i] }
fn main() ! IO {
    let xs: List[Int] = []
    io.println("{pick(xs, 0)}")
}
"#
    expect_compile_error(src, "_list_reads_archive_oob_empty", "E0313")
}

test "in-range reads, checked reads at each edge, and lengths answer as before" {
    let src = #"
fn show(o: Option[Int]) -> Str {
    match o {
        Some(v) => "Some({v})"
        None => "None"
    }
}
fn main() ! IO {
    let xs: List[Int] = [10, 20, 30]
    let empty: List[Int] = []
    let words: List[Str] = ["x", "yy"]
    io.println("{xs.get(0).unwrap()} {xs.get(2).unwrap()} {words.get(1).unwrap()}")
    io.println("{show(xs.get(0))} {show(xs.get(2))} {show(xs.get(3))} {show(xs.get(0 - 1))} {show(empty.get(0))}")
    io.println("{xs.len()} {empty.len()} {words.len()}")
    let s = "hello"
    let blank = ""
    io.println("{s.len()} {blank.len()} {words.get(1).unwrap().len()}")
}
"#
    let r = compile_and_run(src, "_list_reads_archive_in_range")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "10 30 yy\nSome(10) Some(30) None None None\n3 0 2\n5 0 2\n")
}

// The read that once panicked inside an armed assert_panics is refused before it is built.
test "an out-of-bounds index read in a test body is NoIndexOperator at compile time" {
    let src = "fn pick(xs: List[Int], i: Int) -> Int \{ xs[i] }\ntest \"t\" \{\n    assert_panics(matching: \"list index out of bounds: idx=3 len=3\") \{\n        let xs: List[Int] = [1, 2, 3]\n        let _v = pick(xs, 3)\n    }\n}\n"
    expect_compile_error(src, "_list_reads_archive_oob_caught", "E0313")
}
