// 9s68gm (declined, no repro): List .slice() and list-concat .append() emit a
// bare list_slice/list_concat expr with no element stamping — the element
// metadata is recovered from the consumer's tid. Guard that the recovered
// element type survives an inline chain (no intermediate typed let), including
// the reader-flip-sensitive Option element. (.concat() is a Str-only method,
// not a list method — list concatenation is .append().)

test "List[List].append() keeps the nested list element" {
    let a: List[List[Int]] = [[1, 2], [3]]
    let b: List[List[Int]] = [[4, 5, 6]]
    let c = a.append(b)
    let mut total = 0
    for inner in c {
        for x in inner { total = total + x }
    }
    assert_eq(total, 21)
}

test "List[Option].append() keeps the inner Option through an inline chain" {
    let a: List[Option[Int]] = [Some(7), None]
    let b: List[Option[Int]] = [Some(9)]
    let c = a.append(b)
    let inner: Option[Int] = c.get(2).unwrap()
    assert_eq(inner.unwrap(), 9)
}

test "List[Option].slice() keeps the inner Option through an inline chain" {
    let a: List[Option[Int]] = [Some(7), None, Some(9)]
    let c = a.slice(1, 3)
    let inner: Option[Int] = c.get(1).unwrap()
    assert_eq(inner.unwrap(), 9)
}
