// `List[T].sort` is `fn(self) -> List[T]` and `List[T].sort_by` is
// `fn(self, fn(T, T) -> Ordering ! _) -> List[T] ! _` (sections/03_types.md, *The `ListOps`
// Trait*, *Sorting*). Each returns a sorted copy and leaves the receiver in its order. Both
// are stable, and a comparator that breaks the Ord laws still ends with each element once.

type Person { name: Str, age: Int }

// Ordered by `rank` alone, so two values with one rank and different tags compare Equal.
type Ranked { rank: Int, tag: Str }

impl Eq for Ranked {
    fn eq(self, other: Ranked) -> Bool { self.rank == other.rank }
}

impl Ord for Ranked {
    fn cmp(self, other: Ranked) -> Ordering { self.rank.cmp(other.rank) }
}

effect Keys {
    effect Lookup {
        fn key_of(x: Int) -> Int
    }
}

fn by_effect_key(xs: List[Int]) -> List[Int] ! Keys.Lookup {
    xs.sort_by(fn(a, b) { keys.key_of(a).cmp(keys.key_of(b)) })
}

fn ints_str(xs: List[Int]) -> Str {
    let mut parts: List[Str] = []
    for x in xs { parts.push("{x}") }
    parts.join(",")
}

fn tags_str(xs: List[Ranked]) -> Str {
    let mut parts: List[Str] = []
    for x in xs { parts.push(x.tag) }
    parts.join(",")
}

// A list of `n` values from a fixed linear congruential sequence, with runs of each shape.
fn mixed(n: Int) -> List[Int] {
    let mut out: List[Int] = []
    let mut seed = 12345
    let mut i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let shape = (i / 17) % 4
        if shape == 0 { out.push(seed % 1000) }
        if shape == 1 { out.push(i) }
        if shape == 2 { out.push(1000 - i) }
        if shape == 3 { out.push(seed % 5) }
        i = i + 1
    }
    out
}

fn is_sorted(xs: List[Int]) -> Bool {
    let mut i = 1
    while i < xs.len() {
        if xs.get(i - 1).unwrap() > xs.get(i).unwrap() { return false }
        i = i + 1
    }
    true
}

fn reversed(xs: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = xs.len()
    while i > 0 {
        i = i - 1
        out.push(xs.get(i).unwrap())
    }
    out
}

// A comparator that panics with `msg` instead of answering.
fn give_up(msg: Str) -> Ordering {
    let r: Result[Ordering, Str] = Err(msg)
    r.unwrap()
}

// How many times `x` occurs in `xs`.
fn occurrences(xs: List[Int], x: Int) -> Int {
    let mut n = 0
    for y in xs {
        if y == x { n = n + 1 }
    }
    n
}

// `a` and `b` hold the same values, each as many times.
fn same_multiset(a: List[Int], b: List[Int]) -> Bool {
    if a.len() != b.len() { return false }
    for x in a {
        if occurrences(a, x) != occurrences(b, x) { return false }
    }
    true
}

test "sort returns a sorted copy and leaves the receiver in its order" {
    let xs = [3, 1, 2]
    let ys = xs.sort()
    assert_eq(ints_str(ys), "1,2,3")
    assert_eq(ints_str(xs), "3,1,2")
}

test "sort_by returns a sorted copy and leaves the receiver in its order" {
    let xs = [3, 1, 2]
    let ys = xs.sort_by(fn(a, b) { b.cmp(a) })
    assert_eq(ints_str(ys), "3,2,1")
    assert_eq(ints_str(xs), "3,1,2")
}

test "sort and sort_by on Str, Float and Char elements" {
    let words = ["pear", "apple", "fig"]
    assert_eq(words.sort().join(","), "apple,fig,pear")
    let fs = [2.5, -1.0, 0.5]
    let sorted_fs = fs.sort()
    assert(sorted_fs.get(0).unwrap() == -1.0)
    assert(sorted_fs.get(1).unwrap() == 0.5)
    assert(sorted_fs.get(2).unwrap() == 2.5)
    let cs = ['c', 'a', 'b']
    let sorted_cs = cs.sort_by(fn(a, b) { a.cmp(b) })
    assert_eq("{sorted_cs.get(0).unwrap()}{sorted_cs.get(1).unwrap()}{sorted_cs.get(2).unwrap()}", "abc")
}

test "sort_by is stable on records with equal keys" {
    let people = [
        Person { name: "Bo", age: 30 },
        Person { name: "Al", age: 25 },
        Person { name: "Cy", age: 30 },
        Person { name: "Di", age: 25 },
        Person { name: "Ed", age: 30 },
    ]
    let by_age = people.sort_by(fn(a, b) { a.age.cmp(b.age) })
    let mut names: List[Str] = []
    for p in by_age { names.push(p.name) }
    assert_eq(names.join(","), "Al,Di,Bo,Cy,Ed")
    let oldest_first = people.sort_by(fn(a, b) { b.age.cmp(a.age) })
    let mut desc: List[Str] = []
    for p in oldest_first { desc.push(p.name) }
    assert_eq(desc.join(","), "Bo,Cy,Ed,Al,Di")
}

test "sort is stable through a user Ord impl" {
    let xs = [
        Ranked { rank: 2, tag: "a" },
        Ranked { rank: 1, tag: "b" },
        Ranked { rank: 2, tag: "c" },
        Ranked { rank: 1, tag: "d" },
        Ranked { rank: 0, tag: "e" },
    ]
    assert_eq(tags_str(xs.sort()), "e,b,d,a,c")
    assert_eq(tags_str(xs), "a,b,c,d,e")
}

test "sort keeps equal keys in input order over a long list" {
    let mut xs: List[Ranked] = []
    let mut i = 0
    while i < 200 {
        xs.push(Ranked { rank: (i * 7) % 3, tag: "{i}" })
        i = i + 1
    }
    let ys = xs.sort()
    let mut j = 1
    while j < ys.len() {
        let prev = ys.get(j - 1).unwrap()
        let cur = ys.get(j).unwrap()
        assert(prev.rank <= cur.rank)
        if prev.rank == cur.rank { assert(prev.tag.parse_int().unwrap() < cur.tag.parse_int().unwrap()) }
        j = j + 1
    }
}

test "sort on empty and one-element lists" {
    let empty: List[Int] = []
    assert_eq(empty.sort().len(), 0)
    assert_eq(empty.sort_by(fn(a, b) { a.cmp(b) }).len(), 0)
    let one = [7]
    assert_eq(ints_str(one.sort()), "7")
    assert_eq(ints_str(one.sort_by(fn(a, b) { a.cmp(b) })), "7")
}

test "sort over a long list of mixed runs" {
    let xs = mixed(500)
    let before = ints_str(xs)
    let ys = xs.sort()
    assert(is_sorted(ys))
    assert(same_multiset(xs, ys))
    assert_eq(ints_str(xs), before)
    let desc = xs.sort_by(fn(a, b) { b.cmp(a) })
    assert_eq(ints_str(desc), ints_str(reversed(ys)))
}

test "sort over runs that are already in order or in reverse order" {
    let mut up: List[Int] = []
    let mut down: List[Int] = []
    let mut i = 0
    while i < 150 {
        up.push(i)
        down.push(150 - i)
        i = i + 1
    }
    assert(is_sorted(up.sort()))
    assert(is_sorted(down.sort()))
    assert(same_multiset(down, down.sort()))
}

test "an inconsistent comparator still returns each element once" {
    let xs = mixed(300)
    let ys = xs.sort_by(fn(a, b) {
        if (a + b) % 3 == 0 { Less } else if (a * b) % 2 == 0 { Greater } else { Equal }
    })
    assert(same_multiset(xs, ys))
    let zs = xs.sort_by(fn(_a, _b) { Less })
    assert(same_multiset(xs, zs))
    let ws = xs.sort_by(fn(_a, _b) { Greater })
    assert(same_multiset(xs, ws))
}

test "the comparator's effect flows to the caller" {
    let ys = with handler Keys {
        fn key_of(x: Int) -> Int { 0 - x }
    } {
        by_effect_key([2, 3, 1])
    }
    assert_eq(ints_str(ys), "3,2,1")
}

test "a panicking comparator leaves the receiver unchanged" {
    let xs = [3, 1, 2]
    assert_panics(matching: "comparator") {
        let _ = xs.sort_by(fn(a, b) {
            if a == 1 || b == 1 { give_up("comparator gave up") } else { a.cmp(b) }
        })
    }
    assert_eq(ints_str(xs), "3,1,2")
}
