// A list spread copies each source element into the new list in the form a list cell
// holds it, the same form `push` writes. Each row reads the elements back by value, so a
// copy in the wrong form reads a different value instead of raising a diagnostic.

type SpPoint { x: Int, y: Int }

fn sp_three() -> List[Int] { [1, 2, 3] }

test "a spread copies Float elements" {
    let a = [1.5, 2.25]
    let b = [..a, 3.0]
    assert_eq(b.len(), 3)
    assert(b.get(0).unwrap() == 1.5)
    assert(b.get(1).unwrap() == 2.25)
    assert(b.get(2).unwrap() == 3.0)
}

test "a spread copies struct elements" {
    let a = [SpPoint { x: 1, y: 2 }]
    let b = [SpPoint { x: 0, y: 0 }, ..a]
    assert_eq(b.len(), 2)
    assert_eq(b.get(1).unwrap().x, 1)
    assert_eq(b.get(1).unwrap().y, 2)
}

test "a spread copies tuple elements" {
    let a = [(1, "one"), (2, "two")]
    let b = [..a]
    assert_eq(b.get(1).unwrap().0, 2)
    assert_eq(b.get(1).unwrap().1, "two")
}

test "a spread copies Option[Str] elements" {
    let a: List[Option[Str]] = [Some("hi"), None]
    let b = [..a, Some("end")]
    assert_eq(b.get(0).unwrap() ?? "", "hi")
    assert(b.get(1).unwrap().is_none())
    assert_eq(b.get(2).unwrap() ?? "", "end")
}

test "a spread copies nested list elements" {
    let a = [[1, 2], [3]]
    let b = [..a, [4, 5, 6]]
    assert_eq(b.len(), 3)
    assert_eq(b.get(0).unwrap().get(1).unwrap(), 2)
    assert_eq(b.get(2).unwrap().len(), 3)
}

test "a spread of a call result copies its elements" {
    let b = [0, ..sp_three(), 4]
    assert_eq(b.len(), 5)
    assert_eq(b.get(3).unwrap(), 3)
    assert_eq(b.get(4).unwrap(), 4)
}

test "a spread builds a new list that does not alias its source" {
    let mut a = [1, 2]
    let mut b = [..a]
    a.push(3)
    b.push(9)
    assert_eq(a.len(), 3)
    assert_eq(b.len(), 3)
    assert_eq(b.get(2).unwrap(), 9)
    assert_eq(a.get(2).unwrap(), 3)
}

test "the same source spread twice is copied twice in order" {
    let a = [7, 8]
    let b = [..a, 0, ..a]
    assert_eq(b.len(), 5)
    assert_eq(b.get(3).unwrap(), 7)
    assert_eq(b.get(4).unwrap(), 8)
}
