// Regression for br reeadb: a List[Str] struct field bound to an intermediate
// `let` must keep its Str element type. The field-access codegen path set the
// element type on the per-name registry but not the expr_list_elem_* globals,
// so emit_let_binding propagated a STALE element type (whatever list expression
// ran last) — here the outer List[Box], yielding a wrong unwrap carrier.

type Box { items: List[Str] }

test "List[Str] field via intermediate let keeps Str element type" {
    let boxes: List[Box] = [Box { items: ["alice", "bob"] }]
    let b = boxes.get(0).unwrap()
    let xs = b.items
    assert_eq(xs.get(0).unwrap(), "alice")
    assert_eq(xs.get(1).unwrap(), "bob")
    let msg = "name: {xs.get(0).unwrap()}"
    assert_eq(msg, "name: alice")
}
