// A List of a transparent-newtype element (Errno, a single-Int-payload enum
// that lowers to a bare int64_t) reads back correctly through .get().unwrap().

pub type Errno {
    Errno(Int)
}

test "list of transparent-newtype element reads back" {
    let l: List[Errno] = [Errno(1), Errno(2)]
    let e = l.get(0).unwrap()
    let rc = match e {
        Errno(r) => r
    }
    assert_eq(rc, 1)
}
