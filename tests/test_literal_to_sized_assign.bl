// Behavior-preservation test for assignment_types_compatible (br yxtd8w).
// An untyped integer literal RHS may flow into a sized-int target in both
// let-binding and assignment position; types_compatible alone rejects it.

fn main() {
    let a: U8 = 200        // literal -> sized in let-binding: OK
    let b: I32 = -7        // negative literal -> sized: OK
    let mut c: U16 = 0
    c = 65000              // literal -> sized in assignment: OK
    io.println("{a} {b} {c}")
}
