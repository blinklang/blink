// A literal tree in operand position takes the integer type of the other operand, on either
// side (sections/03_types.md §3.2 *Operator operands*). A literal tree is `K` in §3.6
// *Literal arithmetic overflow*: literals, parentheses, unary `-`, and `+ - * / % & | ^ << >>`.
// Each literal in the tree takes the type, the right operand of a shift is U32, and an
// operation in the tree that overflows at that type panics at run time.

import compile_test_helpers

fn u8_tree(a: U8) -> U8 { a * (2 + 3) }
fn u16_tree_left(a: U16) -> U16 { (1000 * 60) + a }
fn u32_tree_nested(a: U32) -> U32 { a - (1 + (2 * 3)) }
fn u64_mask(m: U64) -> U64 { m & (1 << 63) }
fn i8_neg_tree(x: I8) -> I8 { x + -(2 * 3) }
fn i32_div_tree(x: I32) -> I32 { (100000 / 4 % 7) + x }
fn i8_overflow(x: I8) -> I8 { (127 + 1) + x }
fn u8_overflow(u: U8) -> U8 { u + (200 + 100) }

test "a literal tree takes the other operand's type on either side" {
    assert_eq(u8_tree(3), 15)
    assert_eq(u16_tree_left(5), 60005)
    assert_eq(u32_tree_nested(10), 3)
    assert_eq(i8_neg_tree(10), 4)
    assert_eq(i32_div_tree(-10), -7)
    let a: U8 = 3
    let b = a * (40 + 40)
    assert_eq(b, 240)
}

test "a tree with a shift takes the other operand's type, with a U32 amount" {
    assert_eq(u64_mask(18446744073709551615), 9223372036854775808)
    let m: U64 = 9223372036854775809
    let g = m & (1 << 63)
    assert_eq(g, 9223372036854775808)
    let q: U64 = 1
    let s: U64 = q << (1 + 1)
    assert_eq(s, 4)
    let u: U8 = 1
    let f = u << (1 + 1)
    assert_eq(f, 4)
    assert_eq((1 << 7) | u, 129)
    let i: I32 = 1024
    assert_eq(i >> (2 * 2), 64)
}

test "a comparison passes the other operand's type to the tree" {
    let u: U8 = 199
    assert(u < (100 + 100))
    assert((100 + 100) > u)
    let m: U64 = 18446744073709551615
    assert(m == (18446744073709551614 + 1))
    let x: I8 = -6
    assert(x == -(2 * 3))
}

test "two literal trees with no expected type are Int" {
    let n = 1 + (2 * 3)
    let big: Int = 4611686018427387904
    assert_eq(n, 7)
    assert_eq((big + n) - (4611686018427387904 + 7), 0)
}

test "an expected integer type reaches both trees of an operator" {
    let w: U64 = (9223372036854775807 + 1) + (9223372036854775806 + 1)
    assert_eq(w, 18446744073709551615)
    let k: U8 = (100 + 100) + (25 + 30)
    assert_eq(k, 255)
}

test "a tree operation that overflows at the type it takes panics at run time" {
    assert_panics(matching: "I8 overflow in addition") {
        let _ = i8_overflow(0)
    }
    assert_panics(matching: "U8 overflow in addition") {
        let _ = u8_overflow(0)
    }
}

// `blink check` and the build report the same error for a tree, and neither stops at an
// internal error.
fn expect_check_and_build(tag: Str, src: Str, code: Str) {
    let checked = compile_test_helpers.check_via_cli(src, tag)
    let built = compile_test_helpers.compile_and_capture(src, tag)
    for out in [checked, built] {
        compile_test_helpers.expect_error(out, code, tag)
        assert(!out.contains("internal compiler error"))
        assert(!out.contains("\"severity\":\"ice\""))
    }
}

test "check and build agree on a tree error" {
    expect_check_and_build("tree_too_big", "fn f(u: U8) -> U8 \{ u + (300 - 100) }\nfn main() \{ io.println(\"\{f(1)}\") }\n", "E0318")
    expect_check_and_build("tree_shift_amount", "fn f(q: U64) -> U64 \{ q << (4294967296 - 1) }\nfn main() \{ io.println(\"\{f(1)}\") }\n", "E0318")
    expect_check_and_build("tree_with_name", "fn f(x: I8) -> I8 \{\n    let n = 2\n    x + (n * 3)\n}\nfn main() \{ io.println(\"\{f(1)}\") }\n", "E0300")
}
