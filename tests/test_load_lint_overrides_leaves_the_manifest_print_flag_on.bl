// A compile loads blink.toml with the manifest print flag off and reports the warnings itself,
// but it must turn the flag back on: a daemon or the LSP runs many compiles in one process, and
// a later manifest load there that is not a compile, such as for add, remove or update, must
// still print. This holds after a load that finds warnings and after one that fails to parse.

import std.process.{ProcessResult}
import compiler.{load_lint_overrides}
import pkg.manifest.{manifest_print_warnings, manifest_warnings}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn load_in_fresh_project(toml: Str) -> Int ! Diag.Report {
    let dir = sh("mktemp -d /tmp/blink_lint_overrides_flag.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", toml)
    load_lint_overrides("{dir}/src")
    let _ = sh("rm -rf {dir}")
    manifest_warnings.len()
}

test "load_lint_overrides turns the print flag back on after a load with warnings" {
    assert(manifest_print_warnings)
    let n = load_in_fresh_project("[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lints]\nW0703 = \"loud\"\n\n[bogus]\nx = 1\n")
    assert_eq(n, 2)
    assert(manifest_print_warnings)
}

test "load_lint_overrides turns the print flag back on after a load that fails to parse" {
    assert(manifest_print_warnings)
    let _ = load_in_fresh_project("[package\nname = \"app\"\n")
    assert(manifest_print_warnings)
}

test "load_lint_overrides leaves the print flag off when the caller had turned it off" {
    manifest_print_warnings = false
    let _ = load_in_fresh_project("[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    let after = manifest_print_warnings
    manifest_print_warnings = true
    assert(!after)
}
