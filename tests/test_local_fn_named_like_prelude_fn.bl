// A function defined in this file is the only binding in scope, so it wins over a
// same-named free fn of a prelude module that the file never imports.
fn str_len(s: Str) -> Int {
    s.len() + 100
}

fn parse_int(_s: Str, base: Int) -> Int {
    base * 1000
}

fn main() {
    assert_eq(str_len("hi"), 102)
    assert_eq(parse_int("7", 3), 3000)
    let n = str_len("abc")
    assert_eq(n, 103)
}
