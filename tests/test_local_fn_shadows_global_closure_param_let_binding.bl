// A user fn colliding with a stdlib HOF's closure param must not poison that
// HOF's type-checking, even called from a `let` RHS (list_flat_map's
// `let sub = f(...)`), which used to resolve to the global fn's arity instead.
import std.list { list_flat_map }

// Zero arity, unlike the closure param it shadows, so a wrong resolution
// is caught as a TypeError instead of matching by argument-count accident.
fn f() -> Int {
    42
}

fn main() {
    let doubled = list_flat_map([1, 2, 3], fn(x: Int) -> List[Int] { [x, x] })
    let _ = f()
    io.println(doubled.len().to_string())
}

test "user global fn f does not poison stdlib list_flat_map closure param f bound via a let" {
    let doubled = list_flat_map([1, 2, 3], fn(x: Int) -> List[Int] { [x, x] })
    // The user's own global `f` is still callable with its real (zero) arity.
    let result = f()
    assert_eq(doubled.len(), 6)
    assert_eq(result, 42)
}
