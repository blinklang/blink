// br sqbb99 — a local bound from a CALL returning a generic-struct instance
// (`let g = a()`, not an annotation) must keep the Map VALUE type when a field
// of that struct is read. The value slot has to come from the local's tp_id;
// blink_map* alone can't recover it at the field-read site, so a lost type
// argument spells `g.m.get(k).unwrap()` as blink_Option_int over a `const char*`.
//
// The comparison MUST be against a COMPUTED string, never a literal: two equal
// string literals intern to one pointer, so `== "lo"` passes even when the read
// lowers to Option_int and compares pointers. `"l".concat("o")` is a distinct
// pointer, so only a correct blink_Option_str + string-equality passes.
// The annotated twin (`let g: GKV[Int, Str] = ...`) was always correct, which
// localizes the defect to the return-typed local.

type GKV[K, V] { m: Map[K, V] }

fn mkmap() -> Map[Int, Str] {
    let m: Map[Int, Str] = Map()
    m
}

fn a() -> GKV[Int, Str] { GKV { m: mkmap() } }

test "local from generic-struct-returning call keeps the Map value type" {
    let g = a()
    g.m.insert(256, "lo")
    let want = "l".concat("o")
    assert_eq(g.m.get(256).unwrap(), want)
}

test "closure return of the same shape keeps the Map value type" {
    let c = fn() -> GKV[Int, Str] { a() }
    let g = c()
    g.m.insert(512, "hi")
    let want = "h".concat("i")
    assert_eq(g.m.get(512).unwrap(), want)
}
