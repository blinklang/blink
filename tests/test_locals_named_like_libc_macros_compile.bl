// A Blink name is the program's own, whatever a C header in the unit defines. The unit
// includes errno.h, poll.h, signal.h, limits.h and stdio.h, so each name below is an
// object-like macro there; a local, a parameter or a binder named after one must still
// compile and keep its value.

type Point { x: Int, y: Int }

trait Shift {
    fn shifted(self, by: Int) -> Point
}

impl Shift for Point {
    fn shifted(self, EINVAL: Int) -> Point {
        let POLLIN = self.x + EINVAL
        Point { x: POLLIN, y: self.y }
    }
}

effect Probe {
    effect Ask {
        fn ask(SIGTERM: Int) -> Int
    }
}

fn add(EINVAL: Int, POLLIN: Int) -> Int { EINVAL + POLLIN }

fn scaled(n: Int, -- INT_MAX: Int = 3) -> Int { n * INT_MAX }

test "params and lets named like errno and poll macros keep their values" {
    let EAGAIN = 4
    let mut SIGTERM = 5
    SIGTERM = SIGTERM + 1
    assert_eq(add(EAGAIN, SIGTERM), 10)
}

test "a method param and a keyword param named like macros" {
    let p = Point { x: 1, y: 2 }.shifted(10)
    assert_eq(p.x, 11)
    assert_eq(scaled(2), 6)
    assert_eq(scaled(2, INT_MAX: 5), 10)
}

test "loop vars and pattern binders named like macros" {
    let mut total = 0
    for EOF in [1, 2, 3] { total = total + EOF }
    assert_eq(total, 6)
    let (SIGINT, SIGKILL) = (2, 9)
    assert_eq(SIGINT + SIGKILL, 11)
}

test "closure captures named like macros, shared and by value" {
    let EPIPE = 32
    let mut POLLOUT = 0
    let bump = fn(n: Int) {
        POLLOUT = POLLOUT + n + EPIPE
    }
    bump(1)
    bump(2)
    assert_eq(POLLOUT, 67)
}

test "a handler op param named like a macro" {
    with handler Probe {
        fn ask(SIGTERM: Int) -> Int { SIGTERM * 2 }
    } {
        assert_eq(probe.ask(21), 42)
    }
}
