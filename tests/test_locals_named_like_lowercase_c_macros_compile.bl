// A lowercase name can be a C macro too: errno.h defines errno, stdio.h defines stdin,
// stdout and stderr, signal.h defines sa_handler, sys/stat.h defines st_atime, and gcc
// predefines unix and linux. The emitter also writes temps of its own (`_t1`, `_caps1`,
// `_sw1`). A Blink name spelled like any of them is still the program's own name.

type Stat { st_atime: Int, sa_handler: Int }

fn sum(errno: Int, stdin: Int, stdout: Int, stderr: Int) -> Int { errno + stdin + stdout + stderr }

test "params named like libc's lowercase macros keep their values" {
    assert_eq(sum(1, 2, 3, 4), 10)
}

test "lets named like gcc's predefined macros keep their values" {
    let unix = 5
    let linux = 6
    let major = 7
    let minor = 8
    assert_eq(unix + linux + major + minor, 26)
}

test "a field named like a macro that expands to a member path" {
    let st_atime = 9
    let s = Stat { st_atime: st_atime, sa_handler: 2 }
    let t = Stat { sa_handler: 3, ..s }
    assert_eq(s.st_atime + t.sa_handler, 12)
}

test "locals spelled like the emitter's own temps" {
    let _t1 = 1
    let _caps1 = 2
    let _sw1 = 3
    let _cg_tmp1 = 4
    let total = match _sw1 {
        3 => _t1 + _caps1 + _sw1 + _cg_tmp1
        _ => 0
    }
    io.println("{_t1} {total}")
    assert_eq(total, 10)
}

test "a pattern binder and a capture named like errno" {
    let got = match Some(11) {
        Some(errno) => errno
        None => 0
    }
    let stdin = 2
    let f = fn(n: Int) -> Int { n + stdin + got }
    assert_eq(f(1), 14)
}
