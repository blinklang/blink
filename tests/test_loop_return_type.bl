// sections/02_syntax.md §2.11 + sections/03_types.md §3.3. A `for`/`while` tail can
// complete, so a value-returning fn needs an honest tail of its own: a trailing value,
// or an Option return whose "not found" outcome is None. A `loop` no `break` targets
// diverges and needs neither. A `-> Void` fn with a loop tail is unchanged.

fn find_in_for(lst: List[Int]) -> Option[Int] {
    for x in lst {
        if x == 42 {
            return Some(x)
        }
    }
    None
}

fn find_in_while(lst: List[Int]) -> Int {
    let mut i = 0
    while i < lst.len() {
        let v = lst.get(i) ?? 0
        if v == 42 {
            return v
        }
        i = i + 1
    }
    0
}

fn find_in_loop() -> Int {
    let mut n = 0
    loop {
        n = n + 1
        if n == 10 {
            return n
        }
    }
}

fn void_loop() -> Void {
    let lst: List[Int] = [1, 2, 3]
    for x in lst {
        io.println("{x}")
    }
}

test "for loop with an Option return yields the found element" {
    let lst: List[Int] = [1, 2, 42, 99]
    let result = find_in_for(lst)
    assert_eq(result ?? 0, 42)
}

test "for loop with an Option return yields None when the iterable exhausts" {
    let lst: List[Int] = [1, 2, 3]
    let result = find_in_for(lst)
    assert_eq(result ?? 0, 0)
}

test "while loop with a trailing value yields the found element" {
    let lst: List[Int] = [1, 2, 42, 99]
    let result = find_in_while(lst)
    assert_eq(result, 42)
}

test "while loop with a trailing value yields it when the condition ends the loop" {
    let lst: List[Int] = [1, 2, 3]
    let result = find_in_while(lst)
    assert_eq(result, 0)
}

test "a loop no break targets is a valid tail and returns from inside" {
    let result = find_in_loop()
    assert_eq(result, 10)
}

test "loop without return infers Void" {
    void_loop()
}
