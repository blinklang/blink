// A `return` in a fn's TAIL loop must leave the function, however deeply the
// `return` is nested inside block-bearing forms.
//
// A tail `loop` no `break` targets is `Never` (sections/02_syntax.md §2.11), so
// it stands as the tail of a fn returning any type and the only way out of the
// fn is a `return` inside it. That makes each row below a live test of the
// nesting form named in its own test: if the `return` did not fire, the program
// would run off the end of a diverging tail instead of producing the value.
//
// The rows are all VALID programs. Each one was once rejected with
// "return value type Void does not match function ... return type Int".

fn nested_while() -> Int {
    loop {
        while true {
            return 7
        }
    }
}

fn nested_for() -> Int {
    loop {
        for i in [11] {
            return i
        }
    }
}

// A `while` tail is `()` whatever its condition, so this one carries an honest
// trailing value; the nesting under test is the `loop` inside the `while`.
fn nested_loop() -> Int {
    while true {
        loop {
            return 13
        }
    }
    0
}

fn nested_with() -> Int {
    loop {
        with arena {
            return 4
        }
    }
}

fn nested_deep(flag: Bool) -> Str {
    loop {
        while true {
            if flag {
                return "yes"
            }
            return "no"
        }
    }
}

test "a return inside a while nested in a tail loop types the loop" {
    assert(nested_while() == 7)
}

test "a return inside a for nested in a tail loop types the loop" {
    assert(nested_for() == 11)
}

test "a return inside a loop nested in a tail while types the while" {
    assert(nested_loop() == 13)
}

test "a return inside a with-block nested in a tail loop types the loop" {
    assert(nested_with() == 4)
}

test "the scan reaches a return under loop + while + if" {
    assert(nested_deep(true) == "yes")
    assert(nested_deep(false) == "no")
}

// A closure body's `return` belongs to the CLOSURE, not to the enclosing fn, so
// the scan must NOT count it. Here the only return that types the loop is the
// outer one; if the closure's `return 9` were counted the answer would still be
// Int by luck, so the closure returns a Str to make a wrong count observable as
// a compile error rather than a silent pass.
fn closure_return_not_counted() -> Int {
    loop {
        let label = fn() -> Str { return "ignored" }
        if label().len() > 0 {
            return 21
        }
    }
}

test "a closure's own return does not type the enclosing tail loop" {
    assert(closure_return_not_counted() == 21)
}

// A loop with no `return` at all still evaluates to `()`, so a tail loop in a
// Void fn stays legal and a tail loop a `break` targets stays an error in a
// value-returning fn.
fn void_tail_loop(n: Int) -> Int {
    let mut total = 0
    let mut i = 0
    while i < n {
        total = total + i
        i = i + 1
    }
    total
}

test "a returnless while stays a statement evaluating to unit" {
    assert(void_tail_loop(4) == 6)
}

fn scan_diag(tag: Str, src: Str) -> Str {
    let path = ".tmp/_loopscan_{tag}.bl"
    write_file(path, src)
    let args = [path, "/dev/null", "--format", "json"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    shell_exec("rm -f {path}")
    output
}

test "a returnless tail loop in a value fn is still rejected" {
    let out = scan_diag("noret", "fn f() -> Int \{\n    loop \{\n        break\n    \}\n\}\nfn main() \{ io.println(\"\{f()\}\") \}\n")
    assert(out.contains("E0311"))
    assert(out.contains("a `break` targets its tail `loop`"))
}

// A `return` can also hide in the value of a `let`, an assignment or a compound
// assignment. The scan had no arm for those three, so it walked past them and
// answered "no return in here" — rejecting these valid programs.

fn let_value_return(c: Bool) -> Int {
    loop {
        let x = if c { return 3 } else { return 4 }
        io.println("{x}")
    }
}

fn let_match_value_return(c: Bool) -> Str {
    loop {
        let s = match c {
            true => { return "yes" }
            false => { return "no" }
        }
        io.println("{s}")
    }
}

fn assign_value_return(c: Bool) -> Int {
    let mut _y = 0
    loop {
        _y = if c { return 5 } else { return 6 }
    }
}

fn compound_assign_value_return(c: Bool) -> Int {
    let mut y = 0
    loop {
        y = y + 1
        y += if c { return 7 } else { return 8 }
    }
}

test "a return in a let value types the enclosing tail loop" {
    assert(let_value_return(true) == 3)
    assert(let_value_return(false) == 4)
}

test "a return in a let match value types the enclosing tail loop" {
    assert(let_match_value_return(true) == "yes")
    assert(let_match_value_return(false) == "no")
}

test "a return in an assignment value types the enclosing tail loop" {
    assert(assign_value_return(true) == 5)
    assert(assign_value_return(false) == 6)
}

test "a return in a compound assignment value types the enclosing tail loop" {
    assert(compound_assign_value_return(true) == 7)
    assert(compound_assign_value_return(false) == 8)
}
