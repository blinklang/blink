// m1wspm: a bare Map()/Set() passed DIRECTLY to a generic parameter must emit
// the kops table for the pinned concrete key/elem type, not the erased
// blink_kops_str default. Typecheck already solves the types
// (tc_pin_generic_args_from_binds unifies Map[Int,Str] against Map[a_k,a_v] and
// binds a_k := Int in place); codegen previously failed to READ that pinned tid
// off the ctor node and fell back to the enclosing fn's (empty) mono context.
//
// This is a codegen-level RED->GREEN signal via emitted-C inspection. A
// run-and-assert test would FALSELY PASS: blink_map_ensure_kops rescues the
// vtable at the first insert while len==0, so the runtime hides the miscompile
// in single-TU builds. The CONSTRUCTION-site literal is what the runtime rescue
// never rewrites, and it is a genuine ODR/miscompile hazard under
// --link-archive separate compilation. Assert on it directly.

import compile_test_helpers.{compile_and_emit_c}

test "Map() as generic arg with Int key emits i64 kops, not str" {
    let src = "fn fill[K, V](m: Map[K, V], k: K, v: V) \{ m.insert(k, v) }\nfn main() ! IO \{ fill(Map(), 256, \"x\") }\n"
    let c = compile_and_emit_c(src, "m1wspm_map_int")
    assert(c.contains("blink_map_new(&blink_kops_i64)"))
    assert(!c.contains("blink_map_new(&blink_kops_str)"))
}

test "Set() as generic arg with Int elem emits i64 kops, not str" {
    let src = "fn fillset[T](s: Set[T], x: T) \{ s.insert(x) }\nfn main() ! IO \{ fillset(Set(), 256) }\n"
    let c = compile_and_emit_c(src, "m1wspm_set_int")
    assert(c.contains("blink_set_new(&blink_kops_i64)"))
    assert(!c.contains("blink_set_new(&blink_kops_str)"))
}
