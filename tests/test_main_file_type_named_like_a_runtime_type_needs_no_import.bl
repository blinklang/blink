// A main-file type may take the name of a type the runtime header defines (ProcessResult,
// ChildEnd, LimitKind) without importing std.process, and keeps its own shape.

type ProcessResult {
    v: Str
}

type ChildEnd {
    Done(Str)
    Waiting
}

type LimitKind {
    Pair(Str, Str)
}

test "each namesake keeps the shape the file declares" {
    let p = ProcessResult { v: "six" }
    assert_eq(p.v, "six")
    let c = ChildEnd.Done("hello")
    let got = match c {
        Done(s) => s
        Waiting => "waiting"
    }
    assert_eq(got, "hello")
    let pair = match LimitKind.Pair("x", "y") {
        Pair(a, b) => "{a}{b}"
    }
    assert_eq(pair, "xy")
}
