// Struct-keyed Map[K,V] surviving an Option ?? fallback keeps its key/value
// type tracking (key boxing, kops) through the coalesced binding.

@derive(Hash, Eq)
type Point { x: Int, y: Int }

fn make_none() -> Option[Map[Point, Int]] { None }

test "struct-keyed Map through ?? fallback keeps key type tracking" {
    let mut m = make_none() ?? Map()
    m.insert(Point { x: 1, y: 2 }, 5)
    assert_eq(m.get(Point { x: 1, y: 2 }).unwrap(), 5)
}
