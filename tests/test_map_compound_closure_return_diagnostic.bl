import compile_test_helpers

// .map() takes a closure of any output type, so an Option-returning closure
// gives a List[Option[Str]] that a for-in loop can walk and match.

fn map_compound_return_src() -> Str {
    #"fn main() {
    let src: List[Int] = [1, 2, 3]
    let opts = src.map(fn(x: Int) -> Option[Str] { if x > 1 { Some("big") } else { None } })
    let g = opts
    for o in g {
        match o {
            Some(s) => io.println("got {s}")
            None => io.println("none")
        }
    }
}
"#
}

test "map with a compound-returning closure compiles and runs" {
    let r = compile_test_helpers.compile_and_run(map_compound_return_src(), "_map_compound")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("none\ngot big\ngot big"))
}
