import compile_test_helpers

// .map() with a closure returning a compound value (Option/Result/struct/
// tuple) must be rejected with a clean diagnostic at typecheck, not reach
// codegen and ICE on the resulting for-in loop.

fn map_compound_return_src() -> Str {
    #"fn main() {
    let src: List[Int] = [1, 2, 3]
    let opts = src.map(fn(x: Int) -> Option[Str] { if x > 1 { Some("big") } else { None } })
    let g = opts
    for o in g {
        match o {
            Some(s) => io.println("got {s}")
            None => io.println("none")
        }
    }
}
"#
}

test "map with a compound-returning closure is rejected cleanly, not an ICE" {
    let output = compile_test_helpers.compile_and_capture(map_compound_return_src(), "_map_compound")
    compile_test_helpers.expect_error(output, "UnresolvedMethod", "map compound-return closure rejected")
}
