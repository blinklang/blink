// A `.map` over a List[compound] chained directly into `.fold` must use the
// map's declared OUTPUT element type for fold's accumulator step, not the
// source list's compound element type.

test "map over List[List[Int]] chained into fold uses the map output type" {
    let rows: List[List[Int]] = [[1, 2, 3], [10, 20, 30]]
    let total = rows.map(fn(r) -> Int { r.get(0).unwrap() }).fold(0, fn(a, b) -> Int { a + b })
    assert_eq(total, 11)
}
