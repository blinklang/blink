// Map.entries() answers every (key, value) pair the map holds, as a new List
// (sections/03_types.md, the MapOps trait). The order is the map's iteration order, the one
// `for (k, v) in m` walks; the spec leaves that order open, so these tests check the pairs
// and that the two orders agree, never a fixed order.

type Point { x: Int  y: Int }

fn str_int_map() -> Map[Str, Int] {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    m.insert("b", 2)
    m.insert("c", 3)
    m
}

fn keys_distinct(es: List[(Str, Int)]) -> Bool {
    let mut seen: Set[Str] = Set()
    for e in es {
        if !seen.insert(e.0) { return false }
    }
    true
}

test "entries of a Map[Str, Int] look up back to their values" {
    let m = str_int_map()
    let es = m.entries()
    assert_eq(es.len(), m.len())
    for e in es {
        assert_eq(m.get(e.0) ?? -1, e.1)
    }
    assert(keys_distinct(es))
}

test "entries of an empty map is an empty list" {
    let m: Map[Str, Int] = Map()
    let es = m.entries()
    assert_eq(es.len(), 0)
    assert(es.is_empty())
}

test "entries of a Map[Int, Str]" {
    let mut m: Map[Int, Str] = Map()
    m.insert(10, "ten")
    m.insert(20, "twenty")
    let es = m.entries()
    assert_eq(es.len(), 2)
    for e in es {
        assert_eq(m.get(e.0) ?? "", e.1)
    }
    assert(es.get(0).unwrap().0 != es.get(1).unwrap().0)
}

test "entries carry a struct value" {
    let mut m: Map[Str, Point] = Map()
    m.insert("origin", Point { x: 0, y: 0 })
    m.insert("p", Point { x: 3, y: 4 })
    let es = m.entries()
    assert_eq(es.len(), 2)
    for e in es {
        let want = m.get(e.0).unwrap()
        assert_eq(e.1.x, want.x)
        assert_eq(e.1.y, want.y)
    }
}

test "entries reflect a remove and an overwrite" {
    let mut m = str_int_map()
    m.remove("b")
    m.insert("a", 100)
    let es = m.entries()
    assert_eq(es.len(), 2)
    for e in es {
        assert(e.0 != "b")
        if e.0 == "a" { assert_eq(e.1, 100) }
        if e.0 == "c" { assert_eq(e.1, 3) }
    }
}

test "entries is a copy the map does not change afterwards" {
    let mut m = str_int_map()
    let es = m.entries()
    m.insert("d", 4)
    m.insert("a", 50)
    m.remove("c")
    assert_eq(es.len(), 3)
    for e in es {
        if e.0 == "a" { assert_eq(e.1, 1) }
    }
    assert_eq(m.len(), 3)
}

test "entries order matches the for-in order" {
    let m = str_int_map()
    let es = m.entries()
    let mut i = 0
    for (k, v) in m {
        assert_eq(es.get(i).unwrap().0, k)
        assert_eq(es.get(i).unwrap().1, v)
        i = i + 1
    }
    assert_eq(i, es.len())
}

test "entries order matches keys and values" {
    let mut m: Map[Int, Int] = Map()
    let mut n = 0
    while n < 50 {
        m.insert(n * 7, n)
        n = n + 1
    }
    let es = m.entries()
    let ks = m.keys()
    let vs = m.values()
    assert_eq(es.len(), 50)
    let mut i = 0
    while i < es.len() {
        assert_eq(es.get(i).unwrap().0, ks.get(i).unwrap())
        assert_eq(es.get(i).unwrap().1, vs.get(i).unwrap())
        i = i + 1
    }
}

test "entries through the MapOps trait name" {
    let m = str_int_map()
    let es = MapOps.entries(m)
    assert_eq(es.len(), 3)
    for e in es {
        assert_eq(m.get(e.0) ?? -1, e.1)
    }
}
