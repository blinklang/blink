// An enum-keyed map reaches a function body through a parameter with no flat key
// channel stamped on the parameter's scope var — the parameter carries the key
// kind only on its authoritative tid, and the flat key field reads back CT_VOID
// there. The map-key reader on the .get() path answers the enum key off that tid,
// so a struct/enum key resolves to CT_STRUCT and boxes through get_map_key_struct
// rather than leaking the dropped flat field. Reading back a value by its enum key
// inside the callee is a regression guard that the key rides the tid through the
// reader on the parameter path.

@derive(Hash, Eq)
type Color { Red, Green, Blue }

fn read_red(m: Map[Color, Str]) -> Str {
    match m.get(Color.Red) {
        Some(v) => v
        None => "missing"
    }
}

fn read_green(m: Map[Color, Str]) -> Str {
    match m.get(Color.Green) {
        Some(v) => v
        None => "missing"
    }
}

test "an enum-keyed map passed as a function parameter answers enum-key lookups" {
    let mut m: Map[Color, Str] = Map()
    m.insert(Color.Red, "r")
    m.insert(Color.Green, "g")
    assert_eq(read_red(m), "r")
    assert_eq(read_green(m), "g")
}

// The same recovery when the enum-keyed map is created with no annotation — the
// key kind is learned only from the inserted enum keys, so it lives on the tid
// the insert path stamps. Passing that untyped map through a parameter and reading
// by enum key pins that the reader recovers the key from the tid on this path too.
fn read_blue(m: Map[Color, Str]) -> Str {
    match m.get(Color.Blue) {
        Some(v) => v
        None => "missing"
    }
}

test "an untyped enum-keyed map keeps its key through a function parameter" {
    let mut m = Map()
    m.insert(Color.Blue, "b")
    m.insert(Color.Red, "r")
    assert_eq(read_blue(m), "b")
    assert_eq(read_red(m), "r")
}
