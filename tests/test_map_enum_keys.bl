// Map[K, V] with a user enum as K, via @derive(Hash, Eq).
@derive(Hash, Eq)
type Color {
    Red
    Green
    Blue
}

fn main() ! IO {
    let m: Map[Color, Int] = Map()
    m.insert(Color.Red, 1)
    m.insert(Color.Green, 2)
    m.insert(Color.Blue, 3)

    let r = m.get(Color.Red).unwrap()
    let g = m.get(Color.Green).unwrap()
    let b = m.get(Color.Blue).unwrap()
    if r != 1 || g != 2 || b != 3 {
        io.println("FAIL: enum-key get")
        return
    }

    if m.contains_key(Color.Red) == false {
        io.println("FAIL: enum-key contains_key positive")
        return
    }

    m.insert(Color.Red, 11)
    if m.get(Color.Red).unwrap() != 11 {
        io.println("FAIL: enum-key update")
        return
    }

    m.remove(Color.Green)
    if m.contains_key(Color.Green) == true || m.len() != 2 {
        io.println("FAIL: enum-key remove/len")
        return
    }

    io.println("PASS: Map[Color, Int]")
}
