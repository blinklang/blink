// A Map projected out of a struct field (h.m where field m: Map[K,V]) is a
// result temp with no ScopeVar of its own, so its value type must resolve across
// the projection for .get().unwrap() to reach the value's fields. Guards that a
// struct value, a scalar value, and a value nested one struct deeper all resolve
// through the projection.

type P { x: Int }
type Holder { m: Map[Str, P] }

fn field_struct_value() -> Int {
    let mut mm: Map[Str, P] = Map()
    mm.insert("k", P { x: 8 })
    let h = Holder { m: mm }
    h.m.get("k").unwrap().x
}

type IntHolder { m: Map[Str, Int] }

fn field_scalar_value() -> Int {
    let mut mm: Map[Str, Int] = Map()
    mm.insert("k", 12)
    let h = IntHolder { m: mm }
    h.m.get("k").unwrap()
}

type Inner { v: Int }
type Outer { m: Map[Str, Inner] }

fn field_value_field() -> Int {
    let mut mm: Map[Str, Inner] = Map()
    mm.insert("a", Inner { v: 3 })
    mm.insert("b", Inner { v: 4 })
    let o = Outer { m: mm }
    o.m.get("a").unwrap().v + o.m.get("b").unwrap().v
}

test "a struct-field Map resolves its struct value across the projection" {
    assert_eq(field_struct_value(), 8)
}

test "a struct-field Map resolves its scalar value across the projection" {
    assert_eq(field_scalar_value(), 12)
}

test "a struct-field Map resolves a struct value read field-by-field" {
    assert_eq(field_value_field(), 7)
}

type GenHolder[T] { m: Map[Str, T] }

fn generic_field_struct_value() -> Int {
    let mut mm: Map[Str, P] = Map()
    mm.insert("k", P { x: 9 })
    let h: GenHolder[P] = GenHolder { m: mm }
    h.m.get("k").unwrap().x
}

test "a monomorphized generic-struct field Map resolves its value across the projection" {
    assert_eq(generic_field_struct_value(), 9)
}

fn tuple_elem_map_value() -> Int {
    let mut mm: Map[Str, P] = Map()
    mm.insert("k", P { x: 5 })
    let t = (mm, 0)
    t.0.get("k").unwrap().x
}

test "a tuple-element Map resolves its value across the projection" {
    assert_eq(tuple_elem_map_value(), 5)
}

type ListHolder { m: Map[Str, List[Int]] }

fn field_list_value() -> Int {
    let mut mm: Map[Str, List[Int]] = Map()
    mm.insert("k", [10, 20, 30])
    let h = ListHolder { m: mm }
    h.m.get("k").unwrap().get(1).unwrap()
}

test "a struct-field Map resolves a List value's element across the projection" {
    assert_eq(field_list_value(), 20)
}
