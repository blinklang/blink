// E1400 -- Map[K, V] with K = Float / F32 / F64 must be rejected at typecheck
// because Float does not implement Hash (NaN-inequality and bit-equality
// hazards). See decisions/map-runtime-architecture.md.

fn main() {
    let blink_root = process_run("sh", ["-c", "pwd -P"]).out.trim_right()

    let base = ".tmp/_test_map_float_rejected"
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}/tests")
    write_file("{base}/blink.toml", "[package]\nname = \"mfr\"\nversion = \"0.1.0\"\n\n[dependencies]\n")

    let cases = ["Float", "F32", "F64"]
    let mut ci = 0
    while ci < cases.len() {
        let ty = cases.get(ci).unwrap()
        let src = "fn main() \{\n    let _m: Map[{ty}, Int] = Map()\n    io.println(\"unreachable\")\n\}\n"
        write_file("{base}/main_{ci}.bl", src)

        let cmd = "cd {base} && {blink_root}/build/blink check main_{ci}.bl 2>&1"
        let result = process_run("sh", ["-c", cmd])

        if result.exit_code == 0 {
            io.println("FAIL: Map[{ty}, Int] should be rejected, but check exited 0")
            shell_exec("rm -rf {base}")
            return
        }
        if !result.out.contains("E1400") && !result.out.contains("MapKeyNotHashable") {
            io.println("FAIL: Map[{ty}, Int] did not emit E1400 / MapKeyNotHashable")
            io.println("got: {result.out}")
            shell_exec("rm -rf {base}")
            return
        }
        ci = ci + 1
    }

    io.println("PASS: E1400 rejects Map[Float/F32/F64, _]")
    shell_exec("rm -rf {base}")
}
