// `for (k, v) in m` over a Map whose value is a transparent newtype (Errno)
// must lower the whole per-entry value chain (tuple-carrier cast, value cast,
// and the destructured binding) to the newtype's bare scalar representation,
// not box it.

import std.errno.{Errno}

test "for (k, v) in Map[Str, Errno] reads the transparent value back by value" {
    let mut m: Map[Str, Errno] = Map()
    m.insert("x", Errno(99))
    for (k, v) in m {
        match v {
            Errno(rc) => {
                assert_eq(k, "x")
                assert_eq(rc, 99)
            }
        }
    }
}
