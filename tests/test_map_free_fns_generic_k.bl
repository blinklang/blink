pub fn count_inc[K](src: Map[K, Int]) -> Map[K, Int] {
    let r: Map[K, Int] = Map()
    let ks = src.keys()
    let mut i = 0
    while i < ks.len() {
        let k = ks.get(i).unwrap()
        r.insert(k, src.get(k).unwrap() + 1)
        i = i + 1
    }
    r
}

test "generic Map free fn over K=Int" {
    let mut m: Map[Int, Int] = Map()
    m.insert(1, 10)
    m.insert(2, 20)
    let r = count_inc(m)
    assert_eq(r.get(1).unwrap(), 11)
    assert_eq(r.get(2).unwrap(), 21)
}

test "generic Map free fn over K=Str" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 5)
    m.insert("b", 7)
    let r = count_inc(m)
    assert_eq(r.get("a").unwrap(), 6)
    assert_eq(r.get("b").unwrap(), 8)
}

test "generic Map free fn over K=U64" {
    let mut m: Map[U64, Int] = Map()
    let k1: U64 = 100
    let k2: U64 = 200
    m.insert(k1, 1)
    m.insert(k2, 2)
    let r = count_inc(m)
    assert_eq(r.get(k1).unwrap(), 2)
    assert_eq(r.get(k2).unwrap(), 3)
}
