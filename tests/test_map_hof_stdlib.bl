import std.map.{map_for_each, map_filter, map_fold, map_merge, map_map_values}

test "map_for_each: iterate entries" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 10)
    m.insert("b", 20)
    let mut total = 0
    map_for_each(m, fn(_k: Str, v: Int) -> Void { total = total + v })
    assert_eq(total, 30)
}

test "map_filter: keep matching entries" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    m.insert("b", 2)
    m.insert("c", 3)
    let filtered = map_filter(m, fn(_k: Str, v: Int) -> Bool { v > 1 })
    assert_eq(filtered.len(), 2)
    assert_eq(filtered.contains_key("b"), true)
    assert_eq(filtered.contains_key("c"), true)
    assert_eq(filtered.contains_key("a"), false)
}

test "map_fold: sum values" {
    let mut m: Map[Str, Int] = Map()
    m.insert("x", 5)
    m.insert("y", 15)
    let total = map_fold(m, 0, fn(acc: Int, _k: Str, v: Int) -> Int { acc + v })
    assert_eq(total, 20)
}

test "map_fold: collect keys" {
    let mut m: Map[Str, Int] = Map()
    m.insert("hello", 1)
    m.insert("world", 2)
    let keys_str = map_fold(m, "", fn(acc: Str, k: Str, _v: Int) -> Str {
        if acc == "" { k } else { "{acc},{k}" }
    })
    assert(keys_str.len() > 0)
}

test "map_merge: combine two maps" {
    let mut a: Map[Str, Int] = Map()
    a.insert("x", 1)
    let mut b: Map[Str, Int] = Map()
    b.insert("y", 2)
    let merged = map_merge(a, b)
    assert_eq(merged.len(), 2)
    assert_eq(merged.get("x").unwrap(), 1)
    assert_eq(merged.get("y").unwrap(), 2)
}

test "map_merge: second overrides first" {
    let mut a: Map[Str, Int] = Map()
    a.insert("k", 1)
    let mut b: Map[Str, Int] = Map()
    b.insert("k", 99)
    let merged = map_merge(a, b)
    assert_eq(merged.len(), 1)
    assert_eq(merged.get("k").unwrap(), 99)
}

// br ymw81c: U != V pins that map_map_values' result carries its OWN value
// type (Float here), not V's (Int) or a fabricated default.
test "map_map_values: U != V carries the mapped value type" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 3)
    let doubled = map_map_values(m, fn(_k: Str, v: Int) -> Float { v.to_float() * 2.0 })
    assert_eq(doubled.get("a").unwrap(), 6.0)
}
