// Regression sentinel for the K=Int instantiation of the stdlib map HOFs
// (map_for_each / map_filter / map_fold / map_map_values / map_merge). The
// Str-keyed sibling is tests/test_map_hof_stdlib.bl.

import std.map.{map_for_each, map_filter, map_fold, map_map_values, map_merge}

test "map_for_each over Map[Int, V]" {
    let m: Map[Int, Int] = Map()
    m.insert(1, 10)
    m.insert(2, 20)
    let mut total = 0
    map_for_each(m, fn(_k: Int, v: Int) -> Void { total = total + v })
    assert_eq(total, 30)
}

test "map_filter over Map[Int, V]" {
    let m: Map[Int, Int] = Map()
    m.insert(1, 1)
    m.insert(2, 2)
    m.insert(3, 3)
    let filtered = map_filter(m, fn(_k: Int, v: Int) -> Bool { v > 1 })
    assert_eq(filtered.len(), 2)
    assert_eq(filtered.contains_key(2), true)
    assert_eq(filtered.contains_key(3), true)
    assert_eq(filtered.contains_key(1), false)
}

test "map_fold over Map[Int, V]" {
    let m: Map[Int, Int] = Map()
    m.insert(1, 5)
    m.insert(2, 15)
    let total = map_fold(m, 0, fn(acc: Int, _k: Int, v: Int) -> Int { acc + v })
    assert_eq(total, 20)
}

test "map_map_values over Map[Int, V]" {
    let m: Map[Int, Int] = Map()
    m.insert(1, 10)
    m.insert(2, 20)
    let doubled = map_map_values(m, fn(_k: Int, v: Int) -> Int { v * 2 })
    assert_eq(doubled.get(1).unwrap(), 20)
    assert_eq(doubled.get(2).unwrap(), 40)
}

// br ymw81c: U != V over Map[Int, V] carries the mapped value type (Str here),
// not V's (Int) or a fabricated default. The row above (U == V == Int) stays
// as-is -- it pins the CT_INT coincidence still working, not this ticket.
test "map_map_values over Map[Int, V]: U != V carries the mapped value type" {
    let m: Map[Int, Int] = Map()
    m.insert(1, 10)
    m.insert(2, 20)
    let stringified = map_map_values(m, fn(_k: Int, v: Int) -> Str { "{v}" })
    assert_eq(stringified.get(1).unwrap(), "10")
    assert_eq(stringified.get(2).unwrap(), "20")
}

test "map_merge over Map[Int, V]" {
    let a: Map[Int, Int] = Map()
    a.insert(1, 100)
    let b: Map[Int, Int] = Map()
    b.insert(2, 200)
    let merged = map_merge(a, b)
    assert_eq(merged.len(), 2)
    assert_eq(merged.get(1).unwrap(), 100)
    assert_eq(merged.get(2).unwrap(), 200)
}

// MapPure[K] (.contains_key/.remove/.clear for non-Str K) is exercised
// indirectly by test_map_int_keys.bl via the codegen intercept path.
