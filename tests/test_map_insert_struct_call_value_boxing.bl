// A call that returns a struct, used directly as a Map value ARGUMENT (not bound
// to a let first), is not boxed before the (void*) cast that blink_map_set expects.
// Working spellings that DO box correctly: a struct literal, a plain variable, and
// a let-bound result of the very same call. Only the direct-call-in-argument-position
// spelling is broken, and it fails the same way whether the call is spelled as
// `Far.from(...)` or `.into()`.

import compile_test_helpers.{compile_and_run}

test "Map insert boxes a struct-returning call used directly as the value argument" {
    let src = #"
import std.io

type Cel { deg: Int }
type Far { deg: Int }

impl From[Cel] for Far {
    fn from(c: Cel) -> Far {
        Far { deg: c.deg * 9 / 5 + 32 }
    }
}

fn main() {
    let mut m2: Map[Str, Far] = Map()
    m2.insert("fromdirect", Far.from(Cel { deg: 100 }))
    io.println("{m2.get(\"fromdirect\").unwrap().deg}")
}
"#
    let r = compile_and_run(src, "_map_insert_struct_call_value_boxing")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "212\n")
}
