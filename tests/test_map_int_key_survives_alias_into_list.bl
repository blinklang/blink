// An Int-keyed map, aliased so its flat key channel drops to -1, must still push into
// a List[Map[Int, V]] container and answer Int-key lookups. Int is not the default map
// key (Str is), so the recovered key is observable: the aliased map keeps its key kind
// only on the authoritative tid — the flat key field is stale after the alias — and the
// raw key reader on the List[Map] push path must read the key off that tid, not the
// dropped flat field. Round-tripping a value back by its Int key proves the key rode
// the tid through the raw reader.

test "an aliased Int-keyed map pushed into a list container answers Int-key lookups" {
    let mut m1: Map[Int, Str] = Map()
    m1.insert(7, "seven")
    m1.insert(42, "answer")
    let m2 = m1
    let mut container: List[Map[Int, Str]] = []
    container.push(m2)
    let got = container.get(0).unwrap()
    assert_eq(got.get(42).unwrap(), "answer")
    assert_eq(got.get(7).unwrap(), "seven")
}

// The same recovery through an Option unwrap: a Map[Int, Str] returned inside an Option
// reaches the receiver with no flat key channel, so its Int key survives only on the
// tid. Pushing the unwrapped map into a list container and reading by Int key pins that
// the raw key reader recovers the key from the tid on this path too.
fn make_int_map() -> Option[Map[Int, Str]] {
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "a")
    Some(m)
}

test "an Int-keyed map recovered from Option.unwrap keeps its key into a list container" {
    let m = make_int_map().unwrap()
    let mut container: List[Map[Int, Str]] = []
    container.push(m)
    let got = container.get(0).unwrap()
    assert_eq(got.get(1).unwrap(), "a")
}
