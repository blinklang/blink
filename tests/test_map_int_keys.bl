// h0geg9 Phase 2 — Map[Int, V] backed by per-K kops vtable.
// Verifies insert/get/contains_key/remove/len/clear/keys for Int keys, with
// Int and Str value types to exercise both value-boxing paths.

fn main() {
    let mut m: Map[Int, Int] = Map()
    m.insert(1, 100)
    m.insert(2, 200)
    m.insert(42, 4242)

    if m.len() != 3 { io.println("FAIL len after insert: {m.len()}"); return }
    if !m.contains_key(1) { io.println("FAIL contains_key(1)"); return }
    if !m.contains_key(42) { io.println("FAIL contains_key(42)"); return }
    if m.contains_key(7) { io.println("FAIL contains_key(7) should be false"); return }

    let v42 = m.get(42).unwrap()
    if v42 != 4242 { io.println("FAIL get(42) = {v42}"); return }

    if !m.remove(2) { io.println("FAIL remove(2) returned false"); return }
    if m.contains_key(2) { io.println("FAIL contains_key(2) after remove"); return }
    if m.len() != 2 { io.println("FAIL len after remove: {m.len()}"); return }

    m.insert(1, 999)
    if m.get(1).unwrap() != 999 { io.println("FAIL update value for existing key"); return }
    if m.len() != 2 { io.println("FAIL len after update: {m.len()}"); return }

    let ks = m.keys()
    if ks.len() != 2 { io.println("FAIL keys().len() = {ks.len()}"); return }
    let mut sum = 0
    let mut i = 0
    while i < ks.len() {
        sum = sum + ks.get(i).unwrap()
        i = i + 1
    }
    if sum != 43 { io.println("FAIL key sum = {sum}, expected 43"); return }

    // Map[Int, Str] — exercises pointer-valued path with inline Int keys.
    let mut s: Map[Int, Str] = Map()
    s.insert(10, "ten")
    s.insert(20, "twenty")
    if s.get(10).unwrap() != "ten" { io.println("FAIL Map[Int,Str].get(10)"); return }
    if s.get(20).unwrap() != "twenty" { io.println("FAIL Map[Int,Str].get(20)"); return }

    m.clear()
    if !m.is_empty() { io.println("FAIL is_empty after clear"); return }
    if m.len() != 0 { io.println("FAIL len after clear: {m.len()}"); return }

    io.println("PASS: Map[Int, Int] + Map[Int, Str]")
}
