// qf1vzx tp_id retirement, the map-key-struct reader: set_map_types re-registers a
// Map var on every generic-struct-field re-emit and preserved the prior struct KEY
// name by reading it off the flat pool (tp_child1_sname(sv.tp_id)). The value side is
// erased on re-emit (CT_VOID, no name), so without the key-preservation the field's
// Map[StructKey, V] would drop its struct key and the emitted C declares a `void`
// key — a miss on every lookup. The authoritative tid already carries the struct key
// (both re-registration callers stamp set_var_ty before set_map_types), so the reader
// must recover the key name from the tid alone, matching get_map_key_struct. A
// computed key (built from a variable) defeats any literal short-circuit so the
// round-trip exercises the real struct-key kops.

@derive(Hash, Eq)
type Key { id: Int }

type Holder[V] { m: Map[Key, V] }

test "generic-struct field Map[StructKey, Str] keeps the struct key across re-emit" {
    let h = Holder { m: Map() }
    let n = 7
    h.m.insert(Key { id: n }, "seven")
    assert_eq(h.m.get(Key { id: n }).unwrap(), "seven")
}

test "generic-struct field Map[StructKey, Int] keeps the struct key across re-emit" {
    let h = Holder { m: Map() }
    let n = 3
    h.m.insert(Key { id: n }, 300)
    assert_eq(h.m.get(Key { id: n }).unwrap(), 300)
}

test "generic-struct field struct-key map misses on a different key" {
    let h = Holder { m: Map() }
    h.m.insert(Key { id: 5 }, "five")
    assert(h.m.get(Key { id: 6 }).is_none())
}

test "rebound generic-struct field Map[StructKey, V] keeps the key" {
    let h = Holder { m: Map() }
    h.m.insert(Key { id: 9 }, "nine")
    let m2 = h.m
    assert_eq(m2.get(Key { id: 9 }).unwrap(), "nine")
}
