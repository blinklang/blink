// A List-valued map's ELEMENT kind (Map[K, List[E]]) was recovered from the flat `extra`
// channel for non-leaf-scalar elements (struct, enum, nested container). get_map_value_list_elem
// now reads the authoritative map tid for every element kind, so `extra` no longer backs it.
// These rows pin the element round-trip for the shapes that formerly took the `extra` fallback —
// struct elements and nested-list elements — across the alias / Option.unwrap / Result.unwrap
// recovery paths that reach the reader without a prior set_map_types. Each must keep returning
// the element it stored once the reader is tid-only.

type Point {
    x: Int
    y: Int
}

fn make_opt_struct() -> Option[Map[Str, List[Point]]] {
    let mut m: Map[Str, List[Point]] = Map()
    m.insert("k", [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }])
    Some(m)
}

fn make_res_nested() -> Result[Map[Str, List[List[Int]]], Str] {
    let mut m: Map[Str, List[List[Int]]] = Map()
    m.insert("a", [[1, 2], [3, 4, 5]])
    Ok(m)
}

// ── struct element through an unannotated alias chain ─────────────────────────────────────
test "Map[Str,List[Point]] keeps its struct element across an alias chain" {
    let mut m1: Map[Str, List[Point]] = Map()
    m1.insert("k", [Point { x: 10, y: 20 }, Point { x: 30, y: 40 }])
    let m2 = m1
    let m3 = m2
    let lst = m3.get("k").unwrap()
    let p = lst.get(1).unwrap()
    assert_eq(p.x, 30)
    assert_eq(p.y, 40)
    assert_eq(lst.len(), 2)
}

// ── struct element recovered through Option.unwrap ───────────────────────────────────────
test "Map[Str,List[Point]] recovered from Option.unwrap round-trips its struct element" {
    let x = make_opt_struct().unwrap()
    let lst = x.get("k").unwrap()
    let p = lst.get(0).unwrap()
    assert_eq(p.x, 1)
    assert_eq(p.y, 2)
}

// ── nested-list element through an unannotated alias chain ────────────────────────────────
test "Map[Str,List[List[Int]]] keeps its nested-list element across an alias" {
    let mut m1: Map[Str, List[List[Int]]] = Map()
    m1.insert("a", [[7, 8], [9]])
    let m2 = m1
    let lst = m2.get("a").unwrap()
    let inner = lst.get(0).unwrap()
    assert_eq(inner.len(), 2)
    assert_eq(inner.get(1).unwrap(), 8)
    assert_eq(lst.len(), 2)
}

// ── nested-list element recovered through Result.unwrap ───────────────────────────────────
test "Map[Str,List[List[Int]]] recovered from Result.unwrap round-trips its nested list" {
    let x = make_res_nested().unwrap()
    let lst = x.get("a").unwrap()
    let inner = lst.get(1).unwrap()
    assert_eq(inner.len(), 3)
    assert_eq(inner.get(2).unwrap(), 5)
}
