// A generic fn with a Map[Str, T] local is emitted once per concrete T, so the
// map scope var is re-registered per mono through set_map_types. When a mono pass
// hands set_map_types an erased value (CT_VOID, no name), the var's already-stamped
// tid must keep the real value kind so name.get(k) still returns Option[T] rather
// than Option[Int]. This guards that the value survives re-registration from the
// authoritative tid alone -- the flat inner2 value kind is no longer the channel it
// rides. Both a scalar value and a struct value cross the same re-registration path.

type MrPt { x: Int, y: Int }

fn build_map[T](k: Str, v: T) -> Map[Str, T] {
    let mut m: Map[Str, T] = Map()
    m.insert(k, v)
    m
}

test "a generic Map[Str,Int] local keeps its scalar value across re-registration" {
    let m = build_map("a", 7)
    assert_eq(m.get("a").unwrap(), 7)
}

test "a generic Map[Str,Struct] local keeps its struct value across re-registration" {
    let m = build_map("p", MrPt { x: 11, y: 22 })
    let got = m.get("p").unwrap()
    assert_eq(got.x, 11)
    assert_eq(got.y, 22)
}

test "a generic Map[Str,List[Int]] local keeps its list value across re-registration" {
    let m = build_map("xs", [3, 4, 5])
    let xs = m.get("xs").unwrap()
    assert_eq(xs.len(), 3)
    assert_eq(xs.get(2).unwrap(), 5)
}
