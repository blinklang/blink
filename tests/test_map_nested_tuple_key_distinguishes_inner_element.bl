// A Map key that is a tuple containing a nested tuple element must compare and hash the
// nested element too, so two keys differing only in it are distinct.

test.failing(
    "a Map keyed by a tuple with a nested tuple element distinguishes keys that differ only in it",
    reason: "the derived struct eq for the outer tuple key silently skips the nested-tuple field, and its hash twin emits a compiler-bug sentinel in its place, so distinct keys collide",
    ticket: "59bqka",
) {
    let mut m: Map[((Int, Int), Str), Int] = Map()
    m.insert(((1, 2), "a"), 10)
    m.insert(((1, 3), "a"), 20)
    assert_eq(m.get(((1, 2), "a")) ?? 0, 10)
    assert_eq(m.len(), 2)
}
