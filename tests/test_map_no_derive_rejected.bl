// E1400: K must implement Hash. User struct/enum K requires @derive(Hash).

import compile_test_helpers

fn main() {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()

    let base = "{compile_test_helpers.scratch_root()}/_test_map_no_derive_rejected"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/tests"]).unwrap()
    fs.write("{base}/blink.toml", "[package]\nname = \"mnd\"\nversion = \"0.1.0\"\n\n[dependencies]\n").unwrap()

    // Struct without @derive(Hash) — reject.
    let src_struct = "type Point \{\n    x: Int\n    y: Int\n}\n\nfn main() \{\n    let _m: Map[Point, Int] = Map()\n    io.println(\"unreachable\")\n}\n"
    fs.write("{base}/struct.bl", src_struct).unwrap()
    let cmd_s = "cd {base} && {blink_root}/build/blink check struct.bl 2>&1"
    let r_s = process.run("sh", ["-c", cmd_s]).unwrap()
    if r_s.success() {
        io.println("FAIL: Map[Point, Int] without @derive(Hash) should reject")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    if !r_s.out.contains("E1400") && !r_s.out.contains("MapKeyNotHashable") {
        io.println("FAIL: struct rejection did not emit E1400")
        io.println("got: {r_s.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Struct WITH @derive(Hash, Eq) — accept.
    let src_ok = "@derive(Hash, Eq)\ntype Point \{\n    x: Int\n    y: Int\n}\n\nfn main() \{\n    let _m: Map[Point, Int] = Map()\n    io.println(\"ok\")\n}\n"
    fs.write("{base}/ok.bl", src_ok).unwrap()
    let cmd_ok = "cd {base} && {blink_root}/build/blink check ok.bl 2>&1"
    let r_ok = process.run("sh", ["-c", cmd_ok]).unwrap()
    if !r_ok.success() {
        io.println("FAIL: Map[Point, Int] WITH @derive(Hash, Eq) should accept")
        io.println("got: {r_ok.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    io.println("PASS: E1400 rejects struct K without @derive(Hash)")
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
