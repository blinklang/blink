// Locks the map value readers against same-name shadowing across scopes — a shape
// a tid-led reader guard changes behavior on. When an inner block or a callee
// reuses an outer map's name with a different value type, the readers must answer
// for the binding in scope at each read, never a stale outer one. Each row reads a
// shadowing map back through .get()/.unwrap(), driving the value-struct and
// value-type readers on the inner var, then reads the outer map to prove the inner
// binding did not corrupt it.
//
// The KEY-reader counterpart (an inner block shadowing an outer map with a
// different KEY type) is a separate open codegen bug and is deliberately not
// exercised here — see the tracked ticket.

type Tag { label: Str }

test "an inner-block map shadows an outer map with a struct value" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 10)
    if true {
        let mut m: Map[Str, Tag] = Map()
        m.insert("a", Tag { label: "inner" })
        assert_eq(m.get("a").unwrap().label, "inner")
    }
    assert_eq(m.get("a").unwrap(), 10)
}

test "an inner-block map shadows an outer map with a List value" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 5)
    if true {
        let mut m: Map[Str, List[Int]] = Map()
        m.insert("a", [1, 2, 3])
        assert_eq(m.get("a").unwrap().get(1).unwrap(), 2)
    }
    assert_eq(m.get("a").unwrap(), 5)
}

fn tag_map_first_label(m: Map[Str, Tag]) -> Str {
    m.get("x").unwrap().label
}

test "a callee param named like a caller local reads its own struct value" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let mut m2: Map[Str, Tag] = Map()
    m2.insert("x", Tag { label: "t" })
    assert_eq(tag_map_first_label(m2), "t")
    assert_eq(m.get("a").unwrap(), 1)
}
