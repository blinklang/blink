// Verifies the runtime hash-seed contract: when the seed is pinned (via
// BLINK_MAP_SEED at run time, or --deterministic at build time), Map[Int, Int]
// keys() iteration order is identical across processes; with a different
// seed, the order changes. We pin via BLINK_MAP_SEED so this test passes
// regardless of how it was built (the test-runner doesn't pass
// --deterministic).

fn keys_str() -> Str {
    let mut m: Map[Int, Int] = Map()
    let mut i = 0
    while i < 16 {
        m.insert(i * 7 + 3, i)
        i = i + 1
    }
    let ks = m.keys()
    let mut s = ""
    let mut j = 0
    while j < ks.len() {
        if j > 0 { s = s + "," }
        s = s + "{ks.get(j).unwrap()}"
        j = j + 1
    }
    s
}

fn main() {
    let marker = env.var("BLINK_SEED_TEST_CHILD") ?? ""
    if marker != "" {
        io.println(keys_str())
        return
    }
    let self_path = env.var("BLINK_TEST_BIN") ?? "build/test_map_seed_deterministic"
    let r1 = process_run("sh", ["-c", "BLINK_SEED_TEST_CHILD=1 BLINK_MAP_SEED=12345 {self_path}"])
    let r2 = process_run("sh", ["-c", "BLINK_SEED_TEST_CHILD=1 BLINK_MAP_SEED=12345 {self_path}"])
    if r1.exit_code != 0 || r2.exit_code != 0 {
        io.println("FAIL child exit codes: {r1.exit_code},{r2.exit_code}")
        return
    }
    if r1.out != r2.out {
        io.println("FAIL key order differs:")
        io.println("  run1: {r1.out}")
        io.println("  run2: {r2.out}")
        return
    }
    let r3 = process_run("sh", ["-c", "BLINK_SEED_TEST_CHILD=1 BLINK_MAP_SEED=99999 {self_path}"])
    if r3.exit_code != 0 {
        io.println("FAIL third child exit: {r3.exit_code}")
        return
    }
    if r3.out == r1.out {
        io.println("FAIL different seeds gave same order — seed not wired into hash")
        return
    }
    io.println("PASS: Map[Int,Int] iteration order is seed-determined")
}
