// n3fxpz: a Map whose value is a nested container (Set[Int]) must keep the
// Set's element metadata through every consumer, not only Map.get().unwrap().
// The map.bl free-fn consumers — for_each / fold / filter / map_values — pass
// the value through a closure param, a separate producer channel from .get();
// each must carry the Set element so a for-in over the value knows its element.

import std.map.{map_for_each, map_filter, map_fold, map_map_values}

fn build() -> Map[Str, Set[Int]] {
    let mut s1 = Set()
    s1.insert(1)
    s1.insert(2)
    let mut s2 = Set()
    s2.insert(3)
    let mut m: Map[Str, Set[Int]] = Map()
    m.insert("a", s1)
    m.insert("b", s2)
    m
}

test "Map[Str,Set[Int]].get().unwrap() keeps the Set element" {
    let m = build()
    let mut total = 0
    for x in m.get("a").unwrap() {
        total = total + x
    }
    assert_eq(total, 3)
}

test "map_for_each over a Set value iterates the Set element" {
    let m = build()
    let mut total = 0
    map_for_each(m, fn(_k: Str, v: Set[Int]) {
        for x in v {
            total = total + x
        }
    })
    assert_eq(total, 6)
}

test "map_fold over a Set value iterates the Set element" {
    let m = build()
    let total = map_fold(m, 0, fn(acc: Int, _k: Str, v: Set[Int]) -> Int {
        let mut sub = acc
        for x in v {
            sub = sub + x
        }
        sub
    })
    assert_eq(total, 6)
}

test "map_filter predicate reads the Set value" {
    let m = build()
    let big = map_filter(m, fn(_k: Str, v: Set[Int]) -> Bool { v.len() > 1 })
    assert_eq(big.len(), 1)
}

test "map_map_values transforms each Set value" {
    let m = build()
    let sizes = map_map_values(m, fn(_k: Str, v: Set[Int]) -> Int { v.len() })
    assert_eq(sizes.len(), 2)
}
