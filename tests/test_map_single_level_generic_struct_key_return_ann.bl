// A Map keyed by a single-level generic struct, resolved through a fn's
// RETURN annotation, must resolve its kops carrier the same way a
// doubly-nested key of the same shape already does.

import compile_test_helpers.{compile_and_run}

test "a Map[HBox[T], Int] return-annotated ctor resolves its kops carrier" {
    let src = #"
import std.io

@derive(Hash, Eq)
type HBox[T] { value: T }

fn mk1[T](k: T) -> Map[HBox[T], Int] {
    let mut m: Map[HBox[T], Int] = Map()
    m.insert(HBox { value: k }, 7)
    m
}

fn main() ! IO {
    let a = mk1(5)
    io.println("{a.get(HBox { value: 5 }).unwrap()}")
}
"#
    let r = compile_and_run(src, "_map_single_level_generic_struct_key_return_ann")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}
