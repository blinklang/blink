// br 1452w4 (codegen-structured-tids, unblocks q4etvt). Map[Str, Box[Int]] value
// slot is a struct instance nested in a compound carrier; the compound-inner
// spellers erased its inner Int to the bare head. The failure surfaces at runtime
// field access, so this MUST run via `task test` (archive-linked), not just compile.
//
// Model: test_nss31w_* / test_bwyfy1_*.

type Box[T] {
    value: T
}

fn ident[T](v: T) -> T {
    v
}

test "Map[Str, Box[Int]] annotation-only round-trips inner Int" {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("a", Box { value: 100 })
    m.insert("b", Box { value: 200 })
    assert_eq(m.get("a").unwrap().value, 100)
    assert_eq(m.get("b").unwrap().value, 200)
}

test "Map[Str, Box[Int]] through a generic fn round-trips inner Int" {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 321 })
    let m2 = ident(m)
    assert_eq(m2.get("k").unwrap().value, 321)
}
