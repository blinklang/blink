// jctkac: a struct-keyed Map declared by annotation (`let m: Map[Point, Str]`)
// routes through the annotation branch (codegen_stmt.bl) where the key name
// resolves to a struct: type_from_name(key) is CT_VOID, so set_map_types stores
// the flat key kind CT_VOID, then set_map_key_struct stamps the pool key child to
// CT_STRUCT. The two channels therefore disagree on the key kind for a struct key
// (pool = CT_STRUCT, flat inner1 = CT_VOID) unless the setter syncs them.
//
// get_map_key_type must answer CT_STRUCT here so the insert/get round-trip picks
// the struct kops (hash/eq over the Point fields) rather than a scalar-key path.
// A computed key (built from a variable) defeats any literal short-circuit, so the
// round-trip actually exercises the struct-key kops. This pins the annotation path
// distinctly from the generic-fn tid-recovery path (3fmk4k, 0sh55p).

@derive(Hash, Eq)
type Point { x: Int, y: Int }

test "annotation-declared Map[Point, Str] round-trips a computed struct key" {
    let a = 3
    let mut m: Map[Point, Str] = Map()
    m.insert(Point { x: a, y: 4 }, "hit")
    let got = m.get(Point { x: a, y: 4 })
    assert_eq(got.unwrap(), "hit")
}

test "annotation-declared Map[Point, Str] misses on a different struct key" {
    let mut m: Map[Point, Str] = Map()
    m.insert(Point { x: 1, y: 2 }, "v")
    let got = m.get(Point { x: 1, y: 9 })
    assert(got.is_none())
}
