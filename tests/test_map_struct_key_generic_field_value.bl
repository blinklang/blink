// jctkac: a struct-KEYED Map[StructK, V] carried as a generic-struct field is the
// combination that makes set_map_types' value preservation load-bearing on a
// struct key. set_map_key_struct stamps the pool key child to CT_STRUCT; a later
// generic-field re-emit calls set_map_types with an erased value, so prior_v must
// recover the field map's real value type across the erasure.
//
// prior_v now reads the flat inner2 (the shipped value-kind channel that
// get_map_value_type_raw/get_map_value_type already read) instead of the tp_* pool
// value child. The two agree for every usable map: set_map_key_struct only
// fabricates a pool value default (CT_INT) for a map whose value was never
// resolved (inner2 < 0) — an unusable map — and the shipped value reader already
// treats that fabricated default as "unknown". A usable map always resolves its
// value first (inner2 >= 0), so set_map_key_struct copies the real value and the
// two channels match.
//
// Distinct from test_jctkac_map_field_value_tid (Str keys, no struct-key stamp)
// and test_jctkac_map_struct_key_annotation_kops (struct key, non-generic field).

@derive(Hash, Eq)
type PtK { x: Int, y: Int }

type PtV { v: Int }

type GKeyHolder[T] { m: Map[PtK, T] }

fn generic_field_struct_key_value() -> Int {
    let mut mm: Map[PtK, PtV] = Map()
    mm.insert(PtK { x: 1, y: 2 }, PtV { v: 7 })
    let h: GKeyHolder[PtV] = GKeyHolder { m: mm }
    h.m.get(PtK { x: 1, y: 2 }).unwrap().v
}

test "a generic-struct field Map with a struct key resolves its struct value across the projection" {
    assert_eq(generic_field_struct_key_value(), 7)
}

fn generic_field_struct_key_scalar() -> Int {
    let mut mm: Map[PtK, Int] = Map()
    mm.insert(PtK { x: 3, y: 4 }, 42)
    let h: GKeyHolder[Int] = GKeyHolder { m: mm }
    h.m.get(PtK { x: 3, y: 4 }).unwrap()
}

test "a generic-struct field Map with a struct key resolves a scalar value across the projection" {
    assert_eq(generic_field_struct_key_scalar(), 42)
}
