// Map[K, V] with a user struct as K, via @derive(Hash, Eq).

@derive(Hash, Eq)
type Point { x: Int, y: Int }

fn main() {
    let mut m: Map[Point, Int] = Map()
    m.insert(Point { x: 0, y: 0 }, 100)
    m.insert(Point { x: 1, y: 2 }, 200)
    m.insert(Point { x: 3, y: 4 }, 300)

    if m.len() != 3 { io.println("FAIL len after insert: {m.len()}"); return }
    if !m.contains_key(Point { x: 1, y: 2 }) { io.println("FAIL contains_key(1,2)"); return }
    if !m.contains_key(Point { x: 0, y: 0 }) { io.println("FAIL contains_key(0,0)"); return }
    if m.contains_key(Point { x: 9, y: 9 }) { io.println("FAIL contains_key(9,9) should be false"); return }

    let v = m.get(Point { x: 1, y: 2 }).unwrap()
    if v != 200 { io.println("FAIL get(1,2) = {v}, expected 200"); return }

    // Update existing key
    m.insert(Point { x: 1, y: 2 }, 999)
    if m.get(Point { x: 1, y: 2 }).unwrap() != 999 { io.println("FAIL update value"); return }
    if m.len() != 3 { io.println("FAIL len after update: {m.len()}"); return }

    if !m.remove(Point { x: 3, y: 4 }) { io.println("FAIL remove(3,4)"); return }
    if m.contains_key(Point { x: 3, y: 4 }) { io.println("FAIL contains_key after remove"); return }
    if m.len() != 2 { io.println("FAIL len after remove: {m.len()}"); return }

    m.clear()
    if !m.is_empty() { io.println("FAIL is_empty after clear"); return }

    io.println("PASS: Map[Point, Int]")
}
