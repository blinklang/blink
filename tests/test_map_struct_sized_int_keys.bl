// Regression: Map[Point, V] where Point has sized-int fields. Hash mixed
// these fields but eq used to drop them, so two distinct keys could compare
// equal. Verify both hash and eq cover sized ints.

@derive(Hash, Eq)
type Point { x: I32, y: I32 }

fn main() ! IO {
    let mut m: Map[Point, Int] = Map()
    m.insert(Point { x: 1, y: 2 }, 12)
    m.insert(Point { x: 3, y: 4 }, 34)

    if m.get(Point { x: 1, y: 2 }).unwrap() != 12 { io.println("FAIL: lookup (1,2)"); return }
    if m.get(Point { x: 3, y: 4 }).unwrap() != 34 { io.println("FAIL: lookup (3,4)"); return }

    // Differs only in low bits of x: if eq drops I32 fields, this would
    // alias the (1,2) entry and read 12 instead of returning none.
    if m.contains_key(Point { x: 2, y: 2 }) { io.println("FAIL: (2,2) should not alias (1,2)"); return }
    if m.len() != 2 { io.println("FAIL: len"); return }

    io.println("PASS: Map[Point, Int] with I32 fields")
}
