// Map[K, V] with a tuple as K. Per spec §3.8: tuple Hash/Eq are auto-derived
// when all elements satisfy the trait. (Str, Int) -> Map keys work without
// any user @derive annotation.
fn main() ! IO {
    let mut m: Map[(Str, Int), Int] = Map()
    m.insert(("apple", 1), 100)
    m.insert(("apple", 2), 200)
    m.insert(("banana", 1), 300)

    let a1 = m.get(("apple", 1)).unwrap()
    let a2 = m.get(("apple", 2)).unwrap()
    let b1 = m.get(("banana", 1)).unwrap()
    if a1 != 100 || a2 != 200 || b1 != 300 {
        io.println("FAIL: tuple-key get")
        return
    }

    if m.contains_key(("apple", 1)) == false || m.contains_key(("apple", 99)) == true {
        io.println("FAIL: tuple-key contains_key")
        return
    }

    // update via re-insert
    m.insert(("apple", 1), 111)
    if m.get(("apple", 1)).unwrap() != 111 {
        io.println("FAIL: tuple-key update")
        return
    }

    m.remove(("banana", 1))
    if m.contains_key(("banana", 1)) == true || m.len() != 2 {
        io.println("FAIL: tuple-key remove/len")
        return
    }

    io.println("PASS: Map[(Str, Int), Int]")
}
