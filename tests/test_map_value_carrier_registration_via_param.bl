import compile_test_helpers

fn map_value_generic_struct_carrier_src() -> Str {
    #"type SwB[T] {
    v: T
}

fn first_v(m: Map[Str, Option[SwB[Int]]]) -> Int {
    match m.get("k") ?? None {
        Some(b) => { return b.v }
        None => { return -1 }
    }
}

fn main() {
    let mut m: Map[Str, Option[SwB[Int]]] = Map()
    m.insert("k", Some(SwB { v: 9 }))
    io.println("{first_v(m)}")
}
"#
}

test "a Map value that carries a generic struct is registered when the Map is named only by a parameter" {
    let r = compile_test_helpers.compile_and_run(map_value_generic_struct_carrier_src(), "_map_value_generic_struct_carrier")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("9"), "expected the inserted struct's field value: out={r.out}")
}

fn tuple_value_map_via_unwrap() -> Int {
    let mut m: Map[Str, (Int, Int)] = Map()
    m.insert("k", (3, 4))
    pair_of(m)
}

fn pair_of(m: Map[Str, (Int, Int)]) -> Int {
    let t = m.get("k").unwrap()
    t.0 + t.1
}

test "a Map value that is a tuple, read via unwrap, is registered when the Map is named only by a parameter" {
    assert_eq(tuple_value_map_via_unwrap(), 7)
}
