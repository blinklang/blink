// A Map returned from a function and bound with `let m = <call>()` (no type
// annotation on the binding) keeps its value type through `.values()`, for
// both a struct value and an Option value.

type Pt { x: Int }

fn mkpt() -> Map[Str, Pt] {
    let mut m: Map[Str, Pt] = Map()
    m.insert("a", Pt { x: 4 })
    m
}

fn mopt() -> Map[Str, Option[Int]] {
    let mut m: Map[Str, Option[Int]] = Map()
    m.insert("k", Some(7))
    m
}

test "unannotated let-bound Map.values() keeps a struct value type" {
    let m = mkpt()
    let mut total = 0
    for v in m.values() { total = total + v.x }
    assert_eq(total, 4)
}

test "unannotated let-bound Map.values() keeps an Option value type" {
    let m = mopt()
    let mut total = 0
    for v in m.values() { total = total + v.unwrap() }
    assert_eq(total, 7)
}
