// 54rp9j: Map.values() over a nested-container value type must keep the inner
// element metadata, so a for-in over each value knows its element. Covers both
// Map[K,List[V]] and Map[K,Set[V]] — .values() is a distinct producer from
// .get(), and each yields the value type whose element the loop reads back.

test "Map[Str,List[Int]].values() keeps the List element" {
    let mut ml: Map[Str, List[Int]] = Map()
    ml.insert("x", [4, 5])
    ml.insert("y", [6])
    let mut total = 0
    for lst in ml.values() {
        for x in lst {
            total = total + x
        }
    }
    assert_eq(total, 15)
}

test "Map[Str,Set[Int]].values() keeps the Set element" {
    let mut s1 = Set()
    s1.insert(1)
    s1.insert(2)
    let mut s2 = Set()
    s2.insert(3)
    let mut ms: Map[Str, Set[Int]] = Map()
    ms.insert("a", s1)
    ms.insert("b", s2)
    let mut total = 0
    for st in ms.values() {
        for x in st {
            total = total + x
        }
    }
    assert_eq(total, 6)
}
