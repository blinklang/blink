// A match arm's payload binder must take the substituted type of the scrutinee's
// concrete instance, even when the scrutinee is a generic enum instance returned by
// a call through a closure-typed value (not a plain named-fn call or a fn parameter).

type Maybe[T] {
    Nothing,
    Just(v: T)
}

test "match arm binder types correctly for a generic enum instance from a closure call result" {
    let m: fn(Int) -> Maybe[Str] = fn(k: Int) -> Maybe[Str] { Maybe.Just("j{k}") }
    let result = match m(3) {
        Maybe.Just(v) => v
        Maybe.Nothing => "nothing"
    }
    assert_eq(result, "j3")
}
