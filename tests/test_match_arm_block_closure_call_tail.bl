// A match arm implemented as a braced { } block whose TAIL expression is a closure
// call must propagate its result type outward to the match's own result binding,
// not erase it. Covers the specific (match arm) + (braces) + (closure-call tail)
// combination, plus the sibling shapes the ticket named as controls.

test "match-arm block tail that is a closure call keeps its result type" {
    let n = 1
    let r = match n {
        1 => {
            let g = fn() -> Int { 42 }
            g()
        }
        _ => 0
    }
    assert_eq(r, 42)
}

test "braceless match-arm closure call keeps its result type" {
    let n = 1
    let g = fn() -> Int { 42 }
    let r = match n {
        1 => g()
        _ => 0
    }
    assert_eq(r, 42)
}

test "a plain non-match block with a closure-call tail keeps its result type" {
    let r = {
        let g = fn() -> Int { 42 }
        g()
    }
    assert_eq(r, 42)
}

test "a match-arm block with a non-closure tail keeps its result type" {
    let n = 1
    let r = match n {
        1 => {
            let x = 42
            x
        }
        _ => 0
    }
    assert_eq(r, 42)
}
