// Unannotated closures in the arms of one match share one return type, so the closure a match
// picks returns the value its body computes, whichever arm it came from.

fn pick(x: Int) -> fn(Int) -> Int {
    match x {
        0 => fn(i: Int) { i + 1 }
        1 => fn(i: Int) { i * 10 }
        _ => fn(i: Int) { i - 1 }
    }
}

test "the closure a match arm yields returns its body's value" {
    assert_eq(pick(0)(3), 4)
    assert_eq(pick(1)(3), 30)
    assert_eq(pick(2)(3), 2)
}

test "a match bound by let keeps each arm's closure return" {
    let x = 1
    let f = match x {
        0 => fn(i: Int) { i + 1 }
        _ => fn(i: Int) { i * 10 }
    }
    assert_eq(f(3), 30)
}

test "nested matches of closures return the inner arm's value" {
    let x = 1
    let y = 0
    let f = match x {
        0 => fn(i: Int) { i }
        _ => match y {
            0 => fn(i: Int) { i * 100 }
            _ => fn(i: Int) { i * 1000 }
        }
    }
    assert_eq(f(3), 300)
}
