// Arms that share one bare struct-style variant and split its payload between them cover
// the variant, as the qualified `E.V { .. }` spelling does.

type SplitE { V { r: Option[Int] } }

fn none_first(e: SplitE) -> Int {
    match e {
        V { r: None } => -1
        V { r: Some(x) } => x
    }
}

fn some_first(e: SplitE) -> Int {
    match e {
        V { r: Some(x) } => x
        V { r: None } => -1
    }
}

test "a bare struct-style variant split None then Some selects each arm" {
    assert_eq(none_first(SplitE.V { r: Some(5) }), 5)
    assert_eq(none_first(SplitE.V { r: None }), -1)
}

test "a bare struct-style variant split Some then None selects each arm" {
    assert_eq(some_first(SplitE.V { r: Some(6) }), 6)
    assert_eq(some_first(SplitE.V { r: None }), -1)
}
