// A match binder taken from a captured carrier inside a closure body must keep the
// inner container's type arguments (Map[Str,Bx] value type), not just its head type.

type Bx { v: Int }

test "match binder from a captured Option[Map[Str,Bx]] inside a closure keeps the value type" {
    let mut m: Map[Str, Bx] = Map()
    m.insert("k", Bx { v: 9 })
    let mut cell: Option[Map[Str, Bx]] = Some(m)
    let peek = fn() -> Int {
        match cell {
            Some(mm) => {
                match mm.get("k") {
                    Some(b) => b.v
                    None => -1
                }
            }
            None => -2
        }
    }
    assert_eq(peek(), 9)
}
