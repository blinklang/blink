// Regression for e53h5n: block-arm match over Result in tail position must wire
// the pattern-bound arm value into the function return, not discard it.
fn unwrap_or_neg(r: Result[Int, Str]) -> Int {
    match r {
        Ok(v) => { v }
        Err(e) => { -1 }
    }
}

test "block-arm match over Result in tail position returns arm value" {
    assert_eq(unwrap_or_neg(Ok(7)), 7)
    assert_eq(unwrap_or_neg(Err("boom")), -1)
}
