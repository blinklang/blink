// Regression for e53h5n: a block-arm match returning a non-Int scalar payload
// (Str here) must infer the carrier type from the arm pattern, not default to
// CT_INT. Before the fix, infer_block_type's get_var_type lookup on the
// not-yet-in-scope pattern binding `s` defaulted to CT_INT, so the _match_ slot
// was declared int64_t and the const char* arm value was mis-assigned.
fn pick_str(o: Option[Str]) -> Str {
    match o {
        Some(s) => { s }
        None => { "none" }
    }
}

test "block-arm match over Option[Str] in tail position returns arm value" {
    let some_o = Some("hi")
    assert(pick_str(some_o) == "hi", "Some arm")
    let none_o: Option[Str] = None
    assert(pick_str(none_o) == "none", "None arm")
}
