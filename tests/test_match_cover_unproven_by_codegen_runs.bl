// An exhaustive match whose cover codegen cannot prove still compiles and runs its arms.
// The panic codegen adds after the last arm is never reached.

fn pair(a: Bool, b: Bool) -> Int {
    match (a, b) {
        (true, _) => 1
        (false, true) => 2
        (false, false) => 3
    }
}

test "an exhaustive tuple-of-Bool match returns each arm's value" {
    assert_eq(pair(true, false), 1)
    assert_eq(pair(true, true), 1)
    assert_eq(pair(false, true), 2)
    assert_eq(pair(false, false), 3)
}

test "the same match in statement position runs exactly one arm" {
    let mut hits = 0
    let mut which = 0
    match (false, false) {
        (true, _) => {
            hits = hits + 1
            which = 1
        }
        (false, true) => {
            hits = hits + 1
            which = 2
        }
        (false, false) => {
            hits = hits + 1
            which = 3
        }
    }
    assert_eq(hits, 1)
    assert_eq(which, 3)
}
