// Matches with no wildcard arm that still cover every value: list arms whose lengths
// jointly cover every list, and tuple arms where the arms that refute at one shared
// position cover it, beside an arm that refutes at two.

fn first_or_zero(xs: List[Int]) -> Int {
    match xs {
        [] => 0
        [first, ...] => first
    }
}

fn by_length(xs: List[Int]) -> Str {
    match xs {
        [] => "none"
        [a] => "one {a}"
        [a, b, ...] => "many {a} {b}"
    }
}

fn whole_first(xs: List[Str]) -> Str {
    match xs {
        [] => "-"
        [a as head, ...] => head
    }
}

fn option_pair(t: (Option[Int], Int)) -> Int {
    match t {
        (Some(v), 1) => v * 10
        (Some(v), _) => v
        (None, _) => -1
    }
}

fn result_pair(t: (Result[Int, Str], Int)) -> Str {
    match t {
        (Ok(x), 0) => "zero {x}"
        (Ok(x), _) => "ok {x}"
        (Err(e), _) => "err {e}"
    }
}

test "list arms cover every length" {
    assert_eq(first_or_zero([]), 0)
    assert_eq(first_or_zero([4, 5]), 4)
    assert_eq(by_length([]), "none")
    assert_eq(by_length([7]), "one 7")
    assert_eq(by_length([1, 2, 3]), "many 1 2")
    assert_eq(whole_first([]), "-")
    assert_eq(whole_first(["x", "y"]), "x")
}

test "tuple arms cover the shared position in written order" {
    assert_eq(option_pair((Some(3), 1)), 30)
    assert_eq(option_pair((Some(3), 2)), 3)
    assert_eq(option_pair((None, 1)), -1)
    assert_eq(result_pair((Ok(5), 0)), "zero 5")
    assert_eq(result_pair((Ok(5), 9)), "ok 5")
    assert_eq(result_pair((Err("bad"), 0)), "err bad")
}
