// A match expression whose arm value is a field access through a Ptr binder must be lowered
// as an expression, not dropped to a statement with the let given a placeholder zero.
//
// The mirror names the C struct its header declares, so the row runs as `blink test` in a
// package that vendors that header.

import compile_test_helpers.{vendored_header_project, blink_in_project}

let HEADER = #"#include <stdint.h>
struct rpoint { int64_t x; int64_t y; };
"#

let SOURCE = #"@ffi.struct(header: "rpoint.h", name: "rpoint")
type RPoint { x: Int, y: Int }

test "match arm binder holding a pointer reads the field as the match's value" {
    with ffi.scope() as scope {
        let p: Ptr[RPoint] = scope.alloc()
        p.write(RPoint { x: 9, y: 10 })
        let op: Option[Ptr[RPoint]] = Some(p)
        let got = match op {
            Some(q) => q.x.read()
            None => 0
        }
        assert_eq(got, 9)
    }
}
"#

test "match arm binder holding a pointer reads the field as the match's value" {
    let dir = vendored_header_project("match_option_ptr_arm", "rpoint.h", HEADER, SOURCE)
    let r = blink_in_project(dir, "test src/main.bl")
    assert(r.success(), "{r.out}{r.err_out}")
    assert(r.out.contains("1 passed, 0 failed"), "{r.out}{r.err_out}")
}
