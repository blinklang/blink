// A match expression whose arm value is a field access through a Ptr binder must be lowered
// as an expression, not dropped to a statement with the let given a placeholder zero.

type RPoint { x: Int, y: Int }

test.failing(
    "match arm binder holding a pointer reads the field as the match's value",
    reason: "the match-expression value path emits the match as a statement and constant-folds the let to 0 when an arm's value is a field access through a Ptr binder",
    ticket: "4hn7ep",
) {
    with ffi.scope() as scope {
        let p: Ptr[RPoint] = scope.alloc()
        p.write(RPoint { x: 9, y: 10 })
        let op: Option[Ptr[RPoint]] = Some(p)
        let got = match op {
            Some(q) => q.x
            None => 0
        }
        assert_eq(got, 9)
    }
}
