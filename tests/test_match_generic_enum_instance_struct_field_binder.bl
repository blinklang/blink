// Matching a struct field whose type is a generic-enum INSTANCE (SB[Int].e: TE[Int])
// must resolve the scrutinee to its mono typedef (blink_TE_0Int) and the arm binder
// to the payload's real field type, not erase both to void/bare-base. No carrier
// (Option/Result) is involved at all — this is the match-binding path alone.

import compile_test_helpers.{compile_and_run}

test.failing(
    "matching a generic-enum instance held in a struct field resolves the scrutinee and binder types",
    reason: "the struct field's declared enum-instance type erases to the bare unmangled base (blink_TE) instead of the mono typedef (blink_TE_0Int), so the match scrutinee is not a struct/union at all and the arm binder x is declared void, failing to compile",
    ticket: "xghvrx",
) {
    let src = #"
import std.io

type TE[T] { Leaf(v: T), Nil }
type SB[T] { e: TE[T] }

fn main() ! IO {
    let b: SB[Int] = SB { e: Leaf(7) }
    match b.e {
        Leaf(x) => io.println("leaf {x}")
        Nil => io.println("nil")
    }
}
"#
    let r = compile_and_run(src, "_match_generic_enum_instance_struct_field_binder")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "leaf 7\n")
}
