// A match whose scrutinee is typed only by a later statement (a push-built list, an
// inferred Map) reads the solved type, at the top and at every nested sub-pattern.

import std.errno.{Errno}

type SColor { Red, Green, Blue }

fn enum_from_inferred_list() -> Int {
    let mut xs = []
    xs.push(SColor.Blue)
    match xs.get(0).unwrap() {
        SColor.Red => 1
        SColor.Green => 2
        SColor.Blue => 3
    }
}

test "an exhaustive enum match on an inferred list element selects its arm" {
    assert_eq(enum_from_inferred_list(), 3)
}

fn option_from_inferred_list(i: Int) -> Int {
    let mut xs = []
    xs.push(Some(7))
    xs.push(None)
    let o = xs.get(i).unwrap()
    match o {
        Some(v) => v
        None => -2
    }
}

test "a Some/None match on an inferred list element binds the payload" {
    assert_eq(option_from_inferred_list(0), 7)
    assert_eq(option_from_inferred_list(1), -2)
}

fn newtype_from_inferred_map() -> Int {
    let mut m = Map()
    m.insert("a", Errno(5))
    let e = m.get("a").unwrap()
    match e { Errno(rc) => rc }
}

test "a newtype match on an inferred Map value binds its field" {
    assert_eq(newtype_from_inferred_map(), 5)
}

fn nested_from_inferred_list() -> Int {
    let mut xs = []
    xs.push(Some(Some("abc")))
    match xs.get(0).unwrap() {
        Some(Some(s)) => s.len()
        Some(None) => 0
        None => -1
    }
}

test "a nested carrier solved only through the outer one binds the inner payload" {
    assert_eq(nested_from_inferred_list(), 3)
}

fn nested_through_get(i: Int) -> Int {
    let mut xs = []
    xs.push(Some("hi"))
    xs.push(None)
    match xs.get(i) {
        Some(Some(s)) => s.len()
        Some(None) => 0
        None => -1
    }
}

test "a nested match on get() of an inferred list selects each arm" {
    assert_eq(nested_through_get(0), 2)
    assert_eq(nested_through_get(1), 0)
    assert_eq(nested_through_get(5), -1)
}
