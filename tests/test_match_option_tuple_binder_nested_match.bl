// Matching a tuple bound out of an Option payload, then matching that tuple
// binder in a nested match, must register the inner match's scrutinee slot
// without the compiler panicking.

import compile_test_helpers.{compile_and_run}

test "matching a tuple binder from an Option payload in a nested match compiles and runs" {
    let src = #"
import std.io
fn main() ! IO {
    let o: Option[(Int, Int)] = Some((3, 4))
    let n = match o {
        Some(t) => match t { (a, b) => a + b }
        None => 0
    }
    io.println("n={n}")
}
"#
    let r = compile_and_run(src, "_match_option_tuple_binder_nested_match")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=7\n")
}
