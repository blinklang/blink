// Bug hnkrcz: `match` over a Tuple-RETURNING call (not a tuple literal) panicked
// codegen at bind time. emit_match_expr only split the scrutinee into one
// match_scruts entry per tuple element for a literal `TupleLit` scrutinee; a
// tuple-typed call/ident/field fell through to the general path and pushed ONE
// entry for the whole tuple. A TuplePattern arm then indexed scrut_off + j past
// the single entry -> `unwrap called on None`. The fix mirrors the TupleLit fast
// path: materialize the tuple into one temp and push one `._i` field-access entry
// per element.

fn pair() -> Tuple[Int, Int] { (1, 2) }

fn labelled() -> Tuple[Str, Int] { ("x", 9) }

test "match over a tuple-returning call with a literal element" {
    match pair() {
        (1, y) => assert_eq(y, 2)
        _ => assert_eq(1, 0)
    }
}

test "match over a tuple-returning call binding both elements" {
    let mut out = ""
    match pair() {
        (x, y) => out = "{x},{y}"
    }
    assert_eq(out, "1,2")
}

test "match over a tuple call with a string (non-int scalar) element" {
    match labelled() {
        ("x", n) => assert_eq(n, 9)
        _ => assert_eq(1, 0)
    }
    match labelled() {
        (s, n) => {
            assert_eq(s, "x")
            assert_eq(n, 9)
        }
    }
}
