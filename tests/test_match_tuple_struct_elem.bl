type Point { x: Int y: Int }

type Shape { Circle(Int) Square(Int) }

test "match tuple literal with struct element reads fields" {
    let p0 = Point { x: 3, y: 4 }
    let r = match (p0, 9) {
        (p, n) => p.x + p.y + n
    }
    assert_eq(r, 16)
}

test "match tuple literal with data-enum element matches bound var" {
    let r = match (Circle(5), 9) {
        (s, n) => {
            let inner = match s { Circle(x) => x Square(x) => x }
            inner + n
        }
    }
    assert_eq(r, 14)
}
