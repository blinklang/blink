type E {
    A(s: Str),
    B,
}

fn make_err() -> Result[Int, E] { Err(E.A("hello")) }
fn make_ok() -> Result[Int, E] { Ok(42) }

test "Err(E.A(msg)) binds msg as Str" {
    let r = make_err()
    let mut got = ""
    match r {
        Ok(_) => {}
        Err(E.A(msg)) => got = msg
        Err(_) => {}
    }
    assert(got.contains("hello"))
}

test "Ok arm binds payload as Int" {
    let r = make_ok()
    let mut got = 0
    match r {
        Ok(n) => got = n
        Err(_) => {}
    }
    assert_eq(got, 42)
}

type Point {
    Pt(x: Int, y: Int),
    Origin,
}

test "multi-field positional variant binds each field" {
    let p = Point.Pt(3, 4)
    let mut sum = 0
    match p {
        Point.Pt(x, y) => sum = x + y
        Point.Origin => {}
    }
    assert_eq(sum, 7)
}

type Tag {
    Named(label: Str),
    Anon,
}

fn shout(t: Tag) -> Str {
    match t {
        Named(s) => s
        Anon => "anon"
    }
}

test "unqualified A(msg) short form still binds typed field" {
    assert_eq(shout(Tag.Named("hey")), "hey")
    assert_eq(shout(Tag.Anon), "anon")
}
