// memory and processes limits through a delegated cgroup v2 (sections/04_effects.md §4.4.8
// Memory and process count need a delegated cgroup v2). Each case runs a helper program in a
// transient systemd scope with Delegate=yes, so the helper has a cgroup of its own to write
// to. The case skips where no such scope can start (no user systemd, no cgroup v2).
//
// The helper is built standalone (blinkc to C that includes runtime.h), as the program must
// be the only process in its cgroup, and a test binary is not.

import compile_test_helpers
import std.process.{ChildEnd, ChildLimits, ProcessError, ProcessResult}
import std.time.{Duration}

// args: mode, and for some modes a file path. Each mode prints lines that the test compares.
fn helper_program() -> Str {
    [
        #"import std.process.{ChildLimits, LimitKind, ProcessError, ProcessResult, SIGTERM}"#,
        #"import std.errno.{Errno}"#,
        #"import std.time.{Duration}"#,
        #""#,
        #"fn my_cg() -> Str {"#,
        #"    process.run("sh", ["-c", "cut -d: -f3- /proc/$PPID/cgroup"]).unwrap().out.trim()"#,
        #"}"#,
        #""#,
        #"fn child_dirs(d: Str) -> Str {"#,
        #"    process.run("sh", ["-c", "cd /sys/fs/cgroup$0 && for x in blink.child.*; do [ -d \"$x\" ] && printf '%s ' \"$x\"; done; true", d]).unwrap().out.trim()"#,
        #"}"#,
        #""#,
        #"fn gone_within(d: Str, ms: Int) -> Bool {"#,
        #"    let start = time.read()"#,
        #"    while start.elapsed().to_ms() < ms {"#,
        #"        if child_dirs(d) == "" {"#,
        #"            return true"#,
        #"        }"#,
        #"        time.sleep(Duration.ms(50))"#,
        #"    }"#,
        #"    false"#,
        #"}"#,
        #""#,
        #"fn exists_within(path: Str, ms: Int) -> Bool {"#,
        #"    let start = time.read()"#,
        #"    while start.elapsed().to_ms() < ms {"#,
        #"        if process.run("test", ["-s", path]).unwrap().success() {"#,
        #"            return true"#,
        #"        }"#,
        #"        time.sleep(Duration.ms(20))"#,
        #"    }"#,
        #"    false"#,
        #"}"#,
        #""#,
        #"fn mb(n: Int) -> Int {"#,
        #"    n * 1024 * 1024"#,
        #"}"#,
        #""#,
        #"fn show(name: Str, r: Result[ProcessResult, ProcessError]) {"#,
        #"    match r {"#,
        #"        Ok(p) => io.println("{name} end {p.end}")"#,
        #"        Err(e) => {"#,
        #"            let code = match e.code {"#,
        #"                Errno(c) => c"#,
        #"            }"#,
        #"            io.println("{name} errno {code}")"#,
        #"        }"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn main() {"#,
        #"    let a = env.args()"#,
        #"    let me = a.get(0).unwrap()"#,
        #"    let d = my_cg()"#,
        #"    match a.get(1).unwrap() {"#,
        #"        "can" => {"#,
        #"            io.println("can {process.can_limit(LimitKind.Memory)} {process.can_limit(LimitKind.Processes)}")"#,
        #"            io.println("moved {my_cg() != d}")"#,
        #"            io.println("dirs [{child_dirs(d)}]")"#,
        #"        }"#,
        #"        "where" => {"#,
        #"            let script = "p=$(cut -d: -f3- /proc/self/cgroup); echo cg $p; cd /sys/fs/cgroup$p && echo files $(cat memory.max memory.swap.max memory.oom.group pids.max)""#,
        #"            let r = process.run("sh", ["-c", script], limits: ChildLimits { memory: Some(mb(64)), processes: Some(9) }).unwrap()"#,
        #"            io.print(r.out)"#,
        #"            io.println("end {r.end}")"#,
        #"            let m = process.run("sh", ["-c", script], limits: ChildLimits { memory: Some(mb(32)) }).unwrap()"#,
        #"            io.print(m.out)"#,
        #"            io.println("d {d}")"#,
        #"            io.println("self {my_cg()}")"#,
        #"        }"#,
        #"        "hog" => {"#,
        #"            let mut xs: List[Int] = []"#,
        #"            while true {"#,
        #"                xs.push(xs.len())"#,
        #"            }"#,
        #"        }"#,
        #"        "forker" => {"#,
        #"            while true {"#,
        #"                let _ = process.spawn("sleep", ["30"])"#,
        #"            }"#,
        #"        }"#,
        #"        "memory" => {"#,
        #"            show("memory", process.run(me, ["hog"], limits: ChildLimits { memory: Some(mb(64)), timeout: Some(Duration.seconds(60)) }))"#,
        #"            io.println("gone {gone_within(d, 5000)}")"#,
        #"        }"#,
        #"        "processes" => {"#,
        #"            show("processes", process.run(me, ["forker"], limits: ChildLimits { processes: Some(8), timeout: Some(Duration.seconds(60)) }))"#,
        #"            io.println("gone {gone_within(d, 5000)}")"#,
        #"        }"#,
        #"        "under" => {"#,
        #"            let both = ChildLimits { memory: Some(mb(64)), processes: Some(16) }"#,
        #"            show("exit3", process.run("sh", ["-c", "exit 3"], limits: both))"#,
        #"            show("true", process.run("true", [], limits: both))"#,
        #"        }"#,
        #"        "removed" => {"#,
        #"            let lim = ChildLimits { memory: Some(mb(64)) }"#,
        #"            show("true", process.run("true", [], limits: lim))"#,
        #"            io.println("gone {gone_within(d, 5000)}")"#,
        #"            show("left", process.run("sh", ["-c", "sleep 3 </dev/null >/dev/null 2>&1 &"], limits: lim))"#,
        #"            io.println("held [{child_dirs(d)}]")"#,
        #"            io.println("gone {gone_within(d, 15000)}")"#,
        #"        }"#,
        #"        "unlimited" => {"#,
        #"            let kid = process.spawn("sleep", ["30"]).unwrap()"#,
        #"            show("true", process.run("true", [], limits: ChildLimits { memory: Some(mb(64)) }))"#,
        #"            let pid = process.run("pgrep", ["-x", "-P", "{getpid()}", "sleep"]).unwrap().out.trim()"#,
        #"            let kid_cg = process.run("cut", ["-d:", "-f3-", "/proc/{pid}/cgroup"]).unwrap().out.trim()"#,
        #"            io.println("kid {kid_cg == "{d}/blink.self"}")"#,
        #"            io.println("self {my_cg() == "{d}/blink.self"}")"#,
        #"            let _ = process.signal(kid, SIGTERM)"#,
        #"            let _ = process.wait(kid)"#,
        #"        }"#,
        #"        "busy" => {"#,
        #"            io.println("can {process.can_limit(LimitKind.Memory)}")"#,
        #"            let o = process.run("sh", ["-c", "sleep 30 </dev/null >/dev/null 2>&1 & echo $!"]).unwrap()"#,
        #"            let orphan = o.out.trim()"#,
        #"            io.println("orphan {orphan}")"#,
        #"            show("first", process.run("true", [], limits: ChildLimits { memory: Some(mb(64)) }))"#,
        #"            show("second", process.run("true", [], limits: ChildLimits { processes: Some(4) }))"#,
        #"            show("timeout", process.run("true", [], limits: ChildLimits { timeout: Some(Duration.seconds(10)) }))"#,
        #"            let _ = process.run("kill", [orphan])"#,
        #"        }"#,
        #"        "inner" => {"#,
        #"            show("inner", process.run(me, ["hog"], limits: ChildLimits { memory: Some(mb(64)), timeout: Some(Duration.seconds(60)) }))"#,
        #"            // Runs on a while, so the outer program reads the events of its child's cgroup"#,
        #"            // before this one ends."#,
        #"            time.sleep(Duration.ms(500))"#,
        #"        }"#,
        #"        "nested" => {"#,
        #"            // A limited child that is itself a program with a memory limit of its own."#,
        #"            let r = process.run(me, ["inner"], limits: ChildLimits { memory: Some(mb(400)), timeout: Some(Duration.seconds(60)) }).unwrap()"#,
        #"            io.println("nested end {r.end}")"#,
        #"            io.print(r.out)"#,
        #"            io.println("gone {gone_within(d, 5000)}")"#,
        #"        }"#,
        #"        "quick" => {"#,
        #"            show("true", process.run("true", [], limits: ChildLimits { memory: Some(mb(64)) }))"#,
        #"            io.println("d {d}")"#,
        #"        }"#,
        #"        "first" => {"#,
        #"            // The child ignores the SIGTERM of its deadline, then passes its memory limit."#,
        #"            let script = "trap '' TERM; sleep 1; x=$(head -c 512M /dev/zero | tr '\\000' a); echo done""#,
        #"            let start = time.read()"#,
        #"            show("first", process.run("sh", ["-c", script], limits: ChildLimits { memory: Some(mb(64)), timeout: Some(Duration.ms(300)), grace: Duration.seconds(10) }))"#,
        #"            io.println("quick {start.elapsed().to_ms() < 5000}")"#,
        #"        }"#,
        #"        "signal" => {"#,
        #"            // The grandchild leaves the process group of the child, and notes its SIGTERM."#,
        #"            let f = a.get(2).unwrap()"#,
        #"            let script = "setsid sh -c 'trap \"echo t > $0.term; exit 0\" TERM; echo $$ > $0.pid; while :; do sleep 0.05; done' \"$0\" </dev/null >/dev/null 2>&1 & while [ ! -s \"$0.pid\" ]; do sleep 0.01; done; sleep 30""#,
        #"            show("signal", process.run("sh", ["-c", script, f], limits: ChildLimits { memory: Some(mb(64)), timeout: Some(Duration.seconds(2)), grace: Duration.seconds(5) }))"#,
        #"            io.println("term {exists_within("{f}.term", 5000)}")"#,
        #"            io.println("gone {gone_within(d, 5000)}")"#,
        #"        }"#,
        #"        "exit" => {"#,
        #"            // The program returns while a grandchild that left the process group still runs."#,
        #"            let f = a.get(2).unwrap()"#,
        #"            let script = "setsid sh -c 'echo $$ > $0.pid; exec sleep 30' \"$0\" </dev/null >/dev/null 2>&1 & sleep 30""#,
        #"            let _kid = process.spawn("sh", ["-c", script, f], limits: ChildLimits { memory: Some(mb(64)) }).unwrap()"#,
        #"            if exists_within("{f}.pid", 10000) {"#,
        #"                io.println("pid {process.run("cat", ["{f}.pid"]).unwrap().out.trim()}")"#,
        #"            } else {"#,
        #"                io.println("no pid file")"#,
        #"            }"#,
        #"        }"#,
        #"        _ => io.println("unknown mode")"#,
        #"    }"#,
        #"}"#,
        #""#,
    ].join("\n")
}

fn work_dir() -> Str {
    "{compile_test_helpers.scratch_root()}/_cgroup_limits"
}

// Built once per test binary; each later case finds it.
fn helper_bin() -> Str {
    let dir = work_dir()
    let bin = "{dir}/cgroup_limits_helper"
    if process.run("test", ["-x", bin]).unwrap().success() {
        return bin
    }
    shell_exec("mkdir -p {dir}")
    let src = "{dir}/cgroup_limits_helper.bl"
    let c_path = "{dir}/cgroup_limits_helper.c"
    write_file(src, helper_program())
    let emit = process.run("build/blinkc", [src, c_path]).unwrap()
    assert_eq(emit.end, ChildEnd.Exited(0), "blinkc failed:\n{emit.out}{emit.err_out}")
    let cc = process.run("cc", ["-O1", "-w", "-Ibootstrap", "-o", bin, c_path, "-lm", "-lgc", "-pthread"]).unwrap()
    assert_eq(cc.end, ChildEnd.Exited(0), "cc failed:\n{cc.out}{cc.err_out}")
    bin
}

fn scope_args(unit: Str) -> List[Str] {
    ["--user", "--scope", "--quiet", "--collect", "-p", "Delegate=yes", "-p", "MemoryMax=512M", "-p", "TasksMax=256", "--slice=blink-gates.slice", "--unit", unit]
}

// The reason this host cannot give a test a delegated cgroup v2 with the memory and pids
// controllers, or "" when it can. Any other failure of the probe scope fails the test.
fn scope_problem(tag: Str) -> Str {
    let unit = "blink-cgtest-{getpid()}-{tag}-probe"
    let script = "cat \"/sys/fs/cgroup$(cut -d: -f3- /proc/self/cgroup)/cgroup.controllers\""
    let r = scope_run(unit, ["sh", "-c", script])
    end_scope(unit)
    match r {
        Ok(p) => {
            if p.err_out.contains("Failed to connect") {
                return "no user systemd manager here: {p.err_out.trim()}"
            }
            assert_eq(p.end, ChildEnd.Exited(0), "systemd-run cannot start a delegated scope: {p.err_out.trim()}")
            let words = p.out.trim().split(" ")
            if !words.contains("memory") || !words.contains("pids") {
                return "a delegated scope here has no memory and pids controllers: [{p.out.trim()}]"
            }
            ""
        }
        Err(e) => "systemd-run cannot run here: {e}"
    }
}

// Ends whatever the scope still holds, so that a failed case leaves no process behind.
fn end_scope(unit: Str) {
    let _ = process.run("sh", ["-c", "cg=$(systemctl --user show -P ControlGroup \"$0\" 2>/dev/null); [ -n \"$cg\" ] && [ -e \"/sys/fs/cgroup$cg/cgroup.kill\" ] && echo 1 > \"/sys/fs/cgroup$cg/cgroup.kill\"; true", "{unit}.scope"])
}

// Runs cmd in the delegated scope `unit`. The caller ends the scope.
fn scope_run(unit: Str, cmd: List[Str]) -> Result[ProcessResult, ProcessError] {
    // A case that hung would hang the test; the timeout turns that into a failure.
    process.run("systemd-run", scope_args(unit).append(cmd), limits: ChildLimits { timeout: Some(Duration.seconds(120)) })
}

fn helper_lines(mode: Str, r: Result[ProcessResult, ProcessError]) -> List[Str] {
    let res = r.unwrap()
    assert_eq(res.end, ChildEnd.Exited(0), "helper {mode} failed:\n{res.out}{res.err_out}")
    res.out.trim().split("\n")
}

// Runs the helper in a delegated scope of its own and gives its output lines. `wrap` runs it
// through `sh -c` that stays in the scope, so the scope holds a process the helper did not start.
fn run_in_scope(mode: Str, wrap: Bool) -> List[Str] {
    let bin = helper_bin()
    // Each scope in one test process has a name of its own, as systemd keeps a stopped
    // unit loaded for a short time and refuses its name meanwhile.
    let unit = if wrap { "blink-cgtest-{getpid()}-{mode}-wrap" } else { "blink-cgtest-{getpid()}-{mode}" }
    let cmd = if wrap { ["sh", "-c", "\"$0\" \"$1\"; true", bin, mode] } else { [bin, mode] }
    let r = scope_run(unit, cmd)
    end_scope(unit)
    helper_lines(mode, r)
}

// The path the helper's processes write their pid and marker files next to.
fn mark_file(mode: Str) -> Str {
    let f = "{work_dir()}/{mode}-{getpid()}"
    shell_exec("rm -f {f}.pid {f}.term")
    f
}

test "can_limit is true for memory and processes in a delegated cgroup, and moves nothing" {
    let why = scope_problem("can")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("can", false), ["can true true", "moved false", "dirs []"])
}

test "can_limit is false when the cgroup holds a process that this program did not start" {
    let why = scope_problem("can-wrap")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("can", true), ["can false false", "moved false", "dirs []"])
}

test "a memory or processes child runs in a cgroup of its own, and this program moves to a leaf" {
    let why = scope_problem("where")
    if why != "" {
        skip(why)
    }
    let lines = run_in_scope("where", false)
    assert_eq(lines.len(), 7, lines.join("\n"))
    let d = lines.get(5).unwrap().replace("d ", "")
    assert(lines.get(0).unwrap().starts_with("cg {d}/blink.child."), lines.join("\n"))
    // memory.max, memory.swap.max, memory.oom.group, pids.max
    assert_eq(lines.get(1).unwrap(), "files 67108864 0 1 9")
    assert_eq(lines.get(2).unwrap(), "end exit 0")
    assert(lines.get(3).unwrap().starts_with("cg {d}/blink.child."), lines.join("\n"))
    assert(lines.get(3).unwrap() != lines.get(0).unwrap(), "two children shared one cgroup")
    assert_eq(lines.get(4).unwrap(), "files 33554432 0 1 max")
    assert_eq(lines.get(6).unwrap(), "self {d}/blink.self")
}

test "a child past its memory limit ends as Limit(Memory) and its cgroup goes" {
    let why = scope_problem("memory")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("memory", false), ["memory end limit memory", "gone true"])
}

test "a child that keeps forking past its processes limit ends as Limit(Processes) and its cgroup goes" {
    let why = scope_problem("processes")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("processes", false), ["processes end limit processes", "gone true"])
}

test "a child under its memory and processes limits ends with its own exit code" {
    let why = scope_problem("under")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("under", false), ["exit3 end exit 3", "true end exit 0"])
}

test "the cgroup of a child goes after its reap, or when a grandchild that holds it ends" {
    let why = scope_problem("removed")
    if why != "" {
        skip(why)
    }
    let lines = run_in_scope("removed", false)
    assert_eq(lines.len(), 5, lines.join("\n"))
    assert_eq(lines.get(0).unwrap(), "true end exit 0")
    assert_eq(lines.get(1).unwrap(), "gone true")
    assert_eq(lines.get(2).unwrap(), "left end exit 0")
    assert(lines.get(3).unwrap().starts_with("held [blink.child."), "the grandchild did not hold the cgroup: {lines.get(3).unwrap()}")
    assert_eq(lines.get(4).unwrap(), "gone true")
}

test "an unlimited child that runs at the move goes into the leaf with this program" {
    let why = scope_problem("unlimited")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("unlimited", false), ["true end exit 0", "kid true", "self true"])
}

// EBUSY is 16 on Linux, the only host where a delegated scope starts.
test "a move that a process of another program blocks gives its errno, and each later run the same" {
    let why = scope_problem("busy")
    if why != "" {
        skip(why)
    }
    let lines = run_in_scope("busy", false)
    assert_eq(lines.len(), 5, lines.join("\n"))
    assert_eq(lines.get(0).unwrap(), "can true")
    assert_eq(lines.get(2).unwrap(), "first errno 16")
    assert_eq(lines.get(3).unwrap(), "second errno 16")
    assert_eq(lines.get(4).unwrap(), "timeout end exit 0")
}

test "the first limit that a child passes is its end, also when it passes another before its reap" {
    let why = scope_problem("first")
    if why != "" {
        skip(why)
    }
    // The child ignores the SIGTERM of its timeout, then passes its memory limit long before
    // the grace of 10 s ends.
    assert_eq(run_in_scope("first", false), ["first end limit timeout", "quick true"])
}

test "the SIGTERM of a deadline reaches a grandchild that left the process group of the child" {
    let why = scope_problem("signal")
    if why != "" {
        skip(why)
    }
    let bin = helper_bin()
    let unit = "blink-cgtest-{getpid()}-signal"
    let f = mark_file("signal")
    let r = scope_run(unit, [bin, "signal", f])
    end_scope(unit)
    assert_eq(helper_lines("signal", r), ["signal end limit timeout", "term true", "gone true"])
}

test "at program exit a grandchild that left the process group of a limited child ends too" {
    let why = scope_problem("exit")
    if why != "" {
        skip(why)
    }
    let bin = helper_bin()
    let unit = "blink-cgtest-{getpid()}-exit"
    let f = mark_file("exit")
    let r = scope_run(unit, [bin, "exit", f])
    // Read before end_scope, which would end the grandchild in any case.
    let pid = process.run("cat", ["{f}.pid"]).unwrap().out.trim()
    let state = if pid == "" { "" } else { process.run("ps", ["-o", "stat=", "-p", pid]).unwrap().out.trim() }
    end_scope(unit)
    assert_eq(helper_lines("exit", r), ["pid {pid}"])
    assert(state == "" || state.starts_with("Z"), "grandchild {pid} outlived the program: state {state}")
}

test "a memory limit that a limited child sets on its own child is not the limit of the outer child" {
    let why = scope_problem("nested")
    if why != "" {
        skip(why)
    }
    assert_eq(run_in_scope("nested", false), ["nested end exit 0", "inner end limit memory", "gone true"])
}

test "the cgroup of a reaped child does not outlive this program" {
    let why = scope_problem("quick")
    if why != "" {
        skip(why)
    }
    let bin = helper_bin()
    let unit = "blink-cgtest-{getpid()}-quick"
    let r = scope_run(unit, [bin, "quick"])
    let lines = helper_lines("quick", r)
    let d = if lines.len() == 2 { lines.get(1).unwrap().replace("d ", "") } else { "" }
    // Read before end_scope, which ends what the scope holds but leaves its dirs.
    let left = process.run("sh", ["-c", "cd \"/sys/fs/cgroup$0\" && for x in blink.child.*; do [ -d \"$x\" ] && printf '%s ' \"$x\"; done; true", d]).unwrap().out.trim()
    end_scope(unit)
    assert_eq(lines, ["true end exit 0", "d {d}"])
    assert_eq(left, "")
}
