// A container read out of an unannotated list has an element type that inference solved
// through `push`. A method called on it must check its arguments against that solved type,
// not against the list's element variable itself. The Int Set.contains case has its own
// test; these rows cover the other element types, the Set methods that take a key, and the
// same chain through Option, Map and List elements.
//
// Every row runs the program, so a false type error or a wrong element type shows as a
// failed compile or the wrong output.

import compile_test_helpers
import std.io

fn run_ok(src: Str, tag: Str) -> Str {
    let r = compile_test_helpers.compile_and_run(src, tag)
    if r.exit_code != 0 { io.println("FAIL: {tag} — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
    r.out.trim()
}

test "contains on a Str set read out of an unannotated list" {
    let src = #"fn main() ! IO {
    let mut s = Set()
    s.insert("a")
    s.insert("b")
    let mut d = []
    d.push(s)
    let got = d.get(0).unwrap()
    io.println("a={got.contains("a")} z={got.contains("z")} len={got.len()}")
}
"#
    assert_eq(run_ok(src, "elem_arg_set_str_contains"), "a=true z=false len=2")
}

test "insert and remove on a Str set read out of an unannotated list" {
    let src = #"fn main() ! IO {
    let mut s = Set()
    s.insert("a")
    let mut d = []
    d.push(s)
    let mut got = d.get(0).unwrap()
    got.insert("c")
    got.remove("a")
    io.println("c={got.contains("c")} a={got.contains("a")} len={got.len()}")
}
"#
    assert_eq(run_ok(src, "elem_arg_set_str_insert_remove"), "c=true a=false len=1")
}

test "contains straight off the get-unwrap chain with no binding" {
    let src = #"fn main() ! IO {
    let mut s = Set()
    s.insert("b")
    let mut d = []
    d.push(s)
    io.println("b={d.get(0).unwrap().contains("b")} q={d.get(0).unwrap().contains("q")}")
}
"#
    assert_eq(run_ok(src, "elem_arg_set_str_chain"), "b=true q=false")
}

test "an Option element read out of an unannotated list takes an Int default" {
    let src = #"fn main() ! IO {
    let mut os = []
    os.push(Some(4))
    os.push(None)
    let a = os.get(0).unwrap() ?? 0
    let b = os.get(1).unwrap() ?? 10
    io.println("a={a + 1} b={b + 1}")
}
"#
    assert_eq(run_ok(src, "elem_arg_option_default"), "a=5 b=11")
}

test "get on a Map read out of an unannotated list checks the key as Str" {
    let src = #"fn main() ! IO {
    let mut m = Map()
    m.insert("k", 5)
    let mut lm = []
    lm.push(m)
    let got = lm.get(0).unwrap()
    io.println("k={got.get("k").unwrap() + 1} has_x={got.contains_key("x")}")
}
"#
    assert_eq(run_ok(src, "elem_arg_map_get"), "k=6 has_x=false")
}

test "get on a List read out of an unannotated list checks the index as Int" {
    let src = #"fn main() ! IO {
    let mut ll = []
    ll.push([1, 2, 3])
    io.println("third={ll.get(0).unwrap().get(2).unwrap() * 10}")
}
"#
    assert_eq(run_ok(src, "elem_arg_list_get"), "third=30")
}
