type Box {
    x: Int
}

type Holder {
    held: Option[Box] = None
}

trait Taker {
    fn take(self, b: Option[Box]) -> Holder
}

impl Taker for Holder {
    fn take(self, b: Option[Box]) -> Holder {
        return Holder { held: b }
    }
}

test "method-call arg: bare None adopts param's Option[Box] carrier" {
    let h = Holder {}
    let h2 = h.take(None)
    assert_eq(h2.held.is_none(), 1)
}

test "method-call arg: Some(struct) round-trips through Option[Box] param" {
    let h = Holder {}
    let h2 = h.take(Some(Box { x: 9 }))
    assert_eq(h2.held.unwrap().x, 9)
}
