// A method call on an object reached through an unannotated `let` (whose type
// is a bound metavar, not yet a concrete tid) must resolve that metavar before
// reading its inner element type for argument checking. .contains() on a
// Set[Int] recovered from an unannotated List[Set[Int]].get(0).unwrap() chain
// must see Int as the element, not the whole Set as the element.

test "method call arg check resolves the object's metavar before reading its element type" {
    let mut s = Set()
    s.insert(1)
    let mut d = []
    d.push(s)
    let got = d.get(0).unwrap()
    assert(got.contains(1))
    assert(!got.contains(2))
}
