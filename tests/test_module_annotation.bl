import compile_test_helpers

fn run_cmd(cmd: Str, label: Str) -> Bool {
    let r = process.run("sh", ["-c", cmd]).unwrap()
    if !r.success() {
        io.println("FAIL: {label} ({r.end})")
        io.println("{r.out}{r.err_out}")
    }
    r.success()
}

fn check_build_error(base: Str, blink: Str, src: Str, expected_err: Str, label: Str) ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "cd {base}/app && {blink} build {src} -o build/err_test 2>../err.txt; true"]).unwrap()
    let output = fs.read("{base}/err.txt").unwrap()
    if output.contains(expected_err) != 0 {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected error containing '{expected_err}', got: {output}")
    }
}

fn check_output(path: Str, expected: Str, label: Str) ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "{path} > {path}_out.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{path}_out.txt").unwrap()
    if output.starts_with(expected) {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{expected}', got: {output}")
    }
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_module_annotation"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    process.run("sh", ["-c", "mkdir -p {base}/app/src/auth"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/app/build"]).unwrap()
    fs.write("{base}/app/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n").unwrap()

    // --- Test 1: Valid @module matching parent package ---
    fs.write(
        "{base}/app/src/auth/login.bl",
        "@module(\"auth\")\n\npub fn greet() -> Str \{\n    \"hello from auth\"\n}\n"
    ).unwrap()
    fs.write(
        "{base}/app/src/t1.bl",
        "import auth.login\n\nfn main() \{\n    io.println(auth.greet())\n}\n"
    ).unwrap()
    let ok1 = run_cmd("cd {base}/app && {blink} build src/t1.bl -o build/t1 2>&1", "build valid @module(\"auth\")")
    if ok1 {
        check_output("{base}/app/build/t1", "hello from auth", "valid @module matches parent package")
    }

    // --- Test 2: Invalid @module — billing in auth/ ---
    fs.write(
        "{base}/app/src/auth/login.bl",
        "@module(\"billing\")\n\npub fn greet() -> Str \{\n    \"hello from billing\"\n}\n"
    ).unwrap()
    fs.write(
        "{base}/app/src/t2.bl",
        "import auth.login\n\nfn main() \{\n    io.println(billing.greet())\n}\n"
    ).unwrap()
    check_build_error(base, blink, "src/t2.bl", "InvalidModuleAnnotation", "invalid @module(\"billing\") in auth/ rejected")

    // --- Test 3: @module("") is rejected (spec-unauthorized empty string) ---
    fs.write(
        "{base}/app/src/auth/helper.bl",
        "@module(\"\")\n\npub fn help_me() -> Str \{\n    \"helper\"\n}\n"
    ).unwrap()
    fs.write(
        "{base}/app/src/t3.bl",
        "import auth.helper\n\nfn main() \{\n    io.println(help_me())\n}\n"
    ).unwrap()
    check_build_error(base, blink, "src/t3.bl", "InvalidModuleAnnotation", "@module(\"\") rejected as invalid")

    // --- Test 4: Root-level file not constrained ---
    fs.write(
        "{base}/app/src/rootmod.bl",
        "@module(\"anything\")\n\npub fn root_fn() -> Str \{\n    \"root\"\n}\n"
    ).unwrap()
    fs.write(
        "{base}/app/src/t4.bl",
        "import rootmod\n\nfn main() \{\n    io.println(anything.root_fn())\n}\n"
    ).unwrap()
    let ok4 = run_cmd("cd {base}/app && {blink} build src/t4.bl -o build/t4 2>&1", "build root-level @module(\"anything\")")
    if ok4 {
        check_output("{base}/app/build/t4", "root", "root-level file @module unconstrained")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
