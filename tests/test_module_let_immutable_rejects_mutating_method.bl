// A module-level `let` without `mut` is an immutable binding (§2.12.1: "`pub let`
// exports immutable bindings"; §4.16 lists a mutating method call on a module-level
// `let mut` as a write and a read of a module-level `let` as "Immutable — equivalent
// to a constant"). So a mutating method on one is error[MutationRequiresMut], exactly
// as it is on a function-local `let`.
//
// The rule reached module scope only when the binding started carrying its own decl
// node: the mutation check finds the declaration through nr_binding_node and tests it
// for NodeKind.LetBinding, and a module-level `let` used to register with no node at
// all, so the check silently answered "not a let" and passed the mutation through.

import compile_test_helpers

test "a mutating method on a module-level immutable let is rejected" {
    let src = "let names: List[Str] = []\nfn add() \{\n    names.push(\"a\")\n}\nfn main() ! IO \{\n    add()\n    io.println(\"\{names.len()}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "modlet_immutable_push", "MutationRequiresMut")
}

// `let mut` at module scope keeps accepting it — the diagnostic tracks the `mut`
// keyword, not the scope.

test "a mutating method on a module-level mut let is accepted" {
    let src = "let mut names: List[Str] = []\nfn add() \{\n    names.push(\"a\")\n}\nfn main() ! IO \{\n    add()\n    assert_eq(names.len(), 1)\n}\n"
    compile_test_helpers.expect_no_error(src, "modlet_mut_push", "MutationRequiresMut")
}

// A read of an immutable module-level binding is always fine.

test "a read of a module-level immutable let is accepted" {
    let src = "let names: List[Str] = [\"a\"]\nfn main() ! IO \{\n    assert_eq(names.len(), 1)\n}\n"
    compile_test_helpers.expect_no_error(src, "modlet_immutable_read", "MutationRequiresMut")
}
