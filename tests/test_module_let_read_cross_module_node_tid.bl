// A module-qualified read of another module's top-level `let` has to answer that
// binding's declared type. The declaration's type is recorded on the `let` NODE, so
// the qualified read resolves through the node stamp — there is no second type
// channel for module lets to drift from.
//
// A wrong answer here is not a type error but a MISCOMPILE: an unknown type unifies
// with anything, so `let bad: Str = helper.mln_count` would compile and run, and a
// container read would spell a void element in C.

import test_module_let_node_tid_helper

test "a qualified read of a scalar module let keeps its type" {
    let n = test_module_let_node_tid_helper.mln_count
    assert_eq(n, 7)
    assert_eq(n + 1, 8)
}

test "a qualified read of a List module let keeps its element type" {
    let xs = test_module_let_node_tid_helper.mln_names
    assert_eq(xs.len(), 3)
    assert_eq(xs.get(1).unwrap(), "bee")
    assert_eq(xs.get(1).unwrap().len(), 3)
}

test "a qualified read of an Option module let keeps its inner type" {
    let m = test_module_let_node_tid_helper.mln_maybe
    assert_eq(m.unwrap(), 41)
    assert_eq(m.unwrap() + 1, 42)
}

test "a qualified read of a Map module let keeps its key and value types" {
    let mut sc = test_module_let_node_tid_helper.mln_scores
    sc.insert("k", 5)
    assert_eq(sc.get("k").unwrap(), 5)
}

test "a qualified read of a nested-container module let keeps both levels" {
    let ls = test_module_let_node_tid_helper.mln_lists
    assert_eq(ls.len(), 2)
    assert_eq(ls.get(0).unwrap().len(), 2)
    assert_eq(ls.get(0).unwrap().get(1).unwrap(), 2)
}

// The qualified read must also be usable in interpolation, which needs a Display
// impl chosen from the READ type rather than from a fallback.
test "a qualified module let read interpolates as its own type" {
    assert_eq("{test_module_let_node_tid_helper.mln_count}", "7")
}
