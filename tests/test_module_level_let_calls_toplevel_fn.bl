// A module-level `let` initializer must be able to call any function the
// module declares, annotated or not — the same as a local let inside a
// function body. Name resolution at module scope currently has no function
// in scope yet when the initializer is checked, so any call in a top-level
// let fails with UndefinedFunction, regardless of an explicit type
// annotation on the let.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an annotated module-level let can call a top-level fn",
    reason: "module-scope name resolution checks a top-level let's initializer before any function is in scope, so the call is rejected as UndefinedFunction even though mk is declared in the same file",
    ticket: "k5twbk",
) {
    let src = #"
fn mk() -> Int { 7 }

let g: Int = mk()

fn main() ! IO {
    io.println("{g}")
}
"#
    let r = compile_and_run(src, "_module_let_calls_fn_annotated")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}

test.failing(
    "an unannotated module-level let can call a top-level fn",
    reason: "same UndefinedFunction gap as the annotated form; the annotation is not what triggers it",
    ticket: "2q2z95",
) {
    let src = #"
fn mk() -> Int { 7 }

let g = mk()

fn main() ! IO {
    io.println("{g}")
}
"#
    let r = compile_and_run(src, "_module_let_calls_fn_unannotated")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}
