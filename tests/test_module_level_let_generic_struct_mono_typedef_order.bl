// A module-level `let` annotated with a generic struct instance must have that
// instance's monomorphized typedef emitted before the global's own declaration
// references it.

type Box[T] { v: T }

let gbox: Box[Int] = Box { v: 7 }

test "module-level let of a generic struct instance keeps its mono type" {
    assert_eq(gbox.v, 7)
}
