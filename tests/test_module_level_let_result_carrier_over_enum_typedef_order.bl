// A module-level `let` typed as a Result/Option carrier whose inner is a
// nominal enum must have the carrier's own typedef emitted before the
// global's declaration references it.

import compile_test_helpers.{compile_and_run}

test "module-level let of a Result carrier over an enum compiles and matches" {
    let src = #"
import std.io

type Color { Red Green Blue }
let g: Result[Color, Str] = Ok(Color.Red)

fn main() ! IO {
    match g {
        Ok(c) => io.println("ok")
        Err(e) => io.println(e)
    }
}
"#
    let r = compile_and_run(src, "_module_level_let_result_carrier_over_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok\n")
}
