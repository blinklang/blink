// A module-level (top-level `let`) Option[List[Int]] global emits C that
// declares the global as `static blink_Option_list ann;` — the inner List[Int]
// element erased to the bare word "list" — with no typedef of that name ever
// emitted, so the C compiler rejects it as an unknown type. Same failure for
// both the annotated (`let ann: Option[List[Int]] = Some([1, 2])`) and
// unannotated (`let ann = Some([1, 2])`) spellings, so this is not about the
// annotation. A local (non-global) binding of the same Option[List[Int]] type
// compiles and runs fine, which is what pins the fault to the global-carrier
// typedef-ordering path rather than to Option[List[Int]] handling in general.
//
// A second symptom exists behind the carrier-typedef gap once it is fixed
// (the match binder's `.len()` call reports UnresolvedMethod even though the
// diagnostic names the right type), but it is unreachable on the current
// build: the program never gets past the undeclared-carrier-type cc failure
// below, so `.len()` is never reached. Only the reachable symptom is pinned
// here.

import compile_test_helpers.{compile_and_run}

test "a module-level Option[List[Int]] global compiles and matches correctly" {
    let src = #"
import std.io
let ann: Option[List[Int]] = Some([1, 2])
fn main() {
    let v = match ann { Some(x) => x.len()  None => 0 }
    io.println("{v}")
}
"#
    let r = compile_and_run(src, "_module_level_option_list_carrier_typedef")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
