// A destructuring `let` at module scope parses, but neither name is
// registered, so every use is an undefined variable. The same destructuring
// inside a function body works. Silently parsing a binding that binds nothing
// is wrong regardless of the eventual fix direction (register both names, or
// reject module-scope destructuring with a clear diagnostic).

import compile_test_helpers.{compile_and_capture}

test "a module-level tuple destructuring let registers its bound names" {
    let src = #"
import std.io

let (ga, gb): (Int, Str) = (1, "x")

fn main() ! IO {
    io.println("{ga} {gb}")
}
"#
    let out = compile_and_capture(src, "_module_level_tuple_destructure_binds_nothing")
    let ok = out.contains("UndefinedVariable")
    assert(!ok, "module-level destructured names should be usable, not undefined: {out}")
}
