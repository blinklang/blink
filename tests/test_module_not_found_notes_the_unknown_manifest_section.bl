// A misspelled [dependencies] header hides the dependencies under it, so the import of one of
// them fails with ModuleNotFound far from the cause. When W1001 fired in the same build, E1200
// adds a note that points at the unknown section (§8.9.8). A W1001 that [lints] turned off did
// not fire, so it adds no note. The fixture lives under a fresh temporary directory, since the
// test tree itself sits inside a project.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str, json_at, json_len}

let PACKAGE = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n"
let MISSPELLED = "[dependecies]\nlocal/utils = \{ path = \"../utils\" \}\n"
let NOTE = "blink does not load the dependencies under the unknown section at blink.toml:5:1"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn check(toml: Str, args: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_module_not_found_note.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", toml)
    // A lock no older than blink.toml keeps dependency resolution out of the check.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/src/main.bl", "import local.utils\n\nfn main() \{\n    io.println(\"hi\")\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B check {args} src/main.bl")
    let _ = sh("rm -rf {dir}")
    r
}

// The notes of the E1200 row on stderr, or ["no E1200 row"].
fn e1200_notes(r: ProcessResult) -> List[Str] {
    for line in r.err_out.lines() {
        json_clear()
        let row = json_parse(line)
        if row >= 0 && json_as_str(json_get(row, "code")) == "E1200" {
            let mut out: List[Str] = []
            let notes = json_get(row, "notes")
            if notes >= 0 {
                let mut i = 0
                while i < json_len(notes) {
                    out.push(json_as_str(json_at(notes, i)))
                    i = i + 1
                }
            }
            return out
        }
    }
    ["no E1200 row"]
}

test "ModuleNotFound notes the unknown section that W1001 reported" {
    let r = check("{PACKAGE}{MISSPELLED}", "--json")
    assert_eq(r.exit_code, 1)
    assert_eq(e1200_notes(r), [NOTE])
}

test "the human form of ModuleNotFound shows the note" {
    let r = check("{PACKAGE}{MISSPELLED}", "")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("error[ModuleNotFound]: module not found: local.utils"), r.err_out)
    assert(r.err_out.contains("  note: {NOTE}\n"), r.err_out)
}

test "ModuleNotFound has no note when [lints] turned W1001 off" {
    let r = check("{PACKAGE}[lints]\nW1001 = \"off\"\n\n{MISSPELLED}", "--json")
    assert_eq(r.exit_code, 1)
    let notes: List[Str] = []
    assert_eq(e1200_notes(r), notes)
}

test "ModuleNotFound has no note when blink.toml has no unknown section" {
    let r = check(PACKAGE, "--json")
    assert_eq(r.exit_code, 1)
    let notes: List[Str] = []
    assert_eq(e1200_notes(r), notes)
}
