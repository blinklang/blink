// `module.name` reads a function as a value the same way the bare name does. The qualifier
// settles which declaration it is, so a namesake in this file does not stand in for it.

import test_fn_named_as_value_helper
import test_fn_named_as_value_helper as alpha
import test_fn_named_as_value_facade
import compile_test_helpers

fn fnv_triple(n: Int) -> Int { n + 1000 }
fn mqv_apply(n: Int, f: fn(Int) -> Int) -> Int { f(n) }
fn mqv_apply_str(s: Str, f: fn(Str) -> Str) -> Str { f(s) }

type MqvHolder { run: fn(Int) -> Int }

test "a qualified function passed by name runs" {
    assert_eq(mqv_apply(3, test_fn_named_as_value_helper.fnv_triple), 9)
}

test "a qualified function bound to a let is called through the binding" {
    let f = test_fn_named_as_value_helper.fnv_triple
    assert_eq(f(4), 12)
}

test "an import alias qualifies a function value" {
    let f = alpha.fnv_triple
    assert_eq(f(5), 15)
}

test "the qualifier picks the module's function over a namesake in this file" {
    assert_eq(fnv_triple(1), 1001)
    assert_eq(mqv_apply(1, alpha.fnv_triple), 3)
}

test "a qualified generic function takes its instance from the expected type" {
    assert_eq(mqv_apply(7, alpha.fnv_same), 7)
    assert_eq(mqv_apply_str("s", alpha.fnv_same), "s")
    let f: fn(Str) -> Str = alpha.fnv_same
    assert_eq(f("t"), "t")
}

test "a qualified function fills a struct field of function type" {
    let h = MqvHolder { run: alpha.fnv_triple }
    let r = h.run
    assert_eq(r(2), 6)
}

test "a qualified function with an effect runs where the effect is handled" {
    assert_eq(mqv_apply(2, alpha.fnv_shout), 2)
}

test "a wrong qualified function is a type error at the argument" {
    let src = "import alpha\nfn apply(s: Str, f: fn(Str) -> Str) -> Str \{ f(s) }\nfn main() \{ io.println(apply(\"a\", alpha.make)) }\n"
    compile_test_helpers.expect_compile_error_xmod(src, "alpha", "pub fn make(n: Int) -> Int \{ n }\n", "mqv_wrong", "E0300")
}

test "a private function has no qualified value" {
    let src = "import alpha\nfn main() \{\n    let f = alpha.make\n    io.println(\"\{f(1)}\")\n}\n"
    compile_test_helpers.expect_compile_error_xmod(src, "alpha", "fn make(n: Int) -> Int \{ n }\n", "mqv_private", "E1003")
}

test "a function a module re-exports is a qualified value there" {
    let f = test_fn_named_as_value_facade.fnv_triple
    assert_eq(f(1), 3)
    assert_eq(mqv_apply(2, test_fn_named_as_value_facade.fnv_triple), 6)
}

test "the trace log message rule follows a qualified function value" {
    let src = "import alpha\nfn main() \{\n    trace.log(\"c\", \"\{[1].map(alpha.shout)}\")\n}\n"
    let helper = "pub fn shout(n: Int) -> Int ! IO \{\n    io.println(\"x\")\n    n\n}\n"
    compile_test_helpers.expect_compile_error_xmod(src, "alpha", helper, "mqv_msg", "E0566")
}

test "the bound value of a module's function compiles with no internal error" {
    let src = "import alpha\nfn main() \{\n    let f = alpha.make\n    assert_eq(f(1), 2)\n}\n"
    compile_test_helpers.expect_no_error_xmod(src, "alpha", "pub fn make(n: Int) -> Int \{ n + 1 }\n", "mqv_mvce", "NodeCarriesNoType")
}
