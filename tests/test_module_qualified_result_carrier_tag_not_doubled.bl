import compile_test_helpers.{compile_and_run}

// A Result[T, E] carrier whose error half is reached through a re-exported,
// module-qualified path must not double the module qualifier in the carrier's
// C type name -- doing so loses the payload type and the struct fails to build.

test.failing(
    "a Result carrier over a module-qualified error type does not double the module prefix",
    reason: "the Result tag's error half already carries the qualified module prefix, and the carrier-tag builder re-applies the module prefix a second time, so the doubled name cannot be split back into a known type and the carrier's error member erases to void",
) {
    let src = #"
import std.fs
import std.fs.error

fn show(r: Result[Void, error.FsError]) -> Bool {
    r.is_ok()
}

fn main() ! IO {
    io.println("{show(fs.write("/dev/null", "x"))}")
}
"#
    let r = compile_and_run(src, "_result_carrier_module_qualified_tag")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "true\n")
}
