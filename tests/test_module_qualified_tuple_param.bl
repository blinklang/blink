// A tuple whose element is a MODULE-QUALIFIED struct (std.db_row.Row),
// passed as a tuple LITERAL to a fn param typed `(Row, Int)`, must compile and run.
//
// The annotation path (resolve_tuple_ann) spells the fn param carrier correctly as
// `blink_Tuple2_std_db_row_Row_int` (single module prefix). The tuple-literal emit
// path (emit_tuple_lit) erased the module-qualified element to `void`, building the
// argument as `blink_Tuple2_void_int`, so gcc rejected the call with an incompatible
// argument type. A same-module struct element (a local `type Foo`) already spelled
// correctly — the defect was module-qualification-specific at the literal.
//
// The fix must spell a module-qualified tuple element as the SAME registered
// single-prefix carrier the annotation registers, at the literal too. The emit-C row
// pins the exact carrier name (and the absence of the `_void_` erasure); the run row
// proves the program links and runs, since a `void` element is undeclared C and fails
// to compile rather than merely misspelling a string an emit-only row could pass on.
//
// Row is a plain lib/std struct (not runtime-owned, unlike Instant/Duration — see
// lo_decl_fact_table in src/layout.bl), so its carrier still mangles with the module
// prefix this fixture pins.

import compile_test_helpers
import std.io

fn tuple_param_src() -> Str {
    #"import std.io
import std.db_row.{Row}

fn go(t: (Row, Int)) {
    match t {
        (row, n) => io.println("v={row.get_int("v").unwrap() + n}")
    }
}

fn main() {
    go((Row { data: ["200"], columns: ["v"] }, 7))
}
"#
}

test "a module-qualified tuple-literal argument spells the single-prefix carrier" {
    let c = compile_test_helpers.compile_and_emit_c(tuple_param_src(), "w2qxdj_param_c")
    if c.contains("Tuple2_void_int") { io.println("FAIL: module-qualified element erased to void") }
    assert(!c.contains("Tuple2_void_int"))
    compile_test_helpers.expect_contains(c, "blink_Tuple2_std_db_row_Row_int", "registered single-prefix tuple carrier")
    if c.contains("std_db_row_std_db_row") { io.println("FAIL: doubled module prefix in tuple carrier") }
    assert(!c.contains("std_db_row_std_db_row"))
}

test "a module-qualified struct element in a tuple param links and runs" {
    let r = compile_test_helpers.compile_and_run(tuple_param_src(), "w2qxdj_param_run")
    if !r.out.contains("v=207") { io.println("FAIL: got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("v=207"))
}
