import test_eczcwr_a
import test_eczcwr_b

// eczcwr: two modules each define a struct named `Ngx` with DIFFERENT fields.
// mod_type_prefix (codegen_types.bl) was keyed by the BARE type name, so the
// second module's prefix overwrote the first → every c_type_c_name("Ngx")
// resolved to ONE module's C symbol (defect a), and struct_typedef_emitted
// (keyed on bare "Ngx") SKIPPED the second module's typedef entirely (defect b).
// Result: a "has no member" C compile error.
//
// §03_types.md:1038 — the collision rule is narrowly scoped to struct-vs-variant
// only; two modules each defining `Ngx` is LEGAL. §07:1801-1816 — all generated
// C symbols are module-qualified `blink_<module_path>_<item>` to prevent
// collisions. Both must produce distinct C symbols with their own typedefs.
//
// The fix makes: (a) c_type_c_name module-aware via a composite key +
// module-context in the type-def emit loop and the MQ return-temp; (b) the
// typedef dedup key module-resolved so both typedefs emit. Accessing each
// module's distinct field on its own constructor return proves both symbols
// exist with the right shape (a dropped/mis-named typedef → "has no member").
//
// NOTE (deferred, br <see ticket>): binding a cross-module struct to a `let`
// whose C type is re-resolved from the module-blind get_var_struct still picks
// the wrong module's symbol — that is the find_type_def_node var-struct
// module-blindness the eczcwr plan explicitly deferred. This test therefore
// accesses fields on the constructor return directly.

test "two modules with same-named struct resolve distinct C symbols" {
    assert_eq(test_eczcwr_a.make_a().a, 1)
    assert_eq(test_eczcwr_b.make_b().b, 2)
}
