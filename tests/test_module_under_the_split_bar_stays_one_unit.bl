// A chunk boundary costs the program speed: cc can not inline a call from one chunk into a
// function of another. So a build cuts only a module of more than sixteen times
// BLINK_UNIT_CHUNK_DECLS decls, the size where one cc on the whole unit takes seconds. A
// module under the bar is one unit, and one over it is cut.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// count private functions and the pub fn that calls them all.
fn module_source(name: Str, count: Int) -> Str {
    let mut lines: List[Str] = []
    let mut calls: List[Str] = []
    let mut i = 0
    while i < count {
        lines.push("fn {name}{i}(n: Int) -> Int \{ n + {i} }")
        lines.push("")
        calls.push("{name}{i}(n)")
        i = i + 1
    }
    lines.push("pub fn {name}_total(n: Int) -> Int \{")
    lines.push("    {calls.join(" + ")}")
    lines.push("}")
    lines.push("")
    lines.join("\n")
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"split_bar_app\"\nversion = \"0.1.0\"\n").unwrap()
    // At BLINK_UNIT_CHUNK_DECLS=2 the bar is 32 decls: under has 21, over has 41.
    fs.write("{tree}/app/src/under.bl", module_source("under", 20)).unwrap()
    fs.write("{tree}/app/src/over.bl", module_source("over", 40)).unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import under.{under_total}"#,
        #"import over.{over_total}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("total {under_total(1) + over_total(1)}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// one unit, so the run drops them.
fn build(tree: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_UNIT_CHUNK_DECLS=2 BLINK_CACHE_DIR={tree}/objcache build/blink build app/src/main.bl -o {tree}/out/app --per-module"]).unwrap()
}

test "a module under the split bar is one unit, and one over it is cut" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_split_bar_{getpid()}"
    dev_tree(root, tree)
    let r = build(tree)
    let under = sh("ls {tree}/out/app.units | grep -c '^under\\..*c$'").to_int()
    let over = sh("ls {tree}/out/app.units | grep -c '^over\\..*c$'").to_int()
    let out = sh("{tree}/out/app")
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    assert_eq(under, 1)
    assert(over > 2, "the module over the bar was not cut: {over} files")
    assert(out.contains("total 1030"), "the program changed: {out}")
}
