// A field default is written over its struct's own type parameters, so a literal that
// leaves the field out lowers it inside the struct's instance at the literal's type. The
// pass answers which instance a type names; a plain type names none and reads typecheck.

import lower_test_helpers.{probe, rhs_of, assert_eq_str}
import mono.{run_mono, instances, instance_of_type}
import layout.{tid_of_node}
import typecheck.{tc_type_str}
import diagnostics.{Diag}

fn src() -> Str {
    #"type Box[T] { v: Option[T] = None }

type Plain { n: Int = 1 }

fn main() {
    let a: Box[Int] = Box {}
    let again: Box[Int] = Box {}
    let b: Box[Str] = Box {}
    let p = Plain {}
    let n = 3
    let _keep = [a.v.is_none(), again.v.is_none(), b.v.is_none(), p.n == n]
}
"#
}

fn instance_named_by(name: Str) -> Int ! Diag.Report {
    instance_of_type(tid_of_node(rhs_of(name)))
}

test "a generic struct type names the instance registered at its type arguments" {
    let program = probe("mono_type_instance", src())
    run_mono(program)
    let idx = instance_named_by("a")
    assert(idx >= 0)
    assert_eq_str("instance", tc_type_str(instances().get(idx).unwrap().inst_tid), "Box[Int]")
}

test "one generic type at two type arguments names two instances, and at one names one" {
    let program = probe("mono_type_instance", src())
    run_mono(program)
    let a = instance_named_by("a")
    let b = instance_named_by("b")
    assert(a >= 0)
    assert(b >= 0)
    assert(a != b)
    assert_eq_str("same args", "{instance_named_by("again")}", "{a}")
}

test "a plain struct and a scalar name no instance" {
    let program = probe("mono_type_instance", src())
    run_mono(program)
    assert_eq_str("plain", "{instance_named_by("p")}", "-1")
    assert_eq_str("scalar", "{instance_named_by("n")}", "-1")
}
