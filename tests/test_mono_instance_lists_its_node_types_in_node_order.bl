// The pass keeps, for each instance, the type each node of the generic body has at that
// instance. A reader that writes C from the whole list must get the same list on every
// build, so the list comes in node order, and each node reads the type of its own instance.

import lower_test_helpers.{probe, rhs_of, fn_decl_of, assert_eq_str}
import mono.{run_mono, instances, instance_node_tids}
import typecheck.{tc_type_str}

fn src() -> Str {
    #"fn twice[T](x: T) -> List[T] {
    let pair = [x, x]
    pair
}

fn main() {
    let _a = twice(1)
    let _b = twice("s")
}
"#
}

fn instance_at(base: Int, arg: Str) -> Int {
    let table = instances()
    let mut row = 0
    while row < table.len() {
        let inst = table.get(row).unwrap()
        if inst.base_decl_node == base && tc_type_str(inst.inst_tid).contains(arg) { return row }
        row = row + 1
    }
    -1
}

fn tid_listed_for(row: Int, node: Int) -> Int {
    for (n, tid) in instance_node_tids(row) {
        if n == node { return tid }
    }
    -1
}

test "an instance lists its nodes in ascending node order" {
    let program = probe("mono_node_order", src())
    run_mono(program)
    let row = instance_at(fn_decl_of("twice"), "Int")
    assert(row >= 0)
    let listed = instance_node_tids(row)
    assert(listed.len() > 0)
    let mut i = 1
    while i < listed.len() {
        let (prev, _) = listed.get(i - 1).unwrap()
        let (node, _) = listed.get(i).unwrap()
        assert(prev < node)
        i = i + 1
    }
}

test "one body node reads the type of each instance it is listed in" {
    let program = probe("mono_node_order", src())
    run_mono(program)
    let base = fn_decl_of("twice")
    let pair = rhs_of("pair")
    assert_eq_str("at Int", tc_type_str(tid_listed_for(instance_at(base, "Int"), pair)), "List[Int]")
    assert_eq_str("at Str", tc_type_str(tid_listed_for(instance_at(base, "Str"), pair)), "List[Str]")
}
