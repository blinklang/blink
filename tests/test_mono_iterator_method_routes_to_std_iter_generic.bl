// An Iterator method call, and `into_iter` on a List, Set, Str or range, stands for a private
// fn of std.iter. Mono must register the instance of that generic, found by module and name,
// so a program's own fn of the same name never takes the route over.
import std.fs
import typecheck.{check_types, tc_type_str, make_iterator_type, make_list_type, make_range_type, make_set_type, TYPE_FLOAT, TYPE_INT, TYPE_STR, TYPE_U8}
import mono.{run_mono, instances, MonoInstance, iterator_route_name, iterator_route_module}
import parser.{node_count, node_kind, node_name, node_source_module}
import ast.{NodeKind}
import compiler.{compile_to_program}

fn find_decl_in(module: Str, name: Str) -> Int {
    let mut i = 0
    while i < node_count() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == name && node_source_module(i) == module { return i }
        i = i + 1
    }
    -1
}

fn instances_of(decl: Int) -> List[MonoInstance] {
    let mut out: List[MonoInstance] = []
    for inst in instances() {
        if inst.base_decl_node == decl { out.push(inst) }
    }
    out
}

fn run_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete, Env.Exit, Env.Read, FS.Read, IO, FS.Write {
    fs.write(path, src).unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
}

test "each receiver names its std.iter fn, or nothing" {
    // The type pool is filled by a typecheck run, so one runs before any tid is made.
    run_probe("build/mono_iter_route_names.bl", "fn main() \{\n}\n")
    let it = make_iterator_type(TYPE_INT)
    let xs = make_list_type(TYPE_INT)
    assert_eq(iterator_route_module(), "std_iter")
    assert_eq(iterator_route_name(it, "map"), "iter_map")
    assert_eq(iterator_route_name(it, "collect"), "iter_collect")
    assert_eq(iterator_route_name(xs, "into_iter"), "iter_from_list")
    assert_eq(iterator_route_name(make_set_type(TYPE_INT), "into_iter"), "iter_from_set")
    assert_eq(iterator_route_name(TYPE_STR, "into_iter"), "iter_from_str")
    assert_eq(iterator_route_name(it, "into_iter"), "")
    assert_eq(iterator_route_name(xs, "map"), "")
    assert_eq(iterator_route_name(it, "push"), "")
}

test "a range of an integer bound names the one range fn, and a range of any other bound names nothing" {
    run_probe("build/mono_iter_route_range_names.bl", "fn main() \{\n}\n")
    assert_eq(iterator_route_name(make_range_type(TYPE_INT), "into_iter"), "iter_from_range")
    assert_eq(iterator_route_name(make_range_type(TYPE_U8), "into_iter"), "iter_from_range")
    assert_eq(iterator_route_name(make_range_type(TYPE_FLOAT), "into_iter"), "")
    assert_eq(iterator_route_name(make_range_type(TYPE_STR), "into_iter"), "")
    assert_eq(iterator_route_name(make_range_type(TYPE_INT), "map"), "")
}

test "into_iter on a range registers its walk at the range's bound" {
    run_probe("build/mono_iter_route_range.bl", #"fn main() {
    let lo: U8 = 1
    let _n = (lo..=4).into_iter().count()
}
"#)
    let walk = instances_of(find_decl_in(iterator_route_module(), "iter_from_range"))
    assert(walk.len() >= 1)
    let mut shown: List[Str] = []
    for w in walk { shown.push(tc_type_str(w.arg_tids)) }
    assert(shown.contains("(U8)"), shown.join(", "))
}

test "a chain registers one instance of each routed generic" {
    run_probe("build/mono_iter_route_chain.bl", #"fn main() {
    let xs = [1, 2, 3]
    let _n = xs.into_iter().map(fn(v: Int) -> Str { "{v}" }).collect().len()
}
"#)
    let src = instances_of(find_decl_in(iterator_route_module(), "iter_from_list"))
    assert_eq(src.len(), 1)
    assert_eq(tc_type_str(src.get(0).unwrap().arg_tids), "(Int)")
    let map = instances_of(find_decl_in(iterator_route_module(), "iter_map"))
    assert_eq(map.len(), 1)
    assert_eq(tc_type_str(map.get(0).unwrap().arg_tids), "(Int, Str)")
    let out = instances_of(find_decl_in(iterator_route_module(), "iter_collect"))
    assert_eq(out.len(), 1)
    assert_eq(tc_type_str(out.get(0).unwrap().arg_tids), "(Str)")
}

test "a user fn spelled like a routed generic does not take the route" {
    run_probe("build/mono_iter_route_user_twin.bl", #"fn iter_count[T](xs: List[T]) -> Int { xs.len() + 100 }
fn main() {
    let xs = [1, 2]
    let _n = xs.into_iter().count()
}
"#)
    let routed = instances_of(find_decl_in(iterator_route_module(), "iter_count"))
    assert_eq(routed.len(), 1)
    let mut twin = -1
    let mut i = 0
    while i < node_count() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == "iter_count" && node_source_module(i) != iterator_route_module() { twin = i }
        i = i + 1
    }
    assert(twin >= 0)
    assert_eq(instances_of(twin).len(), 0)
}
