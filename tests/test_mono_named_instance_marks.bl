// The instance table carries one mark per instance: whether the codegen unit being written
// named it. A unit starts with none marked, a mark is set once however often it is set, and
// a lowering that is thrown away can put back exactly the marks it found.

import std.fs
import typecheck.{check_types}
import mono.{run_mono, instances, mark_instance_named, named_instance_rows, set_named_instance_rows}
import compiler.{compile_to_program}

fn load_probe(path: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    write_file(path, #"fn id[T](x: T) -> T { x }
fn main() {
    assert(id(1) == 1)
    assert(id("a") == "a")
    assert(id(true))
}
"#)
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
}

test "no instance is marked until a unit names one" {
    load_probe("build/mono_named_marks_none_probe.bl")
    assert(instances().len() >= 3)
    assert_eq(named_instance_rows(), [])
}

test "a mark set twice reads once, and marks read in table order" {
    load_probe("build/mono_named_marks_order_probe.bl")
    mark_instance_named(2)
    mark_instance_named(0)
    mark_instance_named(2)
    assert_eq(named_instance_rows(), [0, 2])
    assert(instances().get(2).unwrap().unit_named)
    assert(!instances().get(1).unwrap().unit_named)
}

test "setting the marks replaces them, and setting none clears them" {
    load_probe("build/mono_named_marks_set_probe.bl")
    mark_instance_named(0)
    mark_instance_named(1)
    set_named_instance_rows([2])
    assert_eq(named_instance_rows(), [2])
    set_named_instance_rows([])
    assert_eq(named_instance_rows(), [])
}
