// Whether main reads BLINK_TRACE_CHANNELS is a fact of the whole program, so the mono walk
// decides it: a trace.log in any function the walk reaches or in a module-level initializer
// counts, and neither a `trace` binding with a `log` method of its own nor a user effect handle
// `trace` with an operation `log` does.

import lower_test_helpers.{probe}
import mono.{program_calls_trace_log, run_mono}

fn src_trace_in_helper() -> Str {
    #"fn helper() -> Int {
    trace.log("c", "in helper")
    6 * 7
}

fn main() {
    let _v = helper()
}
"#
}

fn src_trace_in_global() -> Str {
    #"let START: Int = {
    trace.log("c", "at start")
    1
}

fn main() {
    let _v = START
}
"#
}

fn src_trace_binding() -> Str {
    #"type Logger {
    n: Int
}

trait Log {
    fn log(self, ch: Str, msg: Str) -> Int
}

impl Log for Logger {
    fn log(self, ch: Str, msg: Str) -> Int { self.n }
}

fn main() {
    let trace = Logger { n: 1 }
    let _v = trace.log("c", "x")
}
"#
}

fn src_trace_effect_handle() -> Str {
    #"effect Trace {
    effect Note {
        fn log(ch: Str, m: Str)
    }
}

fn go() ! Trace.Note {
    trace.log("a", "b")
}

fn main() {
    with handler Trace {
        fn log(ch: Str, m: Str) { }
    } {
        go()
    }
}
"#
}

test "program_calls_trace_log is true when a function main calls holds a trace.log" {
    run_mono(probe("trace_log_helper", src_trace_in_helper()))
    assert(program_calls_trace_log())
}

test "program_calls_trace_log is true when a module-level initializer holds a trace.log" {
    run_mono(probe("trace_log_global", src_trace_in_global()))
    assert(program_calls_trace_log())
}

test "program_calls_trace_log is false when trace is a binding with its own log" {
    run_mono(probe("trace_log_binding", src_trace_binding()))
    assert(!program_calls_trace_log())
}

test "program_calls_trace_log is false when trace is a user effect handle with an op log" {
    run_mono(probe("trace_log_effect", src_trace_effect_handle()))
    assert(!program_calls_trace_log())
}
