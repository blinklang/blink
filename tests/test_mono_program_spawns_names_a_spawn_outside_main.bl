// Whether main starts the thread pool is a fact of the whole program, so the mono walk
// decides it: a spawn in any function the walk reaches counts, not only one in main.

import lower_test_helpers.{probe}
import mono.{program_spawns, run_mono}

fn src_spawns_in_helper() -> Str {
    #"fn helper() -> Int {
    let mut r = 0
    async.scope {
        let h = async.spawn(fn() { 6 * 7 })
        r = h.await
    }
    r
}

fn main() {
    let _v = helper()
}
"#
}

fn src_no_spawn() -> Str {
    #"fn helper() -> Int { 6 * 7 }

fn main() {
    let _v = helper()
}
"#
}

test "program_spawns is true when a function main calls spawns" {
    run_mono(probe("spawns_helper", src_spawns_in_helper()))
    assert(program_spawns())
}

test "program_spawns is false when no function spawns" {
    run_mono(probe("spawns_none", src_no_spawn()))
    assert(!program_spawns())
}
