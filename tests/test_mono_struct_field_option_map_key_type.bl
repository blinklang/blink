// A mono struct field typed Option[Map[K,V]] (T mono'd into the key position)
// keeps the map's struct-key type tracking after .unwrap() at the field access.

@derive(Hash, Eq)
type Point { x: Int, y: Int }

type Box[T] { v: Option[Map[T, Int]] }

test "mono struct field Option[Map[T,Int]] round-trips a struct key" {
    let mut b: Box[Point] = Box { v: Some(Map()) }
    b.v.unwrap().insert(Point { x: 1, y: 2 }, 42)
    assert_eq(b.v.unwrap().get(Point { x: 1, y: 2 }).unwrap(), 42)
}
