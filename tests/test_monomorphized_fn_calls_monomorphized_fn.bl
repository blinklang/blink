// Regression for szh3cy: a monomorphized generic fn calling another
// monomorphized generic fn emitted the callsite before the callee's forward
// decl, so C treated the call as an implicit `int()` and then reported
// conflicting types against the real declaration further down the TU.
pub fn step[M](m: M) -> M { m }

pub fn run[M](initial: M) -> M {
    let m = step(initial)
    m
}

type Model { x: Int }

test "mono fn calling mono fn round-trips a struct field" {
    let result = run(Model { x: 42 })
    assert_eq(result.x, 42)
}
