// A generic-struct-INSTANCE parameter whose instance depends on the enclosing
// generic function's own type parameter (b: Box[T], T=Int) concretizes only in
// the monomorphized function body (emit_mono_fn_def). That site registered the
// param through set_var_struct with the mono carrier (Box_Int) on the flat sname
// channel but no type id, so field access on the param inside the mono body
// recovered the carrier through the flat sname alone. The site now also stamps a
// tid pre-substituted through the mono's own tparams (so it is already concrete
// and round-trips as identity at read time), guarded to the reader's mono-name
// round-trip and excluding enums. This is a tid-population step: the emitted C is
// unchanged; the tests guard that field access on such a parameter still resolves
// across the one-param, two-param, and let-bound shapes.
type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }

fn unwrap_box[T](b: Box[T]) -> T {
    b.value
}

fn sum_pair[A, B](p: Pair[A, B]) -> A {
    p.first
}

fn box_twice[T](b: Box[T]) -> T {
    let inner = b
    inner.value
}

test "generic-fn generic-instance param resolves field access" {
    assert_eq(unwrap_box(Box { value: 7 }), 7)
}

test "generic-fn two-param generic-instance param resolves field access" {
    assert_eq(sum_pair(Pair { first: 3, second: 9 }), 3)
}

test "generic-fn generic-instance param let-bound then field access" {
    assert_eq(box_twice(Box { value: 5 }), 5)
}
