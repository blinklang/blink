// sections/03_types.md §3.2.3: a Time handler builds a Monotonic reading with
// Monotonic.from_offset, and `since` is the exact signed difference of two offsets.
// Monotonic has no Eq or Debug, so each test observes a reading only through `since`.
import std.time.{Duration, Monotonic}

test "since is the difference of the two offsets" {
    let a = Monotonic.from_offset(Duration.ms(40))
    let b = Monotonic.from_offset(Duration.ms(55))
    assert_eq(b.since(a), Duration.ms(15))
}

test "since is negative when earlier is the later reading" {
    let a = Monotonic.from_offset(Duration.nanos(9))
    let b = Monotonic.from_offset(Duration.nanos(2))
    assert_eq(b.since(a), Duration.nanos(-7))
}

test "a zero offset is a valid reading" {
    let origin = Monotonic.from_offset(Duration.nanos(0))
    assert_eq(origin.since(origin), Duration.nanos(0))
    assert_eq(Monotonic.from_offset(Duration.seconds(3)).since(origin), Duration.seconds(3))
}

test "a negative offset panics with the offset and the reason" {
    assert_panics(matching: "Monotonic.from_offset: negative offset -5ns; a monotonic reading is never before its origin") {
        let _ = Monotonic.from_offset(Duration.nanos(-5))
    }
}

fn first_reading(xs: List[Monotonic]) -> Monotonic? {
    xs.get(0)
}

test "a reading with no derives is carried in an Option and a List" {
    let origin = Monotonic.from_offset(Duration.nanos(0))
    let none: Monotonic? = first_reading([])
    assert(none.is_none())
    match first_reading([Monotonic.from_offset(Duration.ms(7)), origin]) {
        Some(m) => assert_eq(m.since(origin), Duration.ms(7))
        None => assert(false)
    }
}

test "a closure captures a reading" {
    let start = Monotonic.from_offset(Duration.ms(1))
    let elapsed_to = fn(m: Monotonic) -> Duration { m.since(start) }
    assert_eq(elapsed_to(Monotonic.from_offset(Duration.ms(4))), Duration.ms(3))
}
