// `mut` written before a name in a pattern makes that one name mutable (§3.5 *Mutable
// Binders*): `binder ::= "mut"? IDENT` in a destructuring `let`, a `for` binder or pattern, a
// match arm, a struct field and the name before `as`. Each form below parses, mutates its
// binder and reads the new value back. A binder is a new local, so a write to it never
// reaches the value it was bound from, and a closure shares a `mut` binder the way it shares
// a `let mut`.

type Point {
    x: Int
    y: Int
}

type Shape {
    Circle(Int)
    Rect { w: Int, h: Int }
}

fn pair() -> (Int, List[Int]) {
    (1, [10])
}

test "let (mut x, mut y) makes both names mutable" {
    let (mut x, mut y) = pair()
    x = x + 1
    y.push(20)
    assert_eq(x, 2)
    assert_eq(y.len(), 2)
    assert_eq(y.get(1).unwrap(), 20)
}

test "let (mut lo, hi) makes only lo mutable" {
    let (mut lo, hi) = (3, 9)
    lo -= 1
    assert_eq(lo, 2)
    assert_eq(hi, 9)
}

test "a mut binder nested in a tuple pattern is mutable" {
    let ((mut a, b), c) = ((1, 2), 3)
    a += b + c
    assert_eq(a, 6)
}

test "for mut i changes i and leaves the list as it was" {
    let xs = [1, 2, 3]
    let mut seen: List[Int] = []
    for mut i in xs {
        i = i * 10
        seen.push(i)
    }
    assert_eq(seen, [10, 20, 30])
    assert_eq(xs, [1, 2, 3])
}

test "for mut i over a range changes i only in that iteration" {
    let mut sum = 0
    for mut i in 0..3 {
        i += 100
        sum += i
    }
    assert_eq(sum, 303)
}

test "for (k, mut v) mutates v and leaves k as it was" {
    let pairs = [("a", 1), ("b", 2)]
    let mut out: List[Str] = []
    for (k, mut v) in pairs {
        v += 10
        out.push("{k}={v}")
    }
    assert_eq(out, ["a=11", "b=12"])
    assert_eq(pairs.get(0).unwrap().1, 1)
}

test "Some(mut v) in a match arm is mutable" {
    let o: Int? = Some(4)
    let got = match o {
        Some(mut v) => {
            v = v * 2
            v
        }
        None => 0
    }
    assert_eq(got, 8)
}

test "a mut payload binder holding a list is mutable" {
    let o: List[Int]? = Some([1])
    match o {
        Some(mut xs) => {
            xs.push(2)
            assert_eq(xs.len(), 2)
        }
        None => assert(false)
    }
}

test "a mut constructor field binder is mutable" {
    let s = Shape.Circle(5)
    let r = match s {
        Circle(mut r) => {
            r += 1
            r
        }
        Rect { w, h } => w * h
    }
    assert_eq(r, 6)
}

test "a struct field renamed to a mut binder is mutable" {
    let p = Point { x: 1, y: 2 }
    let got = match p {
        Point { x: mut px, .. } => {
            px += 40
            px
        }
    }
    assert_eq(got, 41)
    assert_eq(p.x, 1)
}

test "a punned struct field with mut is mutable" {
    let p = Point { x: 1, y: 2 }
    let got = match p {
        Point { mut x, y } => {
            x += y
            x
        }
    }
    assert_eq(got, 3)
}

test "a punned mut field of a struct-style variant is mutable" {
    let s = Shape.Rect { w: 2, h: 3 }
    let got = match s {
        Circle(r) => r
        Rect { mut w, h } => {
            w *= h
            w
        }
    }
    assert_eq(got, 6)
}

test "the name before as takes mut and the inner names do not" {
    let o: Int? = Some(7)
    let got = match o {
        mut whole as Some(v) => {
            whole = None
            match whole {
                Some(_) => -1
                None => v
            }
        }
        None => 0
    }
    assert_eq(got, 7)
}

test "a closure shares a mut match binder like a let mut" {
    let o: Int? = Some(1)
    match o {
        Some(mut n) => {
            let read = fn() -> Int { n }
            n = 5
            assert_eq(read(), 5)
        }
        None => assert(false)
    }
}

test "a closure shares a for mut binder like a let mut" {
    let mut total = 0
    for mut i in [1, 2] {
        let read = fn() -> Int { i }
        i += 10
        total += read()
    }
    assert_eq(total, 23)
}

test "a closure shares a mut leaf of a destructuring let" {
    let (mut a, b) = (1, 2)
    let read = fn() -> Int { a + b }
    a = 10
    assert_eq(read(), 12)
}

test "mut on every leaf of a tuple pattern makes each one mutable" {
    let (mut a, mut b) = (1, 2)
    a += 1
    b += 1
    assert_eq(a + b, 5)
}
