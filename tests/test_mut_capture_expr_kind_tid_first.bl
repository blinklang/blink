// The mut-capture arm of the identifier emitter read a captured value's C kind and
// struct name off the flat tp_* pool (tp_get_kind / tp_get_sname on the capture's
// tp_id). The flat kind stamps CT_INT on a captured data enum, so the
// struct-name recording under CT_STRUCT was skipped for one. The immut-capture arm
// one branch below already reads these through the tid-first capture_ct /
// capture_sname; this converges the mut arm onto the same channel. A mut-captured
// data enum read into a list literal, then reassigned through the cell, exercises the
// arm in both directions.

type Shape { Circle(Int), Square(Int) }

fn area(s: Shape) -> Int {
    match s {
        Circle(r) => r * r * 3
        Square(w) => w * w
    }
}

test "a mut-captured data enum keeps its struct kind through a list literal" {
    let mut s = Circle(10)
    let f = fn() -> Int {
        let xs = [s, s]
        let total = area(xs.get(0).unwrap()) + area(xs.get(1).unwrap())
        s = Square(6)
        total
    }
    assert_eq(f(), 600)
    assert_eq(area(s), 36)
}
