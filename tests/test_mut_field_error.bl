import compile_test_helpers

test "mut on struct field emits E1109" {
    let src = "type Foo \{ mut x: Bool \}\nfn main() \{ \}\n"
    write_file("{compile_test_helpers.scratch_root()}/_test_mut_field.bl", src)
    let args = ["{compile_test_helpers.scratch_root()}/_test_mut_field.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(output.contains("E1109"))
    assert(output.contains("MutFieldNotSupported"))
    shell_exec("rm -f {compile_test_helpers.scratch_root()}/_test_mut_field.bl")
}

test "mut on enum variant field emits E1109" {
    let src = "type Shape \{ Circle(mut r: Float) \}\nfn main() \{ \}\n"
    write_file("{compile_test_helpers.scratch_root()}/_test_mut_vfield.bl", src)
    let args = ["{compile_test_helpers.scratch_root()}/_test_mut_vfield.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(output.contains("E1109"))
    assert(output.contains("MutFieldNotSupported"))
    shell_exec("rm -f {compile_test_helpers.scratch_root()}/_test_mut_vfield.bl")
}
