// A mut Result carrier born from a partial Ok(literal) leaves its err slot
// unbound at the let. A later assignment back-pins that slot to the real err
// type, so the Ok literal's declared carrier type must be spelled from the
// back-pinned type, not from a Str default that only happens to match when
// the real err type is also Str.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a mut Result back-pinned to a non-Str err spells the Ok literal's carrier from that err type",
    reason: "the Ok-literal carrier emit always spells its err slot as Str by default; when the later assignment back-pins a non-Str err (e.g. Int), the var decl uses the back-pinned carrier type but the Ok literal initializer still uses the Str-default carrier type, so cc rejects the mismatched initializer",
    ticket: "d643kb",
) {
    let src = #"
import std.io

fn pin_int_err() -> Int {
    let mut x = Ok(1)
    x = Err(42)
    match x { Ok(v) => v Err(e) => e + 1 }
}

fn main() ! IO {
    io.println("{pin_int_err()}")
}
"#
    let r = compile_and_run(src, "_mut_result_backpin_nonstr_err")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "43\n")
}
