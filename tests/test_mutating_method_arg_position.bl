// tc_check_mutating_method has one call site, in tc_check_body's MethodCall arm, which is
// reached only in statement/initializer position. The same mutation on the same immutable
// binding is therefore caught or silently allowed depending only on where it is written.
//
// The rule's stated rationale (sections/03_types.md:320) is that grep "let mut" finds every
// mutation source, which argument position defeats.

import compile_test_helpers

fn stmt_src() -> Str {
    #"import std.io

fn main() {
    let m: Map[Str, Int] = Map()
    m.insert("a", 1)
    io.println("n={m.len()}")
}
"#
}

test "a mutating method in statement position is rejected" {
    let out = compile_test_helpers.compile_and_capture(stmt_src(), "p9wm4c_stmt")
    compile_test_helpers.expect_error(out, "MutationRequiresMut", "statement position")
}

fn arg_src() -> Str {
    #"import std.io

fn sink(v: Bool) -> Int {
    if v { 1 } else { 0 }
}

fn main() {
    let m: Map[Str, Int] = Map()
    let n = sink(m.insert("a", 1))
    io.println("n={n}")
}
"#
}

test "the same mutating method in argument position is rejected too" {
    let out = compile_test_helpers.compile_and_capture(arg_src(), "p9wm4c_arg")
    compile_test_helpers.expect_error(out, "MutationRequiresMut", "argument position")
}

// A `let mut` binding must stay accepted in both positions — the check has to fire on the
// missing `mut`, not on the position.
fn mut_ok_src() -> Str {
    #"import std.io

fn sink(v: Bool) -> Int {
    if v { 1 } else { 0 }
}

fn main() {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let n = sink(m.insert("b", 2))
    io.println("n={n}")
}
"#
}

test "a mut binding is accepted in both positions" {
    let out = compile_test_helpers.compile_and_capture(mut_ok_src(), "p9wm4c_mut")
    if out.contains("MutationRequiresMut") { compile_test_helpers.expect_contains(out, "!!never!!", "mut binding must not be rejected") }
}
