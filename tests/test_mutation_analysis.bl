// test_mutation_analysis.bl — Exercise compile-time mutation analysis patterns
//
// Mutation analysis is a compile-time pass that infers which functions write
// to module-level mutable globals (directly or transitively). If the pass has
// bugs, this file won't compile. The tests verify runtime behavior is correct.
import compile_test_helpers

// ── Module-level mutable globals ─────────────────────────────────────
let mut counter: Int = 0
let mut items: List[Int] = []
let mut name: Str = ""

// ── Direct writers ───────────────────────────────────────────────────
fn increment() {
    counter = counter + 1
}

fn set_name(s: Str) {
    name = s
}

// ── Mutating method call on global ───────────────────────────────────
fn add_item(x: Int) {
    items.push(x)
}

// ── Read-only (no writes) ────────────────────────────────────────────
fn get_counter() -> Int {
    counter
}

fn get_item_count() -> Int {
    items.len()
}

fn get_name() -> Str {
    name
}

// ── Transitive writers (call a fn that writes) ───────────────────────
fn double_increment() {
    increment()
    increment()
}

fn setup_defaults() {
    set_name("default")
    add_item(0)
}

// ── Writes multiple globals in one function ──────────────────────────
fn reset_all() {
    counter = 0
    items = []
    name = ""
}

fn bump_everything() {
    counter = counter + 10
    items.push(99)
    name = "bumped"
}

// ── Save/restore patterns (W0550/W0551 diagnostics) ─────────────
// Complete save/restore — should NOT trigger W0550
fn speculative_bump_safe() {
    let saved_counter = counter
    let saved_items = items
    let saved_name = name
    bump_everything()
    counter = saved_counter
    items = saved_items
    name = saved_name
}

@allow(IncompleteStateRestore)
fn speculative_bump_incomplete() {
    let saved_counter = counter
    let saved_name = name
    bump_everything()
    counter = saved_counter
    name = saved_name
}

// No save/restore pattern in this function at all
// Should NOT trigger W0551 (only fires when function has existing save/restore)
fn speculative_bump_none() {
    bump_everything()
}

// Seeds a local from a module-global sentinel, then makes a broad-write call.
// The seed is NOT a save/restore (there is no restore), so W0551 must NOT fire
// here (ykmmt0). If the analyzer false-positives on the bare seed, this file
// won't compile.
let mut SENTINEL: Int = -1

fn seed_then_mutate() -> Int {
    let mut l_tid = SENTINEL
    l_tid = l_tid + 1
    bump_everything()
    l_tid
}

@allow(UnrestoredMutation)
fn speculative_mixed_pattern() {
    let saved_counter = counter
    increment()
    counter = saved_counter
    set_name("speculative")
}

@allow(IncompleteStateRestore, UnrestoredMutation)
fn speculative_both_allowed() {
    let saved_counter = counter
    bump_everything()
    counter = saved_counter
    set_name("both")
}

// ── Tests ────────────────────────────────────────────────────────────
test "direct assignment to global" {
    reset_all()
    assert_eq(get_counter(), 0)
    increment()
    assert_eq(get_counter(), 1)
    increment()
    assert_eq(get_counter(), 2)
}

test "mutating method call on global list" {
    reset_all()
    add_item(10)
    add_item(20)
    assert_eq(get_item_count(), 2)
    assert_eq(items.get(0).unwrap(), 10)
    assert_eq(items.get(1).unwrap(), 20)
}

test "string global assignment" {
    reset_all()
    assert_eq(get_name(), "")
    set_name("pact")
    assert_eq(get_name(), "pact")
}

test "transitive writes through call chain" {
    reset_all()
    double_increment()
    assert_eq(get_counter(), 2)
}

test "transitive writes to multiple globals" {
    reset_all()
    setup_defaults()
    assert_eq(get_name(), "default")
    assert_eq(get_item_count(), 1)
}

test "single function writes multiple globals" {
    reset_all()
    bump_everything()
    assert_eq(get_counter(), 10)
    assert_eq(get_name(), "bumped")
    assert_eq(get_item_count(), 1)
    assert_eq(items.get(0).unwrap(), 99)
}

test "read-only functions reflect mutations" {
    reset_all()
    assert_eq(get_counter(), 0)
    assert_eq(get_item_count(), 0)
    assert_eq(get_name(), "")
    increment()
    add_item(5)
    set_name("test")
    assert_eq(get_counter(), 1)
    assert_eq(get_item_count(), 1)
    assert_eq(get_name(), "test")
}

test "reset clears all globals" {
    increment()
    add_item(1)
    set_name("dirty")
    reset_all()
    assert_eq(get_counter(), 0)
    assert_eq(get_item_count(), 0)
    assert_eq(get_name(), "")
}

test "complete save/restore preserves state" {
    reset_all()
    counter = 5
    name = "before"
    items.push(42)
    speculative_bump_safe()
    assert_eq(get_counter(), 5)
    assert_eq(get_name(), "before")
    // list save/restore is by reference, so bump_everything's push(99) mutates the shared list
    assert_eq(get_item_count(), 2)
    assert_eq(items.get(0).unwrap(), 42)
    assert_eq(items.get(1).unwrap(), 99)
}

test "incomplete save/restore preserves only saved globals" {
    reset_all()
    counter = 5
    name = "before"
    speculative_bump_incomplete()
    assert_eq(get_counter(), 5)
    assert_eq(get_name(), "before")
    assert_eq(get_item_count(), 1)
    assert_eq(items.get(0).unwrap(), 99)
}

test "W0551 context: mixed save/restore pattern" {
    reset_all()
    counter = 5
    speculative_mixed_pattern()
    assert_eq(get_counter(), 5)
    assert_eq(get_name(), "speculative")
}

test "W0551 context: no save/restore means no warning" {
    reset_all()
    counter = 5
    name = "before"
    speculative_bump_none()
    assert_eq(get_counter(), 15)
    assert_eq(get_name(), "bumped")
    assert_eq(get_item_count(), 1)
}

test "@allow(IncompleteStateRestore) suppresses W0550" {
    reset_all()
    counter = 5
    name = "before"
    speculative_bump_incomplete()
    assert_eq(get_counter(), 5)
    assert_eq(get_name(), "before")
    assert_eq(get_item_count(), 1)
    assert_eq(items.get(0).unwrap(), 99)
}

test "@allow(UnrestoredMutation) suppresses W0551" {
    reset_all()
    counter = 5
    speculative_mixed_pattern()
    assert_eq(get_counter(), 5)
    assert_eq(get_name(), "speculative")
}

test "@allow with multiple warning names" {
    reset_all()
    counter = 5
    speculative_both_allowed()
    assert_eq(get_counter(), 5)
    assert_eq(get_name(), "both")
    assert_eq(get_item_count(), 1)
}

// ── Mutation-analysis warning tests ─────────────────────────────────
//
// W0550/W0551 default to "warning" severity (spec §4.16.8); blink.toml [lints]
// can upgrade them to "error". Verify they fire via compile_and_capture.
test "W0550 fires as warning for incomplete save/restore" {
    let src = "let mut counter: Int = 0\nlet mut name: Str = \"\"\nlet mut items: List[Int] = []\nfn bump() \{\n    counter = 10\n    name = \"bumped\"\n    items.push(99)\n}\nfn bad() \{\n    let saved_counter = counter\n    let saved_name = name\n    bump()\n    counter = saved_counter\n    name = saved_name\n}\nfn main() \{\n}\n"
    let output = compile_test_helpers.compile_and_capture(src, "_test_ma_w0550")
    compile_test_helpers.expect_warning(output, "IncompleteStateRestore", "W0550 fires as warning for incomplete save/restore")
    compile_test_helpers.expect_contains(output, "\"notes\":", "W0550 emits notes")
    compile_test_helpers.expect_contains(output, "is restored after the call", "W0550 note names what is restored")
}

test "W0551 fires as warning for unrestored mutation" {
    let src = "let mut counter: Int = 0\nlet mut name: Str = \"\"\nfn increment() \{\n    counter = counter + 1\n}\nfn set_name(s: Str) \{\n    name = s\n}\nfn bad() \{\n    let saved_counter = counter\n    increment()\n    counter = saved_counter\n    set_name(\"oops\")\n}\nfn main() \{\n}\n"
    let output = compile_test_helpers.compile_and_capture(src, "_test_ma_w0551")
    compile_test_helpers.expect_warning(output, "UnrestoredMutation", "W0551 fires as warning for unrestored mutation")
    compile_test_helpers.expect_contains(output, "\"notes\":", "W0551 emits notes")
    compile_test_helpers.expect_contains(output, "these are not saved/restored for this call", "W0551 message no longer claims no save/restore pattern")
}

// ykmmt0: seeding a local from a module-global sentinel is NOT a save/restore
// (no restore exists), so a sibling broad-write call must NOT trigger W0551.
test "W0551 does not fire for sentinel-seeded local" {
    let src = "let mut SENTINEL: Int = -1\nlet mut counter: Int = 0\nlet mut name: Str = \"\"\nfn bump() \{\n    counter = counter + 10\n    name = \"bumped\"\n}\nfn seed_then_mutate() -> Int \{\n    let mut l_tid = SENTINEL\n    l_tid = l_tid + 1\n    bump()\n    l_tid\n}\nfn main() \{\n}\n"
    compile_test_helpers.expect_no_error(src, "ma_no_w0551_sentinel", "UnrestoredMutation")
}

// 8c11bj: §4.16.7 gates W0551 at FUNCTION granularity — "the presence of
// save/restore patterns elsewhere in the function indicates speculative intent"
// and "any unsaved mutation is potentially a bug". A function whose save/restore
// pattern lives in one block (the then-branch) and whose unsaved broad-write call
// lives in a sibling block (the else-branch) must still fire W0551 on that call.
test "W0551 fires for unsaved call in sibling block" {
    let src = "let mut counter: Int = 0\nfn writes_counter() \{\n    counter = counter + 5\n}\nfn hidden(flag: Bool) \{\n    if flag \{\n        let saved = counter\n        writes_counter()\n        counter = saved\n    } else \{\n        writes_counter()\n    }\n}\nfn main() \{\n}\n"
    let output = compile_test_helpers.compile_and_capture(src, "_test_ma_w0551_sibling")
    compile_test_helpers.expect_warning(output, "UnrestoredMutation", "W0551 fires for unsaved call in sibling block")
}
