// test_mutation_lint_reads_the_return_write_set.bl — W0550/W0551 read the return write set
//
// sections/04_effects.md §4.16.4 *Return write set*: the lints read the writes of the callee
// that lie on some path to its normal return. A path ends only at an expression of type
// Never. A call adds the return write set of its callee only on the paths that go on after
// it, and a callee declared `-> Never` adds nothing. §4.16.7: a warning that still fires has
// a note that names the write site and the call chain, and the help line names both fixes.
import compile_test_helpers

// One JSON diagnostic per line: the lines that carry `code` with its span at line:col.
fn diags_at(out: Str, code: Str, line: Int, col: Int) -> Int {
    let mut n = 0
    for l in out.split("\n") {
        if l.contains("\"code\":\"{code}\"") && l.contains("\"line\":{line},\"col\":{col}}") {
            n = n + 1
        }
    }
    n
}

fn count_code(out: Str, code: Str) -> Int {
    let mut n = 0
    for l in out.split("\n") {
        if l.contains("\"code\":\"{code}\"") {
            n = n + 1
        }
    }
    n
}

fn mutation_lints(out: Str) -> Int {
    count_code(out, "W0550") + count_code(out, "W0551")
}

// The marker is a rollback the lint must flag, placed after the row's own code, so a row
// that sees no lint proves the analysis ran to the end rather than stopped early.
fn expect_no_mutation_lint(src: Str, tag: Str) {
    let marker = [
        #""#,
        #"let mut rw_marker_g = 0"#,
        #"let mut rw_marker_h = 0"#,
        #""#,
        #"fn rw_marker_w() {"#,
        #"    rw_marker_g = 1"#,
        #"    rw_marker_h = 1"#,
        #"}"#,
        #""#,
        #"fn rw_marker() {"#,
        #"    let s = rw_marker_g"#,
        #"    rw_marker_w()"#,
        #"    rw_marker_g = s"#,
        #"}"#,
    ].join("\n")
    let out = compile_test_helpers.compile_and_capture("{src}\n{marker}", tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    compile_test_helpers.expect_contains(out, "call to `rw_marker_w` in `rw_marker`", "{tag} marker")
    assert_eq(mutation_lints(out), 1)
}

fn scratch_file(tag: Str) -> Str {
    "{compile_test_helpers.scratch_root()}/{tag}.bl"
}

let HELP_ERR = "save and restore `err` around the call, or end that path in a call to a `-> Never` function"

// The §4.16.4 example: `die` writes `err` and then ends in env.exit, so no path takes the
// write to a return, and `item` adds nothing through it.
test "a write before env.exit is not in the return write set of its function or its callers" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #"let mut items: List[Int] = [1, 2, 3]"#,
        #""#,
        #"fn die(msg: Str) ! Env.Exit {"#,
        #"    err = msg"#,
        #"    env.exit(101)"#,
        #"}"#,
        #""#,
        #"fn item(i: Int) -> Int ! Env.Exit {"#,
        #"    if i < 0 || i >= items.len() { die("bad index") }"#,
        #"    items.get(i).unwrap()"#,
        #"}"#,
        #""#,
        #"fn peek() -> Int ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    let v = item(pos)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = peek()"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_die_item_peek")
}

// `step` from §4.16.4: `err` is written only on the path that ends in env.exit, `count` on
// the path that returns. A caller that saves and restores `count` gets no warning.
test "a caller that saves the one global on the return path of its callee gets no warning" {
    let src = [
        #"let mut err = """#,
        #"let mut count = 0"#,
        #""#,
        #"fn step(n: Int) -> Int ! Env.Exit {"#,
        #"    if n < 0 {"#,
        #"        err = "neg""#,
        #"        env.exit(101)"#,
        #"    }"#,
        #"    count = count + 1"#,
        #"    n"#,
        #"}"#,
        #""#,
        #"fn try_step(n: Int) -> Int ! Env.Exit {"#,
        #"    let saved = count"#,
        #"    let v = step(n)"#,
        #"    count = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = try_step(1)"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_step_saves_count")
}

// The same `step` under a rollback of another global: the warning names `count`, which can
// reach the return, and not `err`, which cannot.
test "a warning names only the globals on the return path of the callee" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #"let mut count = 0"#,
        #""#,
        #"fn step(n: Int) -> Int ! Env.Exit {"#,
        #"    if n < 0 {"#,
        #"        err = "neg""#,
        #"        env.exit(101)"#,
        #"    }"#,
        #"    count = count + 1"#,
        #"    n"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) -> Int ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    let v = step(n)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = look(1)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_step_names_count"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 16, 13), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `step` in `look` mutates [count];", "step names count only")
    compile_test_helpers.expect_contains(out, "`count` is written at {scratch_file(tag)}:10, in `step`", "step write-site note")
    compile_test_helpers.expect_contains(out, "save and restore `count` around the call, or end that path in a call to a `-> Never` function", "step help")

    // `blink check` reads the same set as the build.
    let chk = compile_test_helpers.check_via_cli(src, tag)
    assert_eq(diags_at(chk, "W0551", 16, 13), 1)
    assert_eq(mutation_lints(chk), 1)
    compile_test_helpers.expect_contains(chk, "call to `step` in `look` mutates [count];", "check names count only")
}

// §4.16.7 *Shape of a warning that still fires*: the write reaches the return through a
// call, so the note gives the write site and the chain of calls back to the callee.
test "a warning that still fires names the write site and the call chain" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #""#,
        #"fn report(msg: Str) {"#,
        #"    err = msg"#,
        #"}"#,
        #""#,
        #"fn item(i: Int) -> Int {"#,
        #"    if i < 0 { report("neg") }"#,
        #"    i"#,
        #"}"#,
        #""#,
        #"fn peek() -> Int {"#,
        #"    let saved = pos"#,
        #"    let v = item(pos)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() {"#,
        #"    let _ = peek()"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_still_fires_chain"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 15, 13), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `item` in `peek` mutates [err];", "chain header")
    compile_test_helpers.expect_contains(out, "`pos` is saved at 14:9 and restored at 16:5 with no new value set between (speculative pair)", "chain pair note")
    let file = scratch_file(tag)
    compile_test_helpers.expect_contains(out, "`err` is written at {file}:5, in `report`, called from `item` at {file}:9", "chain write-site note")
    compile_test_helpers.expect_contains(out, "\"message\":\"`item` can return with `err` changed\"", "chain span label")
    // The §4.16.7 example of W0551 has no writes note: the write-site note takes its place.
    assert(!out.contains("`item` writes"))
    compile_test_helpers.expect_contains(out, HELP_ERR, "chain help")
    compile_test_helpers.expect_contains(out, "if the function sets a global for this call, assign that global between its save and this call", "chain binding help")
}

// A callee that writes and then calls a `-> Never` function on one path, and returns on the
// other with no write: the call adds nothing on the first path, so nothing reaches the return.
test "a write followed by a call to a -> Never function is not in the return write set" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #""#,
        #"fn fail(msg: Str) -> Never ! Env.Exit {"#,
        #"    err = msg"#,
        #"    env.exit(2)"#,
        #"}"#,
        #""#,
        #"fn checked(n: Int) -> Int ! Env.Exit {"#,
        #"    if n < 0 {"#,
        #"        err = "negative""#,
        #"        fail("negative")"#,
        #"    }"#,
        #"    n"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) -> Int ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    let v = checked(n)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = look(1)"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_write_then_never_call")
}

// env.exit as the end of a path inside a match arm; the other arm returns with the write.
test "env.exit in a match arm ends that path, and the arm that returns keeps its write" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #"let mut seen = 0"#,
        #""#,
        #"fn classify(n: Int) -> Int ! Env.Exit {"#,
        #"    match n {"#,
        #"        0 => {"#,
        #"            err = "zero""#,
        #"            env.exit(3)"#,
        #"        }"#,
        #"        _ => {"#,
        #"            seen = n"#,
        #"            n"#,
        #"        }"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) -> Int ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    let v = classify(n)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = look(1)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_exit_in_match_arm"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 20, 13), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `classify` in `look` mutates [seen];", "match arm names seen only")
}

// An early `return` reaches the normal return, so a write before it stays in the set.
test "a write before an early return stays in the return write set" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #""#,
        #"fn checked(n: Int) -> Result[Int, Str] {"#,
        #"    if n < 0 {"#,
        #"        err = "negative""#,
        #"        return Err("negative")"#,
        #"    }"#,
        #"    Ok(n)"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) -> Result[Int, Str] {"#,
        #"    let saved = pos"#,
        #"    let v = checked(n)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() {"#,
        #"    let _ = look(1)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_write_before_return"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 14, 13), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "`err` is written at {scratch_file(tag)}:6, in `checked`", "early return write-site note")
}

// Two functions that call each other. `bounce` writes `err` only before env.exit, so the
// pair has nothing on its return paths but `count`.
test "a recursive pair holds only the writes on its return paths" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #"let mut count = 0"#,
        #""#,
        #"fn walk(n: Int) ! Env.Exit {"#,
        #"    if n > 0 { bounce(n - 1) }"#,
        #"}"#,
        #""#,
        #"fn bounce(n: Int) ! Env.Exit {"#,
        #"    if n == 7 {"#,
        #"        err = "seven""#,
        #"        env.exit(4)"#,
        #"    }"#,
        #"    count = count + 1"#,
        #"    walk(n)"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    walk(n)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(3)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_recursive_pair"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 20, 5), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `walk` in `look` mutates [count];", "recursive pair names count only")
    let file = scratch_file(tag)
    compile_test_helpers.expect_contains(out, "`count` is written at {file}:14, in `bounce`, called from `walk` at {file}:6", "recursive pair write-site note")
}

// A recursive pair whose only write comes before env.exit has an empty return write set.
test "a recursive pair whose writes all end in env.exit gives no warning" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #""#,
        #"fn walk(n: Int) ! Env.Exit {"#,
        #"    if n > 0 { bounce(n - 1) }"#,
        #"}"#,
        #""#,
        #"fn bounce(n: Int) ! Env.Exit {"#,
        #"    if n == 7 {"#,
        #"        err = "seven""#,
        #"        env.exit(4)"#,
        #"    }"#,
        #"    walk(n)"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    walk(n)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(3)"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_recursive_pair_exits")
}

// The error edge of `?` reaches the normal return, so a write before it stays in the set
// even when every other path ends in env.exit.
test "the error edge of ? reaches the return" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut seen = 0"#,
        #""#,
        #"fn check(n: Int) -> Result[Int, Str] {"#,
        #"    if n < 0 { Err("negative") } else { Ok(n) }"#,
        #"}"#,
        #""#,
        #"fn run(n: Int) -> Result[Int, Str] ! Env.Exit {"#,
        #"    seen = n"#,
        #"    let v = check(n)?"#,
        #"    env.exit(v)"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) -> Result[Int, Str] ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    let v = run(n)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = look(1)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_question_edge"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 16, 13), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "`seen` is written at {scratch_file(tag)}:9, in `run`", "? edge write-site note")
}

// A `loop` with no `break` has type Never: no path through it reaches the return.
test "a write inside a loop with no break is not in the return write set" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut count = 0"#,
        #""#,
        #"fn spin() ! Env.Exit {"#,
        #"    loop {"#,
        #"        count = count + 1"#,
        #"        if count > 9 { env.exit(0) }"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look() ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    spin()"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look()"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_loop_no_break")
}

// `break` leaves the loop for the code after it, and `continue` goes back to the loop head,
// so writes before either stay in the set when the loop can end. A write before env.exit
// in the same loop does not.
test "break and continue carry a write on to the return" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut err = """#,
        #"let mut seen = 0"#,
        #"let mut count = 0"#,
        #""#,
        #"fn scan(n: Int) ! Env.Exit {"#,
        #"    let mut i = 0"#,
        #"    while i < n {"#,
        #"        i = i + 1"#,
        #"        if i == 2 {"#,
        #"            count = count + 1"#,
        #"            continue"#,
        #"        }"#,
        #"        if i == 5 {"#,
        #"            err = "five""#,
        #"            env.exit(5)"#,
        #"        }"#,
        #"        if i == 7 {"#,
        #"            seen = i"#,
        #"            break"#,
        #"        }"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    scan(n)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(9)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_break_continue"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 27, 5), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `scan` in `look` mutates [seen, count];", "loop names seen and count")
}

// A store runs after its value, and a call after its arguments, so a value or an argument
// of type Never ends the path before the write. So does a statement after a call to a
// `-> Never` function in the same block.
test "a write after an expression of type Never is not in the return write set" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut code = 0"#,
        #"let mut items: List[Int] = []"#,
        #""#,
        #"fn fail() -> Never ! Env.Exit {"#,
        #"    env.exit(3)"#,
        #"}"#,
        #""#,
        #"fn note(n: Int) {"#,
        #"    code = n"#,
        #"}"#,
        #""#,
        #"fn stop(c: Int) ! Env.Exit {"#,
        #"    if c == 1 { code = fail() }"#,
        #"    if c == 2 { items.push(fail()) }"#,
        #"    if c == 3 { note(fail()) }"#,
        #"    if c == 4 {"#,
        #"        fail()"#,
        #"        code = 1"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look(c: Int) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    stop(c)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(0)"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_write_after_never")
}

// The `if` has no else, so the path where `c` is false goes on to the return, and the write
// before the `if` goes with it.
test "a trailing if whose branch ends in env.exit keeps the writes before it" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut count = 0"#,
        #""#,
        #"fn step(c: Bool) ! Env.Exit {"#,
        #"    count = count + 1"#,
        #"    if c { env.exit(2) }"#,
        #"}"#,
        #""#,
        #"fn look(c: Bool) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    step(c)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(false)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_trailing_if_exit"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 11, 5), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `step` in `look` mutates [count];", "trailing if names count")
}

// A `with` opens its resource before the body runs, so the resource is on the path the body
// takes, here a `return`. The write of `count` at line 13 puts `count` in the write set
// of `use_it` directly; the warning comes through the call to `acquire`.
test "the resource of a with block is on the path its body takes to the return" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut count = 0"#,
        #""#,
        #"type Res { n: Int }"#,
        #"impl Closeable for Res { fn close(_self) {} }"#,
        #""#,
        #"fn fail() -> Never ! Env.Exit {"#,
        #"    env.exit(3)"#,
        #"}"#,
        #""#,
        #"fn acquire() -> Res {"#,
        #"    count = count + 1"#,
        #"    Res { n: 1 }"#,
        #"}"#,
        #""#,
        #"fn use_it(x: Int) -> Int ! Env.Exit {"#,
        #"    if x > 5 {"#,
        #"        count = 2"#,
        #"        fail()"#,
        #"    }"#,
        #"    with acquire() as r {"#,
        #"        return r.n + x"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look() -> Int ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    let v = use_it(1)"#,
        #"    pos = saved"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = look()"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_with_resource_return"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 28, 13), 1)
    assert_eq(mutation_lints(out), 1)
    let file = scratch_file(tag)
    compile_test_helpers.expect_contains(out, "`count` is written at {file}:12, in `acquire`, called from `use_it` at {file}:21", "with resource write-site note")
}

// A guard that fails moves on to the arms after it, not the ones before it. Here every arm
// after the guard ends in a call to a `-> Never` function, so the write in the guard does
// not reach the return, though the first arm does.
test "a failed match guard goes on only to the arms after it" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut count = 0"#,
        #""#,
        #"fn fail() -> Never ! Env.Exit {"#,
        #"    env.exit(3)"#,
        #"}"#,
        #""#,
        #"fn bump() -> Bool {"#,
        #"    count = count + 1"#,
        #"    true"#,
        #"}"#,
        #""#,
        #"fn pick(x: Int) ! Env.Exit {"#,
        #"    match x {"#,
        #"        1 => {}"#,
        #"        _ if bump() => fail()"#,
        #"        _ => fail()"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look(x: Int) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    pick(x)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(1)"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_guard_later_arms")
}

// `err` is in the write set of `step` but not in its return write set. The pair around the
// call still saves it, so the warning is W0550. Its writes note names the full write set, as
// in the §4.16.7 example of W0550: "writes" names the write set, which §4.16.4 keeps.
test "a pair that saves a global off the return path is still a save around the call" {
    let src = [
        #"let mut err = """#,
        #"let mut count = 0"#,
        #""#,
        #"fn step(n: Int) -> Int ! Env.Exit {"#,
        #"    if n < 0 {"#,
        #"        err = "neg""#,
        #"        env.exit(101)"#,
        #"    }"#,
        #"    count = count + 1"#,
        #"    n"#,
        #"}"#,
        #""#,
        #"fn peek(n: Int) -> Int ! Env.Exit {"#,
        #"    let se = err"#,
        #"    let v = step(n)"#,
        #"    err = se"#,
        #"    v"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    let _ = peek(1)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_pair_off_return_path"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0550", 15, 13), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `step` in `peek` mutates [count] which are not saved/restored (write-set: 2 globals, saved: 1)", "off-path pair header")
    compile_test_helpers.expect_contains(out, #"`step` writes {err, count}""#, "off-path writes note")
    assert(!out.contains("on return"))
    compile_test_helpers.expect_contains(out, "only [err] is restored after the call", "off-path restored note")
}

// The closure's type says it returns Never only once typecheck infers it from the body; the
// call still ends the path.
test "a call of a closure whose Never return is inferred ends the path" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut count = 0"#,
        #""#,
        #"fn stop_on(c: Bool) ! Env.Exit {"#,
        #"    let stop = fn() {"#,
        #"        env.exit(3)"#,
        #"    }"#,
        #"    if c {"#,
        #"        count = count + 1"#,
        #"        stop()"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look(c: Bool) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    stop_on(c)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(true)"#,
        #"}"#,
    ].join("\n")
    expect_no_mutation_lint(src, "_rw_inferred_never_closure")
}

// A loop's head is settled in a bounded number of walks of its body, and a nested loop
// inside it is not walked again for each of them. With an early return after each loop,
// 28 levels took 2^28 walks of the inner body.
test "deeply nested loops with early returns are walked a bounded number of times" {
    let depth = 28
    let mut lines: List[Str] = [#"let mut pos = 0"#, #"let mut count = 0"#, #""#, #"fn spin() {"#]
    let mut i = 0
    while i < depth {
        lines.push(#"while count < 3 {"#)
        i = i + 1
    }
    lines.push(#"count = count + 1"#)
    i = 0
    while i < depth {
        lines.push(#"}"#)
        lines.push(#"if count > 5 { return }"#)
        i = i + 1
    }
    lines.push(#"}"#)
    lines.push(#""#)
    lines.push(#"fn look() {"#)
    lines.push(#"    let saved = pos"#)
    lines.push(#"    spin()"#)
    lines.push(#"    pos = saved"#)
    lines.push(#"}"#)
    lines.push(#""#)
    lines.push(#"fn main() { look() }"#)
    let tag = "_rw_nested_loops"
    let out = compile_test_helpers.compile_and_capture(lines.join("\n"), tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    compile_test_helpers.expect_contains(out, "call to `spin` in `look` mutates [count];", "nested loops names count")
}

// §4.16.4 defines the return write set by the paths that reach the normal return, and a
// jump has type Never. This file reads a jump as moving the path, not ending it: `return`
// and the error edge of `?` go to the normal return, `break` and `continue` go to their
// loop. Only an expression of type Never that is not a jump, such as env.exit, ends a path.
test "a jump moves the path to its target and only a Never that is not a jump ends it" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut by_return = 0"#,
        #"let mut by_break = 0"#,
        #"let mut by_exit = 0"#,
        #""#,
        #"fn walk(n: Int) ! Env.Exit {"#,
        #"    if n == 1 {"#,
        #"        by_return = 1"#,
        #"        return"#,
        #"    }"#,
        #"    while true {"#,
        #"        by_break = 1"#,
        #"        break"#,
        #"    }"#,
        #"    if n == 2 {"#,
        #"        by_exit = 1"#,
        #"        env.exit(2)"#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn look(n: Int) ! Env.Exit {"#,
        #"    let saved = pos"#,
        #"    walk(n)"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() ! Env.Exit {"#,
        #"    look(3)"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_jump_moves_path"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 23, 5), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `walk` in `look` mutates [by_return, by_break];", "jumps keep their writes, env.exit drops its write")
}

// §4.16.7 *Shape of a warning that still fires* names "a note that names the write site":
// one note, for the first unsaved global in declaration order, and the label names the same
// global.
test "a warning with many unsaved globals has one write-site note for the first declared" {
    let src = [
        #"let mut pos = 0"#,
        #"let mut alpha = 0"#,
        #"let mut beta = 0"#,
        #"let mut gamma = 0"#,
        #""#,
        #"fn many() {"#,
        #"    gamma = 3"#,
        #"    beta = 2"#,
        #"    alpha = 1"#,
        #"}"#,
        #""#,
        #"fn look() {"#,
        #"    let saved = pos"#,
        #"    many()"#,
        #"    pos = saved"#,
        #"}"#,
        #""#,
        #"fn main() {"#,
        #"    look()"#,
        #"}"#,
    ].join("\n")
    let tag = "_rw_one_site_note"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert_eq(diags_at(out, "W0551", 14, 5), 1)
    assert_eq(mutation_lints(out), 1)
    compile_test_helpers.expect_contains(out, "call to `many` in `look` mutates [alpha, beta, gamma];", "all unsaved globals in the header")
    compile_test_helpers.expect_contains(out, "`alpha` is written at {scratch_file(tag)}:9, in `many`", "the note names the first declared")
    assert(!out.contains("`beta` is written at"))
    assert(!out.contains("`gamma` is written at"))
    compile_test_helpers.expect_contains(out, "\"message\":\"`many` can return with `alpha` changed\"", "the label names the first declared")
}
