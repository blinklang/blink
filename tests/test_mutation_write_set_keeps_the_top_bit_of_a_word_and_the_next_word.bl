// Write sets pack 64 globals to a word, so global 63 is the top bit of the first word and
// global 64 starts the next one. A write to each, reached through a call cycle, must reach
// the caller's write set, and a save of global 63 alone must count as a save.
import compile_test_helpers
import std.str.{str_join}

fn program_source() -> Str {
    let mut lines: List[Str] = []
    let mut i = 0
    while i < 70 {
        lines.push("let mut g{i}: Int = 0")
        i = i + 1
    }
    lines.push("fn top() \{")
    lines.push("    let saved = g63")
    lines.push("    edge_a(2)")
    lines.push("    g63 = saved")
    lines.push("}")
    lines.push("fn edge_a(n: Int) \{")
    lines.push("    if n > 0 \{")
    lines.push("        edge_b(n - 1)")
    lines.push("    }")
    lines.push("}")
    lines.push("fn edge_b(n: Int) \{")
    lines.push("    g64 = 1")
    lines.push("    g63 = 1")
    lines.push("    g62 = 1")
    lines.push("    edge_a(n)")
    lines.push("}")
    lines.push("fn main() \{")
    lines.push("    top()")
    lines.push("}")
    lines.push("")
    str_join(lines, "\n")
}

test "a write to the top bit of a word and to the first bit of the next word reaches every caller" {
    let output = compile_test_helpers.compile_and_capture(program_source(), "_test_ma_top_bit_write_set")
    compile_test_helpers.expect_warning(output, "IncompleteStateRestore", "the restore of g63 alone around edge_a draws W0550")
    compile_test_helpers.expect_contains(output, "call to `edge_a` in `top` mutates [g62, g64] which are not saved/restored (write-set: 3 globals, saved: 1)", "g62 and g64 are the unsaved writes and g63 counts as saved")
    compile_test_helpers.expect_contains(output, "`edge_a` writes \{g62, g63, g64}", "edge_a's write set lists g62, g63 and g64 in declared order")
    compile_test_helpers.expect_contains(output, "only [g63] is restored after the call", "the save of g63 is seen")
}
