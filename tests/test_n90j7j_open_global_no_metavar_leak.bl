// br n90j7j — the second pass that types unannotated non-literal globals must NOT adopt an
// under-determined tid. `infer_type` mints a fresh metavar for an open constructor (`[]` ->
// List[α], `None` -> Option[α]), which is != TYPE_UNKNOWN and would pass a bare non-UNKNOWN
// guard — but an unbound α has no C spelling, so codegen would name a garbage element type or
// ICE. The pass gates adoption on `tc_tid_has_unbound_metavar == 0`, so an open global stays
// UNKNOWN and codegen falls back exactly as before (a plain `blink_list*`).
//
// This RUNS the program: the observable is that it compiles and prints the right length, which
// only holds if the metavar tid never reached codegen.

import compile_test_helpers
import std.io

test "an unannotated global with an open-list initializer compiles and runs" {
    let mut s = "import std.io\n"
    s = s.concat("let g_empty = []\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    io.println(\"len=\{g_empty.len()}\")\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "n90j7j_open_list")
    if r.exit_code != 0 {
        io.println("FAIL: open-list global did not compile/run cleanly (exit {r.exit_code})")
        io.println(r.err_out)
    }
    assert(r.exit_code == 0)
    assert(r.out.contains("len=0"))
}
