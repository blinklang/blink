import compile_test_helpers

// Passing a top-level function BY NAME to a List[T].filter() callback must
// emit the mangled C symbol for the callee, the same one used at its own
// definition site, not the bare Blink-level identifier.

fn named_fn_filter_src() -> Str {
    #"import std.io

fn keep(x: Int) -> Bool { x > 1 }

fn main() ! IO {
    let xs: List[Int] = [1, 2, 3]
    let got = xs.filter(keep)
    io.println("n {got.len()}")
}
"#
}

test "named top-level fn passed to filter() compiles and filters correctly" {
    let r = compile_test_helpers.compile_and_run(named_fn_filter_src(), "_named_fn_filter")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n 2\n")
}
