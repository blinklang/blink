// A named fn whose declared return type is a generic enum INSTANCE must emit that
// instance's tagged-union typedef before the fn's own forward declaration references
// it, when the enum has a payload-less variant alongside a payload-carrying one.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a named fn returning Maybe[Int] emits the blink_Maybe_0Int instance typedef ahead of its own prototype",
    reason: "register_enum_instance_from_tid is not reached from the named-fn return position, so the instance typedef for a generic enum with a nullary variant is never emitted and the forward declaration references an unknown type",
    ticket: "050868",
) {
    let src = #"
type Maybe[T] {
    Nothing,
    Just(v: T)
}
fn mk() -> Maybe[Int] { Maybe.Just(7) }
fn main() ! IO {
    match mk() {
        Maybe.Just(v) => io.println("int={v}")
        Maybe.Nothing => io.println("int=nothing")
    }
}
"#
    let r = compile_and_run(src, "_named_fn_ret_enum_instance_nullary")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "int=7\n")
}
