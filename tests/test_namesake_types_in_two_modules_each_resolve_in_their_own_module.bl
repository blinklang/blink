// Two modules of one package may each declare a type of the same bare name, and the two are
// different types (sections/03_types.md, "Identity, not spelling, selects behavior"). Inside
// each module the bare name, and the qualifier written on a variant, means that module's own
// declaration. The check reads it per module, and so does the build: each module's `Hue.X`
// and its bare `X` in a match reach its own enum, whichever module the main file imports first.

import compile_test_helpers

fn cleanup(base: Str) {
    let _ = process.run("rm", ["-rf", base]).unwrap()
}

fn fail(base: Str, msg: Str) {
    io.println("FAIL: {msg}")
    cleanup(base)
    assert(false)
}

fn blink_bin() -> Str {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()
    "{blink_root}/build/blink"
}

fn new_package(base: Str) {
    cleanup(base)
    let _ = process.run("mkdir", ["-p", "{base}/src"]).unwrap()
    write_file("{base}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
}

// The combined output of `blink <cmd> src/main.bl`, with its exit status on the last line.
fn blink_in(base: Str, cmd: Str) -> Str {
    let r = process.run("sh", ["-c", "cd {base} && {blink_bin()} {cmd} src/main.bl 2>&1"]).unwrap()
    "{r.out}\nexit {r.exit_code}"
}

fn exited_clean(out: Str) -> Bool {
    out.ends_with("\nexit 0")
}

// Writes alpha and beta, and a main file that imports them in `order`.
fn write_package(base: Str, alpha: Str, beta: Str, order: List[Str]) {
    new_package(base)
    write_file("{base}/src/alpha.bl", alpha)
    write_file("{base}/src/beta.bl", beta)
    let mut imports = ""
    for m in order {
        let line = if m == "alpha" { "import alpha.\{make_a\}\n" } else { "import beta.\{make_b\}\n" }
        imports = imports.concat(line)
    }
    write_file("{base}/src/main.bl", "{imports}\nfn main() \{ io.println(\"\{make_a()\} \{make_b()\}\") \}\n")
}

// Checks and runs the package; the run's output must hold every line of `want`.
fn expect_run(base: Str, alpha: Str, beta: Str, order: List[Str], want: List[Str]) {
    write_package(base, alpha, beta, order)
    let names = order.join(", ")
    let chk = blink_in(base, "check")
    if !exited_clean(chk) {
        fail(base, "importing {names} should check clean, got: {chk}")
        return
    }
    let run = blink_in(base, "run")
    for w in want {
        if !exited_clean(run) || !run.contains(w) {
            fail(base, "importing {names} should run and print `{w}`, got: {run}")
            return
        }
    }
}

fn hue_alpha() -> Str {
    #"pub type Hue {
    Red
    Green
}

pub fn make_a() -> Int {
    let h = Hue.Red
    match h {
        Red => 1
        Green => 2
    }
}
"#
}

fn hue_beta() -> Str {
    #"pub type Hue {
    Blue
    Gray
}

pub fn make_b() -> Int {
    let h = Hue.Blue
    match h {
        Blue => 3
        Gray => 4
    }
}
"#
}

test "a namesake enum qualifier reads its own module's enum in either import order" {
    let base = "{compile_test_helpers.scratch_root()}/_test_namesake_types_enum_qualifier"
    expect_run(base, hue_alpha(), hue_beta(), ["alpha", "beta"], ["1 3"])
    expect_run(base, hue_alpha(), hue_beta(), ["beta", "alpha"], ["1 3"])
    cleanup(base)
}

test "a namesake struct builds and reads its own module's fields in either import order" {
    let base = "{compile_test_helpers.scratch_root()}/_test_namesake_types_struct"
    let alpha = #"pub type Spot { x: Int }

pub fn make_a() -> Int {
    let s = Spot { x: 1 }
    s.x
}
"#
    let beta = #"pub type Spot { y: Int, z: Int }

pub fn make_b() -> Int {
    let s = Spot { y: 3, z: 4 }
    s.y + s.z
}
"#
    expect_run(base, alpha, beta, ["alpha", "beta"], ["1 7"])
    expect_run(base, alpha, beta, ["beta", "alpha"], ["1 7"])
    cleanup(base)
}

// Both enums declare a `Dot`, with a different payload, so a variant that reached the other
// module's enum would bind the wrong payload type.
test "each module constructs and matches the payload variants of its own namesake enum" {
    let base = "{compile_test_helpers.scratch_root()}/_test_namesake_types_payload"
    let alpha = #"pub type Shape {
    Dot(r: Int)
    Bar(w: Int, h: Int)
}

pub fn make_a() -> Int {
    let s = Shape.Dot(1)
    let t = Shape.Bar(2, 5)
    let a = match s {
        Dot(r) => r
        Bar(w, h) => w * h
    }
    let b = match t {
        Shape.Dot(r) => r
        Shape.Bar(w, h) => w + h
    }
    a * 10 + b
}
"#
    let beta = #"pub type Shape {
    Tri(a: Int, b: Int, c: Int)
    Dot(name: Str)
}

pub fn make_b() -> Int {
    let s = Shape.Tri(3, 4, 5)
    let t = Shape.Dot("abcd")
    let a = match s {
        Tri(x, y, z) => x + y + z
        Dot(n) => n.len()
    }
    let b = match t {
        Shape.Tri(x, _, _) => x
        Shape.Dot(n) => n.len()
    }
    a * 10 + b
}
"#
    expect_run(base, alpha, beta, ["alpha", "beta"], ["17 124"])
    expect_run(base, alpha, beta, ["beta", "alpha"], ["17 124"])
    cleanup(base)
}

// Each module implements traits for its own namesake types, so an impl reached through a
// receiver, and the close a `with` block runs, must be that module's.
test "each module's trait impls over a namesake type are the ones its values use" {
    let base = "{compile_test_helpers.scratch_root()}/_test_namesake_types_impls"
    let alpha = #"import std.traits

pub type Hue {
    Red
    Green
}

impl Display for Hue {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Red => sb.write("1")
            Green => sb.write("2")
        }
    }
}

pub type Res { n: Int }

impl Closeable for Res {
    fn close(self) { io.println("alpha closes {self.n}") }
}

pub fn make_a() -> Str {
    with Res { n: 5 } as r {
        let _ = r.n
    }
    Hue.Green.display()
}
"#
    let beta = #"import std.traits

pub type Hue {
    Blue
    Gray
}

impl Display for Hue {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Blue => sb.write("3")
            Gray => sb.write("4")
        }
    }
}

pub type Res { n: Int }

impl Closeable for Res {
    fn close(self) { io.println("beta closes {self.n}") }
}

pub fn make_b() -> Str {
    with Res { n: 6 } as r {
        let _ = r.n
    }
    Hue.Gray.display()
}
"#
    let want = ["alpha closes 5", "beta closes 6", "2 4"]
    expect_run(base, alpha, beta, ["alpha", "beta"], want)
    expect_run(base, alpha, beta, ["beta", "alpha"], want)
    cleanup(base)
}

// A qualified variant pattern over a scalar scrutinee names a variant that can never match.
// The qualifier is a namesake, so the check has to read it in the module that wrote it.
test "a namesake enum's variant pattern over a scalar is rejected in its own module" {
    let base = "{compile_test_helpers.scratch_root()}/_test_namesake_types_scalar_pattern"
    let beta = #"pub type Hue {
    Blue
    Gray
}

pub fn make_b() -> Int {
    match 3 {
        Hue.Blue => 1
        _ => 2
    }
}
"#
    for order in [["alpha", "beta"], ["beta", "alpha"]] {
        write_package(base, hue_alpha(), beta, order)
        let chk = blink_in(base, "check")
        if exited_clean(chk) || !chk.contains("error[EnumPatternNeedsEnumScrutinee]") || !chk.contains("src/beta.bl:8:9") {
            fail(base, "importing {order.join(", ")} should reject the scalar match in beta, got: {chk}")
            return
        }
    }
    cleanup(base)
}

// A field default is written in its type's module, so a literal in another module that
// leaves the field out still builds the default from the type's own module.
test "a field default names its own module's namesake enum when another module builds the struct" {
    let base = "{compile_test_helpers.scratch_root()}/_test_namesake_types_field_default"
    let alpha = #"pub type Hue {
    Red
    Green
}

pub type Spot {
    n: Int
    h: Hue = Hue.Green
}

pub fn code(s: Spot) -> Int {
    match s.h {
        Red => 1
        Green => 2
    }
}

pub fn make_a() -> Int {
    code(Spot { n: 0 })
}
"#
    let beta = #"import alpha.{Spot, code}

pub type Hue {
    Blue
    Gray
}

pub fn make_b() -> Int {
    let k = match Hue.Gray {
        Blue => 3
        Gray => 4
    }
    code(Spot { n: 0 }) * 10 + k
}
"#
    expect_run(base, alpha, beta, ["alpha", "beta"], ["2 24"])
    expect_run(base, alpha, beta, ["beta", "alpha"], ["2 24"])
    cleanup(base)
}
