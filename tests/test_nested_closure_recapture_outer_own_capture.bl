// A nested closure that reads a variable present only as the ENCLOSING
// closure's own capture (not directly in the fn defining both closures) must
// chain through that enclosing capture slot, not reference the outer Blink
// name directly.

import compile_test_helpers.{compile_and_run}

test "a nested closure re-capturing an outer closure's own Map capture compiles and runs" {
    let src = #"
import std.io

fn main() ! IO {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 5)
    let outer = fn() -> Int {
        let inner = fn() -> Int { m.get("k").unwrap() }
        inner()
    }
    io.println("{outer()}")
}
"#
    let r = compile_and_run(src, "_nested_closure_recapture_outer_own_capture")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}
