// whg65a: a container nested INSIDE a compound List element
// (`List[Option[Map[K,V]]]`, `List[Result[Map,...]]`, `List[Option[List[T]]]`)
// silently lost the inner container's own type parameters. The old flat one-level
// inner slot held only ONE inner level; list→option→map→{k,v} is four levels
// deep, so the Map's value type was erased to the default Int — a Str value read
// back as a pointer-int (silent wrong output, no crash). These runtime asserts reach their comparisons only if the
// full nested element type survives get()/pop()/for-in + the nested container's
// own decode.

test "List[Option[Map[Int,Str]]] get + nested map get" {
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "a")
    let c: List[Option[Map[Int, Str]]] = [Some(m)]
    let inner = c.get(0).unwrap()
    match inner {
        Some(mm) => {
            match mm.get(1) {
                Some(s) => assert_eq(s, "a")
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Option[Map[Str,Int]]] get + nested map get" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 42)
    let c: List[Option[Map[Str, Int]]] = [Some(m)]
    let inner = c.get(0).unwrap()
    match inner {
        Some(mm) => {
            match mm.get("k") {
                Some(v) => assert_eq(v, 42)
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Option[Map[Int,Str]]] for-in + nested map get" {
    let mut m1: Map[Int, Str] = Map()
    m1.insert(1, "x")
    let mut m2: Map[Int, Str] = Map()
    m2.insert(2, "y")
    let c: List[Option[Map[Int, Str]]] = [Some(m1), None, Some(m2)]
    let mut acc = ""
    for item in c {
        match item {
            Some(mm) => {
                match mm.get(1) {
                    Some(s) => acc = acc.concat(s)
                    None => {}
                }
                match mm.get(2) {
                    Some(s) => acc = acc.concat(s)
                    None => {}
                }
            }
            None => acc = acc.concat("_")
        }
    }
    assert_eq(acc, "x_y")
}

test "List[Option[Map[Int,Str]]] pop + nested map get" {
    let mut m: Map[Int, Str] = Map()
    m.insert(7, "z")
    let mut c: List[Option[Map[Int, Str]]] = [Some(m)]
    let popped = c.pop()
    match popped.unwrap() {
        Some(mm) => {
            match mm.get(7) {
                Some(s) => assert_eq(s, "z")
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Result[Map[Int,Str], Str]] get + nested map get" {
    let mut m: Map[Int, Str] = Map()
    m.insert(3, "ok")
    let c: List[Result[Map[Int, Str], Str]] = [Ok(m)]
    let inner = c.get(0).unwrap()
    match inner {
        Ok(mm) => {
            match mm.get(3) {
                Some(s) => assert_eq(s, "ok")
                None => assert(false)
            }
        }
        Err(_e) => assert(false)
    }
}

test "List[Result[Map[Int,Str], Str]] for-in + nested map get" {
    let mut m: Map[Int, Str] = Map()
    m.insert(5, "good")
    let c: List[Result[Map[Int, Str], Str]] = [Ok(m), Err("bad")]
    let mut acc = ""
    for item in c {
        match item {
            Ok(mm) => {
                match mm.get(5) {
                    Some(s) => acc = acc.concat(s)
                    None => {}
                }
            }
            Err(e) => acc = acc.concat(e)
        }
    }
    assert_eq(acc, "goodbad")
}

test "List[Option[List[Int]]] get + nested list get" {
    let inner_list: List[Int] = [10, 20, 30]
    let c: List[Option[List[Int]]] = [Some(inner_list)]
    let outer = c.get(0).unwrap()
    match outer {
        Some(li) => {
            assert_eq(li.get(1).unwrap(), 20)
            assert_eq(li.len(), 3)
        }
        None => assert(false)
    }
}

test "List[Option[List[Str]]] for-in + nested list get" {
    let a: List[Str] = ["p", "q"]
    let b: List[Str] = ["r"]
    let c: List[Option[List[Str]]] = [Some(a), None, Some(b)]
    let mut acc = ""
    for item in c {
        match item {
            Some(li) => {
                let mut i = 0
                while i < li.len() {
                    acc = acc.concat(li.get(i).unwrap())
                    i = i + 1
                }
            }
            None => acc = acc.concat("_")
        }
    }
    assert_eq(acc, "pq_r")
}
