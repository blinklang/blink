// A nested pattern that destructures a boxed self-recursive enum field must
// unbox it before reading the inner payload. A top-level ident bind on the
// same field already worked; this exercises the nested variant sub-pattern.

type IntTree { ILeaf(value: Int) IBranch(left: IntTree, right: IntTree) }

test "nested destructure through boxed recursive enum field" {
    let t = IBranch(ILeaf(7), ILeaf(9))
    let r = match t {
        IBranch(ILeaf(a), _) => "a={a}"
        _ => "other"
    }
    assert_eq(r, "a=7")
}
