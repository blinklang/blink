// A generic struct field whose annotation is itself a generic-struct instance
// carrying the outer's type parameter (Wrap[T] { inner: Box[T], .. }) must
// substitute T through that nested annotation, not just through a bare
// binder field.

import compile_test_helpers.{compile_and_run}

test.failing(
    "Wrap-of-Box generic struct field substitutes T through the nested Box[T] field",
    reason: "field_ann_at_instance only descends one level through a bare type-param binder field; a field annotation that already carries its own type arguments (Box[T]) is handed back unresolved, so Box's own T reaches monomorphization unsolved",
    ticket: "z0q17z",
) {
    let src = #"
import std.io

type Box[T] { value: T }
type Wrap[T] { inner: Box[T], tag: Int }

fn main() {
    let w: Wrap[Option[Str]] = Wrap { inner: Box { value: Some("hi") }, tag: 1 }
    io.println("tag={w.tag} inner={w.inner.value.unwrap()}")
}
"#
    let r = compile_and_run(src, "_nested_generic_struct_field_typevar_substitution")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "tag=1 inner=hi\n")
}
