// An unannotated nested list literal must keep its true inner element type at every
// depth, instead of falling back to Int once the flat element channel runs out.

test "unannotated depth-2 List[List[Str]] literal keeps its Str element" {
    let ys = [["ab"]]
    let inner = ys.get(0).unwrap()
    let e = inner.get(0).unwrap()
    assert_eq(e, "ab")
    assert_eq(inner.get(0).unwrap().to_upper(), "AB")
}

test "unannotated List[Option[Str]] literal keeps its Option inner type" {
    let b = [Some("cd"), Some("ef")]
    assert_eq(b.get(0).unwrap().unwrap(), "cd")
}

test "unannotated depth-3 all-Int nested list literal keeps its container elements" {
    let b = [[[7]]]
    let b0 = b.get(0).unwrap()
    let b1 = b0.get(0).unwrap()
    let bv: Int = b1.get(0).unwrap()
    assert_eq(bv, 7)
}
