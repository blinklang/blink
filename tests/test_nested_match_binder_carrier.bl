// A NESTED match over a push-built (metavar-pinned) element carrier must type the
// INNER arm binder as the inner PAYLOAD, not the outer scrutinee carrier. A push-built
// list (`let mut xs = []`) carries its element as a bound metavar (kind Unknown, inner1
// -> solution); the inner match's arm binder retype reads the scrutinee's payload type.
// If that read takes the inner off the raw metavar without resolving first, the binder is
// declared at the OUTER carrier type (`blink_Option_str s = _scrut.value`) and a scalar op
// on it (`s.len()`) fails to C-compile. Same metavar class as the unwrap carrier-tag
// speller (dgce5s) and the map value carrier (36cfkq), a DIFFERENT codegen region: the
// match-arm binder declaration. Written in the corpus so the shapes are the real
// self-hosted build, not a compile_and_run string.

// --- let-bound, Option[Option[Str]]: the recorded MVCE shape ---
test "a let-bound nested match on push-built Option[Str] binds the inner str payload" {
    let mut xs = []
    xs.push(Some("hi"))
    xs.push(None)
    let e = xs.get(0)
    let mut got = -1
    match e {
        Some(inner) => {
            match inner {
                Some(s) => { got = s.len() }
                None => { got = -2 }
            }
        }
        None => { got = -3 }
    }
    assert_eq(got, 2)
}

// --- chained, Option[Option[Int]]: scrutinee is the get() result directly ---
test "a chained nested match on push-built Option[Int] binds the inner int payload" {
    let mut xs = []
    xs.push(Some(7))
    xs.push(None)
    let mut got = -1
    match xs.get(0) {
        Some(inner) => {
            match inner {
                Some(v) => { got = v }
                None => { got = -2 }
            }
        }
        None => { got = -3 }
    }
    assert_eq(got, 7)
}

// --- Result inner carrier: Option[Result[Str,Int]] through a let ---
test "a let-bound nested match on push-built Result[Str,Int] binds the Ok str payload" {
    let mut xs = []
    xs.push(Ok("alpha"))
    xs.push(Err(1))
    let e = xs.get(0)
    let mut got = -1
    match e {
        Some(inner) => {
            match inner {
                Ok(s) => { got = s.len() }
                Err(code) => { got = code }
            }
        }
        None => { got = -3 }
    }
    assert_eq(got, 5)
}

// --- Result inner, Err arm binds the int payload ---
test "a nested match on push-built Result[Str,Int] binds the Err int payload" {
    let mut xs = []
    xs.push(Ok("beta"))
    xs.push(Err(9))
    let mut got = -1
    match xs.get(1) {
        Some(inner) => {
            match inner {
                Ok(s) => { got = s.len() }
                Err(code) => { got = code }
            }
        }
        None => { got = -3 }
    }
    assert_eq(got, 9)
}

// The nesting above is incidental — the minimal trigger is a SINGLE match over a
// push-built carrier value obtained by .unwrap(). The pointer-payload form (Str) fails
// only in codegen (binder spelled as the carrier struct); the scalar-payload form (Int)
// fails already at typecheck (binder typed as Option[Int]). Both are the same shallow peel.

test "a single match on a push-built Option[Str] from unwrap binds the str payload" {
    let mut xs = []
    xs.push(Some("hi"))
    xs.push(None)
    let o = xs.get(0).unwrap()
    let mut got = -1
    match o {
        Some(s) => { got = s.len() }
        None => { got = -2 }
    }
    assert_eq(got, 2)
}

test "a single match on a push-built Option[Int] from unwrap binds the int payload" {
    let mut xs = []
    xs.push(Some(7))
    xs.push(None)
    let o = xs.get(0).unwrap()
    let mut got = -1
    match o {
        Some(v) => { got = v }
        None => { got = -2 }
    }
    assert_eq(got, 7)
}

test "a single match on a push-built Result[Str,Int] from unwrap binds the Ok payload" {
    let mut xs = []
    xs.push(Ok("gamma"))
    xs.push(Err(2))
    let r = xs.get(0).unwrap()
    let mut got = -1
    match r {
        Ok(s) => { got = s.len() }
        Err(code) => { got = code }
    }
    assert_eq(got, 5)
}
