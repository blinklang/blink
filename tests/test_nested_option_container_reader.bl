// A List[Option[List[V]]] read with get/unwrap produces an Option[Option[List[V]]] whose
// deepest List element type must survive both carrier layers. The Option inner-tp reader is
// now tid-first: it peels every Option layer of the carrier tid down to the innermost
// container (here the inner List) and spells that from the authoritative tree, falling back
// to the flat pool only for a scalar/struct/Set floor. These shapes exercise the tid path
// directly — get into a nested-Option binder (round-trips through a let), and unwrap of the
// outer Option before the inner match. A regression in the peel-to-floor reader mis-spells
// the inner List and reads the wrong element or fails to compile.

// Str elements, not Int: a regression that erases the deepest List's element type would
// misread the boxed Str handle as a raw int and print garbage or crash, so these asserts
// actually catch element-type erasure — an Int-element test would decode to Int either way.

test "doubly nested get round-trips through both levels" {
    let mut pairs: List[Option[List[Str]]] = []
    let inner: List[Str] = ["a", "b", "c"]
    pairs.push(Some(inner))
    let x = pairs.get(0)
    match x {
        Some(ol) => {
            match ol {
                Some(l) => assert_eq(l.get(0).unwrap(), "a")
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "unwrap of Option[Option[List]] keeps the inner list element" {
    let mut pairs: List[Option[List[Str]]] = []
    let inner: List[Str] = ["x", "y"]
    pairs.push(Some(inner))
    let x = pairs.get(0)
    let y = x.unwrap()
    match y {
        Some(l) => assert_eq(l.get(1).unwrap(), "y")
        None => assert(false)
    }
}
