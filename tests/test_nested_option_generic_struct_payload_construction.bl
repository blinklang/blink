// Constructing a doubly-nested Option over a generic-struct instance
// (Some(Some(QBox{..}))) must keep each Option level typed correctly.

type QBox[T] { v: T }
fn f() -> Option[Option[QBox[Int]]] { Some(Some(QBox { v: 7 })) }

test "nested option construction over generic struct payload" {
    let a = f()
    assert_eq(a.is_none(), false)
    assert_eq(a.unwrap().unwrap().v, 7)
}
