// Constructing Option[Option[Map[Str, Int]]] via a directly let-annotated Some(Some(m))
// must heap-box each Option layer with its own carrier pointer type. codegen instead
// confuses the two boxing slots (_cbox_0 misassigned the bare blink_map* where a
// blink_Option_map is expected, and the outer box misassigned the whole
// blink_Option_Option_map struct where a blink_Option_map is expected), so cc fails
// with 'incompatible types when assigning'. Nested Option-of-container construction
// misses the heap-box that emit_boxed_container_store applies for map/list VALUES.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a directly let-annotated Some(Some(map)) boxes each Option layer correctly",
    reason: "nested Option-of-container construction (Option[Option[Map[Str,Int]]] via a direct let-annotated Some(Some(m))) misses the heap-box emit_boxed_container_store applies for map/list values, confusing the inner and outer carrier box slots so cc fails with incompatible types when assigning blink_map* / blink_Option_Option_map into a blink_Option_map slot",
    ticket: "39k365",
) {
    let src = #"
import std.io

fn main() ! IO {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 5)
    let wrapped: Option[Option[Map[Str, Int]]] = Some(Some(m))
    match wrapped {
        Some(inner) => match inner {
            Some(mm) => {
                let v = mm.get("k").unwrap()
                io.println("some {v}")
            }
            None => io.println("none-inner")
        }
        None => io.println("none-outer")
    }
}
"#
    let r = compile_and_run(src, "_nested_option_of_map_boxing")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "some 5\n")
}
