// rcedft: `Result[Option[T], E]` constructed via `Ok(Some(x))` must carry the
// inner Option as a structured `Option_int` ok member — not the lowercase
// erased `option` tag with `void ok`. Before the fix the construction path
// synthesized `blink_Result_option_str` with `void ok`, and the match Ok arm
// bound `void inner = _scrut.ok;`, so cc rejected the emitted C.
//
// This locks the round-trip: build the nested carrier, match it, and unwrap the
// inner Option — the inner value must survive to `42`.

test "nested result option" {
    let r: Result[Option[Int], Str] = Ok(Some(42))
    match r {
        Ok(inner) => { assert_eq(inner.unwrap(), 42) }
        Err(_e) => { assert(false) }
    }
}

// The Err construction of the SAME `Result[Option[Int], Str]` must emit the
// identical `blink_Result_Option_int_str` carrier — a mismatched typedef
// (`blink_Result_option_str`, `void ok`) would fail cc even though no Ok
// payload is present.
test "err construction of result option matches ok carrier" {
    let ok: Result[Option[Int], Str] = Ok(Some(7))
    let er: Result[Option[Int], Str] = Err("boom")
    match ok {
        Ok(inner) => { assert_eq(inner.unwrap(), 7) }
        Err(_e) => { assert(false) }
    }
    match er {
        Ok(_inner) => { assert(false) }
        Err(e) => { assert_eq(e, "boom") }
    }
}

// The compound side may be the Err side too: `Result[Int, Option[Str]]` must
// carry `blink_Option_str err` by value, for both Ok and Err construction.
test "result with compound err side" {
    let ok: Result[Int, Option[Str]] = Ok(1)
    let er: Result[Int, Option[Str]] = Err(Some("x"))
    match ok {
        Ok(v) => { assert_eq(v, 1) }
        Err(_e) => { assert(false) }
    }
    match er {
        Ok(_v) => { assert(false) }
        Err(e) => { assert_eq(e.unwrap(), "x") }
    }
}
