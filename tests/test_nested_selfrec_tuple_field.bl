// A variant field whose tuple embeds the enum through a NESTED tuple
// (`Node(p: (Int, (Box, Box)))`) is just as self-recursive as the direct
// `(Box, Box)` case: the mono carrier `Tuple2_Int_Tuple2_Box_Box` embeds
// `Tuple2_Box_Box` by value, which embeds `blink_Box` by value. The self-rec
// detector must descend into nested tuples so the field is boxed to int64_t and
// its carriers are emitted AFTER the enum — otherwise the carrier
// forward-references an undefined `blink_Box`. This is the nested-field tail of
// the e1f78s self-recursive-enum family (gjsr9e fixed the direct case).

import compile_test_helpers

fn src_nested_leaf() -> Str {
    #"import std.io

type Box { Node(p: (Int, (Box, Box))), Leaf(v: Int) }

fn main() {
    let b: Box = Box.Leaf(5)
    match b {
        Box.Leaf(v) => io.println("leaf {v}")
        Box.Node(p) => io.println("node {p.0}")
    }
}
"#
}

test "nested self-recursive tuple-field enum compiles and matches Leaf" {
    let r = compile_test_helpers.compile_and_run(src_nested_leaf(), "bxva7r_leaf")
    if !r.out.contains("leaf 5") {
        compile_test_helpers.expect_contains(r.out, "leaf 5", "nested selfrec tuple-field Leaf — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("leaf 5"))
    assert(!r.out.contains("node"))
    assert_eq(r.exit_code, 0)
}

fn src_nested_node() -> Str {
    #"import std.io

type Box { Node(p: (Int, (Box, Box))), Leaf(v: Int) }

fn main() {
    let l: Box = Box.Leaf(3)
    let r: Box = Box.Leaf(4)
    let root: Box = Box.Node((9, (l, r)))
    match root {
        Box.Leaf(v) => io.println("leaf {v}")
        Box.Node(p) => io.println("node {p.0}")
    }
}
"#
}

test "nested self-recursive tuple-field ctor boxes and matches the Node arm" {
    let r = compile_test_helpers.compile_and_run(src_nested_node(), "bxva7r_node")
    if !r.out.contains("node 9") {
        compile_test_helpers.expect_contains(r.out, "node 9", "nested selfrec tuple-field Node — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("node 9"))
    assert(!r.out.contains("leaf"))
    assert_eq(r.exit_code, 0)
}
