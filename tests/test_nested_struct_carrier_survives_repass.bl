// br 1452w4 (codegen-structured-tids, unblocks q4etvt). Re-passing cases that
// exercise the recursive tid path (tc_tid_inner_tag → tc_tid_struct_mono_name) and
// the generic-fn bare-typevar-return carrier recovery MORE THAN ONCE, plus two
// distinct struct-instance carriers (Result-of-Box + Option-of-Box) coexisting in
// one fn — each fails if any repass erases the struct's type-args to the bare head.
//
// Scope note: doubly-NESTED struct instances inside a compound
// (`Result[Box[Box[Int]], Str]`, `Option[Result[Box[Int], Str]]`) are a SEPARATE
// codegen gap (compound-inner member-pointer / field-access erasure at a second
// nesting level) that predates and is orthogonal to 1452w4 — tracked separately.
//
// Model: test_nss31w_* / test_bwyfy1_*.

type Box[T] {
    value: T
}

fn ident[T](v: T) -> T {
    v
}

test "Result[Box[Int], Str] survives a double round-trip" {
    let r: Result[Box[Int], Str] = Ok(Box { value: 13 })
    let r2 = ident(ident(r))
    assert_eq(r2.unwrap().value, 13)
}

test "Option[Box[Str]] survives a double round-trip" {
    let o: Option[Box[Str]] = Some(Box { value: "hi" })
    let o2 = ident(ident(o))
    assert_eq(o2.unwrap().value, "hi")
}

// Two distinct struct-instance carriers in one fn body must keep separate mono
// spellings (blink_Result_Box_Int_str vs blink_Option_Box_Int) — a shared erased
// head would collapse them.
test "Result-of-Box and Option-of-Box carriers coexist" {
    let r: Result[Box[Int], Str] = Ok(Box { value: 1 })
    let o: Option[Box[Int]] = Some(Box { value: 2 })
    assert_eq(ident(r).unwrap().value, 1)
    assert_eq(ident(o).unwrap().value, 2)
}
