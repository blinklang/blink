// A nested irrefutable pattern in a `let` binding, end to end: the names bind, the leaves
// carry their own types, and the values arrive in the right slots. §3.5 lists
// "Nested irrefutable: let ((x, y), label)" among the patterns a binding accepts.
//
// The companion test_typecheck_nested_tuple_let_binds_inner_leaves.bl asserts the front
// end alone. This one runs the program, so a projection that reads the wrong tuple slot
// is caught as a wrong value rather than passing as a well-typed binding.

fn labeled() -> ((Int, Int), Str) {
    ((3, 4), "point")
}

fn deep() -> ((Int, (Int, Str)), Int) {
    ((1, (2, "inner")), 5)
}

fn pairs() -> (Int, (Str, Int)) {
    (7, ("eight", 9))
}

test "a nested tuple let binds the inner leaves to the right values" {
    let ((x, y), label) = labeled()
    assert_eq(x, 3)
    assert_eq(y, 4)
    assert(label == "point")
}

test "a leaf two levels deep gets its own value" {
    let ((a, (b, c)), d) = deep()
    assert_eq(a, 1)
    assert_eq(b, 2)
    assert(c == "inner")
    assert_eq(d, 5)
}

test "a nested pattern in the last position projects from the right slot" {
    let (first, (word, last)) = pairs()
    assert_eq(first, 7)
    assert(word == "eight")
    assert_eq(last, 9)
}

test "a wildcard beside a named leaf drops only its own slot" {
    let ((x, _), label) = labeled()
    assert_eq(x, 3)
    assert(label == "point")
}

test "mut on a destructuring let makes a nested leaf assignable" {
    let mut ((x, y), label) = labeled()
    x = 30
    assert_eq(x, 30)
    assert_eq(y, 4)
    assert(label == "point")
}

test "a flat destructuring let still binds its leaves" {
    let (pair, label) = labeled()
    let (x, y) = pair
    assert_eq(x, 3)
    assert_eq(y, 4)
    assert(label == "point")
}
