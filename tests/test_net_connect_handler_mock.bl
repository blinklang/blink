// The mock_net example of sections/04_effects.md §4.7.1 (derived operations). The innermost
// Net.Connect handler omits `get`, so the `get` body from the effect declaration runs and its
// `net.request` reaches that same handler. The outer handler's `get` clause never runs.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a Net.Connect mock that implements only request answers net.get, and an outer get clause does not run",
    reason: "Net.Connect has no request operation, no Request or Response type and no derived verbs yet; net.* calls are runtime socket calls that no handler can intercept",
) {
    let src = #"
import std.net.{NetError}

fn mock_net(responses: Map[Str, Str]) -> Handler[Net.Connect] {
    handler Net.Connect {
        fn request(req: Request) -> Result[Response, NetError] {
            match responses.get(req.url) {
                Some(body) => Ok(Response { status: 200, body: body, headers: Map.new() })
                None => Err(NetError.ConnectionRefused("mock: no response for {req.url}"))
            }
        }
    }
}

fn logging_get() -> Handler[Net.Connect] {
    handler Net.Connect {
        fn get(url: Str) -> Result[Response, NetError] {
            io.println("GET {url}")
            default.get(url)
        }
    }
}

fn main() ! Net, IO {
    let mut responses: Map[Str, Str] = Map.new()
    responses.insert("https://example.com", "hello")
    with logging_get() {
        with mock_net(responses) {
            let r = net.get("https://example.com").unwrap()
            io.println("{r.status} {r.body}")
        }
    }
}
"#
    let r = compile_and_run(src, "_net_connect_handler_mock")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "200 hello\n")
}
