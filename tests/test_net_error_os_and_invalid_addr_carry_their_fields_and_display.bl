// NetError.Os carries the name of the socket call and its Errno, so a caller can match on
// the errno value; NetError.InvalidAddr carries the address string as given.
import std.net.{NetError, net_error_display}
import std.errno.{Errno}
import std.libc.{ERR_ADDRINUSE}

fn bind_in_use() -> NetError {
    NetError.Os(op: "bind", code: Errno(ERR_ADDRINUSE))
}

test "Os keeps the call name and the errno code" {
    match bind_in_use() {
        NetError.Os(op, code) => {
            assert_eq(op, "bind")
            match code {
                Errno(c) => assert_eq(c, ERR_ADDRINUSE)
            }
        }
        _ => assert(false)
    }
}

test "Os displays the call name and the errno message" {
    let text = net_error_display(bind_in_use())
    assert(text.starts_with("bind: "))
    assert(text.len() > "bind: ".len())
}

test "InvalidAddr keeps the input and displays it" {
    let e = NetError.InvalidAddr(input: "10.0.0.300:53")
    match e {
        NetError.InvalidAddr(input) => assert_eq(input, "10.0.0.300:53")
        _ => assert(false)
    }
    assert_eq(net_error_display(e), "invalid_addr: 10.0.0.300:53")
}
