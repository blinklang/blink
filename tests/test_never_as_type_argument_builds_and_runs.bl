// `Never` is a type argument like any other (§3.2), so a value whose type holds it builds and
// runs. No value of type Never exists, so the arm that would bind one never runs, and its
// binder is a value of every type: the §3.2 match rewrite re-wraps `Result[Int, Never]` as
// `Result[Int, Str]` this way.

fn ok_payload() -> Int {
    let r: Result[Int, Never] = Ok(3)
    match r {
        Ok(v) => v
        Err(e) => e
    }
}

fn rewrapped() -> Result[Int, Str] {
    let r: Result[Int, Never] = Ok(4)
    match r {
        Ok(v) => Ok(v)
        Err(e) => e
    }
}

fn none_of_never() -> Int {
    let o: Option[Never] = None
    match o {
        Some(n) => n
        None => 5
    }
}

test "a Result with a Never error builds and its Ok arm runs" {
    assert_eq(ok_payload(), 3)
}

test "the match rewrite turns Result[Int, Never] into Result[Int, Str]" {
    assert_eq(rewrapped().unwrap(), 4)
}

test "an Option[Never] is always None" {
    assert_eq(none_of_never(), 5)
}

test "an empty List[Never] has length zero" {
    let xs: List[Never] = []
    assert_eq(xs.len(), 0)
}
