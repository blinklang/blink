// `module.name` read as a value resolves the same way as the call form, so a name the module does
// not have gets the same report (section 6.3.3).

import compile_test_helpers

let HELPER = "pub fn inc(x: Int) -> Int \{ x + 1 }\nfn secret(x: Int) -> Int \{ x }\npub type Color \{ Red, Blue }\npub let K = 3\n"

fn no_member(body: Str, tag: Str) ! Process.Spawn, FS.Write, FS.Read, FS.Delete, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ {body} }\n", "nmv", HELPER, tag)
    compile_test_helpers.expect_contains(out, "UnresolvedMethod", tag)
    compile_test_helpers.expect_contains(out, "no member `nope` on module `nmv`", tag)
    assert(!out.contains("internal compiler error"), out)
    assert_eq(out.split("no member `nope`").len(), 2)
}

test "the call form and the value forms report the same" {
    no_member("nmv.nope(1)", "nmv_call")
    no_member("let f = nmv.nope\n f(1)", "nmv_let")
    no_member("let _ = [1].map(nmv.nope)", "nmv_map")
    no_member("let _ = [1].filter(nmv.nope)", "nmv_filter")
    no_member("let _ = [1].fold(0, nmv.nope)", "nmv_fold")
    no_member("let _ = [1].into_iter().map(nmv.nope).collect()", "nmv_it_map")
}

test "a near name is suggested" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let f = nmv.inx\n f(1) }\n", "nmv", HELPER, "nmv_near")
    compile_test_helpers.expect_contains(out, "did you mean `nmv.inc`?", "nmv_near")
}

test "a member the module has is not reported" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let f = nmv.inc\n io.println(\"\{f(nmv.K)}\") }\n", "nmv", HELPER, "nmv_ok")
    assert(!out.contains("no member"), out)
}

test "a private member keeps its own report" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let _ = nmv.secret }\n", "nmv", HELPER, "nmv_private")
    compile_test_helpers.expect_contains(out, "PrivateItemAccess", "nmv_private")
    assert(!out.contains("no member"), out)
}

test "a type qualified through its module keeps its own report" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let _ = nmv.Color.Red }\n", "nmv", HELPER, "nmv_type")
    compile_test_helpers.expect_contains(out, "ModuleQualifiedType", "nmv_type")
    assert(!out.contains("no member"), out)
}
