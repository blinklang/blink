// `module.name` read as a value resolves the same way as the call form, so a name the module does
// not have gets the same report (section 6.3.3).

import compile_test_helpers

let HELPER = "pub fn inc(x: Int) -> Int \{ x + 1 }\nfn secret(x: Int) -> Int \{ x }\npub type Color \{ Red, Blue }\npub let K = 3\npub effect Lg\n"

fn no_member(body: Str, tag: Str) ! Process.Spawn, FS.Write, FS.Read, FS.Delete, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ {body} }\n", "nmv", HELPER, tag)
    compile_test_helpers.expect_contains(out, "UnresolvedMethod", tag)
    compile_test_helpers.expect_contains(out, "no member `nope` on module `nmv`", tag)
    assert(!out.contains("internal compiler error"), out)
    assert_eq(out.split("no member `nope`").len(), 2)
}

test "the call form and the value forms report the same" {
    no_member("nmv.nope(1)", "nmv_call")
    no_member("let f = nmv.nope\n f(1)", "nmv_let")
    no_member("let _ = [1].map(nmv.nope)", "nmv_map")
    no_member("let _ = [1].filter(nmv.nope)", "nmv_filter")
    no_member("let _ = [1].fold(0, nmv.nope)", "nmv_fold")
    no_member("let _ = [1].into_iter().map(nmv.nope).collect()", "nmv_it_map")
}

test "a near name is suggested" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let f = nmv.inx\n f(1) }\n", "nmv", HELPER, "nmv_near")
    compile_test_helpers.expect_contains(out, "did you mean `nmv.inc`?", "nmv_near")
}

test "a member the module has is not reported" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let f = nmv.inc\n io.println(\"\{f(nmv.K)}\") }\n", "nmv", HELPER, "nmv_ok")
    compile_test_helpers.expect_compiles_clean(out, "nmv_ok")
}

test "a private member keeps its own report" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let _ = nmv.secret }\n", "nmv", HELPER, "nmv_private")
    compile_test_helpers.expect_contains(out, "PrivateItemAccess", "nmv_private")
    assert(!out.contains("no member"), out)
}

test "a type qualified through its module keeps its own report" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nfn main() \{ let _ = nmv.Color.Red }\n", "nmv", HELPER, "nmv_type")
    compile_test_helpers.expect_contains(out, "ModuleQualifiedType", "nmv_type")
    assert(!out.contains("no member"), out)
}

fn no_value(body: Str, tag: Str, want: Str) ! Process.Spawn, FS.Write, FS.Read, FS.Delete, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nimport std.fs\nfn main() \{ {body} }\n", "nmv", HELPER, tag)
    compile_test_helpers.expect_contains(out, want, tag)
    assert(!out.contains("no member"), out)
    assert(!out.contains("did you mean"), out)
    assert(!out.contains("internal compiler error"), out)
}

test "a built-in call read as a value says so and does not say the module lacks it" {
    no_value("let _ = fs.write", "nmv_fs_write", "`fs.write` is a built-in call and cannot be read as a value")
    no_value("let _ = [\"p\"].map(fs.read)", "nmv_fs_read", "`fs.read` is a built-in call and cannot be read as a value")
}

// A built-in's arity varies, so the help must not write a closure that does not compile for it.
test "the built-in help writes no closure of a fixed arity" {
    let out = compile_test_helpers.compile_xmod_capture("import nmv\nimport std.fs\nfn main() \{ let _ = fs.write }\n", "nmv", HELPER, "nmv_fs_help")
    compile_test_helpers.expect_contains(out, "wrap the call in a closure", "nmv_fs_help")
    assert(!out.contains("fn(x)"), out)
}

test "an import alias spelled like a built-in namespace names the module it binds" {
    let a = compile_test_helpers.compile_xmod_capture("import nmv as net\nfn main() \{ let _ = net.connect }\n", "nmv", HELPER, "nmv_alias_net")
    compile_test_helpers.expect_contains(a, "no member `connect` on module `net`", "nmv_alias_net")
    assert(!a.contains("built-in call"), a)
    let b = compile_test_helpers.compile_and_capture("import std.json as io\nfn main() \{ let _ = io.println }\n", "nmv_alias_io")
    compile_test_helpers.expect_contains(b, "no member `println` on module `io`", "nmv_alias_io")
    assert(!b.contains("built-in call"), b)
}

test "an effect read as a value does not suggest its own name" {
    no_value("let _ = nmv.Lg", "nmv_effect", "`nmv.Lg` cannot be read as a value")
}

test "a namespace with no import keeps its own report" {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let _ = io.println }\n", "nmv_io")
    compile_test_helpers.expect_contains(out, "`io` is a built-in namespace", "nmv_io")
    assert(!out.contains("no member"), out)
}

test "a local that hides the module reads its own field" {
    let src = "import nmv\ntype Nh \{ nope: Int }\nfn main() \{ let nmv = Nh \{ nope: 1 }\n let _ = nmv.nope }\n"
    compile_test_helpers.expect_compiles_clean(compile_test_helpers.compile_xmod_capture(src, "nmv", HELPER, "nmv_hide"), "nmv_hide")
}

test "a file that does not import the qualifier gets one undefined name" {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let _ = nmv.nope }\n", "nmv_no_import")
    compile_test_helpers.expect_contains(out, "UndefinedVariable", "nmv_no_import")
    assert(!out.contains("no member"), out)
}

test "a member read through an alias looks in the module the alias binds" {
    let a = compile_test_helpers.compile_xmod_capture("import nmv as q\nfn main() \{ let _ = q.Lg }\n", "nmv", HELPER, "nmv_alias_effect")
    compile_test_helpers.expect_contains(a, "`q.Lg` cannot be read as a value", "nmv_alias_effect")
    assert(!a.contains("no member"), a)
    let b = compile_test_helpers.compile_xmod_capture("import nmv as q\nfn main() \{ let _ = q.inx }\n", "nmv", HELPER, "nmv_alias_near")
    compile_test_helpers.expect_contains(b, "did you mean `q.inc`?", "nmv_alias_near")
}

test "an alias spelled like another import's module does not get that module's help" {
    let src = "import std.json as fs\nimport nmv\nfn main() \{ let _ = fs.Write\n nmv.inc(1) }\n"
    let helper = "import std.fs\npub fn inc(x: Int) -> Int \{ x + 1 }\n"
    let out = compile_test_helpers.compile_xmod_capture(src, "nmv", helper, "nmv_alias_other")
    compile_test_helpers.expect_contains(out, "no member `Write` on module `fs`", "nmv_alias_other")
    assert(!out.contains("cannot be read as a value"), out)
}
