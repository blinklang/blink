// The node-tid memo answers a TYPE or nothing. It never answers "Unknown".
//
// tc_publish_node_tid already states the contract in its own comment: "Writes nothing
// for an unknown or absent type, so the memo's '-1 means nobody has typed this'
// contract holds and a caller cannot mistake a published UNKNOWN for an answer."
// infer_type is the memo's OTHER writer, and it did not hold to that: on the first
// inference of a node it wrote whatever infer_type_uncached answered, including the
// shared TYPE_UNKNOWN singleton.
//
// TYPE_UNKNOWN is a real, in-range pool index, so a slot holding it reads as an ANSWER
// to every `tid >= 0` gate downstream while meaning "inference gave up". That is the
// one state the memo must not be able to represent: a reader that wants to know
// whether anybody typed this node has no way to tell the give-up from a type.
//
// The sweep below is over every node of a compiled program, not a hand-picked one, so
// a future arm that answers Unknown on a new shape fails here instead of quietly
// re-poisoning the memo.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_unknown_tid}
import parser.{nodes, node_kind, node_line, node_col}
import ast.{NodeKind, node_kind_name}
import std.io
// Bare and LOAD-BEARING despite `warning[UnusedImport]`: codegen_types resolves several
// globals it cannot import out of the MERGED program, and codegen_expr is the smallest
// root whose transitive closure closes those back-references.
import codegen_expr

// Count the nodes whose memo slot holds the TYPE_UNKNOWN singleton, printing the first
// few so a failure names the shape that re-poisoned the memo rather than only a count.
fn unknown_memo_count(path: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, TypeCheck.Resolve, TypeCheck.Report, FS {
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    let unk = tc_unknown_tid()
    let mut hits = 0
    let mut shown = 0
    let mut i = 0
    while i < nodes.len() {
        if tc_lookup_node_tid(i) == unk {
            hits = hits + 1
            if shown < 8 {
                io.println("  UNKNOWN memo: node {i} kind={node_kind_name(node_kind(i))} at {node_line(i)}:{node_col(i)}")
                shown = shown + 1
            }
        }
        i = i + 1
    }
    let _ = fs.delete(path)
    hits
}

// A program with the shapes that reach the give-up arms: a namespace method call whose
// receiver is not a type (io.println), a bare module ident, a field access, a match with
// a diverging arm, and a tail loop.
fn broad_src() -> Str {
    #"type Point { x: Int, y: Int }

fn pick(o: Option[Int]) -> Int {
    match o {
        Some(v) => v
        None => return 0
    }
}

fn scan(n: Int) -> Int {
    loop {
        if n > 0 {
            return n
        }
        return 0
    }
}

fn main() {
    let p = Point { x: 1, y: 2 }
    io.println("{p.x}{p.y}")
    io.println("{pick(Some(3))}")
    io.println("{scan(4)}")
    let xs = [1, 2, 3]
    io.println("{xs.len()}")
}
"#
}

test "no node's memo slot holds the TYPE_UNKNOWN singleton" {
    let hits = unknown_memo_count("build/memo_unk_broad.bl", broad_src())
    if hits != 0 { io.println("FAIL: {hits} node(s) memoized as TYPE_UNKNOWN") }
    assert(hits == 0)
}

// The same sweep over a program built only from give-up shapes: an else-less `if` used
// as a statement, a handler value, a nested closure, and a qualified call.
fn odd_src() -> Str {
    #"fn main() {
    let flag = true
    if flag {
        io.println("yes")
    }
    let f = fn(x: Int) { io.println("{x}") }
    f(1)
    let ys = [1].map(fn(x) { x * 2 })
    io.println("{ys.len()}")
}
"#
}

test "the sweep also holds for statement-position and closure shapes" {
    let hits = unknown_memo_count("build/memo_unk_odd.bl", odd_src())
    if hits != 0 { io.println("FAIL: {hits} node(s) memoized as TYPE_UNKNOWN") }
    assert(hits == 0)
}
