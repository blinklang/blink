// Inference must answer a type or report; it must never hand back "unknown" and let the
// mistake travel. Three arms used to fall through silently, so a settled, obviously-wrong
// operand reached codegen and was reported — if at all — in C's vocabulary rather than
// Blink's.
//
// CALLING A NON-FUNCTION. `let x = 1` followed by `x()` found `x` in scope, saw its type was
// not a function, inferred the arguments for their own sake, and answered unknown.
//
// AWAITING A NON-HANDLE. `.await` unwraps Handle[T]. On anything else the arm fell through,
// so `1.await` typed as unknown and unified with whatever the binding wanted.
//
// scope.take WITH NO ARGUMENT. Like the other built-in arity holes, the argument check
// validated argument 0 only when argument 0 was present.
//
// Each row's control proves the gate still admits the correct spelling — a check that also
// rejects valid code would pass the error rows for the wrong reason.
import compile_test_helpers

// ── calling a value that is not a function ──────────────────────────────────
test "calling a non-function local is reported" {
    let src = #"fn main() ! IO {
    let x = 1
    let y = x()
    io.println("{y}")
}
"#
    compile_test_helpers.expect_compile_error(src, "operand_call_non_fn", "E0300")
}

test "calling a closure-typed local still type-checks" {
    let src = #"fn main() ! IO {
    let f = fn() -> Int { 1 }
    let y = f()
    io.println("{y}")
}
"#
    compile_test_helpers.expect_no_error(src, "operand_call_closure_ok", "E0300")
}

// ── awaiting a value that is not a Handle ───────────────────────────────────
test "awaiting a non-Handle is reported" {
    let src = #"fn main() ! IO {
    let n = 1
    let r = n.await
    io.println("{r}")
}
"#
    compile_test_helpers.expect_compile_error(src, "operand_await_non_handle", "E0300")
}

test "awaiting a spawned handle still type-checks" {
    let src = #"fn main() ! IO {
    async.scope {
        let h = async.spawn(fn() {
            42
        })
        let r = h.await
        io.println("{r}")
    }
}
"#
    compile_test_helpers.expect_no_error(src, "operand_await_handle_ok", "E0300")
}

// ── scope.take arity ────────────────────────────────────────────────────────
test "scope.take with no argument is reported" {
    let src = #"fn main() ! IO {
    with ffi.scope() as scope {
        let p = scope.take()
        io.println("{p.addr()}")
    }
}
"#
    compile_test_helpers.expect_compile_error(src, "operand_take_arity", "E0300")
}

test "scope.take over an allocated Ptr still type-checks" {
    let src = #"fn main() ! IO {
    with ffi.scope() as scope {
        let p: Ptr[Int] = scope.alloc()
        let q = scope.take(p)
        io.println("{q.addr()}")
    }
}
"#
    compile_test_helpers.expect_no_error(src, "operand_take_ok", "E0300")
}
