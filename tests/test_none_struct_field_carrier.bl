type Box {
    v: Option[Str] = None
    n: Option[Int] = None
}

test "bare None struct field infers declared Option[Str] carrier" {
    let b = Box { v: None, n: None }
    assert_eq(b.v.is_none(), 1)
    assert_eq(b.n.is_none(), 1)
}

test "Some struct field round-trips with declared carrier" {
    let b = Box { v: Some("hello"), n: Some(42) }
    assert_eq(b.v.unwrap(), "hello")
    assert_eq(b.n.unwrap(), 42)
}

test "defaulted None struct fields adopt declared carrier" {
    let b = Box {}
    assert_eq(b.v.is_none(), 1)
    assert_eq(b.n.is_none(), 1)
}

test "mixed provided and defaulted None fields" {
    let b = Box { v: Some("x") }
    assert_eq(b.v.unwrap(), "x")
    assert_eq(b.n.is_none(), 1)
}
