// A non-generic enum's variant payload whose type is a generic-struct
// instance (Box[Int]) must spell that instance's mono stem in the union
// member, the same as the match binder that reads it back does.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a non-generic enum's variant payload keeps the generic-struct instance's mono stem",
    reason: "emit_enum_typedef's non-generic variant-payload branch spells the bare base type instead of recovering the mono stem, so the union member and the match binder disagree and cc fails",
    ticket: "1q03v0",
) {
    let src = #"
import std.io

type Box[T] { val: T }
type E {
    Wrap(b: Box[Int])
    Empty
}

fn f() -> Int {
    let e = E.Wrap(Box { val: 5 })
    match e {
        E.Wrap(b) => b.val
        E.Empty => 0
    }
}

fn main() ! IO {
    io.println("{f()}")
}
"#
    let r = compile_and_run(src, "_nongeneric_enum_variant_generic_struct_payload")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}
