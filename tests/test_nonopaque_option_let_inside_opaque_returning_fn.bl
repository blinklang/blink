// A non-opaque Option let-target inside a fn that itself returns
// Option[@ffi.opaque] must keep its own tagged carrier. The Some-opaque
// resolution must not fall through to the enclosing fn's opaque-Option
// channel just because the fn signature mentions an opaque handle.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a non-opaque Option let inside an opaque-returning fn keeps its tagged carrier",
    reason: "emit_call's Some-opaque resolution falls through to option_inner_struct_from_fn (the enclosing fn's opaque-Option return channel) even when the let-target annotation says the inner is non-opaque, so cc rejects the resulting scalar initializer against the tagged carrier type",
    ticket: "0h1mqk",
) {
    let src = #"
import std.io

@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile

fn f() -> Option[CFile] {
    let x: Option[Int] = Some(5)
    if x.is_some() {
        io.println("x is some")
    }
    None
}

fn main() ! IO {
    let r = f()
    if r.is_none() {
        io.println("r is none")
    }
}
"#
    let r = compile_and_run(src, "_nonopaque_option_let_inside_opaque_returning_fn")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "x is some\nr is none\n")
}
