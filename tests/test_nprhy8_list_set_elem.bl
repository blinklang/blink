// nprhy8: List[Set[T]] element codegen — every seam that binds a Set out of a
// List (or a List of Sets) must carry the Set's OWN element type, not fabricate
// one and not misread the outer CT_SET as its own element.
//
// Root cause (see the full triage in the nprhy8 plan): get_set_elem_type used to
// fabricate CT_STRING for "element unknown" (src/codegen_types.bl's sv_tp CT_SET
// arm), and emit_list_method had NO get/pop CT_SET arm at all — codegen_methods.bl's
// dispatch fell through to plain int64 boxing for any CT not in the
// VOID/STRUCT/ENUM/STRING/FLOAT/LIST/MAP/OPTION/RESULT list. So
// `for x in d.get(0).unwrap()` on a `List[Set[Int]]` either ICE'd (loud) or,
// worse, silently boxed a `blink_set*` pointer where an `Int` element was
// expected (silent miscompile — no diagnostic).
//
// Fix landed in three stages:
//   Stage A — typecheck already resolves every Set's element via HM metavar
//     inference; codegen now reads that tid instead of guessing. Unknown-element
//     consumers (for-in's CT_SET normalizer) fail loud (I0002 ICE), never fabricate.
//   Stage B.6/7 — real `get`/`pop` CT_SET arms in emit_list_method, keyed off
//     get_var_option_inner2/_struct (NOT the global expr_option_inner_list_elem
//     channel — that's CT_LIST-only, and contaminating it would leak a Set's
//     element onto an unrelated later List binding).
//   Stage B.9 — all five Option->Set binding seams (.unwrap(), `let o = d.get(0)`,
//     `match Some(s)`, re-reading the Option var, `??`) carry the element forward.
//   Stage B.10 — recover_list_elem_from_tid (the monomorphized-struct-field path,
//     shared with br jcr0zz) gained a real CT_SET arm.
//   Stage B.11 — both inferred-shape producers (`d.push(s)` and the list literal
//     `[s]`) stamp the Set's element onto the LIST var so later reads have
//     something to recover.
//
// Rows are deliberately element-sensitive on an Int-element Set — `.len()` and
// `Set[Str]` alone can't distinguish a real element from a fabricated default
// (that's exactly why the pre-nprhy8 test suite missed this hole); every row here
// either sums/reads back a concrete Int (or, for the struct-element row, a field)
// through the seam under test.

import compile_test_helpers
import std.io

fn assert_has(c: Str, needle: Str, label: Str) {
    if !c.contains(needle) { io.println("FAIL: {label} — missing '{needle}'") }
    assert(c.contains(needle))
}

// Row 1: `.get(0).unwrap()` + for-in sum — the .unwrap() seam (Stage B.9), also
// acw3q3's construct (for-in over an Option-unwrapped Set).
fn src_row1() -> Str {
    "fn main() ! IO \{\n"
        .concat("    let mut s = Set()\n")
        .concat("    s.insert(3)\n")
        .concat("    s.insert(4)\n")
        .concat("    s.insert(5)\n")
        .concat("    let mut d = []\n")
        .concat("    d.push(s)\n")
        .concat("    let mut total = 0\n")
        .concat("    for x in d.get(0).unwrap() \{ total = total + x }\n")
        .concat("    io.println(\"total=\{total}\")\n")
        .concat("}\n")
}

test "row 1: for x in d.get(0).unwrap() sums the Set's real Int element" {
    let r = compile_test_helpers.compile_and_run(src_row1(), "nprhy8_row1")
    if r.exit_code != 0 { io.println("FAIL: row1 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains("total=12"))
}

// Row 2: .contains() element-sensitive — proves the recovered element is
// genuinely Int (a Str-fabricated default would either mistype or accept the
// wrong value).
// Annotated (not inferred) per sq16v7: an unannotated `let mut s = Set()` /
// `let mut d = []` here binds s/d's element as an HM metavar, and
// got.contains(N)'s arg-check reads that metavar's OWN (unresolved) tid
// instead of resolving it first (missing tc_resolve at typecheck.bl:8232) --
// it misreads the bound metavar's solution pointer (the whole Set[Int]) as
// the element (Int), producing a false TypeError on a correct program. Not
// this ticket's concern -- sq16v7 tracks the fix, 7dcwvz tracks removing
// this annotation once it lands. Explicit annotations sidestep the bug
// (annotated types are concrete tids from the start, never metavars), so
// this row still exercises the codegen seam (Stage B.9's `.unwrap()` seam)
// nprhy8 actually owns.
fn src_row2() -> Str {
    "fn main() ! IO \{\n"
        .concat("    let mut s: Set[Int] = Set()\n")
        .concat("    s.insert(1)\n")
        .concat("    let mut d: List[Set[Int]] = []\n")
        .concat("    d.push(s)\n")
        .concat("    let got = d.get(0).unwrap()\n")
        .concat("    io.println(\"has1=\{got.contains(1)} has9=\{got.contains(9)}\")\n")
        .concat("}\n")
}

test "row 2: .get(0).unwrap().contains(1)/!contains(9) proves the element is Int" {
    let r = compile_test_helpers.compile_and_run(src_row2(), "nprhy8_row2")
    if r.exit_code != 0 { io.println("FAIL: row2 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains("has1=true has9=false"))
}

// Row 3: `.pop()` — the second reader family, independent of `.get`.
fn src_row3() -> Str {
    "fn main() ! IO \{\n"
        .concat("    let mut s = Set()\n")
        .concat("    s.insert(6)\n")
        .concat("    s.insert(7)\n")
        .concat("    let mut d = []\n")
        .concat("    d.push(s)\n")
        .concat("    let popped = d.pop().unwrap()\n")
        .concat("    let mut total = 0\n")
        .concat("    for x in popped \{ total = total + x }\n")
        .concat("    io.println(\"total=\{total}\")\n")
        .concat("}\n")
}

test "row 3: .pop().unwrap() carries the Set's Int element" {
    let r = compile_test_helpers.compile_and_run(src_row3(), "nprhy8_row3")
    if r.exit_code != 0 { io.println("FAIL: row3 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains("total=13"))
}

// Row 4: `for inner in d` — 7b1t5a's control construct (direct List[Set[Int]]
// iteration, no Option unwrap in the path at all).
fn src_row4() -> Str {
    "fn main() ! IO \{\n"
        .concat("    let mut s = Set()\n")
        .concat("    s.insert(2)\n")
        .concat("    s.insert(9)\n")
        .concat("    let mut d = []\n")
        .concat("    d.push(s)\n")
        .concat("    let mut total = 0\n")
        .concat("    for inner in d \{\n")
        .concat("        for x in inner \{ total = total + x }\n")
        .concat("    }\n")
        .concat("    io.println(\"total=\{total}\")\n")
        .concat("}\n")
}

test "row 4: for inner in d (List[Set[Int]]) iterates without an Option seam" {
    let r = compile_test_helpers.compile_and_run(src_row4(), "nprhy8_row4")
    if r.exit_code != 0 { io.println("FAIL: row4 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains("total=11"))
}

// Row 5: inferred list literal `[s]` producer (Stage B.11's list-literal half).
fn src_row5() -> Str {
    "fn main() ! IO \{\n"
        .concat("    let mut s = Set()\n")
        .concat("    s.insert(3)\n")
        .concat("    s.insert(4)\n")
        .concat("    s.insert(5)\n")
        .concat("    let d = [s]\n")
        .concat("    let mut total = 0\n")
        .concat("    for x in d.get(0).unwrap() \{ total = total + x }\n")
        .concat("    io.println(\"total=\{total}\")\n")
        .concat("}\n")
}

test "row 5: let d = [s] (list literal) carries the Set's element" {
    let r = compile_test_helpers.compile_and_run(src_row5(), "nprhy8_row5")
    if r.exit_code != 0 { io.println("FAIL: row5 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains("total=12"))
}

// Row 6: inferred `let d = []; d.push(s)` producer (Stage B.11's push half).
fn src_row6() -> Str {
    "fn main() ! IO \{\n"
        .concat("    let mut s = Set()\n")
        .concat("    s.insert(3)\n")
        .concat("    s.insert(4)\n")
        .concat("    s.insert(5)\n")
        .concat("    let mut d = []\n")
        .concat("    d.push(s)\n")
        .concat("    let mut total = 0\n")
        .concat("    for x in d.get(0).unwrap() \{ total = total + x }\n")
        .concat("    io.println(\"total=\{total}\")\n")
        .concat("}\n")
}

test "row 6: let d = []; d.push(s) carries the Set's element" {
    let r = compile_test_helpers.compile_and_run(src_row6(), "nprhy8_row6")
    if r.exit_code != 0 { io.println("FAIL: row6 runtime — {r.err_out}") }
