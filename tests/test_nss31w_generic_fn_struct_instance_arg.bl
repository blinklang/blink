// Bug nss31w (codegen-structured-tids gate, epic 4y09cs / project nqq29j). A
// generic FREE FN `identity[T](x: T)` called with a concrete struct-INSTANCE arg
// `Box[Int]` mangled to `blink_identity_Box` / `blink_Box` (the never-typedef'd
// bare head) instead of `blink_identity_Box_Int` / `blink_Box_Int`, so the
// emitted C failed to compile ("unknown type name 'blink_Box'").
//
// Root cause: the tid path over-reached IN the deletion gate. tc_tid_encodable
// only deferred MODULE-QUALIFIED struct/enum, so a bare unqualified struct
// INSTANCE (params_count>0, e.g. Box[Int]) passed as encodable; tc_tid_to_c_tag
// then erased its type-args to the bare head `Box`. The stricter
// tc_struct_slot_encodable already rejects params_count != 0 for struct SLOTS —
// this fix mirrors that guard onto tc_tid_encodable so a struct/enum INSTANCE
// defers to the string inference path (infer_fn_type_args_from_types), which
// resolves the arg to its already-registered Box_Int mono name.
//
// This is the by-value-argument path that test_qw7v90_* deliberately kept its
// guards OFF of (see its header) precisely because nss31w / wme0hh were open.
// A bare monomorphic struct (Point) and List[Int] already worked; the fix
// touches only the struct-INSTANCE-with-type-args case.

type Box[T] {
    value: T
}

type Point {
    x: Int
    y: Int
}

fn identity[T](x: T) -> T {
    x
}

test "generic fn called with Box[Int] instance preserves type-args" {
    let b = Box { value: 42 }
    let b2 = identity(b)
    assert_eq(b2.value, 42)
}

test "generic fn called with Box[Str] instance stays on Str path" {
    let b = Box { value: "boxed" }
    let b2 = identity(b)
    assert_eq(b2.value, "boxed")
}

test "generic fn with a monomorphic struct arg still works" {
    let p = Point { x: 3, y: 4 }
    let p2 = identity(p)
    assert_eq(p2.x, 3)
    assert_eq(p2.y, 4)
}

test "generic fn with a plain Int arg is undisturbed" {
    let n = identity(99)
    assert_eq(n, 99)
}
