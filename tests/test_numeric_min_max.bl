// `min` and `max` on each sized integer (sections/03_types.md, the sized integer method
// table), on Float (§3.2.6 Float Math) and on Int. No table gives Int these methods, but the
// spec uses them: the Pad rule in sections/03_types.md writes `w.max(s.len())` on Int. Float
// uses the total order, not C's fmin/fmax: NaN is greater than every other value, -0.0
// equals 0.0, and a tie returns the receiver.

// Built at run time, so no row is a literal the front end could fold.
fn zero() -> Float { 0.0 }

fn nan() -> Float { zero() / zero() }

fn inf() -> Float { 1.0 / zero() }

fn neg_zero() -> Float { zero() * -1.0 }

// IEEE equality, under which NaN alone is unequal to itself. The total order's `==` cannot
// tell a NaN apart.
fn is_nan(x: Float) -> Bool { !x.ieee_eq(x) }

test "Int min and max pick the smaller and the larger" {
    assert_eq(3.max(4), 4)
    assert_eq(4.max(3), 4)
    assert_eq(3.min(4), 3)
    assert_eq(4.min(3), 3)
    assert_eq(5.max(5), 5)
    assert_eq(5.min(5), 5)
}

test "Int min and max order negative values" {
    assert_eq((-3).max(-7), -3)
    assert_eq((-3).min(-7), -7)
    assert_eq((-1).max(0), 0)
    assert_eq((-1).min(0), -1)
    let x = -42
    assert_eq(x.max(0), 0)
    assert_eq(x.min(0), -42)
}

test "Int min and max hold at the bounds" {
    let lo = -9223372036854775807 - 1
    let hi = 9223372036854775807
    assert_eq(lo.max(hi), hi)
    assert_eq(lo.min(hi), lo)
    assert_eq(hi.min(lo), lo)
    assert_eq(hi.max(lo), hi)
    assert_eq(lo.max(lo), lo)
    assert_eq(hi.min(0), 0)
    assert_eq(lo.max(0), 0)
}

test "Int min and max chain" {
    assert_eq(15.max(0).min(10), 10)
    assert_eq((-5).max(0).min(10), 0)
}

test "signed sized integers order negative values and their bounds" {
    let a: I8 = -128
    let b: I8 = 127
    assert_eq(a.max(b), b)
    assert_eq(a.min(b), a)
    assert_eq(b.min(-1), -1)
    assert_eq(a.max(a), a)
    let c: I16 = -32768
    let d: I16 = 32767
    assert_eq(c.max(d), d)
    assert_eq(c.min(d), c)
    assert_eq(d.min(-1), -1)
    let x: I32 = -42
    assert_eq(x.min(0), -42)
    assert_eq(x.max(0), 0)
    let e: I32 = -2147483648
    let f: I32 = 2147483647
    assert_eq(e.max(f), f)
    assert_eq(e.min(f), e)
    assert_eq(f.max(f), f)
}

test "unsigned sized integers order their bounds" {
    let a: U8 = 255
    assert_eq(a.min(0), 0)
    assert_eq(a.max(0), 255)
    assert_eq(a.max(a), a)
    let b: U16 = 65535
    assert_eq(b.min(7), 7)
    assert_eq(b.max(7), 65535)
    let c: U32 = 4294967295
    assert_eq(c.min(1), 1)
    assert_eq(c.max(1), 4294967295)
    let d: U64 = 18446744073709551615
    assert_eq(d.min(2), 2)
    assert_eq(d.max(2), d)
    let z: U64 = 0
    assert_eq(z.max(d), d)
    assert_eq(z.min(d), z)
}

test "a sized min or max keeps the receiver's type" {
    let a: U8 = 200
    let b: U8 = 100
    let m: U8 = a.min(b)
    assert_eq(m.wrapping_add(200), 44)
    let s: I8 = 100
    let t: I8 = s.max(-5)
    assert_eq(t.wrapping_add(100), -56)
}

test "Float min and max pick the smaller and the larger" {
    assert_eq(1.5.max(2.5), 2.5)
    assert_eq(2.5.max(1.5), 2.5)
    assert_eq(1.5.min(2.5), 1.5)
    assert_eq(2.5.min(1.5), 1.5)
    assert_eq(2.0.max(2.0), 2.0)
    assert_eq(2.0.min(2.0), 2.0)
    assert_eq((-1.5).max(-2.5), -1.5)
    assert_eq((-1.5).min(-2.5), -2.5)
}

test "a NaN receiver wins max and loses min" {
    assert(is_nan(nan().max(1.0)))
    assert_eq(nan().min(1.0), 1.0)
    assert(is_nan(nan().max(-1.0)))
    assert_eq(nan().min(-1.0), -1.0)
}

test "a NaN argument wins max and loses min" {
    assert(is_nan(1.0.max(nan())))
    assert_eq(1.0.min(nan()), 1.0)
    assert(is_nan(inf().max(nan())))
    assert_eq(inf().min(nan()), inf())
}

// The chain is not clamp (§3.2.6 Float Math, `clamp`): for a NaN receiver it gives the
// upper bound.
test "a NaN receiver chained through max then min gives the upper bound" {
    assert_eq(nan().max(0.0).min(1.0), 1.0)
}

test "NaN against NaN is a tie" {
    assert(is_nan(nan().max(nan())))
    assert(is_nan(nan().min(nan())))
}

test "the two zeros tie, so the receiver comes back" {
    assert(neg_zero().max(0.0).is_sign_negative())
    assert(neg_zero().min(0.0).is_sign_negative())
    assert(!0.0.max(neg_zero()).is_sign_negative())
    assert(!0.0.min(neg_zero()).is_sign_negative())
}

test "infinities order against finite values" {
    let ninf = 0.0 - inf()
    assert_eq(inf().max(1000000.0), inf())
    assert_eq(inf().min(1000000.0), 1000000.0)
    assert_eq(ninf.min(-1000000.0), ninf)
    assert_eq(ninf.max(-1000000.0), -1000000.0)
    assert_eq(inf().max(ninf), inf())
    assert_eq(inf().min(ninf), ninf)
    assert(is_nan(nan().max(inf())))
    assert_eq(nan().min(inf()), inf())
}
