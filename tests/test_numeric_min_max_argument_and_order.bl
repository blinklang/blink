// The argument of `min` and `max` is `Self` (sections/03_types.md, the sized integer method
// table and §3.2.6 Float Math; Int follows the same signature), so an argument of another
// type is a TypeError at check and never reaches codegen. The call reads its receiver once and its argument once, in that
// order.

import compile_test_helpers.{compile_and_capture, compile_and_run}

fn refused_with(code: Str, src: Str, fixture: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_capture(src, fixture)
    assert(r.contains(code), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "an Int min or max refuses an argument that is not an Int" {
    refused_with("argument 1 of `Int.max` expects Int, got Float", "fn main() \{ io.println(\"\{3.max(4.0)}\") \}\n", "_minmax_int_float_arg")
    refused_with("argument 1 of `Int.min` expects Int, got Str", "fn main() \{ io.println(\"\{3.min(\"x\")}\") \}\n", "_minmax_int_str_arg")
    refused_with("argument 1 of `Int.max` expects Int, got U8", "fn main() \{\n let u: U8 = 1\n io.println(\"\{3.max(u)}\")\n\}\n", "_minmax_int_u8_arg")
}

test "a sized integer min or max refuses an argument of another type" {
    refused_with("argument 1 of `U8.max` expects U8, got Int", "fn main() \{\n let u: U8 = 1\n let i = 2\n io.println(\"\{u.max(i)}\")\n\}\n", "_minmax_u8_int_arg")
    refused_with("argument 1 of `I32.min` expects I32, got I16", "fn main() \{\n let a: I32 = 1\n let b: I16 = 2\n io.println(\"\{a.min(b)}\")\n\}\n", "_minmax_i32_i16_arg")
}

test "a literal argument takes the sized receiver's type and its range" {
    refused_with("IntLiteralOutOfRange", "fn main() \{\n let u: U8 = 1\n io.println(\"\{u.max(300)}\")\n\}\n", "_minmax_u8_literal_range")
    refused_with("IntLiteralOutOfRange", "fn main() \{\n let u: U16 = 1\n io.println(\"\{u.min(-1)}\")\n\}\n", "_minmax_u16_negative_literal")
}

test "a Float min or max refuses an argument that is not a Float" {
    refused_with("argument 1 of `Float.max` expects Float, got Int", "fn main() \{\n let i = 2\n io.println(\"\{1.5.max(i)}\")\n\}\n", "_minmax_float_int_arg")
    refused_with("argument 1 of `Float.min` expects Float, got Str", "fn main() \{ io.println(\"\{1.5.min(\"x\")}\") \}\n", "_minmax_float_str_arg")
}

test "min and max take one argument" {
    refused_with("method `U8.max` expects 1 argument(s), got 0", "fn main() \{\n let u: U8 = 1\n io.println(\"\{u.max()}\")\n\}\n", "_minmax_u8_no_arg")
    refused_with("method `Float.min` expects 1 argument(s), got 2", "fn main() \{ io.println(\"\{1.5.min(1.0, 2.0)}\") \}\n", "_minmax_float_two_args")
}

test "min and max read the receiver once and the argument once, in that order" {
    let r = compile_and_run(#"
fn a() -> Int ! IO.Print {
    io.println("a")
    3
}
fn b() -> Int ! IO.Print {
    io.println("b")
    4
}
fn fa() -> Float ! IO.Print {
    io.println("fa")
    1.5
}
fn fb() -> Float ! IO.Print {
    io.println("fb")
    2.5
}
fn ua() -> U8 ! IO.Print {
    io.println("ua")
    7
}
fn ub() -> U8 ! IO.Print {
    io.println("ub")
    9
}
fn main() {
    io.println("{a().max(b())} {a().min(b())}")
    io.println("{fa().max(fb())} {fa().min(fb())}")
    io.println("{ua().max(ub())} {ua().min(ub())}")
}
"#, "_minmax_eval_order")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert_eq(r.out.trim(), "a\nb\na\nb\n4 3\nfa\nfb\nfa\nfb\n2.5 1.5\nua\nub\nua\nub\n9 7")
}
