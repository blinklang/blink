// A `match` binds its scrutinee to a temp once; the arms test the temp, not a
// re-embedded scrutinee expression. For a plain (C-style) enum scrutinee this
// held only by accident: a BARE-arm match (`Red =>`) erased the scrutinee to a
// scalar CT and got the temp, but a QUALIFIED-arm match (`Col.Red =>`) kept it
// at CT_ENUM and fell through to the no-temp fallback, so a side-effecting
// scrutinee (a fn call) ran once per arm tested. `Col.Blue` is the last arm, so
// the scrutinee ran three times.

type Col { Red, Green, Blue }

let mut nyz_calls = 0

fn nyz_side() -> Col {
    nyz_calls = nyz_calls + 1
    Col.Blue
}

test "a qualified-variant match evaluates a side-effecting scrutinee once" {
    nyz_calls = 0
    let n = match nyz_side() {
        Col.Red => 1
        Col.Green => 2
        Col.Blue => 3
    }
    assert_eq(n, 3)
    assert_eq(nyz_calls, 1)
}

test "a qualified-variant match that hits the first arm still evaluates once" {
    nyz_calls = 0
    let m = match nyz_first() {
        Col.Red => 10
        Col.Green => 20
        Col.Blue => 30
    }
    assert_eq(m, 10)
    assert_eq(nyz_calls, 1)
}

fn nyz_first() -> Col {
    nyz_calls = nyz_calls + 1
    Col.Red
}

test "the bare-variant form still evaluates the scrutinee once" {
    nyz_calls = 0
    let b = match nyz_side() {
        Red => 1
        Green => 2
        Blue => 3
    }
    assert_eq(b, 3)
    assert_eq(nyz_calls, 1)
}
