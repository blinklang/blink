// The Result twin of b7zdk3, plus the pop() siblings of the same accessor family.
// A List whose element is a carrier (Option/Result) over a Map is a
// carrier-over-carrier-over-Map: the list accessor spelled its result carrier with
// the Map inner ERASED to the bare head (blink_Option_Result_int_str /
// blink_Option_Option_int) while the .unwrap() chain demanded the map carrier, so
// the deref hit a non-struct scalar and cc rejected it. The Map value nested two
// carriers deep must keep its identity at every list-element producer site:
// .get() and .pop(), for both Option and Result elements.

fn get_result() -> Int {
    let mut xs: List[Result[Map[Str, Int], Str]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 9)
    xs.push(Ok(m))
    xs.get(0).unwrap().unwrap().get("k").unwrap()
}

fn pop_result() -> Int {
    let mut xs: List[Result[Map[Str, Int], Str]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 7)
    xs.push(Ok(m))
    xs.pop().unwrap().unwrap().get("k").unwrap()
}

fn pop_option() -> Int {
    let mut xs: List[Option[Map[Str, Int]]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 5)
    xs.push(Some(m))
    xs.pop().unwrap().unwrap().get("k").unwrap()
}

test "List[Result[Map,E]] element keeps its Map inner through get/unwrap" {
    assert_eq(get_result(), 9)
}

test "List[Result[Map,E]] element keeps its Map inner through pop/unwrap" {
    assert_eq(pop_result(), 7)
}

test "List[Option[Map]] element keeps its Map inner through pop/unwrap" {
    assert_eq(pop_option(), 5)
}
