// Two builds can share one object cache, and the GC of one can delete the archive header PCH
// the other has just found there, before its units compile against it. gcc then reads the
// header in its place, so the build passes, but each unit pays for the header again. The build
// holds the PCH it found, so its units still read it, and the binary is the one a cold build
// links. BLINK_DEV_OBJCACHE_EVICT=compile empties the cache after the build's lookups and
// before its units compile, as such a GC would, so the race happens on every run.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with a program of two modules, and a cc first on PATH that runs the real cc
// with -H on each compile, so its log names the PCH a unit read ("! <path>.gch"). Each
// compile logs to a file of its own: gcc writes -H lines in pieces, which parallel compiles
// would interleave in one file.
fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/bin {tree}/out")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    let real_cc = sh("command -v cc")
    write_file("{tree}/bin/cc", "#!/bin/sh\ncase \" $* \" in *\" -c \"*) exec {real_cc} \"$@\" -H 2>\"$(mktemp {tree}/cc_h/XXXXXX)\" ;; esac\nexec {real_cc} \"$@\"\n")
    shell_exec("chmod +x {tree}/bin/cc")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"evict_pch_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/part.bl", "pub fn value() -> Int \{\n    41\n\}\n")
}

fn edit_main(tree: Str, n: Int) {
    write_file("{tree}/app/src/main.bl", "import part.\{value\}\n\nfn main() \{\n    let total = value() + {n}\n    io.println(\"sum \{total\}\")\n\}\n")
}

// Runs blink in the tree with the object cache at cache, the -H cc and the unit trace. The
// corpus exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so
// the run drops them.
fn build(tree: Str, cache: Str, env_extra: Str) -> ProcessResult {
    shell_exec("rm -rf {tree}/cc_h && mkdir {tree}/cc_h")
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_DEV_OBJCACHE_EVICT -u BLINK_ARCHIVE_PCH PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/{cache} BLINK_TRACE_CHANNELS=build.units {env_extra} build/blink build app/src/main.bl -o {tree}/out/app --per-module"]).unwrap()
}

// The compiles of the last build that read a PCH.
fn pch_reads(tree: Str) -> Int {
    sh("cat {tree}/cc_h/* | grep -c '^! /.*/libblink_std\\.h\\.gch$'").to_int()
}

test "units read the archive header PCH their build found after it is evicted, and the binary is a cold build's" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_evict_pch_{getpid()}"
    dev_tree(root, tree)
    edit_main(tree, 1)
    let cold = build(tree, "cold-cache", "BLINK_ARCHIVE_PCH=0")
    shell_exec("cp {tree}/out/app {tree}/cold.bin")
    shell_exec("rm -rf {tree}/out/app.units {tree}/out/app")
    // A program's first build makes no PCH, and the second makes one.
    edit_main(tree, 0)
    let first = build(tree, "cache", "")
    edit_main(tree, 2)
    let second = build(tree, "cache", "")
    let pch_dirs = sh("ls -d {tree}/cache/*.pch 2>/dev/null | wc -l")
    edit_main(tree, 1)
    let raced = build(tree, "cache", "BLINK_DEV_OBJCACHE_EVICT=compile")
    let reads = pch_reads(tree)
    let same = sh("cmp -s {tree}/cold.bin {tree}/out/app && echo same")
    let out = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(cold.exit_code == 0, "cold build failed: {cold.out}{cold.err_out}")
    assert(first.exit_code == 0, "first build failed: {first.out}{first.err_out}")
    assert(second.exit_code == 0, "second build failed: {second.out}{second.err_out}")
    assert_eq(pch_dirs, "1")
    assert(raced.err_out.contains("dev evict compile"), "no eviction ran: {raced.err_out}")
    assert(raced.exit_code == 0, "the build failed after the eviction: {raced.out}{raced.err_out}")
    assert(reads >= 1, "no unit read the PCH its build found")
    assert_eq(same, "same")
    assert_eq(out, "sum 42")
}
