// A per-module build holds its cache hits and the PCH in a dir under the cache's tmp/, which
// no GC removes, so the build must remove it however it ends: after its link, after a unit
// fails to compile, and after its link fails. A daemon builds in a child it forks and runs
// the same path, so the rule holds there too. A cc first on PATH fails a unit compile while
// fail_compile exists and the program link while fail_link exists.

import std.process.{ProcessResult}
import std.testing.{cleanup}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/app/out {tree}/ccwrap")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // Only the program link names the archive, so the PCH compile never fails here.
    let real = sh("command -v cc")
    write_file("{tree}/ccwrap/cc", "#!/bin/sh\ncase \" $* \" in\n    *\" -c \"*) [ -e {tree}/fail_compile ] && exit 1 ;;\n    *libblink_std.a*) [ -e {tree}/fail_link ] && exit 1 ;;\nesac\nexec {real} \"$@\"\n")
    shell_exec("chmod +x {tree}/ccwrap/cc")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"hold_dir_app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/part.bl", "pub fn value() -> Int \{\n    41\n\}\n")
    edit_main(tree, 1)
}

fn edit_main(tree: Str, n: Int) {
    write_file("{tree}/app/src/main.bl", "import part.\{value\}\n\nfn main() \{\n    let total = value() + {n}\n    io.println(\"sum \{total\}\")\n\}\n")
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it serves only a client whose env is its own.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_DEV_OBJCACHE_EVICT -u BLINK_DEV_OBJCACHE_HOLD BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units PATH={tree}/ccwrap:$PATH"
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree}/app && {env_of(tree)} ../build/blink {args}"])
}

fn build(tree: Str) -> ProcessResult {
    blink_in(tree, "build src/main.bl -o out/app --per-module")
}

// What the cache's tmp/ holds after a build: no hold dir may outlive it.
fn holds_left(tree: Str) -> Str {
    sh("ls -A {tree}/objcache/tmp 2>/dev/null")
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process_run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"])
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if up.exit_code != 0 {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "builds", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = blink_in(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            n.to_int()
        }
        None => -1
    }
}

// Runs a cold build, a build whose main fails to compile and one whose link fails, each with
// part a hit, and answers each build's result and what tmp/ held after it.
fn three_builds(tree: Str) -> List[(ProcessResult, Str)] {
    let mut out: List[(ProcessResult, Str)] = []
    let ok = build(tree)
    out.push((ok, holds_left(tree)))
    edit_main(tree, 2)
    shell_exec("touch {tree}/fail_compile")
    let bad_compile = build(tree)
    shell_exec("rm -f {tree}/fail_compile")
    out.push((bad_compile, holds_left(tree)))
    shell_exec("touch {tree}/fail_link")
    let bad_link = build(tree)
    shell_exec("rm -f {tree}/fail_link")
    out.push((bad_link, holds_left(tree)))
    out
}

fn check(label: Str, runs: List[(ProcessResult, Str)]) {
    let (ok, ok_left) = runs.get(0).unwrap()
    let (bad_compile, compile_left) = runs.get(1).unwrap()
    let (bad_link, link_left) = runs.get(2).unwrap()
    assert(ok.exit_code == 0, "{label}: the cold build failed: {ok.out}{ok.err_out}")
    assert_eq(ok_left, "")
    assert(bad_compile.exit_code != 0, "{label}: the build passed with a unit that failed to compile")
    assert(bad_compile.err_out.contains("hit part"), "{label}: part was not a hit, so nothing was held: {bad_compile.err_out}")
    assert(bad_compile.out.contains("C compilation failed in unit"), "{label}: no unit failed: {bad_compile.out}")
    assert_eq(compile_left, "")
    assert(bad_link.exit_code != 0, "{label}: the build passed with a link that failed")
    assert(bad_link.err_out.contains("hit part"), "{label}: part was not a hit, so nothing was held: {bad_link.err_out}")
    assert(bad_link.out.contains("failed while linking"), "{label}: the link did not fail: {bad_link.out}")
    assert_eq(link_left, "")
}

test "a build removes its hold dir after its link, a unit that fails to compile and a link that fails" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_hold_dir_cli_{getpid()}"
    dev_tree(root, tree)
    let runs = three_builds(tree)
    shell_exec("rm -rf {tree}")
    check("cli", runs)
}

test "a daemon build removes its hold dir after its link, a unit that fails to compile and a link that fails" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_hold_dir_daemon_{getpid()}"
    dev_tree(root, tree)
    let pid = start_daemon(tree)
    let mut runs: List[(ProcessResult, Str)] = []
    let mut builds = -1
    with cleanup(fn() { stop_daemon(pid) }) {
        assert(pid > 0, "the daemon did not start: {read_file("{tree}/daemon.log")}")
        runs = three_builds(tree)
        builds = served(tree, "builds")
    }
    shell_exec("rm -rf {tree}")
    check("daemon", runs)
    assert_eq(builds, 3)
}
