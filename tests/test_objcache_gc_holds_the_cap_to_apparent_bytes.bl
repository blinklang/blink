// The object cache evicts its oldest entries once its files pass the cap. A build counts the
// bytes each file holds in process instead of asking du for the blocks the tree takes, so a
// build starts no du. The cap only starts eviction and never changes what a build makes, so a
// file's bytes stand in for its blocks: a sparse file counts at its full length.

import build_objcache
import std.fs.{FsErrorExt}

// A stat that fails for another reason than a missing entry counts as there.
fn path_exists(path: Str) -> Bool ! FS.Read {
    match fs.stat(path) {
        Ok(_) => true
        Err(e) => !e.not_found()
    }
}

let DIR = "build/objcache_gc_apparent_bytes_probe"

fn entry(key: Str, kib: Int, age: Str) {
    process.run("sh", ["-c", "head -c {kib * 1024} /dev/zero > {DIR}/{key}.o && echo '1 mod ' > {DIR}/{key}.meta && touch -d '{age}' {DIR}/{key}.meta"]).unwrap()
}

fn gc_with_cap(mb: Int) ! IO, FS.Read, FS.Delete {
    env.set_var("BLINK_CACHE_DIR", DIR)
    env.set_var("BLINK_CACHE_SIZE_MB", "{mb}")
    build_objcache.maybe_gc()
    env.remove_var("BLINK_CACHE_SIZE_MB")
    env.remove_var("BLINK_CACHE_DIR")
}

test "a sparse object counts at its full length" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/tmp"])?
    process.run("sh", ["-c", "truncate -s 2M {DIR}/aaaaaaaaaaaaaaaa.o && echo '1 mod ' > {DIR}/aaaaaaaaaaaaaaaa.meta"])?
    gc_with_cap(1)
    assert(!path_exists("{DIR}/aaaaaaaaaaaaaaaa.o"))
    assert(!path_exists("{DIR}/aaaaaaaaaaaaaaaa.meta"))
}

test "eviction drops the oldest entries until the bytes fit the cap" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/tmp"])?
    entry("1111111111111111", 400, "3 hours ago")
    entry("2222222222222222", 400, "2 hours ago")
    entry("3333333333333333", 400, "1 hour ago")
    gc_with_cap(1)
    assert(!path_exists("{DIR}/1111111111111111.o"))
    assert(path_exists("{DIR}/2222222222222222.o"))
    assert(path_exists("{DIR}/3333333333333333.o"))
}

test "the files under tmp count toward the cap" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/tmp/unit.abcdef"])?
    entry("1111111111111111", 400, "2 hours ago")
    entry("2222222222222222", 400, "1 hour ago")
    process.run("sh", ["-c", "head -c 307200 /dev/zero > {DIR}/tmp/unit.abcdef/x.c"])?
    gc_with_cap(1)
    assert(!path_exists("{DIR}/1111111111111111.o"))
    assert(path_exists("{DIR}/2222222222222222.o"))
}

test "a cache under its cap keeps every entry" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/tmp"])?
    entry("1111111111111111", 400, "2 hours ago")
    entry("2222222222222222", 400, "1 hour ago")
    gc_with_cap(1)
    assert(path_exists("{DIR}/1111111111111111.o"))
    assert(path_exists("{DIR}/2222222222222222.o"))
}
