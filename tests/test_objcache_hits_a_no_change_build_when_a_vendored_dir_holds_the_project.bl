// A vendored dep whose source sits at the project root has the root as its include dir, -I.,
// so every file under the project is in the unit key. The obj cache, the output binary and
// the units dir lie there too, and the build writes them. Were they in the key, each build
// would miss the objects the last one stored. A header in a subdir of the root still keys.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

// A dev tree with an empty project in {tree}/app.
fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
}

fn write_in(tree: Str, rel: Str, text: Str) {
    let path = "{tree}/app/{rel}"
    shell_exec("mkdir -p $(dirname {path})")
    write_file(path, text)
}

// A project over one native dep at its root whose mylib.h answers MYLIB_K from sub/k.h.
fn root_dep_project(tree: Str) {
    write_in(tree, "blink.toml", "[package]\nname = \"rd\"\nversion = \"0.1.0\"\n\n[native-dependencies]\nmylib = \{ type = \"vendored\", path = \"mylib.c\", headers = [\"mylib.h\"] \}\n")
    shell_exec("touch {tree}/app/blink.lock")
    write_in(tree, "mylib.h", [
        "#pragma once",
        "#include <stdint.h>",
        "#include \"sub/k.h\"",
        "typedef struct mylib_ctx mylib_ctx;",
        "static inline int64_t mylib_k(void) \{ return MYLIB_K; \}",
        "",
    ].join("\n"))
    write_in(tree, "sub/k.h", "#define MYLIB_K 1\n")
    write_in(tree, "mylib.c", "#include \"mylib.h\"\nint64_t mylib_unused(void) \{ return 0; \}\n")
    write_in(tree, "src/part.bl", [
        #"@ffi.opaque(header: "mylib.h", name: "mylib_ctx")"#,
        #"pub type Ctx"#,
        #""#,
        #"@ffi("mylib", "mylib_k", header: "mylib.h")"#,
        #"@trusted(audit: "T1")"#,
        #"pub fn k() -> Int ! FFI {}"#,
        #""#,
    ].join("\n"))
    write_in(tree, "src/main.bl", [
        #"import part.{k}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("k {k()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// Builds with the default obj cache, build/obj-cache under the project. The corpus exports
// BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the run
// drops them.
fn build_in(tree: Str, flags: Str) -> Str {
    let r = process_run("sh", ["-c", "cd {tree}/app && env -u BLINK_ROOT -u BLINK_CACHE_DIR -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE {tree}/build/blink build src/main.bl -o out/app {flags}"])
    assert(r.exit_code == 0, "build failed: {r.out}{r.err_out}")
    sh("{tree}/app/out/app")
}

// The objects the obj cache holds.
fn cached_objs(tree: Str) -> Str {
    sh("find {tree}/app/build/obj-cache -name '*.o' | wc -l")
}

fn check_no_change(name: Str, flags: Str) {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_root_dep_hit_{name}_{getpid()}"
    dev_tree(root, tree)
    root_dep_project(tree)
    assert_eq(build_in(tree, flags), "k 1")
    let first = cached_objs(tree)
    assert_eq(build_in(tree, flags), "k 1")
    assert_eq(build_in(tree, flags), "k 1")
    let third = cached_objs(tree)
    shell_exec("rm -rf {tree}")
    assert(first != "0", "the first build stored no object")
    assert_eq(third, first)
}

fn check_edit(name: Str, flags: Str) {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_root_dep_edit_{name}_{getpid()}"
    dev_tree(root, tree)
    root_dep_project(tree)
    assert_eq(build_in(tree, flags), "k 1")
    write_in(tree, "sub/k.h", "#define MYLIB_K 2\n")
    let after = build_in(tree, flags)
    shell_exec("rm -rf {tree}")
    assert_eq(after, "k 2")
}

test "a no-change build of a project whose root is a vendored dir stores no new object" {
    check_no_change("units", "--per-module")
}

test "a no-change one-unit build of a project whose root is a vendored dir stores no new object" {
    check_no_change("one", "--no-per-module")
}

test "an edit to a header in a subdir of a project root that is a vendored dir gives the unit a new key" {
    check_edit("units", "--per-module")
}

test "an edit to a header in a subdir of a project root that is a vendored dir gives the one-unit build a new key" {
    check_edit("one", "--no-per-module")
}
