// A user unit includes libblink_std.h and, through it, the runtime.h beside it in the
// archive dir, and a vendored dependency's headers through its include dir. Each one
// shapes the object, so the object cache key must change when any of them changes, and
// a key input that cannot be read must turn the cache off rather than drop out of the
// key.

import build_objcache.{user_unit_key}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn key_dir(name: Str) -> Str {
    let dir = "{sh("pwd -P")}/.tmp/_objcache_header_key_{name}_{getpid()}"
    shell_exec("rm -rf {dir} && mkdir -p {dir}/arc {dir}/vendor")
    write_file("{dir}/unit.c", "#include \"libblink_std.h\"\nint main(void) \{ return 0; }\n")
    write_file("{dir}/arc/libblink_std.h", "#include \"runtime.h\"\n")
    write_file("{dir}/arc/runtime.h", "int blink_part(void);\n")
    write_file("{dir}/vendor/dep.h", "int dep(void);\n")
    dir
}

fn key_of(dir: Str) -> Str {
    user_unit_key("{dir}/unit.c", "build/unit.c", "{dir}/arc", ["{dir}/vendor"], "bc", "cc 1", ["-O1"], "")
}

test "editing the runtime header the unit includes changes the key" {
    let dir = key_dir("runtime")
    let before = key_of(dir)
    shell_exec("echo '/* edited */' >> {dir}/arc/runtime.h")
    let after = key_of(dir)
    shell_exec("rm -rf {dir}")
    assert_eq(before.len(), 16)
    assert_eq(after.len(), 16)
    assert(before != after, "a runtime.h edit left the key at {before}")
}

test "editing the archive header the unit includes changes the key" {
    let dir = key_dir("archive_header")
    let before = key_of(dir)
    shell_exec("echo '/* edited */' >> {dir}/arc/libblink_std.h")
    let after = key_of(dir)
    shell_exec("rm -rf {dir}")
    assert_eq(before.len(), 16)
    assert(before != after, "a libblink_std.h edit left the key at {before}")
}

test "editing a vendored dependency header changes the key" {
    let dir = key_dir("vendored")
    let before = key_of(dir)
    shell_exec("echo '/* edited */' >> {dir}/vendor/dep.h")
    let after = key_of(dir)
    shell_exec("rm -rf {dir}")
    assert_eq(before.len(), 16)
    assert(before != after, "a vendored header edit left the key at {before}")
}

test "the same inputs give the same key" {
    let dir = key_dir("stable")
    let first = key_of(dir)
    let second = key_of(dir)
    shell_exec("rm -rf {dir}")
    assert_eq(first.len(), 16)
    assert_eq(first, second)
}

test "a key input that cannot be read gives no key" {
    let dir = key_dir("unreadable")
    shell_exec("rm {dir}/arc/runtime.h")
    let no_runtime = key_of(dir)
    write_file("{dir}/arc/runtime.h", "int blink_part(void);\n")
    shell_exec("rm {dir}/arc/libblink_std.h")
    let no_archive_header = key_of(dir)
    write_file("{dir}/arc/libblink_std.h", "#include \"runtime.h\"\n")
    shell_exec("rm {dir}/unit.c")
    let no_source = key_of(dir)
    write_file("{dir}/unit.c", "int main(void) \{ return 0; }\n")
    let no_compiler = user_unit_key("{dir}/unit.c", "build/unit.c", "{dir}/arc", [], "", "cc 1", ["-O1"], "")
    let no_cc = user_unit_key("{dir}/unit.c", "build/unit.c", "{dir}/arc", [], "bc", "", ["-O1"], "")
    shell_exec("rm -rf {dir}")
    assert_eq(no_runtime, "")
    assert_eq(no_archive_header, "")
    assert_eq(no_source, "")
    assert_eq(no_compiler, "")
    assert_eq(no_cc, "")
}

