// Two builds that miss the same PCH key each stage a dir and build into it. The first rename
// installs its dir; the second rename fails on the dir now in place, so the loser must remove
// its staged dir and the cache must keep the winner, which a later lookup finds.

import build_objcache

let DIR = "build/objcache_pch_store_race_probe"

fn staged_dir(name: Str, body: Str) -> Str {
    shell_exec("mkdir -p {DIR}/tmp/{name} && printf '{body}' > {DIR}/tmp/{name}/libblink_std.h.gch")
    "{DIR}/tmp/{name}"
}

test "a PCH store that loses the race removes its staged dir and keeps the winner" {
    shell_exec("rm -rf {DIR} && mkdir -p {DIR}/tmp")
    env.set_var("BLINK_CACHE_DIR", DIR)
    let first = staged_dir("first", "winner")
    let second = staged_dir("second", "loser")
    let first_stored = build_objcache.store_pch("aaaaaaaaaaaaaaaa", first)
    let second_stored = build_objcache.store_pch("aaaaaaaaaaaaaaaa", second)
    let found = build_objcache.lookup_pch("aaaaaaaaaaaaaaaa")
    env.remove_var("BLINK_CACHE_DIR")
    assert_eq(first_stored, true)
    assert_eq(second_stored, false)
    assert_eq(file_exists(second), 0)
    assert_eq(found, "{DIR}/aaaaaaaaaaaaaaaa.pch")
    assert_eq(read_file("{found}/libblink_std.h.gch"), "winner")
    assert_eq(file_exists("{DIR}/aaaaaaaaaaaaaaaa.meta"), 1)
}
