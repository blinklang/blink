// The unit key holds each file under a vendored dir but a dot entry. A vendored header can
// still include a file the key does not hold: one outside every vendored dir, by a path that
// climbs out or by an absolute path, or one under a dot dir. The cache keeps the list of such
// files the compile read beside the object and checks them on each hit, so an edit to one
// compiles the unit again, and a build that changed nothing still hits. A compile can read
// such a file while it is being written, so a build stores no object whose compile read one
// with an mtime the compile could have seen change.

import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with an empty project in {tree}/app.
fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    fs.write("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n").unwrap()
}

fn write_at(path: Str, text: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "mkdir -p $(dirname {path})"]).unwrap()
    fs.write(path, text).unwrap()
}

// A project over the native dep vendor/mylib, whose mylib.h answers MYLIB_K from the file it
// names by include.
fn project(tree: Str, include: Str) ! Process.Spawn, FS.Write {
    let app = "{tree}/app"
    write_at("{app}/blink.toml", "[package]\nname = \"ov\"\nversion = \"0.1.0\"\n\n[native-dependencies]\nmylib = \{ type = \"vendored\", path = \"vendor/mylib/mylib.c\", headers = [\"mylib.h\"] \}\n")
    process.run("sh", ["-c", "touch {app}/blink.lock"]).unwrap()
    write_at("{app}/vendor/mylib/mylib.h", [
        "#pragma once",
        "#include <stdint.h>",
        "#include \"{include}\"",
        "typedef struct mylib_ctx mylib_ctx;",
        "static inline int64_t mylib_k(void) \{ return MYLIB_K; \}",
        "",
    ].join("\n"))
    write_at("{app}/vendor/mylib/mylib.c", "#include \"mylib.h\"\nint64_t mylib_unused(void) \{ return 0; \}\n")
    write_at("{app}/src/part.bl", [
        #"@ffi.opaque(header: "mylib.h", name: "mylib_ctx")"#,
        #"pub type Ctx"#,
        #""#,
        #"@ffi("mylib", "mylib_k", header: "mylib.h")"#,
        #"@trusted(audit: "T1")"#,
        #"pub fn k() -> Int ! () {}"#,
        #""#,
    ].join("\n"))
    write_at("{app}/src/main.bl", [
        #"import part.{k}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("k {k()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// Builds with the default obj cache, build/obj-cache under the project. The corpus exports
// BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the run
// drops them.
fn build_in(tree: Str, flags: Str) -> Str ! Process.Spawn {
    let r = process.run("sh", ["-c", "cd {tree}/app && env -u BLINK_ROOT -u BLINK_CACHE_DIR -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE {tree}/build/blink build src/main.bl -o out/app {flags}"]).unwrap()
    assert(r.success(), "build failed: {r.out}{r.err_out}")
    sh("{tree}/app/out/app")
}

// The objects the obj cache holds.
fn cached_objs(tree: Str) -> Str ! Process.Spawn {
    sh("find {tree}/app/build/obj-cache -name '*.o' | wc -l")
}

// The objects the obj cache stored after the mark: a build that hits stores none, where one
// that compiles again stores its object afresh even under a key the cache holds.
fn mark(tree: Str) ! Process.Spawn {
    process.run("sh", ["-c", "touch {tree}/mark"]).unwrap()
}

fn stored_since_mark(tree: Str) -> Str ! Process.Spawn {
    sh("find {tree}/app/build/obj-cache -name '*.o' -newer {tree}/mark | wc -l")
}

// A file written just before a build is one the build may have read mid-write, so a build does
// not store what it compiled from it.
fn settle(path: Str) ! Process.Spawn {
    process.run("sh", ["-c", "touch -d '1 minute ago' {path}"]).unwrap()
}

// include is how mylib.h names the file, k_file where that file is (relative to the project
// when it does not start with /). An edit to it gives the new value on the same cache, and a
// build after that changes nothing hits.
fn check_edit(name: Str, flags: Str, include: Str, k_file: Str) ! Process.Spawn, FS.Write, Env.Read {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_outside_key_{name}_{getpid()}"
    dev_tree(root, tree)
    project(tree, include)
    let k_path = if k_file.starts_with("/") { k_file } else { "{tree}/app/{k_file}" }
    write_at(k_path, "#define MYLIB_K 1\n")
    settle(k_path)
    let first = build_in(tree, flags)
    write_at(k_path, "#define MYLIB_K 2\n")
    settle(k_path)
    let edited = build_in(tree, flags)
    let objs = cached_objs(tree)
    mark(tree)
    let again = build_in(tree, flags)
    let objs_again = cached_objs(tree)
    let stored = stored_since_mark(tree)
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    if k_file.starts_with("/") {
        process.run("sh", ["-c", "rm -rf {sh("dirname {k_file}")}"]).unwrap()
    }
    assert_eq(first, "k 1")
    assert_eq(edited, "k 2")
    assert_eq(again, "k 2")
    assert_eq(objs_again, objs)
    assert_eq(stored, "0")
}

// A dir outside the project and the test's tree.
fn outside_dir(name: Str) -> Str ! Env.Read, Process.Spawn {
    "{compile_test_helpers.scratch_root()}/_outside_key_abs_{name}_{getpid()}"
}

test "an edit to a file a vendored header includes by a path that climbs out of every vendored dir compiles the unit again" {
    check_edit("climb_units", "--per-module", "../shared/k.h", "vendor/shared/k.h")
}

test "an edit to a file a vendored header includes by a path that climbs out of every vendored dir compiles the one-unit build again" {
    check_edit("climb_one", "--no-per-module", "../shared/k.h", "vendor/shared/k.h")
}

test "an edit to a file a vendored header includes by an absolute path outside the project compiles the unit again" {
    let k = "{outside_dir("units")}/k.h"
    check_edit("abs_units", "--per-module", k, k)
}

test "an edit to a file a vendored header includes by an absolute path outside the project compiles the one-unit build again" {
    let k = "{outside_dir("one")}/k.h"
    check_edit("abs_one", "--no-per-module", k, k)
}

test "an edit to a header under a dot dir of a vendored dir compiles the unit again" {
    check_edit("dot_units", "--per-module", ".inc/k.h", "vendor/mylib/.inc/k.h")
}

test "an edit to a header under a dot dir of a vendored dir compiles the one-unit build again" {
    check_edit("dot_one", "--no-per-module", ".inc/k.h", "vendor/mylib/.inc/k.h")
}

fn count(tree: Str, pattern: Str) -> Int ! Process.Spawn {
    sh("find {tree}/app/build/obj-cache -name '{pattern}' | wc -l").to_int()
}

// A file outside the key whose mtime is at or past the start of the compile may have changed
// while cc read it, so the build links its object and stores neither it nor the reads beside it.
fn check_new_mtime(name: Str, flags: Str) ! Process.Spawn, FS.Write, Env.Read {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_outside_key_new_{name}_{getpid()}"
    dev_tree(root, tree)
    project(tree, "../shared/k.h")
    let k_path = "{tree}/app/vendor/shared/k.h"
    write_at(k_path, "#define MYLIB_K 1\n")
    settle(k_path)
    let first = build_in(tree, flags)
    let objs = count(tree, "*.o")
    let reads = count(tree, "*.reads")
    process.run("sh", ["-c", "rm -rf {tree}/app/build/obj-cache"]).unwrap()
    process.run("sh", ["-c", "touch -d '1 hour' {k_path}"]).unwrap()
    let late = build_in(tree, flags)
    let objs_late = count(tree, "*.o")
    let reads_late = count(tree, "*.reads")
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    assert_eq(first, "k 1")
    assert_eq(late, "k 1")
    assert(reads > 0, "the build stored no reads for the unit that read k.h")
    assert_eq(reads_late, 0)
    assert(objs_late < objs, "a build that read k.h with a new mtime stored {objs_late} objects, one that did not stored {objs}")
}

test "a unit that read a file outside the key whose mtime is past the start of its compile is not stored" {
    check_new_mtime("units", "--per-module")
}

test "a one-unit build that read a file outside the key whose mtime is past the start of its compile is not stored" {
    check_new_mtime("one", "--no-per-module")
}
