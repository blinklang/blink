// The object cache keys a unit by the sha of its C. Another build that writes the same
// C path can rewrite the file between the hash and the compile, so a compile that reads
// the path a second time can store an object built from other bytes under the key, and
// every later build links that object. The test makes the rewrite happen every time: a
// `cc` first on PATH empties the emitted C on the first compile of it, then runs the
// real compiler. An object built from the empty file has no `main`.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn setup(base: Str) -> Str {
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}/bin")
    let fake_cc = "#!/bin/sh\ncompiling=0\nunit=0\nfor a in \"$@\"; do\n    [ \"$a\" = -c ] && compiling=1\n    case \"$a\" in */hello.c|hello.c) unit=1 ;; esac\ndone\nif [ $compiling = 1 ] && [ $unit = 1 ] && [ ! -e \"$REWRITE_MARK\" ]; then\n    : > \"$REWRITE_C\"\n    touch \"$REWRITE_MARK\"\nfi\nexec \"$REAL_CC\" \"$@\"\n"
    write_file("{base}/bin/cc", fake_cc)
    // A host ccache would call the real cc by its own path, past the one above.
    write_file("{base}/bin/ccache", "#!/bin/sh\nshift\nexec cc \"$@\"\n")
    shell_exec("chmod +x {base}/bin/cc {base}/bin/ccache")
    write_file("{base}/hello.bl", "fn main() ! IO \{\n    io.println(\"hello from the hashed bytes\")\n}\n")
    sh("command -v cc")
}

fn build(base: Str, blink_root: Str, real_cc: Str) -> ProcessResult {
    let env_vars = "PATH={base}/bin:$PATH REAL_CC={real_cc} REWRITE_C={base}/hello.c REWRITE_MARK={base}/rewritten BLINK_CACHE_DIR={base}/objcache"
    process_run("sh", ["-c", "cd {base} && {env_vars} {blink_root}/build/blink build hello.bl --output hello 2>&1"])
}

test "a C file rewritten after it is hashed does not put a wrong object in the cache" {
    let blink_root = sh("pwd -P")
    let base = "{blink_root}/.tmp/_objcache_hashed_bytes_{getpid()}"
    let real_cc = setup(base)

    let first = build(base, blink_root, real_cc)
    assert_eq(file_exists("{base}/rewritten"), 1)
    assert(first.exit_code == 0, "the build whose C was rewritten failed:\n{first.out}")
    assert_eq(sh("{base}/hello"), "hello from the hashed bytes")

    // The marker is set, so this build compiles nothing it rewrote, and it hits the
    // entry the first build stored.
    let second = build(base, blink_root, real_cc)
    assert(second.exit_code == 0, "the build that hit the cache failed:\n{second.out}")
    assert_eq(sh("{base}/hello"), "hello from the hashed bytes")

    let entries = sh("ls {base}/objcache/*.o 2>/dev/null | wc -l").to_int()
    assert(entries > 0, "the builds stored no object")
    let mainless = sh("for o in {base}/objcache/*.o; do nm \"$o\" | grep -q ' T main$' || echo \"$o\"; done")
    assert_eq(mainless, "")
    shell_exec("rm -rf {base}")
}
