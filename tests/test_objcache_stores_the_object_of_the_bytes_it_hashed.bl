// The object cache keys a unit by the sha of its C. Another build that writes the same
// C path can rewrite the file between the hash and the compile, so a compile that reads
// the path a second time can store an object built from other bytes under the key, and
// every later build links that object. The test makes the rewrite happen every time: a
// `cc` first on PATH empties the emitted C on the first compile of it, then runs the
// real compiler. An object built from the empty file has no `main`. The one-unit build and
// the per-module build each compile from C another build can rewrite, so each test asks for
// its build by name.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn setup(base: Str) -> Str {
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}/bin")
    let fake_cc = "#!/bin/sh\ncompiling=0\nunit=0\nfor a in \"$@\"; do\n    [ \"$a\" = -c ] && compiling=1\n    case \"$a\" in */$REWRITE_UNIT|$REWRITE_UNIT) unit=1 ;; esac\ndone\nif [ $compiling = 1 ] && [ $unit = 1 ] && [ ! -e \"$REWRITE_MARK\" ]; then\n    : > \"$REWRITE_C\"\n    touch \"$REWRITE_MARK\"\nfi\nexec \"$REAL_CC\" \"$@\"\n"
    write_file("{base}/bin/cc", fake_cc)
    // A host ccache would call the real cc by its own path, past the one above.
    write_file("{base}/bin/ccache", "#!/bin/sh\nshift\nexec cc \"$@\"\n")
    shell_exec("chmod +x {base}/bin/cc {base}/bin/ccache")
    write_file("{base}/hello.bl", "fn main() ! IO \{\n    io.println(\"hello from the hashed bytes\")\n}\n")
    sh("command -v cc")
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// fall back to one unit, so a per-module run drops them.
fn build(base: Str, blink_root: Str, real_cc: Str, unit: Str, rewrite_c: Str, flag: Str) -> ProcessResult {
    let env_vars = "PATH={base}/bin:$PATH REAL_CC={real_cc} REWRITE_UNIT={unit} REWRITE_C={rewrite_c} REWRITE_MARK={base}/rewritten BLINK_CACHE_DIR={base}/objcache"
    let unset = if flag == "--per-module" { "env -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE " } else { "" }
    process_run("sh", ["-c", "cd {base} && {unset}{env_vars} {blink_root}/build/blink build hello.bl --output hello {flag} 2>&1"])
}

fn mainless_objects(base: Str) -> Str {
    sh("for o in {base}/objcache/*.o; do nm \"$o\" | grep -q ' T main$' || echo \"$o\"; done")
}

test "a C file rewritten after it is hashed does not put a wrong object in the cache" {
    let blink_root = sh("pwd -P")
    let base = "{blink_root}/.tmp/_objcache_hashed_bytes_{getpid()}"
    let real_cc = setup(base)

    let first = build(base, blink_root, real_cc, "hello.c", "{base}/hello.c", "--no-per-module")
    assert_eq(file_exists("{base}/rewritten"), 1)
    assert(first.exit_code == 0, "the build whose C was rewritten failed:\n{first.out}")
    assert_eq(sh("{base}/hello"), "hello from the hashed bytes")

    // The marker is set, so this build compiles nothing it rewrote, and it hits the
    // entry the first build stored.
    let second = build(base, blink_root, real_cc, "hello.c", "{base}/hello.c", "--no-per-module")
    assert(second.exit_code == 0, "the build that hit the cache failed:\n{second.out}")
    assert_eq(sh("{base}/hello"), "hello from the hashed bytes")

    let entries = sh("ls {base}/objcache/*.o 2>/dev/null | wc -l").to_int()
    assert(entries > 0, "the builds stored no object")
    assert_eq(mainless_objects(base), "")
    shell_exec("rm -rf {base}")
}

// A per-module build compiles its units in a private work dir and then replaces the
// published one, so the rewrite here hits the units an earlier build published while the
// next build compiles.
test "a unit rewritten after it is hashed does not put a wrong object in the cache, per module" {
    let blink_root = sh("pwd -P")
    let base = "{blink_root}/.tmp/_objcache_hashed_units_{getpid()}"
    let real_cc = setup(base)
    let published = "{base}/hello.units/__main__.c"

    // The marker is set, so this build rewrites nothing; it publishes the units the next
    // build's rewrite hits.
    shell_exec("touch {base}/rewritten")
    let first = build(base, blink_root, real_cc, "__main__.c", published, "--per-module")
    assert(first.exit_code == 0, "the first build failed:\n{first.out}")
    assert_eq(file_exists(published), 1)
    assert_eq(sh("{base}/hello"), "hello from the hashed bytes")

    // A new message, so the unit is emitted and compiled again, not reused.
    write_file("{base}/hello.bl", "fn main() ! IO \{\n    io.println(\"hello from the second bytes\")\n}\n")
    shell_exec("rm -f {base}/rewritten")
    let second = build(base, blink_root, real_cc, "__main__.c", published, "--per-module")
    assert_eq(file_exists("{base}/rewritten"), 1)
    assert(second.exit_code == 0, "the build whose published unit was rewritten failed:\n{second.out}")
    assert_eq(sh("{base}/hello"), "hello from the second bytes")

    let third = build(base, blink_root, real_cc, "__main__.c", published, "--per-module")
    assert(third.exit_code == 0, "the build that hit the cache failed:\n{third.out}")
    assert_eq(sh("{base}/hello"), "hello from the second bytes")

    let entries = sh("ls {base}/objcache/*.o 2>/dev/null | wc -l").to_int()
    assert(entries > 0, "the builds stored no object")
    assert_eq(mainless_objects(base), "")
    shell_exec("rm -rf {base}")
}
