// A build makes private dirs under the object cache's tmp/ (a one-unit build's unit.<rand>, a
// per-module build's hold.<rand>, a staged PCH's unit.<rand>) and removes them itself. A build
// killed with SIGKILL cannot, and the bytes it leaves count toward the cache cap. So a later
// build on the same cache must remove every such dir whose build is dead. A cc first on PATH
// stops a build at one step while hold_<step> exists, and the test then kills the build.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/ccwrap")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    let real = sh("command -v cc")
    // The step a cc command is: a PCH build, a unit compile, or the program link. The held cc
    // names its pid in held, written whole by a rename.
    write_file("{tree}/ccwrap/cc", "#!/bin/sh\ncase \" $* \" in\n    *\" -x c-header \"*) step=pch ;;\n    *\" -c \"*) step=compile ;;\n    *libblink_std.a*) step=link ;;\n    *) step=other ;;\nesac\nif [ -e {tree}/hold_$step ]; then\n    echo $$ > {tree}/held.tmp && mv {tree}/held.tmp {tree}/held\n    while [ ! -e {tree}/release ]; do sleep 0.05; done\nfi\nexec {real} \"$@\"\n")
    shell_exec("chmod +x {tree}/ccwrap/cc")
    for app in ["one", "two"] {
        shell_exec("mkdir -p {tree}/{app}/out")
        edit_main(tree, app, 1)
    }
}

fn edit_main(tree: Str, app: Str, n: Int) {
    write_file("{tree}/{app}/main.bl", "fn main() \{\n    io.println(\"{app} {n}\")\n\}\n")
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit with no cache, so the run drops both, and the module filters.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_DEV_OBJCACHE_EVICT -u BLINK_DEV_OBJCACHE_HOLD BLINK_CACHE_DIR={tree}/objcache PATH={tree}/ccwrap:$PATH"
}

fn build(tree: Str, app: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/{app} && {env_of(tree)} ../build/blink build main.bl -o out/app {args}"]).unwrap()
}

// Waits up to a minute for pid to be gone.
fn wait_gone(pid: Str) {
    shell_exec("for i in $(seq 1 1200); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done")
}

// Starts a build of app, kills it with SIGKILL once its cc reaches step, then lets that cc go
// and waits for it to end. Answers "" when the build reached step, else what it printed.
fn kill_at(tree: Str, app: Str, step: Str, args: Str) -> Str {
    shell_exec("rm -f {tree}/held {tree}/release && touch {tree}/hold_{step}")
    // env execs blink, so $! is the build's own pid.
    shell_exec("cd {tree}/{app} && \{ {env_of(tree)} ../build/blink build main.bl -o out/app {args} > {tree}/killed.log 2>&1 & echo $! > {tree}/blink.pid; \}")
    let blink = sh("cat {tree}/blink.pid")
    let reached = process.run("sh", ["-c", "for i in $(seq 1 2400); do [ -e {tree}/held ] && exit 0; kill -0 {blink} 2>/dev/null || exit 1; sleep 0.05; done; exit 1"]).unwrap().success()
    shell_exec("kill -9 {blink} 2>/dev/null")
    wait_gone(blink)
    shell_exec("rm -f {tree}/hold_{step} && touch {tree}/release")
    if !reached {
        return "the build never reached {step}: {read_file("{tree}/killed.log")}"
    }
    wait_gone(sh("cat {tree}/held"))
    ""
}

fn tmp_left(tree: Str) -> Str {
    sh("ls -A {tree}/objcache/tmp 2>/dev/null | tr '\\n' ' '").trim()
}

fn uses_pch() -> Bool {
    !sh("cc --version 2>&1 | head -1").contains("clang")
}

test "a per-module build killed at its link leaves a hold dir that a later build removes" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_reap_tmp_hold_{getpid()}"
    dev_tree(root, tree)
    let killed = kill_at(tree, "one", "link", "--per-module")
    let left = tmp_left(tree)
    let later = build(tree, "two", "--per-module")
    let after = tmp_left(tree)
    shell_exec("rm -rf {tree}")
    assert_eq(killed, "")
    assert(left.starts_with("hold."), "the killed build left no hold dir, so nothing was tested: {left}")
    assert(later.success(), "the later build failed: {later.out}{later.err_out}")
    assert_eq(after, "")
}

test "a one-unit build killed at its link leaves a unit dir that a later build removes" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_reap_tmp_unit_{getpid()}"
    dev_tree(root, tree)
    let killed = kill_at(tree, "one", "link", "--no-per-module")
    let left = tmp_left(tree)
    let later = build(tree, "two", "--no-per-module")
    let after = tmp_left(tree)
    shell_exec("rm -rf {tree}")
    assert_eq(killed, "")
    assert(left.starts_with("unit."), "the killed build left no unit dir, so nothing was tested: {left}")
    assert(later.success(), "the later build failed: {later.out}{later.err_out}")
    assert_eq(after, "")
}

test "a per-module build killed while it builds a PCH leaves a staged dir that a later build removes" {
    if !uses_pch() { return }
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_reap_tmp_pch_{getpid()}"
    dev_tree(root, tree)
    // The first build of a program makes no PCH; the edit after it does.
    let first = build(tree, "one", "--per-module")
    edit_main(tree, "one", 2)
    let killed = kill_at(tree, "one", "pch", "--per-module")
    let left = tmp_left(tree)
    let later = build(tree, "two", "--per-module")
    let after = tmp_left(tree)
    shell_exec("rm -rf {tree}")
    assert(first.success(), "the first build failed: {first.out}{first.err_out}")
    assert_eq(killed, "")
    assert(left.contains("unit."), "the killed build left no staged PCH dir, so nothing was tested: {left}")
    assert(later.success(), "the later build failed: {later.out}{later.err_out}")
    assert_eq(after, "")
}
