// A Result whose Ok side is itself a Result, nested under an outer Option, must
// spell the middle carrier's Ok side as the inner Result tag once, not re-wrap it
// into a doubled Result. The fn-return Ok construction path synthesized the Ok-side
// carrier from the emitted value and over-nested, producing a carrier type with one
// extra Result level that mismatched the declared return type. Sibling of the
// compound-ok and compound-err reconstructions on the same construction path.

type Point { x: Int, y: Int }

fn build_rr(n: Int) -> Option[Result[Result[Point, Str], Str]] {
    if n == 0 { Some(Ok(Ok(Point { x: 5, y: 6 }))) } else { Some(Err("outer")) }
}

fn main() {
    let a = build_rr(0)
    match a {
        Some(r) => {
            match r {
                Ok(inner) => {
                    match inner {
                        Ok(p) => {
                            assert_eq(p.x == 5, true)
                            assert_eq(p.y == 6, true)
                        }
                        Err(_e) => assert_eq(1, 0)
                    }
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }

    let b = build_rr(1)
    match b {
        Some(r) => {
            match r {
                Ok(_inner) => assert_eq(1, 0)
                Err(e) => assert_eq(e == "outer", true)
            }
        }
        None => assert_eq(1, 0)
    }
}
