// `on_panic(f)` takes one argument of type `fn(PanicInfo) -> Never`, with whatever row `f`
// declares (sections/02_syntax.md §2.20 *Panic Hook*). `main` holds every built-in effect, so
// a hook may use them with no declaration.

import compile_test_helpers.{check_via_cli}

fn has_error(out: Str) -> Bool {
    out.contains("\"severity\":\"error\"")
}

test "a hook with built-in effects in its row is no error" {
    let src = #"import std.panic.{PanicInfo}
let mut cur_id = 0

fn report(p: PanicInfo) -> Never ! IO.Print, IO.Eprint, Env.Exit, State {
    io.println("error id={cur_id}: {p.message}")
    io.eprintln(p.file)
    env.exit(101)
}

fn main() ! IO, Env {
    with on_panic(report) {
        cur_id = 7
        io.println("{cur_id}")
    }
}
"#
    let out = check_via_cli(src, "hook_builtin_row_{getpid()}")
    assert(!has_error(out), out)
}

test "a closure from PanicInfo to Never is a hook" {
    let src = #"import std.panic.{PanicInfo}
fn main() ! IO, Env {
    with on_panic(fn(p: PanicInfo) -> Never {
        io.eprintln(p.message)
        env.exit(3)
    }) {
        io.println("run")
    }
}
"#
    let out = check_via_cli(src, "hook_closure_{getpid()}")
    assert(!has_error(out), out)
}

test "a hook that takes the wrong type is a type error" {
    let src = #"fn report(n: Int) -> Never ! Env.Exit {
    env.exit(n)
}

fn main() ! IO, Env {
    with on_panic(report) {
        io.println("run")
    }
}
"#
    let out = check_via_cli(src, "hook_wrong_param_{getpid()}")
    assert(out.contains("argument 1 of `on_panic` expects"), out)
}

test "a hook that returns is a type error" {
    let src = #"import std.panic.{PanicInfo}
fn report(p: PanicInfo) ! IO.Eprint {
    io.eprintln(p.message)
}

fn main() ! IO, Env {
    with on_panic(report) {
        io.println("run")
    }
}
"#
    let out = check_via_cli(src, "hook_returns_{getpid()}")
    assert(out.contains("argument 1 of `on_panic` expects"), out)
}

test "on_panic with no argument is an arity error" {
    let src = #"fn main() ! IO, Env {
    with on_panic() {
        io.println("run")
    }
}
"#
    let out = check_via_cli(src, "hook_no_arg_{getpid()}")
    assert(out.contains("`on_panic` expects 1 argument(s), got 0"), out)
}

test "on_panic with two arguments is an arity error" {
    let src = #"import std.panic.{PanicInfo}
fn report(p: PanicInfo) -> Never ! Env.Exit {
    env.exit(70)
}

fn main() ! IO, Env {
    with on_panic(report, report) {
        io.println("run")
    }
}
"#
    let out = check_via_cli(src, "hook_two_args_{getpid()}")
    assert(out.contains("`on_panic` expects 1 argument(s), got 2"), out)
}
