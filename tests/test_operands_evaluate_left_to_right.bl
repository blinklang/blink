// Operands evaluate once, left to right (§2.22). Each row of the program below records the
// order its side effects ran in, then the value it built, so a row prints `label: order =
// value`. C leaves the order of call arguments and of most operands unspecified, and gcc picks
// a different order at each optimization level, so the program runs at -O0 and at -O2.

import compile_test_helpers.{compile_and_run_opt}

fn program() -> Str {
    #"import std.io

    let mut trace = ""

    fn t(n: Int) -> Int {
        trace = trace.concat("{n}")
        n
    }

    fn ts(n: Int) -> Str {
        trace = trace.concat("{n}")
        "{n}"
    }

    fn tok(n: Int) -> Result[Int, Str] {
        trace = trace.concat("{n}")
        Ok(n)
    }

    fn tnone(n: Int) -> Option[Int] {
        trace = trace.concat("{n}")
        None
    }

    fn tsok(n: Int) -> Result[Str, Str] {
        trace = trace.concat("{n}")
        Ok("{n}")
    }

    fn tsome(n: Int) -> Option[Int] {
        trace = trace.concat("{n}")
        Some(n)
    }

    fn tl(n: Int) -> List[Int] {
        trace = trace.concat("{n}")
        [n]
    }

    fn tbyte(n: Int) -> U8 {
        trace = trace.concat("{n}")
        let b: U8 = 1
        b
    }

    fn tmap(n: Int) -> Map[Int, Int] {
        trace = trace.concat("{n}")
        let mut m: Map[Int, Int] = Map()
        m.insert(2, 5)
        m
    }

    fn add(a: Int, b: Int) -> Int { a + b }

    fn kw(-- a: Int, b: Int) -> Int { a * 10 + b }

    fn pair(a: Bool, b: Bool) -> Bool { a && b }

    type P {
        x: Int
        y: Int
    }

    type Shape {
        Two(Int, Int)
    }

    type Box {
        v: Int
    }

    trait Get {
        fn get(self, n: Int) -> Int
    }

    impl Get for Box {
        fn get(self, n: Int) -> Int { self.v + n }
    }

    fn tbox(n: Int) -> Box {
        trace = trace.concat("{n}")
        Box { v: n }
    }

    type Shown {
        n: Int
    }

    impl Display for Shown {
        fn fmt(self, sb: StringBuilder) {
            trace = trace.concat("d")
            sb.write("{self.n}")
        }
    }

    fn row(label: Str, value: Str) {
        io.println("{label}: {trace} = {value}")
        trace = ""
    }

    fn holes_through_question() -> Result[Str, Str] {
        let s = "{t(1)} {tok(2)?} {t(3)}"
        Ok(s)
    }

    fn arg_through_question() -> Result[Int, Str] {
        Ok(add(t(1), tok(2)?))
    }

    fn get_base(n: Int) -> P {
        trace = trace.concat("{n}")
        P { x: 5, y: 6 }
    }

    fn concat_through_question() -> Result[Str, Str] { Ok(ts(1).concat(tsok(2)?)) }

    fn closure_through_question() -> Result[Int, Str] {
        let g = fn(a: Int, b: Int) -> Int { a + b }
        Ok(g(t(1), tok(2)?))
    }

    fn keyword_through_question() -> Result[Int, Str] { Ok(kw(b: t(1), a: tok(2)?)) }

    fn spread_through_question() -> Result[Int, Str] { Ok([..tl(1), tok(2)?].len()) }

    fn binop_through_question() -> Result[Int, Str] { Ok(t(1) + tok(2)?) }

    fn str_eq_through_question() -> Result[Bool, Str] { Ok(ts(1) == tsok(2)?) }

    fn str_cmp_through_question() -> Result[Bool, Str] { Ok(ts(1) < tsok(2)?) }

    fn contains_through_question() -> Result[Bool, Str] { Ok(ts(1).contains(tsok(2)?)) }

    fn get_through_question() -> Result[Int, Str] { Ok(tl(1).get(tok(2)? - 2) ?? 0) }

    fn take_through_question() -> Result[Int, Str] { Ok(tl(1).take(tok(2)?).len()) }

    fn wrapping_through_question() -> Result[Int, Str] { Ok(tbyte(1).wrapping_add(tbyte(tok(2)?)).to_int()) }

    fn int_eq_through_question() -> Result[Bool, Str] { Ok(t(1).eq(tok(2)?)) }

    fn map_remove_through_question() -> Result[Int, Str] { Ok(tmap(1).remove(tok(2)?) ?? 0) }

    fn map_contains_through_question() -> Result[Bool, Str] { Ok(tmap(1).contains_key(tok(2)?)) }

    fn main() {
        let s = "{t(1)} {t(2)}"
        row("interp", s)
        let nested = "{t(1)} {"{t(2)}{t(3)}"} {t(4)}"
        row("interp nested", nested)
        let q = holes_through_question().unwrap()
        row("interp question", q)
        let shown = Shown { n: 7 }
        let disp = "{shown} {t(2)}"
        row("interp display", disp)
        let mut count = 0
        let bump = fn() -> Int {
            count += 1
            count
        }
        let after = "{bump()} {count}"
        row("interp write then read", after)
        let before = "{count} {bump()}"
        row("interp read then write", before)
        row("call", "{add(t(1), t(2))}")
        row("call nested", "{add(add(t(1), t(2)), add(t(3), t(4)))}")
        row("call read then write", "{add(count, bump())}")
        row("call write then read", "{add(bump(), count)}")
        row("global read then write", "{trace}{ts(5)}")
        row("method", "{tbox(1).get(t(2))}")
        row("method chain", ts(1).concat(ts(2)).concat(ts(3)))
        let p = P { x: t(1), y: t(2) }
        row("struct", "{p.x} {p.y}")
        let pr = P { y: t(1), x: t(2) }
        row("struct written order", "{pr.x} {pr.y}")
        let (a, b) = (t(1), t(2))
        row("tuple", "{a} {b}")
        let v = Shape.Two(t(1), t(2))
        let vs = match v {
            Two(i, j) => "{i} {j}"
        }
        row("variant", vs)
        row("arith", "{t(1) + t(2) * t(3)}")
        row("negate", "{-t(1) + t(2)}")
        row("compare", "{t(1) < t(2)}")
        row("equal", "{t(1) == t(2)}")
        row("coalesce", "{add(t(1), tnone(2) ?? t(3))}")
        let none: Option[Int] = None
        row("coalesce name", "{add(t(1), none ?? t(3))}")
        row("question", "{arg_through_question().unwrap()}")
        row("and", "{pair(t(1) == 1, t(2) == 2 && t(3) == 3)}")
        let xs = [t(1), t(2), t(3)]
        row("list", "{xs.len()}")
        assert_eq(t(1), t(2) - 1)
        row("assert_eq", "")
        row("and skips its right side", "{false && add(t(1), t(2)) == 3}")
        row("coalesce skips its default", "{tsome(1) ?? add(t(2), t(3))}")
        row("keyword", "{kw(b: t(1), a: t(2))}")
        let ps = P { y: t(1), ..get_base(2) }
        row("struct spread", "{ps.x} {ps.y}")
        let mut src = P { x: 1, y: 2 }
        let replace_src = fn() -> Int {
            src = P { x: 3, y: 4 }
            t(1)
        }
        let pw = P { x: replace_src(), ..src }
        row("spread reads its source after the fields", "{pw.x} {pw.y}")
        row("variant payload through call", "{add(t(1), Some(t(2)) ?? 0)}")
        row("concat question", concat_through_question().unwrap())
        row("closure question", "{closure_through_question().unwrap()}")
        row("keyword question", "{keyword_through_question().unwrap()}")
        row("spread question", "{spread_through_question().unwrap()}")
        row("binop question", "{binop_through_question().unwrap()}")
        row("str eq question", "{str_eq_through_question().unwrap()}")
        row("str cmp question", "{str_cmp_through_question().unwrap()}")
        row("contains question", "{contains_through_question().unwrap()}")
        row("get question", "{get_through_question().unwrap()}")
        row("take question", "{take_through_question().unwrap()}")
        row("wrapping question", "{wrapping_through_question().unwrap()}")
        row("int eq question", "{int_eq_through_question().unwrap()}")
        row("map remove question", "{map_remove_through_question().unwrap()}")
        row("map contains question", "{map_contains_through_question().unwrap()}")
        let _tp = t"a{t(1)}b{t(2)}c"
        row("template", "")
    }
"#
}

fn expected_rows() -> List[Str] {
    [
        "interp: 12 = 1 2",
        "interp nested: 1234 = 1 23 4",
        "interp question: 123 = 1 2 3",
        "interp display: d2 = 7 2",
        "interp write then read:  = 1 1",
        "interp read then write:  = 1 2",
        "call: 12 = 3",
        "call nested: 1234 = 10",
        "call read then write:  = 5",
        "call write then read:  = 8",
        "global read then write: 5 = 5",
        "method: 12 = 3",
        "method chain: 123 = 123",
        "struct: 12 = 1 2",
        "struct written order: 12 = 2 1",
        "tuple: 12 = 1 2",
        "variant: 12 = 1 2",
        "arith: 123 = 7",
        "negate: 12 = 1",
        "compare: 12 = true",
        "equal: 12 = false",
        "coalesce: 123 = 4",
        "coalesce name: 13 = 4",
        "question: 12 = 3",
        "and: 123 = true",
        "list: 123 = 3",
        "assert_eq: 12 = ",
        "and skips its right side:  = false",
        "coalesce skips its default: 1 = 1",
        "keyword: 12 = 21",
        "struct spread: 12 = 5 1",
        "spread reads its source after the fields: 1 = 1 4",
        "variant payload through call: 12 = 3",
        "concat question: 12 = 12",
        "closure question: 12 = 3",
        "keyword question: 12 = 21",
        "spread question: 12 = 2",
        "binop question: 12 = 3",
        "str eq question: 12 = false",
        "str cmp question: 12 = true",
        "contains question: 12 = false",
        "get question: 12 = 1",
        "take question: 12 = 1",
        "wrapping question: 122 = 2",
        "int eq question: 12 = false",
        "map remove question: 12 = 5",
        "map contains question: 12 = true",
        "template: 12 = ",
    ]
}

fn check_rows(opt: Str, tag: Str) {
    let r = compile_and_run_opt(program(), tag, opt)
    assert_eq(r.err_out, "")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, expected_rows().join("\n").concat("\n"))
}

test "operands evaluate left to right at -O0" {
    check_rows("-O0", "_operands_left_to_right_o0")
}

test "operands evaluate left to right at -O2" {
    check_rows("-O2", "_operands_left_to_right_o2")
}
