// An operator whose operand's type comes from a later line runs with that type
// (sections/03_types.md §3.2 *Operator operands*). A closure parameter with no literal beside
// it takes its type from the call; a lone literal beside one makes it Int unless an expected
// integer type reaches the operator; a parameter type that reaches the closure before its body
// is checked is the parameter's type. The errors these rules give are in
// test_typecheck_operator_checks_an_inferred_operand_with_its_solved_type.bl.

fn take(n: U64) -> U64 { n }
fn ap(f: fn(U64) -> U64, v: U64) -> U64 { f(v) }
fn id[T](x: T) -> T { x }

test "a shift takes its left operand's type from the call" {
    let n: U64 = 3
    let m = fn(x) { x << 1 }
    assert_eq(take(m(n)), 6)
}

test "two operands with no literal take their type from the call" {
    let n: U64 = 6
    let k = fn(x, y) { x & y }
    let a = fn(x, y) { x * y }
    let c = fn(x, y) { x < y }
    assert_eq(take(k(n, n)), 6)
    assert_eq(take(a(n, n)), 36)
    assert(c(n, take(7)))
}

test "a literal beside an unannotated parameter makes it Int" {
    let h = fn(x) { x + 1 }
    let j = fn(x) { 2 * x }
    assert_eq(h(2), 3)
    assert_eq(j(4), 8)
}

test "an expected integer type beside a literal is the parameter's type" {
    let n: U64 = 3
    let h = fn(x) {
        let r: U64 = x + 1
        r
    }
    assert_eq(take(h(n)), 4)
}

test "a parameter type that reaches the closure first is its type" {
    let xs: List[U64] = [1, 2]
    let ys = xs.map(fn(x) { x + 1 })
    let zs = xs.map(fn(x) { 1 + x })
    let ws = xs.map(fn(x) { x & 1 })
    assert_eq(take(ys.get(0).unwrap()), 2)
    assert_eq(take(zs.get(1).unwrap()), 3)
    assert_eq(take(ws.get(0).unwrap()), 1)
    assert_eq(ap(fn(x) { x + 1 }, 5), 6)
    assert_eq(ap(fn(x) { 2 * x }, 5), 10)
    let h: fn(U64) -> U64 = fn(x) { x + 1 }
    let h2: fn(U64) -> U64 = fn(x) { 1 | x }
    assert_eq(h(7), 8)
    assert_eq(h2(6), 7)
}

test "a literal beside a generic call's result takes the result's type" {
    let r: U64 = 3
    assert_eq(take(2 * id(r)), 6)
    assert_eq(take(id(r) * 2), 6)
    let mut acc: U64 = 1
    acc += id(r)
    assert_eq(acc, 4)
}
