// t5nvd4: `let om: Option[Map[Int,Int]] = Some(Map())` must spell the RHS
// Some(...) carrier from the live let annotation, matching the structured
// carrier name emit_let_binding derives from that same annotation. Before the
// fix the declaration was structured (blink_Option_Map_int_int) but the RHS
// initializer cast was spelled one-level (blink_Option_map) — byte-identical
// layout, divergent name, so C reported "invalid initializer". Sibling of
// kjpq9p; same coupled edit in the Some construction path. Spec lineage:
// structured-spelling-wins direction set by 6kqgnp and the Ok/Err path, which
// already consults the annotation.

test "let-annotated Option[Map[Int,Int]] = Some(Map()) resolves the structured carrier" {
    let om: Option[Map[Int, Int]] = Some(Map())
    assert_eq(om.is_some(), true)
}

test "let-annotated Option[Option[Int]] = Some(Some(5)) proves compound_name_from_ann generality" {
    let oo: Option[Option[Int]] = Some(Some(5))
    assert_eq(oo.is_some(), true)
}

// Regression guard: the fn-return path (no let annotation) must stay green —
// the annotation-consult block only fires when cg_let_target_ann is live.
fn make() -> Option[Map[Int, Int]] {
    Some(Map())
}

test "fn-return Some(Map()) with no let annotation stays green" {
    assert_eq(make().is_some(), true)
}
