// An Option[T] carrier over a @derive(Serialize) type T has no .to_json()
// method of its own. Reporting that as UnresolvedMethod is correct — but the
// same compile must not ALSO panic with an internal compiler error over the
// same let binding. One diagnostic, no ICE.

import compile_test_helpers.{compile_and_capture}

test "an unresolved method call on an Option-of-derive-type carrier reports one error, no ICE" {
    let src = "@derive(Serialize)\ntype Cmd \{ Start, Stop }\nfn main() \{\n    let c: Option[Cmd] = Some(Cmd.Start)\n    let j = c.to_json()\n    io.println(j)\n}\n"
    let out = compile_and_capture(src, "option_derive_method_no_ice")
    assert(out.contains("UnresolvedMethod"), "expected UnresolvedMethod in output: {out}")
    assert(!out.contains("I0001"), "should not also raise an internal compiler error: {out}")
}
