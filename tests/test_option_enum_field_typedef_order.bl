type Color {
    Red
    Green
    Blue
}

type Box {
    c: Option[Color] = None
}

test "Option[enum] struct field: typedef ordered before owning struct" {
    let b = Box { c: None }
    assert_eq(b.c.is_none(), 1)
}

test "Option[enum] struct field round-trips Some(variant)" {
    let b = Box { c: Some(Color.Green) }
    assert_eq(b.c.is_some(), 1)
}
