// The value produced by Option[Enum].unwrap() must still dispatch enum methods
// (to_str), not just support equality and match.

type Status { Open = "open"  Done = "done" }

fn pick() -> Option[Status] { Some(Status.Open) }

test "unwrapping an Option[Enum] keeps enum method dispatch" {
    let v = pick().unwrap()
    assert_eq(v.to_str(), "open")
}
