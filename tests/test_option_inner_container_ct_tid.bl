// An Option whose inner is itself a container (Option[List[T]] / Option[Map[K,V]]),
// recovered by unwrapping a List[compound] element, must spell the inner container's
// deep element/value kind so a later unwrap/get reads the right value. The kind
// historically rode the flat inner2 ScopeVar slot; the option tid alone must now
// reproduce it. Both rows use a struct inner: the CT_INT floor rescues a lost scalar
// element, so only a struct element proves the kind actually survived.
//
// Row 1 (Option[List[Struct]]) is the razor guard for get_var_option_inner2: the
// CT_LIST unwrap arm reads the Set/List element from that reader first, and a struct
// element cannot be recovered by the floor. Row 2 (Option[Map[Struct]]) covers the
// sibling Option[Map]-through-list-element path, whose deep value authority is the
// unwrap node's own tid stamp (stamp_map_from_tid), not get_var_option_inner2.

type OiPt { x: Int, y: Int }

test "Option[List[Struct]] from a list element reads its struct element through unwrap" {
    let mut xs: List[Option[List[OiPt]]] = []
    xs.push(Some([OiPt { x: 1, y: 2 }, OiPt { x: 3, y: 4 }]))
    let o = xs.get(0).unwrap()
    let inner = o.unwrap()
    let p = inner.get(1).unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "Option[Map[Str,Struct]] from a list element reads its struct value through unwrap" {
    let mut xs: List[Option[Map[Str, OiPt]]] = []
    let mut m: Map[Str, OiPt] = Map()
    m.insert("o", OiPt { x: 5, y: 6 })
    xs.push(Some(m))
    let o = xs.get(0).unwrap()
    let inner = o.unwrap()
    let p = inner.get("o").unwrap()
    assert_eq(p.x, 5)
    assert_eq(p.y, 6)
}
