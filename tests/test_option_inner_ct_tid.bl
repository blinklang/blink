// get_var_option_inner reads the Option value CT from the carrier tid alone, with
// no flat inner1 fallback. These rows cover the inner shapes the reader must spell
// from the tid — struct, enum, nested Option, and the compound List/Map inners —
// reached through fn return, alias, match binder, and list/map temps. A wrong inner
// CT mis-spells the unwrap and reads the wrong value or fails to compile.

type OptPt { x: Int, y: Int }
type OptColor { Red, Green, Blue }

fn make_opt_struct() -> Option[OptPt] {
    Some(OptPt { x: 3, y: 4 })
}

fn make_opt_enum() -> Option[OptColor] {
    Some(OptColor.Green)
}

fn make_opt_list() -> Option[List[Int]] {
    Some([1, 2, 3])
}

fn make_opt_map() -> Option[Map[Str, Int]] {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 9)
    Some(m)
}

test "Option[Struct] from a fn return reads its struct fields" {
    let o = make_opt_struct()
    let p = o.unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "Option[Struct] through a match Some binds the struct" {
    let o = make_opt_struct()
    match o {
        Some(p) => { assert_eq(p.x + p.y, 7) }
        None => { assert_eq(0, 1) }
    }
}

test "Option[Enum] from a fn return matches its variant" {
    let o = make_opt_enum()
    let c = o.unwrap()
    let ok = match c {
        OptColor.Green => { true }
        _ => { false }
    }
    assert(ok)
}

test "Option[Struct] keeps its identity across an alias chain" {
    let o1 = make_opt_struct()
    let o2 = o1
    let o3 = o2
    assert_eq(o3.unwrap().x, 3)
}

test "Option[List[Int]] from a fn return iterates its elements" {
    let o = make_opt_list()
    let xs = o.unwrap()
    let mut total = 0
    for v in xs { total = total + v }
    assert_eq(total, 6)
}

test "Option[Map[Str,Int]] from a fn return reads its value back" {
    let o = make_opt_map()
    let m = o.unwrap()
    assert_eq(m.get("k").unwrap(), 9)
}

test "Option[Option[Int]] nested unwraps both layers" {
    let o: Option[Option[Int]] = Some(Some(5))
    let inner = o.unwrap()
    assert_eq(inner.unwrap(), 5)
}

test "a List[Option[Int]] element temp unwraps through the metavar inner" {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(8))
    let v = xs.get(0).unwrap()
    assert_eq(v.unwrap(), 8)
}
