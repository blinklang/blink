// Option[Map[Str, GenericStruct[T]]] keeps the value's generic instance type
// through unwrap().get().unwrap(), for a Str-keyed map.

type Box[T] { value: T }

test "opt map str box" {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 42 })
    let o: Option[Map[Str, Box[Int]]] = Some(m)
    let b = o.unwrap().get("k").unwrap()
    assert_eq(b.value, 42)
}
