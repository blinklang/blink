// e8n2n3: Option[Errno] must flatten the transparent newtype the same way
// Result[_, Errno] does. Before the fix, three codegen sites assumed a boxed
// payload: the Option typedef boxed the value as int64_t*, Some(Errno(rc))
// resolved to the wrong carrier name (Option_int vs Option_Errno), and the
// match value-binding deref'd a bare int64_t as (*(blink_Errno*).value),
// producing a hard C compile error.

pub type Errno { Errno(Int) }

fn maybe(x: Int) -> Option[Errno] {
    if x < 0 { Some(Errno(7)) } else { None }
}

fn describe(x: Int) -> Str {
    match maybe(x) {
        Some(Errno(rc)) => "some {rc}"
        None => "none"
    }
}

test "Some(Errno) through Option carrier binds the bare scalar payload" {
    assert_eq(describe(-1), "some 7")
}

test "None through Option[Errno] carrier matches the None arm" {
    assert_eq(describe(1), "none")
}

// The transparent inner can also reach Some as a VARIABLE, not just a literal
// Errno(..) call. emit_let_binding's transparent carve-out lowers `let e =
// Errno(..)` to a bare int64_t and drops the enum tracking, so the Some wrapper
// must recover the carrier from the enclosing Option[Errno] return annotation,
// not box it or fall back to Option_int (gap caught in e8n2n3 code-review).
fn wrap_var(x: Int) -> Option[Errno] {
    if x < 0 {
        let e = Errno(9)
        Some(e)
    } else {
        None
    }
}

fn describe_var(x: Int) -> Str {
    match wrap_var(x) {
        Some(Errno(rc)) => "some {rc}"
        None => "none"
    }
}

test "Some(var) where var is a transparent-newtype variable stays Option_Errno" {
    assert_eq(describe_var(-1), "some 9")
}

test "None path of the variable-fed Option[Errno] still matches None" {
    assert_eq(describe_var(1), "none")
}
