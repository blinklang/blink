// Unwrapping an Option[Ptr[T]] yields a void* rather than a T*, so a field
// read through the unwrapped value emits a void* dereference and cc rejects
// it. The pointer itself is written and read correctly before it goes into
// the Option; only field access through the value that comes back out of
// `.unwrap()` is affected. This is a different mechanism from field access
// through a Ptr stored in a plain struct field: here the Ptr passes through
// an Option carrier's unwrap path, not a struct field declaration.

import compile_test_helpers.{compile_and_run}

test.failing(
    "field access through an unwrapped Option[Ptr[T]] compiles",
    reason: "Option[Ptr[T]].unwrap() gives a void* instead of a pointer to the pointee type, so the field read through it dereferences void* and cc rejects it with 'request for member x in something not a structure or union'",
) {
    let src = #"
import std.io

@ffi.struct
type RPoint { x: Int, y: Int }

fn main() {
    with ffi.scope() as scope {
        let p: Ptr[RPoint] = scope.alloc()
        p.write(RPoint { x: 11, y: 12 })
        let op: Option[Ptr[RPoint]] = Some(p)
        let got = if op.is_some() { op.unwrap().x.read() } else { 0 }
        io.println("{got}")
    }
}
"#
    let r = compile_and_run(src, "_option_ptr_unwrap_pointee_field_access")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "11\n")
}
