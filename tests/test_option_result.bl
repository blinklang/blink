test "option Some and None" {
    let x = Some(42)
    let y: Int? = None
    io.println("Option created: Some and None")
}

test "result Ok and Err" {
    // A one-sided carrier leaves its other slot under-determined, so it needs an
    // annotation — uniformly with the `let y: Int? = None` above.
    let ok_val: Result[Int, Str] = Ok(100)
    let err_val: Result[Int, Str] = Err("something went wrong")
    io.println("Result created: Ok and Err")
}
