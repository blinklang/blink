// Option[Result[T, E]] construction must recover the Result's err type E from
// the let annotation, not default it to Str.

type Point { x: Int, y: Int }

fn check() -> Str {
    let x: Option[Result[Point, Int]] = Some(Ok(Point { x: 1, y: 2 }))
    match x {
        Some(r) => match r {
            Ok(p) => "ok:{p.x}"
            Err(e) => "err:{e}"
        }
        None => "none"
    }
}

fn check_bare() -> Int {
    let y: Result[Point, Int] = Ok(Point { x: 5, y: 6 })
    match y {
        Ok(p) => p.x
        Err(e) => e
    }
}

test "an Option[Result[struct, Int]] recovers the annotated Int err type" {
    assert_eq(check(), "ok:1")
}

test "a bare Result[struct, Int] recovers the annotated Int err type" {
    assert_eq(check_bare(), 5)
}
