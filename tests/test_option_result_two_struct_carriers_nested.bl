// A Result[Foo, Bar] nested inside an Option must keep both struct arms
// (Foo for Ok, Bar for Err) distinct; the Err struct must not erase to a
// scalar/string placeholder.

type Foo { a: Int }
type Bar { b: Int }

test "Option of Result of two structs" {
    let o: Option[Result[Foo, Bar]] = Some(Ok(Foo { a: 1 }))
    let r = o.unwrap()
    assert_eq(r.unwrap().a, 1)
}
