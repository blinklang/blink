// Locks the Option carrier readers against the name-reuse shape a tid-led reader
// guard changes behavior on. When a callee param reuses a caller local's name with
// a different Option inner type, the readers (option-inner2, inner2-struct,
// inner-tp) must answer for the binding in scope at each read, never a stale outer
// one. The rows drive the value-struct reader through .unwrap() on a List/Map inner
// and the nested-inner reader through Option[Option[.]].
//
// The block-scoped counterpart (an inner block shadowing an outer Option with a
// different inner type) is a separate open codegen bug and is deliberately not
// exercised here — see the tracked ticket.

type Tag { label: Str }

fn opt_first_label(x: Option[List[Tag]]) -> Str {
    x.unwrap().get(0).unwrap().label
}

test "a callee option param named like a caller local reads its own inner struct" {
    let mut x: Option[Int] = Some(1)
    let mut x2: Option[List[Tag]] = Some([Tag { label: "t" }])
    assert_eq(opt_first_label(x2), "t")
    assert_eq(x.unwrap(), 1)
}

test "an option over a map with a struct value reads its inner struct" {
    let mut m: Map[Str, Tag] = Map()
    m.insert("k", Tag { label: "mv" })
    let om: Option[Map[Str, Tag]] = Some(m)
    assert_eq(om.unwrap().get("k").unwrap().label, "mv")
}

test "an option of option nested inner round-trips" {
    let oo: Option[Option[Int]] = Some(Some(9))
    assert_eq(oo.unwrap().unwrap(), 9)
}
