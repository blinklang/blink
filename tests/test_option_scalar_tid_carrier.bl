// The tid is the authority for a List/Map Option-temp scalar carrier: the
// List.get/pop and Map.get producers (emit_list_method / emit_map_method scalar
// branches) and the get_var_option_inner reader spell the PRECISE scalar carrier
// (blink_Option_bool / blink_Option_char / blink_Option_bytes / ...) from the tid.
// Producer and consumer must agree on the carrier for a non-int scalar element,
// and a pointer-backed scalar (Bytes) needs a pointer cast, not the intptr cast.

import std.bytes.{bytes_from_str}

test "list of bool elems get+unwrap" {
    let mut bs: List[Bool] = []
    bs.push(true)
    bs.push(false)
    assert_eq(bs.get(0).unwrap(), true)
    assert_eq(bs.get(1).unwrap(), false)
}

test "list of char elems get+unwrap" {
    let mut cs: List[Char] = []
    cs.push('h')
    cs.push('i')
    assert_eq(cs.get(0).unwrap(), 'h')
    assert_eq(cs.get(1).unwrap(), 'i')
}

test "list of bool elems pop+unwrap" {
    let mut bs: List[Bool] = []
    bs.push(false)
    bs.push(true)
    assert_eq(bs.pop().unwrap(), true)
    assert_eq(bs.pop().unwrap(), false)
}

test "list of char elems pop+unwrap" {
    let mut cs: List[Char] = []
    cs.push('a')
    cs.push('z')
    assert_eq(cs.pop().unwrap(), 'z')
    assert_eq(cs.pop().unwrap(), 'a')
}

test "map with bool value get+unwrap" {
    let mut mb: Map[Str, Bool] = Map()
    mb.insert("on", true)
    mb.insert("off", false)
    assert_eq(mb.get("on").unwrap(), true)
    assert_eq(mb.get("off").unwrap(), false)
}

test "map with char value get+unwrap" {
    let mut mc: Map[Int, Char] = Map()
    mc.insert(1, 'a')
    mc.insert(2, 'b')
    assert_eq(mc.get(1).unwrap(), 'a')
    assert_eq(mc.get(2).unwrap(), 'b')
}

test "list of bytes elems get+unwrap" {
    let mut xs: List[Bytes] = []
    xs.push(bytes_from_str("hi"))
    xs.push(bytes_from_str("world"))
    assert_eq(xs.get(0).unwrap().len(), 2)
    assert_eq(xs.get(1).unwrap().len(), 5)
}

test "list of bytes elems pop+unwrap" {
    let mut xs: List[Bytes] = []
    xs.push(bytes_from_str("hi"))
    xs.push(bytes_from_str("world"))
    assert_eq(xs.pop().unwrap().len(), 5)
    assert_eq(xs.pop().unwrap().len(), 2)
}

test "map with bytes value get+unwrap" {
    let mut mv: Map[Str, Bytes] = Map()
    mv.insert("a", bytes_from_str("x"))
    mv.insert("b", bytes_from_str("yz"))
    assert_eq(mv.get("a").unwrap().len(), 1)
    assert_eq(mv.get("b").unwrap().len(), 2)
}
