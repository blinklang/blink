// br fyat2w — `Option[Set[T]].unwrap()` must take its element from the call it is unwrapping, not
// from whatever list-producing declaration happened to be emitted last.
//
// The CT_SET unwrap arm threads the element from `get_var_option_inner2(obj_str)`. For a CALL
// receiver, `obj_str` is the C call expression (`blink_u_oset()`), which has no ScopeVar — so it
// answers nothing and the unwrapped set is left with NO element at all. A later `for` over it then
// falls back to the stale `expr_list_elem_*` globals, which the last emitted list-producing fn body
// left behind. The element therefore depends on an UNCALLED declaration elsewhere in the file:
//
//   with `fn olist() -> Option[List[Str]]` present, `for x in oset().unwrap()` decodes Str
//   with it deleted, the same program prints 9
//   with no list producer anywhere, the element is unset and the for-in ICEs
//
// That is not a near miss between two spellings of one type. It is one declaration reaching into
// another's codegen, and it is why every row below asserts a value: the shape compiles.

type Pt { x: Int, y: Int }

fn oset_int() -> Option[Set[Int]] {
    let mut s: Set[Int] = Set()
    s.insert(4)
    s.insert(5)
    Some(s)
}

fn oset_str() -> Option[Set[Str]] {
    let mut s: Set[Str] = Set()
    s.insert("q")
    s.insert("rr")
    Some(s)
}

// The contaminants. Neither is called from any row here; their presence alone used to decide what
// the unwrapped Set above iterated as.
fn olist_str() -> Option[List[Str]] { Some(["a", "bb"]) }

fn olist_pt() -> Option[List[Pt]] { Some([Pt { x: 5, y: 1 }]) }

test "an unwrapped Set keeps its own element, not a neighbouring list's" {
    let st = oset_int().unwrap()
    let mut n = 0
    for x in st { n = n + x }
    assert_eq(n, 9)
    assert_eq(st.len(), 2)
    assert(st.contains(4))
    assert(!st.contains(9))
}

test "an unwrapped Set[Str] keeps its own element too" {
    let st = oset_str().unwrap()
    let mut acc = 0
    for s in st { acc = acc + s.len() }
    assert_eq(acc, 3)
    assert(st.contains("rr"))
}

test "unwrapping in expression position is the same seam" {
    let mut n = 0
    for x in oset_int().unwrap() { n = n + x }
    assert_eq(n, 9)
}

test "the contaminant declarations still work themselves" {
    let l = olist_str().unwrap()
    let mut acc = ""
    for s in l { acc = "{acc}{s}" }
    assert_eq(acc, "abb")

    let p = olist_pt().unwrap()
    assert_eq(p.get(0).unwrap().x, 5)
}
