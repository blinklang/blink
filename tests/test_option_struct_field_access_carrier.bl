type Inner {
    x: Int
}

type Outer {
    v: Option[Inner] = None
}

test "Option[struct] field access adopts inner struct carrier" {
    let o = Outer { v: None }
    assert_eq(o.v.is_none(), 1)
}

test "Option[struct] field access round-trips Some(struct)" {
    let o = Outer { v: Some(Inner { x: 7 }) }
    assert_eq(o.v.unwrap().x, 7)
}
