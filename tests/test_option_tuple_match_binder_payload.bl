import compile_test_helpers

// Matching an Option[(Int, Str)] must read the tuple payload as a by-value
// aggregate at the Some(t) binder, not the boxed/scalar carrier slot.

fn option_tuple_match_binder_src() -> Str {
    #"fn opt_tuple() -> Option[(Int, Str)] { Some((7, "a")) }
fn main() ! IO {
    match opt_tuple() {
        Some(t) => { io.println("v={t.0}") }
        None => { io.println("none") }
    }
}
"#
}

test.failing(
    "matching an Option of tuple reads the tuple payload correctly",
    reason: "the Option[(Int, Str)] carrier stores the tuple payload boxed, but the Some(t) match binder reads it as a by-value Tuple2 aggregate without the box cast/deref, so cc rejects the initializer",
    ticket: "jbk7yg",
) {
    let r = compile_test_helpers.compile_and_run(option_tuple_match_binder_src(), "_option_tuple")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v=7\n")
}
