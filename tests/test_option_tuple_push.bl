// A call-returned Option[tuple] pushed into List[Option[tuple]] must box under the
// carrier the callee returns (blink_Option_Tuple2_...), not the flat-erased Option_void.
// The push box-typing path (emit_boxed_container_store CT_OPTION) had no struct name and a
// CT_VOID inner for a tuple, so it spelled Option_void and cc rejected the store. Recover
// the element-option's tuple/struct inner from the list tid instead. Sibling of the
// Option[struct] and Result carrier reconstructions on push.

type Point { x: Int, y: Int }

fn find_prim(n: Int) -> Option[(Int, Int)] {
    if n == 0 { Some((1, 2)) } else { None }
}

fn find_struct(n: Int) -> Option[(Point, Int)] {
    if n == 0 { Some((Point { x: 3, y: 4 }, 9)) } else { None }
}

fn main() {
    // Primitive-tuple inner via a call return.
    let mut xs: List[Option[(Int, Int)]] = []
    xs.push(find_prim(0))
    xs.push(find_prim(1))
    let a = xs.get(0).unwrap()
    match a {
        Some(t) => {
            assert_eq(t.0 == 1, true)
            assert_eq(t.1 == 2, true)
        }
        None => assert_eq(1, 0)
    }
    let b = xs.get(1).unwrap()
    match b {
        Some(_t) => assert_eq(1, 0)
        None => assert_eq(1, 1)
    }

    // Struct-carrying tuple inner via a call return.
    let mut ys: List[Option[(Point, Int)]] = []
    ys.push(find_struct(0))
    let c = ys.get(0).unwrap()
    match c {
        Some(t) => {
            assert_eq(t.0.x == 3, true)
            assert_eq(t.1 == 9, true)
        }
        None => assert_eq(1, 0)
    }

    // A direct Some-literal push of the same shape stays correct (regression pin).
    let mut zs: List[Option[(Int, Int)]] = []
    zs.push(Some((5, 6)))
    let d = zs.get(0).unwrap()
    match d {
        Some(t) => assert_eq(t.1 == 6, true)
        None => assert_eq(1, 0)
    }
}
