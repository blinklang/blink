// `Option[(A, B)].unwrap()` (e.g. `list.get(i).unwrap()` over a List of tuples)
// and `Result[(A, B), E].unwrap()` each materialize an `_ounv_`/`_runv_` codegen
// temp that is registered CT_STRUCT with the tuple carrier name (Tuple2_int_int)
// on the flat ScopeVar.sname channel. The tuple's tid has ct -1 (TyKind.Tuple,
// not CT_STRUCT), so the container-struct stamp used to skip it and the carrier
// name lived only on the flat channel. stamp_container_struct_temp now also
// stamps the tuple tid when it round-trips to that carrier name, so the tid
// leads. These guard field access through such a temp once the flat channel is
// gone, across both the Option-unwrap and Result-unwrap call sites.
fn build_int_pairs() -> List[(Int, Int)] {
    let mut ls: List[(Int, Int)] = []
    ls.push((7, 8))
    ls
}

fn build_mixed_pairs() -> List[(Int, Str)] {
    let mut ls: List[(Int, Str)] = []
    ls.push((3, "hi"))
    ls
}

fn build_int_pair_result() -> Result[(Int, Int), Str] {
    Ok((11, 4))
}

test "field read through an Option[tuple].unwrap() temp" {
    let g = build_int_pairs()
    let f = g.get(0).unwrap()
    assert_eq(f.0 + f.1, 15)
}

test "mixed-type tuple keeps both element types through unwrap" {
    let g = build_mixed_pairs()
    let f = g.get(0).unwrap()
    let n: Int = f.0
    let s: Str = f.1
    assert_eq(n, 3)
    assert_eq(s, "hi")
}

test "field read directly on the unwrap result with no binding" {
    let g = build_int_pairs()
    assert_eq(g.get(0).unwrap().0, 7)
}

test "field read through a Result[tuple].unwrap() temp" {
    let f = build_int_pair_result().unwrap()
    assert_eq(f.0 + f.1, 15)
}
