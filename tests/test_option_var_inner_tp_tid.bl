// qf1vzx tp_id retirement, the last flat-pool reader: get_var_option_inner_tp read
// the DIRECT inner tp of an Option var from the pool child (tp_get_child1(sv.tp_id))
// for a container/Option/Set inner, while its tid path only peeled to a Map/List/
// Result floor. Two inner shapes were pool-only: an Option[Set[T]] (the tid tk-check
// excluded Set) and an Option[Option[container]] (only the pool returned the direct
// nested inner, not the peeled floor). The tid must spell the DIRECT inner for every
// one of these so the flat pool child can go. An erased Set/nested inner emits a
// carrier with an erased element and the C compiler rejects it, so each row is a
// compile-or-crash observation, not a silent decode-to-Int.

@derive(Hash, Eq)
type Pt { x: Int, y: Int }

test "rebound Option[Set[Int]] keeps the set inner across the copy" {
    let mut s: Set[Int] = Set()
    s.insert(1)
    s.insert(2)
    let x: Option[Set[Int]] = Some(s)
    let y = x
    match y {
        Some(ss) => assert_eq(ss.len(), 2)
        None => assert(false)
    }
}

test "rebound Option[List[Int]] keeps the list element across the copy" {
    let x: Option[List[Int]] = Some([10, 20, 30])
    let y = x
    match y {
        Some(xs) => {
            assert_eq(xs.len(), 3)
            assert_eq(xs.get(2).unwrap(), 30)
        }
        None => assert(false)
    }
}

test "rebound Option[Map[Str, Int]] keeps the map value across the copy" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 42)
    let x: Option[Map[Str, Int]] = Some(m)
    let y = x
    match y {
        Some(mm) => assert_eq(mm.get("k").unwrap(), 42)
        None => assert(false)
    }
}

test "rebound Option[Result[Int, Str]] keeps the ok inner across the copy" {
    let x: Option[Result[Int, Str]] = Some(Ok(7))
    let y = x
    match y {
        Some(r) => {
            match r {
                Ok(v) => assert_eq(v, 7)
                Err(_) => assert(false)
            }
        }
        None => assert(false)
    }
}

test "rebound Option[Option[List[Int]]] keeps the doubly-nested list element" {
    let inner: Option[List[Int]] = Some([5, 6])
    let x: Option[Option[List[Int]]] = Some(inner)
    let y = x
    match y {
        Some(o) => {
            match o {
                Some(xs) => {
                    assert_eq(xs.len(), 2)
                    assert_eq(xs.get(1).unwrap(), 6)
                }
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "Option[Option[List]] from a List[Option[List]] element round-trips the inner list" {
    let mut a: List[Option[List[Int]]] = []
    a.push(Some([100, 200]))
    let cell = a.get(0)
    let cell2 = cell
    match cell2 {
        Some(o) => {
            match o {
                Some(xs) => assert_eq(xs.get(1).unwrap(), 200)
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "rebound Option[Set[Pt]] keeps the struct-set inner across the copy" {
    let mut s: Set[Pt] = Set()
    s.insert(Pt { x: 1, y: 2 })
    s.insert(Pt { x: 3, y: 4 })
    let x: Option[Set[Pt]] = Some(s)
    let y = x
    match y {
        Some(ss) => assert_eq(ss.len(), 2)
        None => assert(false)
    }
}
