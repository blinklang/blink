// Matching Some(v) on an Option[Void] must bind v as the (unit) Void value and
// take the Some arm, not fail to build. bind_pattern_vars' scalar-inner else-arm
// needs the same genuine-Void discriminator as emit_let_binding uses.

import compile_test_helpers.{compile_and_run}

test "Some(v) match arm over Option[Void] takes the Some branch and builds" {
    let src = #"
fn nothing() { }
fn main() ! IO {
    let o: Option[Void] = Some(nothing())
    match o {
        Some(v) => io.println("some")
        None => io.println("none")
    }
}
"#
    let r = compile_and_run(src, "_option_void_binder_scalar_arm")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "some\n")
}
