// Map[Str, Result[Int, Str]].insert's value carrier must box the VALUE type
// (Result[Int, Str]) regardless of whether the map itself is later wrapped in an
// outer Option/Result return. Wrapping the map in an Option return bleeds the
// outer map type into the insert-value expected-type derivation, so the Ok slot
// is boxed as blink_Result_map_str (ok: blink_map*) instead of blink_Result_int_str
// (ok: int64_t), and the literal Ok(99) initializer makes a pointer from an int.

import compile_test_helpers.{compile_and_run}

test.failing(
    "Map[Str,Result[Int,Str]].insert keeps the value carrier's own type when the map is wrapped in an outer Option return",
    reason: "the insert-value expected-type derivation reads a flat channel that bleeds the outer Option[Map[...]] return's map type into the Result value carrier, so blink_Result_map_str (ok: blink_map*) is used instead of blink_Result_int_str (ok: int64_t), and Ok(99) tries to initialize a pointer field from an int literal, failing to compile",
    ticket: "d5c5se",
) {
    let src = #"
import std.io

fn mk() -> Option[Map[Str, Result[Int, Str]]] {
    let mut m: Map[Str, Result[Int, Str]] = Map()
    m.insert("k", Ok(99))
    Some(m)
}

fn main() ! IO {
    match mk() {
        Some(m) => match m.get("k").unwrap() {
            Ok(v) => io.println("ok {v}")
            Err(e) => io.println("err {e}")
        }
        None => io.println("none")
    }
}
"#
    let r = compile_and_run(src, "_option_wrapped_map_result_insert_value_carrier")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok 99\n")
}
