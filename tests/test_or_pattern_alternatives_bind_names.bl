// An OR-pattern binds each name once for its arm, and the arm body reads the value from
// whichever alternative matched (sections/03_types.md §3.5 *OR-Patterns*).

type Event { Click(Int, Int), Touch(Int, Int), Key(Str), Quit }

type Shape { Circle(Int), Square(Int), Tri(Int), Dot }

type Pt { x: Int, y: Int }

type Wrapped { Plain(Pt), Boxed(Pt), Empty }

fn input_sum(e: Event) -> Int {
    match e {
        Event.Click(x, y) | Event.Touch(x, y) => x * 10 + y
        Event.Key(_) => -1
        Event.Quit => -2
    }
}

fn size(s: Shape) -> Int {
    match s {
        Circle(n) | Square(n) | Tri(n) => n
        Dot => 0
    }
}

fn nested(r: Result[Option[Int], Int]) -> Int {
    match r {
        Ok(Some(v)) | Err(v) => v
        Ok(None) => -1
    }
}

fn field_x(w: Wrapped) -> Int {
    match w {
        Plain(Pt { x, .. }) | Boxed(Pt { x, .. }) => x
        Empty => -1
    }
}

fn guarded(s: Shape) -> Str {
    match s {
        Circle(n) | Square(n) if n > 5 => "big {n}"
        Circle(n) | Square(n) => "small {n}"
        _ => "other"
    }
}

fn bumped(s: Shape) -> Int {
    match s {
        Circle(mut n) | Square(mut n) | Tri(mut n) => {
            n += 100
            n
        }
        Dot => 0
    }
}

fn bumped_in_closure(s: Shape) -> Int {
    match s {
        Circle(mut n) | Square(mut n) => {
            let bump = fn() { n += 10 }
            bump()
            n
        }
        _ => 0
    }
}

type Pair { L(Int, Str), R(Str, Int) }

fn joined(p: Pair) -> Str {
    match p {
        L(n, s) | R(s, n) => "{s}{n}"
    }
}

fn code_class(c: Int) -> Str {
    match c {
        200 | 201 | 204 => "ok"
        400 | 422 => "client"
        _ => "other"
    }
}

test "both alternatives of a two-way OR bind the same names" {
    assert_eq(input_sum(Event.Click(1, 2)), 12)
    assert_eq(input_sum(Event.Touch(3, 4)), 34)
    assert_eq(input_sum(Event.Key("a")), -1)
    assert_eq(input_sum(Event.Quit), -2)
}

test "each alternative of a three-way OR binds the name" {
    assert_eq(size(Shape.Circle(1)), 1)
    assert_eq(size(Shape.Square(2)), 2)
    assert_eq(size(Shape.Tri(3)), 3)
    assert_eq(size(Shape.Dot), 0)
}

test "a nested payload binds from either alternative" {
    assert_eq(nested(Ok(Some(5))), 5)
    assert_eq(nested(Err(7)), 7)
    assert_eq(nested(Ok(None)), -1)
}

test "a struct field binder binds from either alternative" {
    assert_eq(field_x(Wrapped.Plain(Pt { x: 1, y: 2 })), 1)
    assert_eq(field_x(Wrapped.Boxed(Pt { x: 3, y: 4 })), 3)
    assert_eq(field_x(Wrapped.Empty), -1)
}

test "a guard reads the name bound by the alternative that matched" {
    assert_eq(guarded(Shape.Circle(9)), "big 9")
    assert_eq(guarded(Shape.Square(7)), "big 7")
    assert_eq(guarded(Shape.Circle(2)), "small 2")
    assert_eq(guarded(Shape.Square(1)), "small 1")
    assert_eq(guarded(Shape.Tri(9)), "other")
}

test "a mut binder in every alternative can be changed" {
    assert_eq(bumped(Shape.Circle(1)), 101)
    assert_eq(bumped(Shape.Square(2)), 102)
    assert_eq(bumped(Shape.Tri(3)), 103)
    assert_eq(bumped(Shape.Dot), 0)
}

test "a closure that changes a mut OR binder changes the arm's binding" {
    assert_eq(bumped_in_closure(Shape.Circle(1)), 11)
    assert_eq(bumped_in_closure(Shape.Square(2)), 12)
    assert_eq(bumped_in_closure(Shape.Dot), 0)
}

test "alternatives may bind the names in different positions" {
    assert_eq(joined(Pair.L(1, "a")), "a1")
    assert_eq(joined(Pair.R("b", 2)), "b2")
}

test "literal alternatives bind no names" {
    assert_eq(code_class(201), "ok")
    assert_eq(code_class(422), "client")
    assert_eq(code_class(500), "other")
}
