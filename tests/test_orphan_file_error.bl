// Tests E1010 OrphanFile: a source file with no enclosing blink.toml
// cannot use bare external imports (only std.* / pkg.* / absolute paths).

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_orphan_file"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    // --- Test 1: bare external import from orphan file → E1010 ---
    fs.write("{base}/orphan.bl", "import notpkg\n\nfn main() \{\n    io.println(\"unreachable\")\n}\n").unwrap()
    process.run("sh", ["-c", "cd {base} && {blink} check orphan.bl > err.txt 2>&1; true"]).unwrap()
    let err1 = fs.read("{base}/err.txt").unwrap()
    if err1.contains("OrphanFile") {
        io.println("PASS: orphan file with bare external import emits OrphanFile/E1010")
    } else {
        io.println("FAIL: expected OrphanFile for orphan bare import, got: {err1}")
    }

    // --- Test 2: orphan file with only std import is allowed ---
    fs.write("{base}/orphan_std.bl", "import std.path.\{path_join\}\n\nfn main() \{\n    io.println(path_join(\"a\", \"b\"))\n}\n").unwrap()
    process.run("sh", ["-c", "cd {base} && {blink} check orphan_std.bl > err2.txt 2>&1; true"]).unwrap()
    let err2 = fs.read("{base}/err2.txt").unwrap()
    if err2.contains("OrphanFile") {
        io.println("FAIL: orphan file with std-only imports should not emit OrphanFile, got: {err2}")
    } else {
        io.println("PASS: orphan file with std-only imports compiles without OrphanFile")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
