// A whole import binds only its qualifier (sections/07), so a bare call in the file means the
// file's own function, even where the module declares a generic function of the same name.

import std.map
import std.random

fn shuffle(n: Int) -> Int {
    n + 1
}

fn map_merge(n: Int) -> Int {
    n * 2
}

test "a bare call of shuffle is the file's own fn and random.shuffle is std.random's" {
    assert_eq(shuffle(1), 2)
    assert_eq(random.shuffle([7]), [7])
}

test "a bare call of map_merge is the file's own fn and map.map_merge is std.map's" {
    assert_eq(map_merge(4), 8)
    let a: Map[Int, Int] = Map()
    let mut b: Map[Int, Int] = Map()
    b.insert(1, 2)
    assert_eq(map.map_merge(a, b).len(), 1)
}
