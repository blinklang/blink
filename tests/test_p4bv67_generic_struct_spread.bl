// p4bv67: struct spread over a generic struct must copy the unprovided fields.
// The spread-fill loop filtered sf_entries by the BARE base name while a
// generic instance registers its rows under the mono name (Box_Int), so no
// `.field = spread.field` initializer was emitted and the field stayed zero.

type Box[T] { value: T, tag: Int }
type BoxNonGen { value: Int, tag: Int }

fn base() -> Box[Int] { Box { value: 7, tag: 1 } }
fn base_ng() -> BoxNonGen { BoxNonGen { value: 7, tag: 1 } }

test "generic struct spread copies the unprovided field" {
    let b: Box[Int] = Box { tag: 2, ..base() }
    assert_eq(b.value, 7)
    assert_eq(b.tag, 2)
}

test "non-generic twin spread still works" {
    let b: BoxNonGen = BoxNonGen { tag: 2, ..base_ng() }
    assert_eq(b.value, 7)
    assert_eq(b.tag, 2)
}
