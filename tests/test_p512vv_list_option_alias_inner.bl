// A List whose element is an Option carrier over a TRANSPARENT struct alias
// (type UserId = Point) spelled its element carrier with the alias inner ERASED
// to blink_Option_void: the flat oi_tp channel resolved the alias to void
// instead of hopping it to the target struct, so the .unwrap() consumer read a
// carrier the producer never spelled. The carrier must be recovered from the
// receiver's node tid, which hops transparent aliases to the target struct.
// Distinct axis from b7zdk3/wcz075 (Map inner): alias-hop, not container-inner.

type Point { x: Int, y: Int }
type UserId = Point

type AHolder {
    rows: List[Option[UserId]]
}

fn get_local() -> Int {
    let xs: List[Option[UserId]] = [Some(Point { x: 3, y: 4 })]
    xs.get(0).unwrap().unwrap().x
}

fn find_field_bound() -> Int {
    let h = AHolder { rows: [Some(Point { x: 5, y: 6 })] }
    h.rows.find(fn(e: Option[UserId]) -> Bool { e.is_some() }).unwrap().unwrap().y
}

fn filter_field_bound() -> Int {
    let h = AHolder { rows: [Some(Point { x: 8, y: 1 })] }
    h.rows.filter(fn(e: Option[UserId]) -> Bool { e.is_some() }).collect().get(0).unwrap().unwrap().x
}

test "List[Option[alias]] element hops the alias through get/unwrap" {
    assert_eq(get_local(), 3)
}

test "List[Option[alias]] element hops the alias through find" {
    assert_eq(find_field_bound(), 6)
}

test "List[Option[alias]] element hops the alias through filter adapter" {
    assert_eq(filter_field_bound(), 8)
}
