type Key {
    Char(ch: Char)
}

// Builtin *variant* names (Ok/Err/Some) collide the same way as primitive type
// names — stdlib uses Ok/Err everywhere, so a private user variant named `Ok`
// registered as private would poison their resolution into spurious stdlib E1003.
type MyResult {
    Ok(v: Int)
    Bad(e: Str)
}

test "user enum variant named Char coexists with builtin Char, no stdlib E1003" {
    let k = Key.Char(ch: 'a')
    match k {
        Key.Char(ch) => assert(ch == 'a')
    }
}

test "user enum variant named Ok coexists with builtin Ok, no stdlib E1003" {
    let r = MyResult.Ok(v: 5)
    match r {
        Ok(v) => assert(v == 5)
        Bad(_e) => assert(false)
    }
}
