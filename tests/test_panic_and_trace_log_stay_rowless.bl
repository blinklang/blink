// `panic` and `trace.log` need no row (sections/04_effects.md §4.4, sections/06_tooling.md
// §8.15.7): a fn that has no row may call them.

import compile_test_helpers

test "a fn with no row may panic" {
    let out = compile_test_helpers.compile_and_capture(#"fn f(n: Int) -> Int {
    if n < 0 { panic("negative") }
    n
}
fn main() {
    io.println("{f(1)}")
}
"#, "rowless_panic")
    compile_test_helpers.expect_compiles_clean(out, "panic")
}

test "a fn with no row may call trace.log" {
    let out = compile_test_helpers.compile_and_capture(#"fn f(n: Int) -> Int {
    trace.log("c", "n is {n}")
    n
}
fn main() {
    io.println("{f(1)}")
}
"#, "rowless_trace_log")
    compile_test_helpers.expect_compiles_clean(out, "trace.log")
}
