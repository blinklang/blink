// A source file path containing a literal `%` must never reach a printf/vsnprintf
// FORMAT string for a panic (div/mod/shift/overflow guards). Otherwise the `%`
// becomes an unmatched conversion spec with no vararg -> UB / garbage / crash.
// The panic passes the path to the runtime as a value of its own, and the
// runtime prints it through `%s`, so the path stays raw and is never escaped.
// C-emission check (deterministic): a div-by-zero fixture at a `%`-containing
// path must pass the raw path to the panic entry, and no format holds it.
import compile_test_helpers

test "a panic file path with a percent goes to the runtime as a value, not in a format" {
    let dir = "{compile_test_helpers.scratch_root()}/pct%dir_{getpid()}"
    process.run("sh", ["-c", "rm -rf '{dir}'"])?
    process.run("sh", ["-c", "mkdir -p '{dir}'"])?
    let src = "fn main() \{\n    let z = 0\n    let _ = 1 / z\n\}\n"
    // Unique basename so the emitted build/<base>.c does not collide with
    // sibling test workers (basename, not just dir, must be unique).
    let fixture = "{dir}/pctfmt_{getpid()}.bl"
    fs.write(fixture, src).unwrap()
    let result = process.run("build/blink", ["build", fixture, "--emit", "c"])?
    let output = "{result.out}{result.err_out}"
    // `emitted: build/<base>.c` -> recover the exact path it wrote.
    let marker = "emitted: "
    let idx = output.byte_index_of(marker, 0) ?? -1
    assert(idx >= 0)
    let after = output.byte_slice(idx + marker.byte_len(), output.byte_len())
    let c_path = after.trim_right()
    let c_src = fs.read(c_path).unwrap()
    // The panic entry is given the raw path as its file argument.
    let mut passed_raw = false
    for line in c_src.split("\n") {
        if line.contains("__blink_panic_dispatch_at(") && line.contains("/pctfmt_{getpid()}.bl\" + 16)") {
            passed_raw = line.contains("pct%dir")
        }
    }
    assert(passed_raw)
    // No string escapes the path for a format, and no panic sentence is built with it.
    assert(!c_src.contains("pct%%dir"))
    assert(!c_src.contains("at {compile_test_helpers.scratch_root()}/pct%dir"))
    process.run("sh", ["-c", "rm -rf '{dir}'"])?
    process.run("sh", ["-c", "rm -f '{c_path}'"])?
}

// Runtime check (proves no UB): running the same fixture must emit the
// `division by zero` panic with the literal intact path (printf un-doubles
// `%%` back to a single `%`).
test "panic at percent path runs without UB and prints intact path" {
    let dir = "{compile_test_helpers.scratch_root()}/pctrun%dir_{getpid()}"
    process.run("sh", ["-c", "rm -rf '{dir}'"])?
    process.run("sh", ["-c", "mkdir -p '{dir}'"])?
    let src = "fn main() \{\n    let z = 0\n    let _ = 1 / z\n\}\n"
    let fixture = "{dir}/pctrun_{getpid()}.bl"
    fs.write(fixture, src).unwrap()
    let result = process.run("build/blink", ["run", fixture])?
    let combined = "{result.out}{result.err_out}"
    assert(combined.contains("division by zero"))
    // printf collapses `%%` -> `%`, so the displayed path is the literal one.
    assert(combined.contains("pctrun%dir"))
    process.run("sh", ["-c", "rm -rf '{dir}'"])?
    // `blink run` derives its outputs from the fixture basename -> build/<base>{.c}.
    let base = "pctrun_{getpid()}"
    process.run("sh", ["-c", "rm -f 'build/{base}' 'build/{base}.c'"])?
}
