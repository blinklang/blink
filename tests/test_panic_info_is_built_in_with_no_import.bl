// PanicInfo is a built-in type, so a program names it with no import
// (sections/02_syntax.md §2.20 *Panic Hook*). `main` does not run under the test runner, so
// a test checks a hook by calling it as a plain fn under mock_env, where `env.exit` panics.

import compile_test_helpers

test "PanicInfo holds the message, the file and a known line" {
    let p = PanicInfo { message: "ice", file: "a.bl", line: Some(3) }
    assert_eq(p.message, "ice")
    assert_eq(p.file, "a.bl")
    assert_eq(p.line, Some(3))
}

test "PanicInfo holds None for a line that is not known" {
    let p = PanicInfo { message: "ice", file: "a.bl", line: None }
    assert(p.line.is_none())
}

// The example of §2.20 *The hook in tests*, run as a test file of its own. It needs
// std.testing.mock_env, and the compiler has no mock_env yet.
fn hook_in_a_test_src() -> Str {
    #"import std.testing.{capture_print, mock_env}

fn report(p: PanicInfo) -> Never ! IO.Print, Env.Exit {
    io.println("fatal: {p.message}")
    env.exit(101)
}

test "report writes the status line and exits 101" {
    let out: List[Str] = []
    assert_panics(matching: "env.exit(101)") {
        with capture_print(out), mock_env(Map.new()).as_handler() {
            report(PanicInfo { message: "ice", file: "a.bl", line: Some(3) })
        }
    }
    assert(out.get(0).unwrap().contains("ice"))
}
"#
}

test.failing(
    "a test calls the hook as a plain fn under mock_env and assert_panics",
    reason: "std.testing has no mock_env, and a handler of Env cannot handle exit",
) {
    let r = compile_test_helpers.compile_and_run_test_json(hook_in_a_test_src(), "_hook_in_a_test")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert(r.out.contains("\"status\":\"passed\""), r.out)
}
