// br 8pj4b7: directly exercise panic_line_str's l <= 0 defensive branch.

import codegen_expr.{panic_line_str}
import parser.{nodes}
import ast.{AstNode}

test "panic_line_str returns <synthesized> for line <= 0" {
    let synth_id = nodes.len()
    nodes.push(AstNode { line: 0 })
    assert(panic_line_str(synth_id) == "<synthesized>")
}

test "panic_line_str returns decimal line for real source node" {
    let real_id = nodes.len()
    nodes.push(AstNode { line: 42 })
    assert(panic_line_str(real_id) == "42")
}
