// panic location encoding must be correct at the codegen layer.
//
// Companion to tests/test_panic_loc_synth_unwrap.bl (which exercises the
// happy path end-to-end at runtime). This test inspects the EMITTED C
// directly via `build/blink build --emit c`, asserting structural
// properties of panic_line_str's output without needing the runtime.
//
// What this guards (happy-path encoding):
//   - A real .unwrap() at a known source line passes the runtime its
//     message, its file and the correct numeric line, each as its own
//     value; the runtime joins them as `panic: <msg> at <file>:<line>`.
//   - The literal `"<synthesized>"` does NOT appear in the emitted C
//     when every panic site has a real source line — confirming the
//     defensive branch is not over-firing.
//
// Synth branch (l <= 0) is now covered by tests/test_panic_line_str_synth.bl.

import compile_test_helpers

fn emit_c(tag: Str, src: Str) -> Str ! FS.Write, Process.Spawn, FS.Read, Env.Read {
    let bl_path = "{compile_test_helpers.scratch_root()}/_test_{tag}.bl"
    fs.write(bl_path, src).unwrap()
    let _ = process.run("build/blink", ["build", bl_path, "--emit", "c"]).unwrap()
    let c_src = fs.read("build/_test_{tag}.c").unwrap()
    process.run("sh", ["-c", "rm -f {bl_path} build/_test_{tag}.c"]).unwrap()
    c_src
}

test "panic_line_str emits numeric line for real .unwrap() site" {
    // .unwrap() is on line 3 of this fixture.
    let src = "fn main() \{\n"
              .concat("    let o: Option[Int] = None\n")
              .concat("    let _ = o.unwrap()\n")
              .concat("\}\n")
    let c = emit_c("panic_loc_unwrap", src)
    // For a real source line, the line passed is the decimal node_line.
    assert(c.contains("unwrap called on None"))
    assert(c.contains("_test_panic_loc_unwrap.bl\" + 16), 3);"))
}

test "panic_line_str does not render <synthesized> for real source nodes" {
    // Any panic-emitting construct with a real source line must NOT
    // trip the `l <= 0` defensive branch. This guards against the
    // helper over-firing (e.g. if a future refactor accidentally
    // zeroes out lines for parsed nodes).
    let src = "fn main() \{\n"
              .concat("    let o: Option[Int] = None\n")
              .concat("    let _ = o.unwrap()\n")
              .concat("\}\n")
    let c = emit_c("panic_loc_no_synth", src)
    assert(!c.contains("<synthesized>"))
}

test "panic_line_str emits numeric line for sized-int overflow trap" {
    // Sized-integer arithmetic also flows through panic_line_str
    // (codegen_expr.bl:1625). Distinct emit site, same helper.
    // The arithmetic op is on line 3.
    let src = "fn main() \{\n"
              .concat("    let a: I32 = 2147483647\n")
              .concat("    let _ = a + a\n")
              .concat("\}\n")
    let c = emit_c("panic_loc_i32_ovf", src)
    assert(c.contains("I32 overflow"))
    assert(c.contains("_test_panic_loc_i32_ovf.bl\" + 16), 3);"))
    assert(!c.contains("<synthesized>"))
}
