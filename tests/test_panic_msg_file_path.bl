// A runtime panic that originates in module A must report module A's
// file path, not whichever module was last seen by the codegen pass.

fn main() {
    let pwd_res = process_run("sh", ["-c", "pwd -P"])
    let blink_root = pwd_res.out.trim_right()

    let base = ".tmp/_test_panic_msg_file_path_{getpid()}"
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}/src")

    write_file("{base}/blink.toml", "[package]\nname = \"panicfp\"\nversion = \"0.1.0\"\n\n[dependencies]\n")

    let util_src = "pub fn boom() -> Int \{\n    let o: Option[Int] = None\n    o.unwrap()\n\}\n"
    write_file("{base}/src/util.bl", util_src)

    let main_src = "import util.\{boom\}\n\nfn main() \{\n    io.println(boom())\n\}\n"
    write_file("{base}/src/main.bl", main_src)

    let cmd = "cd {base} && {blink_root}/build/blink run src/main.bl 2>&1"
    let result = process_run("sh", ["-c", cmd])
    let combined = "{result.out}{result.err_out}"

    shell_exec("rm -rf {base}")

    if !combined.contains("unwrap called on None") {
        io.println("FAIL: expected 'unwrap called on None' panic, got:")
        io.println(combined)
        return
    }
    if !combined.contains("util.bl:") {
        io.println("FAIL: expected panic to reference util.bl (where boom lives), got:")
        io.println(combined)
        return
    }
    if combined.contains("main.bl:") {
        io.println("FAIL: panic should not reference main.bl (boom lives in util.bl), got:")
        io.println(combined)
        return
    }
    io.println("PASS: panic message correctly points at util.bl")
}
