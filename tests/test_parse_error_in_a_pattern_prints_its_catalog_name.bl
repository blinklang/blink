// E1102 has its own catalog name, UnexpectedTokenPattern. The bracket must print that name, not
// the generic UnexpectedToken of E1100, or an author who searches the catalog finds a different rule.
import std.fs
import compile_test_helpers

fn run_human(path: Str, src: Str) -> Str ! FS.Delete {
    write_file(path, src)
    let args = [path, "/dev/null"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    let _ = fs.delete(path)
    output
}

test "a token that cannot start a pattern prints UnexpectedTokenPattern" {
    let src = "fn main() \{\n    let x = 1\n    match x \{\n        + => io.println(\"a\")\n        _ => io.println(\"b\")\n    }\n}\n"
    let output = run_human("{compile_test_helpers.scratch_root()}/_test_pattern_token_name.bl", src)
    assert(output.contains("error[UnexpectedTokenPattern]: unexpected token in pattern: +"), output)
}

test "a token after `mut` that cannot start a pattern prints UnexpectedTokenPattern" {
    let src = "fn main() \{\n    let x = 1\n    match x \{\n        mut + => io.println(\"a\")\n        _ => io.println(\"b\")\n    }\n}\n"
    let output = run_human("{compile_test_helpers.scratch_root()}/_test_mut_pattern_token_name.bl", src)
    assert(output.contains("error[UnexpectedTokenPattern]: expected a pattern after `mut`, got +"), output)
}
