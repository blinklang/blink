import compile_test_helpers

test "inline module emits E1015" {
    let src = "mod schema \{ fn validate() \{ \} \}\nfn main() \{ \}\n"
    compile_test_helpers.expect_compile_error(src, "parse_mod", "E1015")
}

test "unexpected token at top level emits E1100" {
    let src = "42\nfn main() \{ \}\n"
    compile_test_helpers.expect_compile_error(src, "parse_unexp", "E1100")
}

test "keyword as identifier emits E1103" {
    let src = "fn main() \{ let match = 42 \}\n"
    compile_test_helpers.expect_compile_error(src, "parse_kw", "E1103")
}

test "empty braces emits E1107" {
    let src = "fn main() \{ let _m = \{\} \}\n"
    compile_test_helpers.expect_compile_error(src, "parse_empty", "E1107")
}

test "embed nonexistent file emits E1108" {
    let src = "const data: Str = #embed(\"nonexistent_file_xyz.txt\")\nfn main() \{ \}\n"
    compile_test_helpers.expect_compile_error(src, "parse_embed", "E1108")
}

test "@module(\"\") emits E1008" {
    let src = "@module(\"\")\n\nfn main() \{ \}\n"
    compile_test_helpers.expect_compile_error(src, "module_empty", "E1008")
}

// E1106 — InterpParseFailure (br zk19j3, decisions/backticks-in-strings.md)
// An unparseable interpolation expression must produce ONE focused error
// at the `\{` position, not an E1100/E1101 cascade.

test "interp parse failure emits one focused E1106" {
    let src = "fn main() \{\n    let s = \"select `\{ pg.query(...) \}`\"\n    io.println(s)\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_fail_repro")
    assert(out.split("E1106").len() == 2)
    assert(!out.contains("E1100"))
    assert(!out.contains("E1101"))
    assert(out.split("\"severity\":\"error\"").len() == 2)
}

test "interp trailing garbage emits one focused E1106" {
    let src = "fn main() \{\n    let s = \"a \{select * from t\} b\"\n    io.println(s)\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_fail_trailing")
    assert(out.split("E1106").len() == 2)
    assert(!out.contains("E1100"))
    assert(!out.contains("E1101"))
    assert(out.split("\"severity\":\"error\"").len() == 2)
}

test "two broken interps in one string emit two E1106" {
    let src = "fn main() \{\n    let s = \"a \{1 + \} b \{2 *\} c\"\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_two_fail")
    assert(out.split("E1106").len() == 3)
    assert(!out.contains("E1100"))
    assert(!out.contains("E1101"))
}

// br ec8yz6 — a bare-brace interpolation body containing TWO+ escaped-quote
// string literals separated by a comma drove the parser into unbounded
// allocation (OOM). The recovery loop balanced only InterpStart/InterpEnd, so
// a nested StringEnd terminated it early, leaving string-structural tokens
// parked for parse_block's loop to spin on. Each fixture below must emit
// exactly ONE focused E1106 and terminate instantly.

test "interp with comma-separated string literals emits one E1106 (no OOM)" {
    let src = "fn main() \{\n    let s = \"\{\\\"a\\\",\\\"b\\\"\}\"\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_comma_strs")
    assert(out.split("E1106").len() == 2)
    assert(!out.contains("E1100"))
    assert(!out.contains("E1101"))
}

test "interp with map-shaped quoted keys emits one E1106 (no OOM)" {
    let src = "fn main() \{\n    let s = \"\{\\\"b\\\":1,\\\"c\\\":2\}\"\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_map_shape")
    assert(out.split("E1106").len() == 2)
    assert(!out.contains("E1100"))
}

test "interp with quoted-then-bare-ident emits one E1106 (boundary)" {
    let src = "fn main() \{\n    let s = \"\{\\\"a\\\",b\}\"\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_quoted_bare")
    assert(out.split("E1106").len() == 2)
    assert(!out.contains("E1100"))
}

test "well-formed interpolation unaffected by E1106" {
    let src = "fn main() \{\n    let x = 42\n    io.println(\"x is \{x\}\")\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_ok")
    assert(!out.contains("E1106"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "escaped brace string unaffected by E1106" {
    let src = "fn main() \{\n    io.println(\"literal \\\{ brace\")\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_escaped_brace")
    assert(!out.contains("E1106"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "raw string with braces unaffected by E1106" {
    let src = "fn main() \{\n    io.println(#\"select `\{ pg.query(...) \}`\"#)\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "interp_raw_string")
    assert(!out.contains("E1106"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "blink explain E1106 returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("E1106", "InterpParseFailure")
}
