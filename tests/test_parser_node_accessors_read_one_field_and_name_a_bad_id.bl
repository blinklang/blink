// Each parser node accessor returns the one field it names from the pool, a node read out of
// the pool is a copy that a later setter does not reach, and a bad id stops the compiler with a
// message that names the accessor rather than the generic list-index panic.

import compile_test_helpers
import parser.{node_at, node_count, node_push, node_set_int_val, node_set_name, node_args, node_arms, node_assoc_types, node_body, node_captures, node_col, node_condition, node_doc_comment, node_effects, node_elements, node_else_body, node_end, node_end_col, node_end_line, node_fields, node_for_binder, node_guard, node_handlers, node_impl_binders, node_impl_where_bounds, node_inclusive, node_index, node_int_val, node_is_const, node_is_mut, node_is_pub, node_iterable, node_kind, node_leading_comments, node_left, node_line, node_method, node_methods, node_module, node_name, node_obj, node_op, node_params, node_pattern, node_recv_type_args, node_return_type, node_right, node_scrutinee, node_start, node_stmts, node_str_val, node_supertraits, node_target, node_then_body, node_trailing_comments, node_trait_name, node_type_ann, node_type_name, node_type_params, node_value, node_var_name, node_xfail_reason}
import ast.{AstNode, NodeKind, nk_tag}

// Every field holds a value no other field holds, so an accessor that reads the wrong field fails.
fn push_distinct_node() -> Int {
    let id = node_count()
    node_push(AstNode {
        kind: NodeKind.Ident,
        int_val: 1001,
        str_val: "str_val-text",
        name: "name-text",
        op: "op-text",
        left: 1005,
        right: 1006,
        body: 1007,
        condition: 1008,
        then_body: 1009,
        else_body: 1010,
        scrutinee: 1011,
        pattern: 1012,
        guard: 1013,
        value: 1014,
        target: 1015,
        iterable: 1016,
        var_name: "var_name-text",
        is_mut: 1018,
        is_pub: 1019,
        is_const: 1020,
        module: "module-text",
        inclusive: 1022,
        start: 1023,
        end: 1024,
        obj: 1025,
        method: "method-text",
        index: 1027,
        return_type: "return_type-text",
        type_name: "type_name-text",
        trait_name: "trait_name-text",
        params: 1031,
        args: 1032,
        stmts: 1033,
        arms: 1034,
        fields: 1035,
        elements: 1036,
        methods: 1037,
        type_params: 1038,
        effects: 1039,
        captures: 1040,
        type_ann: 1041,
        handlers: 1042,
        leading_comments: "leading_comments-text",
        trailing_comments: "trailing_comments-text",
        doc_comment: "doc_comment-text",
        line: 1046,
        col: 1047,
        end_line: 1048,
        end_col: 1049,
        assoc_types: 1050,
        impl_binders: 1051,
        recv_type_args: 1052,
        impl_where_bounds: 1053,
        xfail_reason: "xfail_reason-text",
        for_binder: 1055,
        supertraits: 1056
    })
    id
}

test "each accessor returns the field it names" {
    let id = push_distinct_node()
    assert_eq(nk_tag(node_kind(id)), nk_tag(NodeKind.Ident))
    assert_eq(node_int_val(id), 1001)
    assert_eq(node_str_val(id), "str_val-text")
    assert_eq(node_name(id), "name-text")
    assert_eq(node_op(id), "op-text")
    assert_eq(node_left(id), 1005)
    assert_eq(node_right(id), 1006)
    assert_eq(node_body(id), 1007)
    assert_eq(node_condition(id), 1008)
    assert_eq(node_then_body(id), 1009)
    assert_eq(node_else_body(id), 1010)
    assert_eq(node_scrutinee(id), 1011)
    assert_eq(node_pattern(id), 1012)
    assert_eq(node_guard(id), 1013)
    assert_eq(node_value(id), 1014)
    assert_eq(node_target(id), 1015)
    assert_eq(node_iterable(id), 1016)
    assert_eq(node_var_name(id), "var_name-text")
    assert_eq(node_is_mut(id), 1018)
    assert_eq(node_is_pub(id), 1019)
    assert_eq(node_is_const(id), 1020)
    assert_eq(node_module(id), "module-text")
    assert_eq(node_inclusive(id), 1022)
    assert_eq(node_start(id), 1023)
    assert_eq(node_end(id), 1024)
    assert_eq(node_obj(id), 1025)
    assert_eq(node_method(id), "method-text")
    assert_eq(node_index(id), 1027)
    assert_eq(node_return_type(id), "return_type-text")
    assert_eq(node_type_name(id), "type_name-text")
    assert_eq(node_trait_name(id), "trait_name-text")
    assert_eq(node_params(id), 1031)
    assert_eq(node_args(id), 1032)
    assert_eq(node_stmts(id), 1033)
    assert_eq(node_arms(id), 1034)
    assert_eq(node_fields(id), 1035)
    assert_eq(node_elements(id), 1036)
    assert_eq(node_for_binder(id), 1055)
    assert_eq(node_methods(id), 1037)
    assert_eq(node_type_params(id), 1038)
    assert_eq(node_effects(id), 1039)
    assert_eq(node_captures(id), 1040)
    assert_eq(node_type_ann(id), 1041)
    assert_eq(node_handlers(id), 1042)
    assert_eq(node_leading_comments(id), "leading_comments-text")
    assert_eq(node_trailing_comments(id), "trailing_comments-text")
    assert_eq(node_doc_comment(id), "doc_comment-text")
    assert_eq(node_line(id), 1046)
    assert_eq(node_col(id), 1047)
    assert_eq(node_end_line(id), 1048)
    assert_eq(node_end_col(id), 1049)
    assert_eq(node_assoc_types(id), 1050)
    assert_eq(node_impl_binders(id), 1051)
    assert_eq(node_recv_type_args(id), 1052)
    assert_eq(node_impl_where_bounds(id), 1053)
    assert_eq(node_supertraits(id), 1056)
    assert_eq(node_xfail_reason(id), "xfail_reason-text")
}

test "a node read out of the pool keeps its value after a setter changes the pool" {
    let id = push_distinct_node()
    let before = node_at(id)
    node_set_int_val(id, 42)
    node_set_name(id, "renamed")
    assert_eq(before.int_val, 1001)
    assert_eq(before.name, "name-text")
    assert_eq(node_int_val(id), 42)
    assert_eq(node_name(id), "renamed")
    assert_eq(nk_tag(node_kind(id)), nk_tag(NodeKind.Ident))
}

// Reads a bad id in a child run of a plain build of this file, because the accessor ends the
// process.
fn assert_named_out_of_bounds(which: Str, want: Str) {
    let exe = compile_test_helpers.main_binary_of("tests/test_parser_node_accessors_read_one_field_and_name_a_bad_id.bl")
    let r = process_run("sh", ["-c", "NODE_READ_PROBE={which} {exe}"])
    let text = "{r.out}{r.err_out}"
    assert(text.contains(want), "{which}: want `{want}`, got: {text}")
    assert(!text.contains("list index out of bounds"), "{which}: generic list panic: {text}")
    assert_eq(r.exit_code, 101)
}

test "a read past the end names the accessor, the id and the pool length" {
    assert_named_out_of_bounds("kind_past_end", "parser: node_kind(8) out of bounds; nodes.len()=3")
}

test "a read of the no-node id names the accessor" {
    assert_named_out_of_bounds("name_of_none", "parser: node_name(-1) out of bounds; nodes.len()=3")
}

test "every accessor checks the id, not only the hot ones" {
    assert_named_out_of_bounds("line_past_end", "parser: node_line(3) out of bounds; nodes.len()=3")
    assert_named_out_of_bounds("set_of_none", "parser: node_set_int_val(-1) out of bounds; nodes.len()=3")
}

fn main() {
    let which = env.var("NODE_READ_PROBE") ?? ""
    if which == "" { return }
    node_push(AstNode {})
    node_push(AstNode {})
    node_push(AstNode {})
    if which == "kind_past_end" { io.println("{nk_tag(node_kind(8))}") }
    if which == "name_of_none" { io.println(node_name(-1)) }
    if which == "line_past_end" { io.println("{node_line(3)}") }
    if which == "set_of_none" { node_set_int_val(-1, 1) }
    io.println("FAIL: {which} read a bad id without stopping")
}
