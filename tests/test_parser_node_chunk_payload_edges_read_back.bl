// A node's fields sit in the chunk of its id: its Int fields after the chunk's head words
// and its Str fields in the chunk's own Str list. So a read must hold when a chunk outgrows the
// room it was made with, when a payload starts past what a 16-bit offset reaches, when a node
// moves its fields while a later chunk exists, when a pop drops a whole chunk, and when a
// field the node's kind holds from its push is read before and after a write.

import parser.{node_count, node_push, node_pop, parser_reset, node_set_module, node_set_is_pub, node_set_leading_comments, node_set_handlers, node_set_doc_comment, node_set_left, node_set_name, node_str_val, node_name, node_op, node_var_name, node_module, node_method, node_return_type, node_type_name, node_trait_name, node_leading_comments, node_trailing_comments, node_doc_comment, node_xfail_reason, node_kind, node_int_val, node_left, node_right, node_body, node_condition, node_then_body, node_else_body, node_scrutinee, node_pattern, node_guard, node_value, node_target, node_iterable, node_is_mut, node_is_pub, node_is_const, node_inclusive, node_start, node_end, node_obj, node_index, node_params, node_args, node_stmts, node_arms, node_fields, node_elements, node_methods, node_type_params, node_effects, node_captures, node_type_ann, node_handlers, node_line, node_col, node_end_line, node_end_col, node_assoc_types, node_impl_binders, node_recv_type_args, node_impl_where_bounds, node_for_binder, node_supertraits}
import ast.{AstNode, NodeKind, NK_ALL}

fn first_mismatch(id: Int, want: AstNode) -> Str {
    if node_str_val(id) != want.str_val { return "str_val" }
    if node_name(id) != want.name { return "name" }
    if node_op(id) != want.op { return "op" }
    if node_var_name(id) != want.var_name { return "var_name" }
    if node_module(id) != want.module { return "module" }
    if node_method(id) != want.method { return "method" }
    if node_return_type(id) != want.return_type { return "return_type" }
    if node_type_name(id) != want.type_name { return "type_name" }
    if node_trait_name(id) != want.trait_name { return "trait_name" }
    if node_leading_comments(id) != want.leading_comments { return "leading_comments" }
    if node_trailing_comments(id) != want.trailing_comments { return "trailing_comments" }
    if node_doc_comment(id) != want.doc_comment { return "doc_comment" }
    if node_xfail_reason(id) != want.xfail_reason { return "xfail_reason" }
    if node_kind(id) != want.kind { return "kind" }
    if node_int_val(id) != want.int_val { return "int_val" }
    if node_left(id) != want.left { return "left" }
    if node_right(id) != want.right { return "right" }
    if node_body(id) != want.body { return "body" }
    if node_condition(id) != want.condition { return "condition" }
    if node_then_body(id) != want.then_body { return "then_body" }
    if node_else_body(id) != want.else_body { return "else_body" }
    if node_scrutinee(id) != want.scrutinee { return "scrutinee" }
    if node_pattern(id) != want.pattern { return "pattern" }
    if node_guard(id) != want.guard { return "guard" }
    if node_value(id) != want.value { return "value" }
    if node_target(id) != want.target { return "target" }
    if node_iterable(id) != want.iterable { return "iterable" }
    if node_is_mut(id) != want.is_mut { return "is_mut" }
    if node_is_pub(id) != want.is_pub { return "is_pub" }
    if node_is_const(id) != want.is_const { return "is_const" }
    if node_inclusive(id) != want.inclusive { return "inclusive" }
    if node_start(id) != want.start { return "start" }
    if node_end(id) != want.end { return "end" }
    if node_obj(id) != want.obj { return "obj" }
    if node_index(id) != want.index { return "index" }
    if node_params(id) != want.params { return "params" }
    if node_args(id) != want.args { return "args" }
    if node_stmts(id) != want.stmts { return "stmts" }
    if node_arms(id) != want.arms { return "arms" }
    if node_fields(id) != want.fields { return "fields" }
    if node_elements(id) != want.elements { return "elements" }
    if node_methods(id) != want.methods { return "methods" }
    if node_type_params(id) != want.type_params { return "type_params" }
    if node_effects(id) != want.effects { return "effects" }
    if node_captures(id) != want.captures { return "captures" }
    if node_type_ann(id) != want.type_ann { return "type_ann" }
    if node_handlers(id) != want.handlers { return "handlers" }
    if node_line(id) != want.line { return "line" }
    if node_col(id) != want.col { return "col" }
    if node_end_line(id) != want.end_line { return "end_line" }
    if node_end_col(id) != want.end_col { return "end_col" }
    if node_assoc_types(id) != want.assoc_types { return "assoc_types" }
    if node_impl_binders(id) != want.impl_binders { return "impl_binders" }
    if node_recv_type_args(id) != want.recv_type_args { return "recv_type_args" }
    if node_impl_where_bounds(id) != want.impl_where_bounds { return "impl_where_bounds" }
    if node_for_binder(id) != want.for_binder { return "for_binder" }
    if node_supertraits(id) != want.supertraits { return "supertraits" }
    ""
}

// Every field set to a value that differs from its default and from node to node.
fn full(i: Int) -> AstNode {
    AstNode { kind: NK_ALL.get(i % NK_ALL.len()).unwrap(), int_val: i, left: i + 1, right: i + 2, body: i + 3, condition: i + 4, then_body: i + 5, else_body: i + 6, scrutinee: i + 7, pattern: i + 8, guard: i + 9, value: i + 10, target: i + 11, iterable: i + 12, is_mut: 1, is_pub: 1, is_const: 1, inclusive: 1, start: i + 13, end: i + 14, obj: i + 15, index: i + 16, params: i + 17, args: i + 18, stmts: i + 19, arms: i + 20, fields: i + 21, elements: i + 22, methods: i + 23, type_params: i + 24, effects: i + 25, captures: i + 26, type_ann: i + 27, handlers: i + 28, line: i + 29, col: i + 30, end_line: i + 31, end_col: i + 32, assoc_types: i + 33, impl_binders: i + 34, recv_type_args: i + 35, impl_where_bounds: i + 36, for_binder: i + 37, supertraits: i + 38, str_val: "s{i}", name: "n{i}", op: "o{i}", var_name: "v{i}", module: "m{i}", method: "me{i}", return_type: "r{i}", type_name: "ty{i}", trait_name: "tr{i}", leading_comments: "lc{i}", trailing_comments: "tc{i}", doc_comment: "dc{i}", xfail_reason: "x{i}" }
}

fn check_full(from: Int, to: Int) {
    let mut i = from
    while i < to {
        let m = first_mismatch(i, full(i))
        assert(m == "", "node {i}: {m}")
        i = i + 1
    }
}

test "a chunk whose fields outgrow the room its fieldless predecessor sized it for reads every node back" {
    parser_reset()
    let mut i = 0
    while i < 4096 {
        let _ = node_push(AstNode { kind: NodeKind.Continue })
        i = i + 1
    }
    while i < 8192 {
        assert_eq(node_push(full(i)), i)
        i = i + 1
    }
    let mut k = 0
    while k < 4096 {
        assert_eq(first_mismatch(k, AstNode { kind: NodeKind.Continue }), "")
        k = k + 1
    }
    check_full(4096, 8192)
    parser_reset()
}

test "a node whose fields start past offset 65535 in its chunk reads them back" {
    parser_reset()
    // 43 Int fields a node, so node 1600 of one chunk starts past 1600 * 43 = 68800 words.
    let mut i = 0
    while i < 1700 {
        assert_eq(node_push(full(i)), i)
        i = i + 1
    }
    check_full(0, 1700)
    node_set_doc_comment(1699, "moved")
    node_set_left(0, 7)
    assert_eq(first_mismatch(1699, AstNode { doc_comment: "moved", ..full(1699) }), "")
    assert_eq(first_mismatch(0, AstNode { left: 7, ..full(0) }), "")
    check_full(1, 1699)
    parser_reset()
}

test "a node that moves its fields while a later chunk exists keeps them through a pop and push in that chunk" {
    parser_reset()
    let mut i = 0
    while i < 4100 {
        assert_eq(node_push(AstNode { kind: NodeKind.Ident, name: "i{i}", line: i, col: i + 1 }), i)
        i = i + 1
    }
    node_set_doc_comment(10, "ten")
    node_set_handlers(10, 3)
    node_pop()
    let last = AstNode { kind: NodeKind.Return, str_val: "r", value: 10, line: 1, col: 2 }
    assert_eq(node_push(last), 4099)
    assert_eq(first_mismatch(10, AstNode { kind: NodeKind.Ident, name: "i10", line: 10, col: 11, doc_comment: "ten", handlers: 3 }), "")
    assert_eq(first_mismatch(4099, last), "")
    assert_eq(first_mismatch(4098, AstNode { kind: NodeKind.Ident, name: "i4098", line: 4098, col: 4099 }), "")
    assert_eq(first_mismatch(4095, AstNode { kind: NodeKind.Ident, name: "i4095", line: 4095, col: 4096 }), "")
    parser_reset()
}

test "a pop of the only node in a chunk after it moved its fields gives the chunk back clean" {
    parser_reset()
    let mut i = 0
    while i < 4097 {
        assert_eq(node_push(AstNode { kind: NodeKind.Ident, name: "i{i}", line: i, col: i + 1 }), i)
        i = i + 1
    }
    node_set_doc_comment(4095, "end of chunk 0")
    node_set_doc_comment(4096, "chunk 1")
    node_set_left(4096, 5)
    node_pop()
    assert_eq(node_count(), 4096)
    let again = AstNode { kind: NodeKind.IntLit, int_val: 42, line: 7, col: 8 }
    assert_eq(node_push(again), 4096)
    assert_eq(first_mismatch(4096, again), "")
    assert_eq(first_mismatch(4095, AstNode { kind: NodeKind.Ident, name: "i4095", line: 4095, col: 4096, doc_comment: "end of chunk 0" }), "")
    let next = AstNode { kind: NodeKind.Ident, name: "next", leading_comments: "c", line: 9, col: 10 }
    assert_eq(node_push(next), 4097)
    assert_eq(first_mismatch(4097, next), "")
    assert_eq(first_mismatch(4096, again), "")
    parser_reset()
}

test "a field a fn, binding, param or loop holds from its push reads its default until written" {
    parser_reset()
    let f = AstNode { kind: NodeKind.FnDef, name: "f", params: 0, body: 0, line: 1, col: 2 }
    let l = AstNode { kind: NodeKind.LetBinding, name: "x", value: 0, line: 3, col: 4 }
    let p = AstNode { kind: NodeKind.Param, name: "p", line: 5, col: 6 }
    let r = AstNode { kind: NodeKind.ForIn, var_name: "v", iterable: 0, body: 0, line: 7, col: 8 }
    let fi = node_push(f)
    let li = node_push(l)
    let pi = node_push(p)
    let ri = node_push(r)
    assert_eq(first_mismatch(fi, f), "")
    assert_eq(first_mismatch(li, l), "")
    assert_eq(first_mismatch(pi, p), "")
    assert_eq(first_mismatch(ri, r), "")
    node_set_module(fi, "mf")
    node_set_is_pub(fi, 1)
    node_set_leading_comments(fi, "// f")
    node_set_module(li, "ml")
    node_set_module(pi, "mp")
    node_set_module(ri, "mr")
    let f2 = AstNode { module: "mf", is_pub: 1, leading_comments: "// f", ..f }
    assert_eq(first_mismatch(fi, f2), "")
    assert_eq(first_mismatch(li, AstNode { module: "ml", ..l }), "")
    assert_eq(first_mismatch(pi, AstNode { module: "mp", ..p }), "")
    assert_eq(first_mismatch(ri, AstNode { module: "mr", ..r }), "")
    node_set_module(fi, "")
    node_set_is_pub(fi, 0)
    node_set_name(li, "y")
    assert_eq(first_mismatch(fi, AstNode { module: "", is_pub: 0, ..f2 }), "")
    assert_eq(first_mismatch(li, AstNode { module: "ml", name: "y", ..l }), "")
    parser_reset()
}
