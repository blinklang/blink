// Locks in the parser bad-id diagnostic format. The parser routes every
// node accessor through a helper that prints
// `parser: <getter>(<id>) out of bounds; nodes.len()=<n>` on a stale id;
// this test fails loudly if that wording ever drifts.

fn main() {
    let pwd_res = process_run("sh", ["-c", "pwd -P"])
    let blink_root = pwd_res.out.trim_right()

    let base = ".tmp/_test_parser_node_getter_panic_format_{getpid()}"
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}/src")

    write_file("{base}/blink.toml", "[package]\nname = \"getfmt\"\nversion = \"0.1.0\"\n\n[dependencies]\n")

    // Mimic the helper format we're committing to:
    //   parser: <getter>(<id>) out of bounds; nodes.len()=<n>
    let prog = "fn fake_get_or_die(id: Int, where: Str, pool_len: Int) -> Int \{\n    if id < 0 || id >= pool_len \{\n        io.eprintln(\"parser: \{where\}(\{id\}) out of bounds; nodes.len()=\{pool_len\}\")\n        exit(2)\n    \}\n    id\n\}\n\nfn main() \{\n    fake_get_or_die(999, \"node_params\", 42)\n\}\n"
    write_file("{base}/src/main.bl", prog)

    let cmd = "cd {base} && {blink_root}/build/blink run src/main.bl 2>&1; echo __EXIT__=$?"
    let result = process_run("sh", ["-c", cmd])
    let combined = "{result.out}{result.err_out}"

    shell_exec("rm -rf {base}")

    if !combined.contains("parser: node_params(999) out of bounds; nodes.len()=42") {
        io.println("FAIL: expected parser-specific bad-id message, got:")
        io.println(combined)
        return
    }
    if combined.contains("unwrap called on None") {
        io.println("FAIL: should not produce generic unwrap panic message, got:")
        io.println(combined)
        return
    }
    if !combined.contains("__EXIT__=2") {
        io.println("FAIL: expected exit code 2 from helper, got:")
        io.println(combined)
        return
    }
    io.println("PASS: parser bad-id panic format matches spec")
}
