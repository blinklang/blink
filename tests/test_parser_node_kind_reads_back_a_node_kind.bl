// The parser stores a node's kind as a NodeKind, and node_kind hands back that value, not
// an Int tag. An enum is nominally distinct from Int (sections/03_types.md), so a kind held
// as an Int could be matched only through a catch-all, and a new kind would compile with no
// arm. These rows read kinds back as NodeKind and match them with no catch-all.

import compiler.{compile_to_program}
import parser.{node_count, node_kind, node_name, node_value}
import ast.{NodeKind, node_kind_name}
import std.io

fn probe(stem: Str, text: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report {
    let path = "build/{stem}_probe.bl"
    write_file(path, text)
    let _program = compile_to_program(path, 1)
    let _rm = process.run("rm", ["-f", path]).unwrap()
}

fn literal_kind_name(k: NodeKind) -> Str {
    match k {
        NodeKind.IntLit => "int"
        NodeKind.InterpString => "str"
        NodeKind.BoolLit => "bool"
        _ => "other"
    }
}

// The last binding of this name: the pool keeps earlier probes' nodes, and each probe's own
// nodes come last.
fn binding_value(name: Str) -> Int {
    let mut i = node_count() - 1
    while i >= 0 {
        if node_kind(i) == NodeKind.LetBinding && node_name(i) == name { return node_value(i) }
        i = i - 1
    }
    -1
}

test "a parsed literal reads back as its NodeKind" {
    probe("nk_lits", "fn main() \{\n    let _nk_probe_a = 1\n    let _nk_probe_b = \"s\"\n    let _nk_probe_c = true\n}\n")
    let a: NodeKind = node_kind(binding_value("_nk_probe_a"))
    let b: NodeKind = node_kind(binding_value("_nk_probe_b"))
    let c: NodeKind = node_kind(binding_value("_nk_probe_c"))
    assert_eq(literal_kind_name(a), "int")
    assert_eq(literal_kind_name(b), "str")
    assert_eq(literal_kind_name(c), "bool")
}

test "every parsed node names a real kind" {
    probe("nk_all", "type P \{ n: Int }\nfn f(p: P) -> Int \{ match p.n \{ 0 => 1\n _ => p.n + 2 } }\nfn main() \{ let _x = f(P \{ n: 3 }) }\n")
    let mut i = 0
    let mut bad = 0
    while i < node_count() {
        let k: NodeKind = node_kind(i)
        if k == NodeKind.KindCount {
            io.println("FAIL: node {i} reads back the KindCount sentinel")
            bad = bad + 1
        }
        i = i + 1
    }
    assert_eq(bad, 0)
    assert(node_count() > 0)
}

test "a node's kind spells its name with no tag in between" {
    probe("nk_name", "fn main() \{\n    let _nk_probe_a = 1\n}\n")
    assert_eq(node_kind_name(node_kind(binding_value("_nk_probe_a"))), "IntLit")
}
