// node_kind reads a column laid out apart from the chunked columns that hold the other fields.
// Each column must still hold the same node at every id: a pop that closes a chunk and a push
// that opens one move every column together, or node_kind answers for a node that is gone.

import parser.{node_count, node_push, node_pop, node_kind, node_name, node_line, parser_reset}
import ast.{AstNode}

// The kind, the name and the line all encode the round and the id, so a column that lags or
// leads the others by one node disagrees with them.
fn push_marked(round: Int) -> Int {
    let i = node_count()
    node_push(AstNode { kind: 1000 + round * 100000 + i, name: "r{round}-{i}", line: round, col: 1 })
}

fn push_to(count: Int, round: Int) {
    while node_count() < count {
        let _ = push_marked(round)
    }
}

fn pop_to(count: Int) {
    while node_count() > count {
        node_pop()
    }
}

// The first id whose columns disagree, or -1.
fn first_disagreement() -> Int {
    let mut i = 0
    while i < node_count() {
        let round = node_line(i)
        if node_kind(i) != 1000 + round * 100000 + i { return i }
        if node_name(i) != "r{round}-{i}" { return i }
        i = i + 1
    }
    -1
}

fn round_at(i: Int) -> Int { node_line(i) }

test "every column holds the same node after pops and pushes across a chunk boundary" {
    parser_reset()
    push_to(4100, 1)
    pop_to(4090)
    push_to(8200, 2)
    pop_to(4096)
    push_to(4200, 3)
    assert_eq(node_count(), 4200)
    assert_eq(first_disagreement(), -1)
    assert_eq(round_at(4089), 1)
    assert_eq(round_at(4090), 2)
    assert_eq(round_at(4095), 2)
    assert_eq(round_at(4096), 3)
    assert_eq(node_kind(4096), 1000 + 3 * 100000 + 4096)
    parser_reset()
}

test "a pop of the only node in a chunk and a push in its place reads the new kind" {
    parser_reset()
    push_to(4097, 1)
    pop_to(4096)
    let id = push_marked(2)
    assert_eq(id, 4096)
    assert_eq(node_kind(id), 1000 + 2 * 100000 + 4096)
    assert_eq(first_disagreement(), -1)
    parser_reset()
}

test "a reset starts the kind column over with the other columns" {
    parser_reset()
    push_to(5000, 1)
    parser_reset()
    push_to(3, 2)
    assert_eq(node_count(), 3)
    assert_eq(node_kind(0), 1000 + 2 * 100000)
    assert_eq(first_disagreement(), -1)
    parser_reset()
}
