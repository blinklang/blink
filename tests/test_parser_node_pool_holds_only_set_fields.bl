// A node keeps only the fields it holds, so a getter on any other field must answer the
// field's default, a write that adds a field must move the node's fields without touching
// its neighbours', and a pop must give back only space no live node still reads.

import parser.{node_at, node_count, node_push, node_pop, parser_reset, node_set_module, node_set_is_pub, node_set_handlers, node_set_name, node_set_left, node_set_doc_comment, node_set_int_val, node_str_val, node_name, node_op, node_var_name, node_module, node_method, node_return_type, node_type_name, node_trait_name, node_leading_comments, node_trailing_comments, node_doc_comment, node_xfail_reason, node_kind, node_int_val, node_left, node_right, node_body, node_condition, node_then_body, node_else_body, node_scrutinee, node_pattern, node_guard, node_value, node_target, node_iterable, node_is_mut, node_is_pub, node_is_const, node_inclusive, node_start, node_end, node_obj, node_index, node_params, node_args, node_stmts, node_arms, node_fields, node_elements, node_methods, node_type_params, node_effects, node_captures, node_type_ann, node_handlers, node_line, node_col, node_end_line, node_end_col, node_assoc_types, node_impl_binders, node_recv_type_args, node_impl_where_bounds, node_for_binder, node_supertraits, node_binder_col}
import ast.{AstNode, NodeKind, NK_ALL}

fn first_mismatch(id: Int, want: AstNode) -> Str {
    if node_str_val(id) != want.str_val { return "str_val" }
    if node_name(id) != want.name { return "name" }
    if node_op(id) != want.op { return "op" }
    if node_var_name(id) != want.var_name { return "var_name" }
    if node_module(id) != want.module { return "module" }
    if node_method(id) != want.method { return "method" }
    if node_return_type(id) != want.return_type { return "return_type" }
    if node_type_name(id) != want.type_name { return "type_name" }
    if node_trait_name(id) != want.trait_name { return "trait_name" }
    if node_leading_comments(id) != want.leading_comments { return "leading_comments" }
    if node_trailing_comments(id) != want.trailing_comments { return "trailing_comments" }
    if node_doc_comment(id) != want.doc_comment { return "doc_comment" }
    if node_xfail_reason(id) != want.xfail_reason { return "xfail_reason" }
    if node_kind(id) != want.kind { return "kind" }
    if node_int_val(id) != want.int_val { return "int_val" }
    if node_left(id) != want.left { return "left" }
    if node_right(id) != want.right { return "right" }
    if node_body(id) != want.body { return "body" }
    if node_condition(id) != want.condition { return "condition" }
    if node_then_body(id) != want.then_body { return "then_body" }
    if node_else_body(id) != want.else_body { return "else_body" }
    if node_scrutinee(id) != want.scrutinee { return "scrutinee" }
    if node_pattern(id) != want.pattern { return "pattern" }
    if node_guard(id) != want.guard { return "guard" }
    if node_value(id) != want.value { return "value" }
    if node_target(id) != want.target { return "target" }
    if node_iterable(id) != want.iterable { return "iterable" }
    if node_is_mut(id) != want.is_mut { return "is_mut" }
    if node_is_pub(id) != want.is_pub { return "is_pub" }
    if node_is_const(id) != want.is_const { return "is_const" }
    if node_inclusive(id) != want.inclusive { return "inclusive" }
    if node_start(id) != want.start { return "start" }
    if node_end(id) != want.end { return "end" }
    if node_obj(id) != want.obj { return "obj" }
    if node_index(id) != want.index { return "index" }
    if node_params(id) != want.params { return "params" }
    if node_args(id) != want.args { return "args" }
    if node_stmts(id) != want.stmts { return "stmts" }
    if node_arms(id) != want.arms { return "arms" }
    if node_fields(id) != want.fields { return "fields" }
    if node_elements(id) != want.elements { return "elements" }
    if node_methods(id) != want.methods { return "methods" }
    if node_type_params(id) != want.type_params { return "type_params" }
    if node_effects(id) != want.effects { return "effects" }
    if node_captures(id) != want.captures { return "captures" }
    if node_type_ann(id) != want.type_ann { return "type_ann" }
    if node_handlers(id) != want.handlers { return "handlers" }
    if node_line(id) != want.line { return "line" }
    if node_col(id) != want.col { return "col" }
    if node_end_line(id) != want.end_line { return "end_line" }
    if node_end_col(id) != want.end_col { return "end_col" }
    if node_assoc_types(id) != want.assoc_types { return "assoc_types" }
    if node_impl_binders(id) != want.impl_binders { return "impl_binders" }
    if node_recv_type_args(id) != want.recv_type_args { return "recv_type_args" }
    if node_impl_where_bounds(id) != want.impl_where_bounds { return "impl_where_bounds" }
    if node_for_binder(id) != want.for_binder { return "for_binder" }
    if node_supertraits(id) != want.supertraits { return "supertraits" }
    if node_binder_col(id) != want.binder_col { return "binder_col" }
    ""
}

test "a node that holds no field reads every default an unset AstNode holds" {
    parser_reset()
    let id = node_push(AstNode { kind: NodeKind.Continue })
    assert_eq(first_mismatch(id, AstNode { kind: NodeKind.Continue }), "")
    assert_eq(node_left(id), -1)
    assert_eq(node_right(id), -1)
    assert_eq(node_body(id), -1)
    assert_eq(node_condition(id), -1)
    assert_eq(node_then_body(id), -1)
    assert_eq(node_else_body(id), -1)
    assert_eq(node_scrutinee(id), -1)
    assert_eq(node_pattern(id), -1)
    assert_eq(node_guard(id), -1)
    assert_eq(node_value(id), -1)
    assert_eq(node_target(id), -1)
    assert_eq(node_iterable(id), -1)
    assert_eq(node_start(id), -1)
    assert_eq(node_end(id), -1)
    assert_eq(node_obj(id), -1)
    assert_eq(node_index(id), -1)
    assert_eq(node_params(id), -1)
    assert_eq(node_args(id), -1)
    assert_eq(node_stmts(id), -1)
    assert_eq(node_arms(id), -1)
    assert_eq(node_fields(id), -1)
    assert_eq(node_elements(id), -1)
    assert_eq(node_methods(id), -1)
    assert_eq(node_type_params(id), -1)
    assert_eq(node_effects(id), -1)
    assert_eq(node_captures(id), -1)
    assert_eq(node_type_ann(id), -1)
    assert_eq(node_handlers(id), -1)
    assert_eq(node_line(id), -1)
    assert_eq(node_col(id), -1)
    assert_eq(node_end_line(id), -1)
    assert_eq(node_end_col(id), -1)
    assert_eq(node_assoc_types(id), -1)
    assert_eq(node_impl_binders(id), -1)
    assert_eq(node_recv_type_args(id), -1)
    assert_eq(node_impl_where_bounds(id), -1)
    assert_eq(node_for_binder(id), -1)
    assert_eq(node_supertraits(id), -1)
    assert_eq(node_binder_col(id), -1)
    assert_eq(node_int_val(id), 0)
    assert_eq(node_is_mut(id), 0)
    assert_eq(node_is_pub(id), 0)
    assert_eq(node_is_const(id), 0)
    assert_eq(node_inclusive(id), 0)
    assert_eq(node_str_val(id), "")
    assert_eq(node_name(id), "")
    assert_eq(node_op(id), "")
    assert_eq(node_var_name(id), "")
    assert_eq(node_module(id), "")
    assert_eq(node_method(id), "")
    assert_eq(node_return_type(id), "")
    assert_eq(node_type_name(id), "")
    assert_eq(node_trait_name(id), "")
    assert_eq(node_leading_comments(id), "")
    assert_eq(node_trailing_comments(id), "")
    assert_eq(node_doc_comment(id), "")
    assert_eq(node_xfail_reason(id), "")
    parser_reset()
}

test "a getter on a field the node does not hold reads the default, beside fields it does hold" {
    parser_reset()
    let before = node_push(AstNode { kind: NodeKind.Ident, name: "before", line: 1, col: 2 })
    let id = node_push(AstNode { kind: NodeKind.BinOp, op: "+", left: before, right: before, line: 3, col: 4 })
    let after = node_push(AstNode { kind: NodeKind.IntLit, int_val: 9, line: 5, col: 6 })
    assert_eq(node_left(id), before)
    assert_eq(node_op(id), "+")
    assert_eq(node_name(id), "")
    assert_eq(node_body(id), -1)
    assert_eq(node_is_pub(id), 0)
    assert_eq(node_int_val(after), 9)
    assert_eq(node_name(after), "")
    assert_eq(node_left(after), -1)
    assert_eq(node_int_val(before), 0)
    assert_eq(node_name(before), "before")
    parser_reset()
}

test "a write that adds a field the node does not hold reads back, and its neighbours keep theirs" {
    parser_reset()
    let a = AstNode { kind: NodeKind.Ident, name: "a", line: 1, col: 2 }
    let b = AstNode { kind: NodeKind.FnDef, name: "b", body: 0, params: 3, line: 4, col: 5 }
    let c = AstNode { kind: NodeKind.IntLit, int_val: 6, line: 7, col: 8 }
    let ia = node_push(a)
    let ib = node_push(b)
    let ic = node_push(c)
    node_set_module(ib, "mod")
    node_set_is_pub(ib, 1)
    node_set_handlers(ib, 11)
    node_set_doc_comment(ib, "doc")
    let b2 = AstNode { module: "mod", is_pub: 1, handlers: 11, doc_comment: "doc", ..b }
    assert_eq(first_mismatch(ib, b2), "")
    assert_eq(first_mismatch(ia, a), "")
    assert_eq(first_mismatch(ic, c), "")
    // A held field written back to its default reads the default; so does an absent one.
    node_set_is_pub(ib, 0)
    node_set_int_val(ib, 0)
    node_set_left(ia, 2)
    node_set_name(ic, "c")
    assert_eq(first_mismatch(ib, AstNode { is_pub: 0, ..b2 }), "")
    assert_eq(first_mismatch(ia, AstNode { left: 2, ..a }), "")
    assert_eq(first_mismatch(ic, AstNode { name: "c", ..c }), "")
    parser_reset()
}

test "a pop after an older node moved its fields leaves the moved fields alone" {
    parser_reset()
    let a = AstNode { kind: NodeKind.Ident, name: "a", line: 1, col: 2 }
    let ia = node_push(a)
    let _ = node_push(AstNode { kind: NodeKind.Ident, name: "scratch", line: 3, col: 4 })
    // a's fields now sit after the scratch node's, at the end of the pool.
    node_set_module(ia, "m")
    node_set_left(ia, 0)
    node_pop()
    let c = AstNode { kind: NodeKind.Return, str_val: "c", value: 0, line: 5, col: 6 }
    let ic = node_push(c)
    assert_eq(first_mismatch(ia, AstNode { module: "m", left: 0, ..a }), "")
    assert_eq(first_mismatch(ic, c), "")
    parser_reset()
}

test "a pop of a node that moved its own fields gives the space back to the next push" {
    parser_reset()
    let a = AstNode { kind: NodeKind.Ident, name: "a", line: 1, col: 2 }
    let ia = node_push(a)
    let ib = node_push(AstNode { kind: NodeKind.Ident, name: "b", line: 3, col: 4 })
    node_set_module(ib, "m")
    node_set_left(ib, 0)
    node_pop()
    assert_eq(node_count(), ib)
    let c = AstNode { kind: NodeKind.Call, left: ia, args: 0, line: 5, col: 6 }
    let ic = node_push(c)
    assert_eq(ic, ib)
    assert_eq(first_mismatch(ia, a), "")
    assert_eq(first_mismatch(ic, c), "")
    parser_reset()
}

// Node `i` holds a set of fields that changes with `i`, so a long run makes many shapes and
// crosses many chunk ends at uneven places.
fn varied(i: Int) -> AstNode {
    let k = i % 7
    let mut n = AstNode { kind: NodeKind.Ident, line: i, col: i + 1 }
    if k == 1 { n = AstNode { kind: NodeKind.BinOp, op: "op{i}", left: i, right: i + 2, line: i, col: i + 1 } }
    if k == 2 { n = AstNode { kind: NodeKind.IntLit, int_val: i, line: i, col: i + 1 } }
    if k == 3 { n = AstNode { kind: NodeKind.FnDef, name: "f{i}", params: i, body: i + 3, type_params: i + 4, return_type: "R{i}", is_pub: i % 2, line: i, col: i + 1, end_line: i + 5, end_col: i + 6, doc_comment: "d{i}" } }
    if k == 4 { n = AstNode { kind: NodeKind.Continue } }
    if k == 5 { n = AstNode { kind: NK_ALL.get(i % NK_ALL.len()).unwrap(), int_val: i, left: i, right: i, body: i, condition: i, then_body: i, else_body: i, scrutinee: i, pattern: i, guard: i, value: i, target: i, iterable: i, is_mut: i, is_pub: i, is_const: i, inclusive: i, start: i, end: i, obj: i, index: i, params: i, args: i, stmts: i, arms: i, fields: i, elements: i, methods: i, type_params: i, effects: i, captures: i, type_ann: i, handlers: i, line: i, col: i, end_line: i, end_col: i, assoc_types: i, impl_binders: i, recv_type_args: i, impl_where_bounds: i, for_binder: i, supertraits: i, binder_col: i, str_val: "s{i}", trait_name: "t{i}" } }
    if k == 6 { n = AstNode { kind: NodeKind.Ident, name: "n{i}", line: i, col: i + 1, leading_comments: "c{i}" } }
    n
}

fn check_varied(from: Int, to: Int, offset: Int) {
    let mut i = from
    while i < to {
        let m = first_mismatch(i, varied(i + offset))
        assert(m == "", "node {i}: {m}")
        i = i + 1
    }
}

test "nodes of many field sets read back across chunk ends, after a pop back and a push again" {
    parser_reset()
    let mut i = 0
    while i < 40000 {
        assert_eq(node_push(varied(i)), i)
        i = i + 1
    }
    check_varied(0, 40000, 0)
    while node_count() > 15000 { node_pop() }
    i = 15000
    while i < 42000 {
        assert_eq(node_push(varied(i + 5)), i)
        i = i + 1
    }
    check_varied(0, 15000, 0)
    check_varied(15000, 42000, 5)
    parser_reset()
}
