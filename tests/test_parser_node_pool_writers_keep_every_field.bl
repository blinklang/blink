// A node's fields are kept as rows of the node pool, one row per node id, so every write to
// the pool must write every row. A pop that left one row behind would hand that field to the
// next node pushed at the same id; a setter that rewrote the wrong row would change a field it
// does not name; a reset that missed a row would carry a field into the next parse. Each test
// checks every field through its accessor, so a row that one writer forgets fails here.

import parser.{node_at, node_count, node_push, node_pop, node_set_left, node_set_name, node_set_end_pos, parser_reset, node_str_val, node_name, node_op, node_var_name, node_module, node_method, node_return_type, node_type_name, node_trait_name, node_leading_comments, node_trailing_comments, node_doc_comment, node_xfail_reason, node_kind, node_int_val, node_left, node_right, node_body, node_condition, node_then_body, node_else_body, node_scrutinee, node_pattern, node_guard, node_value, node_target, node_iterable, node_is_mut, node_is_pub, node_is_const, node_inclusive, node_start, node_end, node_obj, node_index, node_params, node_args, node_stmts, node_arms, node_fields, node_elements, node_methods, node_type_params, node_effects, node_captures, node_type_ann, node_handlers, node_line, node_col, node_end_line, node_end_col, node_assoc_types, node_impl_binders, node_recv_type_args, node_impl_where_bounds, node_for_binder, node_supertraits, node_set_int_val, node_set_is_pub, node_set_line, node_set_col, node_set_end_line, node_set_end_col, node_set_is_mut, node_set_is_const, node_set_inclusive, node_set_str_val, node_set_module, node_set_type_name, node_set_leading_comments, node_set_trailing_comments, node_set_doc_comment, node_set_op, node_set_var_name, node_set_method, node_set_return_type, node_set_trait_name, node_set_pos, sublist_of, sublist_get, sublist_length, node_value_child_ids, node_spell_child_ids}
import ast.{AstNode, NodeKind, node_children, nk_tag}

// Every field holds a value no other field holds and no default holds.
fn distinct_node() -> AstNode {
    AstNode {
        str_val: "str_val-text",
        name: "name-text",
        op: "op-text",
        var_name: "var_name-text",
        module: "module-text",
        method: "method-text",
        return_type: "return_type-text",
        type_name: "type_name-text",
        trait_name: "trait_name-text",
        leading_comments: "leading_comments-text",
        trailing_comments: "trailing_comments-text",
        doc_comment: "doc_comment-text",
        xfail_reason: "xfail_reason-text",
        kind: 2013,
        int_val: 2014,
        left: 2015,
        right: 2016,
        body: 2017,
        condition: 2018,
        then_body: 2019,
        else_body: 2020,
        scrutinee: 2021,
        pattern: 2022,
        guard: 2023,
        value: 2024,
        target: 2025,
        iterable: 2026,
        is_mut: 2027,
        is_pub: 2028,
        is_const: 2029,
        inclusive: 2030,
        start: 2031,
        end: 2032,
        obj: 2033,
        index: 2034,
        params: 2035,
        args: 2036,
        stmts: 2037,
        arms: 2038,
        fields: 2039,
        elements: 2040,
        methods: 2041,
        type_params: 2042,
        effects: 2043,
        captures: 2044,
        type_ann: 2045,
        handlers: 2046,
        line: 2047,
        col: 2048,
        end_line: 2049,
        end_col: 2050,
        assoc_types: 2051,
        impl_binders: 2052,
        recv_type_args: 2053,
        impl_where_bounds: 2054,
        for_binder: 2055,
        supertraits: 2056,
    }
}

// The first field whose accessor at `id` does not read what `want` holds, or "".
// Node `i` of a long run: every field holds a value no other field and no other node holds.
fn numbered(i: Int) -> AstNode {
    AstNode {
        str_val: "str_val-{i}",
        name: "name-{i}",
        op: "op-{i}",
        var_name: "var_name-{i}",
        module: "module-{i}",
        method: "method-{i}",
        return_type: "return_type-{i}",
        type_name: "type_name-{i}",
        trait_name: "trait_name-{i}",
        leading_comments: "leading_comments-{i}",
        trailing_comments: "trailing_comments-{i}",
        doc_comment: "doc_comment-{i}",
        xfail_reason: "xfail_reason-{i}",
        kind: 14000000 + i,
        int_val: 15000000 + i,
        left: 16000000 + i,
        right: 17000000 + i,
        body: 18000000 + i,
        condition: 19000000 + i,
        then_body: 20000000 + i,
        else_body: 21000000 + i,
        scrutinee: 22000000 + i,
        pattern: 23000000 + i,
        guard: 24000000 + i,
        value: 25000000 + i,
        target: 26000000 + i,
        iterable: 27000000 + i,
        is_mut: 28000000 + i,
        is_pub: 29000000 + i,
        is_const: 30000000 + i,
        inclusive: 31000000 + i,
        start: 32000000 + i,
        end: 33000000 + i,
        obj: 34000000 + i,
        index: 35000000 + i,
        params: 36000000 + i,
        args: 37000000 + i,
        stmts: 38000000 + i,
        arms: 39000000 + i,
        fields: 40000000 + i,
        elements: 41000000 + i,
        methods: 42000000 + i,
        type_params: 43000000 + i,
        effects: 44000000 + i,
        captures: 45000000 + i,
        type_ann: 46000000 + i,
        handlers: 47000000 + i,
        line: 48000000 + i,
        col: 49000000 + i,
        end_line: 50000000 + i,
        end_col: 51000000 + i,
        assoc_types: 52000000 + i,
        impl_binders: 53000000 + i,
        recv_type_args: 54000000 + i,
        impl_where_bounds: 55000000 + i,
        for_binder: 56000000 + i,
        supertraits: 57000000 + i,
    }
}

fn first_mismatch(id: Int, want: AstNode) -> Str {
    if node_str_val(id) != want.str_val { return "str_val" }
    if node_name(id) != want.name { return "name" }
    if node_op(id) != want.op { return "op" }
    if node_var_name(id) != want.var_name { return "var_name" }
    if node_module(id) != want.module { return "module" }
    if node_method(id) != want.method { return "method" }
    if node_return_type(id) != want.return_type { return "return_type" }
    if node_type_name(id) != want.type_name { return "type_name" }
    if node_trait_name(id) != want.trait_name { return "trait_name" }
    if node_leading_comments(id) != want.leading_comments { return "leading_comments" }
    if node_trailing_comments(id) != want.trailing_comments { return "trailing_comments" }
    if node_doc_comment(id) != want.doc_comment { return "doc_comment" }
    if node_xfail_reason(id) != want.xfail_reason { return "xfail_reason" }
    if node_kind(id) != want.kind { return "kind" }
    if node_int_val(id) != want.int_val { return "int_val" }
    if node_left(id) != want.left { return "left" }
    if node_right(id) != want.right { return "right" }
    if node_body(id) != want.body { return "body" }
    if node_condition(id) != want.condition { return "condition" }
    if node_then_body(id) != want.then_body { return "then_body" }
    if node_else_body(id) != want.else_body { return "else_body" }
    if node_scrutinee(id) != want.scrutinee { return "scrutinee" }
    if node_pattern(id) != want.pattern { return "pattern" }
    if node_guard(id) != want.guard { return "guard" }
    if node_value(id) != want.value { return "value" }
    if node_target(id) != want.target { return "target" }
    if node_iterable(id) != want.iterable { return "iterable" }
    if node_is_mut(id) != want.is_mut { return "is_mut" }
    if node_is_pub(id) != want.is_pub { return "is_pub" }
    if node_is_const(id) != want.is_const { return "is_const" }
    if node_inclusive(id) != want.inclusive { return "inclusive" }
    if node_start(id) != want.start { return "start" }
    if node_end(id) != want.end { return "end" }
    if node_obj(id) != want.obj { return "obj" }
    if node_index(id) != want.index { return "index" }
    if node_params(id) != want.params { return "params" }
    if node_args(id) != want.args { return "args" }
    if node_stmts(id) != want.stmts { return "stmts" }
    if node_arms(id) != want.arms { return "arms" }
    if node_fields(id) != want.fields { return "fields" }
    if node_elements(id) != want.elements { return "elements" }
    if node_methods(id) != want.methods { return "methods" }
    if node_type_params(id) != want.type_params { return "type_params" }
    if node_effects(id) != want.effects { return "effects" }
    if node_captures(id) != want.captures { return "captures" }
    if node_type_ann(id) != want.type_ann { return "type_ann" }
    if node_handlers(id) != want.handlers { return "handlers" }
    if node_line(id) != want.line { return "line" }
    if node_col(id) != want.col { return "col" }
    if node_end_line(id) != want.end_line { return "end_line" }
    if node_end_col(id) != want.end_col { return "end_col" }
    if node_assoc_types(id) != want.assoc_types { return "assoc_types" }
    if node_impl_binders(id) != want.impl_binders { return "impl_binders" }
    if node_recv_type_args(id) != want.recv_type_args { return "recv_type_args" }
    if node_impl_where_bounds(id) != want.impl_where_bounds { return "impl_where_bounds" }
    if node_for_binder(id) != want.for_binder { return "for_binder" }
    if node_supertraits(id) != want.supertraits { return "supertraits" }
    ""
}

test "a pushed node reads back every field" {
    let want = distinct_node()
    let id = node_push(want)
    assert_eq(first_mismatch(id, want), "")
    node_pop()
}

test "a node pushed where one was popped reads none of the popped node's fields" {
    let first = node_push(distinct_node())
    node_pop()
    assert_eq(node_count(), first)
    let want = AstNode { kind: NodeKind.IntLit }
    let second = node_push(want)
    assert_eq(second, first)
    assert_eq(first_mismatch(second, want), "")
    node_pop()
}

test "a setter changes the field it names and no other" {
    let base = distinct_node()
    let id = node_push(base)
    node_set_left(id, 7)
    assert_eq(first_mismatch(id, AstNode { left: 7, ..base }), "")
    node_set_name(id, "renamed")
    assert_eq(first_mismatch(id, AstNode { left: 7, name: "renamed", ..base }), "")
    node_set_end_pos(id, 11, 12)
    assert_eq(first_mismatch(id, AstNode { left: 7, name: "renamed", end_line: 11, end_col: 12, ..base }), "")
    node_pop()
}

test "a node pushed after a reset reads none of the old pool's fields" {
    let _ = node_push(distinct_node())
    let _ = node_push(distinct_node())
    parser_reset()
    assert_eq(node_count(), 0)
    let want = AstNode { kind: NodeKind.Block, line: 3, col: 4 }
    let id = node_push(want)
    assert_eq(id, 0)
    assert_eq(first_mismatch(id, want), "")
    parser_reset()
}

fn check_run(from: Int, to: Int, offset: Int) {
    let mut i = from
    while i < to {
        let m = first_mismatch(i, numbered(i + offset))
        assert(m == "", "node {i}: {m}")
        i = i + 1
    }
}

test "a long run of nodes reads back every field, after a pop back and a push again too" {
    parser_reset()
    let mut i = 0
    while i < 9000 {
        assert_eq(node_push(numbered(i)), i)
        i = i + 1
    }
    check_run(0, 9000, 0)
    while node_count() > 3000 { node_pop() }
    i = 3000
    while i < 9500 {
        assert_eq(node_push(numbered(i + 100000)), i)
        i = i + 1
    }
    check_run(0, 3000, 0)
    check_run(3000, 9500, 100000)
    node_set_left(8500, 5)
    node_set_module(8500, "moved")
    assert_eq(first_mismatch(8500, AstNode { left: 5, module: "moved", ..numbered(108500) }), "")
    check_run(8501, 9500, 100000)
    parser_reset()
}

fn expand(refs: List[Int], lists: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    for r in refs { out.push(r) }
    for sl in lists {
        let mut k = 0
        while k < sublist_length(sl) {
            let m = sublist_get(sl, k)
            if m != -1 { out.push(m) }
            k = k + 1
        }
    }
    out
}

fn same(a: List[Int], b: List[Int]) -> Bool {
    if a.len() != b.len() { return false }
    let mut i = 0
    while i < a.len() {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    true
}

// The child slots against the child table run afresh on the node as it is now.
fn agrees_at(i: Int) -> Bool {
    let kids = node_children(node_at(i))
    same(node_value_child_ids(i), expand(kids.refs, kids.lists)) && same(node_spell_child_ids(i), expand(kids.spell_refs, kids.spell_lists))
}

// These setters write their one field and leave the child slots alone, which is right only
// while the child table reads none of their fields for any kind. Each one here writes a value
// the table would turn into a child, so a table that starts to read one of these fields fails.
test "a setter of a field the child table does not read leaves every kind's children as the table reads them" {
    parser_reset()
    let _ = node_push(AstNode { kind: NodeKind.IntLit })
    let one = node_push(AstNode { kind: NodeKind.IntLit })
    let _ = sublist_of([one])
    // `one` names a node and a sublist both, so a field read as a child or as a list of
    // children gives the node a child.
    assert_eq(sublist_of([one]), one)
    let mut k = 0
    while k < nk_tag(NodeKind.KindCount) {
        let id = node_push(AstNode { kind: k })
        node_set_int_val(id, one)
        assert(agrees_at(id), "kind {k} after node_set_int_val")
        node_set_is_pub(id, one)
        assert(agrees_at(id), "kind {k} after node_set_is_pub")
        node_set_line(id, one)
        assert(agrees_at(id), "kind {k} after node_set_line")
        node_set_col(id, one)
        assert(agrees_at(id), "kind {k} after node_set_col")
        node_set_end_line(id, one)
        assert(agrees_at(id), "kind {k} after node_set_end_line")
        node_set_end_col(id, one)
        assert(agrees_at(id), "kind {k} after node_set_end_col")
        node_set_is_mut(id, one)
        assert(agrees_at(id), "kind {k} after node_set_is_mut")
        node_set_is_const(id, one)
        assert(agrees_at(id), "kind {k} after node_set_is_const")
        node_set_inclusive(id, one)
        assert(agrees_at(id), "kind {k} after node_set_inclusive")
        node_set_str_val(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_str_val")
        node_set_module(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_module")
        node_set_type_name(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_type_name")
        node_set_leading_comments(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_leading_comments")
        node_set_trailing_comments(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_trailing_comments")
        node_set_doc_comment(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_doc_comment")
        node_set_op(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_op")
        node_set_var_name(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_var_name")
        node_set_method(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_method")
        node_set_return_type(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_return_type")
        node_set_trait_name(id, "requires")
        assert(agrees_at(id), "kind {k} after node_set_trait_name")
        node_set_pos(id, one, one)
        assert(agrees_at(id), "kind {k} after node_set_pos")
        node_set_end_pos(id, one, one)
        assert(agrees_at(id), "kind {k} after node_set_end_pos")
        k = k + 1
    }
    parser_reset()
}
