// A sublist reads the same members in the same order however it was built: while it is still
// open, while a sublist nested in it is open, after a later sublist has been built past it,
// and after typecheck appends to it once the parse has closed it.

import parser.{node_count, node_push, node_value_child_ids, new_sublist, sublist_push, finalize_sublist, sublist_get, sublist_length, sublist_append, sublist_of}
import ast.{NodeKind, AstNode}

fn members(sl: Int) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    while i < sublist_length(sl) {
        out.push(sublist_get(sl, i))
        i = i + 1
    }
    out
}

fn call_node(args: Int) -> Int {
    let id = node_count()
    node_push(AstNode { kind: NodeKind.Call, left: 900, args: args })
    id
}

test "an open sublist reads what was pushed so far" {
    let sl = new_sublist()
    sublist_push(sl, 11)
    sublist_push(sl, 12)
    assert_eq(sublist_length(sl), 2)
    assert_eq(sublist_get(sl, 1), 12)
    sublist_push(sl, 13)
    assert_eq(members(sl), [11, 12, 13])
    finalize_sublist(sl)
    assert_eq(members(sl), [11, 12, 13])
}

test "an outer sublist reads and grows while a nested one is open" {
    let outer = new_sublist()
    sublist_push(outer, 21)
    let inner = new_sublist()
    sublist_push(inner, 31)
    assert_eq(members(outer), [21])
    sublist_push(outer, 22)
    sublist_push(inner, 32)
    assert_eq(members(outer), [21, 22])
    assert_eq(members(inner), [31, 32])
    finalize_sublist(inner)
    sublist_push(outer, 23)
    finalize_sublist(outer)
    assert_eq(members(outer), [21, 22, 23])
    assert_eq(members(inner), [31, 32])
}

test "a sublist opened after another closed starts empty" {
    let first = new_sublist()
    sublist_push(first, 41)
    finalize_sublist(first)
    let second = new_sublist()
    assert_eq(sublist_length(second), 0)
    sublist_push(second, 42)
    finalize_sublist(second)
    assert_eq(members(first), [41])
    assert_eq(members(second), [42])
}

test "an append to a closed sublist keeps the sublists built after it" {
    let a = sublist_of([51, 52])
    let b = sublist_of([61])
    sublist_append(a, 53)
    assert_eq(members(a), [51, 52, 53])
    assert_eq(members(b), [61])
    sublist_append(a, 54)
    sublist_append(b, 62)
    assert_eq(members(a), [51, 52, 53, 54])
    assert_eq(members(b), [61, 62])
}

test "a node walk reads a sublist that grew after it closed" {
    let args = sublist_of([71])
    let later = sublist_of([81])
    let call = call_node(args)
    sublist_append(args, 72)
    assert_eq(node_value_child_ids(call), [900, 71, 72])
    assert_eq(members(later), [81])
}

test "a push to a closed sublist during a parse grows it" {
    let closed = sublist_of([91])
    let later = sublist_of([95])
    let open = new_sublist()
    sublist_push(closed, 92)
    finalize_sublist(open)
    assert_eq(members(closed), [91, 92])
    assert_eq(members(later), [95])
    assert_eq(sublist_length(open), 0)
}
