// A body edit changes no module's interface, so a per-module build keeps the last build's
// header of each module whose text it would write again unchanged: it links the file into the
// new units directory, and the inode stays the one the last build wrote. A header whose text
// does change is written new, such as the private header of the module that homes a generic
// when another module's edit calls a new instance of it. Each build runs with
// BLINK_EMIT_REUSE_VERIFY=1, so every header it keeps or writes is byte-equal to a cold emit.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"header_reuse_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/base.bl", [
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s}]""#,
        #"}"#,
        #""#,
        #"pub fn pair_left[T](a: T, b: T) -> T {"#,
        #"    a"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/mid.bl", [
        #"import base.{pair_left, tag}"#,
        #""#,
        #"pub fn mid_value() -> Str {"#,
        #"    tag("mid {pair_left(2, 9)}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/other.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn other() -> Str {"#,
        #"    tag("other")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/leaf.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag("leaf")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #"import mid.{mid_value}"#,
        #"import other.{other}"#,
        #"import leaf.{leaf_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{tag("main")} {mid_value()} {other()} {leaf_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both and the module filters.
fn build(tree: Str) -> ProcessResult {
    let r = process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_EMIT_REUSE_VERIFY=1 BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink build app/src/main.bl -o {tree}/out/app --per-module"])
    assert(r.exit_code == 0, "per-module build failed: {r.out}{r.err_out}")
    r
}

fn append(tree: Str, file: Str, text: Str) {
    let path = "{tree}/app/src/{file}"
    write_file(path, "{read_file(path)}{text}")
}

fn edit(tree: Str, file: Str, sed: Str) {
    let path = "{tree}/app/src/{file}"
    let before = read_file(path)
    shell_exec("sed -i '{sed}' {path}")
    assert(read_file(path) != before, "the edit `{sed}` did not change {file}")
}

// The inode of each header in the units directory, as "name inode" lines in name order.
fn header_inodes(tree: Str) -> List[Str] {
    sh("cd {tree}/out/app.units && stat -c '%n %i' *.h | LC_ALL=C sort").split("\n")
}

// The headers of `b` whose inode differs from the one in `a`, then those that only `a` holds.
fn rewritten(a: List[Str], b: List[Str]) -> Str {
    let mut names: List[Str] = []
    for line in b {
        if !a.contains(line) { names.push(line.split(" ").get(0).unwrap()) }
    }
    let mut kept: List[Str] = []
    for line in b { kept.push(line.split(" ").get(0).unwrap()) }
    for line in a {
        let name = line.split(" ").get(0).unwrap()
        if !kept.contains(name) { names.push("gone:{name}") }
    }
    names.join(",")
}

test "a body edit writes no header whose text did not change" {
    let root = sh("pwd -P")
    let tree = "{root}/.tmp/_per_module_header_reuse_{getpid()}"
    dev_tree(root, tree)
    let _first = build(tree)
    let first = header_inodes(tree)
    edit(tree, "leaf.bl", #"s/tag("leaf")/tag("leaf body")/"#)
    let _body = build(tree)
    let after_body = header_inodes(tree)
    edit(tree, "leaf.bl", #"s/tag("leaf body")/tag("leaf {pair_left("x", "y")}")/; s/import base.{tag}/import base.{pair_left, tag}/"#)
    let _instance = build(tree)
    let after_instance = header_inodes(tree)
    let out = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(first.len() > 0, "the build wrote no header")
    assert_eq("body edit in leaf rewrote: {rewritten(first, after_body)}", "body edit in leaf rewrote: ")
    assert_eq("new instance of a base generic rewrote: {rewritten(after_body, after_instance)}", "new instance of a base generic rewrote: base.priv.h")
    assert_eq(out, "[main] [mid 2] [other] [leaf x]")
}
