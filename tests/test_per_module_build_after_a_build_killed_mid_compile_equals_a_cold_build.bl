// A unit compile can outlive its build: a SIGTERM to the blink pid alone ends blink and not
// its cc. Such a compile writes only into the private dir of the build that started it, so
// the next build of the same program never reads or links what it writes.

import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

// A dev tree with a program of four units: __main__, a, b and c. The cc in bin/ runs as
// follows. In the first build (phase_a exists) the compile of a waits for the second build
// to compile a, compiles, then writes junk over its own object. In the second build the link
// waits for that junk. So if the two builds shared an object path, the second would link
// the junk.
fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/bin")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    let real_cc = sh("command -v cc")
    let script = [
        "#!/bin/sh",
        "wait_for() \{ n=0; while [ ! -e \"$1\" ]; do n=$((n + 1)); [ $n -ge 400 ] && return; sleep 0.05; done; \}",
        "case \" $* \" in",
        "    *\" -c \"*) ;;",
        "    *libblink_std.a*) wait_for {tree}/junk_done; exec {real_cc} \"$@\" ;;",
        "    *) exec {real_cc} \"$@\" ;;",
        "esac",
        "out=''; prev=''",
        "for a in \"$@\"; do",
        "    case \"$a\" in *.c) unit=$(basename \"$a\" .c) ;; esac",
        "    [ \"$prev\" = -o ] && out=$a",
        "    prev=$a",
        "done",
        "[ \"$unit\" = a ] || exec {real_cc} \"$@\"",
        "if [ -e {tree}/phase_a ]; then",
        "    touch {tree}/started_a",
        "    wait_for {tree}/b_compiled_a",
        "    {real_cc} \"$@\"",
        "    echo junk > \"$out\"",
        "    echo \"$out\" > {tree}/junk_done",
        "    exit 0",
        "fi",
        "{real_cc} \"$@\"",
        "rc=$?",
        "touch {tree}/b_compiled_a",
        "exit $rc",
    ]
    write_file("{tree}/bin/cc", "{script.join("\n")}\n")
    shell_exec("chmod +x {tree}/bin/cc")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"orphan_app\"\nversion = \"0.1.0\"\n")
    for m in ["a", "b", "c"] {
        write_file("{tree}/app/src/{m}.bl", "pub fn {m}_value() -> Int \{\n    1\n\}\n")
    }
    write_file("{tree}/app/src/main.bl", "import a.\{a_value\}\nimport b.\{b_value\}\nimport c.\{c_value\}\n\nfn main() \{\n    io.println(\"sum \{a_value() + b_value() + c_value()\}\")\n\}\n")
}

// The command of a build into out/app, run in tree. The corpus exports
// BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the run drops
// them.
fn build_cmd(tree: Str, path: Str, cache: Str, jobs: Int) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_JOBS PATH={path} BLINK_CACHE_DIR={tree}/{cache} BLINK_ARCHIVE_PCH=0 build/blink build app/src/main.bl -o {tree}/out/app --per-module --jobs {jobs}"
}

test "a build after a build killed mid compile equals a cold build" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_unit_orphan_{getpid()}"
    dev_tree(root, tree)
    let wrapped = "{tree}/bin:$PATH"
    // The first build, killed with SIGTERM to its pid alone once a compiles. env execs blink
    // and sh forks a simple command run with & straight into it, so $! is the blink pid.
    shell_exec("touch {tree}/phase_a")
    shell_exec("cd {tree} && \{ {build_cmd(tree, wrapped, "objcache", 2)} > {tree}/first.log 2>&1 & echo $! > {tree}/first.pid; \}")
    let started = process_run("sh", ["-c", "for i in $(seq 1 400); do [ -e {tree}/started_a ] && exit 0; sleep 0.05; done; exit 1"]).exit_code == 0
    let pid = sh("cat {tree}/first.pid")
    shell_exec("kill -TERM {pid}; for i in $(seq 1 200); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done")
    let first_gone = process_run("sh", ["-c", "kill -0 {pid} 2>/dev/null"]).exit_code != 0
    shell_exec("rm -f {tree}/phase_a")
    let second = process_run("sh", ["-c", "cd {tree} && {build_cmd(tree, wrapped, "objcache", 2)}"])
    let second_bin = sh("sha256sum < {tree}/out/app")
    let run = sh("{tree}/out/app")
    let junk_path = sh("cat {tree}/junk_done 2>/dev/null")
    let junk = sh("cat '{junk_path}' 2>/dev/null")
    // The units dir the orphan wrote in: its object sits in obj/ there.
    let orphan_dir_left = junk_path != "" && sh("[ -d \"$(dirname \"$(dirname '{junk_path}')\")\" ] && echo yes") == "yes"
    let second_units = sh("readlink -f {tree}/out/app.units")
    shell_exec("rm -rf {tree}/out")
    let cold = process_run("sh", ["-c", "cd {tree} && {build_cmd(tree, "$PATH", "cold_cache", 1)}"])
    let cold_bin = sh("sha256sum < {tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(started, "the compile of a never started in the first build")
    assert(first_gone, "the first build did not end on SIGTERM")
    assert(second.exit_code == 0, "second build failed: {second.out}{second.err_out}")
    assert(cold.exit_code == 0, "cold build failed: {cold.out}{cold.err_out}")
    // A later build reaps the dir of the killed one, so the orphan may find its dir gone and
    // write nothing; junk_done shows it ran either way.
    assert(junk_path != "", "the orphan compile of a never ended")
    assert(junk == "junk" || !orphan_dir_left, "the orphan wrote \"{junk}\" at {junk_path}")
    assert(!junk_path.starts_with(second_units), "the orphan wrote into the second build's dir: {junk_path}")
    assert_eq(second_bin, cold_bin)
    assert_eq(run, "sum 3")
}
