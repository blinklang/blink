// A per-module build compiles up to --jobs units at once. The async pool a Blink program
// runs its tasks on has four threads, and a task that waits on a child holds its thread, so
// a build that waited for each compile from its own task could never run more than four.

import std.process.{ProcessResult}
import compile_test_helpers

fn module_count() -> Int {
    8
}

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src {tree}/shim {tree}/live"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    // A cc that, for each compile, counts the compiles running beside it halfway through
    // its own, then runs the real cc.
    let real_cc = sh("command -v cc")
    fs.write("{tree}/shim/cc", [
        "#!/bin/sh",
        "case \" $* \" in *\" -c \"*)",
        "    touch {tree}/live/$$; sleep 0.5",
        "    ls {tree}/live | wc -l >> {tree}/counts; sleep 0.5",
        "    rm -f {tree}/live/$$ ;;",
        "esac",
        "exec {real_cc} \"$@\"",
        "",
    ].join("\n")).unwrap()
    process.run("sh", ["-c", "chmod +x {tree}/shim/cc"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"wide_app\"\nversion = \"0.1.0\"\n").unwrap()
    let mut main_lines: List[Str] = []
    let mut terms: List[Str] = []
    let n = module_count()
    for i in 0..n {
        fs.write("{tree}/app/src/part_{i}.bl", "pub fn value_{i}() -> Int \{\n    {i}\n\}\n").unwrap()
        main_lines.push("import part_{i}.\{value_{i}\}")
        terms.push("value_{i}()")
    }
    main_lines.push("")
    main_lines.push("fn main() \{")
    main_lines.push("    io.println(\"sum \{{terms.join(" + ")}\}\")")
    main_lines.push("\}")
    main_lines.push("")
    fs.write("{tree}/app/src/main.bl", main_lines.join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes
// --per-module build one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_JOBS PATH={tree}/shim:$PATH BLINK_CACHE_DIR={tree}/objcache build/blink {args}"]).unwrap()
}

test "a per-module build with --jobs 9 runs more than four unit compiles at once" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_wide_{getpid()}"
    dev_tree(root, tree)
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module --jobs 9")
    let most = sh("sort -n {tree}/counts | tail -1")
    let compiles = sh("wc -l < {tree}/counts")
    let out = sh("{tree}/out/app")
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    assert_eq(compiles, "{module_count() + 1}")
    assert(most.to_int() > 4, "at most {most} unit compiles ran at once")
    assert_eq(out, "sum {module_count() * (module_count() - 1) / 2}")
}
