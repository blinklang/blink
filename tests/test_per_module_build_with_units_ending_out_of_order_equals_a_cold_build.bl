// A per-module build whose unit compiles end out of start order makes the same objects and
// the same binary as a cold build that compiles one unit at a time.

import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with a program of five units: big, the largest, so it starts first, and
// __main__, a, b and c. The cc in bin/ holds the compile of big until the other four
// compiles have ended, and gives up after 20 s, leaving timed_out, so with two slots the
// units end in an order other than the one they start in.
fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/bin {tree}/done")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    let real_cc = sh("command -v cc")
    let script = [
        "#!/bin/sh",
        "case \" $* \" in *\" -c \"*) ;; *) exec {real_cc} \"$@\" ;; esac",
        "for a in \"$@\"; do case \"$a\" in *.c) unit=$(basename \"$a\" .c) ;; esac; done",
        "if [ \"$unit\" = big ]; then",
        "    n=0",
        "    while [ $(ls {tree}/done | wc -l) -lt 4 ]; do",
        "        n=$((n + 1))",
        "        if [ $n -ge 400 ]; then touch {tree}/timed_out; break; fi",
        "        sleep 0.05",
        "    done",
        "fi",
        "{real_cc} \"$@\"",
        "rc=$?",
        "touch {tree}/done/$unit",
        "exit $rc",
    ]
    write_file("{tree}/bin/cc", "{script.join("\n")}\n")
    shell_exec("chmod +x {tree}/bin/cc")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"same_app\"\nversion = \"0.1.0\"\n")
    let mut big: List[Str] = []
    let mut i = 1
    while i <= 60 {
        big.push("pub fn big_{i}(x: Int) -> Int \{\n    let mut s = x\n    for j in 0..{i} \{ s = s + j * {i} \}\n    s\n\}\n")
        i = i + 1
    }
    write_file("{tree}/app/src/big.bl", big.join("\n"))
    for m in ["a", "b", "c"] {
        write_file("{tree}/app/src/{m}.bl", "pub fn {m}_value() -> Int \{\n    1\n\}\n")
    }
    write_file("{tree}/app/src/main.bl", "import big.\{big_1\}\nimport a.\{a_value\}\nimport b.\{b_value\}\nimport c.\{c_value\}\n\nfn main() \{\n    io.println(\"sum \{big_1(1) + a_value() + b_value() + c_value()\}\")\n\}\n")
}

// Builds the app into out/app with an empty object cache and returns the sha256 of the
// binary and of each object. With hold set, the cc in bin/ comes first on PATH. The corpus
// exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the
// run drops them.
fn build_cold(tree: Str, hold: Bool, jobs: Int) -> (Str, Str) {
    shell_exec("rm -rf {tree}/objcache {tree}/done {tree}/out && mkdir -p {tree}/done")
    let path = if hold { "{tree}/bin:$PATH" } else { "$PATH" }
    let r = process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_JOBS PATH={path} BLINK_CACHE_DIR={tree}/objcache BLINK_ARCHIVE_PCH=0 build/blink build app/src/main.bl -o {tree}/out/app --per-module --jobs {jobs}"]).unwrap()
    assert(r.success(), "build failed: {r.out}{r.err_out}")
    (sh("sha256sum < {tree}/out/app"), sh("cd {tree}/objcache && sha256sum *.o"))
}

test "a build whose units end out of order equals a cold build of one unit at a time" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_unit_same_bin_{getpid()}"
    dev_tree(root, tree)
    let (held_bin, held_objs) = build_cold(tree, true, 2)
    let held_units = sh("ls {tree}/done | LC_ALL=C sort | tr '\\n' ' '")
    let timed_out = file_exists("{tree}/timed_out") == 1
    let (cold_bin, cold_objs) = build_cold(tree, false, 1)
    let run = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert_eq(held_units, "__main__ a b big c")
    assert(!timed_out, "big held its slot until the 20 s limit")
    assert(held_objs.split("\n").len() == 5, "objects: {held_objs}")
    assert_eq(held_objs, cold_objs)
    assert_eq(held_bin, cold_bin)
    assert_eq(run, "sum 4")
}
