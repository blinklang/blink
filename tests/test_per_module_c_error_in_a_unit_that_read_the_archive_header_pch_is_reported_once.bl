// A unit that read the PCH and failed compiles once more without it, since gcc stops on a
// .gch cut short. When the unit holds a real C error, both compiles report it, and the build
// must print it once: the report of the compile that ran last.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with a program of two modules, and a cc first on PATH that runs the real cc.
// While {tree}/break exists, it compiles the entry unit with a header that holds a C error.
fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src {tree}/bin"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    let real_cc = sh("command -v cc")
    fs.write("{tree}/bad.h", "int injected_c_error = ;\n").unwrap()
    fs.write("{tree}/bin/cc", "#!/bin/sh\nif [ -f {tree}/break ]; then case \" $* \" in *__main__.c*) set -- \"$@\" -include {tree}/bad.h ;; esac; fi\nexec {real_cc} \"$@\"\n").unwrap()
    process.run("sh", ["-c", "chmod +x {tree}/bin/cc"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"pch_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/part.bl", "pub fn value() -> Int \{\n    41\n\}\n").unwrap()
    edit_main(tree, 1)
}

fn edit_main(tree: Str, n: Int) ! FS.Write {
    fs.write("{tree}/app/src/main.bl", "import part.\{value\}\n\nfn main() \{\n    let total = value() + {n}\n    io.println(\"sum \{total\}\")\n\}\n").unwrap()
}

// Runs blink in the tree with its own object cache, the -H cc and the unit trace. The corpus
// exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the
// run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "rm -rf {tree}/cc_h && mkdir {tree}/cc_h"]).unwrap()
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=blink.build.units build/blink {args}"]).unwrap()
}

fn build_ok(tree: Str, flags: Str) ! Process.Spawn {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module {flags}")
    assert(r.success(), "build failed: {r.out}{r.err_out}")
}

fn pch_dirs(tree: Str) -> List[Str] ! Process.Spawn {
    let out = sh("cd {tree}/objcache && ls -d *.pch 2>/dev/null")
    if out == "" { [] } else { out.split("\n") }
}

fn count_of(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "a C error in a unit that read the archive header PCH is reported once" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_pch_c_error_{getpid()}"
    dev_tree(root, tree)
    build_ok(tree, "")
    edit_main(tree, 2)
    build_ok(tree, "")
    let dirs = pch_dirs(tree)
    process.run("sh", ["-c", "touch {tree}/break"])?
    edit_main(tree, 3)
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    let out = "{r.out}{r.err_out}"
    let dirs_after = pch_dirs(tree)
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert_eq(dirs.len(), 1)
    assert(!r.success(), "the build passed: {out}")
    // Both compiles ran, the one with the PCH and the one without it.
    assert(out.contains("pch fallback __main__ exit 1"), "no fallback compile: {out}")
    assert_eq(count_of(out, "error: expected expression"), 1)
    // The compile without the PCH failed too, so the PCH was not at fault and stays.
    assert_eq(dirs_after.len(), 1)
}
