// When cc rejects one unit, a per-module build names that unit and exits with the code the
// one-unit build exits with. A cc wrapper on PATH rejects any C file that holds a marker
// string, which only the shapes module holds.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"shapes_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/shapes.bl", [
        #"pub type Shape {"#,
        #"    name: Str"#,
        #"    sides: Int"#,
        #"}"#,
        #""#,
        #"pub trait Describe {"#,
        #"    fn describe(self) -> Str"#,
        #"}"#,
        #""#,
        #"impl Describe for Shape {"#,
        #"    fn describe(self) -> Str {"#,
        #"        "{self.name}/{self.sides}""#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn weight(s: Shape) -> Int {"#,
        #"    s.sides * 10"#,
        #"}"#,
        #""#,
        #"pub fn score(s: Shape) -> Int {"#,
        #"    weight(s) + 1"#,
        #"}"#,
        #""#,
        #"pub fn first_or[T](xs: List[T], fallback: T) -> T {"#,
        #"    match xs.get(0) {"#,
        #"        Some(x) => x"#,
        #"        None => fallback"#,
        #"    }"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/tally.bl", [
        #"import shapes.{Shape, Describe, score, first_or}"#,
        #""#,
        #"pub fn tally(xs: List[Shape]) -> Map[Str, Int] {"#,
        #"    let mut m: Map[Str, Int] = Map()"#,
        #"    for s in xs {"#,
        #"        m.insert(s.describe(), score(s))"#,
        #"    }"#,
        #"    m"#,
        #"}"#,
        #""#,
        #"pub fn widest(xs: List[Shape]) -> Shape {"#,
        #"    let big = xs.filter(fn(s) { s.sides > 3 })"#,
        #"    first_or(big, Shape { name: "none", sides: 0 })"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import shapes.{Shape, Describe, first_or}"#,
        #"import tally.{tally, widest}"#,
        #""#,
        #"fn main() {"#,
        #"    let xs = [Shape { name: "tri", sides: 3 }, Shape { name: "sq", sides: 4 }, Shape { name: "hex", sides: 6 }]"#,
        #"    let m = tally(xs)"#,
        #"    for k in ["tri/3", "sq/4", "hex/6"] {"#,
        #"        io.println("{k} -> {m.get(k) ?? -1}")"#,
        #"    }"#,
        #"    io.println("widest {widest(xs).describe()}")"#,
        #"    io.println("first {first_or([7, 8], 0)} {first_or([], \"empty\")}")"#,
        #"    let names = xs.map(fn(s: Shape) -> Str { s.name })"#,
        #"    io.println(names.join(","))"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// Runs blink in the tree with its own object cache, and the unit trace on. The corpus
// exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes --per-module
// build one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink {args}"])
}

fn fake_cc(tree: Str) {
    let real_cc = sh("command -v cc")
    shell_exec("mkdir -p {tree}/fakebin")
    write_file("{tree}/fakebin/cc", [
        "#!/bin/sh",
        "for a in \"$@\"; do",
        "    case \"$a\" in",
        "        *.c) if grep -q BLINK_FAKE_CC_REJECTS_THIS \"$a\" 2>/dev/null; then echo \"fake-cc: rejected $a\" >&2; exit 1; fi ;;",
        "    esac",
        "done",
        "exec {real_cc} \"$@\"",
        "",
    ].join("\n"))
    shell_exec("chmod +x {tree}/fakebin/cc")
    shell_exec("sed -i \"s/s.sides \\* 10/s.sides * 10 + \\\"BLINK_FAKE_CC_REJECTS_THIS\\\".byte_len() * 0/\" {tree}/app/src/shapes.bl")
}

fn build_with_fake_cc(tree: Str, out: Str, flags: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE CCACHE_DISABLE=1 PATH={tree}/fakebin:$PATH BLINK_CACHE_DIR={tree}/objcache build/blink build app/src/main.bl -o {tree}/out/{out} {flags}"])
}

test "a cc error names the unit and exits like the one-unit build" {
    let root = sh("pwd -P")
    let tree = "{root}/.tmp/_per_module_cc_error_{getpid()}"
    dev_tree(root, tree)
    fake_cc(tree)
    let marked = sh("grep -c BLINK_FAKE_CC_REJECTS_THIS {tree}/app/src/shapes.bl")
    let one = build_with_fake_cc(tree, "one", "")
    let units = build_with_fake_cc(tree, "units", "--per-module")
    let units_bin = file_exists("{tree}/out/units")
    shell_exec("rm -rf {tree}")
    assert_eq(marked, "1")
    assert(one.exit_code != 0, "the one-unit build passed: {one.out}")
    assert_eq(units.exit_code, one.exit_code)
    let all = "{units.out}\n{units.err_out}"
    assert(all.contains("error: C compilation failed in unit shapes"), "got: {all}")
    assert(all.contains("fake-cc: rejected"), "cc output was dropped: {all}")
    assert(!all.contains("in unit tally"), "got: {all}")
    assert(!all.contains("in unit __main__"), "got: {all}")
    assert_eq(units_bin, 0)
}
