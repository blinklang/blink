// The entry unit holds the program's main, which runs the test blocks. An entry file that
// holds only imports and test blocks declares nothing else, and its per-module build must
// still get that unit, or the link finds no main.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"calc_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/calc.bl", [
        #"pub fn double(x: Int) -> Int {"#,
        #"    x * 2"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main_test.bl", [
        #"import calc.{double}"#,
        #""#,
        #"test "double doubles" {"#,
        #"    assert_eq(double(2), 4)"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes
// --per-module build one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache build/blink {args}"])
}

test "an entry file of only imports and tests builds per module with an entry unit" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_tests_only_entry_{getpid()}"
    dev_tree(root, tree)
    let b = blink_in(tree, "build app/src/main_test.bl -o {tree}/out/app --per-module --debug")
    let units = sh("cd {tree}/out/app.units 2>/dev/null && ls *.c | LC_ALL=C sort | tr '\\n' ' '")
    let ran = process_run("sh", ["-c", "{tree}/out/app"])
    shell_exec("rm -rf {tree}")
    assert(b.exit_code == 0, "per-module build failed: {b.out}{b.err_out}")
    assert_eq(units, "__main__.c calc.c")
    assert_eq(ran.exit_code, 0)
    assert(ran.out.contains("1 passed"), "got: {ran.out}{ran.err_out}")
}
