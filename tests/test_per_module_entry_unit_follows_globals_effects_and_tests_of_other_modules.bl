// The entry unit's text reads the globals that other modules set at run time, every effect,
// whether any body spawns, and every key table. A per-module build must emit the entry unit
// again after an edit in another module that changes its text: a global made deferred or
// constant again, a deferred global added, an effect declared or changed, a first spawn and a
// first tuple-keyed Map. It takes the unit after an edit that leaves the text the same: a
// plain body edit, a test in an imported module, which is not in the program, a second spawn,
// a second Map with the same tuple key type in an earlier source, and a body edit in the source
// that declares an effect. Each build runs with BLINK_EMIT_REUSE_VERIFY=1, so every unit it
// writes or takes is byte-equal to a cold emit.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"entry_reads_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/base.bl", [
        #"pub let LIMIT: Int = 5"#,
        #""#,
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s} {LIMIT}]""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/leaf.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag("leaf")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #"import leaf.{leaf_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{tag("main")} {leaf_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both and the module filters.
fn build(tree: Str) -> ProcessResult {
    let r = process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_EMIT_REUSE_VERIFY=1 BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink build app/src/main.bl -o {tree}/out/app --per-module"]).unwrap()
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    r
}

fn took_entry(r: ProcessResult) -> Bool {
    "{r.out}\n{r.err_out}".split("\n").contains("[dbg:build.units] reuse unit __main__")
}

fn edit(tree: Str, file: Str, sed: Str) {
    let path = "{tree}/app/src/{file}"
    let before = read_file(path)
    shell_exec("sed -i '{sed}' {path}")
    assert(read_file(path) != before, "the edit `{sed}` did not change {file}")
}

fn append(tree: Str, file: Str, text: Str) {
    let path = "{tree}/app/src/{file}"
    write_file(path, "{read_file(path)}{text}")
}

// Whether the build took the entry unit, and whether its text is the last build's.
fn step(tree: Str, name: Str) -> Str {
    let unit = "{tree}/out/app.units/__main__.c"
    let before = read_file(unit)
    let took = took_entry(build(tree))
    let text = if read_file(unit) == before { "same" } else { "changed" }
    "{name}: took {took}, text {text}"
}

test "the entry unit is emitted again when another module changes its text, and taken when not" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_entry_reads_{getpid()}"
    dev_tree(root, tree)
    let _first = build(tree)
    let mut seen: List[Str] = []
    edit(tree, "leaf.bl", #"s/tag("leaf")/tag("leaf2")/"#)
    seen.push(step(tree, "plain body"))
    edit(tree, "base.bl", "s/LIMIT: Int = 5/LIMIT: Int = [5, 6].len() + 3/")
    seen.push(step(tree, "global made deferred"))
    edit(tree, "base.bl", "s/LIMIT: Int = \\[5, 6\\].len() + 3/LIMIT: Int = 5/")
    seen.push(step(tree, "global made constant again"))
    append(tree, "leaf.bl", "\npub let WORDS: List[Str] = \"a b\".split(\" \")\n")
    seen.push(step(tree, "deferred global added"))
    append(tree, "leaf.bl", "\ntest \"leaf tag\" \{\n    assert_eq(leaf_value(), \"[leaf2 5]\")\n}\n")
    seen.push(step(tree, "test in an imported module"))
    append(tree, "leaf.bl", "\neffect Probe \{\n    effect Ping \{\n        fn ping() -> Int\n    }\n}\n")
    seen.push(step(tree, "effect declared"))
    edit(tree, "leaf.bl", #"s/^        fn ping() -> Int$/        fn ping() -> Int\n        fn pong(n: Int) -> Str/"#)
    seen.push(step(tree, "effect changed"))
    edit(tree, "leaf.bl", #"s/tag("leaf2")/tag("leaf2 {async.spawn(fn() -> Int { 41 + 1 }).await}")/"#)
    seen.push(step(tree, "first spawn"))
    edit(tree, "base.bl", #"s/"\[{s} {LIMIT}\]"/"[{s} {LIMIT} {async.spawn(fn() -> Int { 2 }).await}]"/"#)
    seen.push(step(tree, "second spawn"))
    edit(tree, "leaf.bl", #"s/tag("leaf2 /tag("leaf2 {pairs()} /"#)
    append(tree, "leaf.bl", "\nfn pairs() -> Int \{\n    let mut m: Map[(Int, Str), Int] = Map()\n    m.insert((1, \"x\"), 3)\n    m.len()\n}\n")
    seen.push(step(tree, "first tuple-keyed map"))
    edit(tree, "base.bl", #"s/"\[{s} {LIMIT} /"[{s} {LIMIT} {more()} /"#)
    append(tree, "base.bl", "\nfn more() -> Int \{\n    let mut m: Map[(Int, Str), Bool] = Map()\n    m.insert((3, \"z\"), true)\n    m.len()\n}\n")
    seen.push(step(tree, "same key in an earlier source"))
    edit(tree, "leaf.bl", #"s/tag("leaf2 /tag("leaf3 /"#)
    seen.push(step(tree, "body edit beside an effect"))
    seen.push(sh("{tree}/out/app"))
    shell_exec("rm -rf {tree}")
    assert_eq(seen.join("\n"), [
        "plain body: took true, text same",
        "global made deferred: took false, text changed",
        "global made constant again: took false, text changed",
        "deferred global added: took false, text changed",
        "test in an imported module: took true, text same",
        "effect declared: took false, text changed",
        "effect changed: took false, text changed",
        "first spawn: took false, text changed",
        "second spawn: took true, text same",
        "first tuple-keyed map: took false, text changed",
        "same key in an earlier source: took true, text same",
        "body edit beside an effect: took true, text same",
        "[main 5 1 2] [leaf3 1 42 5 1 2]",
    ].join("\n"))
}
