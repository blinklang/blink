// The entry unit reads facts of the whole program that no source span carries: whether any
// body spawns a task, the test table, the key table of each tuple a Map or Set keys on, and
// the init calls of the modules with a global set at run time. A per-module build that takes
// the entry unit from the last build must see each of these change, so an edit that adds a
// spawn, a new tuple-keyed Map or a new tuple-keyed Set to a body in another module, a test
// to the entry file of a test build, or a line to the entry file's main emits the entry unit
// again. A plain body edit in between shows the build takes it otherwise. Each build runs with
// BLINK_EMIT_REUSE_VERIFY=1, so every unit it writes or takes is byte-equal to a cold emit,
// and the binary prints what the program says.

import std.process.{ProcessResult, ChildEnd}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"entry_fact_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/base.bl", [
        #"pub let NAMES: List[Str] = ["a", "b"]"#,
        #""#,
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s} {NAMES.len()}]""#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/leaf.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag("leaf")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #"import leaf.{leaf_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{tag("main")} {leaf_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both and the module filters.
fn build(tree: Str) -> ProcessResult ! Process.Spawn {
    build_with(tree, "build")
}

// Only a test build writes the test table, so only a test build shows that fact change.
fn test_build(tree: Str) -> ProcessResult ! Process.Spawn {
    build_with(tree, "__test-build")
}

fn build_with(tree: Str, cmd: Str) -> ProcessResult ! Process.Spawn {
    let r = process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_EMIT_REUSE_VERIFY=1 BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=blink.build.units build/blink {cmd} app/src/main.bl -o {tree}/out/app --per-module"]).unwrap()
    assert(r.success(), "per-module {cmd} failed: {r.out}{r.err_out}")
    r
}

fn took_entry(r: ProcessResult) -> Bool {
    "{r.out}\n{r.err_out}".split("\n").contains("[trace:blink.build.units] reuse unit __main__")
}

fn edit(tree: Str, file: Str, sed: Str) ! FS.Read, Process.Spawn {
    let path = "{tree}/app/src/{file}"
    let before = fs.read(path).unwrap()
    process.run("sh", ["-c", "sed -i '{sed}' {path}"]).unwrap()
    assert(fs.read(path).unwrap() != before, "the edit `{sed}` did not change {file}")
}

fn append(tree: Str, file: Str, text: Str) ! FS.Write, FS.Read {
    let path = "{tree}/app/src/{file}"
    fs.write(path, "{fs.read(path).unwrap()}{text}").unwrap()
}

fn step(tree: Str, name: Str) -> Str ! Process.Spawn {
    let took = took_entry(build(tree))
    "{name} {took} {sh("{tree}/out/app").replace("\n", "|")}"
}

test "an edit that changes a fact of the whole program emits the entry unit again" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_entry_fact_{getpid()}"
    dev_tree(root, tree)
    let _first = build(tree)
    let mut seen: List[Str] = []
    edit(tree, "leaf.bl", #"s/tag("leaf")/tag("leaf {async.spawn(fn() -> Int { 41 + 1 }).await}")/"#)
    seen.push(step(tree, "spawn"))
    edit(tree, "leaf.bl", #"s/tag("leaf /tag("leaf: /"#)
    seen.push(step(tree, "plain body"))
    edit(tree, "leaf.bl", #"s/tag("leaf: /tag("leaf {pairs()} /"#)
    append(tree, "leaf.bl", "fn pairs() -> Int \{\n    let mut m: Map[(Int, Str), Int] = Map()\n    m.insert((1, \"x\"), 3)\n    m.len()\n}\n")
    seen.push(step(tree, "tuple-keyed map"))
    edit(tree, "leaf.bl", #"s/^    m.len()$/    let mut s: Set[(Str, Bool)] = Set()\n    s.insert(("y", true))\n    m.len() + s.len()/"#)
    seen.push(step(tree, "tuple-keyed set"))
    edit(tree, "main.bl", #"s/^fn main() {$/fn main() {\n    io.println("start")/"#)
    seen.push(step(tree, "entry body"))
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert_eq(seen.join("\n"), [
        "spawn false [main 2] [leaf 42 2]",
        "plain body true [main 2] [leaf: 42 2]",
        "tuple-keyed map false [main 2] [leaf 1 42 2]",
        "tuple-keyed set false [main 2] [leaf 2 42 2]",
        "entry body false start|[main 2] [leaf 2 42 2]",
    ].join("\n"))
}

test "a test added to the entry file emits the entry unit of a test build again" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_entry_test_fact_{getpid()}"
    dev_tree(root, tree)
    append(tree, "main.bl", "test \"main tag\" \{\n    assert_eq(tag(\"t\"), \"[t 2]\")\n}\n")
    let _first = test_build(tree)
    append(tree, "main.bl", "test \"leaf tag\" \{\n    assert_eq(leaf_value(), \"[leaf 2]\")\n}\n")
    let took = took_entry(test_build(tree))
    let ran = process.run("{tree}/out/app", [])?
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(!took, "a test build took the entry unit after a test was added")
    assert_eq(ran.end, ChildEnd.Exited(0))
    assert(ran.out.contains("2 passed, 0 failed (of 2)"), "got: {ran.out}{ran.err_out}")
}

// The entry's main turns on the channels of `trace.log` only when the program holds one, so
// the first `trace.log`, added in another module, is a fact of the whole program too.
test "a first trace.log added to another module turns its channel on" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_entry_trace_fact_{getpid()}"
    dev_tree(root, tree)
    let _first = build(tree)
    edit(tree, "leaf.bl", #"s/^    tag("leaf")$/    trace.log("c", "in leaf")\n    tag("leaf")/"#)
    let _second = build(tree)
    let ran = process.run("env", ["BLINK_TRACE_CHANNELS=c", "{tree}/out/app"])?
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert_eq(ran.out, "[main 2] [leaf 2]\n")
    assert_eq(ran.err_out, "[trace:c] in leaf\n")
}
