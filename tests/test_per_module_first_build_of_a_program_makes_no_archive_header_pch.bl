// A program's first build makes no PCH of the archive header: no later build of a one-off
// program (a test, a CI job) would read it. The units directory of the last build shows the
// program was built before, so its next build makes the PCH, and the builds after it read it.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

// A dev tree with a program of two modules, and a cc first on PATH that runs the real cc
// with -H on each compile, so its log names the PCH a unit read ("! <path>.gch"). Each
// compile logs to a file of its own: gcc writes -H lines in pieces, which parallel compiles
// would interleave in one file.
fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/bin")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    let real_cc = sh("command -v cc")
    write_file("{tree}/bin/cc", "#!/bin/sh\ncase \" $* \" in *\" -c \"*) exec {real_cc} \"$@\" -H 2>\"$(mktemp {tree}/cc_h/XXXXXX)\" ;; esac\nexec {real_cc} \"$@\"\n")
    shell_exec("chmod +x {tree}/bin/cc")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"pch_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/part.bl", "pub fn value() -> Int \{\n    41\n\}\n")
    edit_main(tree, 1)
}

fn edit_main(tree: Str, n: Int) {
    write_file("{tree}/app/src/main.bl", "import part.\{value\}\n\nfn main() \{\n    let total = value() + {n}\n    io.println(\"sum \{total\}\")\n\}\n")
}

// Runs blink in the tree with its own object cache, the -H cc and the unit trace. The corpus
// exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the
// run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    shell_exec("rm -rf {tree}/cc_h && mkdir {tree}/cc_h")
    process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink {args}"])
}

fn build_ok(tree: Str, flags: Str) {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module {flags}")
    assert(r.exit_code == 0, "build failed: {r.out}{r.err_out}")
}

// The compiles of the last build that read a PCH from the object cache.
fn pch_reads(tree: Str) -> Int {
    sh("cat {tree}/cc_h/* | grep -c '^! {tree}/objcache/[0-9a-f]*\\.pch/libblink_std\\.h\\.gch$'").to_int()
}

fn pch_dirs(tree: Str) -> List[Str] {
    let out = sh("cd {tree}/objcache && ls -d *.pch 2>/dev/null")
    if out == "" { [] } else { out.split("\n") }
}

// build_ok, answering what the build printed.
fn build_out(tree: Str, flags: Str) -> Str {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module {flags}")
    assert(r.exit_code == 0, "build failed: {r.out}{r.err_out}")
    "{r.out}{r.err_out}"
}

test "the first build of a program makes no archive header PCH and the second makes one" {
    let root = sh("pwd -P")
    let tree = "{root}/.tmp/_pch_lazy_{getpid()}"
    dev_tree(root, tree)
    let first_out = build_out(tree, "")
    let first = pch_dirs(tree).len()
    let first_run = sh("{tree}/out/app")
    edit_main(tree, 2)
    let second_out = build_out(tree, "")
    let second = pch_dirs(tree).len()
    edit_main(tree, 3)
    build_ok(tree, "")
    let third_reads = pch_reads(tree)
    let third_run = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert_eq(first, 0)
    assert(!first_out.contains("pch build"), "the first build started a PCH build: {first_out}")
    assert_eq(first_run, "sum 42")
    assert_eq(second, 1)
    assert(second_out.contains("pch build"), "the second build started no PCH build: {second_out}")
    assert(third_reads >= 1, "no unit of the third build read the PCH")
    assert_eq(third_run, "sum 44")
}
