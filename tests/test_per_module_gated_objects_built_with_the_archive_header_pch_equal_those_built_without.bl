// The PCH a unit under a native dep gate reads is built with that gate and with the dep's
// include dir, so the dep's header resolves as it does in a compile without the PCH. Each
// object a unit compiles with it must be the bytes it compiles to without it.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with a program whose store module uses sqlite, and a cc first on PATH that runs the real cc
// with -H on each compile, so its log names the PCH a unit read ("! <path>.gch"). Each
// compile logs to a file of its own: gcc writes -H lines in pieces, which parallel compiles
// would interleave in one file.
fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src {tree}/bin"]).unwrap()
    compile_test_helpers.seed_native_cache(root, tree)
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    let real_cc = sh("command -v cc")
    fs.write("{tree}/bin/cc", "#!/bin/sh\ncase \" $* \" in *\" -c \"*) exec {real_cc} \"$@\" -H 2>\"$(mktemp {tree}/cc_h/XXXXXX)\" ;; esac\nexec {real_cc} \"$@\"\n").unwrap()
    process.run("sh", ["-c", "chmod +x {tree}/bin/cc"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"pch_store_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import store.{stored_names}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("stored {stored_names()}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    // A program's first build makes no PCH, so the tree starts with one build behind it.
    edit_store(tree, 0)
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.success(), "build failed: {r.out}{r.err_out}")
    edit_store(tree, 1)
}

fn edit_store(tree: Str, n: Int) ! FS.Write {
    fs.write("{tree}/app/src/store.bl", [
        #"import std.db_sqlite.{sqlite_open, sqlite_handler}"#,
        #""#,
        #"pub fn stored_names() -> Str {"#,
        #"    let handle = sqlite_open(":memory:")"#,
        #"    with sqlite_handler(handle) {"#,
        #"        db.exec("CREATE TABLE t (name TEXT)").unwrap()"#,
        "        db.exec(\"INSERT INTO t VALUES ('kept {n}')\").unwrap()",
        #"        let rows = db.query("SELECT name FROM t").unwrap()"#,
        #"        rows.get(0).unwrap().get("name").unwrap()"#,
        #"    }"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// Runs blink in the tree with its own object cache, the -H cc and the unit trace. The corpus
// exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the
// run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult ! Process.Spawn {
    blink_in_env(tree, "", args)
}

// blink_in with the variables in envs ("NAME=value ...") set as well.
fn blink_in_env(tree: Str, envs: Str, args: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "rm -rf {tree}/cc_h && mkdir {tree}/cc_h"]).unwrap()
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units {envs} build/blink {args}"]).unwrap()
}

fn build_out(tree: Str, flags: Str) -> Str ! Process.Spawn {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module {flags}")
    assert(r.success(), "build failed: {r.out}{r.err_out}")
    "{r.out}{r.err_out}"
}

// The compiles of the last build that read a PCH from the object cache, which the build
// holds in a dir of its own under tmp/ while its units compile.
fn pch_reads(tree: Str) -> Int ! Process.Spawn {
    sh("cat {tree}/cc_h/* | grep -c '^! {tree}/objcache/tmp/hold\\.[A-Za-z0-9]*/pch/libblink_std\\.h\\.gch$'").to_int()
}

fn pch_dirs(tree: Str) -> List[Str] ! Process.Spawn {
    let out = sh("cd {tree}/objcache && ls -d *.pch 2>/dev/null")
    if out == "" { [] } else { out.split("\n") }
}

// The objects in the cache after a build with no cached object, by key, as "<sha>  <key>.o"
// lines, and how many units read the PCH.
fn objects_built(tree: Str, flags: Str, n: Int) -> (Str, Int) ! FS.Write, Process.Spawn {
    objects_built_with(tree, "", flags, n)
}

// objects_built with the variables in envs set.
fn objects_built_with(tree: Str, envs: Str, flags: Str, n: Int) -> (Str, Int) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -f {tree}/objcache/*.o {tree}/objcache/*.meta"]).unwrap()
    edit_store(tree, n)
    let r = blink_in_env(tree, envs, "build app/src/main.bl -o {tree}/out/app --per-module {flags}")
    assert(r.success(), "build failed: {r.out}{r.err_out}")
    (sh("cd {tree}/objcache && sha256sum *.o"), pch_reads(tree))
}

fn binary_sha(tree: Str) -> Str ! Process.Spawn {
    sh("sha256sum < {tree}/out/app")
}

fn with_and_without(root: Str, flags: Str, label: Str) ! Process.Spawn, FS.Write, Env.Read {
    let tree = "{compile_test_helpers.scratch_root()}/_pch_gated_equal_{label}_{getpid()}"
    dev_tree(root, tree)
    // Leaves the PCH in the cache for the next build.
    let _ = build_out(tree, flags)
    let (pch_objs, pch_reads_n) = objects_built(tree, flags, 2)
    let pch_bin = binary_sha(tree)
    let dirs = pch_dirs(tree)
    assert(dirs.len() == 1, "{label}: the builds made {dirs.len()} PCH dirs")
    let dir = dirs.get(0).unwrap()
    // gcc warns on a file too short to be a PCH and reads the header copy beside it.
    process.run("sh", ["-c", "printf garbage > {tree}/objcache/{dir}/libblink_std.h.gch"]).unwrap()
    let (plain_objs, plain_reads_n) = objects_built(tree, flags, 2)
    let plain_bin = binary_sha(tree)
    // With the PCH off, no unit names a PCH dir, so its objects are those of a build that
    // never had one.
    let (off_objs, off_reads_n) = objects_built_with(tree, "BLINK_ARCHIVE_PCH=0", flags, 2)
    let off_bin = binary_sha(tree)
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    assert(pch_reads_n >= 2, "{label}: {pch_reads_n} units read the PCH")
    assert_eq(plain_reads_n, 0)
    assert(pch_objs.split("\n").len() >= 2, "{label}: objects {pch_objs}")
    assert_eq(pch_objs, plain_objs)
    assert_eq(off_reads_n, 0)
    assert_eq(pch_objs, off_objs)
    assert_eq(pch_bin, plain_bin)
    assert_eq(pch_bin, off_bin)
}

test "objects of units under a native dep gate built with the archive header PCH equal those built without it" {
    let root = sh("pwd -P")
    with_and_without(root, "", "default")
    with_and_without(root, "--debug", "debug")
}
