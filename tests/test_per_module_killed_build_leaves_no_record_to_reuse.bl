// A per-module build killed before it finishes leaves no record that claims its units, so the
// next build writes them again rather than reusing what the killed build began.

import std.process.{ProcessResult, ChildEnd}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"reuse_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/greet.bl", [
        #"pub fn greet(name: Str) -> Str {"#,
        #"    "hello {name}""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import greet.{greet}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println(greet("units"))"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both, and the module filters.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink {args}"]).unwrap()
}

// "reuse emit" or "emit": which way the build got its units, read from its build.units trace.
fn emit_kind(r: ProcessResult) -> Str {
    for line in "{r.out}\n{r.err_out}".split("\n") {
        if line == "[dbg:build.units] reuse emit" { return "reuse emit" }
        if line == "[dbg:build.units] emit" { return "emit" }
    }
    "none"
}

fn build(tree: Str) -> ProcessResult {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    r
}

// A cc first on PATH that kills the build at its link, the last step before the build
// replaces its units directory, and passes every other call to the real cc.
fn killing_cc(tree: Str) {
    let real_cc = sh("command -v cc")
    shell_exec("mkdir -p {tree}/fakebin")
    write_file("{tree}/fakebin/cc", [
        "#!/bin/sh",
        "case \"$*\" in *libblink_std.a*) kill -9 $(cat {tree}/build.pid); sleep 5; exit 1;; esac",
        "exec {real_cc} \"$@\"",
        "",
    ].join("\n"))
    shell_exec("chmod +x {tree}/fakebin/cc")
}

test "a build killed at its link leaves no record the next build reuses" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_reuse_killed_{getpid()}"
    dev_tree(root, tree)
    killing_cc(tree)
    let _cold = build(tree)
    shell_exec("sed -i \"s/hello/howdy/\" {tree}/app/src/greet.bl")
    let killed = process.run("sh", ["-c", "cd {tree} || exit 1; PATH={tree}/fakebin:$PATH env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache build/blink build app/src/main.bl -o {tree}/out/app --per-module & echo $! > {tree}/build.pid; wait $!"])?
    let records_left = sh("ls -a {tree}/out/.units.*/.emit-record 2>/dev/null | wc -l")
    let next = build(tree)
    let out = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(killed.end == ChildEnd.Exited(137), "the build was not killed: {killed.end}\n {killed.out}{killed.err_out}")
    assert_eq(records_left, "0")
    assert_eq(emit_kind(next), "emit")
    assert_eq(out, "howdy units")
}
