// A unit includes the header of a module only when it names something that header
// declares. Adding a pub fn changes the header of its own module and no other, so only
// that module and the units that call into it compile again. A unit that never names the
// module, even one that reaches it through another import, hits the cache.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"pubfn_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/shapes.bl", [
        #"pub type Shape {"#,
        #"    name: Str"#,
        #"    sides: Int"#,
        #"}"#,
        #""#,
        #"pub fn score(s: Shape) -> Int {"#,
        #"    s.sides * 10 + 1"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/tally.bl", [
        #"import shapes.{Shape, score}"#,
        #""#,
        #"pub fn total(xs: List[Shape]) -> Int {"#,
        #"    let mut t = 0"#,
        #"    for s in xs {"#,
        #"        t = t + score(s)"#,
        #"    }"#,
        #"    t"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/labels.bl", [
        #"pub fn banner(s: Str) -> Str {"#,
        #"    "== {s}""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import shapes.{Shape}"#,
        #"import tally.{total}"#,
        #"import labels.{banner}"#,
        #""#,
        #"fn main() {"#,
        #"    let xs = [Shape { name: "tri", sides: 3 }, Shape { name: "sq", sides: 4 }]"#,
        #"    io.println(banner("total {total(xs)}"))"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// Runs blink in the tree with its own object cache, and the unit trace on. The corpus
// exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes --per-module
// build one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink {args}"])
}

// The units a build compiled, read from its build.units trace, sorted so the check does
// not depend on the order the units start in.
fn units_compiled(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        let mark = "[dbg:build.units] compile "
        if line.starts_with(mark) {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len()).trim())
        }
    }
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap() > cur {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

fn build_units(tree: Str) -> List[Str] {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.exit_code == 0, "per-module build failed: {r.out}{r.err_out}")
    units_compiled(r)
}

test "a new pub fn recompiles its own module and the units that call into it, and no other" {
    let root = sh("pwd -P")
    let tree = "{root}/.tmp/_per_module_new_pub_fn_{getpid()}"
    dev_tree(root, tree)
    let cold = build_units(tree)
    shell_exec("printf \"\\npub fn bonus() -> Int \{ 2 }\\n\" >> {tree}/app/src/shapes.bl")
    let edited = build_units(tree)
    let out = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert_eq(cold.join(","), "__main__,labels,shapes,tally")
    // main.bl imports shapes for the type alone, so it names nothing shapes.h declares.
    assert_eq(edited.join(","), "shapes,tally")
    assert(out.contains("== total 72"), "got: {out}")
}
