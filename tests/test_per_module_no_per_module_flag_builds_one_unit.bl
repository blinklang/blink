// --no-per-module asks `blink build`, `blink run` and `blink test` for the one-unit build, so
// a per-module bug can be bisected against it: the whole program goes into one C file and no
// units directory is written.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"calc_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/calc.bl", [
        #"pub fn double(x: Int) -> Int {"#,
        #"    x * 2"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import calc.{double}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{double(21)}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main_test.bl", [
        #"import calc.{double}"#,
        #""#,
        #"test "double doubles" {"#,
        #"    assert_eq(double(2), 4)"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// fall back to one unit, and the per-module corpus exports BLINK_PER_MODULE. The run drops
// them all, so only the flag asks for one unit.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_PER_MODULE BLINK_CACHE_DIR={tree}/objcache build/blink {args}"]).unwrap()
}

fn exists(path: Str) -> Str {
    sh("[ -e {path} ] && echo yes || echo no")
}

test "build --no-per-module builds one C unit" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_no_per_module_build_{getpid()}"
    dev_tree(root, tree)
    let b = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --no-per-module")
    let units = exists("{tree}/out/app.units")
    let one_c = exists("{tree}/out/app.c")
    let ran = process.run("sh", ["-c", "{tree}/out/app"])?
    shell_exec("rm -rf {tree}")
    assert(b.success(), "build failed: {b.out}{b.err_out}")
    assert_eq(units, "no")
    assert_eq(one_c, "yes")
    assert_eq(ran.out.trim(), "42")
}

test "run --no-per-module builds one C unit" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_no_per_module_run_{getpid()}"
    dev_tree(root, tree)
    let r = blink_in(tree, "run app/src/main.bl --no-per-module")
    let units = exists("{tree}/build/main.units")
    let one_c = exists("{tree}/build/main.c")
    shell_exec("rm -rf {tree}")
    assert(r.success(), "run failed: {r.out}{r.err_out}")
    assert(r.out.contains("42"), "got: {r.out}")
    assert_eq(units, "no")
    assert_eq(one_c, "yes")
}

test "test --no-per-module builds one C unit, for a file and for a directory" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_no_per_module_test_{getpid()}"
    dev_tree(root, tree)
    let file = blink_in(tree, "test app/src/main_test.bl --no-per-module")
    let file_units = exists("{tree}/build/main_test.units")
    let file_c = exists("{tree}/build/main_test.c")
    let dir = blink_in(tree, "test app/src --no-per-module")
    let dir_units = exists("{tree}/build/app/src/main_test.units")
    let dir_c = exists("{tree}/build/app/src/main_test.c")
    shell_exec("rm -rf {tree}")
    assert(file.success(), "test failed: {file.out}{file.err_out}")
    assert_eq(file_units, "no")
    assert_eq(file_c, "yes")
    assert(dir.success(), "test failed: {dir.out}{dir.err_out}")
    assert_eq(dir_units, "no")
    assert_eq(dir_c, "yes")
}

test "--per-module and --no-per-module together are an error" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_no_per_module_both_{getpid()}"
    dev_tree(root, tree)
    let b = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module --no-per-module")
    let built = exists("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(!b.success(), "both flags built: {b.out}{b.err_out}")
    assert(b.err_out.contains("--no-per-module"), "got: {b.err_out}")
    assert_eq(built, "no")
}
