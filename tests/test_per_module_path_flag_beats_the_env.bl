// A path flag on the command beats BLINK_PER_MODULE: --no-per-module builds one C unit under
// BLINK_PER_MODULE=1, and --per-module builds units under BLINK_PER_MODULE=0. So one command
// can be bisected inside a run that sets the env for every build.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"calc_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/calc.bl", [
        #"pub fn double(x: Int) -> Int {"#,
        #"    x * 2"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import calc.{double}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{double(21)}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main_test.bl", [
        #"import calc.{double}"#,
        #""#,
        #"test "double doubles" {"#,
        #"    assert_eq(double(2), 4)"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// fall back to one unit, so the run drops them, and sets BLINK_PER_MODULE itself.
fn blink_in(tree: Str, env_val: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_PER_MODULE={env_val} BLINK_CACHE_DIR={tree}/objcache build/blink {args}"]).unwrap()
}

fn unit_files(dir: Str) -> Str {
    sh("cd {dir} 2>/dev/null && ls *.c | LC_ALL=C sort | tr '\\n' ' '")
}

fn exists(path: Str) -> Str {
    sh("[ -e {path} ] && echo yes || echo no")
}

test "--no-per-module beats BLINK_PER_MODULE=1 for build, run and test" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_path_flag_off_beats_env_{getpid()}"
    dev_tree(root, tree)
    let b = blink_in(tree, "1", "build app/src/main.bl -o {tree}/out/app --no-per-module")
    let b_units = exists("{tree}/out/app.units")
    let b_c = exists("{tree}/out/app.c")
    let r = blink_in(tree, "1", "run app/src/main.bl --no-per-module")
    let r_units = exists("{tree}/build/main.units")
    let r_c = exists("{tree}/build/main.c")
    let t = blink_in(tree, "1", "test app/src --no-per-module")
    let t_units = exists("{tree}/build/app/src/main_test.units")
    let t_c = exists("{tree}/build/app/src/main_test.c")
    shell_exec("rm -rf {tree}")
    assert(b.success(), "build failed: {b.out}{b.err_out}")
    assert_eq(b_units, "no")
    assert_eq(b_c, "yes")
    assert(r.success(), "run failed: {r.out}{r.err_out}")
    assert_eq(r_units, "no")
    assert_eq(r_c, "yes")
    assert(t.success(), "test failed: {t.out}{t.err_out}")
    assert_eq(t_units, "no")
    assert_eq(t_c, "yes")
}

test "--per-module beats BLINK_PER_MODULE=0 for build, run and test" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_path_flag_on_beats_env_{getpid()}"
    dev_tree(root, tree)
    let b = blink_in(tree, "0", "build app/src/main.bl -o {tree}/out/app --per-module")
    let b_units = unit_files("{tree}/out/app.units")
    let r = blink_in(tree, "0", "run app/src/main.bl --per-module")
    let r_units = unit_files("{tree}/build/main.units")
    let t = blink_in(tree, "0", "test app/src --per-module")
    let t_units = unit_files("{tree}/build/app/src/main_test.units")
    shell_exec("rm -rf {tree}")
    assert(b.success(), "build failed: {b.out}{b.err_out}")
    assert_eq(b_units, "__main__.c calc.c")
    assert(r.success(), "run failed: {r.out}{r.err_out}")
    assert_eq(r_units, "__main__.c calc.c")
    assert(t.success(), "test failed: {t.out}{t.err_out}")
    assert_eq(t_units, "__main__.c calc.c")
}
