// When two unit compiles fail, the build prints their output and its error lines in unit
// order (largest unit first), not in the order the compiles ended.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with a program of five units: big, the largest, so it is the first unit, and
// __main__, a, b and c. A cc first on PATH fails the compiles of big and a, each with a line
// on stdout and on stderr that names it. It holds big until a has ended, and gives up after
// 20 s, so a ends first.
fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src {tree}/bin {tree}/done"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    let real_cc = sh("command -v cc")
    let script = [
        "#!/bin/sh",
        "case \" $* \" in *\" -c \"*) ;; *) exec {real_cc} \"$@\" ;; esac",
        "for a in \"$@\"; do case \"$a\" in *.c) unit=$(basename \"$a\" .c) ;; esac; done",
        "if [ \"$unit\" = big ]; then",
        "    n=0",
        "    while [ ! -e {tree}/done/a ]; do",
        "        n=$((n + 1))",
        "        if [ $n -ge 400 ]; then break; fi",
        "        sleep 0.05",
        "    done",
        "fi",
        "case \"$unit\" in",
        "    big|a) echo \"cc stdout of $unit\"; echo \"cc stderr of $unit\" >&2; rc=1 ;;",
        "    *) {real_cc} \"$@\"; rc=$? ;;",
        "esac",
        "touch {tree}/done/$unit",
        "exit $rc",
    ]
    fs.write("{tree}/bin/cc", "{script.join("\n")}\n").unwrap()
    process.run("sh", ["-c", "chmod +x {tree}/bin/cc"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"order_app\"\nversion = \"0.1.0\"\n").unwrap()
    let mut big: List[Str] = []
    let mut i = 1
    while i <= 60 {
        big.push("pub fn big_{i}(x: Int) -> Int \{\n    let mut s = x\n    for j in 0..{i} \{ s = s + j * {i} \}\n    s\n\}\n")
        i = i + 1
    }
    fs.write("{tree}/app/src/big.bl", big.join("\n")).unwrap()
    for m in ["a", "b", "c"] {
        fs.write("{tree}/app/src/{m}.bl", "pub fn {m}_value() -> Int \{\n    1\n\}\n").unwrap()
    }
    fs.write("{tree}/app/src/main.bl", "import big.\{big_1\}\nimport a.\{a_value\}\nimport b.\{b_value\}\nimport c.\{c_value\}\n\nfn main() \{\n    io.println(\"sum \{big_1(1) + a_value() + b_value() + c_value()\}\")\n\}\n").unwrap()
}

// Runs blink in the tree with its own object cache and the failing cc. The corpus exports
// BLINK_COMPILER_ARCHIVE and module filters, which make the build one unit, so the run drops
// them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_JOBS PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/objcache BLINK_ARCHIVE_PCH=0 build/blink {args}"]).unwrap()
}

fn lines_with(text: Str, part: Str) -> List[Str] {
    text.split("\n").filter(fn(l) { l.contains(part) })
}

test "unit compile errors print in unit order, not in the order the compiles end" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_unit_err_order_{getpid()}"
    dev_tree(root, tree)
    // Three slots: big, __main__ and a start together, so a ends while big waits for it.
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module --jobs 3")
    let ended_first = sh("ls -tr --time=ctime {tree}/done | head -1")
    let a_before_big = compile_test_helpers.path_exists("{tree}/done/a")
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(!r.success(), "the build passed: {r.out}")
    assert(a_before_big, "a did not end")
    assert(ended_first != "big", "big ended first, so the test proves no order")
    assert_eq(lines_with(r.out, "cc stdout of").join("|"), "cc stdout of big|cc stdout of a")
    assert_eq(lines_with(r.err_out, "cc stderr of").join("|"), "cc stderr of big|cc stderr of a")
    assert_eq(lines_with(r.out, "C compilation failed").join("|"), "error: C compilation failed in unit big|error: C compilation failed in unit a")
}
