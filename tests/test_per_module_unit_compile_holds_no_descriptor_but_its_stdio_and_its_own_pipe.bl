// A unit compile starts with its stdin, its two output files and the write end of its own
// pipe, and no other descriptor of the build: not the pipes of the units started before it,
// nor those of the PCH compile that runs beside it. A process cc leaves running would else
// hold the pipe of another unit, or of the PCH compile, open. Linux only: it reads /proc.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

// A dev tree with a program of four units: __main__, a, b and c. While probe exists, the cc
// in bin/ writes `ls -l` of its own descriptors to fds/<unit>.
fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/bin {tree}/fds")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    let real_cc = sh("command -v cc")
    // ls runs in a child of sh, which takes the redirect, so the list is of sh's descriptors
    // alone; a command substitution or a glob would open one in sh while it reads them.
    let script = [
        "#!/bin/sh",
        "case \" $* \" in *\" -c \"*) ;; *) exec {real_cc} \"$@\" ;; esac",
        "for a in \"$@\"; do case \"$a\" in *.c) unit=$(basename \"$a\" .c) ;; esac; done",
        "[ -e {tree}/probe ] && ls -l /proc/$$/fd > {tree}/fds/$unit",
        "exec {real_cc} \"$@\"",
    ]
    write_file("{tree}/bin/cc", "{script.join("\n")}\n")
    shell_exec("chmod +x {tree}/bin/cc")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"fds_app\"\nversion = \"0.1.0\"\n")
    for m in ["a", "b", "c"] {
        write_file("{tree}/app/src/{m}.bl", "pub fn {m}_value() -> Int \{\n    1\n\}\n")
    }
    write_file("{tree}/app/src/main.bl", "import a.\{a_value\}\nimport b.\{b_value\}\nimport c.\{c_value\}\n\nfn main() \{\n    io.println(\"sum \{a_value() + b_value() + c_value()\}\")\n\}\n")
}

// The corpus exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one
// unit, so the run drops them, and BLINK_ARCHIVE_PCH, so the PCH stays on. A unit gets each
// descriptor blink got, as a child of make or of a shell does, so blink starts with fds 0-2
// alone: the corpus runs this test with a lock file open.
fn build(tree: Str, cache: Str) -> ProcessResult {
    process_run("sh", ["-c", "for f in /proc/$$/fd/*; do n=$(basename $f); [ $n -gt 2 ] && eval \"exec $n>&-\"; done; cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_JOBS -u BLINK_ARCHIVE_PCH PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/{cache} BLINK_TRACE_CHANNELS=build.units build/blink build app/src/main.bl -o {tree}/out/app --per-module --jobs 3"])
}

test "a unit compile holds no descriptor but its stdio and its own pipe" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_unit_fds_{getpid()}"
    dev_tree(root, tree)
    // A program's first build makes no PCH. The second, with a cache of its own, compiles
    // every unit again and the PCH beside the first of them.
    let first = build(tree, "cache1")
    shell_exec("touch {tree}/probe")
    let second = build(tree, "cache2")
    let mut lists: List[(Str, List[Str])] = []
    for u in ["__main__", "a", "b", "c"] {
        lists.push((u, descriptors(sh("cat {tree}/fds/{u} 2>/dev/null"), "{tree}/bin/cc")))
    }
    shell_exec("rm -rf {tree}")
    assert(first.exit_code == 0, "first build failed: {first.out}{first.err_out}")
    assert(second.exit_code == 0, "second build failed: {second.out}{second.err_out}")
    assert(second.err_out.contains("pch build"), "no PCH compile ran beside the units: {second.err_out}")
    for (u, fds) in lists {
        let all = fds.join(" | ")
        assert(fds.len() == 4, "unit {u} holds {fds.len()} descriptors: {all}")
        assert(fds.filter(fn(l) { !l.starts_with("0 ") && l.contains(" pipe:") }).len() == 1, "unit {u}: {all}")
        assert(fds.filter(fn(l) { !l.starts_with("0 ") && l.contains(" pipe:") && l.ends_with(" w") }).len() == 1, "unit {u}: its pipe is not a write end: {all}")
        assert(fds.filter(fn(l) { l.starts_with("1 ") && l.contains(".cc-out ") }).len() == 1, "unit {u}: {all}")
        assert(fds.filter(fn(l) { l.starts_with("2 ") && l.contains(".cc-err ") }).len() == 1, "unit {u}: {all}")
    }
}

// Each descriptor in the `ls -l /proc/<pid>/fd` text as "<fd> <target> <r|w|rw>", but the one
// sh holds its script, at script, on.
fn descriptors(text: Str, script: Str) -> List[Str] {
    let mut fds: List[Str] = []
    for l in text.split("\n") {
        let parts = l.split(" -> ")
        if parts.len() != 2 || parts.get(1).unwrap() == script { continue }
        let words = parts.get(0).unwrap().split(" ").filter(fn(w) { w != "" })
        let mode = words.get(0).unwrap()
        let access = if mode.contains("r") && mode.contains("w") { "rw" } else if mode.contains("w") { "w" } else { "r" }
        fds.push("{words.get(words.len() - 1).unwrap()} {parts.get(1).unwrap()} {access}")
    }
    fds
}
