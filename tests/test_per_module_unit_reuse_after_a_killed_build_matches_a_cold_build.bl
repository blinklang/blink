// A per-module build killed after it took units from the last build leaves the last build's
// units as they were and no record of its own, so the next build takes them again and writes
// the C a build with no last build writes.

import std.process.{ProcessResult, ChildEnd}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"unit_reuse_app\"\nversion = \"0.1.0\"\n").unwrap()
    // mid's unit lowers base's field default, so it reads base's source.
    fs.write("{tree}/app/src/base.bl", [
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s}]""#,
        #"}"#,
        #""#,
        #"pub type Cfg {"#,
        #"    n: Int = [10, 20].get(1).unwrap()"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/mid.bl", [
        #"import base.{Cfg, tag}"#,
        #""#,
        #"pub fn mid_value() -> Str {"#,
        #"    let c = Cfg { }"#,
        #"    tag("{c.n}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/leaf.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag("leaf")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #"import mid.{mid_value}"#,
        #"import leaf.{leaf_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{tag("main")} {mid_value()} {leaf_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both, and the module filters.
fn blink_in(tree: Str, env_args: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units {env_args} build/blink {args}"]).unwrap()
}

fn build_into(tree: Str, env_args: Str, flags: Str, out: Str) -> ProcessResult {
    let r = blink_in(tree, env_args, "build app/src/main.bl -o {tree}/{out}/app --per-module {flags}")
    assert(r.success(), "per-module build into {out} failed: {r.out}{r.err_out}")
    r
}

// The modules whose units the build took from the last build, from its build.units trace.
fn reused_units(r: ProcessResult) -> Str {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        if line.starts_with("[dbg:build.units] reuse unit ") {
            out.push(line.byte_slice(29, line.byte_len()))
        }
    }
    out.join(",")
}

// The C files that differ between out/ and a build of the same inputs with no last build.
fn differ_from_cold(tree: Str, env_args: Str, flags: Str) -> Str {
    process.run("sh", ["-c", "rm -rf {tree}/cold"]).unwrap()
    let _cold = build_into(tree, env_args, flags, "cold")
    sh("cd {tree} && for f in cold/app.units/*.c cold/app.units/*.h; do b=$(basename $f); cmp -s $f out/app.units/$b || echo $b; done; for f in out/app.units/*.c out/app.units/*.h; do [ -e cold/app.units/$(basename $f) ] || echo extra:$(basename $f); done").split("\n").join(" ")
}

fn edit(tree: Str, file: Str, sed: Str) ! FS.Read, Process.Spawn {
    let path = "{tree}/app/src/{file}"
    let before = fs.read(path).unwrap()
    process.run("sh", ["-c", "sed -i '{sed}' {path}"]).unwrap()
    assert(fs.read(path).unwrap() != before, "the edit `{sed}` did not change {file}")
}

// Whether the build took m's unit from the last build.
fn took(r: ProcessResult, m: Str) -> Bool {
    reused_units(r).split(",").contains(m)
}

// A cc first on PATH that kills the build at its link, the last step before the build
// replaces its units directory, and passes every other call to the real cc.
fn killing_cc(tree: Str) ! Process.Spawn, FS.Write {
    let real_cc = sh("command -v cc")
    process.run("sh", ["-c", "mkdir -p {tree}/fakebin"]).unwrap()
    fs.write("{tree}/fakebin/cc", [
        "#!/bin/sh",
        "case \"$*\" in *libblink_std.a*) kill -9 $(cat {tree}/build.pid); sleep 5; exit 1;; esac",
        "exec {real_cc} \"$@\"",
        "",
    ].join("\n")).unwrap()
    process.run("sh", ["-c", "chmod +x {tree}/fakebin/cc"]).unwrap()
}

test "a build killed after it took units leaves the last units for the next build" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_unit_reuse_killed_{getpid()}"
    dev_tree(root, tree)
    killing_cc(tree)
    let _first = build_into(tree, "", "", "out")
    edit(tree, "leaf.bl", #"s/"leaf"/"lea2"/"#)
    let killed = process.run("sh", ["-c", "cd {tree} || exit 1; PATH={tree}/fakebin:$PATH env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink build app/src/main.bl -o {tree}/out/app --per-module & echo $! > {tree}/build.pid; wait $!"])?
    let records_left = sh("ls -a {tree}/out/.units.*/.emit-record 2>/dev/null | wc -l")
    let next = build_into(tree, "", "", "out")
    let out = sh("{tree}/out/app")
    let differ = differ_from_cold(tree, "", "")
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(killed.end == ChildEnd.Exited(137), "the build was not killed: {killed.end}\n {killed.out}{killed.err_out}")
    assert(took(killed, "base") && took(killed, "mid"), "the killed build took {reused_units(killed)}")
    assert_eq(records_left, "0")
    assert(took(next, "base") && took(next, "mid"), "the next build took {reused_units(next)}")
    assert_eq(differ, "")
    assert_eq(out, "[main] [20] [lea2]")
}
