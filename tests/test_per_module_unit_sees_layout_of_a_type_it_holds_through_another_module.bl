// Module c imports only b, but holds b's Seg by value, and a Seg holds a's Point by value,
// so c's unit needs the layout of Point without naming module a. Every type layout lives in
// one shared header, so the unit gets it from there and never from a.h. Two generics cross
// the modules too: an instance of a's generic over b's type, homed in a's unit, and an
// instance of b's generic over a type that holds a's, called from c.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"layout_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/pa.bl", [
        #"pub type Point {"#,
        #"    x: Int"#,
        #"    y: Int"#,
        #"}"#,
        #""#,
        #"pub fn twice[T](v: T) -> List[T] {"#,
        #"    [v, v]"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/pb.bl", [
        #"import pa.{Point, twice}"#,
        #""#,
        #"pub type Seg {"#,
        #"    from: Point"#,
        #"    to: Point"#,
        #"}"#,
        #""#,
        #"pub fn make_seg(x0: Int, y0: Int, x1: Int, y1: Int) -> Seg {"#,
        #"    Seg { from: Point { x: x0, y: y0 }, to: Point { x: x1, y: y1 } }"#,
        #"}"#,
        #""#,
        #"pub fn doubled(s: Seg) -> List[Seg] {"#,
        #"    twice(s)"#,
        #"}"#,
        #""#,
        #"pub fn pick[T](xs: List[T], i: Int, fallback: T) -> T {"#,
        #"    xs.get(i) ?? fallback"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/pc.bl", [
        #"import pb.{Seg, make_seg, doubled, pick}"#,
        #""#,
        #"pub type Path {"#,
        #"    first: Seg"#,
        #"    hops: Int"#,
        #"}"#,
        #""#,
        #"pub fn path_len2() -> Int {"#,
        #"    let p = Path { first: make_seg(1, 2, 4, 6), hops: 2 }"#,
        #"    let both = doubled(p.first)"#,
        #"    let s = pick(both, 1, make_seg(0, 0, 0, 0))"#,
        #"    let dx = s.to.x - s.from.x"#,
        #"    let dy = s.to.y - s.from.y"#,
        #"    let far = pick([p], 0, p)"#,
        #"    (dx * dx + dy * dy) * far.hops"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import pc.{path_len2}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("len2 {path_len2()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes
// --per-module build one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache build/blink {args}"]).unwrap()
}

// The program headers a unit includes, in the order it includes them.
fn quoted_includes(c: Str) -> List[Str] {
    let mut out: List[Str] = []
    for line in c.split("\n") {
        let mark = "#include \""
        if line.starts_with(mark) && line.ends_with("\"") {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len() - 1))
        }
    }
    out
}

// Whether c has a one-line declaration of the C symbol name.
fn declares(c: Str, name: Str) -> Bool {
    for line in c.split("\n") {
        if line.ends_with(";") && line.contains(" {name}(") { return true }
    }
    false
}

fn has(xs: List[Str], x: Str) -> Bool {
    for y in xs {
        if y == x { return true }
    }
    false
}

test "a unit holding a type by value through another module builds without that module's header" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_per_module_layout_{getpid()}"
    dev_tree(root, tree)
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    let out = sh("{tree}/out/app")
    let c_text = read_file("{tree}/out/app.units/pc.c")
    let c_includes = quoted_includes(c_text)
    let c_seen = c_includes.join(",")
    shell_exec("rm -rf {tree}")
    assert(r.exit_code == 0, "per-module build failed: {r.out}{r.err_out}")
    assert_eq(out, "len2 50")
    assert(has(c_includes, "blink.types.h"), "pc.c includes: {c_seen}")
    // pc.c holds the declarations of b's fns it calls in place of b's header.
    assert(declares(c_text, "blink_pb_make_1seg"), "pc.c does not declare make_seg")
    assert(!has(c_includes, "pb.h"), "pc.c includes: {c_seen}")
    // Point's layout reaches pc.c through the shared types header, not through pa.h.
    assert(!has(c_includes, "pa.h"), "pc.c includes: {c_seen}")
    assert(!has(c_includes, "_blink_all.h"), "pc.c includes: {c_seen}")
}
