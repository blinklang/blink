// A cc wrapper can start a process that outlives cc, as `something &` does, and that process
// holds every descriptor cc had. The build still ends when its units end, not when that
// process ends.

import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// A dev tree with a program of four units: __main__, a, b and c. The cc in bin/ leaves a
// `sleep 30` running beside the compile of a and writes its pid to sleeper.
fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src {tree}/bin"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    let real_cc = sh("command -v cc")
    let script = [
        "#!/bin/sh",
        "case \" $* \" in *\" -c \"*) ;; *) exec {real_cc} \"$@\" ;; esac",
        "for a in \"$@\"; do case \"$a\" in *.c) unit=$(basename \"$a\" .c) ;; esac; done",
        "if [ \"$unit\" = a ]; then sleep 30 & echo $! > {tree}/sleeper; fi",
        "exec {real_cc} \"$@\"",
    ]
    fs.write("{tree}/bin/cc", "{script.join("\n")}\n").unwrap()
    process.run("sh", ["-c", "chmod +x {tree}/bin/cc"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"sleeper_app\"\nversion = \"0.1.0\"\n").unwrap()
    for m in ["a", "b", "c"] {
        fs.write("{tree}/app/src/{m}.bl", "pub fn {m}_value() -> Int \{\n    1\n\}\n").unwrap()
    }
    fs.write("{tree}/app/src/main.bl", "import a.\{a_value\}\nimport b.\{b_value\}\nimport c.\{c_value\}\n\nfn main() \{\n    io.println(\"sum \{a_value() + b_value() + c_value()\}\")\n\}\n").unwrap()
}

test "a unit whose cc leaves a process running does not hold up the build" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_unit_sleeper_{getpid()}"
    dev_tree(root, tree)
    // The corpus exports BLINK_COMPILER_ARCHIVE and module filters, which make the build one
    // unit, so the run drops them. The wall time is in milliseconds.
    let r = process.run("sh", ["-c", "cd {tree} && t0=$(date +%s%3N) && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE -u BLINK_JOBS PATH={tree}/bin:$PATH BLINK_CACHE_DIR={tree}/objcache BLINK_ARCHIVE_PCH=0 build/blink build app/src/main.bl -o {tree}/out/app --per-module --jobs 2; rc=$?; echo \"wall $(($(date +%s%3N) - t0))\"; exit $rc"])?
    let sleeper = sh("cat {tree}/sleeper 2>/dev/null")
    let alive = sleeper != "" && process.run("sh", ["-c", "kill -0 {sleeper}"])?.success()
    if sleeper != "" { process.run("sh", ["-c", "kill {sleeper} 2>/dev/null"])? }
    let run = sh("{tree}/out/app")
    process.run("sh", ["-c", "rm -rf {tree}"])?
    let wall = number_after(r.out, "wall ")
    assert(r.success(), "build failed: {r.out}{r.err_out}")
    assert(wall >= 0 && wall < 10000, "the build took {wall} ms: it waited on the sleep")
    assert(alive, "the sleep had ended, so the test proves nothing")
    assert_eq(run, "sum 3")
}

// The number after prefix on the line of text that starts with it, or -1.
fn number_after(text: Str, prefix: Str) -> Int {
    for l in text.split("\n") {
        if l.starts_with(prefix) {
            return l.byte_slice(prefix.byte_len(), l.byte_len()).to_int()
        }
    }
    -1
}
