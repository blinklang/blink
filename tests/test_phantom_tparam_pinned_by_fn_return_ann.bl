// A phantom type parameter (used in no field of the struct) pinned only by a FUNCTION's
// declared return type, not by a let annotation on the struct literal. No field can bind
// T, so the tid must reach the tail literal `Keyed { id: 1 }` from `-> Keyed[NoHash]`.
//
// tests/test_i0001_unsolved_typevar_at_codegen.bl annotates the literal directly
// (`let w: W[Int] = W { n: 5 }`); this file routes the tid through a return type instead.

import compile_test_helpers.{compile_and_run}

test "a phantom type param pinned only by a fn's return-type annotation still compiles" {
    let src = #"
import std.io

type NoHash { v: Int }

@derive(Hash, Eq)
type Keyed[T] { id: Int }

fn mk() -> Keyed[NoHash] { Keyed { id: 1 } }

fn main() { io.println("{mk().id}") }
"#
    let r = compile_and_run(src, "_phantom_tparam_pinned_by_fn_return_ann")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
