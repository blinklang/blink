// A phantom type parameter (used in no field of the struct) that is pinned
// by a FUNCTION's declared return-type annotation, rather than by a direct
// let-binding annotation on the struct literal itself, still reaches
// monomorphization unsolved and trips the I0001 UnsolvedTypeVarAtCodegen
// backstop instead of compiling. T occurs in no field, so no field-value
// inference arm can bind it, and the tid never gets threaded from the
// enclosing fn's `-> Keyed[NoHash]` annotation down into the tail struct
// literal `Keyed { id: 1 }`.
//
// This is a different shape from tests/test_i0001_unsolved_typevar_at_codegen.bl's
// "annotated phantom type param lowers without I0001" row, which annotates the
// struct literal directly (`let w: W[Int] = W { n: 5 }`) rather than routing the
// tid through a function return type. Reproduces identically with or without
// @derive(Hash, Eq) on Keyed.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a phantom type param pinned only by a fn's return-type annotation still compiles",
    reason: "the return annotation Keyed[NoHash] states the argument outright, but nothing threads that tid into the tail struct literal Keyed \{ id: 1 }, so it reaches monomorphization unsolved and trips the I0001 UnsolvedTypeVarAtCodegen ICE backstop instead of compiling",
    ticket: "mc2mna",
) {
    let src = #"
import std.io

type NoHash { v: Int }

@derive(Hash, Eq)
type Keyed[T] { id: Int }

fn mk() -> Keyed[NoHash] { Keyed { id: 1 } }

fn main() { io.println("{mk().id}") }
"#
    let r = compile_and_run(src, "_phantom_tparam_pinned_by_fn_return_ann")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
