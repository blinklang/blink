// Tests E1009 PackageEntryNotFound: when [package].name is "foo" but
// src/foo.bl does not exist, the compiler reports a single expected path.

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_pkg_entry_missing"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    process.run("sh", ["-c", "mkdir -p {base}/missinglib/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/app/src"]).unwrap()
    // Manifest says name = "missinglib", but no src/missinglib.bl is written
    fs.write("{base}/missinglib/blink.toml", "[package]\nname = \"missinglib\"\nversion = \"0.1.0\"\n").unwrap()
    // Write a sibling file (NOT the entry) so the package isn't completely empty
    fs.write("{base}/missinglib/src/other.bl", "pub fn other() -> Int \{ 1 \}\n").unwrap()

    fs.write("{base}/app/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nmissinglib = \{ path = \"../missinglib\" \}\n").unwrap()
    fs.write("{base}/app/src/main.bl", "import missinglib\n\nfn main() \{\n    io.println(\"unreachable\")\n}\n").unwrap()

    process.run("sh", ["-c", "cd {base}/app && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err = fs.read("{base}/app/err.txt").unwrap()
    if err.contains("PackageEntryNotFound") {
        io.println("PASS: missing entry file emits PackageEntryNotFound/E1009")
    } else {
        io.println("FAIL: expected PackageEntryNotFound for missing entry file, got: {err}")
    }
    if err.contains("missinglib.bl") {
        io.println("PASS: E1009 names the expected entry path")
    } else {
        io.println("FAIL: E1009 should name 'missinglib.bl', got: {err}")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
