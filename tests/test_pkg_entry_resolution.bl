// Tests that bare `import <pkg>` resolves to <pkg-root>/src/<pkg>.bl.

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_pkg_entry_resolution"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    process.run("sh", ["-c", "mkdir -p {base}/foolib/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/app/src"]).unwrap()
    fs.write("{base}/foolib/blink.toml", "[package]\nname = \"foolib\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/foolib/src/foolib.bl", "pub fn hello() -> Str \{\n    \"hello-from-foolib\"\n}\n").unwrap()

    fs.write("{base}/app/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nfoolib = \{ path = \"../foolib\" \}\n").unwrap()
    fs.write("{base}/app/src/main.bl", "import foolib.\{hello\}\n\nfn main() \{\n    io.println(hello())\n}\n").unwrap()

    process.run("sh", ["-c", "cd {base}/app && {blink} build src/main.bl -o build/app > out.txt 2>&1; true"]).unwrap()
    let rc_out = fs.read("{base}/app/out.txt").unwrap()
    if compile_test_helpers.path_exists("{base}/app/build/app") {
        process.run("sh", ["-c", "{base}/app/build/app > {base}/app/run.txt 2>&1 || true"]).unwrap()
        let run_out = fs.read("{base}/app/run.txt").unwrap()
        if run_out.starts_with("hello-from-foolib") {
            io.println("PASS: bare `import foolib` resolves to src/foolib.bl")
        } else {
            io.println("FAIL: expected 'hello-from-foolib', got: {run_out}")
        }
    } else {
        io.println("FAIL: build did not produce binary, output: {rc_out}")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
