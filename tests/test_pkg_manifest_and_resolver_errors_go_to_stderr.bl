// A manifest or dependency error from lib/pkg goes to stderr, whoever loads the manifest: a
// compile loads blink.toml while `check --json` stdout holds one status line and an LSP
// server writes its frames there. The probe program runs in a child process because the
// errors print, and the child compiles this tree's pkg modules.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn run_probe(name: Str, imports: Str, body: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_pkg_errors_stderr.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/noname {dir}/gonedep")
    write_file("{dir}/noname.toml", "[package\n")
    write_file("{dir}/nover.toml", "[package]\nname = \"probe\"\n")
    write_file("{dir}/badname.toml", "[package]\nname = \"Bad-Name\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/twosrc.toml", "[package]\nname = \"probe\"\nversion = \"0.1.0\"\n\n[dependencies]\nlib = \{ path = \"lib\", version = \"1.0.0\" }\n")
    write_file("{dir}/noname/blink.toml", "[package\n")
    write_file("{dir}/gonedep/blink.toml", "[package]\nname = \"root\"\nversion = \"0.1.0\"\n\n[dependencies]\ngone = \{ path = \"gone\" }\n")
    write_file("{dir}/{name}.bl", "{imports}\n\nfn main() \{\n{body}}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B run {name}.bl")
    let _ = sh("rm -rf {dir}")
    r
}

test "manifest_load prints each of its errors on stderr and none on stdout" {
    let r = run_probe("manifest_errors", "import pkg.manifest.\{manifest_load}", "    io.println(\"missing=\{manifest_load(\"missing.toml\")}\")\n    io.println(\"noname=\{manifest_load(\"noname.toml\")}\")\n    io.println(\"nover=\{manifest_load(\"nover.toml\")}\")\n    io.println(\"badname=\{manifest_load(\"badname.toml\")}\")\n    io.println(\"twosrc=\{manifest_load(\"twosrc.toml\")}\")\n")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "missing=1\nnoname=1\nnover=1\nbadname=1\ntwosrc=1\n")
    assert(r.err_out.contains("error: manifest file not found: missing.toml"))
    assert(r.err_out.contains("error: [package] section missing required field 'name'"))
    assert(r.err_out.contains("error: [package] section missing required field 'version'"))
    assert(r.err_out.contains("error[E1011]: package name 'Bad-Name' is invalid"))
    assert(r.err_out.contains("error: dependency 'lib' has multiple sources"))
}

test "resolve and resolve_path_deps print their errors on stderr and none on stdout" {
    let r = run_probe("resolver_errors", "import pkg.resolver.\{resolve}\nimport pkg.pathdeps.\{resolve_path_deps}", "    io.println(\"resolve_noname=\{resolve(\"noname\")}\")\n    io.println(\"resolve_gonedep=\{resolve(\"gonedep\")}\")\n    io.println(\"pathdeps_noname=\{resolve_path_deps(\"noname\")}\")\n    io.println(\"pathdeps_gonedep=\{resolve_path_deps(\"gonedep\")}\")\n")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "resolve_noname=1\nresolve_gonedep=1\npathdeps_noname=1\npathdeps_gonedep=1\n")
    assert_eq(r.err_out.split("error: failed to load root manifest").len() - 1, 2)
    assert(r.err_out.contains("error: path dependency 'gone' not found: gonedep/gone"))
    assert(r.err_out.contains("error: path dependency 'gone' directory not found: gonedep/gone"))
}
