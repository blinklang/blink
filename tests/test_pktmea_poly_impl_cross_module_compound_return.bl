import test_cross_module_generic_fn_helper

// pktmea: the CROSS PRODUCT of the two existing poly-impl fixtures —
// test_poly_impl_compound_return.bl (compound-over-binder return `-> Option[T]` /
// `-> Result[T, Str]`, but LOCAL struct) and test_dwhm4v_poly_impl_cross_module.bl
// (CROSS-MODULE struct T, but bare `-> T` return). Here a poly impl on `List[T]`
// returns a COMPOUND over the binder AND is instantiated with a CROSS-MODULE
// struct (CmgPoint).
//
// These three cases are a MIGRATION REGRESSION GUARD, not red-first: the string
// path (poly_impl_resolution_args + resolve_tparam) already handles a plain
// cross-module struct correctly (dwhm4v + wkwj7e). pktmea switches
// emit_poly_impl_call's RETURN-type recovery to the interned type_id pool
// (resolve_tparam_via_tid over receiver-element tids); a wrong tid resolver
// would drop the struct-return temp or emit a divergent carrier name. All three
// must stay GREEN across the switch.
//
// The arena / bare-name RED-FIRST case (latent bug #1) lives in a sibling fixture,
// test_pktmea_poly_impl_arena_promote.bl — a hard gcc error in that case would take
// down this whole TU, so it is isolated for a clean red->green.
//
// NOT covered anywhere yet — a compound-over-binder return where T is itself a
// struct INSTANCE (`List[CmgBox[Int]]` -> `Option[T]`): the inner resolves to the
// bare base `CmgBox` instead of the physical mono stem `CmgBox_Int` on BOTH the
// string and the receiver-tid path, and the poly-impl arg-side also erases the
// instance (`void x`). That reproduces with a LOCAL instance too, so it is
// orthogonal to pktmea's cross-module RETURN migration — filed separately as a bug.

trait Wrapper[T] {
    fn wrap_one(self, x: T) -> Option[T]
}

impl[T] Wrapper[T] for List[T] {
    fn wrap_one(_self, x: T) -> Option[T] { Some(x) }
}

trait Resulter[T] {
    fn ok_one(self, x: T) -> Result[T, Str]
}

impl[T] Resulter[T] for List[T] {
    fn ok_one(_self, x: T) -> Result[T, Str] { Ok(x) }
}

trait Echoer[T] {
    fn echo_one(self, x: T) -> T
}

impl[T] Echoer[T] for List[T] {
    fn echo_one(_self, x: T) -> T { x }
}

test "poly impl -> Option[T] over a cross-module struct" {
    let pts: List[test_cross_module_generic_fn_helper.CmgPoint] = [
        test_cross_module_generic_fn_helper.CmgPoint { x: 1, y: 2 }
    ]
    let w = pts.wrap_one(test_cross_module_generic_fn_helper.CmgPoint { x: 3, y: 4 })
    let p = w.unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "poly impl -> Result[T, Str] over a cross-module struct" {
    let pts: List[test_cross_module_generic_fn_helper.CmgPoint] = [
        test_cross_module_generic_fn_helper.CmgPoint { x: 1, y: 2 }
    ]
    let r = pts.ok_one(test_cross_module_generic_fn_helper.CmgPoint { x: 5, y: 6 })
    let p = r.unwrap()
    assert_eq(p.x, 5)
    assert_eq(p.y, 6)
}

test "poly impl -> T bare over a cross-module struct" {
    let pts: List[test_cross_module_generic_fn_helper.CmgPoint] = [
        test_cross_module_generic_fn_helper.CmgPoint { x: 1, y: 2 }
    ]
    let e = pts.echo_one(test_cross_module_generic_fn_helper.CmgPoint { x: 9, y: 10 })
    assert_eq(e.x, 9)
    assert_eq(e.y, 10)
}

