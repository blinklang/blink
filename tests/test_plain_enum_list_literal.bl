type Color { Red, Green, Blue }

// A payload-less enum List element is stamped its CT_INT ordinal (not a
// by-pointer struct box). Guards the shared tid_inner_ct against re-declining
// enums, which would divert this element to a (CT_VOID, name) pointer stamp and
// deref the ordinal as a pointer.
test "plain enum list literal element read" {
    let xs = [Color.Red, Color.Green, Color.Blue]
    assert_eq(xs.len(), 3)
    let c = xs.get(1).unwrap()
    let ok = match c {
        Color.Red => 0
        Color.Green => 1
        Color.Blue => 2
    }
    assert_eq(ok, 1)
    let mut n = 0
    for _x in xs {
        n = n + 1
    }
    assert_eq(n, 3)
}
