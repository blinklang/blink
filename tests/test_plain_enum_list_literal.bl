type Color { Red, Green, Blue }

// A payload-less enum List element is stored as its CT_INT ordinal, and `.get`
// lifts that ordinal into a by-VALUE nominal Option carrier (blink_Option_Color,
// recovered from the .get result tid). Guards against the element being
// pointer-boxed (a struct-element box) or erased to blink_Option_int, either of
// which makes the downstream match read the wrong carrier.
test "plain enum list literal element read" {
    let xs = [Color.Red, Color.Green, Color.Blue]
    assert_eq(xs.len(), 3)
    let c = xs.get(1).unwrap()
    let ok = match c {
        Color.Red => 0
        Color.Green => 1
        Color.Blue => 2
    }
    assert_eq(ok, 1)
    let mut n = 0
    for _x in xs {
        n = n + 1
    }
    assert_eq(n, 3)
}
