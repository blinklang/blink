import test_cross_module_generic_fn_helper

// pktmea latent bug #1 (RED-FIRST): the poly-impl RETURN carrier recovery in
// emit_poly_impl_call wrote the inner struct name DOTTED (resolve_tparam over
// poly_impl_resolution_args -> `test_cross_module_generic_fn_helper.CmgPoint`).
// That dotted name feeds descriptor_from_expr_state -> descriptor_mangle
// (codegen_derive), which splices it VERBATIM into `blink_promote_{name}`, yielding
// the invalid C identifier `blink_promote_test_cross_module_generic_fn_helper.CmgPoint`.
//
// Reachable when a `with arena { }` block's TAIL is a poly-impl call returning a
// cross-module struct: the tail value is promoted out of the arena, so codegen emits
// a promote descriptor keyed on the (dotted) struct name. On HEAD this is a hard gcc
// syntax error. The tid path (resolve_tparam_via_tid) spells the inner BARE
// (`CmgPoint`), matching the 7 other bare-storing RETURN-path producers, so
// descriptor_mangle emits a valid `blink_promote_..._CmgPoint`. A runtime test that
// reaches its asserts proves the promote descriptor compiled.

trait Echoer[T] {
    fn echo_one(self, x: T) -> T
}

impl[T] Echoer[T] for List[T] {
    fn echo_one(_self, x: T) -> T { x }
}

test "poly impl -> T cross-module struct as a with-arena tail" {
    let e = with arena {
        let pts: List[test_cross_module_generic_fn_helper.CmgPoint] = [
            test_cross_module_generic_fn_helper.CmgPoint { x: 1, y: 2 }
        ]
        pts.echo_one(test_cross_module_generic_fn_helper.CmgPoint { x: 11, y: 12 })
    }
    assert_eq(e.x, 11)
    assert_eq(e.y, 12)
}
