// The enum twin of the poly-impl generic-instance struct-param bug: a poly-impl
// method (impl[T] Trait[T] for List[T]) whose parameter is a generic-ENUM
// instance parameterized by the impl binder (t: Tree[T], T=Int). The
// monomorphized method signature spelled the bare base type (blink_Tree), which
// is never typedef'd -- only the mono instance blink_Tree_Int exists -- so the
// emitted C failed to compile, and the def-side scope binding carried only the
// bare base so a match scrutinee got the erased C type. Both the signature
// builder (poly_impl_method_signature) and the def-side registration
// (emit_poly_impl_method_def) now resolve the instance's mono name via
// mono_name_from_ann + segs, mirroring the free-fn enum twin (mono_fn_signature
// / emit_mono_fn_def): the signature spells blink_Tree_Int and the def binds the
// bare base in var_enums (for variant lookup) plus the mono stem via
// set_var_struct (for the concrete C type).
type Tree[T] {
    Leaf(value: T)
    Branch(left: Tree[T], right: Tree[T])
}

type Pair[T] {
    Full(value: T)
    Half(value: T)
}

trait TreeCounter[T] {
    fn count_tree(self, t: Tree[T]) -> Int
}

trait PairPicker[T] {
    fn is_full(self, p: Pair[T]) -> Int
}

impl[T] TreeCounter[T] for List[T] {
    fn count_tree(self, t: Tree[T]) -> Int {
        match t {
            Leaf(_v) => return 1
            Branch(_l, _r) => return 2
        }
    }
}

impl[T] PairPicker[T] for List[T] {
    fn is_full(self, p: Pair[T]) -> Int {
        match p {
            Full(_v) => return 1
            Half(_v) => return 0
        }
    }
}

test "poly-impl method resolves a self-recursive-typed generic-enum instance param" {
    let xs: List[Int] = [1]
    let t = Branch(Leaf(1), Leaf(2))
    assert_eq(xs.count_tree(t), 2)
}

test "poly-impl method resolves a single-level generic-enum instance param" {
    let ys: List[Int] = [1]
    let p: Pair[Int] = Full(9)
    assert_eq(ys.is_full(p), 1)
    let h: Pair[Int] = Half(3)
    assert_eq(ys.is_full(h), 0)
}
