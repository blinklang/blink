// A polymorphic impl method (impl[T] Holder[T] for List[T]) whose parameter is a
// generic-struct INSTANCE parameterized by the impl binder (b: Box[T], T=Int).
// The monomorphized method signature spelled the param as the bare base type
// (blink_Box), which is never typedef'd -- only the mono instance blink_Box_Int
// exists -- so the emitted C failed to compile. Both the signature builder
// (poly_impl_method_signature) and the def-side scope registration
// (emit_poly_impl_method_def) now resolve the instance's mono name via
// mono_name_from_ann + segs, mirroring the free-fn twin (mono_fn_signature /
// emit_mono_fn_def), so the param concretizes to blink_Box_Int and field access
// on it resolves.
type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }

trait Holder[T] {
    fn take_box(self, b: Box[T]) -> T
}

trait Pairer[T] {
    fn take_pair(self, p: Pair[T, T]) -> T
}

impl[T] Holder[T] for List[T] {
    fn take_box(self, b: Box[T]) -> T {
        b.value
    }
}

impl[T] Pairer[T] for List[T] {
    fn take_pair(self, p: Pair[T, T]) -> T {
        p.first + p.second
    }
}

test "poly-impl method resolves a generic-instance struct param" {
    let xs: List[Int] = [1, 2, 3]
    assert_eq(xs.take_box(Box { value: 7 }), 7)
}

test "poly-impl method resolves a two-arg generic-instance struct param" {
    let ys: List[Int] = [4, 5]
    assert_eq(ys.take_pair(Pair { first: 3, second: 9 }), 12)
}
