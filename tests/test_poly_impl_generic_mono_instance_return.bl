// A polymorphic-impl method (`impl[T] Trait[T] for List[T]`) that returns a
// fixed generic mono-instance (`-> Box[Int]`, not the impl's own binder T)
// must spell the full mono instance in the emitted signature (blink_Box_0Int),
// not the bare generic head (blink_Box). Distinct from plain non-generic
// struct/enum returns and from a compound OVER the binder (`-> Option[T]`),
// which have their own tests.

type Box[T] { value: T }
trait Firster[T] { fn boxed_first(self) -> Box[Int] }
impl[T] Firster[T] for List[T] { fn boxed_first(_self) -> Box[Int] { Box { value: 42 } } }

test "poly-impl method returning a fixed generic mono-instance resolves through field access" {
    let xs: List[Int] = [1, 2, 3]
    assert_eq(xs.boxed_first().value, 42)
}
