// ms4ctb -- a polymorphic impl on a builtin generic receiver
//   impl[T] Echoable[T] for List[T] { fn echo(self, x: T) -> T { x } }
// must be MONOMORPHIZED per concrete T at each use site, exactly like a
// generic free function. Calling `.echo()` on a List[Int] and a List[Str]
// must emit TWO distinct C functions with distinct signatures:
//   - blink_List_Echoable_echo_Int  taking/returning int64_t
//   - blink_List_Echoable_echo_Str  taking/returning const char* (Blink's Str)
//
// This inspects the EMITTED C directly via `build/blink build --emit c`
// (mirrors tests/test_panic_loc_emit_c.bl), so it needs no runtime — it
// asserts the structural fact that the two instantiations exist as
// separate symbols. The `echo` body returns the bare `T` argument, which
// deliberately avoids the List.push void*-boxing intrinsic (that boxed
// stdlib body is k68v0r, a separate ticket).
//
// Presence/distinctness of the two mono symbols is asserted structurally via
// compile_test_helpers.poly_impl_fn_names (br cr4gqk), not by pinning the
// literal mangled name — see that helper's KNOWN COUPLING doc comment. The
// per-type C signatures below (int64_t vs const char*) are a check on TYPE
// LOWERING, not on name mangling, so they still assert the literal name they
// were emitted under (read back from the helper) rather than the whole line.

import compile_test_helpers

fn emit_c(tag: Str, src: Str) -> Str {
    let bl_path = ".tmp/_test_{tag}.bl"
    write_file(bl_path, src)
    let _ = process_run("build/blink", ["build", bl_path, "--emit", "c"])
    let c_src = read_file("build/_test_{tag}.c")
    shell_exec("rm -f {bl_path} build/_test_{tag}.c")
    c_src
}

test "poly impl on List[T] monomorphizes per concrete T" {
    let src = "trait Echoable[T] \{\n"
              .concat("    fn echo(self, x: T) -> T\n")
              .concat("\}\n")
              .concat("impl[T] Echoable[T] for List[T] \{\n")
              .concat("    fn echo(self, x: T) -> T \{ x \}\n")
              .concat("\}\n")
              .concat("fn main() \{\n")
              .concat("    let ints: List[Int] = [1, 2, 3]\n")
              .concat("    let _i = ints.echo(7)\n")
              .concat("    let strs: List[Str] = [\"a\", \"b\"]\n")
              .concat("    let _s = strs.echo(\"z\")\n")
              .concat("\}\n")
    let c = emit_c("poly_impl_mono", src)
    // Both monomorphized symbols exist as distinct functions.
    let names = compile_test_helpers.poly_impl_fn_names(c, "List_Echoable_echo")
    assert(names.len() == 2)
    let n0 = names.get(0).unwrap()
    let n1 = names.get(1).unwrap()
    assert(n0 != n1)
    // The Int instance carries an int64_t signature; the Str instance a
    // const char* signature (Blink's Str lowering). Distinct C types prove
    // they are separate monos, not one void-erased symbol — and that the
    // `self: List[T]` receiver lowers to blink_list*, not void.
    let int_name = if n0.contains("Int") { n0 } else { n1 }
    let str_name = if n0.contains("Str") { n0 } else { n1 }
    assert(c.contains("int64_t {int_name}(blink_list* self, int64_t x)"))
    assert(c.contains("const char* {str_name}(blink_list* self, const char* x)"))
}
