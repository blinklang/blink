import compile_test_helpers

fn poly_impl_option_tuple_src() -> Str {
    #"trait KOpt[T] {
    fn pt(self, o: Option[(T, Int)], d: Int) -> Int
}

impl[T] KOpt[T] for List[T] {
    fn pt(self, o: Option[(T, Int)], d: Int) -> Int {
        match o {
            Some(t) => { return t.1 }
            None => { return d }
        }
    }
}

fn main() {
    let xs: List[Int] = [1]
    io.println("{xs.pt(Some((4, 5)), 0)}")
}
"#
}

test("a poly-impl method with an Option-of-tuple param over the impl typevar compiles") {
    let r = compile_test_helpers.compile_and_run(poly_impl_option_tuple_src(), "_poly_impl_option_tuple_typevar")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("5"), "expected the tuple's second element: out={r.out}")
}
