import compile_test_helpers

fn poly_impl_option_tuple_src() -> Str {
    #"trait KOpt[T] {
    fn pt(self, o: Option[(T, Int)], d: Int) -> Int
}

impl[T] KOpt[T] for List[T] {
    fn pt(self, o: Option[(T, Int)], d: Int) -> Int {
        match o {
            Some(t) => { return t.1 }
            None => { return d }
        }
    }
}

fn main() {
    let xs: List[Int] = [1]
    io.println("{xs.pt(Some((4, 5)), 0)}")
}
"#
}

test.failing(
    "a poly-impl method with an Option-of-tuple param over the impl typevar compiles",
    reason: "the mono signature speller resolves the Option-of-tuple param's C type from its annotation rather than from the substituted tid, so the definition is emitted with an unknown type 'blink_Option_void' for the parameter while the call site correctly substitutes 'blink_Option_Tuple2_int_int', and cc rejects the mismatch as an implicit function declaration",
    ticket: "y83g4b",
) {
    let r = compile_test_helpers.compile_and_run(poly_impl_option_tuple_src(), "_poly_impl_option_tuple_typevar")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("5"), "expected the tuple's second element: out={r.out}")
}
