// A poly-impl method (impl[T] Trait[T] for List[T]) whose body RECURSIVELY calls
// itself over a self-recursive-typed generic enum field (t: Tree[T], with
// Branch(left: Tree[T], right: Tree[T])) concretizes the nested call's argument
// tid at the impl binder's concrete T. The non-recursive case is pinned by
// tests/test_poly_impl_generic_enum_param.bl; this row adds the recursive one.
//
// The row was once wrapped as an expected failure against a mono-resolution gap
// it never actually reached. The tree it builds uses BARE variant calls, and a
// bare ordinary-variant call used to lower as a free-function call and spell a C
// symbol no function defines. Build the same tree through the qualified form and
// it always ran. So the wrapper measured the constructor, not the recursion.

import compile_test_helpers.{compile_and_run}

test "a poly-impl method recursively calling itself over a self-typed generic enum field compiles and returns the right count" {
    let src = #"
import std.io

type Tree[T] {
    Leaf(value: T)
    Branch(left: Tree[T], right: Tree[T])
}

trait TreeCounter[T] {
    fn count_tree(self, t: Tree[T]) -> Int
}

impl[T] TreeCounter[T] for List[T] {
    fn count_tree(self, t: Tree[T]) -> Int {
        match t {
            Leaf(_v) => return 1
            Branch(l, r) => return self.count_tree(l) + self.count_tree(r)
        }
    }
}

fn main() ! IO {
    let xs: List[Int] = [1]
    let t = Branch(Leaf(1), Leaf(2))
    io.println("n={xs.count_tree(t)}")
}
"#
    let r = compile_and_run(src, "_poly_impl_recursive_method_self_typed_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=2\n")
}
