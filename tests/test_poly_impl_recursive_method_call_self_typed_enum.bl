// A poly-impl method (impl[T] Trait[T] for List[T]) whose body RECURSIVELY
// calls itself over a self-recursive-typed generic enum field (t: Tree[T],
// Branch(left: Tree[T], right: Tree[T])) must concretize the nested call's
// argument tid at the impl binder's concrete T, not leave it as the unbound
// binder. The non-recursive case already works (tests/test_poly_impl_generic_enum_param.bl);
// this is specific to the recursive self.method(field) call inside the
// poly-impl method body.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a poly-impl method recursively calling itself over a self-typed generic enum field compiles and returns the right count",
    reason: "the recursive call self.count_tree(l), where l is a Branch field of type Tree[T] (the enclosing impl binder), does not concretize: the nested call's arg tid stays the unbound binder, so the mono is named with the I0001 erased-slot backstop and the param spells blink_Tree_0T instead of blink_Tree_0Int",
    ticket: "a5cfqe",
) {
    let src = #"
import std.io

type Tree[T] {
    Leaf(value: T)
    Branch(left: Tree[T], right: Tree[T])
}

trait TreeCounter[T] {
    fn count_tree(self, t: Tree[T]) -> Int
}

impl[T] TreeCounter[T] for List[T] {
    fn count_tree(self, t: Tree[T]) -> Int {
        match t {
            Leaf(_v) => return 1
            Branch(l, r) => return self.count_tree(l) + self.count_tree(r)
        }
    }
}

fn main() ! IO {
    let xs: List[Int] = [1]
    let t = Branch(Leaf(1), Leaf(2))
    io.println("n={xs.count_tree(t)}")
}
"#
    let r = compile_and_run(src, "_poly_impl_recursive_method_self_typed_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=2\n")
}
