// A polymorphic-impl method (`impl[T] Trait[T] for List[T]`) that returns a
// plain struct or enum materializes its result into a codegen temp (_psr in
// emit_poly_impl_call) that has no typecheck node, so let_binding_tid never
// stamps it — the temp's struct name has lived only on the flat ScopeVar.sname
// channel. sv_struct_tid_first now recovers that name from the call node's own
// tid, so the flat sname is only a fallback. These guard that field access and
// match through such a temp still resolve once the flat channel is gone.
// (A generic mono-instance return — `-> Box[Int]` — is a separate uncovered
// miscompile tracked as its own bug; the tid gate declines that path.)
type Header { tag: Int, len: Int }
type Status { Idle, Busy }

trait Firster[T] {
    fn header(self) -> Header
    fn state(self) -> Status
}

impl[T] Firster[T] for List[T] {
    fn header(_self) -> Header { Header { tag: 9, len: 4 } }
    fn state(_self) -> Status { Status.Busy }
}

test "poly-impl method plain-struct return resolves through field access" {
    let xs: List[Int] = [1, 2, 3]
    assert_eq(xs.header().tag, 9)
    assert_eq(xs.header().len, 4)
}

test "poly-impl method enum return resolves through match" {
    let xs: List[Int] = [1, 2, 3]
    match xs.state() {
        Status.Busy => { assert_eq(1, 1) }
        Status.Idle => { assert_eq(1, 2) }
    }
}
