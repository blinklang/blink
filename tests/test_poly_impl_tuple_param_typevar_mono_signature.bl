import compile_test_helpers

fn poly_impl_tuple_param_src() -> Str {
    #"trait JTup[T] {
    fn firstof(self, t: (T, Int)) -> Int
}

impl[T] JTup[T] for List[T] {
    fn firstof(self, t: (T, Int)) -> Int {
        t.1
    }
}

fn main() {
    let xs: List[Int] = [1, 2]
    io.println("{xs.firstof((5, 6))}")
}
"#
}

test.failing(
    "a poly-impl method with a tuple param over the impl typevar compiles",
    reason: "the mono signature speller resolves the tuple param's C type from its type annotation rather than from the substituted tid, so the typevar inside the tuple is never substituted and the parameter is emitted as bare 'void', which cc rejects at both the declaration and the call site",
    ticket: "rxzpw8",
) {
    let r = compile_test_helpers.compile_and_run(poly_impl_tuple_param_src(), "_poly_impl_tuple_param_typevar")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("6"), "expected the tuple's second element: out={r.out}")
}
