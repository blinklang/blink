import compile_test_helpers

fn poly_impl_tuple_param_src() -> Str {
    #"trait JTup[T] {
    fn firstof(self, t: (T, Int)) -> Int
}

impl[T] JTup[T] for List[T] {
    fn firstof(self, t: (T, Int)) -> Int {
        t.1
    }
}

fn main() {
    let xs: List[Int] = [1, 2]
    io.println("{xs.firstof((5, 6))}")
}
"#
}

test "a poly-impl method with a tuple param over the impl typevar compiles" {
    let r = compile_test_helpers.compile_and_run(poly_impl_tuple_param_src(), "_poly_impl_tuple_param_typevar")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("6"), "expected the tuple's second element: out={r.out}")
}
