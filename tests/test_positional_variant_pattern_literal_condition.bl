// A positional single-payload enum pattern with a literal sub-pattern
// (IPresent(3)) must only match when the payload equals that literal.
// A different payload value must fall through to the next arm.

type IOpt { IPresent(value: Int) IAbsent }

fn classify(o: IOpt) -> Str {
    match o {
        IPresent(3) => "three"
        IPresent(v) => "val {v}"
        IAbsent => "absent"
    }
}

test "positional variant pattern keeps its literal value condition" {
    assert_eq(classify(IPresent(5)), "val 5")
    assert_eq(classify(IPresent(3)), "three")
    assert_eq(classify(IAbsent), "absent")
}
