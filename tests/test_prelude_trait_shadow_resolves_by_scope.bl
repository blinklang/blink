// A module that declares a prelude trait name has two traits of that name (sections/07 §10.6
// *Shadowing a Prelude Trait*). A name the user writes (a bound, an impl head, a @derive
// argument) resolves by scope; a form the compiler inserts (an operator, a Map key,
// assert_eq, the Eq that @derive(Ord) derives) uses the compiler-known trait by identity.
// `import blink.core.{Eq as CoreEq}` names the compiler-known trait in a written position.
// Every row runs check and build, one unit and per module, so the two paths cannot disagree.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

// A package whose src/ holds `main.bl` and, when `sim` is not empty, `geo/sim.bl`.
fn project(main: Str, sim: Str) -> Str {
    let dir = sh("mktemp -d /tmp/blink_prelude_shadow.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src/geo")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", main)
    if sim != "" { write_file("{dir}/src/geo/sim.bl", sim) }
    dir
}

fn blink(dir: Str, args: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
}

fn expect_runs(main: Str, sim: Str, want: Str) {
    let dir = project(main, sim)
    let mut ok = true
    let c = blink(dir, "check")
    if c.exit_code != 0 {
        io.eprintln("blink check: exit {c.exit_code}\n{c.out}")
        ok = false
    }
    for args in ["run --no-per-module", "run --per-module"] {
        let r = blink(dir, args)
        if r.exit_code != 0 || !r.out.trim().ends_with(want) {
            io.eprintln("blink {args}: exit {r.exit_code}, want `{want}`\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

// Each of `wants` is in the output of check and of both builds, none of `nots` is, no build
// hits an internal compiler error, and each build passes exactly when `passes` says so.
fn expect_output(main: Str, sim: Str, passes: Bool, wants: List[Str], nots: List[Str]) {
    let dir = project(main, sim)
    let mut ok = true
    for args in ["check", "build --no-per-module", "build --per-module"] {
        let r = blink(dir, args)
        let mut wrong: List[Str] = []
        for w in wants {
            if !r.out.contains(w) { wrong.push("missing {w}") }
        }
        for n in nots {
            if r.out.contains(n) { wrong.push("unwanted {n}") }
        }
        if (r.exit_code == 0) != passes || wrong.len() > 0 || r.out.contains("internal compiler error") {
            io.eprintln("blink {args}: exit {r.exit_code}, {wrong.join(", ")}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

fn expect_rejects(main: Str, sim: Str, wants: List[Str]) {
    expect_output(main, sim, false, wants, [])
}

fn expect_warns(main: Str, sim: Str, wants: List[Str]) {
    expect_output(main, sim, true, wants, [])
}

let shadow_eq = #"trait Eq {
    fn eq(self, other: Int) -> Bool
}
"#

test "an alias import of the compiler-known Eq derives it, bounds with it and licenses ==" {
    let main = #"import blink.core.{Eq as CoreEq}
"#.concat(shadow_eq).concat(#"
@derive(CoreEq)
type P {
    x: Int
}

fn same[T: CoreEq](a: T, b: T) -> Bool {
    a == b
}

fn main() {
    assert_eq(P { x: 1 }, P { x: 1 })
    io.println("{P { x: 1 } == P { x: 1 }} {same(P { x: 1 }, P { x: 2 })}")
}
"#)
    expect_runs(main, "", "true false")
}

test "@derive(Ord) in a shadowing module derives the compiler-known Eq" {
    let main = #"import blink.core.{Eq as CoreEq}
"#.concat(shadow_eq).concat(#"
@derive(Ord)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 } == P { x: 1 }} {P { x: 1 } < P { x: 2 }}")
}
"#)
    expect_runs(main, "", "true true")
}

test "a Map key in a module that shadows Hash and Eq uses the compiler-known traits" {
    let main = #"import blink.core.{Hash as CoreHash}

trait Hash {
    fn hash(self) -> Int
}

trait Eq {
    fn eq(self, other: Int) -> Bool
}

@derive(CoreHash)
type K {
    x: Int
}

fn main() {
    let mut m: Map[K, Int] = Map()
    m.insert(K { x: 1 }, 7)
    io.println("{m.get(K { x: 1 }) ?? 0}")
}
"#
    expect_runs(main, "", "7")
}

test "an impl of a shadowing Hash does not make a type a Map key" {
    let main = #"trait Hash {
    fn hash(self) -> Int
}

type K {
    x: Int
}

impl Hash for K {
    fn hash(self) -> Int { self.x }
}

fn main() {
    let mut m: Map[K, Int] = Map()
    m.insert(K { x: 1 }, 7)
    io.println("{m.len()}")
}
"#
    expect_rejects(main, "", [
        "Map key type `K` does not implement Hash (blink.core)",
        "`Hash` in this module is `Hash (main)`, a different trait with the same name as `Hash (blink.core)`",
        "import blink.core.\{Hash as CoreHash}",
        "add @derive(CoreHash, Eq) to the `K` type definition",
    ])
}

test "a shadow in another module leaves @derive(Eq) and == alone here" {
    let main = #"import geo.sim

@derive(Eq)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 } == P { x: 1 }} {sim.near(1)}")
}
"#
    let sim = shadow_eq.concat(#"
pub fn near(x: Int) -> Int { x }
"#)
    expect_runs(main, sim, "true 1")
}

test "an impl head under the alias implements the compiler-known Eq that == uses" {
    let main = #"import blink.core.{Eq as CoreEq}
"#.concat(shadow_eq).concat(#"
type Q {
    x: Int
}

impl CoreEq for Q {
    fn eq(self, other: Q) -> Bool { self.x % 10 == other.x % 10 }
}

fn main() {
    io.println("{Q { x: 3 } == Q { x: 13 }}")
}
"#)
    expect_runs(main, "", "true")
}

let fine_main = #"import geo.sim

fn main() {
    io.println("{sim.near(1)}")
}
"#

test "@derive(Eq) under a shadowing Eq is E1402 with the alias import as its fix" {
    let sim = shadow_eq.concat(#"
@derive(Eq)
type P {
    x: Int
}

pub fn near(x: Int) -> Int { x }
"#)
    expect_rejects(fine_main, sim, [
        "NotDerivable",
        "cannot derive `Eq`: it is not a compiler-known trait",
        "`Eq` here is `trait Eq` (src/geo/sim.bl:1), a user trait",
        "`Eq` here is `trait Eq` (src/geo/sim.bl:1), which shadows the compiler-known `Eq` (blink.core)",
        "@derive takes Eq, Ord, Hash, Clone, Display, Debug, Serialize, Deserialize",
        "import blink.core.\{Eq as CoreEq}",
        "then write @derive(CoreEq)",
    ])
}

test "@derive of a user trait is E1402 and says to implement it by hand" {
    let main = #"trait Shape {
    fn area(self) -> Int
}

@derive(Shape)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 }.x}")
}
"#
    expect_rejects(main, "", ["NotDerivable", "cannot derive `Shape`: it is not a compiler-known trait", "a user trait", "implement `Shape` by hand"])
}

test "@derive of a compiler-known trait that is not derivable is E1402" {
    let main = #"@derive(Add)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 }.x}")
}
"#
    expect_rejects(main, "", ["NotDerivable", "cannot derive `Add`: it is not a derivable trait"])
}

test "@derive of a name that is no trait is E1402" {
    let main = #"@derive(Eqq)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 }.x}")
}
"#
    expect_rejects(main, "", ["NotDerivable", "cannot derive `Eqq`: no trait named `Eqq` is in scope"])
}

test "a bound on a shadowing Eq does not license ==, and the error names both traits" {
    let sim = shadow_eq.concat(#"
pub fn same[T: Eq](a: T, b: T) -> Bool {
    a == b
}

pub fn near(x: Int) -> Int { x }
"#)
    expect_rejects(fine_main, sim, [
        "`==` on T needs `Eq (blink.core)`, but the bounds on T give only `Eq (geo.sim)`",
        "`Eq (geo.sim)` and `Eq (blink.core)` are different traits with the same name",
        "import blink.core.\{Eq as CoreEq}",
        "then add the bound `[T: CoreEq]`",
    ])
}

test "an impl of a shadowing Eq does not license ==, and the error names both traits" {
    let main = #"trait Eq {
    fn eq(self, other: Self) -> Bool
}

type P {
    x: Int
}

impl Eq for P {
    fn eq(self, other: P) -> Bool { self.x == other.x }
}

fn main() {
    io.println("{P { x: 1 } == P { x: 1 }}")
}
"#
    expect_rejects(main, "", [
        "`P` does not implement `Eq (blink.core)`",
        "`Eq` in this module is `Eq (main)`, a different trait with the same name as `Eq (blink.core)`",
        "import blink.core.\{Eq as CoreEq}",
        "add `@derive(CoreEq)` to `type P`",
    ])
}

test "a bound on a shadowing Add does not license +, and the error names both traits" {
    let main = #"trait Add {
    fn add(self, other: Self) -> Self
}

fn plus[T: Add](a: T, b: T) -> T {
    a + b
}

fn main() {
    io.println("hi")
}
"#
    expect_rejects(main, "", ["`+` on T needs `Add (blink.core)`, but the bounds on T give only `Add (main)`", "then add the bound `[T: CoreAdd]`"])
}

test "W1010 on a shadowing Eq lists the forms that still use the compiler-known Eq" {
    let main = shadow_eq.concat(#"
fn main() {
    io.println("{1 == 1}")
}
"#)
    expect_warns(main, "", [
        "warning[ShadowedPreludeName]: name shadows compiler-known trait",
        "shadows compiler-known trait `Eq` (blink.core)",
        "`==`, `!=`, `assert_eq`, `assert_ne` and Map/Set keys in this module still use `Eq` (blink.core)",
        "to use the compiler-known trait in this module, import it under another name:",
        "import blink.core.\{Eq as CoreEq}",
    ])
}

test "W1010 on a shadowing Add names + as a form that still uses the compiler-known Add" {
    let main = #"trait Add {
    fn add(self, other: Self) -> Self
}

fn main() {
    io.println("{1 + 2}")
}
"#
    expect_warns(main, "", [
        "shadows compiler-known trait `Add` (blink.core)",
        "`+` in this module still uses `Add` (blink.core)",
    ])
}

test "W1010 on a shadowing Clone has no forms note, since only @derive names Clone" {
    let main = #"trait Clone {
    fn dup(self) -> Self
}

fn main() {
    io.println("ok")
}
"#
    expect_output(main, "", true, ["shadows compiler-known trait `Clone` (blink.core)"], ["in this module still use"])
}

test "a qualified @derive argument that names no trait is E1402, not the compiler-known trait" {
    let main = #"@derive(nosuch.Eq)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 }.x}")
}
"#
    expect_rejects(main, "", ["NotDerivable", "cannot derive `nosuch.Eq`: no trait named `nosuch.Eq` is in scope"])
}

test "a qualified bound that names no trait is rejected, not read as the compiler-known trait" {
    let main = #"fn g[T: nosuch.Eq](a: T) -> Int { 1 }

fn main() {
    io.println("{g(1)}")
}
"#
    expect_rejects(main, "", ["nosuch.Eq"])
}

test "an alias of a compiler-known trait wins over another module's trait of the alias name" {
    let main = #"import blink.core.{Eq as CoreEq}
import geo.sim

@derive(CoreEq)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 } == P { x: 1 }} {sim.near(1)}")
}
"#
    let sim = #"pub trait CoreEq {
    fn same(self) -> Bool
}

pub fn near(x: Int) -> Int { x }
"#
    expect_runs(main, sim, "true 1")
}

test "E1402 on an alias of a shadowing trait names the trait it declares" {
    let main = #"import geo.sim.{Eq as SimEq}

@derive(SimEq)
type P {
    x: Int
}

fn main() {
    io.println("{P { x: 1 }.x}")
}
"#
    let sim = #"pub trait Eq {
    fn eq(self, other: Int) -> Bool
}
"#
    expect_rejects(main, sim, [
        "`SimEq` here is `trait Eq` (src/geo/sim.bl:1), a user trait",
        "`SimEq` here is `trait Eq` (src/geo/sim.bl:1), which shadows the compiler-known `Eq` (blink.core)",
    ])
}

test "== on a type parameter bound by a shadowing Ord names Eq as the trait it needs" {
    let main = #"trait Ord {
    fn rank(self) -> Int
}

fn same[T: Ord](a: T, b: T) -> Bool {
    a == b
}

fn main() {
    io.println("hi")
}
"#
    expect_rejects(main, "", [
        "`==` on T needs `Eq (blink.core)`, but the bounds on T give only `Ord (main)`",
        "add the bound `[T: Eq]`",
    ])
}

test "+ on a type parameter with no Add bound in a module that shadows Add gives the alias bound" {
    let main = #"trait Add {
    fn add(self, other: Self) -> Self
}

fn twice[T: Display](a: T) -> T {
    a + a
}

fn main() {
    io.println("hi")
}
"#
    expect_output(main, "", false, ["import blink.core.\{Add as CoreAdd}", "then add the bound `[T: CoreAdd]`"], ["e.g. `[T: Add]`"])
}

test "a fix in a module that already aliases the compiler-known Eq uses that alias" {
    let main = #"import blink.core.{Eq as BaseEq}

trait Eq {
    fn eq(self, other: Self) -> Bool
}

type P {
    x: Int
}

impl Eq for P {
    fn eq(self, other: P) -> Bool { self.x == other.x }
}

fn main() {
    io.println("{P { x: 1 } == P { x: 1 }}")
}
"#
    expect_output(main, "", false, ["add `@derive(BaseEq)` to `type P`"], ["import blink.core.\{Eq as CoreEq}"])
}

test "a type whose impl of the compiler-known Eq does not apply is told to write it under the alias" {
    let main = #"import blink.core.{Eq as CoreEq}
"#.concat(shadow_eq).concat(#"
type B[T] {
    v: T
}

impl CoreEq for B[Int] {
    fn eq(self, other: B[Int]) -> Bool { self.v == other.v }
}

fn main() {
    io.println("{B { v: "a" } == B { v: "a" }}")
}
"#)
    expect_output(main, "", false, ["write `impl CoreEq for B[Str]`"], ["write `impl Eq for"])
}

test "a type passed for a bound on a shadowing Eq that has only the compiler-known Eq says so" {
    let main = shadow_eq.concat(#"
fn same[T: Eq](a: T) -> Bool {
    a.eq(1)
}

fn main() {
    io.println("{same(3)}")
}
"#)
    expect_rejects(main, "", [
        "`Int` does not satisfy the Eq (main) bound on type parameter T",
        "`Int` implements `Eq (blink.core)`, a different trait with the same name as `Eq (main)`",
    ])
}
