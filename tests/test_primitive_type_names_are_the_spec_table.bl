// The table of compiler-known type names is closed (sections/07 §10.6): a name it does not
// list is not compiler-known, and the compiler must not treat it as one. `is_primitive_type`
// in src/typecheck.bl is the compiler's own list, so every name it answers for must be in the
// spec's table. This reads both files, so a name added to one alone fails here.

fn between(text: Str, start: Str, end: Str) -> Str {
    let from = text.byte_index_of(start, 0) ?? -1
    assert(from >= 0)
    let to = text.byte_index_of(end, from + start.byte_len()) ?? -1
    assert(to > from)
    text.byte_slice(from, to)
}

// Each backticked name in the table's first column, without its parameters.
fn spec_table_names() -> List[Str] {
    let table = between(read_file("sections/07_trust_modules_metadata.md"),
        "#### Compiler-Known Type Names (closed set)", "#### Shadowing Rules")
    let mut names: List[Str] = []
    for line in table.split("\n") {
        if !line.starts_with("| `") { continue }
        let first = line.split("|").get(1) ?? ""
        let parts = first.split("`")
        let mut i = 1
        while i < parts.len() {
            let spelled = parts.get(i) ?? ""
            names.push(spelled.split("[").get(0) ?? spelled)
            i = i + 2
        }
    }
    names
}

// Each name `is_primitive_type` answers 1 for.
fn primitive_type_arms() -> List[Str] {
    let body = between(read_file("src/typecheck.bl"), "fn is_primitive_type(", "\n}\n")
    let mut names: List[Str] = []
    for line in body.split("\n") {
        let t = line.trim()
        if !t.starts_with("\"") || !t.ends_with("=> 1") { continue }
        names.push(t.split("\"").get(1) ?? "")
    }
    names
}

test "the spec table is read whole" {
    let names = spec_table_names()
    assert(names.contains("Int"))
    assert(names.contains("Self"))
    assert(names.contains("Handler"))
    assert(names.contains("Buf"))
    assert(!names.contains("Duration"))
}

test "is_primitive_type answers only for names the spec table lists" {
    let table = spec_table_names()
    let arms = primitive_type_arms()
    assert(arms.contains("Int"))
    // `fn(A) -> B` and `(A, B)` reach the checker as annotations spelled Fn and Tuple. They
    // stay on the list until every reader tells those annotations apart by their marker.
    let syntax = ["Fn", "Tuple"]
    let mut stray: List[Str] = []
    for a in arms {
        if !table.contains(a) && !syntax.contains(a) { stray.push(a) }
    }
    for s in stray { io.eprintln("is_primitive_type answers for `{s}`, which §10.6 does not list") }
    assert(stray.len() == 0)
}
