fn main() {
    let result = process.run("echo", ["hello world"]).unwrap()
    io.println("end: {result.end}")
    io.println("has output: {result.out.len() > 0}")

    let result2 = process.run("printf", ["no newline"]).unwrap()
    io.println("printf: {result2.out}")

    let result3 = process.run("false", []).unwrap()
    io.println("false end: {result3.end}")

    let result4 = process.run("sh", ["-c", "echo errtext >&2"]).unwrap()
    io.println("has stderr: {result4.err_out.len() > 0}")

    match process.run("nonexistent_command_xyz", []) {
        Ok(_) => panic("a missing command ran")
        Err(e) => io.println("not found: {e}")
    }

    let result6 = process.run("cat", [], stdin: Some("hello from stdin")).unwrap()
    io.println("stdin: {result6.out}")
    io.println("stdin end: {result6.end}")
}
