// ProcessResult.end says how the child ended, and success() is true exactly for Exited(0).
// A signal is Signaled(n), never an exit code of 128 + n.

import std.process.{ChildEnd, SIGKILL, SIGTERM}

test "a run that exits 0 ends as Exited(0) and is a success" {
    let r = process.run("sh", ["-c", "exit 0"])?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.success())
}

test "a run that exits 3 ends as Exited(3) and is not a success" {
    let r = process.run("sh", ["-c", "exit 3"])?
    assert_eq(r.end, ChildEnd.Exited(3))
    assert(!r.success())
}

test "a run whose child exits 137 by choice ends as Exited(137), not as a signal" {
    let r = process.run("sh", ["-c", "exit 137"])?
    assert_eq(r.end, ChildEnd.Exited(137))
}

test "a run whose child kills itself with SIGKILL ends as Signaled(SIGKILL)" {
    let r = process.run("sh", ["-c", "kill -9 $$"])?
    assert_eq(r.end, ChildEnd.Signaled(SIGKILL))
    assert(!r.success())
}

test "a spawned child that exits 0 ends as Exited(0) and is a success" {
    let r = process.wait(process.spawn("sh", ["-c", "exit 0"])?)?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.success())
}

test "a spawned child that exits 3 ends as Exited(3)" {
    let r = process.wait(process.spawn("sh", ["-c", "exit 3"])?)?
    assert_eq(r.end, ChildEnd.Exited(3))
    assert(!r.success())
}

test "a spawned child killed with SIGKILL ends as Signaled(9) and is not a success" {
    let child = process.spawn("sh", ["-c", "sleep 30"])?
    process.signal(child, SIGKILL)?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Signaled(SIGKILL))
    assert(!r.success())
}

test "a second wait returns the same end" {
    let child = process.spawn("sh", ["-c", "sleep 30"])?
    process.signal(child, SIGTERM)?
    let first = process.wait(child)?
    let again = process.wait(child)?
    assert_eq(first.end, ChildEnd.Signaled(SIGTERM))
    assert_eq(again.end, first.end)
}

test "ends compare by variant and by payload" {
    assert(ChildEnd.Exited(1) != ChildEnd.Exited(2))
    assert(ChildEnd.Exited(9) != ChildEnd.Signaled(9))
}
