// `process.f(..)` in a file that imports its own module named `process` calls that module,
// as any qualified call does. The `process` handle of sections/04_effects.md §4.4.8 stays the
// reading in every other file of the program, and in a file whose `process` is std.process.

import std.process.{ProcessResult}
import compile_test_helpers

fn run_package(tag: Str, files: List[(Str, Str)]) -> ProcessResult {
    let root = "{compile_test_helpers.scratch_root()}/{tag}"
    let _ = process.run("mkdir", ["-p", "{root}/src"]).unwrap()
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n")
    for f in files {
        write_file("{root}/src/{f.0}", f.1)
    }
    process.run("build/blink", ["run", "-o", "{root}/main", "{root}/src/main.bl"]).unwrap()
}

// wait and signal only: a user fn named run, spawn or exec shares its C name with the runtime's.
let USER_PROCESS: Str = "pub fn wait(x: Int) -> Int \{ x + 1 }\npub fn signal(x: Int) -> Int \{ x + 2 }\n"

test "a file that imports a module named process calls that module" {
    let main = "import process\n\nfn main() ! IO \{\n    io.println(\"\{process.wait(1)} \{process.signal(1)}\")\n}\n"
    let r = run_package("process_q_user_module", [("process.bl", USER_PROCESS), ("main.bl", main)])
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2 3\n")
}

test "a file that does not import the user module still reaches the process handle" {
    let runner = "pub fn run_echo() -> Str ! Process \{\n    process.run(\"sh\", [\"-c\", \"echo op\"]).unwrap().out\n}\n"
    let main = "import process\nimport runner\n\nfn main() ! IO, Process \{\n    io.println(\"\{process.wait(1)}\")\n    io.print(runner.run_echo())\n}\n"
    let r = run_package("process_q_user_module_and_handle", [("process.bl", USER_PROCESS), ("runner.bl", runner), ("main.bl", main)])
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\nop\n")
}

test "a file that imports std.process still reaches the process handle" {
    let main = "import std.process.\{ProcessError}\n\nfn main() ! IO, Process \{\n    match process.run(\"sh\", [\"-c\", \"echo op\"]) \{\n        Ok(r) => io.print(r.out)\n        Err(e) => io.println(\"\{e}\")\n    }\n}\n"
    let r = run_package("process_q_std_import_handle", [("main.bl", main)])
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "op\n")
}
