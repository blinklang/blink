// signal_name gives the host's name for a signal number, and "SIG<n>" for a number the
// host has no name for, a real-time signal included.

import std.process.{signal_name, SIGHUP, SIGINT, SIGQUIT, SIGKILL, SIGTERM, SIGSEGV, SIGBUS, SIGABRT, SIGXCPU}

test "each signal constant has its own name" {
    assert_eq(signal_name(SIGHUP), "SIGHUP")
    assert_eq(signal_name(SIGINT), "SIGINT")
    assert_eq(signal_name(SIGQUIT), "SIGQUIT")
    assert_eq(signal_name(SIGKILL), "SIGKILL")
    assert_eq(signal_name(SIGTERM), "SIGTERM")
    assert_eq(signal_name(SIGSEGV), "SIGSEGV")
    assert_eq(signal_name(SIGBUS), "SIGBUS")
    assert_eq(signal_name(SIGABRT), "SIGABRT")
    assert_eq(signal_name(SIGXCPU), "SIGXCPU")
}

test "a number with no name gives SIG and the number" {
    assert_eq(signal_name(34), "SIG34")
    assert_eq(signal_name(0), "SIG0")
    assert_eq(signal_name(1000), "SIG1000")
}

test "the name agrees with the signal that ended a child" {
    let r = process.run("sh", ["-c", "kill -SEGV $$"])?
    match r.end {
        Signaled(n) => assert_eq(signal_name(n), "SIGSEGV")
        _ => assert(false, "expected a signal end, got {r.end.debug()}")
    }
}
