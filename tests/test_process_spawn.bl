import std.process.{ChildEnd, SIGKILL, SIGTERM}

// Runtime primitives for non-blocking process spawn + signal propagation.
//
// These are the building blocks for lib/std/process; cmd_test uses them to
// forward SIGTERM/SIGINT to live build/test workers instead of orphaning them.

test "spawn echo and wait captures stdout + zero exit" {
    let child = process.spawn("echo", ["hello-spawn"])?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out.contains("hello-spawn"), "expected stdout to contain 'hello-spawn', got: {r.out}")
}

test "spawn captures stderr separately" {
    let child = process.spawn("sh", ["-c", "printf err-out 1>&2"])?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.err_out.contains("err-out"), "expected stderr to contain 'err-out', got: {r.err_out}")
}

test "spawn + signal SIGKILL ends the child with that signal" {
    let child = process.spawn("sh", ["-c", "sleep 30"])?
    process.signal(child, SIGKILL)?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Signaled(SIGKILL))
}

test "spawn + signal SIGTERM ends the child through its trap or the signal" {
    let child = process.spawn("sh", ["-c", "trap 'exit 143' TERM; sleep 30"])?
    process.signal(child, SIGTERM)?
    let r = process.wait(child)?
    // The trap exits 143 if the shell had set it before the signal came; else the signal ends the shell.
    assert(r.end == ChildEnd.Exited(143) || r.end == ChildEnd.Signaled(SIGTERM), "ended with {r.end}")
}

test "spawn nonzero exit propagates" {
    let child = process.spawn("sh", ["-c", "exit 7"])?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Exited(7))
}

test "double-wait on already-reaped child returns cached result" {
    let child = process.spawn("echo", ["once"])?
    let r1 = process.wait(child)?
    let r2 = process.wait(child)?
    assert_eq(r1.end, ChildEnd.Exited(0))
    assert_eq(r2.end, ChildEnd.Exited(0))
}

// A child that writes more than one pipe buffer (~64KB) to STDERR while the
// parent is reading must not deadlock. The wait must drain stdout and stderr
// concurrently — draining stdout to EOF first blocks the child on its stderr
// write (EOF on stdout never arrives), hanging both sides. Regression for the
// cmd_test hang on chatty --debug builds (e.g. test_bytes.bl).
test "spawn with large stderr does not deadlock" {
    let child = process.spawn("sh", ["-c", "i=0; while [ $i -lt 4000 ]; do echo 'padding padding padding padding padding padding padding' 1>&2; i=$((i+1)); done; echo small-stdout"])?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out.contains("small-stdout"), "expected stdout captured, got len {r.out.len()}")
    assert(r.err_out.len() > 100000, "expected large stderr captured, got len {r.err_out.len()}")
}

// Symmetric case: a child that writes more than one pipe buffer to STDOUT
// while also writing stderr. Guards against a fix that only reorders the two
// sequential drains instead of interleaving them.
test "spawn with large stdout does not deadlock" {
    let child = process.spawn("sh", ["-c", "i=0; while [ $i -lt 4000 ]; do echo 'padding padding padding padding padding padding padding'; i=$((i+1)); done; echo small-err 1>&2"])?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out.len() > 100000, "expected large stdout captured, got len {r.out.len()}")
    assert(r.err_out.contains("small-err"), "expected stderr captured, got len {r.err_out.len()}")
}

// The Child keeps the result of its first wait, so a second wait must give back that whole
// result: both streams in full past one pipe buffer, and the end, not a fresh or empty one.
test "a second wait on a Child gives back the same full result, large output included" {
    let child = process.spawn("sh", ["-c", "i=0; while [ $i -lt 4000 ]; do echo \"out line $i padding padding\"; echo \"err line $i padding padding\" 1>&2; i=$((i+1)); done; exit 3"])?
    let r1 = process.wait(child)?
    let r2 = process.wait(child)?
    assert_eq(r1.end, ChildEnd.Exited(3))
    assert(r1.out.len() > 100000, "expected large stdout, got len {r1.out.len()}")
    assert(r1.err_out.len() > 100000, "expected large stderr, got len {r1.err_out.len()}")
    assert(r1.out.contains("out line 3999 "), "stdout lacks its last line")
    assert_eq(r2.end, r1.end)
    assert(r2.out == r1.out, "second wait stdout differs: len {r2.out.len()} vs {r1.out.len()}")
    assert(r2.err_out == r1.err_out, "second wait stderr differs: len {r2.err_out.len()} vs {r1.err_out.len()}")
}
