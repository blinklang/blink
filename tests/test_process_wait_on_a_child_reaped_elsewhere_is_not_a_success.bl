// process.wait on a child that another waitpid already reaped: the wait fails with ECHILD
// and names no child that ended, so it must not read as a clean exit 0.

@ffi("c", "waitpid")
fn c_waitpid(pid: I32, status: Ptr[I32], options: I32) -> I32 ! ()

test "a wait on a child reaped elsewhere is not a success" {
    let child = process.spawn("true", [])?
    with ffi.scope() as scope {
        let st: Ptr[I32] = scope.alloc[I32]()
        let reaped = c_waitpid(-1.to_i32(), st, 0.to_i32())
        assert(reaped.to_int() > 0)
    }
    match process.wait(child) {
        Ok(r) => assert(false, "a reaped child waited as {r.end}")
        Err(e) => assert_eq("{e}", "wait true: No child processes")
    }
}
