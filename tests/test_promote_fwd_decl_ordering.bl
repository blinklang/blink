type Connection { fd: Int }
type PgError { msg: Str }
impl Closeable for Connection { fn close(_self) {} }
fn connect() -> Result[Connection, PgError] { Ok(Connection { fd: 7 }) }

fn run() -> Result[Int, PgError] {
  let result = fn() -> Result[Int, PgError] {
    with connect()? as conn { Ok(conn.fd) }
  }()
  result
}

test "iife with `with..? as` body emits promote fwd decl before use" {
  let result = fn() -> Result[Int, PgError] {
    with connect()? as conn { Ok(conn.fd) }
  }()
  match result {
    Ok(v) => { assert(v == 7) }
    Err(_) => { assert(false) }
  }
}

test "closure in regular fn also emits promote fwd decl before use" {
  match run() {
    Ok(v) => { assert(v == 7) }
    Err(_) => { assert(false) }
  }
}
