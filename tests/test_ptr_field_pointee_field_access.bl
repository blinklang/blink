// A Ptr[T] stored in a struct FIELD loses its pointee type: the field's declared C
// type falls back to void*, so a further field access through it (`h.p.x`, an
// implicit dereference via dot-syntax, not an explicit `.deref()` call) emits a
// void* dereference that cc rejects. The identical pointer used directly (not
// stored through a struct field first) works fine. This is a different access
// idiom from tests/test_generic_enum_ffi_struct_variant_typedef_name.bl (Ptr[T] as
// an enum-variant payload, read via an explicit `.deref()` call) and
// tests/test_ffi_struct_field_access.bl (a Ptr[Pollfd] read via `.field.read()`
// accessor methods, not implicit dot-through-field access on a plain struct).

import compile_test_helpers.{compile_and_run}

test.failing(
    "field access through a Ptr stored in a struct field compiles",
    reason: "a Ptr[T] stored as a struct field is declared as void* (the pointee type is lost at the field declaration), so a further field access through it via dot-syntax emits a void* dereference and cc rejects it with 'request for member x in something not a structure or union'; the same pointer accessed directly, not through a struct field, works",
) {
    let src = #"
import std.io

type RPoint { x: Int, y: Int }
type PHold { p: Ptr[RPoint] }

fn main() {
    with ffi.scope() as scope {
        let p: Ptr[RPoint] = scope.alloc()
        p.write(RPoint { x: 3, y: 4 })
        let h = PHold { p: p }
        io.println("{h.p.x}")
    }
}
"#
    let r = compile_and_run(src, "_ptr_field_pointee_field_access")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
