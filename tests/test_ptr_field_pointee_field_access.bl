// A Ptr[T] stored in a struct field must keep its pointee type, so a field
// read through it (`h.p.x.read()`) reaches the pointee's field. Ptr[T] needs
// an @ffi.struct T, and `p.x` on such a pointer is a pointer to the field that
// `.read()` loads. This differs from
// tests/test_generic_enum_ffi_struct_variant_typedef_name.bl (Ptr[T] as an
// enum-variant payload) and tests/test_ffi_struct_field_access.bl (a Ptr read
// directly, not through a struct field).

import compile_test_helpers.{compile_and_run}

test "field access through a Ptr stored in a struct field compiles" {
    let src = #"
import std.io

@ffi.struct
type RPoint { x: Int, y: Int }
@ffi.struct
type PHold { p: Ptr[RPoint] }

fn main() {
    with ffi.scope() as scope {
        let p: Ptr[RPoint] = scope.alloc()
        p.write(RPoint { x: 3, y: 4 })
        let h = PHold { p: p }
        io.println("{h.p.x.read()}")
    }
}
"#
    let r = compile_and_run(src, "_ptr_field_pointee_field_access")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
