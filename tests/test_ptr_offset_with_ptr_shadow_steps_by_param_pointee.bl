// A `Bytes.with_ptr` closure parameter that shadows an outer pointer of another width steps by
// its own pointee. The outer `p` is `Ptr[I32]` and the parameter is `Ptr[U8]`, so a step that
// borrowed the outer type would move four bytes where the parameter means one. C steps by the
// type the arithmetic is spelled at, so the emitted declaration is what decides the address.
//
// This reads the emitted C rather than running the program: a parameter that shadows an outer
// local today redeclares it in the same C block, and the program does not build.
import compile_test_helpers

fn shadow_src() -> Str {
    #"@trusted(audit: "with-ptr-shadow-offset-test")
fn go() -> Int {
    with ffi.scope() as scope {
        let p: Ptr[I32] = scope.alloc_n(2)
        p.write((7).to_i32())
        let b = Bytes.new()
        b.push(1)
        b.push(2)
        b.with_ptr(fn(p) {
            let inner_step = p.offset(1)
            inner_step.deref().to_int()
        })
    }
}

fn main() { io.println("{go()}") }
"#
}

test "a with_ptr parameter shadowing a wider pointer steps by its own pointee" {
    let c = compile_test_helpers.compile_and_emit_c(shadow_src(), "ptr_offset_with_ptr_shadow")
    assert(c.contains("int32_t* b_p = "))
    assert(c.contains("uint8_t* b_inner_step = (b_p + 1);"))
    assert(!c.contains("int32_t* b_inner_step"))
}
