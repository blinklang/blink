// `p.write(v)` checks `v` against the pointee `T`, and a literal takes `T`
// (sections/07_trust_modules_metadata.md, `fn write(self, value: T)`). Each store here is
// legal, so each must still build, and `deref` (or a field `read`) must give back the value
// stored at the pointee's own width: a literal that takes U64 or I8 keeps its exact value.
import std.libc.{Pollfd}

@trusted(audit: "ptr-write-round-trip")
fn put[T](p: Ptr[T], v: T) ! FFI { p.write(v) }

@trusted(audit: "ptr-write-round-trip")
fn scalars() ! FFI {
    with ffi.scope() as scope {
        let a: Ptr[U8] = scope.alloc()
        a.write(255)
        assert_eq(a.deref().to_int(), 255)
        let b: Ptr[I8] = scope.alloc()
        b.write(-128)
        assert_eq(b.deref().to_int(), -128)
        let c: Ptr[U16] = scope.alloc()
        c.write(65535)
        assert_eq(c.deref().to_int(), 65535)
        let d: Ptr[I16] = scope.alloc()
        d.write(-32768)
        assert_eq(d.deref().to_int(), -32768)
        let e: Ptr[U32] = scope.alloc()
        e.write(4294967295)
        assert_eq(e.deref().to_int(), 4294967295)
        let f: Ptr[I32] = scope.alloc()
        f.write(-2147483648)
        assert_eq(f.deref().to_int(), -2147483648)
        let g: Ptr[U64] = scope.alloc()
        g.write(18446744073709551615)
        assert_eq("{g.deref()}", "18446744073709551615")
        let h: Ptr[Int] = scope.alloc()
        h.write(-9223372036854775807)
        assert_eq(h.deref(), -9223372036854775807)
        let k: Ptr[Float] = scope.alloc()
        k.write(2.5)
        assert_eq(k.deref(), 2.5)
    }
}

@trusted(audit: "ptr-write-round-trip")
fn structs_and_cells() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[Pollfd] = scope.alloc()
        p.write(Pollfd { fd: 3, events: 4, revents: 5 })
        assert_eq(p.deref().fd.to_int(), 3)
        p.events.write(-32768)
        p.fd.write(2147483647)
        assert_eq(p.events.read().to_int(), -32768)
        assert_eq(p.fd.read().to_int(), 2147483647)
        assert_eq(p.revents.read().to_int(), 5)

        let cell: Ptr[Ptr[U8]] = scope.alloc()
        let byte: Ptr[U8] = scope.alloc()
        byte.write(9)
        cell.write(byte)
        assert_eq(cell.deref().deref().to_int(), 9)

        let generic: Ptr[U8] = scope.alloc()
        put(generic, 200)
        assert_eq(generic.deref().to_int(), 200)
    }
}

test "scalar pointees store and read back literals at their own width" { scalars() }

test "struct, field and pointer-cell stores read back" { structs_and_cells() }
