// Two test names differing only in a punctuation character must mangle to
// distinct C symbols and both must run and report independently.

import compile_test_helpers.{compile_and_run_test_json}

test.failing(
    "test names differing only by an operator character compile and both run",
    reason: "the name-to-symbol mangler replaces every non-identifier byte with a single underscore, which is not injective; two such names collide into one C function and the file fails to compile with a redefinition error",
    ticket: "3nsztp",
) {
    let src = "test \"Bool + Bool is rejected\" \{ assert(1 == 1) }\ntest \"Bool - Bool is rejected\" \{ assert(1 == 1) }\n"
    let r = compile_and_run_test_json(src, "_punctuation_only_name_diff")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert(r.out.contains("\"name\":\"Bool + Bool is rejected\",\"status\":\"passed\""))
    assert(r.out.contains("\"name\":\"Bool - Bool is rejected\",\"status\":\"passed\""))
    assert(r.out.contains("\"passed\":2"))
    assert(r.out.contains("\"failed\":0"))
}
