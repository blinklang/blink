// The stdlib binds its pure runtime helpers (bytes, str, StringBuilder, containers) with
// the explicit pure row `! ()`. A fn with no row must be able to reach each of them through
// the stdlib methods, and get the right answer.

fn bytes_roundtrip() -> Str {
    let mut b = Bytes.from_str("hi")
    b.push(33)
    b.write_u32_be(258)
    let s = b.slice(0, 3).to_str().unwrap()
    "{s}:{b.len()}:{b.read_u32_be(3).unwrap()}:{b.to_hex()}"
}

fn str_ops() -> Str {
    let s = "  héllo world  ".trim()
    let parts = s.split(" ")
    "{s.len()}:{s.index_of("o").unwrap()}:{s.char_at(1).unwrap()}:{parts.len()}:{parts.get(1).unwrap().replace("o", "0").to_upper()}"
}

fn sb_ops() -> Str {
    let mut sb = StringBuilder.new()
    sb.write("n=")
    sb.write("{42}")
    sb.write_char('!')
    let n = sb.len()
    "{sb.to_str()}:{n}:{sb.is_empty()}"
}

fn container_ops() -> Str {
    let l = [1, 2, 3, 4].skip(1)
    let mut st: Set[Str] = Set.new()
    st.insert("a")
    st.insert("a")
    st.insert("b")
    st.remove("b")
    let mut m: Map[Str, Int] = Map.new()
    m.insert("k", 1)
    let has_k = m.contains_key("k")
    let m_len = m.len()
    m.clear()
    let total = [10, 20, 30].into_iter().map(fn(x: Int) -> Int { x + 1 }).collect()
    "{l.len()},{l.get(0).unwrap()}:{st.len()}:{st.contains("a")}:{has_k}:{m_len}:{m.len()}:{total.len()},{total.get(2).unwrap()}"
}

test "a row-less fn reaches the pure bytes bindings" {
    assert_eq(bytes_roundtrip(), "hi!:7:258:68692100000102")
}

test "a row-less fn reaches the pure str bindings" {
    assert_eq(str_ops(), "11:4:é:2:W0RLD")
}

test "a row-less fn reaches the pure StringBuilder bindings" {
    assert_eq(sb_ops(), "n=42!:5:false")
}

test "a row-less fn reaches the pure container bindings" {
    assert_eq(container_ops(), "3,2:1:true:true:1:0:3,31")
}
