// A `@pure` fn may perform no effect, so a handle op in its body is ImpureBodyForPureAnnotation
// (E1307) alone: adding the effect to a row is no way out (sections/04_effects.md §4.16.3).

import compile_test_helpers

fn out_of(src: Str, tag: Str) -> Str ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    compile_test_helpers.compile_and_capture(src, tag)
}

test "io.eprintln in a @pure fn is E1307 and not E0500" {
    let out = out_of(#"@pure
fn f() {
    io.eprintln("x")
}
fn main() {
    f()
}
"#, "pure_handle_op_eprintln")
    compile_test_helpers.expect_error(out, "E1307", "E1307")
    assert(!out.contains("E0500"), "E0500 as well: {out}")
    compile_test_helpers.expect_contains(out, "`@pure` function `f` has the effect `IO.Eprint`", "title")
    compile_test_helpers.expect_contains(out, "`io.eprintln` needs `IO.Eprint`", "label")
    compile_test_helpers.expect_contains(out, "remove `@pure`", "help")
}

test "env.var in a @pure fn is E1307 and not E0500" {
    let out = out_of(#"@pure
fn home() -> Str {
    env.var("HOME") ?? ""
}
fn main() {
    io.println(home())
}
"#, "pure_handle_op_env")
    compile_test_helpers.expect_error(out, "E1307", "E1307")
    assert(!out.contains("E0500"), "E0500 as well: {out}")
}

test "a suspension in a @pure fn is E1307 and not E0500" {
    let out = out_of(#"@pure
fn f(ch: Channel[Int]) -> Int {
    ch.recv() ?? 0
}
fn main() {
    let _ = f(channel.new[Int](buffer: 1))
}
"#, "pure_handle_op_recv")
    compile_test_helpers.expect_error(out, "E1307", "E1307")
    assert(!out.contains("E0500"), "E0500 as well: {out}")
}

test "a pure op-free @pure fn stays clean" {
    let out = out_of(#"@pure
fn f(n: Int) -> Int {
    n + 1
}
fn main() {
    io.println("{f(1)}")
}
"#, "pure_no_handle_op")
    compile_test_helpers.expect_compiles_clean(out, "clean")
}
