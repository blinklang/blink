// There is no FFI effect (sections/07_trust_modules_metadata.md), so a pure @ffi binding
// states its row as `! ()`. Every @ffi binding in these stdlib modules is pure, so the symbol
// index must list none of their fns under the FFI effect.

import std.process.{ProcessResult, ChildEnd}

fn ffi_fns_in(module: Str) -> ProcessResult {
    process.run("sh", ["-c", "$(pwd)/build/blink query lib/std/{module}.bl --effect FFI"]).unwrap()
}

test "the pure stdlib modules bind no fn with an FFI row" {
    let modules = ["bytes", "str", "sb", "list", "set", "map", "iter", "net_tcp", "fs_error"]
    for module in modules {
        let r = ffi_fns_in(module)
        if r.out.trim() != "\{\"results\":[]}" {
            io.eprintln("lib/std/{module}.bl:\n{r.out}\nstderr:\n{r.err_out}")
        }
        assert_eq(r.end, ChildEnd.Exited(0))
        assert_eq(r.out.trim(), "\{\"results\":[]}")
    }
}
