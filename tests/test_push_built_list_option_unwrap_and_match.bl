// A push-built (unannotated element-carrier) List[Option[Int]] must typecheck
// and codegen identically to the list-literal form: a double .unwrap() chain
// off .get() must typecheck, and a single .unwrap() followed by a match arm
// must actually declare its bound payload in the emitted code.

test "push-built List[Option[Int]] supports a double unwrap chain off .get()" {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(7))
    let v = xs.get(0).unwrap().unwrap()
    assert_eq(v, 7)
}

test "push-built List[Option[Int]] element matches after a single unwrap" {
    let mut li: List[Option[Int]] = []
    li.push(Some(9))
    let c = li.get(0).unwrap()
    let mut got = -1
    match c {
        Some(v) => { got = v }
        None => { got = -2 }
    }
    assert_eq(got, 9)
}
