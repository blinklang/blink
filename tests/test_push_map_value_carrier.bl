// A push-built (unannotated) Map whose value is a carrier — Map[K, Option[V]] or
// Map[K, Result[T,E]] — carries that value as a bound metavar: `let mut m = Map()`
// gives the value an unbound metavar and the first insert pins it. A pinned metavar has
// kind Unknown with inner1 pointing at its solution, so map_val_carrier_from_vtid, which
// reads the value kind off the raw tid (tc_tid_ct), declines the carrier and erases it —
// m.get(k) then spells the erased blink_Option_option (or blink_Result_..) and fails to
// C-compile. Resolving the value tid before reading its kind recovers the carrier.
// Written in the corpus so the shapes are the real self-hosted build, not a
// compile_and_run string (feedback_corpus_sweep_is_not_coverage).

type MapValPoint { x: Int, y: Int }
type MapValColor { Red, Green, Blue }

// --- Option value carrier: get().unwrap() through the pinned metavar ---
test "a push-built Map[Str, Option[Str]] reads its value carrier back through get().unwrap()" {
    let mut m = Map()
    m.insert("a", Some("hi"))
    m.insert("b", None)
    let v = m.get("a")
    let inner = v.unwrap()
    let s = inner.unwrap()
    assert_eq(s.len(), 2)
    assert(!m.get("b").unwrap().is_some())
}

// --- Option value carrier, scalar-independent Int ---
test "a push-built Map[Str, Option[Int]] reads its value carrier back to the int" {
    let mut m = Map()
    m.insert("x", Some(7))
    m.insert("y", None)
    let v = m.get("x")
    let inner = v.unwrap()
    let n = inner.unwrap()
    assert_eq(n, 7)
}

// --- Result value carrier: both sides pinned (Ok pins T, Err pins E) ---
test "a push-built Map[Str, Result[Str,Int]] reads an Ok value back through get().unwrap()" {
    let mut m = Map()
    m.insert("ok", Ok("alpha"))
    m.insert("er", Err(1))
    let v = m.get("ok")
    let r = v.unwrap()
    let s = r.unwrap()
    assert_eq(s.len(), 5)
    assert(m.get("er").unwrap().is_err())
}

// --- Nominal inners: the carrier tag (resolved) carries the struct/enum name even though
// the secondary inner_ct/inner_sname channels read the child metavar raw. ---
test "a push-built Map[Str, Option[Struct]] reads its struct value back through get().unwrap()" {
    let mut m = Map()
    m.insert("a", Some(MapValPoint { x: 3, y: 4 }))
    m.insert("b", None)
    let inner = m.get("a").unwrap()
    let p = inner.unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "a push-built Map[Str, Option[Enum]] reads its enum value back through get().unwrap()" {
    let mut m = Map()
    m.insert("a", Some(MapValColor.Green))
    m.insert("b", None)
    let inner = m.get("a").unwrap()
    let c = inner.unwrap()
    let ok = match c {
        MapValColor.Green => { true }
        _ => { false }
    }
    assert(ok)
}

test "a push-built Map[Str, Result[Struct,Int]] reads an Ok struct back through get().unwrap()" {
    let mut m = Map()
    m.insert("ok", Ok(MapValPoint { x: 5, y: 6 }))
    m.insert("er", Err(1))
    let r = m.get("ok").unwrap()
    let p = r.unwrap()
    assert_eq(p.x, 5)
    assert_eq(p.y, 6)
}
