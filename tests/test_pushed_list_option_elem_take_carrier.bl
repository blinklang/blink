// A List[Option[T]] built via .push() (not a list literal / annotation) must
// still carry its Option element type through a compound HOF like .take(),
// not erase the element to void.

test "take over a push-built List[Option[T]] keeps the Option element" {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(7))
    let ys = xs.take(5)
    let v = ys.get(0).unwrap()
    assert_eq(v.unwrap(), 7)
}
