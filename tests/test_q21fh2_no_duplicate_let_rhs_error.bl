// q21fh2: a let-RHS MethodCall whose argument type-checks fail produced TWO
// identical diagnostics, because both full passes over a fn body call
// infer_type on the RHS — the nr pass (to set nr_set_last_type) and the tc pass
// (declared-vs-inferred check). infer_type emits diagnostics, and the emit
// chokepoint (diag_emit_range_notes) had no dedup, so the same error fired
// twice. The fix dedups byte-identical diagnostics at that single chokepoint.
//
// Symptom asserted via the human summary line: "1 error(s) found", never
// "2 error(s) found". A genuinely distinct second error on the same node would
// have a different code/message and so survive the dedup (the key includes both).

test "let-RHS MethodCall arg error is reported once, not twice" {
    let src = "pub fn main() \{ let _ = \"s\".substring(\"a\") \}\n"
    let path = ".tmp/_test_q21fh2.bl"
    write_file(path, src)
    let r = process_run("build/blink", ["check", path])
    let out = "{r.out}{r.err_out}"
    // The arg-type error must be present...
    assert(out.contains("argument 1 of 'Str.substring' expects Int, got Str"))
    // ...exactly once.
    assert(out.contains("1 error(s) found"))
    assert(!out.contains("2 error(s) found"))
    fs.remove(path)
}
