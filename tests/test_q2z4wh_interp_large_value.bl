let mut interp_calls = 0

fn bump() -> Int {
    interp_calls = interp_calls + 1
    99
}

fn match_interp() -> Str {
    match "key{bump()}" {
        "key1" => return "one"
        "key2" => return "two"
        _ => return "other"
    }
}

fn main() {
    let chunk = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    let mut big = ""
    let mut i = 0
    while i < 100 {
        big = big.concat(chunk)
        i = i + 1
    }
    // Interpolation is concatenation with no length cap (spec §2.4): a >4095
    // byte value must survive interpolation intact, not truncate to 4095.
    assert_eq(big.len(), 6400)
    assert_eq(("{big}").len(), 6400)
    assert_eq(("pre:{big}:post").len(), 6409)

    // An interpolated string used as a match scrutinee must evaluate its
    // interpolants exactly once, not once per arm tested.
    let chosen = match_interp()
    assert_eq(chosen, "other")
    assert_eq(interp_calls, 1)
}
