// A Set nested inside a List's compound carrier element (List[Option[Set]],
// List[Result[Set, E]], List[Map[K, Set]]) must keep its element type across
// every readback path — rebind+match, for-in, and get()/unwrap. deep_tp_from_tid
// (the tid-side deep tp builder) used to erase a Set inner and cede to the flat
// pool; deep_tp_from_ann spells it faithfully, so the tid path must reach the same
// type_set node or the for-in path emits an inner-erased `blink_Option_set` and the
// C compiler rejects the scrutinee. Element widths (Int, Str) are observable, so an
// erased inner is a wrong readback, not a silent decode-to-Int.

test "for-in over List[Option[Set]] reaches the set element" {
    let mut a: List[Option[Set[Int]]] = []
    let mut s: Set[Int] = Set()
    s.insert(7)
    s.insert(8)
    a.push(Some(s))
    let mut total = 0
    for cell in a {
        match cell {
            Some(ss) => total = total + ss.len()
            None => assert(false)
        }
    }
    assert_eq(total, 2)
}

test "for-in over List[Result[Set, Str]] reaches the ok set element" {
    let mut a: List[Result[Set[Int], Str]] = []
    let mut s: Set[Int] = Set()
    s.insert(1)
    s.insert(2)
    s.insert(3)
    a.push(Ok(s))
    let mut total = 0
    for cell in a {
        match cell {
            Ok(ss) => total = total + ss.len()
            Err(_) => assert(false)
        }
    }
    assert_eq(total, 3)
}

test "rebound List[Option[Set]] keeps the set inner across the copy" {
    let mut src: List[Option[Set[Int]]] = []
    let mut s: Set[Int] = Set()
    s.insert(10)
    s.insert(20)
    src.push(Some(s))
    let dst = src
    match dst.get(0).unwrap() {
        Some(ss) => assert_eq(ss.len(), 2)
        None => assert(false)
    }
}

test "rebound List[Result[Set, Str]] keeps the ok set across the copy" {
    let mut src: List[Result[Set[Int], Str]] = []
    let mut s: Set[Int] = Set()
    s.insert(4)
    s.insert(5)
    src.push(Ok(s))
    let dst = src
    match dst.get(0).unwrap() {
        Ok(ss) => assert_eq(ss.len(), 2)
        Err(_) => assert(false)
    }
}

test "rebound List[Map[Str, Set]] keeps the set value across the copy" {
    let mut src: List[Map[Str, Set[Int]]] = []
    let mut m: Map[Str, Set[Int]] = Map()
    let mut s: Set[Int] = Set()
    s.insert(5)
    s.insert(6)
    m.insert("xs", s)
    src.push(m)
    let dst = src
    let got = dst.get(0).unwrap()
    assert_eq(got.get("xs").unwrap().len(), 2)
}

test "an inferred Set inside a List[Option] carrier keeps its element" {
    let mut a: List[Option[Set[Int]]] = []
    let mut s = Set()
    s.insert(30)
    s.insert(40)
    s.insert(50)
    a.push(Some(s))
    for cell in a {
        match cell {
            Some(ss) => assert_eq(ss.len(), 3)
            None => assert(false)
        }
    }
}
