// br qah9tx: a struct literal in FIELD-ACCESS RECEIVER position was typed as the access
// RESULT, not as itself.
//
// tid_native_struct_inst_tid (src/codegen_expr.bl) matches cg_let_target_ann /
// cg_expect_arg_ann by BARE STRUCT NAME. br htxpmh retargeted those two channels to each
// field's own annotation across emit_struct_lit's field loop, defaults loop, and
// enum-variant ctor loop — but the FieldAccess handler in emit_expr never retargeted them
// before recursing into the receiver (`emit_expr(fa_obj)`, src/codegen_expr.bl:812). So a
// struct literal sitting in receiver position — `Box { value: Box { value: X } }.value` —
// kept the ENCLOSING let's annotation live, which names the same bare struct ("Box") one
// nesting level too high, and adopted it.
//
// ── LEDGER: measured at 1a0f961 before the fix ────────────────────────────────────────
//
//   ROW A  let n: Box[Str] = Box { value: Box { value: "z" } }.value
//            RED — hard cc error: "incompatible types when initializing type 'const char *'
//            using type 'blink_Box_Str'" / "invalid initializer". The outer literal is
//            really Box[Box[Str]] but adopted Box[Str] from the enclosing let.
//   ROW B  let n: Box[Int] = Box { value: Box { value: Box { value: 3 } } }.value.value
//            RED — hard cc error: "incompatible types when initializing type 'long int'
//            using type 'blink_Box_Box_Int'" / "request for member 'value' in something
//            not a structure or union". Three nesting levels, same defect.
//
// The two MASKED shapes at this same seam (Box[Set[Int]], Box[List[Int]] — green today only
// because the br jefm9w parity veto declines the bad adoption downstream) already have
// regression coverage in tests/test_jefm9w_parity_veto_live.bl rows B and B2; not repeated
// here.

import compile_test_helpers
import std.io

fn assert_has(c: Str, needle: Str, label: Str) {
    if !c.contains(needle) { io.println("FAIL: {label} — missing '{needle}'") }
    assert(c.contains(needle))
}

fn assert_lacks(c: Str, needle: Str, label: Str) {
    if c.contains(needle) { io.println("FAIL: {label} — forbidden '{needle}' present") }
    assert(!c.contains(needle))
}

fn box_decl() -> Str {
    "type Box[T] \{ value: T }\n"
}

// ── ROW A: two-level receiver, Str payload ────────────────────────────────────────────

fn src_row_a() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let n: Box[Str] = Box \{ value: Box \{ value: \"z\" } }.value\n")
    s = s.concat("    assert(n.value == \"z\")\n")
    s = s.concat("}\n")
    s
}

test "a struct literal in field-access-receiver position keeps its own nesting level (Str payload)" {
    let c = compile_test_helpers.compile_and_emit_c(src_row_a(), "qah9tx_rowa_c")
    assert_has(c, "blink_Box_Box_Str", "row A / outer literal named at its true nesting level")
    let r = compile_test_helpers.compile_and_run(src_row_a(), "qah9tx_rowa_run")
    if r.exit_code != 0 { io.println("FAIL: row A runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

// ── ROW B: three-level receiver chain, Int payload ────────────────────────────────────

fn src_row_b() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let n: Box[Int] = Box \{ value: Box \{ value: Box \{ value: 3 } } }.value.value\n")
    s = s.concat("    assert(n.value == 3)\n")
    s = s.concat("}\n")
    s
}

test "a struct literal in a three-level field-access-receiver chain keeps its own nesting level" {
    let c = compile_test_helpers.compile_and_emit_c(src_row_b(), "qah9tx_rowb_c")
    assert_has(c, "blink_Box_Box_Box_Int", "row B / outermost literal named at its true nesting level")
    let r = compile_test_helpers.compile_and_run(src_row_b(), "qah9tx_rowb_run")
    if r.exit_code != 0 { io.println("FAIL: row B runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}
