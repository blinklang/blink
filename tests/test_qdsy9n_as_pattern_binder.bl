// `name as pattern` binds the whole scrutinee while destructuring it, and the spec fixes the
// binder's type: "the bound name gets the pre-destructured value (scrutinee type)"
// (sections/03_types.md, Pattern Binding (`as`)).
//
// The binder's C declaration was spelled from the scrutinee's flat CT alone. Three kinds cannot be
// named that way — a carrier is only nameable WITH its inner, and a struct needs its name — so all
// three came out as a hard C error:
//
//     void config = _scrut_0;
//     error: variable or field 'config' declared void
//     error: incompatible types when initializing type 'int' using type 'blink_ServerConfig'
//
// Every row below USES the binder rather than only declaring it, because a declaration that is
// merely present proves nothing: the binder and the scrutinee must agree on a layout, and only a
// read through the binder shows that they do.
//
// Each arm yields an Int. That is deliberate and not incidental — an arm whose value IS the binder
// mistypes the match result temp on a separate seam, which would make these rows red for a reason
// that is not the binder's declaration.

type ServerConfig { port: Int, host: Str }

type Event {
    Request(req: Int)
    Idle
}

fn start_with_config(c: ServerConfig, port: Int) -> Int { c.port + port }

// ── the three kinds a bare CT cannot name ─────────────────────────────────────

test "an as-pattern over an Option scrutinee binds the whole carrier" {
    let o: Option[Int] = Some(3)
    let r = match o {
        whole as Some(v) => { if whole.is_some() { v + 10 } else { -1 } }
        None => { 0 }
    }
    assert_eq(r, 13)
}

test "an as-pattern over a Result scrutinee binds the whole carrier" {
    let e: Result[Int, Str] = Ok(4)
    let r = match e {
        whole as Ok(v) => { if whole.is_ok() { v + 20 } else { -1 } }
        Err(_) => { 0 }
    }
    assert_eq(r, 24)
}

// The Err side is a separate leaf of the same declaration, so an Ok-only fix leaves it red.
test "an as-pattern over a Result scrutinee binds the whole carrier on the Err side" {
    let e: Result[Int, Str] = Err("nope")
    let r = match e {
        Ok(_) => { 0 }
        whole as Err(_) => { if whole.is_err() { 7 } else { -1 } }
    }
    assert_eq(r, 7)
}

test "an as-pattern over a struct scrutinee binds the whole struct" {
    let cfg = ServerConfig { port: 2048, host: "h" }
    let r = match cfg {
        config as ServerConfig { port, .. } => { config.port + port }
        _ => { 0 }
    }
    assert_eq(r, 4096)
}

// ── the spec's own two examples, verbatim in shape ────────────────────────────

test "spec example: a guarded struct as-pattern passes the whole value on" {
    let cfg = ServerConfig { port: 2048, host: "h" }
    let r = match cfg {
        config as ServerConfig { port, .. } if port > 1024 => { start_with_config(config, port) }
        _ => { 0 }
    }
    assert_eq(r, 4096)
}

test "spec example: a data-enum as-pattern binds the whole event" {
    let e = Event.Request(9)
    let r = match e {
        original as Event.Request(req) => {
            match original {
                Event.Request(again) => { req + again }
                Event.Idle => { -1 }
            }
        }
        _ => { 0 }
    }
    assert_eq(r, 18)
}

// ── controls: the kinds a bare CT already named correctly ─────────────────────
//
// These passed before the fix. They are here because each is a shape the flat spelling got right,
// and a fix that changed their declaration would be the same defect mirrored.

test "an as-pattern over an Int scrutinee still binds the scalar" {
    let n = 7
    let r = match n {
        w as 7 => { w }
        _ => { 0 }
    }
    assert_eq(r, 7)
}

test "an as-pattern over a List scrutinee still binds the list" {
    let l = [1, 2, 5]
    let r = match l {
        w as [a, b, ..] => { w.len() + a + b }
        _ => { 0 }
    }
    assert_eq(r, 6)
}
