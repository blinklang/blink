// qf1vzx tp_id retirement, deep-tp reader family: the get_list_elem_*_tp readers
// (option inner, result ok/err, map key/val) must spell a STRUCT carrier inner from
// the list tid alone, with no flat-pool child fallback. The stressed shape is a
// generic body: inside `wrap_*[T]` the `out` var's tid reads back with T abstract, so
// the reader recovers the struct only through the mono binder (cg_bind_mono_tid /
// tc_tid_subst_mono). The flat pool would have carried the annotated struct name for
// free; the tid must reach the same type_struct node when the pool child is gone.
// A rebind (copy_list_compound_elem), a for-in, and a get()/unwrap readback each
// consume the deep inner, so an erased struct inner is an observable wrong readback.

type Pt { x: Int, y: Int }

// Option carrier inner read back INSIDE the mono body via rebind + get().unwrap().
fn wrap_opt[T](v: T) -> List[Option[T]] {
    let mut out: List[Option[T]] = []
    out.push(Some(v))
    let dst = out
    dst
}

// Result-ok carrier inner, mono body, rebind + get().unwrap().
fn wrap_ok[T](v: T) -> List[Result[T, Str]] {
    let mut out: List[Result[T, Str]] = []
    out.push(Ok(v))
    let dst = out
    dst
}

// Map-value carrier inner, mono body, rebind + get().unwrap().
fn wrap_val[T](v: T) -> List[Map[Str, T]] {
    let mut out: List[Map[Str, T]] = []
    let mut m: Map[Str, T] = Map()
    m.insert("k", v)
    out.push(m)
    let dst = out
    dst
}

test "generic List[Option[Struct]] carrier keeps the struct inner across the mono body" {
    let g = wrap_opt(Pt { x: 3, y: 4 })
    match g.get(0).unwrap() {
        Some(p) => {
            assert_eq(p.x, 3)
            assert_eq(p.y, 4)
        }
        None => assert(false)
    }
}

test "generic List[Result[Struct, Str]] carrier keeps the ok struct inner" {
    let g = wrap_ok(Pt { x: 7, y: 8 })
    match g.get(0).unwrap() {
        Ok(p) => {
            assert_eq(p.x, 7)
            assert_eq(p.y, 8)
        }
        Err(_) => assert(false)
    }
}

test "generic List[Map[Str, Struct]] carrier keeps the struct value inner" {
    let g = wrap_val(Pt { x: 5, y: 6 })
    let m = g.get(0).unwrap()
    let p = m.get("k").unwrap()
    assert_eq(p.x, 5)
    assert_eq(p.y, 6)
}

// for-in over the generic Option carrier reaches the struct inner (the for-in reader
// path, distinct from the get()/rebind path above).
test "for-in over generic List[Option[Struct]] reaches the struct inner" {
    let g = wrap_opt(Pt { x: 1, y: 2 })
    let mut sum = 0
    for cell in g {
        match cell {
            Some(p) => sum = sum + p.x + p.y
            None => assert(false)
        }
    }
    assert_eq(sum, 3)
}
