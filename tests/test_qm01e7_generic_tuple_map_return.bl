// qm01e7: a generic fn returning a compound type whose element is a type
// parameter — `fn wrap[T](x: T) -> (T, Int)` — must monomorphize `T` to the
// concrete argument type in BOTH the parameter and the returned tuple, for
// every carrier shape. Before the fix the return tuple left `T` un-substituted:
// a Map arg emitted `blink_Tuple2_void_int { blink_void _0; }` (hard C error),
// and Option/Result args collapsed to a bare `wrap_Option` mangling with the
// inner type defaulted to Int (silently wrong for non-Int inners).

fn wrap[T](x: T) -> (T, Int) { (x, 1) }

fn main() {
    // Uniform-carrier compound (Map erases to blink_map*): compiles + runs.
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 41)
    let tm = wrap(m)
    assert(tm.1 == 1, "map tuple tag")
    assert(tm.0.get("a").unwrap() == 41, "map element usable")

    // Parameterized carrier, scalar inner.
    let oi: Option[Int] = Some(5)
    let toi = wrap(oi)
    assert(toi.0.unwrap() == 5, "option[int] element usable")

    // Parameterized carrier, non-Int inner — proves per-inner mono keys.
    let os: Option[Str] = Some("hi")
    let tos = wrap(os)
    assert(tos.0.unwrap() == "hi", "option[str] element usable")

    let r: Result[Int, Str] = Ok(9)
    let tr = wrap(r)
    assert(tr.0.unwrap() == 9, "result element usable")

    // Display-able element resolves at codegen and renders its real value.
    let ti = wrap(7)
    assert(ti.0 == 7, "int element resolves")

    io.println("ok")
}
