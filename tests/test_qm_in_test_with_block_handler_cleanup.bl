// Subprocess + side-file pattern: ? propagation makes the inner test fail
// (inner binary exits non-zero). We can't observe that in-process, so
// Timer.exit() flushes its observation to a file before the runner exits;
// the outer test reads the file and asserts the cleanup ran.

test "? inside with-block runs BlockHandler.exit(false) before failing the test" {
    let src = "let mut log: List[Str] = []\n"
              .concat("fn flush_log() \{\n")
              .concat("    let mut s = \"\"\n")
              .concat("    let mut i = 0\n")
              .concat("    while i < log.len() \{\n")
              .concat("        s = s.concat(log.get(i).unwrap()).concat(\"\\n\")\n")
              .concat("        i = i + 1\n")
              .concat("    }\n")
              .concat("    write_file(\".tmp/_qm_with_log.txt\", s)\n")
              .concat("}\n")
              .concat("type Timer \{ id: Int }\n")
              .concat("impl BlockHandler for Timer \{\n")
              .concat("    type Context = Int\n")
              .concat("    fn enter(self) -> Int \{ log.push(\"enter:\".concat(self.id.to_string())) 0 }\n")
              .concat("    fn exit(self, ok: Bool) \{\n")
              .concat("        if ok \{ log.push(\"exit:\".concat(self.id.to_string()).concat(\":ok=true\")) }\n")
              .concat("        else \{ log.push(\"exit:\".concat(self.id.to_string()).concat(\":ok=false\")) }\n")
              .concat("        flush_log()\n")
              .concat("    }\n")
              .concat("}\n")
              .concat("fn fail() -> Result[Int, Str] \{ Err(\"boom\") }\n")
              .concat("test \"qm_in_with\" \{\n")
              .concat("    with Timer \{ id: 9 } as _t \{\n")
              .concat("        let _v = fail()?\n")
              .concat("    }\n")
              .concat("}\n")

    shell_exec("rm -f .tmp/_qm_with_log.txt")
    write_file(".tmp/_test_qm_with_inner.bl", src)
    let build_res = process_run("build/blink", ["build", ".tmp/_test_qm_with_inner.bl"])
    assert_eq(build_res.exit_code, 0)

    // Inner binary will exit 1 (test failed via ?), but BEFORE exit, the
    // Timer.exit() must run with ok=false and flush the log.
    let _ = process_run("build/_test_qm_with_inner", [])

    let log = read_file(".tmp/_qm_with_log.txt")
    assert(log.contains("enter:9"))
    assert(log.contains("exit:9:ok=false"))

    shell_exec("rm -f build/_test_qm_with_inner .tmp/_test_qm_with_inner.bl .tmp/_qm_with_log.txt")
}
