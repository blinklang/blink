// The `?`-on-Result propagation arm spells the enclosing function's return carrier C
// type (the early-return cast `return (blink_Result_..){.tag=1,.err=..}`) from the
// return kind. It read that kind off the flat tp children (tp_child1_kind /
// tp_child2_kind on the return's tp_id); this converges it onto the return tid via
// tc_tid_result_ok_ct / tc_tid_result_err_ct, with the flat read kept only as the
// no-tid fallback. A List-ok side carries no struct name, so the kind alone spells
// `blink_Result_list_str` — the case where the channel is load-bearing rather than
// masked by a struct-inner name. The arena variant exercises the depth>0 branch,
// which spells the same carrier for its unwind cast.

fn src_list() -> Result[List[Int], Str] { Ok([10, 20, 30]) }
fn src_int() -> Result[Int, Str] { Ok(7) }

fn take_list() -> Result[List[Int], Str] {
    let xs = src_list()?
    Ok(xs)
}

fn take_int_arena() -> Result[Int, Str] {
    let v = with arena { src_int()? }
    Ok(v + 1)
}

test "a ?-propagated List-ok Result keeps its list carrier through the return cast" {
    match take_list() {
        Ok(xs) => {
            assert_eq(xs.len(), 3)
            assert_eq(xs.get(2).unwrap(), 30)
        }
        Err(_e) => assert_eq(1, 0)
    }
}

test "a ?-propagated Result inside an arena expr keeps its return carrier" {
    match take_int_arena() {
        Ok(v) => assert_eq(v, 8)
        Err(_e) => assert_eq(1, 0)
    }
}
