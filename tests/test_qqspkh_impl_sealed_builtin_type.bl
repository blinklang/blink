// qqspkh — a sealed built-in TYPE named in the trait position of an impl
// (`impl Iterator[T] for Foo`) must report E0907 "sealed built-in ... cannot be
// implemented", NOT E0904 "trait 'Iterator' is not defined". Iterator is a sealed
// opaque built-in type (§3c.1:38 — "a built-in, sealed, opaque type, not a
// user-implementable trait"); the collections Str/List/Map/Set/Bytes/Range are
// likewise closed (§3c.1:38 — "the type is closed, exactly as Str and List are
// closed"). Before qqspkh, Iterator fell out of tc_trait_names and hit the E0904
// undefined-trait arm, whose help wrongly told the user to `define trait Iterator {}`.

import compile_test_helpers

test "impl Iterator for a user type -> E0907, not E0904" {
    let src = "type Foo \{ x: Int }\nimpl Iterator[Int] for Foo \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "qqspkh_impl_iterator", "E0907")
}

test "impl Iterator does not misfire the E0904 undefined-trait diagnostic" {
    let src = "type Foo \{ x: Int }\nimpl Iterator[Int] for Foo \{}\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "qqspkh_no_e0904")
    assert(!out.contains("E0904"))
}

test "impl List for a user type -> E0907 (closed built-in type)" {
    let src = "type Foo \{ x: Int }\nimpl List[Int] for Foo \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "qqspkh_impl_list", "E0907")
}

test "impl Str for a user type -> E0907 (closed built-in type)" {
    let src = "type Foo \{ x: Int }\nimpl Str for Foo \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "qqspkh_impl_str", "E0907")
}

// StringBuilder is a prelude-level compiler-known sealed type (§3c.4:737), on
// the same footing as Str/List/Map/Set — it must route to E0907, not E0904.
test "impl StringBuilder for a user type -> E0907 (closed built-in type)" {
    let src = "type Foo \{ x: Int }\nimpl StringBuilder for Foo \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "qqspkh_impl_stringbuilder", "E0907")
}

// control: a genuinely undefined trait name still reports E0904 (unchanged).
test "impl of a truly undefined trait still reports E0904" {
    let src = "type Foo \{ x: Int }\nimpl Bogus for Foo \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "qqspkh_undefined_trait", "E0904")
}
