// A user enum may declare a variant spelled like a prelude carrier's (`None`, `Ok`). The
// qualified carrier spelling still names the carrier, with or without an expected type, and
// it is the repair AmbiguousConstruction (E0519) names for an unhinted bare `None`.

type Mode { None, Fast }
type Outcome { Ok(n: Int), Err(msg: Str) }

fn mode_label(m: Mode) -> Str {
    match m {
        Mode.None => "mode-none"
        Mode.Fast => "mode-fast"
    }
}

fn take_opt(o: Option[Int]) -> Int { o ?? -1 }

fn opt_label(o: Option[Int]) -> Str {
    match o {
        Option.Some(v) => "some {v}"
        Option.None => "none"
    }
}

fn res_label(r: Result[Int, Str]) -> Str {
    match r {
        Result.Ok(v) => "ok {v}"
        Result.Err(e) => "err {e}"
    }
}

test "the qualified carrier is unchanged by a user enum that declares None or Ok" {
    let n: Option[Int] = Option.None
    assert_eq(n, None)
    let un = Option.None
    let _keep: Option[Str] = un
    assert(un.is_none())
    let m = Mode.None
    assert_eq(mode_label(m), "mode-none")
    let r = Result.Ok(1)
    let _r: Result[Int, Str] = r
    assert_eq(r.unwrap(), 1)
    let o = Outcome.Ok(2)
    match o {
        Outcome.Ok(v) => assert_eq(v, 2)
        Outcome.Err(_) => assert(false)
    }
    assert_eq(take_opt(Option.Some(8)), 8)
}

test "qualified carrier patterns beside user namesake variants" {
    assert_eq(opt_label(Option.Some(1)), "some 1")
    assert_eq(opt_label(Option.None), "none")
    assert_eq(res_label(Result.Ok(2)), "ok 2")
    assert_eq(res_label(Result.Err("x")), "err x")
}
