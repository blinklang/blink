// `Option.Some(x)`, `Option.None`, `Result.Ok(x)` and `Result.Err(e)` are the qualified
// spellings of the prelude carrier variants (sections/03_types.md §3.4). Each one builds the
// same value as the bare spelling, in every value position, and the qualified patterns match
// as the bare ones do.

fn opt_tail(n: Int) -> Option[Int] {
    if n > 0 { return Option.Some(n) }
    Option.None
}

fn res_tail(n: Int) -> Result[Int, Str] {
    if n > 0 { return Result.Ok(n) }
    Result.Err("neg")
}

fn take_opt(o: Option[Int]) -> Int { o ?? -1 }

fn take_res(r: Result[Int, Str]) -> Str {
    match r {
        Ok(v) => "ok {v}"
        Err(e) => "err {e}"
    }
}

fn opt_label(o: Option[Int]) -> Str {
    match o {
        Option.Some(v) => "some {v}"
        Option.None => "none"
    }
}

fn res_label(r: Result[Int, Str]) -> Str {
    match r {
        Result.Ok(v) => "ok {v}"
        Result.Err(e) => "err {e}"
    }
}

test "qualified construction under an annotation equals the bare form" {
    let a: Option[Int] = Option.Some(1)
    let b: Result[Int, Str] = Result.Ok(1)
    let c: Option[Int] = Option.None
    let d: Result[Int, Str] = Result.Err("x")
    let ba: Option[Int] = Some(1)
    let bb: Result[Int, Str] = Ok(1)
    let bc: Option[Int] = None
    let bd: Result[Int, Str] = Err("x")
    assert_eq(a, ba)
    assert_eq(b, bb)
    assert_eq(c, bc)
    assert_eq(d, bd)
}

test "qualified construction with no annotation infers as the bare form does" {
    let a = Option.Some(2)
    assert_eq(a.unwrap(), 2)
    let s = Option.Some("txt")
    assert_eq(s.unwrap(), "txt")
    let mut later = Option.None
    later = Some(7)
    assert_eq(later, Some(7))
    let r = Result.Ok(3)
    let _e: Result[Int, Str] = r
    assert_eq(r, Ok(3))
}

test "qualified construction as a call argument" {
    assert_eq(take_opt(Option.Some(4)), take_opt(Some(4)))
    assert_eq(take_opt(Option.None), take_opt(None))
    assert_eq(take_res(Result.Ok(5)), take_res(Ok(5)))
    assert_eq(take_res(Result.Err("bad")), take_res(Err("bad")))
}

test "qualified construction as a return and a tail" {
    assert_eq(opt_tail(3), Some(3))
    assert_eq(opt_tail(0), None)
    assert_eq(res_tail(3), Ok(3))
    assert_eq(res_tail(0), Err("neg"))
}

test "qualified construction as a match arm value" {
    let pick = fn(n: Int) -> Option[Int] {
        match n {
            0 => Option.None
            _ => Option.Some(n * 10)
        }
    }
    assert_eq(pick(0), None)
    assert_eq(pick(2), Some(20))
    let x: Result[Int, Str] = match 1 {
        1 => Result.Ok(1)
        _ => Result.Err("no")
    }
    assert_eq(x, Ok(1))
}

test "qualified construction as a ?? default" {
    let none: Option[Option[Int]] = None
    let o: Option[Int] = none ?? Option.Some(9)
    assert_eq(o, Some(9))
    let p: Option[Option[Int]] = Some(Some(1))
    assert_eq(p ?? Option.None, Some(1))
    assert_eq(none ?? Option.None, None)
}

test "qualified construction inside a closure" {
    let wrap = fn(n: Int) -> Option[Int] { Option.Some(n) }
    let fail = fn(m: Str) -> Result[Int, Str] { Result.Err(m) }
    assert_eq(wrap(6), Some(6))
    assert_eq(fail("c"), Err("c"))
    let xs = [1, 2, 3].map(fn(n) { Option.Some(n + 1) })
    assert_eq(xs.get(0).unwrap(), Some(2))
}

test "qualified patterns match as the bare patterns do" {
    assert_eq(opt_label(Some(1)), "some 1")
    assert_eq(opt_label(None), "none")
    assert_eq(opt_label(Option.Some(2)), "some 2")
    assert_eq(res_label(Ok(3)), "ok 3")
    assert_eq(res_label(Err("e")), "err e")
    assert_eq(res_label(Result.Err("q")), "err q")
}

test "qualified construction as a comparison operand takes the other side's type" {
    let o: Option[Int] = None
    assert(o == Option.None)
    assert(Option.None == o)
    assert(Option.Some(2) != o)
    let r: Result[Int, Str] = Ok(1)
    assert(r == Result.Ok(1))
    assert(Result.Err("x") != r)
}

type Slots { v: Option[Int], r: Result[Str, Str] }

test "qualified construction in a list, a struct field and an if arm" {
    let xs = [Option.Some(1), Option.None, Some(3)]
    assert_eq(xs, [Some(1), None, Some(3)])
    let s = Slots { v: Option.None, r: Result.Ok("y") }
    assert(s.v.is_none())
    assert_eq(s.r, Ok("y"))
    let c = if xs.len() > 2 { Option.Some(5) } else { Option.None }
    assert_eq(c, Some(5))
    let nested: Result[Option[Int], Str] = Result.Ok(Option.Some(4))
    assert_eq(nested, Ok(Some(4)))
    let unit: Result[Void, Str] = Result.Ok()
    assert(unit.is_ok())
}
