// A tuple element typed as a generic struct instantiated with a QUALIFIED cross-module
// monomorphic type argument (`qualified_cross_module_monomorphic_tuple_element_geo.KngPoint`, not a type parameter) must keep the
// generic struct's own name in the tuple's element mono name, not erase to the bare
// argument type. Staged as its own helper module since the shape is cross-module and
// cannot be expressed as a single embedded program.

import std.path.{path_join}
import compile_test_helpers

fn blink_bin_path() -> Str {
    let root = env.var("BLINK_ROOT") ?? ""
    if root != "" {
        let p = path_join(root, "build/blink")
        if file_exists(p) == 1 {
            return p
        }
    }
    "build/blink"
}

test "qualified cross-module monomorphic arg in a generic-struct tuple element keeps the wrapper's shape" {
    let root = "{compile_test_helpers.scratch_root()}/_qualified_cross_module_monomorphic_tuple_element"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", src_dir])?
    write_file("{root}/blink.toml", "[package]\nname = \"kngxmod\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/qualified_cross_module_monomorphic_tuple_element_geo.bl", "pub type KngPoint \{ x: Int, y: Int \}\n")
    let entry_path = "{src_dir}/main.bl"
    write_file(entry_path, "import qualified_cross_module_monomorphic_tuple_element_geo\n\ntype KngLocBox[T] \{ value: T \}\nfn kng_take(t: (KngLocBox[qualified_cross_module_monomorphic_tuple_element_geo.KngPoint], Int)) -> Int \{ t.1 \}\n\nfn main() \{\n    let b: KngLocBox[qualified_cross_module_monomorphic_tuple_element_geo.KngPoint] = KngLocBox \{ value: qualified_cross_module_monomorphic_tuple_element_geo.KngPoint \{ x: 1, y: 2 \} \}\n    let t: (KngLocBox[qualified_cross_module_monomorphic_tuple_element_geo.KngPoint], Int) = (b, 42)\n    assert_eq(kng_take(t), 42)\n\}\n")
    // Without -o every main.bl builds to build/main, which a parallel run of another test overwrites.
    let r = process.run(blink_bin_path(), ["run", entry_path, "-o", "{root}/main_bin"])?
    assert(r.success(), "compile or run failed: {r.out}{r.err_out}")
}
