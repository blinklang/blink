// `Display.display(x)` is the qualified spelling of `x.display()` (§3c "Qualified Method
// Calls"). No impl writes `display`: Display seals it over the user's `fmt`, so the qualified
// form has to reach the same synthesized rendering the dotted form reaches, for a concrete
// receiver and for a type parameter bounded by Display.
//
// Each row prints both spellings side by side, so a qualified call that builds, but renders
// something other than the dotted call, fails on the output.

import compile_test_helpers
import std.io

fn run_ok(src: Str, tag: Str) -> Str {
    let r = compile_test_helpers.compile_and_run(src, tag)
    if r.exit_code != 0 { io.println("FAIL: {tag} — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
    r.out.trim()
}

fn types_decl() -> Str {
    #"type Pt { x: Int }
impl Display for Pt {
    fn fmt(self, sb: StringBuilder) { sb.write("pt{self.x}") }
}
type Color { Red, Green }
impl Display for Color {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Red => sb.write("red")
            Green => sb.write("green")
        }
    }
}
"#
}

test "a qualified display on a struct renders through its fmt" {
    let src = types_decl().concat(#"
fn main() {
    let p = Pt { x: 7 }
    let s = Display.display(p)
    io.println("q={s} hole={Display.display(p)} dot={p.display()}")
}
"#)
    assert_eq(run_ok(src, "qdisp_struct"), "q=pt7 hole=pt7 dot=pt7")
}

test "a qualified display on an enum renders through its fmt" {
    let src = types_decl().concat(#"
fn main() {
    let c = Color.Green
    io.println("q={Display.display(c)} dot={c.display()}")
}
"#)
    assert_eq(run_ok(src, "qdisp_enum"), "q=green dot=green")
}

// Two instances of one generic body: each has to reach its own type's fmt.
test "a qualified display through a Display bound renders per instance" {
    let src = types_decl().concat(#"
fn show[T: Display](v: T) -> Str { Display.display(v) }
fn main() {
    io.println("s={show(Pt { x: 3 })} e={show(Color.Red)}")
}
"#)
    assert_eq(run_ok(src, "qdisp_bound"), "s=pt3 e=red")
}

test "the qualified result is a Str equal to the dotted one" {
    let src = types_decl().concat(#"
fn main() {
    let p = Pt { x: 42 }
    let q = Display.display(p)
    io.println("len={q.len()} same={q == p.display()}")
}
"#)
    assert_eq(run_ok(src, "qdisp_str_value"), "len=4 same=true")
}

// A second trait over the same type also declares `display`. The qualifier names which one
// is meant, so each spelling has to reach its own trait's method and not the other one.
test "the Display qualifier picks the sealed display over another trait's display" {
    let src = types_decl().concat(#"
trait Named {
    fn display(self) -> Str
}
impl Named for Pt {
    fn display(self) -> Str { "named" }
}
fn main() {
    let p = Pt { x: 5 }
    io.println("d={Display.display(p)} n={Named.display(p)}")
}
"#)
    assert_eq(run_ok(src, "qdisp_other_trait"), "d=pt5 n=named")
}
