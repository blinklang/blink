// A QUALIFIED struct-style variant literal on a generic enum (Choice.First { value: T })
// must register the same mono instance as the bare spelling, not erase to the bare base
// generic name.

type Choice[T] { First { value: T }, Second { tag: Int } }

test "qualified struct-style literal on a generic enum monomorphizes with Int payload" {
    let c = Choice.First { value: 7 }
    match c {
        First { value } => assert_eq(value, 7)
        Second { tag: _tag } => assert(false)
    }
}

test "qualified struct-style literal on a generic enum monomorphizes with Str payload" {
    let c: Choice[Str] = Choice.First { value: "hi" }
    match c {
        First { value } => assert_eq(value, "hi")
        Second { tag: _tag } => assert(false)
    }
}
