// qualified `testing.skip(reason)` must behave as the test-skip
// intrinsic, exactly like the bare `skip(reason)` form. Before the fix the
// qualified call routed through the module-qualified path and emitted a plain
// call to the NO-OP stdlib `pub fn skip` — so the skip was swallowed, the
// following assert ran, and the test reported `failed` instead of `skipped`.

import compile_test_helpers

test "qualified testing.skip() produces status=skipped with reason" {
    let src = "import std.testing\ntest \"x\" \{ testing.skip(\"not ready yet\")\n  assert_eq(1, 2)\n \}\n"
    write_file("{compile_test_helpers.scratch_root()}/_test_qualified_testing_skip_qskip.bl", src)

    let build_res = process_run("build/blink", ["__test-build", "{compile_test_helpers.scratch_root()}/_test_qualified_testing_skip_qskip.bl"])
    assert_eq(build_res.exit_code, 0)

    let run = process_run("build/_test_qualified_testing_skip_qskip", ["--test-json"])
    assert(run.out.contains("\"status\":\"skipped\""))
    assert(run.out.contains("\"reason\":\"not ready yet\""))
    // The assert_eq after the qualified skip must NOT have executed.
    assert(!run.out.contains("\"status\":\"failed\""))

    shell_exec("rm -f build/_test_qualified_testing_skip_qskip {compile_test_helpers.scratch_root()}/_test_qualified_testing_skip_qskip.bl")
}
