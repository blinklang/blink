// a qualified variant constructor `Enum.Variant(...)` called with the
// wrong number of arguments must be rejected at typecheck (E0300), mirroring the
// bare-Ident variant path. The qualified-construction guard in
// infer_type's MethodCall handling type-checked each argument value but never
// compared the argument COUNT to the variant's field count, so `Sig.Term(99)`
// (Term has 0 fields) was silently accepted.

import compile_test_helpers

test "qualified zero-field variant given an arg is a typecheck error" {
    let src = "type Sig \{ Term, Kill \}\npub fn main() \{ let _ = Sig.Term(99) \}\n"
    compile_test_helpers.expect_compile_error(src, "qualified_variant_arity_over", "E0300")
}

test "qualified variant over-arity error names the variant and counts" {
    let src = "type Sig \{ Term, Kill \}\npub fn main() \{ let _ = Sig.Term(99) \}\n"
    let out = compile_test_helpers.compile_and_capture(src, "qualified_variant_arity_over_msg")
    compile_test_helpers.expect_contains(out, "variant `Term` expects 0 argument(s), got 1", "qualified_variant_arity_over_msg")
}

test "qualified data variant under-arity is a typecheck error" {
    let src = "type E \{ A(Int), B \}\npub fn main() \{ let _ = E.A() \}\n"
    compile_test_helpers.expect_compile_error(src, "qualified_variant_arity_under", "E0300")
}

test "qualified data variant correct arity compiles clean" {
    let src = "type E \{ A(Int), B \}\npub fn main() \{ let _ = E.A(1) \}\n"
    compile_test_helpers.expect_no_error(src, "qualified_variant_arity_ok", "E0300")
}
