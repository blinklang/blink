// Phase 1.2 (tid-sole-authority): a qualified enum-variant constructor
// call `Enum.Variant(name: val)` looked its field type up with
// lookup_evfield_type_by_name / _by_index, which return -1 for a field the
// variant does not declare. check_arg_value then compared the argument against
// -1, and types_compatible failed OPEN on -1, so a misspelled field name was
// silently accepted. The -1 must never escape as an answer: a named-arg miss is
// E0525 NoSuchField.
//
// RED before the guard: `Shape.Circle(diameter: 5.0)` produced no diagnostic.

import compile_test_helpers

// ── named-arg miss on a tuple-with-label variant → E0525 ────────────────────

test "misspelled named field on a qualified tuple variant ctor errors E0525" {
    let src = "type Shape \{ Circle(radius: Float) }\nfn main() \{\n    let _ = Shape.Circle(diameter: 5.0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "a2_tuple_variant_field_miss", "E0525")
}

// ── named-arg miss on a struct-style variant → E0525 ────────────────────────

test "misspelled named field on a qualified struct-style variant ctor errors E0525" {
    let src = "type Msg \{ Rich \{ code: Int, message: Str } }\nfn main() \{\n    let _ = Msg.Rich(codex: 1, message: \"x\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "a2_struct_variant_field_miss", "E0525")
}

// ── the correct field name is the repair (must NOT error) ───────────────────

test "correct named field on a qualified tuple variant ctor does not error" {
    let src = "type Shape \{ Circle(radius: Float) }\nfn main() \{\n    let _ = Shape.Circle(radius: 5.0)\n}\n"
    compile_test_helpers.expect_no_error(src, "a2_tuple_variant_field_ok", "E0525")
}

test "correct named fields on a qualified struct-style variant ctor do not error" {
    let src = "type Msg \{ Rich \{ code: Int, message: Str } }\nfn main() \{\n    let _ = Msg.Rich(code: 1, message: \"x\")\n}\n"
    compile_test_helpers.expect_no_error(src, "a2_struct_variant_field_ok", "E0525")
}
