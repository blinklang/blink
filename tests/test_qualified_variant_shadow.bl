// 8v0cpr: a variant name can shadow an enum type name in qualified construction.
// `Key.Char(ch:'a')` where `Key` is both an enum type AND a variant of `Event`
// must resolve `Key` as the type (so `.Char` resolves), not as the shadowing
// variant of `Event`. This is a pure typecheck-phase bug; codegen already
// handles qualified variant construction. Spec: sections/03_types.md §3.4.

import compile_test_helpers

// Case 1 — MVCE: variant name `Key` shadows enum type `Key`. Qualified
// construction `Key.Char(ch:'a')` must NOT emit UnresolvedMethod (E0505).
test "shadowed enum type resolves in qualified construction" {
    let src = "type Key \{ Char(ch: Char) }\ntype Event \{ Key(key: Key) }\nfn main() \{ let _k = Key.Char(ch: 'a') }\n"
    compile_test_helpers.expect_no_error(src, "shadow_mvce_8v0cpr", "E0505")
}

// Case 2 — the outer (shadowing) variant still constructs: `Event.Key(...)`
// with a nested shadowed-type construction as its payload.
test "outer shadowing variant still constructs with nested payload" {
    let src = "type Key \{ Char(ch: Char) }\ntype Event \{ Key(key: Key) }\nfn main() \{ let _e = Event.Key(key: Key.Char(ch: 'a')) }\n"
    compile_test_helpers.expect_no_error(src, "shadow_outer_8v0cpr", "E0505")
}

// Case 3 — non-shadowed qualified construction is unaffected.
test "non-shadowed qualified construction still works" {
    let src = "type Shape \{ Circle(r: Float) }\nfn main() \{ let _s = Shape.Circle(r: 1.0) }\n"
    compile_test_helpers.expect_no_error(src, "shadow_unshadowed_8v0cpr", "E0505")
}

// Case 4 (not over-broad) — the new fast path also type-checks payload args.
// A wrong-typed payload to the inner qualified construction must be rejected,
// proving the guard validates args rather than blindly returning the enum tid.
test "qualified variant construction type-checks payload args" {
    let src = "type Key \{ Char(ch: Char) }\ntype Event \{ Key(key: Key) }\nfn main() \{ let _k = Key.Char(ch: 42) }\n"
    let output = compile_test_helpers.compile_and_capture(src, "shadow_argtype_8v0cpr")
    assert(output.contains("expects Char"))
}
