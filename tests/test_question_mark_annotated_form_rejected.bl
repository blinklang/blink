// Spec §2.20: explicit return annotation on a test block is forbidden.
// The parser detects the `-> Type` after the test name, consumes and
// discards the annotation (recovery), and emits E0515 directly. This
// test pins that surface-syntax contract.

test "test block with -> Result annotation is rejected" {
    let src = "test \"x\" -> Result[Void, Str] \{ let _ = 1 \}\n"
    write_file(".tmp/_test_annotated_test_block.bl", src)
    let args = [".tmp/_test_annotated_test_block.bl", "/dev/null", "--format", "json"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    // Parser rejection: E0515 on the `-> Type` after the test name.
    assert(output.contains("E0515"))
    assert(output.contains("AnnotatedTestReturnTypeRejected"))
    shell_exec("rm -f .tmp/_test_annotated_test_block.bl")
}
