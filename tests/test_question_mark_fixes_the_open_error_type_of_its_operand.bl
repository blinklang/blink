// `?` propagates its operand's error to the enclosing function unchanged, so the operand's
// error type is the enclosing return type's (sections/03_types.md §3.4 *What pins `E`*: "a `?`
// in a context whose error type it must match"; sections/04_effects.md: propagation is exact).
// An `Ok(x)?` whose own error slot nothing else fixes takes that type and runs.

type Box[T] { v: List[T] }

fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }

fn boxed() -> Result[Box[Int], Str] {
    let b: Box[Int] = Ok(mk([]))?
    Ok(b)
}

fn bump(x: Int) -> Result[Int, Str] {
    let y = Ok(x)?
    Ok(y + 1)
}

fn first_err(x: Int) -> Result[Int, Str] {
    let y = Ok(x)?
    if y > 2 { return Err("big") }
    Ok(y)
}

// A type parameter of the enclosing declaration is the error type each instance propagates.
fn lift[E](x: Int) -> Result[Int, E] {
    let y = Ok(x)?
    Ok(y * 2)
}

test "the error slot of Ok(x)? takes the enclosing return's error type" {
    match boxed() {
        Ok(b) => assert_eq(b.v.len(), 0)
        Err(e) => assert_eq(e, "unreachable")
    }
    assert_eq(bump(4).unwrap(), 5)
}

test "an Ok(x)? beside a later Err of the same function runs both paths" {
    assert_eq(first_err(1).unwrap(), 1)
    match first_err(5) {
        Ok(_) => assert(false)
        Err(e) => assert_eq(e, "big")
    }
}

test "the error slot of Ok(x)? in a generic function is the function's own parameter" {
    let r: Result[Int, Str] = lift(3)
    assert_eq(r.unwrap(), 6)
}
