// Spec §3c.2: closures do not inherit test-body elaboration.
// `?` inside a fn-literal passed to a HOF must be gated against the
// closure's own (Void) return type, not the surrounding test block's
// implicit Result[Void, TestError].

test "? inside closure body inside test is rejected" {
    let src = "fn fail() -> Result[Int, Str] \{ Err(\"boom\") \}\n"
              .concat("test \"x\" \{\n")
              .concat("    [1, 2].for_each(fn(_x: Int) \{ let _ = fail()? \})\n")
              .concat("\}\n")
    write_file(".tmp/_test_qm_closure.bl", src)
    let args = [".tmp/_test_qm_closure.bl", "/dev/null", "--format", "json"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    assert(output.contains("QuestionMarkResultInNonResult"))
    shell_exec("rm -f .tmp/_test_qm_closure.bl")
}
