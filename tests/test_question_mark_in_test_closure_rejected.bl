// Spec §3c.2: closures do not inherit test-body elaboration.
// `?` inside a fn-literal passed to a HOF must be gated against the
// closure's own (Void) return type, not the surrounding test block's
// implicit Result[Void, TestError].
//
// Stays green independently of the closure own-return-type fix: fail()'s
// error type is Str, which implements Display, so the tc_in_test_body branch still wins
// over the closure's own (Void) return — the two mechanisms don't collide here.

import compile_test_helpers

test "? inside closure body inside test is rejected" {
    let src = "fn fail() -> Result[Int, Str] \{ Err(\"boom\") \}\n"
              .concat("test \"x\" \{\n")
              .concat("    [1, 2].for_each(fn(_x: Int) \{ let _ = fail()? \})\n")
              .concat("\}\n")
    write_file("{compile_test_helpers.scratch_root()}/_test_qm_closure.bl", src)
    let args = ["{compile_test_helpers.scratch_root()}/_test_qm_closure.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(output.contains("QuestionMarkResultInNonResult"))
    shell_exec("rm -f {compile_test_helpers.scratch_root()}/_test_qm_closure.bl")
}
