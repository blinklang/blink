// Spec §2.20 / §3c.2: when `?` propagates a custom error in a test body, the
// runner renders it via the synthesized Display.display(e) — NOT a placeholder.
// Regression for the codegen gap where struct err types emitted "<MyErr>"
// instead of calling {T}_display (the comment said "until Display lands";
// Display landed in 4q2etk). Compile a failing test as a subprocess and assert
// the runner's NDJSON carries the custom Display text, not the placeholder.

test "? in test body renders custom Display, not placeholder" {
    let src = "type MyErr \{ code: Int }\n"
              .concat("impl Display for MyErr \{\n")
              .concat("    fn fmt(self, sb: StringBuilder) \{ sb.write(\"MyErr(code=\{self.code})\") }\n")
              .concat("}\n")
              .concat("fn boom() -> Result[Int, MyErr] \{ Err(MyErr \{ code: 7 }) }\n")
              .concat("test \"propagates\" \{\n")
              .concat("    let _n = boom()?\n")
              .concat("}\n")
    write_file(".tmp/_test_qm_display_rendered.bl", src)
    let result = process_run("build/blink", ["test", ".tmp/_test_qm_display_rendered.bl"])
    let output = "{result.out}{result.err_out}"
    assert(output.contains("MyErr(code=7)"))
    assert(output.contains("<MyErr>") == false)
    shell_exec("rm -f .tmp/_test_qm_display_rendered.bl")
}
