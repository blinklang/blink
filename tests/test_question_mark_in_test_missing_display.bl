// E0514 (5q5jwz/wbf74w): `?` in a test body on Result[T, E] where E has no
// `impl Display` must be rejected — the error path renders E via
// Display.display(e) into a TestError, so Display[E] is required at the ? site.

test "? in test body on non-Display error type emits E0514" {
    let src = "type MyErr \{ msg: Str \}\n"
              .concat("fn fallible() -> Result[Int, MyErr] \{ Err(MyErr \{ msg: \"boom\" \}) \}\n")
              .concat("test \"x\" \{\n")
              .concat("    let _n = fallible()?\n")
              .concat("\}\n")
    write_file(".tmp/_test_qm_missing_display.bl", src)
    let args = [".tmp/_test_qm_missing_display.bl", "/dev/null", "--format", "json"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    assert(output.contains("QuestionMarkTestDisplayRequired"))
    shell_exec("rm -f .tmp/_test_qm_missing_display.bl")
}
