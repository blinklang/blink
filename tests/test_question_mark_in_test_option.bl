// Spec §2.20: `?` on Option[T] in a test body renders a fixed "None"
// message and imposes NO Display requirement on the inner type. NoDisplay
// has no `impl Display`, yet this must compile and run cleanly — proving
// the Option path never gates on Display (only the Result path emits E0514).

type NoDisplay {
    n: Int
}

fn maybe(found: Bool) -> Option[NoDisplay] {
    if found {
        Some(NoDisplay { n: 99 })
    } else {
        None
    }
}

test "? on Option[NoDisplay] in test body needs no Display" {
    let v = maybe(true)?
    assert_eq(v.n, 99)
}
