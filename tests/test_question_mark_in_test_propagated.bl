// Spec §2.20: `?` in a test body propagates an Err whose error type IS
// Display. Str is a builtin-Display scalar, so this must compile and the
// E0514 gate must NOT fire. Subprocess-build the source and assert exit 0.

import compile_test_helpers

test "? on Result[Int, Str] in test body compiles (Str is Display)" {
    let src = "fn fallible() -> Result[Int, Str] \{ Ok(7) \}\n"
              .concat("test \"propagate\" \{\n")
              .concat("    let n = fallible()?\n")
              .concat("    assert_eq(n, 7)\n")
              .concat("\}\n")
    write_file("{compile_test_helpers.scratch_root()}/_test_qm_propagated.bl", src)
    let args = ["--test-build", "{compile_test_helpers.scratch_root()}/_test_qm_propagated.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    assert_eq(result.exit_code, 0)
    shell_exec("rm -f {compile_test_helpers.scratch_root()}/_test_qm_propagated.bl")
}
