type Cmd {
    Quit
    Continue
}

fn wrap[T](_x: T) -> Option[Cmd] {
    Some(Quit)
}

fn wrap_none[T](_x: T) -> Option[Cmd] {
    None
}

test "generic fn returning Option[enum] with Some" {
    let r = wrap(42)
    let matched = match r {
        Some(Cmd.Quit) => 1
        _ => 0
    }
    assert_eq(matched, 1)
}

test "generic fn returning Option[enum] with None" {
    let r = wrap_none("hi")
    assert_eq(r.is_none(), 1)
}

test "generic fn returning Option[enum] unwrap" {
    let r = wrap(1)
    let matched = match r.unwrap() {
        Quit => 1
        _ => 0
    }
    assert_eq(matched, 1)
}
