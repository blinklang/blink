// br qw7v90 + 2bh76q negative guard: the soundness hole the epic closes.
//
// Before increments A (types_compatible nominal eq by name+params) and B
// (StructLit reverse-inference of the concrete instance tid), every generic
// struct instantiation shared the single bare `Box` tid. Passing a Box[Str]
// literal where a Box[Int] parameter is expected type-checked CLEAN and leaked a
// mistype straight to the C compiler (int-from-pointer). A programming language
// must reject this at type-check time with a proper E0300, never at gcc.
//
// RED before this increment: expect_compile_error fails because no E0300 is
// emitted (the program compiles). GREEN after: the concrete-vs-concrete mismatch
// is caught with a TypeError.

import compile_test_helpers

test "Box[Str] literal into Box[Int] parameter is rejected (E0300)" {
    let src = "type Box[T] \{\n    value: T\n\}\nfn want_int_box(b: Box[Int]) -> Int \{\n    b.value\n\}\nfn main() \{\n    want_int_box(Box \{ value: \"wrong\" \})\n}\n"
    compile_test_helpers.expect_compile_error(src, "box_str_into_int_param", "E0300")
}

test "Box[Str] literal into an annotated Box[Int] binding is rejected (E0300)" {
    let src = "type Box[T] \{\n    value: T\n\}\nfn main() \{\n    let b: Box[Int] = Box \{ value: \"nope\" \}\n    b.value\n}\n"
    compile_test_helpers.expect_compile_error(src, "box_str_into_int_let", "E0300")
}

test "matching concrete Box[Int] literal into Box[Int] is NOT rejected" {
    let src = "type Box[T] \{\n    value: T\n\}\nfn want_int_box(b: Box[Int]) -> Int \{\n    b.value\n\}\nfn main() \{\n    want_int_box(Box \{ value: 5 \})\n}\n"
    compile_test_helpers.expect_no_error(src, "box_int_into_int_param", "E0300")
}
