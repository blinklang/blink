import compile_test_helpers

// r1s7g2 — a type-changing list.map(fn(T)->U) must yield List[U] (eager, §3c.1).
// Previously map returned the original List[T], so List[U] was mistyped as
// List[T]: correct code rejected, wrong accepted.

test "map(Int -> Str) typed as List[Str]" {
    let src = "fn main() \{ let l: List[Int] = []\n let r: List[Str] = l.map(fn(x: Int) -> Str \{ \"v\" }) }\n"
    compile_test_helpers.expect_no_error(src, "r1s7g2_to_str_ok", "E0300")
}

test "map(Int -> Str) into List[Int] rejected" {
    let src = "fn main() \{ let l: List[Int] = []\n let r: List[Int] = l.map(fn(x: Int) -> Str \{ \"v\" }) }\n"
    compile_test_helpers.expect_compile_error(src, "r1s7g2_to_int_bad", "E0300")
}

test "map with unannotated closure return still compiles" {
    let src = "fn main() \{ let l: List[Int] = []\n let r = l.map(fn(x) \{ x }) }\n"
    compile_test_helpers.expect_no_error(src, "r1s7g2_unannotated", "E0300")
}
