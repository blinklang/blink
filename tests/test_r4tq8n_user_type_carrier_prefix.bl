// c_type_c_name_in tests the type NAME with starts_with("Map_") / "Option_" / "Result_" to
// recognize a synthesized carrier tag. Those tags are compiler-built, but the test also matches
// a user type whose declared name happens to begin with one of them — a legal name — and
// rewrites it to a carrier spelling. The typedef emitter is kind-keyed and does not, so the
// declaration and every use disagree and the program cannot compile.

import compile_test_helpers
import std.io

fn map_prefixed_src() -> Str {
    #"import std.io

type Map_Entry {
    k: Str
    v: Int
}

fn main() {
    let e = Map_Entry { k: "a", v: 1 }
    io.println("k={e.k} v={e.v}")
}
"#
}

test "a user type named Map_* compiles and runs" {
    let r = compile_test_helpers.compile_and_run(map_prefixed_src(), "r4tq8n_map")
    if !r.out.contains("k=a v=1") { io.println("FAIL: Map_Entry — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("k=a v=1"))
}

fn option_prefixed_src() -> Str {
    #"import std.io

type Option_Set {
    n: Int
}

fn main() {
    let s = Option_Set { n: 4 }
    io.println("n={s.n}")
}
"#
}

test "a user type named Option_* compiles and runs" {
    let r = compile_test_helpers.compile_and_run(option_prefixed_src(), "r4tq8n_option")
    if !r.out.contains("n=4") { io.println("FAIL: Option_Set — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("n=4"))
}

fn result_prefixed_src() -> Str {
    #"import std.io

type Result_Row {
    ok: Bool
}

fn main() {
    let r = Result_Row { ok: true }
    io.println("ok={r.ok}")
}
"#
}

test "a user type named Result_* compiles and runs" {
    let r = compile_test_helpers.compile_and_run(result_prefixed_src(), "r4tq8n_result")
    if !r.out.contains("ok=true") { io.println("FAIL: Result_Row — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("ok=true"))
}

// The genuine carrier tags must keep resolving to their runtime spellings — this is the row
// that fails if the fix widens into "never treat a prefixed name as a carrier".
fn real_carriers_src() -> Str {
    #"import std.io

fn main() {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let o: Option[Int] = Some(2)
    let r: Result[Int, Str] = Ok(3)
    let ov = match o { Some(v) => v None => 0 }
    let rv = match r { Ok(v) => v Err(e) => 0 }
    io.println("m={m.get(\"a\").unwrap()} o={ov} r={rv}")
}
"#
}

test "the real Map/Option/Result carriers still resolve" {
    let r = compile_test_helpers.compile_and_run(real_carriers_src(), "r4tq8n_carriers")
    if !r.out.contains("m=1 o=2 r=3") { io.println("FAIL: real carriers — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("m=1 o=2 r=3"))
}
