// Bug r9bbmk: `Option[Tuple[...]]` typed `blink_Option_void` because a Tuple inner
// name fell through the struct/compound checks in emit_let_binding's CT_OPTION
// path (opt_inner_s = "") and in the struct-field carrier-typedef path. The
// carrier typedef also had to be emitted AFTER the inner tuple typedef it
// references by value, or C reads the unknown name as `int`. Fix resolves the
// Tuple inner tag so the carrier is `blink_Option_Tuple2_int_int` and eager-emits
// the tuple typedef first.

test "let Option[Tuple[Int,Int]] = Some((3,4)) match reads tuple field" {
    let x: Option[Tuple[Int, Int]] = Some((3, 4))
    let mut sum = 0
    match x {
        Some(t) => sum = t._0 + t._1
        None => sum = -1
    }
    assert_eq(sum, 7)
}

type Holder { p: Option[Tuple[Int, Int]] }

test "struct field Option[Tuple[Int,Int]] carrier round-trips" {
    let h = Holder { p: Some((3, 4)) }
    let mut sum = 0
    match h.p {
        Some(t) => sum = t._0 + t._1
        None => sum = -1
    }
    assert_eq(sum, 7)
}

test "let Result[Tuple[Int,Int], Str] = Ok((3,4)) match reads tuple field" {
    let x: Result[Tuple[Int, Int], Str] = Ok((3, 4))
    let mut sum = 0
    match x {
        Ok(t) => sum = t._0 + t._1
        Err(e) => sum = -1
    }
    assert_eq(sum, 7)
}
