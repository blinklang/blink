// Each rand wrapper checks the handler's answer in every build mode (sections/04_effects.md
// §4.4.7 Handler contract): int must be in [lo, hi], float in [0.0, 1.0) and bytes must have
// the asked length. A bad answer panics with the op, its arguments and the value.

fn bad_int() -> Handler[Rand] {
    handler Rand {
        fn int(_lo: Int, hi: Int) -> Int { hi + 5 }
    }
}

fn below_int() -> Handler[Rand] {
    handler Rand {
        fn int(lo: Int, _hi: Int) -> Int { lo - 1 }
    }
}

fn float_of(x: Float) -> Handler[Rand] {
    handler Rand {
        fn float() -> Float { x }
    }
}

// 0.0 / 0.0 in place of Float.NAN, which codegen cannot lower yet.
fn a_nan() -> Float {
    let zero = 0.0
    zero / zero
}

fn short_bytes() -> Handler[Rand] {
    handler Rand {
        fn bytes(n: Int) -> Bytes { Bytes.zeroed(n - 1) }
    }
}

test "an int above hi panics with the op and the value" {
    with bad_int() {
        assert_panics(matching: "Rand handler contract violated: int(0, 4) returned 9") {
            let _ = rand.int(0..5)
        }
    }
}

test "an int below lo panics" {
    with below_int() {
        assert_panics(matching: "Rand handler contract violated: int(3, 7) returned 2") {
            let _ = rand.int(3..=7)
        }
    }
}

test "a float of 1.0 panics" {
    with float_of(1.0) {
        assert_panics(matching: "Rand handler contract violated: float() returned 1") {
            let _ = rand.float()
        }
    }
}

test "a negative float panics" {
    with float_of(-0.5) {
        assert_panics(matching: "Rand handler contract violated: float() returned -0.5") {
            let _ = rand.float()
        }
    }
}

test "a NaN float panics" {
    with float_of(a_nan()) {
        assert_panics(matching: "Rand handler contract violated: float() returned") {
            let _ = rand.float()
        }
    }
}

test "a float in range passes through" {
    with float_of(0.25) {
        assert_eq(rand.float(), 0.25)
    }
}

test "bytes of the wrong length panic" {
    with short_bytes() {
        assert_panics(matching: "Rand handler contract violated: bytes(4) returned 3 bytes") {
            let _ = rand.bytes(4)
        }
    }
}

test "a negative byte count panics before the op" {
    assert_panics(matching: "rand.bytes: negative count -1") {
        let _ = rand.bytes(-1)
    }
}

test "the default handler gives the asked byte count" {
    assert_eq(rand.bytes(0).len(), 0)
    assert_eq(rand.bytes(33).len(), 33)
}
