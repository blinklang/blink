// rand.int takes a Range[Int] and performs the op int(lo, hi) with an inclusive hi
// (sections/04_effects.md §4.4.7): `a..b` asks for int(a, b - 1) and `a..=b` for int(a, b).
// An empty range panics before any op call, with the range in the message.

fn low() -> Handler[Rand] {
    handler Rand {
        fn int(lo: Int, _hi: Int) -> Int { lo }
    }
}

fn high() -> Handler[Rand] {
    handler Rand {
        fn int(_lo: Int, hi: Int) -> Int { hi }
    }
}

test "an exclusive range asks for its end minus one" {
    with low() {
        assert_eq(rand.int(3..7), 3)
    }
    with high() {
        assert_eq(rand.int(3..7), 6)
    }
}

test "an inclusive range asks for its end" {
    with low() {
        assert_eq(rand.int(3..=7), 3)
    }
    with high() {
        assert_eq(rand.int(3..=7), 7)
    }
}

test "a range bound to a let passes to rand.int" {
    let r = 1..=6
    with high() {
        assert_eq(rand.int(r), 6)
    }
}

test "a one-value range asks for that value" {
    with high() {
        assert_eq(rand.int(5..6), 5)
        assert_eq(rand.int(5..=5), 5)
    }
}

test "an empty exclusive range panics" {
    assert_panics(matching: "rand.int: empty range 5..5") {
        let _ = rand.int(5..5)
    }
    assert_panics(matching: "rand.int: empty range 5..2") {
        let _ = rand.int(5..2)
    }
}

test "an empty inclusive range panics" {
    assert_panics(matching: "rand.int: empty range 5..=4") {
        let _ = rand.int(5..=4)
    }
}

test "an exclusive range that ends at the lowest Int panics instead of wrapping" {
    let end = 0 - 9223372036854775807 - 1
    assert_panics(matching: "rand.int: empty range 0..-9223372036854775808") {
        let _ = rand.int(0..end)
    }
}
