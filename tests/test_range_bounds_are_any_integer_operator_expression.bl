// `..` and `..=` have their own row in the precedence table, between comparison and the integer
// operator groups (sections/02_syntax.md §2.19 "Range Operands"). Each bound is any expression
// that binds tighter: a name, a call, a field, a parenthesized expression, a unary expression, or
// an arithmetic, shift or bitwise expression. So `0..n + 1` is `0..(n + 1)`, `0..xs.len()` is
// `0..(xs.len())` and `-2..3` is `(-2)..3`.

type Span {
    lo: Int
    hi: Int
}

fn walk(r: Range[Int]) -> List[Int] {
    let mut seen: List[Int] = []
    for i in r { seen.push(i) }
    seen
}

fn two() -> Int { 2 }

test "an arithmetic end binds tighter than the range" {
    let n = 3
    let mut seen: List[Int] = []
    for i in 0..n + 1 { seen.push(i) }
    assert_eq(seen, [0, 1, 2, 3])
    assert_eq(walk(1..=n * 2), [1, 2, 3, 4, 5, 6])
    assert_eq(walk(n - 2..n), [1, 2])
}

test "a method call end is the end, not a call on the range" {
    let xs = [10, 20, 30]
    let mut seen: List[Int] = []
    for i in 0..xs.len() { seen.push(i) }
    assert_eq(seen, [0, 1, 2])
}

test "a start need not be a literal" {
    let lo = 1
    let hi = 4
    let xs = [1, 2, 3]
    let s = Span { lo: 2, hi: 5 }
    assert_eq(walk(lo..hi), [1, 2, 3])
    assert_eq(walk(xs.len()..5), [3, 4])
    assert_eq(walk(two()..=3), [2, 3])
    assert_eq(walk(s.lo..s.hi), [2, 3, 4])
    assert_eq(walk((lo)..3), [1, 2])
}

test "a unary minus start binds tighter than the range" {
    assert_eq(walk(-2..1), [-2, -1, 0])
    let n = 2
    assert_eq(walk(-n..=0), [-2, -1, 0])
}

test "a bitwise or shift end binds tighter than the range" {
    let n = 4
    assert_eq(walk(0..n | 1), [0, 1, 2, 3, 4])
    assert_eq(walk(0..1 << 2), [0, 1, 2, 3])
    assert_eq(walk(0..(n & 3)), [])
}

test "a range beside an equality operator is one operand" {
    let r = 0..3
    assert(r == 0..3)
    assert(r != 0..4)
    assert(r == (0..3))
}

test "an empty range with name bounds runs zero times" {
    let five = 5
    let three = 3
    let mut n = 0
    for _i in five..five { n = n + 1 }
    for _i in five..three { n = n + 1 }
    for _i in five..=three + 1 { n = n + 1 }
    assert_eq(n, 0)
    for _i in five..=five { n = n + 1 }
    assert_eq(n, 1)
}
