// Each bound of a range evaluates once, the start before the end, when the range value is
// created (sections/02_syntax.md §2.10 "Evaluation", §2.22). It holds for every range value,
// not only in a `for` header, and a change inside the loop does not change the bounds.

let mut calls: List[Str] = []

fn bound(tag: Str, v: Int) -> Int {
    calls.push(tag)
    v
}

test "a for header reads each bound once, the start first" {
    calls = []
    let mut turns = 0
    for _i in bound("lo", 0)..bound("hi", 3) { turns = turns + 1 }
    assert_eq(turns, 3)
    assert_eq(calls, ["lo", "hi"])
}

test "an inclusive for header reads each bound once, the start first" {
    calls = []
    let mut turns = 0
    for _i in bound("lo", 1)..=bound("hi", 3) + 1 { turns = turns + 1 }
    assert_eq(turns, 4)
    assert_eq(calls, ["lo", "hi"])
}

test "a range value reads each bound once, the start first" {
    calls = []
    let r = bound("lo", 2)..bound("hi", 5)
    assert_eq(calls, ["lo", "hi"])
    let mut seen: List[Int] = []
    for i in r { seen.push(i) }
    for i in r { seen.push(i) }
    assert_eq(seen, [2, 3, 4, 2, 3, 4])
    assert_eq(calls, ["lo", "hi"])
}

test "a range value reads the start before an end with an operator" {
    calls = []
    let r = bound("lo", 2)..=bound("hi", 3) + 1
    assert_eq(calls, ["lo", "hi"])
    assert(r == 2..=4)
}

test "a range value reads the start before an end that runs statements" {
    calls = []
    let r = bound("lo", 0)..{
        calls.push("hi")
        2
    }
    assert_eq(calls, ["lo", "hi"])
    assert(r == 0..2)
}

test "a push inside the loop does not change an end read from the list" {
    let mut xs = [1, 2, 3]
    for i in 0..xs.len() {
        xs.push(i)
    }
    assert_eq(xs.len(), 6)
}
