// `Range[T]` is `Clone` when `T` is. The clone has the same start, end and kind, and each
// bound is copied by the `clone` of `T` (sections/03_types.md §3.6.1 *Clone Semantics*).

@derive(Debug, Eq, Ord)
type RangeClonePoint {
    a: Int
}

// A written clone shows in the copy, so the test can tell that each bound went through it.
impl Clone for RangeClonePoint {
    fn clone(self) -> RangeClonePoint { RangeClonePoint { a: self.a + 100 } }
}

// A generic bound type: its written clone is an instance of a generic impl, which nothing but
// the range's clone calls.
@derive(Debug, Eq, Ord)
type RangeCloneBox[T: Ord + Debug] {
    v: T
}

impl[T: Ord + Debug] Clone for RangeCloneBox[T] {
    fn clone(self) -> RangeCloneBox[T] { RangeCloneBox { v: self.v } }
}

@derive(Clone, Eq, Debug)
type RangeCloneWindow {
    span: Range[Int]
}

fn range_clone_dup[T: Clone](x: T) -> T {
    x.clone()
}

test "a clone has the same start, end and kind" {
    let r = 0..3
    let c = r.clone()
    assert(c == r)
    assert_eq(c.debug(), "0..3")
    assert_eq((1..=4).clone().debug(), "1..=4")
    assert((1..=4).clone() != 1..4)
}

test "a range of Str clones to an equal range" {
    let r = "a".."c"
    assert(r.clone() == r)
}

test "each bound is copied by the clone of its type" {
    let r = RangeClonePoint { a: 1 }..=RangeClonePoint { a: 2 }
    assert_eq(r.clone().debug(), "RangeClonePoint \{ a: 101 }..=RangeClonePoint \{ a: 102 }")
    assert_eq(r.debug(), "RangeClonePoint \{ a: 1 }..=RangeClonePoint \{ a: 2 }")
}

test "a T: Clone bound reaches a range's clone" {
    assert(range_clone_dup(0..3) == 0..3)
    let p = range_clone_dup(RangeClonePoint { a: 5 }..RangeClonePoint { a: 6 })
    assert_eq(p.debug(), "RangeClonePoint \{ a: 105 }..RangeClonePoint \{ a: 106 }")
}

test "a derived Clone copies a range field" {
    let w = RangeCloneWindow { span: 2..=5 }
    let c = w.clone()
    assert(c == w)
    assert_eq(c.debug(), "RangeCloneWindow \{ span: 2..=5 }")
}

test "each bound is copied by a written clone of a generic type" {
    let r = RangeCloneBox { v: 1 }..=RangeCloneBox { v: 2 }
    assert_eq(r.clone().debug(), "RangeCloneBox \{ v: 1 }..=RangeCloneBox \{ v: 2 }")
    let s = RangeCloneBox { v: "a" }..RangeCloneBox { v: "b" }
    assert(range_clone_dup(s) == s)
}
