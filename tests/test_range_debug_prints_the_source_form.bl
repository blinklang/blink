// A range's debug() prints the range as it was written: the start's debug(), then `..` or
// `..=`, then the end's debug() (sections/03_types.md §3.6.1 *Container Debug Rendering*).
// Range[T] is Debug when T is, so a derived Debug and a `T: Debug` bound both reach it.

@derive(Debug, Eq, Ord)
type RangeDebugPoint {
    a: Int
}

@derive(Debug, Eq)
type RangeDebugWindow {
    span: Range[Int]
}

@derive(Debug)
type RangeDebugHolder {
    maybe: Option[Range[Int]]
    spans: List[Range[Int]]
}

fn range_debug_shown[T: Debug](x: T) -> Str {
    x.debug()
}

test "an exclusive range prints with .." {
    assert_eq((0..3).debug(), "0..3")
    let r = 0..3
    assert_eq(r.debug(), "0..3")
}

test "an inclusive range prints with ..=" {
    assert_eq((1..=4).debug(), "1..=4")
}

test "an empty range prints its bounds as written" {
    assert_eq((5..3).debug(), "5..3")
    assert_eq((-2..-2).debug(), "-2..-2")
}

test "each bound prints by the debug of its type" {
    assert_eq(("a".."c").debug(), "\"a\"..\"c\"")
    assert_eq(('a'..='z').debug(), "'a'..='z'")
    assert_eq((0.5..1.5).debug(), "0.5..1.5")
    let lo: U8 = 1
    let hi: U8 = 4
    assert_eq((lo..=hi).debug(), "1..=4")
    let p = RangeDebugPoint { a: 1 }..RangeDebugPoint { a: 2 }
    assert_eq(p.debug(), "RangeDebugPoint \{ a: 1 }..RangeDebugPoint \{ a: 2 }")
}

test "a derived Debug prints a range field in its source form" {
    assert_eq(RangeDebugWindow { span: 0..3 }.debug(), "RangeDebugWindow \{ span: 0..3 }")
    let h = RangeDebugHolder { maybe: Some(1..=2), spans: [0..1, 2..=3] }
    assert_eq(h.debug(), "RangeDebugHolder \{ maybe: Some(1..=2), spans: [0..1, 2..=3] }")
}

test "a T: Debug bound reaches a range's debug" {
    assert_eq(range_debug_shown(0..=2), "0..=2")
    assert_eq(range_debug_shown(RangeDebugWindow { span: 4..5 }), "RangeDebugWindow \{ span: 4..5 }")
}

test "two equal ranges print the same text" {
    let a = 0..3
    let b = 0..3
    assert(a == b)
    assert_eq(a.debug(), b.debug())
}
