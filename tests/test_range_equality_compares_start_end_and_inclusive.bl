// Two ranges are equal when their start, their end and their inclusive flag are equal
// (sections/02_syntax.md §2.19 *A range next to a comparison or equality operator*). The
// compare is structural, not by the values a range walks: 0..3 and 0..=2 walk the same
// values and are not equal.

@derive(Eq)
type Span {
    name: Str
    r: Range[Int]
}

fn same(a: Range[Int], b: Range[Int]) -> Bool {
    a == b
}

test "a range equals a range with the same bounds" {
    let r = 0..3
    let ok = r == 0..3
    assert(ok)
    assert(same(1..=4, 1..=4))
}

test "a range differs from one with another start or end" {
    let r = 0..3
    assert(r != 1..3)
    assert(r != 0..4)
    assert(!same(2..4, 2..5))
}

test "an exclusive range differs from the inclusive range that walks the same values" {
    let r = 0..3
    assert(r != 0..=2)
    assert(!same(5..=5, 5..6))
}

test "a range in a derived struct field compares by its bounds" {
    assert(Span { name: "a", r: 0..3 } == Span { name: "a", r: 0..3 })
    assert(Span { name: "a", r: 0..3 } != Span { name: "a", r: 0..=3 })
}

test "a range inside an Option and a List compares by its bounds" {
    let a: Option[Range[Int]] = Some(0..3)
    assert(a == Some(0..3))
    assert(a != Some(0..=3))
    assert([0..1, 2..3] == [0..1, 2..3])
    assert([0..1, 2..3] != [0..1, 2..=3])
}
