// `Range[T]` implements IntoIterator and yields `T`, lazily (sections/03c_protocols.md §3c.1
// *IntoIterator*), so `.into_iter()` on a range of an integer type gives the same elements a
// `for` loop walks over it, in order, and `collect()` gathers them into a List.

test "an exclusive range yields each element before its end" {
    let xs: List[Int] = (0..3).into_iter().collect()
    assert_eq(xs, [0, 1, 2])
}

test "an inclusive range yields its end too" {
    let xs: List[Int] = (0..=2).into_iter().collect()
    assert_eq(xs, [0, 1, 2])
    let r = 1..=4
    assert_eq(r.into_iter().count(), 4)
}

test "an empty range yields nothing" {
    assert_eq((5..5).into_iter().count(), 0)
    assert_eq((5..3).into_iter().count(), 0)
    assert_eq((5..=4).into_iter().count(), 0)
    let one: List[Int] = (5..=5).into_iter().collect()
    assert_eq(one, [5])
}

test "a range of negative bounds yields in order" {
    let xs: List[Int] = (-2..1).into_iter().collect()
    assert_eq(xs, [-2, -1, 0])
}

test "the elements of two ranges compare where the ranges do not" {
    let a: List[Int] = (0..3).into_iter().collect()
    let b: List[Int] = (0..=2).into_iter().collect()
    assert((0..3) != (0..=2))
    assert_eq(a, b)
}

test "a range of a sized integer type yields that type" {
    let lo: U8 = 250
    let hi: U8 = 255
    let xs: List[U8] = (lo..=hi).into_iter().collect()
    assert_eq(xs.len(), 6)
    assert_eq(xs.get(5).unwrap(), hi)
    let a: I8 = -128
    let b: I8 = -126
    let ys: List[I8] = (a..b).into_iter().collect()
    assert_eq(ys, [a, a + 1])
    let top: U64 = 18446744073709551615
    let us: List[U64] = (top..=top).into_iter().collect()
    assert_eq(us, [top])
}

test "each sized integer type has a range iterator" {
    let a: I16 = 1
    let b: I32 = 1
    let c: U16 = 1
    let d: U32 = 1
    assert_eq((a..=a + 2).into_iter().count(), 3)
    assert_eq((b..=b + 2).into_iter().count(), 3)
    assert_eq((c..=c + 2).into_iter().count(), 3)
    assert_eq((d..=d + 2).into_iter().count(), 3)
}

test "the elements are produced on demand" {
    let first: List[Int] = (0..9223372036854775807).into_iter().take(3).collect()
    assert_eq(first, [0, 1, 2])
}

test "each walk of one range iterator starts over" {
    let it = (1..=3).into_iter()
    assert_eq(it.count(), 3)
    let xs: List[Int] = it.map(fn(x: Int) -> Int { x * 10 }).collect()
    assert_eq(xs, [10, 20, 30])
}

test "a for loop over into_iter walks the same elements" {
    let mut sum = 0
    for x in (1..=4).into_iter() {
        sum = sum + x
    }
    assert_eq(sum, 10)
}
