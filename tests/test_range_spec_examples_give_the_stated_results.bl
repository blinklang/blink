// The range examples of sections/02_syntax.md §2.10 (*Comparing ranges*, *An inclusive range
// up to the largest value of its type*) and sections/03_types.md §3.6 (*Range equality*, `==`
// *on ranges is not equality of elements*, *Traits of Range[T]*) give the results their
// comments state.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}
import std.io

fn typecheck_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    init_embedded_stdlib()
    fs.write(path, src).unwrap()
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

// Each error as "name: message | note | note".
fn errors_of(src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    typecheck_probe("build/test_range_spec_examples_probe.bl", src)
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            let mut line = "{d.name}: {d.message}"
            for n in d.notes { line = "{line} | {n}" }
            out.push(line)
        }
    }
    for e in out { io.println("  diag: {e}") }
    out
}

@derive(Eq, Clone, Debug)
type RangeSpecWindow {
    span: Range[Int]
}

fn range_spec_same[T: Ord](a: Range[T], b: Range[T]) -> Bool {
    a == b
}

test "comparing ranges compares the start, the end and the kind" {
    let a = (0..3) == (0..3)
    let b = (0..3) == (0..=2)
    let c = (5..3) == (0..0)
    assert(a)
    assert(!b)
    assert(!c)
}

test "to compare the elements, collect both sides" {
    let xs: List[Int] = (0..3).into_iter().collect()
    let ys: List[Int] = (0..=2).into_iter().collect()
    let same = xs == ys
    assert(same)
}

test "an inclusive range up to the largest value of its type stops after it" {
    let top: U8 = 255
    let mut n = 0
    for _i in 250..=top {
        n = n + 1
    }
    assert_eq(n, 6)
}

test "range equality gives the stated results" {
    let r = 0..3
    let a = r == 0..3
    let b = (0..3) == (0..=2)
    let c = (5..3) == (0..0)
    let d = (5..5) == (5..5)
    let e = (5..=5) == (5..6)
    let f = 0.0..1.0
    let g = f == 0.0..=1.0
    assert(a)
    assert(!b)
    assert(!c)
    assert(d)
    assert(!e)
    assert(!g)
}

test "equality of elements is not equality of ranges" {
    let a: List[Int] = (0..3).into_iter().collect()
    let b: List[Int] = (0..=2).into_iter().collect()
    let same_elements = a == b
    let same_range = (0..3) == (0..=2)
    assert(same_elements)
    assert(!same_range)
}

test "the traits example runs to its stated output" {
    let w = RangeSpecWindow { span: 0..3 }
    assert(w == w.clone())
    assert_eq(w.debug(), "RangeSpecWindow \{ span: 0..3 }")
    assert(range_spec_same(1..4, 1..4))
    assert(!range_spec_same(1.0..4.0, 1.0..=4.0))
    let r = 0..3
    assert_eq(r.debug(), "0..3")
    assert_eq((1..=4).debug(), "1..=4")
    assert_ne(r, 0..=2)
}

test "the traits example rejects Hash, Ord and Display" {
    let src = "fn main() \{\n    let r = 0..3\n    let m: Map[Range[Int], Str] = Map.new()\n    let lt = r < 1..3\n    io.println(\"\{r}\")\n}\n"
    let errs = errors_of(src)
    assert_eq(errs.len(), 3)
    assert(errs.get(0).unwrap().contains("MapKeyNotHashable"), errs.get(0).unwrap())
    assert(errs.get(1).unwrap().contains("TypeError: binary `<` needs Ord"), errs.get(1).unwrap())
    assert(errs.get(2).unwrap().contains("MissingDisplayImpl"), errs.get(2).unwrap())
}
