// `..` binds tighter than the comparison, equality and `??` operators (sections/02_syntax.md
// §2.19 "Range Operands"), so `x == 0..3` compares `x` with a range and `opt ?? 0..n` takes the
// whole range as its default. Each is a TypeError with a help keyed on the syntax: a bare range
// beside a comparison or equality operator asks for the two bound tests, and a bare range as a
// `??` default whose start fits the Option shows the parenthesized start.

import std.process.{ProcessResult, ChildEnd}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/range_type_errors_say_what_to_write"

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

// The body goes after `fn main() {` and the lets it uses.
fn check_json(name: Str, body: Str) -> ProcessResult ! FS.Write, Process.Spawn {
    let _ = sh("mkdir -p {DIR}")
    let lets = "    let n = 5\n    let a = 1\n    let x = 2\n    let r = 0..3\n    let opt: Int? = None\n    let name: Str? = None\n    let ou: U8? = None\n"
    fs.write("{DIR}/{name}.bl", "fn main() \{\n{lets}{body}\n}\n").unwrap()
    sh("B=$(pwd)/build/blink; cd {DIR} && $B check --json {name}.bl")
}

fn error_rows(out: Str) -> List[Str] {
    let mut rows: List[Str] = []
    for row in out.trim().split("\n") {
        if row.contains("\"severity\":\"error\"") { rows.push(row) }
    }
    rows
}

// The one error row of `body`, or a text that names what is wrong.
fn one_row(name: Str, body: Str) -> Str ! FS.Write, Process.Spawn {
    let r = check_json(name, body)
    let rows = error_rows(r.err_out)
    if rows.len() != 1 { return "want 1 error row, got {rows.len()}:\n{r.err_out}" }
    rows.get(0).unwrap()
}

fn has(row: Str, part: Str) -> Str {
    if row.contains(part) { "" } else { "want {part} in {row}\n" }
}

fn lacks(row: Str, part: Str) -> Str {
    if row.contains(part) { "do not want {part} in {row}\n" } else { "" }
}

fn help(text: Str) -> Str {
    "\"help\":\"{text}\""
}

test "an int compared with a bare range asks for the two bound tests" {
    let row = one_row("eq", "    let _b = x == 0..3")
    let p = has(row, "\"name\":\"TypeError\"").concat(has(row, help("to test that `x` is in the range, write `x >= 0 && x < 3`")))
    assert_eq(p, "")
}

test "each comparison and equality operator gets the same help" {
    for op in ["!=", "<", ">", "<=", ">="] {
        let row = one_row("op", "    let _b = x {op} 0..3")
        assert_eq(has(row, help("to test that `x` is in the range, write `x >= 0 && x < 3`")), "")
    }
}

test "an inclusive range tests the end with `<=`" {
    let row = one_row("inclusive", "    let _b = x == 0..=3")
    assert_eq(has(row, help("to test that `x` is in the range, write `x >= 0 && x <= 3`")), "")
}

test "a bare range on the left names the right operand" {
    let row = one_row("left", "    let _b = 0..3 == x")
    assert_eq(has(row, help("to test that `x` is in the range, write `x >= 0 && x < 3`")), "")
}

test "wider operands show as written, with the pairs a bitwise bound needs" {
    let row = one_row("wide", "    let _b = a + 1 == n..n * 2")
    assert_eq(has(row, help("to test that `a + 1` is in the range, write `a + 1 >= n && a + 1 < n * 2`")), "")
    let row2 = one_row("bitwise", "    let _b = x < 0..(n | 1)")
    assert_eq(has(row2, help("to test that `x` is in the range, write `x >= 0 && x < (n | 1)`")), "")
}

test "a parenthesized range gets the help too, as no node keeps the parentheses" {
    let row = one_row("paren", "    let _b = x == (0..3)")
    assert_eq(has(row, help("to test that `x` is in the range, write `x >= 0 && x < 3`")), "")
}

test "an operand the help cannot quote gets the help with placeholders" {
    let row = one_row("unquoted", "    let _b = (if a > 0 \{ 1 } else \{ 2 }) == 0..3")
    assert_eq(has(row, help("to test that a value `v` is in the range, write `v >= lo && v < hi`")), "")
}

test "a range compared with a range is no error" {
    let r = check_json("range_eq", "    let _b = r == 0..3")
    assert_eq(error_rows(r.err_out).len(), 0)
    assert_eq(r.end, ChildEnd.Exited(0))
}

test "a range as the default of an Int Option shows the parenthesized start" {
    let row = one_row("coalesce", "    let _u = opt ?? 0..n")
    let p = has(row, "\"name\":\"TypeError\"").concat(has(row, help("did you mean `(opt ?? 0)..n`?")))
    assert_eq(p, "")
}

test "a range as the default of an Option the start does not fit gets no range help" {
    let row = one_row("coalesce_str", "    let _u = name ?? 0..n")
    assert_eq(has(row, "\"name\":\"TypeError\"").concat(lacks(row, "\"help\"")), "")
}

test "the `??` help needs the end to fit the Option too" {
    let row = one_row("coalesce_u8_int_end", "    let _u = ou ?? 0..n")
    assert_eq(has(row, "\"name\":\"TypeError\"").concat(lacks(row, "\"help\"")), "")
    let row2 = one_row("coalesce_u8_literal_end", "    let _u = ou ?? 0..3")
    assert_eq(has(row2, help("did you mean `(ou ?? 0)..3`?")), "")
}

test "a range of a type with no order is a TypeError" {
    for (name, body) in [("bool_range", "    let _s = true..false"), ("cmp_range", "    let _s = (x == 0)..true"), ("option_range", "    let _s = opt..opt")] {
        let row = one_row(name, body)
        assert_eq(has(row, "\"name\":\"TypeError\"").concat(has(row, "does not implement `Ord`")), "")
    }
    let r = check_json("ord_ranges", "    let _a = 'a'..'c'\n    let _f = 0.5..1.5\n    let _t = \"a\"..\"b\"")
    assert_eq(error_rows(r.err_out).len(), 0)
    let _ = sh("rm -rf {DIR}")
}
