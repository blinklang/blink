// `ProcessResult` has no `exit_code` field: the child's end is `r.end`, a `ChildEnd`, and
// `r.success()` tests for a clean exit (sections/04_effects.md §4.4.8). A read of the old
// field is NoSuchField (E0525) with the help line that section writes, whether the type
// comes from `import std.process` or from a builtin that answers it with no import. A
// struct of the same name that a user declares is not the std type, so it gets the
// common help.
import lower_test_helpers.{probe_but, assert_eq_str}
import diagnostics.{diag_entries}
import std.io

let PROCESS_HELP = "the child's end is `r.end`; use `r.success()` to test for a clean exit, or `match r.end`"

// The one NoSuchField the probe reports, as "message | help", or why there is not one.
fn no_such_field() -> Str {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.name == "NoSuchField" {
            if d.code != "E0525" { io.println("FAIL: NoSuchField with code {d.code}") }
            out.push("{d.message} | {d.help}")
        }
    }
    if out.len() == 1 { out.get(0).unwrap() } else { "{out.len()} NoSuchField reports: {out.join(\"; \")}" }
}

test "a read of exit_code on the result of process.run is E0525 with the end and success help" {
    let _p = probe_but("exit_code_process_run", #"import std.process

fn main() ! Process.Spawn {
    let r = process.run("true", []).unwrap()
    let _c = r.exit_code
}
"#, "NoSuchField")
    assert_eq_str("process.run", no_such_field(), "`ProcessResult` has no field `exit_code` | {PROCESS_HELP}")
}

test "a read of exit_code on a ProcessResult parameter is E0525 with the end and success help" {
    let _p = probe_but("exit_code_param", #"import std.process.{ProcessResult}

fn code(r: ProcessResult) -> Int {
    r.exit_code
}

fn main() {}
"#, "NoSuchField")
    assert_eq_str("parameter", no_such_field(), "`ProcessResult` has no field `exit_code` | {PROCESS_HELP}")
}

test "a read of exit_code on a builtin result with no std.process import has the same help" {
    let _p = probe_but("exit_code_unimported", #"fn main() {
    let r = process_run("true", [])
    let _c = r.exit_code
}
"#, "NoSuchField")
    assert_eq_str("unimported", no_such_field(), "`ProcessResult` has no field `exit_code` | {PROCESS_HELP}")
}

test "a user struct named ProcessResult gets the common help for exit_code" {
    let _p = probe_but("exit_code_user_struct", #"type ProcessResult {
    out: Str
}

fn main() {
    let r = ProcessResult { out: "" }
    let _c = r.exit_code
}
"#, "NoSuchField")
    assert_eq_str("user struct", no_such_field(), "`ProcessResult` has no field `exit_code` | use a declared field, or add the field to the type")
}
