// Two modules whose types name each other by value: each module's C needs the other's type
// before its own body, so the cycle only links when one field on it goes behind a box.

import compile_test_helpers.{scratch_root}

fn stage_and_run(tag: Str, a_src: Str, b_src: Str, main_src: Str) -> Str {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", src_dir]).unwrap()
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/ma.bl", a_src)
    write_file("{src_dir}/mb.bl", b_src)
    // `blink run` writes its binary to build/<entry basename> under the cwd, so the entry is
    // named for the test: two of these never write one path.
    write_file("{src_dir}/{tag}.bl", main_src)
    let r = process.run("build/blink", ["run", "{src_dir}/{tag}.bl"]).unwrap()
    "{r.end}|{r.out}{r.err_out}"
}

test "a struct and an enum in two modules that name each other run as values" {
    let a_src = "import mb.\{BLink\}\npub type A \{ n: Int, b: BLink \}\n"
    let b_src = "import ma.\{A\}\npub type BLink \{\n    Nil\n    Has(a: A)\n\}\n"
    let main_src = "import ma.\{A\}\nimport mb.\{BLink\}\nfn depth(a: A) -> Int \{\n    match a.b \{\n        BLink.Nil => 1\n        BLink.Has(x) => 1 + depth(x)\n    \}\n\}\nfn main() ! IO \{\n    let x = A \{ n: 1, b: BLink.Has(A \{ n: 2, b: BLink.Nil \}) \}\n    let mut y = x\n    y.n = 5\n    io.println(\"\{depth(x)\} \{x.n\} \{y.n\}\")\n\}\n"
    assert_eq(stage_and_run("recursive_type_xmod_enum", a_src, b_src, main_src), "exit 0|2 1 5\n")
}

test "two structs in two modules that name each other through an Option run as values" {
    let a_src = "import mb.\{B\}\npub type A \{ n: Int, b: Option[B] \}\n"
    let b_src = "import ma.\{A\}\npub type B \{ a: A \}\n"
    let main_src = "import ma.\{A\}\nimport mb.\{B\}\nfn sum(a: A) -> Int \{\n    match a.b \{\n        Some(b) => a.n + sum(b.a)\n        None => a.n\n    \}\n\}\nfn main() ! IO \{\n    let x = A \{ n: 1, b: Some(B \{ a: A \{ n: 2, b: None \} \}) \}\n    io.println(\"\{sum(x)\}\")\n\}\n"
    assert_eq(stage_and_run("recursive_type_xmod_option", a_src, b_src, main_src), "exit 0|3\n")
}
