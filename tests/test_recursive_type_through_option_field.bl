// A type that reaches itself only through an Option holds the payload by pointer, so the
// C struct needs no indirection of its own: it needs its name declared before the Option
// carrier that points at it, in whatever order the typedefs are written.

type Link {
    v: Int
    next: Option[Link]
}

type Node[T] { v: T, next: Option[Node[T]] }

// The cycle goes through a second type: B holds an Option of A, and A holds B by value.
type Outer { inner: Inner }
type Inner { flag: Bool, back: Option[Outer] }

fn link_sum(l: Link) -> Int {
    match l.next {
        Some(n) => l.v + link_sum(n)
        None => l.v
    }
}

fn node_len[T](n: Node[T]) -> Int {
    match n.next {
        Some(m) => 1 + node_len(m)
        None => 1
    }
}

test "a self-recursive struct through an Option builds and walks a chain" {
    let l = Link { v: 1, next: Some(Link { v: 2, next: Some(Link { v: 3, next: None }) }) }
    assert_eq(link_sum(l), 6)
}

test "a self-recursive struct through an Option is held in a List" {
    let t = Link { v: 3, next: None }
    let rt = [t]
    assert_eq(rt.get(0).unwrap().v, 3)
}

test "a self-recursive generic struct through an Option at two instances" {
    let a = Node { v: 1, next: Some(Node { v: 2, next: None }) }
    let b = Node { v: "x", next: Some(Node { v: "y", next: Some(Node { v: "z", next: None }) }) }
    assert_eq(a.next.unwrap().v, 2)
    assert_eq(node_len(a), 2)
    assert_eq(node_len(b), 3)
    assert_eq(b.next.unwrap().next.unwrap().v, "z")
}

test "a two-type cycle through an Option builds and reads back" {
    let o = Outer { inner: Inner { flag: true, back: Some(Outer { inner: Inner { flag: false, back: None } }) } }
    assert_eq(o.inner.flag, true)
    match o.inner.back {
        Some(p) => assert_eq(p.inner.flag, false)
        None => assert(false, "the back link is set")
    }
}

test "a copy of a recursive struct is a value: changing the copy leaves the original" {
    let l = Link { v: 1, next: Some(Link { v: 2, next: None }) }
    let mut c = l
    c.v = 10
    c.next = None
    assert_eq(l.v, 1)
    assert_eq(link_sum(l), 3)
    assert_eq(link_sum(c), 10)
}
