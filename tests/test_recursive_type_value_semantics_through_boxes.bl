// A type on a cycle of by-value types stores the fields on the cycle behind boxes. Copies
// of one value then share those boxes, so every write, derive and copy has to keep the
// value a value: a change through one name never shows through another (§3.6.1).

import std.traits
import std.json

// X -> Y -> Z -> ZLink -> X: a write to `v.y.z.n` crosses two boxes.
@derive(Eq, Ord, Hash, Clone, Debug, Serialize, Deserialize)
type X { y: Y }
@derive(Eq, Ord, Hash, Clone, Debug, Serialize, Deserialize)
type Y { z: Z }
@derive(Eq, Ord, Hash, Clone, Debug, Serialize, Deserialize)
type Z { n: Int, back: ZLink }
@derive(Eq, Ord, Hash, Clone, Debug, Serialize, Deserialize)
type ZLink {
    Nil
    Has(x: X)
}

// A generic cycle, used at two instances.
@derive(Eq, Debug)
type GNode[T] { v: T, link: GLink[T] }
@derive(Eq, Debug)
type GLink[T] {
    Nil
    Has(node: GNode[T])
}

impl Display for Z {
    fn fmt(self, sb: StringBuilder) {
        match self.back {
            ZLink.Nil => sb.write("{self.n}")
            ZLink.Has(x) => sb.write("{self.n} -> {x.y.z}")
        }
    }
}

fn leaf(n: Int) -> X { X { y: Y { z: Z { n: n, back: ZLink.Nil } } } }

fn chain(a: Int, b: Int) -> X { X { y: Y { z: Z { n: a, back: ZLink.Has(leaf(b)) } } } }

fn g_len[T](n: GNode[T]) -> Int {
    match n.link {
        GLink.Nil => 1
        GLink.Has(m) => 1 + g_len(m)
    }
}

test "a write that crosses two boxes changes only the copy" {
    let x = chain(1, 2)
    let mut v = x
    v.y.z.n = 5
    assert_eq(x.y.z.n, 1)
    assert_eq(v.y.z.n, 5)
}

test "a compound assignment through boxes changes only the copy" {
    let x = chain(1, 2)
    let mut v = x
    v.y.z.n += 10
    v.y.z.n += 1
    assert_eq(x.y.z.n, 1)
    assert_eq(v.y.z.n, 12)
}

test "replacing a boxed field of a copy leaves the original" {
    let x = chain(1, 2)
    let mut v = x
    v.y.z.back = ZLink.Nil
    v.y = Y { z: Z { n: 8, back: ZLink.Has(leaf(9)) } }
    assert_eq("{x.y.z}", "1 -> 2")
    assert_eq("{v.y.z}", "8 -> 9")
}

test "a write through boxes keeps what its right side wrote to the same value" {
    let mut v = leaf(1)
    let link = fn() -> Int {
        v.y.z.back = ZLink.Has(leaf(9))
        5
    }
    v.y.z.n = link()
    assert_eq("{v.y.z}", "5 -> 9")
    let mut w = leaf(1)
    let relink = fn() -> Int {
        w.y.z.back = ZLink.Has(leaf(8))
        2
    }
    w.y.z.n += relink()
    assert_eq("{w.y.z}", "3 -> 8")
}

test "a write to a copy taken in a loop leaves every earlier copy" {
    let mut v = leaf(0)
    let mut seen: List[X] = []
    let mut i = 0
    while i < 3 {
        seen.push(v)
        v.y.z.n += 1
        i += 1
    }
    assert_eq(seen.get(0).unwrap().y.z.n, 0)
    assert_eq(seen.get(2).unwrap().y.z.n, 2)
    assert_eq(v.y.z.n, 3)
}

test "a value a closure captured keeps its fields when the original changes" {
    let mut v = chain(1, 2)
    let before = v
    let read = fn() -> Int { before.y.z.n }
    v.y.z.n = 4
    assert_eq(read(), 1)
    assert_eq(v.y.z.n, 4)
}

test "derived Eq, Ord and Hash read through the boxes" {
    assert(chain(1, 2) == chain(1, 2), "equal chains")
    assert(chain(1, 2) != chain(1, 3), "a difference behind the boxes")
    assert(chain(1, 2) < chain(1, 3), "order reads the inner value")
    assert(leaf(1) < chain(1, 0), "Nil orders before Has")
    assert_eq(chain(1, 2).hash(), chain(1, 2).hash())
}

test "a derived clone is a value" {
    let x = chain(1, 2)
    let mut c = x.clone()
    c.y.z.n = 3
    assert_eq(x.y.z.n, 1)
    assert(c != x, "the clone changed and the original did not")
}

test "derived Debug and a written Display read through the boxes" {
    assert_eq(leaf(4).debug(), "X \{ y: Y \{ z: Z \{ n: 4, back: Nil } } }")
    assert_eq("{chain(1, 2).y.z}", "1 -> 2")
}

test "a recursive value goes to JSON and back" {
    let x = chain(1, 2)
    let back = X.from_json(x.to_json()).unwrap()
    assert(back == x, "the round trip gives the same value")
}

test "a generic cycle at two instances" {
    let a = GNode { v: 1, link: GLink.Has(GNode { v: 2, link: GLink.Nil }) }
    let b: GNode[Str] = GNode { v: "p", link: GLink.Nil }
    assert_eq(g_len(a), 2)
    assert_eq(g_len(b), 1)
    assert(a == GNode { v: 1, link: GLink.Has(GNode { v: 2, link: GLink.Nil }) }, "equal generic chains")
    let mut c = a
    c.v = 7
    assert_eq(a.v, 1)
}
