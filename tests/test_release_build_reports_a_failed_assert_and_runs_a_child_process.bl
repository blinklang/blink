// A release build (-O2) calls the runtime's assert-failure and process functions out of line:
// the failed assert still prints its message and exits 1, a passing assert prints nothing,
// and a child process's output, error output and exit code still come back.

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

test "a release build reports a failed assert and runs a child process" {
    let root = sh("pwd -P")
    let dir = "{root}/.tmp/_release_assert_process_{getpid()}"
    shell_exec("rm -rf {dir} && mkdir -p {dir}")
    write_file("{dir}/main.bl", [
        #"fn main() {"#,
        #"    let r = process_run("sh", ["-c", "printf out; printf err >&2; exit 3"])"#,
        #"    io.println("child {r.out} {r.err_out} {r.exit_code}")"#,
        #"    let n = r.exit_code + 39"#,
        #"    assert(n == 42, "n is {n}")"#,
        #"    assert_eq(n, 42)"#,
        #"    io.println("passed")"#,
        #"    assert_eq(n + 1, 42)"#,
        #"    io.println("not reached")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    let b = process_run("sh", ["-c", "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE build/blink build --release {dir}/main.bl -o {dir}/app"])
    assert(b.exit_code == 0, "release build failed: {b.out}{b.err_out}")
    let r = process_run("{dir}/app", [])
    shell_exec("rm -rf {dir}")
    assert_eq(r.out, "child out err 3\npassed\n")
    assert_eq(r.err_out.trim(), "ASSERT_EQ FAILED: 43 != 42 (line 8)")
    assert_eq(r.exit_code, 1)
}
