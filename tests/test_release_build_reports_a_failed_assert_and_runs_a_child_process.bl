// A release build (-O2) calls the runtime's assert-failure and process functions out of line:
// the failed assert still prints its message and exits 1, a passing assert prints nothing,
// and a child process's output, error output and end still come back.

import compile_test_helpers
import std.process.{ChildEnd}

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

test "a release build reports a failed assert and runs a child process" {
    let root = sh("pwd -P")
    let dir = "{compile_test_helpers.scratch_root()}/_release_assert_process_{getpid()}"
    shell_exec("rm -rf {dir} && mkdir -p {dir}")
    write_file("{dir}/main.bl", [
        #"import std.process.{ChildEnd}"#,
        #""#,
        #"fn main() {"#,
        #"    let r = process.run("sh", ["-c", "printf out; printf err >&2; exit 3"]).unwrap()"#,
        #"    io.println("child {r.out} {r.err_out} {r.end}")"#,
        #"    let n = if r.end == ChildEnd.Exited(3) { 42 } else { 0 }"#,
        #"    assert(n == 42, "n is {n}")"#,
        #"    assert_eq(n, 42)"#,
        #"    io.println("passed")"#,
        #"    assert_eq(n + 1, 42)"#,
        #"    io.println("not reached")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    let b = process.run("sh", ["-c", "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE build/blink build --release {dir}/main.bl -o {dir}/app"])?
    assert(b.success(), "release build failed: {b.out}{b.err_out}")
    let r = process.run("{dir}/app", [])?
    shell_exec("rm -rf {dir}")
    assert_eq(r.out, "child out err exit 3\npassed\n")
    assert_eq(r.err_out.trim(), "ASSERT_EQ FAILED: 43 != 42 (line 10)")
    assert_eq(r.end, ChildEnd.Exited(1))
}
