// The spec strips test blocks and their @tags from release builds; only `blink test` keeps
// them. A `--release` binary must hold no test body, no name or tag table, and no `--test`
// hook, in the one-unit and the per-module emit modes alike. What a plain `blink build`
// (no --release) does is an open spec question, so no row here pins it.

import compile_test_helpers

let FIXTURE: Str = "fn helperonlyfortests(x: Int) -> Int \{ x * 3 }

fn identonlyfortests[T](x: T) -> T \{ x }

fn main() ! IO \{
    io.println(\"main ran\")
}

test \"triples a number\" \{
    assert_eq(helperonlyfortests(2), 6)
    assert_eq(identonlyfortests(2.5), 2.5)
}

@tags(\"slow\", \"unit_tag_marker\")
test \"tagged test name marker\" \{
    assert_panics \{ panic(\"boom\") }
}
"

let BROKEN_TEST_BODY: Str = "fn main() ! IO \{
    io.println(\"main ran\")
}

test \"has a type error\" \{
    let n: Int = \"not an int\"
    assert_eq(n, 1)
}
"

fn scratch(tag: Str) -> Str {
    let dir = "{compile_test_helpers.scratch_root()}/_release_strips_{tag}_{getpid()}"
    shell_exec("rm -rf {dir} && mkdir -p {dir}")
    write_file("{dir}/test_strip_fixture.bl", FIXTURE)
    dir
}

// Each marker is a test-only part: a body or tag table symbol, the name table, the runner
// entry (static, so only the emitted C names it), the test name string and a tag string.
fn test_parts_in(text: Str) -> List[Str] {
    let mut found: List[Str] = []
    for marker in ["blink_test__", "__blink_tests", "__blink_run_tests", "triples a number", "unit_tag_marker"] {
        if text.contains(marker) {
            found.push(marker)
        }
    }
    found
}

// The emitted C still defines the functions only tests call, as it defines any function
// nothing calls; a release binary must not hold them, nor the test runner the runtime keeps
// for `--test`. The fixture names hold no `_`, so their C symbols keep them whole.
fn binary_test_parts(bin: Str) -> List[Str] {
    let r = process_run("sh", ["-c", "nm {bin}; strings -a {bin}"])
    // Without it, a missing nm or strings would pass every row.
    assert(r.out.contains("main ran"), "nm and strings saw nothing of {bin}: {r.err_out}")
    let mut found = test_parts_in(r.out)
    for marker in ["helperonlyfortests", "identonlyfortests", "blink_test_run"] {
        if r.out.contains(marker) {
            found.push(marker)
        }
    }
    found
}

fn assert_release_binary_has_no_tests(bin: Str) {
    let parts = binary_test_parts(bin)
    assert(parts.len() == 0, "release binary {bin} still holds test parts: {parts.join(", ")}")
    let run = process_run(bin, ["--test"])
    assert_eq(run.exit_code, 0)
    assert_eq(run.out.trim(), "main ran")
}

test "a release build emits C with no test body, name table, tag table or --test hook" {
    let dir = scratch("emit")
    let b = process_run("build/blink", ["build", "--release", "--emit", "c", "{dir}/test_strip_fixture.bl", "-o", "{dir}/out"])
    assert_eq(b.exit_code, 0)
    let c = read_file("{dir}/out.c")
    assert(c.contains("main ran"), "emitted C lacks main's body")
    let parts = test_parts_in(c)
    assert(parts.len() == 0, "release C still holds test parts: {parts.join(", ")}")
    assert(!c.contains("\"--test\""), "release C still checks argv for --test")
    shell_exec("rm -rf {dir}")
}

test "a one-unit release binary holds no test part and ignores --test" {
    let dir = scratch("one")
    let b = process_run("build/blink", ["build", "--release", "--no-per-module", "{dir}/test_strip_fixture.bl", "-o", "{dir}/bin"])
    assert_eq(b.exit_code, 0)
    assert_release_binary_has_no_tests("{dir}/bin")
    shell_exec("rm -rf {dir}")
}

test "a per-module release binary holds no test part and ignores --test" {
    let dir = scratch("pm")
    let b = process_run("build/blink", ["build", "--release", "{dir}/test_strip_fixture.bl", "-o", "{dir}/bin"])
    assert_eq(b.exit_code, 0)
    assert_release_binary_has_no_tests("{dir}/bin")
    shell_exec("rm -rf {dir}")
}

// A per-module build may take the whole emit of the last build to the same output, and the
// units of a build with the same inputs. Units that hold tests and units that leave them out
// must never stand in for each other. Release forces one decl per chunk; the plain builds ask
// for the same, so the two builds differ in nothing else.
fn build_with_cache(dir: Str, flags: Str) {
    let r = process_run("sh", ["-c", "BLINK_UNIT_CHUNK_DECLS=0 BLINK_CACHE_DIR={dir}/cache build/blink build {flags} --per-module {dir}/test_strip_fixture.bl -o {dir}/bin"])
    assert_eq(r.exit_code, 0)
}

test "a release build after a plain build of the same output reuses no unit that holds tests" {
    let dir = scratch("reuse")
    build_with_cache(dir, "")
    build_with_cache(dir, "--release")
    assert_release_binary_has_no_tests("{dir}/bin")
    shell_exec("rm -rf {dir}")
}

test "a plain build after a release build of the same output matches a cold plain build" {
    let cold = scratch("cold")
    build_with_cache(cold, "")
    let want = binary_test_parts("{cold}/bin")
    let dir = scratch("warm")
    build_with_cache(dir, "--release")
    build_with_cache(dir, "")
    let got = binary_test_parts("{dir}/bin")
    assert_eq(got.join(", "), want.join(", "))
    shell_exec("rm -rf {cold} {dir}")
}

test "a release build after a debug build of the same output holds no test part" {
    let dir = scratch("debug")
    let env_cache = "BLINK_CACHE_DIR={dir}/cache"
    let debug = process_run("sh", ["-c", "{env_cache} build/blink build --debug --per-module {dir}/test_strip_fixture.bl -o {dir}/bin"])
    assert_eq(debug.exit_code, 0)
    let rel = process_run("sh", ["-c", "{env_cache} build/blink build --release --per-module {dir}/test_strip_fixture.bl -o {dir}/bin"])
    assert_eq(rel.exit_code, 0)
    assert_release_binary_has_no_tests("{dir}/bin")
    shell_exec("rm -rf {dir}")
}

test "blink test still runs the tests of the file a release build strips" {
    let dir = scratch("keep")
    // The directory form: a single-file `blink test` of a file with `fn main` runs main.
    let r = process_run("build/blink", ["test", "--json", dir])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("\"total\":2,\"passed\":2"), "blink test output: {r.out}")
    assert(r.out.contains("\"tags\":[\"slow\",\"unit_tag_marker\"]"), "blink test lost the tags: {r.out}")
    shell_exec("rm -rf {dir}")
}

test "a type error in a test body still fails a release build and check" {
    let dir = scratch("err")
    write_file("{dir}/broken_test_body.bl", BROKEN_TEST_BODY)
    let b = process_run("build/blink", ["build", "--release", "{dir}/broken_test_body.bl", "-o", "{dir}/bin"])
    assert(b.exit_code != 0, "release build accepted a type error in a test body")
    let c = process_run("build/blink", ["check", "{dir}/broken_test_body.bl"])
    assert(c.exit_code != 0, "check accepted a type error in a test body")
    shell_exec("rm -rf {dir}")
}
