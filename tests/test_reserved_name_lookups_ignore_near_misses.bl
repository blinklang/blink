import std.path.{path_stem as stem_of}

// Names one byte away from a keyword, a builtin function or a builtin type are plain
// identifiers: the compiler's name tables must not match on length or prefix.
type Maps { n: Int }
type Sets { n: Int }
type Rawr { n: Int }
type Intx { n: Int }
type Handlers { n: Int }
type Selfie { n: Int }

fn exit_code(x: Int) -> Int { x + 1 }
fn getpid2() -> Int { 7 }
fn time_ms_x() -> Int { 9 }
fn arg_counts() -> Int { 3 }
fn assert_equal(a: Int, b: Int) -> Int { a + b }
fn assert_panic(a: Int) -> Int { a * 2 }
fn skips(a: Int) -> Int { a - 1 }

test "identifiers one byte off a keyword stay identifiers" {
    let fns = 1
    let lets = 2
    let mut mutt = 3
    let consts = 4
    let types = 5
    let iff = 6
    let elsee = 7
    let matches = 8
    let fo = 9
    let inn = 10
    let whilee = 11
    let loops = 12
    let breaks = 13
    let continues = 14
    let returns = 15
    let pubs = 16
    let withs = 17
    let handlerr = 18
    let selfs = 19
    let tests = 20
    let imports = 21
    let ass = 22
    let mods = 23
    let effects = 24
    mutt = mutt + 1
    let total = fns + lets + mutt + consts + types + iff + elsee + matches + fo + inn + whilee + loops + breaks + continues + returns + pubs + withs + handlerr + selfs + tests + imports + ass + mods + effects
    assert_eq(total, 301)
}

test "declarations named one byte off a builtin resolve to the declaration written" {
    assert_eq(exit_code(1), 2)
    assert_eq(getpid2(), 7)
    assert_eq(time_ms_x(), 9)
    assert_eq(arg_counts(), 3)
    assert_eq(assert_equal(2, 3), 5)
    assert_eq(assert_panic(4), 8)
    assert_eq(skips(4), 3)
}

test "types named one byte off a builtin type resolve to the type written" {
    let a = Maps { n: 1 }
    let b = Sets { n: 2 }
    let c = Rawr { n: 3 }
    let d = Intx { n: 4 }
    let e = Handlers { n: 5 }
    let f = Selfie { n: 6 }
    assert_eq(a.n + b.n + c.n + d.n + e.n + f.n, 21)
}

test "builtin types and builtin functions still resolve" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let mut s: Set[Int] = Set()
    s.insert(5)
    let o: Option[Int] = Some(3)
    let r: Result[Int, Str] = Ok(4)
    assert_eq(m.get("a") ?? 0, 1)
    assert_eq(s.len(), 1)
    assert_eq(o ?? 0, 3)
    assert_eq(r.unwrap(), 4)
}

test "an aliased selective import binds under the alias" {
    assert_eq(stem_of("a/b.bl"), "b")
}

test "intrinsic string and list methods resolve to the standard library" {
    let mut sb = StringBuilder.new()
    sb.write("ab")
    sb.write("cd")
    assert_eq(sb.to_str(), "abcd")
    let xs = [3, 1, 2]
    assert_eq(xs.slice(1, 3).len(), 2)
    assert_eq("17".to_int(), 17)
}
