// Regression for 3ahkvq (Result variant): an `Ok`/`Err` constructor passed as a
// call argument must adopt the parameter's expected Result[Box, Str] type rather
// than defaulting the unspecified side to a scalar carrier.
type Box { val: Int }

fn unwrap_or_default(r: Result[Box, Str]) -> Box {
    match r {
        Ok(b) => { b }
        Err(e) => { Box { val: -1 } }
    }
}

test "Ok call-arg adopts Result[Box, Str] param type" {
    assert_eq(unwrap_or_default(Ok(Box { val: 5 })).val, 5)
}

test "Err call-arg adopts Result[Box, Str] param type" {
    assert_eq(unwrap_or_default(Err("boom")).val, -1)
}
