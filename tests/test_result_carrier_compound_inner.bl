// br xnacxw — top-level Result carrier over a COMPOUND inner. A generic fn
// `fn wrap[K,V](m: Map[K,V]) -> Result[Map[K,V], Str] { Ok(m) }` had the mono
// SIGNATURE spell the Result carrier from the erasing flat channels
// (blink_Result_map_str) while the return expression spelled it faithfully
// (blink_Result_Map_str_int_str) — disagreeing C in one TU = cc failure. The
// CT_RESULT signature arm handled only struct/enum inners; a compound inner
// (Map/List/Set/Option/Result) erased. Fix routes the compound ok/err inner
// through compound_name_from_ann_ctx, mirroring the CT_OPTION arm.

fn wrap[K, V](m: Map[K, V]) -> Result[Map[K, V], Str] { Ok(m) }

test "top-level Result carrier keeps its Map inner K,V" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 7)
    let r = wrap(m)
    let mut got = 0
    match r {
        Ok(inner) => { got = inner.get("k").unwrap() }
        Err(_) => { got = -1 }
    }
    assert_eq(got, 7)
}

fn wrap_list[T](xs: List[T]) -> Result[List[T], Str] { Ok(xs) }

test "top-level Result carrier keeps its List inner element" {
    let xs: List[Int] = [3, 4, 5]
    let r = wrap_list(xs)
    let mut sum = 0
    match r {
        Ok(inner) => { for x in inner { sum = sum + x } }
        Err(_) => { sum = -1 }
    }
    assert_eq(sum, 12)
}
