// `Result[T, E]` is `Eq` when both `T` and `E` are (sections/03_types.md, *Container
// Equality*): equal when both are `Ok` with `==` payloads or both are `Err` with `==`
// payloads. `Option[T]` over a type parameter compares once the parameter has `Eq`.

type Color {
    Red
    Green
}

fn same[T: Eq](a: Option[T], b: Option[T]) -> Bool {
    a == b
}

test "Result compares tag first, then the payload" {
    let a: Result[Int, Str] = Ok(1)
    let b: Result[Int, Str] = Ok(1)
    let c: Result[Int, Str] = Ok(2)
    let d: Result[Int, Str] = Err("x")
    let e: Result[Int, Str] = Err("x")
    let f: Result[Int, Str] = Err("y")
    assert(a == b)
    assert(a != c)
    assert(a != d)
    assert(d == e)
    assert(d != f)
}

test "Result over a payload-free enum compares by variant" {
    let a: Result[Int, Color] = Err(Color.Red)
    let b: Result[Int, Color] = Err(Color.Red)
    let c: Result[Int, Color] = Err(Color.Green)
    assert(a == b)
    assert(a != c)
}

test "Option over a bounded type parameter compares by value" {
    assert(same(Some(1), Some(1)))
    assert(!same(Some(1), Some(2)))
    assert(!same(Some("a"), None))
    let none: Option[Str] = None
    assert(same(none, None))
}
