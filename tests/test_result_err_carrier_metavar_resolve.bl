// A mut Result carrier that is born Ok leaves its err slot an unbound metavar; a
// later `x = Err(...)` PINS that slot to a metavar (kind Unknown, inner1 -> the
// solution) rather than a concrete tid. get_var_result_err reads the err CT off
// the tid, and the tid reader must RESOLVE that bound metavar before taking the
// CT — a raw read declines it (-1), and with the flat err channel now retired the
// err binder would spell the wrong C. The Err binder is read through .len(), which
// needs the err CT recovered as CT_STR, so a mistyped err slot fails to compile.

fn pin_str_err() -> Int {
    let mut x = Ok(3)
    x = Err("boom")
    match x { Ok(v) => v Err(e) => e.len() }
}

test "a mut Result with a metavar-pinned Str err reads the err len back" {
    assert_eq(pin_str_err(), 4)
}
