// A scalar-slotted Result binder can be pushed before its ok/err types are known
// (a reassigned mut var), landing on an unresolved tid. The later set_var_result
// update must reconstruct the exact carrier from the ok/err CTs alone — the plain
// entry carries no struct name, so a scalar Result must round-trip through it with
// the carrier intact. These rows drive that update path and pin the reconstructed
// carrier by unwrapping the value it produced.

fn classify(n: Int) -> Result[Int, Str] {
    if n > 0 { Ok(n) } else { Err("neg") }
}

test "a match-expr Result temp reconstructs its scalar carrier on update" {
    let r = match 3 {
        0 => Ok(100)
        _ => Err("other")
    }
    assert(!r.is_ok())
    let ok = match 0 {
        0 => Ok(100)
        _ => Err("other")
    }
    assert(ok.is_ok())
    assert_eq(ok.unwrap(), 100)
}

test "a reassigned mut scalar Result keeps its carrier across sets" {
    let mut r: Result[Int, Str] = Ok(1)
    r = classify(9)
    assert(r.is_ok())
    assert_eq(r.unwrap(), 9)
    r = Err("stop")
    assert(!r.is_ok())
}

test "a Result[Void, Str] scalar carrier round-trips the plain update" {
    let mut r: Result[Void, Str] = Err("x")
    r = Ok(())
    assert(r.is_ok())
}
