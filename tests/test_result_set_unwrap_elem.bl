// 811c4b: Result[Set[T], E].unwrap() must keep the Set's element metadata, so a
// for-in over the unwrapped set knows its element type. Without it the unwrapped
// set temp carries no element and the loop ICEs (SetElementTypeUnknownAtCodegen).
// Mirrors the Option-side fix (fyat2w): a fill-only stamp from the unwrap node's
// own tid, which head-CT agreement keeps from stamping a neighbouring list.

fn make_ints() -> Result[Set[Int], Str] {
    let mut s = Set()
    s.insert(3)
    s.insert(4)
    Ok(s)
}

fn make_strs() -> Result[Set[Str], Str] {
    let mut s = Set()
    s.insert("a")
    s.insert("b")
    Ok(s)
}

test "Result[Set[Int]].unwrap() iterates the Set element" {
    let mut total = 0
    for x in make_ints().unwrap() {
        total = total + x
    }
    assert_eq(total, 7)
}

test "Result[Set[Str]].unwrap() keeps the Str element for .contains" {
    let s = make_strs().unwrap()
    assert_eq(s.contains("a"), true)
    assert_eq(s.contains("z"), false)
}
