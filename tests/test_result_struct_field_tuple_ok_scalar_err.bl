// A struct field whose type is Result[(Int, Int), Int] (a tuple-stem Ok payload
// paired with a scalar Err) must keep its own Result carrier type, not collapse
// to a bare `int` field. canonical_struct_tag's right-to-left separator scan over
// the combined "Result_Tuple2_int_int_int" tag picks the wrong boundary between
// the Ok and Err halves, corrupting the field's declared C type.

import compile_test_helpers.{compile_and_run}

test.failing(
    "struct field of type Result[(Int,Int), Int] keeps its Result carrier type for the Err case",
    reason: "canonical_struct_tag's right-to-left separator scan mis-splits the combined Result tag for a tuple-stem Ok + scalar Err, so the struct field's C type erases to a bare int and the Err initializer fails to compile",
    ticket: "0wasdd",
) {
    let src = #"
type Box { r: Result[(Int, Int), Int] }

fn main() ! IO {
    let err_box = Box { r: Err(9) }
    match err_box.r {
        Ok(v) => io.println("ok {v.0} {v.1}")
        Err(e) => io.println("err {e}")
    }
}
"#
    let r = compile_and_run(src, "_result_struct_field_tuple_ok_scalar_err")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "err 9\n")
}

test "struct field of type Result[(Int,Int), Int] keeps its Result carrier type for the Ok case" {
    // The Ok-constructed case for the same field type already builds and runs
    // correctly today; kept here as a plain test so the file documents the
    // asymmetry (only the Err-first construction hits the mis-split above).
    let src = #"
type Box { r: Result[(Int, Int), Int] }

fn main() ! IO {
    let ok_box = Box { r: Ok((3, 4)) }
    match ok_box.r {
        Ok(v) => io.println("ok {v.0} {v.1}")
        Err(e) => io.println("err {e}")
    }
}
"#
    let r = compile_and_run(src, "_result_struct_field_tuple_ok_scalar_err_okcase")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok 3 4\n")
}
