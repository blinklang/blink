// Unwrapping a Result whose OK arm is a transparent newtype (a single-Int
// payload enum lowering to a bare int64_t) yields the correct scalar value.

type Errno { Errno(Int) }
fn parse_ok() -> Result[Errno, Str] { Ok(Errno(9)) }

test "result newtype-ok unwrap" {
    let r = parse_ok()
    let e = r.unwrap()
    let n = match e { Errno(x) => x }
    assert_eq(n, 9)
}
