// `.unwrap()` has no Display requirement on the arm it panics on, so a program whose Err arm
// has no Display impl compiles and panics with the arm's type name as a placeholder. An arm
// with a Display impl renders through it, and a scalar arm prints as it stands.

fn run_program(src: Str, tag: Str) -> Str {
    let path = ".tmp/{tag}.bl"
    write_file(path, src)
    let r = process_run("build/blink", ["run", path])
    fs_remove(path)
    "{r.out}{r.err_out}"
}

fn expect_says(out: Str, needle: Str, label: Str) {
    if out.contains("internal compiler error") || !out.contains(needle) {
        io.println("FAIL: {label}: expected '{needle}', got:")
        io.println(out)
    }
    assert(!out.contains("internal compiler error"))
    assert(out.contains(needle))
}

test "unwrap over an enum Err arm with no Display impl names the enum" {
    let src = "type MyError \{ NotFound(msg: Str) }\n\nfn main() \{\n    let r: Result[Int, MyError] = Err(NotFound(msg: \"x\"))\n    io.println(\"got \{r.unwrap()}\")\n}\n"
    expect_says(run_program(src, "_panic_arm_enum"), "unwrap called on Err: <MyError> at ", "enum arm")
}

test "unwrap over a struct Err arm with no Display impl names the struct" {
    let src = "type Woe \{ code: Int }\n\nfn main() \{\n    let r: Result[Int, Woe] = Err(Woe \{ code: 1 })\n    io.println(\"got \{r.unwrap()}\")\n}\n"
    expect_says(run_program(src, "_panic_arm_struct"), "unwrap called on Err: <Woe> at ", "struct arm")
}

test "unwrap_err over a struct Ok arm with no Display impl names the struct" {
    let src = "type Item \{ name: Str }\n\nfn main() \{\n    let r: Result[Item, Int] = Ok(Item \{ name: \"t\" })\n    io.println(\"got \{r.unwrap_err()}\")\n}\n"
    expect_says(run_program(src, "_panic_arm_ok_struct"), "unwrap_err called on Ok: <Item> at ", "ok struct arm")
}

test "unwrap over an Err arm with a Display impl renders through the impl" {
    let src = "type Boom \{ code: Int }\n\nimpl Display for Boom \{\n    fn fmt(self, sb: StringBuilder) \{ sb.write(\"boom-\{self.code}\") }\n}\n\nfn main() \{\n    let r: Result[Int, Boom] = Err(Boom \{ code: 42 })\n    io.println(\"got \{r.unwrap()}\")\n}\n"
    expect_says(run_program(src, "_panic_arm_display"), "unwrap called on Err: boom-42 at ", "display arm")
}

test "unwrap over a scalar Err arm prints the value" {
    let src = "fn main() \{\n    let r: Result[Str, Int] = Err(7)\n    io.println(\"got \{r.unwrap()}\")\n}\n"
    expect_says(run_program(src, "_panic_arm_scalar"), "unwrap called on Err: 7 at ", "scalar arm")
}
