// Result[T, E].unwrap() on an Err whose payload is a struct must compile (the
// panic-message render must not cast the struct aggregate to an integer) and
// must panic, per spec, rather than silently default the value.

type Payload { n: Int }
type Woe { code: Int }

test "Result[Struct, Struct].unwrap on Err panics without a bad struct-to-int cast" {
    assert_panics(matching: "unwrap called on Err") {
        let r: Result[Payload, Woe] = Err(Woe { code: 1 })
        let _ = r.unwrap()
    }
}

test "Result[Struct, Struct].unwrap_err on Ok panics without a bad struct-to-int cast" {
    assert_panics(matching: "unwrap_err called on Ok") {
        let r: Result[Payload, Woe] = Ok(Payload { n: 9 })
        let _ = r.unwrap_err()
    }
}
