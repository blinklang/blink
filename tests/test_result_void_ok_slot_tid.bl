// jctkac (tid-sole-authority, flat-field deletion). get_var_result_ok/err read the
// ok/err CT of a Result carrier. A Result[Void, _] carrier is the pivotal holdout:
// the tid historically declined to encode a Void inner, so the flat inner1/inner2
// channel was the sole authority for it. Once Void becomes tid-authoritative and the
// flat fallback is deleted, these carriers must still codegen and run correctly:
//   - Result[Void, Str] bound to a local, matched         -> ok slot is Void
//   - Result[Void, Struct] bound to a local, matched      -> ok Void, err struct (cascade)
//   - Result[Void, Str] propagated with `?`               -> ok Void through the ? carrier
//   - Result[Int, Void]                                   -> err slot is Void
// A wrong CT after the flip fails to compile or produces a wrong runtime answer.

type VErr {
    code: Int
    msg: Str
}

fn vr_str(fail: Bool) -> Result[Void, Str] {
    if fail { return Err("boom") }
    Ok(())
}

fn vr_struct(fail: Bool) -> Result[Void, VErr] {
    if fail { return Err(VErr { code: 7, msg: "nope" }) }
    Ok(())
}

fn vr_int_void_err(fail: Bool) -> Result[Int, Void] {
    if fail { return Err(()) }
    Ok(42)
}

fn chain() -> Result[Void, Str] {
    let _step = vr_str(false)?
    Ok(())
}

test "Result[Void, Str] local matches Ok and Err arms" {
    let ok = vr_str(false)
    match ok {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    let bad = vr_str(true)
    match bad {
        Ok(_) => assert(false)
        Err(m) => assert_eq(m, "boom")
    }
}

test "Result[Void, Struct] local carries a struct err beside a Void ok" {
    let ok = vr_struct(false)
    match ok {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    let bad = vr_struct(true)
    match bad {
        Ok(_) => assert(false)
        Err(e) => {
            assert_eq(e.code, 7)
            assert_eq(e.msg, "nope")
        }
    }
}

test "Result[Void, Str] propagates through the ? carrier" {
    match chain() {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
}

test "Result[Int, Void] carries a Void err beside an Int ok" {
    let ok = vr_int_void_err(false)
    match ok {
        Ok(v) => assert_eq(v, 42)
        Err(_) => assert(false)
    }
    let bad = vr_int_void_err(true)
    match bad {
        Ok(_) => assert(false)
        Err(_) => assert(true)
    }
}
