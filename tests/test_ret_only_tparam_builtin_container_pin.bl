// A generic fn whose type parameter appears ONLY in the return type must have that
// type parameter pinned by a fully-annotated call site (`let x: Container[Int] = mk()`)
// for List[T], Option[T] and Result[T,E], the same way it already works for Map[K,T],
// Set[T] and user generic structs.

import compile_test_helpers.{compile_and_run}

fn mk_opt[T]() -> Option[T] { None }
fn mk_res[T]() -> Result[T, Str] { Err("boom") }

test.failing(
    "return-only type param under a List[T] return builds at an annotated call site",
    reason: "tc_pin_admits_declared does not admit TK_LIST, so T reaches monomorphization unsolved and the compiler ICEs (I0001) instead of building",
    ticket: "nbybr2",
) {
    let src = #"
fn mk[T]() -> List[T] { [] }
fn main() ! IO {
    let x: List[Int] = mk()
    io.println("{x.len()}")
}
"#
    let r = compile_and_run(src, "_ret_only_tparam_list_pin")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "0\n")
}

test "return-only type param under an Option[T] return builds at an annotated call site" {
    let x: Option[Int] = mk_opt()
    assert(x.is_none())
}

test "return-only type param under a Result[T,E] return builds at an annotated call site" {
    let x: Result[Int, Str] = mk_res()
    assert(x.is_err())
    assert_eq(x.unwrap_err(), "boom")
}
