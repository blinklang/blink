// A construct of type Never produces no value and satisfies any expected type
// (sections/03_types.md *Never*), so `return` of one compiles under any return type and leaves.

import compile_test_helpers

fn panics_with(src: Str, want: Str, tag: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let run = compile_test_helpers.compile_and_run(src, tag)
    assert_eq(run.exit_code, 101)
    compile_test_helpers.expect_contains(run.err_out, want, tag)
}

test "return of an if whose arms panic, in a fn that returns nothing" {
    panics_with("fn f(c: Bool) \{ return if c \{ panic(\"a\") } else \{ panic(\"b\") } }\nfn main() \{ f(true) }\n", "a", "nvr_if_void")
}

test "return of a match whose arms panic, in a closure that returns nothing" {
    panics_with("fn main() \{ [1].for_each(fn(x) \{ return match x \{ 1 => panic(\"a\")\n _ => panic(\"b\") } }) }\n", "a", "nvr_match_closure")
}

test "return of an if whose arms panic, under a value return" {
    panics_with("fn f(c: Bool) -> Int \{ return if c \{ panic(\"a\") } else \{ panic(\"b\") } }\nfn main() \{ let _x = f(false) }\n", "b", "nvr_if_int")
    panics_with("fn f(c: Bool) -> Str \{ return if c \{ panic(\"a\") } else \{ panic(\"b\") } }\nfn main() \{ let _x = f(true) }\n", "a", "nvr_if_str")
}
