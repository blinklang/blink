// `return e` where `e` has type `()` is legal (sections/03_types.md *`return` with a value*). The
// operand is a value with no C form, so it must run as a statement before the return.

let mut RUV_CALLS = 0

fn ruv_note() { RUV_CALLS = RUV_CALLS + 1 }
fn ruv_literal() { return () }
fn ruv_declared() -> () { return () }
fn ruv_local() -> () {
    let u = ()
    return u
}
fn ruv_call() { return ruv_note() }
fn ruv_early(x: Int) {
    if x > 0 { return ruv_note() }
    ruv_note()
    ruv_note()
}
fn ruv_id[T](x: T) -> T { return x }

test "a fn returns a unit literal or a unit local" {
    ruv_literal()
    ruv_declared()
    ruv_local()
    let _ = ruv_id(())
}

test "a returned unit call runs once" {
    RUV_CALLS = 0
    ruv_call()
    assert_eq(RUV_CALLS, 1)
    ruv_early(1)
    assert_eq(RUV_CALLS, 2)
    ruv_early(0)
    assert_eq(RUV_CALLS, 4)
}

test "a closure returns a unit value" {
    RUV_CALLS = 0
    [1, 2].for_each(fn(x) { return ruv_note() })
    assert_eq(RUV_CALLS, 2)
    let k = fn() { return () }
    k()
}
