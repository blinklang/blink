// rpes5b: get_map_value_struct leads with the authoritative tid
// (tc_tid_map_val_struct_mono) for a concrete generic-struct value, ceding to
// the flat sname2 only for the genuinely-erased bare-typevar generic-fn-return
// case. A directly-annotated Map[Str, Box[Int]] resolves its value struct from
// the tid; the round-trip below would emit an undeclared blink_Box (bare head)
// if the value-slot mono stem were lost. Companion to the erased-case guards
// test_ya0739 / test_wzm47q. Must run archive-linked (task test), not just
// compile -- the failure surfaces at value field access.

type Box[T] {
    value: T
}

test "directly-annotated map struct value round-trips via the tid" {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 42 })
    assert_eq(m.get("k").unwrap().value, 42)
}

test "map struct value survives a concrete-return binding" {
    let m = make_boxmap()
    assert_eq(m.get("a").unwrap().value, 7)
}

fn make_boxmap() -> Map[Str, Box[Int]] {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("a", Box { value: 7 })
    m
}
