// An as-pattern `x as y` over a tuple scrutinee binds BOTH names to the WHOLE
// scrutinee. The top-level tuple-scrutinee fast path pre-expands the tuple into
// one match_scruts entry per element (scrut_len == n_elems), and the AsPattern arm
// bound its own name (`pair`) from element 0 only -- emitting `T pair = _scrut._0;`,
// an element-0 initializer where a whole-tuple bind is required (cc: invalid
// initializer). The arm now reconstructs the whole tuple as a compound literal for
// the as-name, the same way the IdentPattern arm does for a bare whole binder, so
// both names resolve field access. Guards the as-pattern whole-tuple binder.
import compile_test_helpers

test "as-pattern over a let-bound tuple binds both names to the whole tuple" {
    let src = "fn main() \{\n"
        .concat("    let t = (7, 9)\n")
        .concat("    match t \{ pair as whole => io.println(\"\{pair.0\} \{pair.1\} \{whole.0\} \{whole.1\}\") \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_rqcn4g_let_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("7 9 7 9"))
    assert(!r.out.contains("<value>"))
}

test "as-pattern over a tuple literal scrutinee binds both names to the whole tuple" {
    let src = "fn main() \{\n"
        .concat("    match (7, 9) \{ pair as whole => io.println(\"\{pair.1\} \{whole.0\}\") \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_rqcn4g_lit_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("9 7"))
    assert(!r.out.contains("<value>"))
}

test "as-pattern over a struct-field tuple sub-pattern binds both names to the whole tuple" {
    // Single-scrutinee (scrut_len==1) as-pattern whose scrut_sname is a tuple carrier tag:
    // the struct-field tuple sub-pattern `p: pair as whole`. This site is served by the
    // scrut_len==1 branch, not the pre-expanded fast path, so it exercises the new tuple arm of
    // stamp_whole_binder_from_tid intercepting a scrut_sname-tuple binder (formerly a flat
    // set_var_struct write). Both names bind field p's whole tuple value.
    let src = "type TP \{ p: (Int, Int) \}\n"
        .concat("fn main() \{\n")
        .concat("    let t = TP \{ p: (5, 6) \}\n")
        .concat("    match t \{ TP \{ p: pair as whole \} => io.println(\"\{pair.0\} \{pair.1\} \{whole.0\} \{whole.1\}\") \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_rqcn4g_field_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("5 6 5 6"))
    assert(!r.out.contains("<value>"))
}

test "as-pattern over a struct-element tuple resolves nested field access on both names" {
    let src = "type TP \{ x: Int, y: Int \}\n"
        .concat("fn main() \{\n")
        .concat("    let t = (TP \{ x: 5, y: 6 \}, 7)\n")
        .concat("    match t \{ pair as whole => \{\n")
        .concat("        let a = pair.0\n")
        .concat("        let b = whole.0\n")
        .concat("        io.println(\"\{a.x\} \{b.y\} \{whole.1\}\")\n")
        .concat("    \} \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_rqcn4g_struct_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("5 6 7"))
    assert(!r.out.contains("<value>"))
}
