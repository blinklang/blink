// `blink run` and `blink test` read `--format` as check, build and fmt do. A value they do not
// know is a usage error: the command prints the valid values on stderr, exits 1, and builds
// nothing, so no diagnostic of the file shows up and no build/ directory is made. `--json`
// beside `--format human` asks for two formats at once, which is a usage error too. The
// commands run in a fresh temporary directory, since the test tree itself sits inside a
// project.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn scratch() -> Str {
    let dir = sh("mktemp -d /tmp/blink_run_test_format.XXXXXX").out.trim()
    write_file("{dir}/err.bl", "fn main() \{\n    let x: Int = \"s\"\n    io.println(\"\{x}\")\n}\n")
    write_file("{dir}/err_test.bl", "test \"t\" \{\n    let x: Int = \"s\"\n    assert_eq(x, 1)\n}\n")
    dir
}

fn run_in(dir: Str, cmd: Str) -> ProcessResult {
    sh("R=$(pwd); cd {dir} && timeout 120 {cmd}")
}

// What is wrong with the result of a rejected --format, or "".
fn rejected(label: Str, r: ProcessResult, text: Str) -> Str {
    if r.end != ChildEnd.Exited(1) { return "`{label}` ended with {r.end}, not 1\nstdout:\n{r.out}\nstderr:\n{r.err_out}" }
    if r.out != "" { return "`{label}` printed on stdout:\n{r.out}" }
    if !r.err_out.contains(text) { return "`{label}` stderr has no `{text}`:\n{r.err_out}" }
    if r.err_out.contains("E0300") || r.err_out.contains("TypeError") { return "`{label}` checked the file:\n{r.err_out}" }
    ""
}

test "an unknown --format value on run and test exits 1 with the valid values and builds nothing" {
    let dir = scratch()
    let msg = "error: --format must be json or human, got 'xyz'"
    let mut wrong: List[Str] = []
    wrong.push(rejected("run --format xyz err.bl", run_in(dir, "$R/build/blink run --format xyz err.bl"), msg))
    wrong.push(rejected("run err.bl --format text", run_in(dir, "$R/build/blink run err.bl --format text"), "error: --format must be json or human, got 'text'"))
    wrong.push(rejected("run --json --format xyz err.bl", run_in(dir, "$R/build/blink run --json --format xyz err.bl"), msg))
    wrong.push(rejected("test --format xyz err_test.bl", run_in(dir, "$R/build/blink test --format xyz err_test.bl"), msg))
    wrong.push(rejected("test --format xyz (a directory)", run_in(dir, "$R/build/blink test --format xyz ."), msg))
    let built = sh("ls -A {dir}").out
    let _ = sh("rm -rf {dir}")
    let found: List[Str] = wrong.filter(fn(w) { w != "" })
    assert_eq(found.join("\n"), "")
    assert_eq(built.trim(), "err.bl\nerr_test.bl")
}

test "--json beside --format human on run and test is a usage error that builds nothing" {
    let dir = scratch()
    let msg = "error: --json conflicts with --format human"
    let mut wrong: List[Str] = []
    wrong.push(rejected("run --json --format human err.bl", run_in(dir, "$R/build/blink run --json --format human err.bl"), msg))
    wrong.push(rejected("test --json --format human err_test.bl", run_in(dir, "$R/build/blink test --json --format human err_test.bl"), msg))
    let built = sh("ls -A {dir}").out
    let _ = sh("rm -rf {dir}")
    let found: List[Str] = wrong.filter(fn(w) { w != "" })
    assert_eq(found.join("\n"), "")
    assert_eq(built.trim(), "err.bl\nerr_test.bl")
}

test "--format human on run and test is the default" {
    let dir = scratch()
    let mut wrong: List[Str] = []
    let pairs = [("run", "err.bl"), ("test", "err_test.bl")]
    for p in pairs {
        let (cmd, file) = p
        let plain = run_in(dir, "$R/build/blink {cmd} {file}")
        let human = run_in(dir, "$R/build/blink {cmd} --format human {file}")
        if plain.end != human.end || plain.out != human.out || plain.err_out != human.err_out {
            wrong.push("{cmd}: --format human differs from the default\n{human.err_out}\n-- vs --\n{plain.err_out}")
        }
        if !human.err_out.contains("error[TypeError]") { wrong.push("{cmd}: no human diagnostic:\n{human.err_out}") }
    }
    let _ = sh("rm -rf {dir}")
    let found: List[Str] = wrong.filter(fn(w) { w != "" })
    assert_eq(found.join("\n"), "")
}
