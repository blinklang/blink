// Regression for zs3w3y: when a test binary dies from a C-level signal crash
// (SIGSEGV), the per-test lines emitted BEFORE the crash must still reach the
// captured stdout. `blink test` captures each test binary's stdout through a
// pipe, which makes glibc stdout fully block-buffered. Per-test lines
// (`test NAME ... ok/FAIL`) print to stdout; a crash that skips atexit (a real
// SIGSEGV, not a Blink panic — the panic hook longjmps and never bypasses the
// flush) discarded the buffered stdout entirely, so the run read as a total
// wipeout. The runtime now line-buffers stdout (setvbuf _IOLBF) so each
// completed per-test line flushes on its trailing newline and survives.

test "runner crash flushes completed per-test lines to stdout" {
    // Fixture basename must be unique per worker: `build/blink build` writes the
    // compiled binary to `build/<basename>`, and sibling workers racing on the
    // same path hit ETXTBSY ("Text file busy") on execvp.
    let tag = "_test_runner_crash_{getpid()}"
    let fixture = ".tmp/{tag}.bl"
    // c_crash triggers a REAL SIGSEGV via unbounded recursion (stack overflow).
    // A Blink panic would be caught by the test hook and longjmp — it does NOT
    // bypass atexit, so it would not reproduce the buffered-stdout loss. Only a
    // hardware signal that skips the atexit flush exercises this path.
    let src = "fn crash_now() -> Int \{ return crash_now() + 1 \}\n"
              .concat("test \"a_pass\" \{ assert(1 == 1) \}\n")
              .concat("test \"c_crash\" \{ let _v = crash_now()\n  assert(true) \}\n")
    write_file(fixture, src)

    // Build via build/blink so the C compile picks up runtime.h + libs.
    let build_res = process_run("build/blink", ["build", fixture])
    assert_eq(build_res.exit_code, 0)

    // Capture stdout SEPARATELY from stderr — do NOT merge. The whole point is
    // that stdout was discarded while unbuffered stderr survived; merging could
    // mask the bug.
    let run = process_run("build/{tag}", [])
    let diag = "exit_code={run.exit_code}; stdout:\n{run.out}\nstderr:\n{run.err_out}"

    // 1. Fixture guard: prove a genuine SIGSEGV, not a degraded caught-panic.
    //    Signal death is encoded as 128 + WTERMSIG; SIGSEGV=11 -> 139.
    assert_eq(run.exit_code, 139)

    // 2. Load-bearing: the early per-test line was buffered, flushed on its
    //    newline, and survived the crash. RED (empty stdout) without the fix.
    assert(run.out.contains("test a_pass ... "), "a_pass per-test line lost after crash; {diag}")
    assert(run.out.contains("ok"), "a_pass missing ok status; {diag}")

    // Note: no assertion on the case-summary line — a crashed run legitimately
    // never reaches it, and that is correct behavior.

    shell_exec("rm -f build/{tag} {fixture}")
}
