// Spec §2.20 + §8.10: NDJSON failure record for `?` propagation in a
// test body carries cause:"propagated_error" and an error subobject
// with the rendered message and static type name.

test "runner JSON encodes propagated_error cause" {
    let src = "fn fail() -> Result[Int, Str] \{ Err(\"boom\") \}\n" +
              "test \"x\" \{ let _ = fail()?\n  assert_eq(1, 1)\n \}\n"
    write_file(".tmp/_test_runner_qm.bl", src)

    // Build via bin/blink so the C compile picks up runtime.h + libs.
    let build_res = process_run("bin/blink", ["build", ".tmp/_test_runner_qm.bl"])
    assert_eq(build_res.exit_code, 0)

    let run = process_run("build/_test_runner_qm", ["--test-json"])
    assert(run.out.contains("\"cause\":\"propagated_error\""))
    assert(run.out.contains("\"error_type\":\"Str\""))
    assert(run.out.contains("\"message\":\"boom\""))

    shell_exec("rm -f build/_test_runner_qm .tmp/_test_runner_qm.bl")
}
