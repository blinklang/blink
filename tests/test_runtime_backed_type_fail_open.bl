// Typecheck must not fail OPEN to Void for runtime-backed compiler-known types.
//
// `ProcessResult` and `Instant` are std types whose C struct lives in the runtime
// (bootstrap/runtime_process.h, runtime_core.h). A handle operation answers them even in a
// file that never writes `import std.process` or `import std.time`, so typecheck must give
// that call and its binding the std type, never Void. A Void here is invisible at runtime,
// because codegen still names the C struct, so this file asserts typecheck's own tid, not
// runtime behaviour. Harness mirrors tests/test_typecheck_ty_pool_interns_compounds.bl.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_type_str, tc_tid_kind, tc_tid_decl_node, TyKind}
import parser.{node_count, nodes, node_source_module}
import std.io

fn assert_eq_int(got: Int, want: Int, label: Str) {
    if got != want { io.println("FAIL: {label} — got {got}, want {want}") }
    assert(got == want)
}

fn assert_true(got: Bool, label: Str) {
    if !got { io.println("FAIL: {label} — expected true") }
    assert(got)
}

fn find_tid_by_str(want: Str) -> Int {
    let mut idx = 0
    let n = node_count()
    while idx < n {
        let tid = tc_lookup_node_tid(idx)
        if tid >= 0 && tc_type_str(tid) == want {
            return tid
        }
        idx = idx + 1
    }
    -1
}

// Count DISTINCT tid values among every node whose type-string matches `want`. A plain
// linear scan, not a Map insert — a Map keyed by type-string would dedup on its own and
// could never observe two tids for one name (Half B).
fn count_distinct_tids_by_str(want: Str) -> Int {
    let mut distinct: List[Int] = []
    let mut idx = 0
    let n = node_count()
    while idx < n {
        let tid = tc_lookup_node_tid(idx)
        if tid >= 0 && tc_type_str(tid) == want {
            let mut found = false
            let mut j = 0
            while j < distinct.len() {
                if distinct.get(j).unwrap() == tid { found = true }
                j = j + 1
            }
            if !found { distinct.push(tid) }
        }
        idx = idx + 1
    }
    distinct.len()
}

fn count_nodes_by_str(want: Str) -> Int {
    let mut n_hit = 0
    let mut idx = 0
    let n = node_count()
    while idx < n {
        let tid = tc_lookup_node_tid(idx)
        if tid >= 0 && tc_type_str(tid) == want {
            n_hit = n_hit + 1
        }
        idx = idx + 1
    }
    n_hit
}

// Whether THIS test binary can load stdlib modules at all. It often cannot: std.* is
// resolved relative to `path_dirname(env.args().get(0))` (compiler.bl), and `blink test <dir>`
// builds each test binary into `build/<dir>/`, where no `lib/std` sits beside it — while
// `blink test <file>` builds into `build/`, which does have one. So the same test file sees
// a program WITH prelude in one harness mode and WITHOUT it in the other, with only an
// unflushed ModuleNotFound to show for it. Filed separately; the halves below that need a
// real declaration skip rather than assert a mode-dependent answer.
fn stdlib_loadable() -> Bool ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete, Env.Exit, Env.Read, FS.Read, IO, FS.Write {
    let path = "build/runtime_backed_type_fail_open_stdlib_probe.bl"
    fs.write(path, "import std.time\n\nfn main() \{\n    assert(true)\n}\n").unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    // Duration is declared ONLY in lib/std/time.bl — observing its tid proves the module
    // was actually loaded and registered, not merely named in an import.
    find_tid_by_str("Duration") >= 0
}

// ── Half A — the process handle operations, with NO `import std.process` ────────────
//
// The field reads are load-bearing, not decoration: they are how this test asserts the
// fields are registered too. A ProcessResult tid whose sfield_pool entries are missing
// makes `r.out` a field access on a fieldless struct, and check_types() raises instead
// of returning — so a fields-less "fix" fails here rather than passing quietly.

fn process_probe_src() -> Str {
    #"fn main() ! Process.Spawn {
    let child = process.spawn("echo", ["hi"]).unwrap()
    let waited = process.wait(child).unwrap()
    let w_out: Str = waited.out
    let w_err: Str = waited.err_out
    let ran = process.run("echo", ["hi"]).unwrap()
    let r_err: Str = ran.err_out
    let piped = process.run("cat", [], stdin: Some("hi")).unwrap()
    let p_out: Str = piped.out
    assert(w_out.len() >= 0)
    assert(w_err.len() >= 0)
    assert(r_err.len() >= 0)
    assert(p_out.len() >= 0)
}
"#
}

test "process handle operations type as ProcessResult without import std.process" {
    let path = "build/runtime_backed_type_fail_open_process_probe.bl"
    fs.write(path, process_probe_src()).unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)

    let tid = find_tid_by_str("ProcessResult")
    assert_true(tid >= 0, "process: a ProcessResult tid is observed — typecheck must not erase a runtime-backed type to Void")
    assert_true(tc_tid_kind(tid) == TyKind.Struct, "process: the ProcessResult tid is a Struct kind")
    assert_eq_int(count_distinct_tids_by_str("ProcessResult"), 1, "process: all three operations share ONE ProcessResult tid")
    let decl = tc_tid_decl_node(tid)
    assert_true(decl >= 0 && node_source_module(decl) == "std_process", "process: the tid is the one lib/std/process.bl declares")
    // Six nodes must carry it: the three unwrapped calls and the three lets bound to them. A
    // fix that typed only the call expression and left the let erased would satisfy the
    // checks above.
    assert_true(count_nodes_by_str("ProcessResult") >= 6, "process: both the call and its let binding carry the type, for all three operations")
}

// ── Half B — an imported declaration and the handle op share one tid ────────────────
//
// When the file imports std.process there must still be exactly ONE ProcessResult tid.
// Two would mean a handle call typed its result apart from the declaration, and nominal
// type identity would then depend on which tid a given node happened to memoize.

fn declared_probe_src() -> Str {
    #"import std.process

fn main() ! Process.Spawn {
    let ran = process.run("echo", ["hi"]).unwrap()
    let out: Str = ran.out
    let child = process.spawn("echo", ["hi"]).unwrap()
    let waited = process.wait(child).unwrap()
    let w: Str = waited.out
    assert(out.len() >= 0)
    assert(w.len() >= 0)
}
"#
}

test "an imported ProcessResult and the handle op return type are ONE tid" {
    if !stdlib_loadable() {
        skip("harness cannot load std.* from this binary's directory — the declaration half needs a real lib/std/process.bl")
    }
    let path = "build/runtime_backed_type_fail_open_declared_probe.bl"
    fs.write(path, declared_probe_src()).unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)

    let tid = find_tid_by_str("ProcessResult")
    assert_true(tid >= 0, "declared: a ProcessResult tid is observed")
    assert_eq_int(count_distinct_tids_by_str("ProcessResult"), 1, "declared: the declaration and the handle op return share ONE tid")
}

// ── Half C — the Instant twin, with NO `import std.time` ────────────────────────────
//
// Same shape at src/typecheck.bl:8797. The comment there already states the intent
// ("typing read() as Instant lets the comparison check catch `time.read() > 0`"). std.time
// is a PRELUDE module (compiler.bl:1357), so the declaration is normally present and this
// half exercises the lookup-hit path — it is a tripwire against std.time leaving the
// prelude, plus a guard that the site never answers Void. It cannot exercise the mint:
// the enclosing branch also requires `is_import_module_name("time")`, so with no std.time
// in the program at all the call types as Unknown before reaching the lookup.

fn time_probe_src() -> Str {
    #"fn main() {
    let t = time.read()
    let n: Int = t.nanos
    assert(n >= 0)
}
"#
}

test "time.read() types as Instant without import std.time" {
    if !stdlib_loadable() {
        skip("harness cannot load std.* from this binary's directory — see stdlib_loadable()")
    }
    let path = "build/runtime_backed_type_fail_open_time_probe.bl"
    fs.write(path, time_probe_src()).unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)

    let tid = find_tid_by_str("Instant")
    assert_true(tid >= 0, "time: an Instant tid is observed — typecheck must not erase a runtime-backed type")
    assert_true(tc_tid_kind(tid) == TyKind.Struct, "time: the Instant tid is a Struct kind")
    assert_eq_int(count_distinct_tids_by_str("Instant"), 1, "time: one Instant tid")
}
