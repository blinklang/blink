// The runtime fills a vtable slot with a default body until a handler replaces it. A slot
// that returns a Str must hand back a real Str even when the default has no work to do:
// a NULL there panics the first time the caller reads its length.

@ffi("c", "blink_net_default_dns")
@trusted(audit: "TEST-RUNTIME-DEFAULT-VTABLE")
fn net_default_dns(slf: Ptr[U8], host: Str) -> Str ! FFI { }

@ffi("c", "blink_crypto_default_hash")
@trusted(audit: "TEST-RUNTIME-DEFAULT-VTABLE")
fn crypto_default_hash(slf: Ptr[U8], data: Str) -> Str ! FFI { }

@ffi("c", "blink_crypto_default_sign")
@trusted(audit: "TEST-RUNTIME-DEFAULT-VTABLE")
fn crypto_default_sign(slf: Ptr[U8], data: Str, key: Str) -> Str ! FFI { }

@ffi("c", "blink_crypto_default_encrypt")
@trusted(audit: "TEST-RUNTIME-DEFAULT-VTABLE")
fn crypto_default_encrypt(slf: Ptr[U8], data: Str, key: Str) -> Str ! FFI { }

@ffi("c", "blink_crypto_default_decrypt")
@trusted(audit: "TEST-RUNTIME-DEFAULT-VTABLE")
fn crypto_default_decrypt(slf: Ptr[U8], data: Str, key: Str) -> Str ! FFI { }

test "net default dns returns a readable Str" {
    with ffi.scope() as scope {
        let slf: Ptr[U8] = scope.alloc[U8]()
        assert_eq(net_default_dns(slf, "example.com").len(), 0)
    }
}

test "crypto default hash returns a readable Str" {
    with ffi.scope() as scope {
        let slf: Ptr[U8] = scope.alloc[U8]()
        assert_eq(crypto_default_hash(slf, "data").len(), 0)
    }
}

test "crypto default sign returns a readable Str" {
    with ffi.scope() as scope {
        let slf: Ptr[U8] = scope.alloc[U8]()
        assert_eq(crypto_default_sign(slf, "data", "key").len(), 0)
    }
}

test "crypto default encrypt returns a readable Str" {
    with ffi.scope() as scope {
        let slf: Ptr[U8] = scope.alloc[U8]()
        assert_eq(crypto_default_encrypt(slf, "data", "key").len(), 0)
    }
}

test "crypto default decrypt returns a readable Str" {
    with ffi.scope() as scope {
        let slf: Ptr[U8] = scope.alloc[U8]()
        assert_eq(crypto_default_decrypt(slf, "data", "key").len(), 0)
    }
}
