// The compiler hashes its own binary to key its caches and to check that an installed archive
// is its own. The runtime names that binary by asking the OS in process, so the answer does
// not depend on argv[0] or on a `readlink -f` that macOS before 12.3 lacks.
//
// The test runs a copy of its own binary through a symlink. The copy must report the copy's
// path, with the symlink resolved.

@ffi("blink_exe_path")
@trusted(audit: "Runtime function: takes no input and returns a GC-owned Str, never NULL.")
fn exe_path() -> Str ! FS.Read {}

import std.process.{ChildEnd}

let DIR = "build/runtime_exe_path_probe"
let OUT_VAR = "BLINK_EXE_PATH_PROBE_OUT"

test "the runtime names the running binary by its resolved path" {
    let probe_out = env.var(OUT_VAR) ?? ""
    if probe_out != "" {
        write_file(probe_out, exe_path())
    } else {
        let self_path = exe_path()
        assert(self_path.starts_with("/"))
        assert_eq(file_exists(self_path), 1)

        process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/bin"])?
        let cp = process.run("sh", ["-c", "cp {self_path} {DIR}/copy"])?
        assert_eq(cp.end, ChildEnd.Exited(0), cp.err_out)
        let ln = process.run("sh", ["-c", "ln -s ../copy {DIR}/bin/link"])?
        assert_eq(ln.end, ChildEnd.Exited(0), ln.err_out)
        let out = "{DIR}/out.txt"
        let probe = process.run("sh", ["-c", "{OUT_VAR}={out} {DIR}/bin/link >/dev/null 2>&1"])?
        assert_eq(probe.end, ChildEnd.Exited(0), probe.err_out)
        let got = read_file(out)
        let want = "{process.run("sh", ["-c", "cd {DIR} && pwd -P"])?.out.trim()}/copy"
        process.run("sh", ["-c", "rm -rf {DIR}"])?
        assert_eq(got, want)
    }
}
