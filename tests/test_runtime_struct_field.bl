import compile_test_helpers

// the E0525 NoSuchField absence prover (tc_struct_field_provably_absent) read the
// declared shape only from tc_struct_decl_nodes, which is keyed on a parsed `type` AST node.
// A runtime struct (Instant) had no AST decl node when typecheck synthesized it, and
// registered its shape only in named_type_map and sfield_pool. So field EXISTENCE (get_struct_field_tid, which reads sfield_pool) and field ABSENCE (which read
// tc_struct_decl_nodes) consulted different sources: a bad field access on such a type found no decl
// node, the prover returned 0 (cannot prove absent), and the access silently fell through to
// TYPE_UNKNOWN instead of E0525 (sections/03_types.md:3305). Instant is the type of time.read(),
// which types without importing std.time, so this is reachable in ordinary code. The fix makes the absence prover fall back to the same shape source
// existence uses (sfield_pool) when no AST decl node is present, so both channels agree.

fn bad_field_src() -> Str {
    #"fn main() ! IO, Time {
    let r = time.read()
    let bad = r.nonexistent_field
    io.println("bad")
}
"#
}

test "reading a nonexistent field on a runtime Instant is E0525" {
    compile_test_helpers.expect_compile_error(bad_field_src(), "runtime_struct_field_bad", "E0525")
}

// Guard: the real declared fields of the runtime shape must still resolve — proving absence
// from sfield_pool must not reject a field that IS in the shape.
fn good_fields_src() -> Str {
    #"fn main() ! IO, Time {
    let r = time.read()
    let nanos: Int = r.nanos
    io.println("{nanos}")
}
"#
}

test "reading real fields on a runtime Instant does not false-fire E0525" {
    compile_test_helpers.expect_no_error(good_fields_src(), "runtime_struct_field_good", "E0525")
}
