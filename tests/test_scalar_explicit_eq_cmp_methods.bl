// `x.eq(y)` and `x.cmp(y)` on the built-in scalars are the explicit forms of `==` and `<`
// (sections/03_types.md, the built-in trait table): Int, every sized int, Char and Str
// implement Eq and Ord, and Bool implements Eq alone.

fn order_of[T: Ord](a: T, b: T) -> Ordering { a.cmp(b) }

fn equal_to[T: Eq](a: T, b: T) -> Bool { a.eq(b) }

test "cmp on an Int answers Less, Equal and Greater" {
    let a = 1
    let b = 2
    assert(a.cmp(b) == Less)
    assert(a.cmp(1) == Equal)
    assert(b.cmp(a) == Greater)
    assert(1.cmp(2) == Less)
}

test "cmp on a negative Int orders below zero" {
    let n = -5
    assert(n.cmp(0) == Less)
    assert(0.cmp(n) == Greater)
    assert(n.cmp(-5) == Equal)
    assert(n.cmp(-6) == Greater)
}

test "eq on an Int answers for equal and unequal values" {
    let a = 7
    assert(a.eq(7))
    assert(!a.eq(8))
    assert(1.eq(1))
    assert(!(-1).eq(1))
}

test "cmp and eq on a signed sized int" {
    let a = 3.to_i8()
    let b = (-4).to_i8()
    assert(a.cmp(b) == Greater)
    assert(b.cmp(a) == Less)
    assert(a.cmp(3.to_i8()) == Equal)
    assert(a.eq(3.to_i8()))
    assert(!a.eq(b))
    assert(100.to_i16().cmp(200.to_i16()) == Less)
    assert((-1).to_i32().cmp(1.to_i32()) == Less)
    assert(5.to_i32().eq(5.to_i32()))
}

test "cmp and eq on an unsigned sized int" {
    let a = 200.to_u8()
    let b = 10.to_u8()
    assert(a.cmp(b) == Greater)
    assert(b.cmp(a) == Less)
    assert(a.eq(200.to_u8()))
    assert(!a.eq(b))
    assert(1.to_u16().cmp(65535.to_u16()) == Less)
    assert(7.to_u32().cmp(7.to_u32()) == Equal)
    assert(0.to_u64().cmp(1.to_u64()) == Less)
    assert(9.to_u64().eq(9.to_u64()))
}

test "an unsigned sized int above the signed range orders as unsigned" {
    let big = (-1).to_u64()
    assert(big.cmp(1.to_u64()) == Greater)
    assert(1.to_u64().cmp(big) == Less)
    let top = (-1).to_u32()
    assert(top.cmp(1.to_u32()) == Greater)
}

test "cmp and eq on a Char follow the code point" {
    let a = 'a'
    let b = 'b'
    assert(a.cmp(b) == Less)
    assert(b.cmp(a) == Greater)
    assert(a.cmp('a') == Equal)
    assert(a.eq('a'))
    assert(!a.eq(b))
    assert('Z'.cmp('a') == Less)
}

test "cmp on a Str is lexicographic" {
    assert("a".cmp("b") == Less)
    assert("b".cmp("a") == Greater)
    assert("abc".cmp("abc") == Equal)
    assert("apple".cmp("apricot") == Less)
}

test "cmp on a Str puts a prefix before the longer string" {
    assert("ab".cmp("abc") == Less)
    assert("abc".cmp("ab") == Greater)
    assert("".cmp("a") == Less)
    assert("a".cmp("") == Greater)
    assert("".cmp("") == Equal)
}

test "eq on a Str compares contents" {
    let s = "hello"
    let t = "hel".concat("lo")
    assert(s.eq(t))
    assert(!s.eq("help"))
    assert("".eq(""))
    assert(!"".eq("a"))
    assert(!"ab".eq("abc"))
}

test "eq on a Bool" {
    assert(true.eq(true))
    assert(false.eq(false))
    assert(!true.eq(false))
    assert(!false.eq(true))
}

test "the methods agree with the operators on every Int pair" {
    let vals = [-3, -1, 0, 1, 2, 1000]
    for a in vals {
        for b in vals {
            assert(a.eq(b) == (a == b))
            assert((a.cmp(b) == Less) == (a < b))
            assert((a.cmp(b) == Greater) == (a > b))
            assert((a.cmp(b) == Equal) == (a == b))
        }
    }
}

test "the methods agree with the operators on every Str pair" {
    let vals = ["", "a", "ab", "abc", "b", "B"]
    for a in vals {
        for b in vals {
            assert(a.eq(b) == (a == b))
            assert((a.cmp(b) == Less) == (a < b))
            assert((a.cmp(b) == Greater) == (a > b))
            assert((a.cmp(b) == Equal) == (a == b))
        }
    }
}

test "each operand of cmp is evaluated once" {
    let mut calls = 0
    let mut next = fn() -> Int {
        calls = calls + 1
        calls
    }
    let o = next().cmp(next())
    assert(o == Less)
    assert(calls == 2)
}

test "an Ord bound orders an Int, a Str, a Char and a sized int" {
    assert(order_of(1, 2) == Less)
    assert(order_of(2, 2) == Equal)
    assert(order_of(-1, -2) == Greater)
    assert(order_of("b", "a") == Greater)
    assert(order_of("", "a") == Less)
    assert(order_of('x', 'x') == Equal)
    assert(order_of(1.to_u8(), 2.to_u8()) == Less)
    assert(order_of((-1).to_i16(), 1.to_i16()) == Less)
}

test "an Eq bound equates an Int, a Str, a Char, a Bool and a sized int" {
    assert(equal_to(3, 3))
    assert(!equal_to(3, 4))
    assert(equal_to("x", "x"))
    assert(!equal_to("x", "y"))
    assert(equal_to('q', 'q'))
    assert(!equal_to('q', 'r'))
    assert(equal_to(true, true))
    assert(!equal_to(true, false))
    assert(equal_to(9.to_u32(), 9.to_u32()))
    assert(!equal_to(9.to_i8(), 8.to_i8()))
}
