// br 3xvjcy (increment D of the codegen-structured-tids epic, kvn6w8): codegen
// must monomorphize a generic struct field whose concrete inner is itself a
// struct instance. Increment C taught typecheck to infer the concrete inner
// (`b.value.value : Int` where `b: Box[Box[Int]]`), but codegen's struct-literal
// mono-arg inference (infer_struct_type_args) computed each type-arg via
// type_name_from_ct, which has no CT_STRUCT case and returned "Void". So the
// outer instance `Box[Box[Int]]` registered as `blink_Box_Void` with `void
// value;`, and the struct literal built `blink_Box_Void _s0 = {.value = _s1}`
// (where `_s1` was the correct `blink_Box_Int`) → cc rejected.
//
// D captures the field-value's already-registered mono name (get_var_struct on
// the emitted field temp → "Box_Int") and prefers it over the "Void" fallback,
// so the outer registers as `blink_Box_Box_Int` with `blink_Box_Int value;`.
// This is the codegen consumer of C's inference. Byte-safe: reuses the exact
// string the inner literal already registered — no re-spelling.

type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }

test "nested Box[Box[Int]] field chain monomorphizes concrete inner" {
    let b: Box[Box[Int]] = Box { value: Box { value: 42 } }
    assert_eq(b.value.value, 42)
}

test "let-bound intermediate struct field carries concrete inner" {
    let b: Box[Box[Int]] = Box { value: Box { value: 7 } }
    let inner = b.value
    assert_eq(inner.value, 7)
}

test "two-param struct with a struct-instance arg monomorphizes positionally" {
    let p: Pair[Box[Int], Str] = Pair { first: Box { value: 9 }, second: "nine" }
    assert_eq(p.first.value, 9)
    assert_eq(p.second, "nine")
}

// GREEN control: a scalar Str field must stay on the natural path — the
// substituted concrete inner must be Str, never overriding onto Void or a
// struct mono name.
test "scalar Str field stays undisturbed (default path)" {
    let b: Box[Str] = Box { value: "hi" }
    assert_eq(b.value, "hi")
}
