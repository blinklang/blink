import compile_test_helpers

fn scope_alloc_typearg_src() -> Str {
    #"@trusted(audit: "x")
fn go() ! FFI {
    with ffi.scope() as scope {
        let p = scope.alloc[Int]()
        io.println("null={p.is_null()}")
    }
}
fn main() { go() }
"#
}

test.failing(
    "scope.alloc[T]() (the spec's only spelling for the explicit pointee type argument) compiles and runs",
    reason: "the [T] type argument on the scope.alloc namespace-method receiver is dropped before it reaches the let binder, so the binder is typed Void instead of Ptr[Int]; build/run then fail with UnresolvedMethod .is_null on Void (and a LetBindingTypeUnspellable ICE) even though 'blink check' reports the file ok, since bare scope.alloc() without an annotation is CannotInferType (decisions/under-determined-types.md 8vcj2c) and this is the only other spelling the spec offers",
    ticket: "16e876",
) {
    let r = compile_test_helpers.compile_and_run(scope_alloc_typearg_src(), "_scope_alloc_explicit_typearg")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("null=false"), "expected a non-null Int pointer: out={r.out}")
}
