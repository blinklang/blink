// 022d8b: the built-in method-surface traits (StrOps, BytesOps, StringBuildOps,
// Sized, Contains, ListOps, MapOps, SetOps, Joinable) are prelude + sealed
// (nrbq84, §3.2.2 / §10.6). User code may neither redefine them nor write an
// `impl` for them. Both forms are a hard error, E0907.

import compile_test_helpers

test "seal: user redefinition of StrOps -> E0907" {
    let src = "trait StrOps \{ fn bogus(self) -> Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "seal_redef_strops", "E0907")
}

test "seal: user redefinition of Sized -> E0907" {
    let src = "trait Sized \{ fn len(self) -> Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "seal_redef_sized", "E0907")
}

test "seal: user impl Contains for own type -> E0907" {
    let src = "type MyStr \{ s: Str }\nimpl Contains for MyStr \{ fn contains(self, value: Str) -> Bool \{ true } }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "seal_impl_contains", "E0907")
}

test "seal: user impl ListOps for own type -> E0907" {
    let src = "type Stack \{ n: Int }\nimpl ListOps for Stack \{ fn push(self, x: Int) \{} }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "seal_impl_listops", "E0907")
}

// Negative control: a genuine user trait + impl still compiles cleanly.
test "seal: genuine user trait + impl is unaffected" {
    let src = "trait Greet \{ fn greet(self) -> Str }\ntype Dog \{ name: Str }\nimpl Greet for Dog \{ fn greet(self) -> Str \{ self.name } }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "seal_user_ok", "E0907")
}
