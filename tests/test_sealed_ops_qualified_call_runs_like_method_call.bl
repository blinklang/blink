// A sealed ops trait has no source impl: `StrOps.len(s)` means `s.len()`, with the receiver
// written as the first argument. Each row is one way the compiler dispatches the method form,
// so a family the qualified spelling fails to reach fails its own row.
import std.traits { StrOps, MapOps, ListOps, SetOps, BytesOps, StringBuildOps }

let mut seen: List[Str] = []

fn greeting() -> Str {
    "hello"
}

test "a Str intrinsic answers through its trait" {
    assert_eq(StrOps.to_upper("abc"), "ABC")
    assert_eq(StrOps.replace("a-b", "-", "+"), "a+b")
}

test "a Str method from Sized answers through StrOps" {
    assert_eq(StrOps.len("hello"), 5)
}

test "a receiver that is a call is evaluated as the receiver" {
    assert_eq(StrOps.len(greeting()), 5)
}

test "a Map keyed op answers through MapOps" {
    let m = Map()
    MapOps.insert(m, "key", 42)
    assert_eq(MapOps.contains_key(m, "key"), true)
    assert_eq(MapOps.get(m, "key").unwrap(), 42)
    assert_eq(MapOps.len(m), 1)
    MapOps.remove(m, "key")
    assert_eq(MapOps.contains_key(m, "key"), false)
}

test "a List runtime op answers through ListOps" {
    let xs: List[Int] = []
    ListOps.push(xs, 10)
    ListOps.push(xs, 20)
    assert_eq(ListOps.get(xs, 1).unwrap(), 20)
    assert_eq(xs.len(), 2)
}

test "a List method from Sized answers through ListOps" {
    let xs: List[Int] = [1, 2, 3]
    assert_eq(ListOps.len(xs), 3)
    assert_eq(ListOps.is_empty(xs), false)
}

test "a Set keyed op answers through SetOps" {
    let s: Set[Int] = Set()
    assert_eq(SetOps.insert(s, 7), true)
    assert_eq(SetOps.insert(s, 7), false)
    assert_eq(s.len(), 1)
}

test "a Bytes intrinsic answers through BytesOps" {
    let b = Bytes.new()
    BytesOps.push(b, 72)
    BytesOps.push(b, 105)
    assert_eq(BytesOps.len(b), 2)
    assert_eq(BytesOps.to_hex(b), "4869")
}

test "a StringBuilder intrinsic answers through StringBuildOps" {
    let sb = StringBuilder.new()
    StringBuildOps.write(sb, "hi")
    assert_eq(StringBuildOps.len(sb), 2)
    assert_eq(StringBuildOps.to_str(sb), "hi")
}

test "a module-level global is a receiver like a local" {
    ListOps.push(seen, "a")
    ListOps.push(seen, "b")
    assert_eq(ListOps.len(seen), 2)
    assert_eq(seen.get(1).unwrap(), "b")
}

// The panic comes from the unwrap, whose receiver is the qualified call. It checks the line
// of the unwrap node, not the call's own span; the rewrite suite checks that span directly.
test "a panic on a qualified call's result reports the line it was written on" {
    let m: Map[Str, Int] = Map()
    assert_panics(matching: "qualified_call_runs_like_method_call.bl:83") {
        let _ = MapOps.get(m, "missing").unwrap()
    }
}
