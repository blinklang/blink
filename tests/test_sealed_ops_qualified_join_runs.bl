// The qualified spelling `Joinable.join(xs, sep)` is the same call as `xs.join(sep)`, so it
// builds and joins the same string.

test "Joinable.join on a List[Str] joins as the instance call does" {
    let xs: List[Str] = ["a", "b", "c"]
    assert_eq(Joinable.join(xs, ","), "a,b,c")
    assert_eq(Joinable.join(xs, ", "), xs.join(", "))
}

test "Joinable.join on an empty List[Str] is the empty string" {
    let xs: List[Str] = []
    assert_eq(Joinable.join(xs, ","), "")
}
