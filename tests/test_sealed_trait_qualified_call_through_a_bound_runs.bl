// `Sized.len(x)` with `x: T` and `T: Sized` is `x.len()`: the bound licenses the call, and each
// instance runs the length of its own type.

fn qualified[T: Sized](x: T) -> Int { Sized.len(x) }
fn dotted[T: Sized](x: T) -> Int { x.len() }

test "a sealed trait qualified call through a bound runs the instance's method" {
    assert_eq(qualified([1, 2, 3]), 3)
    assert_eq(qualified("ab"), 2)
    assert_eq(qualified(Map[Str, Int]()), 0)
    assert_eq(qualified([4]), dotted([4]))
}
