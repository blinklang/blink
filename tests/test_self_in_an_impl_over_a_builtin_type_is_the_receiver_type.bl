// In an impl over a built-in type, `Self` is the type being implemented (sections/03_types.md
// *The `Self` Type*). A call fills the impl's binders from the receiver, so `Self` in a
// parameter, a default or a return type is the receiver's type at the call, as it is for an
// impl over a user generic.

trait Same {
    fn same(self, -- other: Option[Self] = None) -> Bool
}

impl[T] Same for List[T] {
    fn same(self, -- other: Option[Self] = None) -> Bool {
        match other {
            Some(o) => o.len() == self.len()
            None => self.len() > 0
        }
    }
}

impl Same for Int {
    fn same(self, -- other: Option[Self] = None) -> Bool {
        match other {
            Some(o) => o == self
            None => self > 0
        }
    }
}

impl Same for Str {
    fn same(self, -- other: Option[Self] = None) -> Bool {
        match other {
            Some(o) => o == self
            None => self.len() > 0
        }
    }
}

type Bx[T] { v: T, n: Int }

impl[T] Same for Bx[T] {
    fn same(self, -- other: Option[Self] = None) -> Bool {
        match other {
            Some(o) => o.n == self.n
            None => self.n > 0
        }
    }
}

trait Wrap {
    fn wrap(self) -> Option[Self]
    fn twice(self) -> List[Self]
    fn me(self) -> Self
    fn tagged(self) -> (Self, Int)
}

impl[T] Wrap for List[T] {
    fn wrap(self) -> Option[Self] { Some(self) }
    fn twice(self) -> List[Self] { [self, self] }
    fn me(self) -> Self { self }
    fn tagged(self) -> (Self, Int) { (self, self.len()) }
}

impl Wrap for Int {
    fn wrap(self) -> Option[Self] { Some(self) }
    fn twice(self) -> List[Self] { [self, self] }
    fn me(self) -> Self { self }
    fn tagged(self) -> (Self, Int) { (self, self + 1) }
}

// A method binder's bound is part of the signature, so `Self` or a binder there also gives the
// impl one body per receiver instance.
trait Cv[X] {
    fn cv(self) -> X
}

trait Pick {
    fn pick[U: Cv[Self]](self, u: U) -> Int
    fn first[U: Cv[Option[Self]]](self, u: U) -> Int
}

impl[T] Pick for List[T] {
    fn pick[U: Cv[Self]](self, u: U) -> Int { self.len() + u.cv().len() }
    fn first[U: Cv[Option[List[T]]]](self, u: U) -> Int {
        match u.cv() {
            Some(l) => self.len() * 10 + l.len()
            None => self.len()
        }
    }
}

type Gv { n: Int }

impl Cv[List[Int]] for Gv {
    fn cv(self) -> List[Int] { [self.n, self.n] }
}

impl Cv[Option[List[Int]]] for Gv {
    fn cv(self) -> Option[List[Int]] { Some([self.n]) }
}

test "Option[Self] in a parameter and its default on a List receiver" {
    assert([1].same())
    assert(![1].same(other: Some([2, 3])))
    assert(["a", "b"].same(other: Some(["c", "d"])))
}

test "Option[Self] in a parameter and its default on an Int or Str receiver" {
    assert(3.same())
    assert(!3.same(other: Some(4)))
    assert("a".same(other: Some("a")))
    assert(!"".same())
}

test "Option[Self] on a user generic receiver" {
    assert(Bx { v: 1, n: 2 }.same())
    assert(Bx { v: "a", n: 2 }.same(other: Some(Bx { v: "b", n: 2 })))
}

test "Self in a return type on a List receiver" {
    let xs = [4, 5]
    match xs.wrap() {
        Some(w) => assert_eq(w.len(), 2)
        None => assert(false)
    }
    assert_eq(xs.twice().len(), 2)
    assert_eq(xs.twice().get(1).unwrap().get(0).unwrap(), 4)
    assert_eq(xs.me().len(), 2)
    let (back, n) = xs.tagged()
    assert_eq(back.get(1).unwrap(), 5)
    assert_eq(n, 2)
}

test "Self in a return type on a List of Str receiver" {
    let ys = ["p"]
    assert_eq(ys.me().get(0).unwrap(), "p")
    assert_eq(ys.twice().get(1).unwrap().get(0).unwrap(), "p")
}

test "Self in a return type on an Int receiver" {
    assert_eq(7.wrap().unwrap(), 7)
    assert_eq(7.twice().len(), 2)
    assert_eq(7.me(), 7)
    let (v, n) = 7.tagged()
    assert_eq(v, 7)
    assert_eq(n, 8)
}

test "Self or a binder in a method binder bound on a List receiver" {
    assert_eq([1].pick(Gv { n: 3 }), 3)
    assert_eq([1, 2].first(Gv { n: 3 }), 21)
}
