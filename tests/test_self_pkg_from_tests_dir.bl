// Tests that a file at <pkg>/tests/foo.bl can `import <pkg>` and have
// it resolve to <pkg>/src/<pkg>.bl via find_src_root walking up to blink.toml.

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_self_pkg_from_tests_dir"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    process.run("sh", ["-c", "mkdir -p {base}/mylib/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/mylib/tests"]).unwrap()
    fs.write("{base}/mylib/blink.toml", "[package]\nname = \"mylib\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/mylib/src/mylib.bl", "@module(\"mylib\")\n\npub fn greet() -> Str \{\n    \"hello-from-mylib\"\n}\n").unwrap()
    // Test file lives in tests/, NOT under src/. find_src_root must walk
    // up to blink.toml so that `import mylib` resolves to src/mylib.bl,
    // not to tests/mylib.bl (which was the reported bug).
    fs.write("{base}/mylib/tests/check_greet.bl", "import mylib.\{greet\}\n\nfn main() \{\n    io.println(greet())\n}\n").unwrap()

    process.run("sh", ["-c", "cd {base}/mylib && {blink} build tests/check_greet.bl -o build/check > out.txt 2>&1; true"]).unwrap()
    let build_out = fs.read("{base}/mylib/out.txt").unwrap()
    if compile_test_helpers.path_exists("{base}/mylib/build/check") {
        process.run("sh", ["-c", "{base}/mylib/build/check > {base}/mylib/run.txt 2>&1 || true"]).unwrap()
        let run_out = fs.read("{base}/mylib/run.txt").unwrap()
        if run_out.starts_with("hello-from-mylib") {
            io.println("PASS: tests/check_greet.bl resolves `import mylib` via walk-up to package root")
        } else {
            io.println("FAIL: expected 'hello-from-mylib', got: {run_out}")
        }
    } else {
        io.println("FAIL: build did not produce binary, output: {build_out}")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
