// A self-recursive generic struct, whose recursive field goes through an
// Option (Node[T] { v: T, next: Option[Node[T]] }), must monomorphize with
// the self-reference boxed correctly through the Option carrier.

import compile_test_helpers.{compile_and_run}

test.failing(
    "self-recursive generic struct through an Option field compiles and links a two-node chain",
    reason: "the inner literal of a self-recursive generic struct built through an Option field is not monomorphized, so a free type variable T reaches codegen and it stops with ICE UnspellableExprType",
) {
    let src = #"
import std.io

type Node[T] { v: T, next: Option[Node[T]] }

fn main() {
    let n = Node { v: 1, next: Some(Node { v: 2, next: None }) }
    io.println("{n.v} {n.next.unwrap().v}")
}
"#
    let r = compile_and_run(src, "_self_recursive_generic_struct_via_option")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1 2\n")
}
