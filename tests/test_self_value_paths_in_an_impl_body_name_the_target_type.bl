// In an impl body `Self` is the target type in every position, so a value path or a pattern
// that `Self` heads compiles as the same text with the type name does (sections/03_types.md,
// `Self` as the head of a value path or a pattern). A local or a type parameter that has the
// name of the target type does not change what `Self` names.

type Color {
    Red
    Rgb(Int)
    At(Int, Int)
    Named { n: Int }
}

@derive(Eq)
type Point {
    x: Int
    y: Int
}

fn Color_parse(s: Str) -> Color {
    if s == "red" { Color.Red } else { Color.Rgb(0) }
}

trait Mk {
    fn make(n: Int) -> Self
    fn bump(self) -> Self
    fn code(self) -> Int
}

impl Mk for Color {
    fn make(n: Int) -> Self {
        if n == 0 { Self.parse("red") } else { Self.Rgb(n) }
    }
    fn bump(self) -> Self {
        match self {
            Self.Rgb(k) => Self.make(k + 1)
            Self.Red => Self.Red
            Self.At(a, b) => Self.At(b, a)
            Self.Named { n } => Self.Named { n: n + 1 }
        }
    }
    fn code(self) -> Int {
        match self {
            Self.Red => 0
            Self.Rgb(k) => k
            Self.At(a, b) => a * 10 + b
            Self.Named { n } => 100 + n
        }
    }
}

impl Mk for Point {
    fn make(n: Int) -> Self { Self { x: n, y: n + 1 } }
    fn bump(self) -> Self {
        match self {
            Self { x, y } => Self { x: y, y: x }
        }
    }
    fn code(self) -> Int {
        match self {
            Self { x, y } => x * 10 + y
        }
    }
}

trait Pick {
    fn pick[U](self, u: U) -> Self
    fn fresh(self) -> Self
}

// A type parameter and a local each named like the target type: `Self` is still `Color`.
impl Pick for Color {
    fn pick[Color](self, u: Color) -> Self {
        let _u = u
        let _was = self
        Self.Rgb(9)
    }
    fn fresh(self) -> Self {
        let Color = 3
        let _c = Color
        let _was = self
        Self.At(1, 2)
    }
}

test "Self.V and Self.V(..) build variants of the target enum" {
    assert_eq(Color.make(4), Color.Rgb(4))
    assert_eq(Color.Rgb(1).bump(), Color.Rgb(2))
    assert_eq(Color.Red.bump(), Color.Red)
    assert_eq(Color.At(1, 2).bump(), Color.At(2, 1))
}

test "Self.V with named fields builds a variant of the target enum" {
    assert_eq(Color.Named { n: 4 }.bump(), Color.Named { n: 5 })
}

test "Self.f(..) calls a type-scoped fn of the target type" {
    assert_eq(Color.make(0), Color.Red)
}

test "Self-headed variant patterns match as the type name patterns do" {
    assert_eq(Color.Red.code(), 0)
    assert_eq(Color.Rgb(7).code(), 7)
    assert_eq(Color.At(3, 4).code(), 34)
    assert_eq(Color.Named { n: 2 }.code(), 102)
}

test "a Self struct literal and a Self struct pattern build and match the target struct" {
    assert_eq(Point.make(2), Point { x: 2, y: 3 })
    assert_eq(Point { x: 1, y: 2 }.bump(), Point { x: 2, y: 1 })
    assert_eq(Point { x: 5, y: 6 }.code(), 56)
}

test "a type parameter named like the target type does not change what Self names" {
    assert_eq(Color.Red.pick(1), Color.Rgb(9))
}

test "a local named like the target type does not change what Self names" {
    assert_eq(Color.Red.fresh(), Color.At(1, 2))
}
