fn main() ! IO {
    let mut s = Set()

    // insert returns true if new, false if already present
    let r1 = s.insert("Alice")
    assert_eq(r1, true)
    let r2 = s.insert("Alice")
    assert_eq(r2, false)
    s.insert("Bob")
    s.insert("Carol")

    // len
    assert_eq(s.len(), 3)

    // is_empty
    assert_eq(s.is_empty(), false)

    // contains
    assert_eq(s.contains("Alice"), true)
    assert_eq(s.contains("Dave"), false)

    // remove returns true if was present
    let r3 = s.remove("Bob")
    assert_eq(r3, true)
    let r4 = s.remove("Bob")
    assert_eq(r4, false)
    assert_eq(s.len(), 2)

    // union
    let mut s2 = Set()
    s2.insert("Carol")
    s2.insert("Dave")
    let merged = s.union(s2)
    assert_eq(merged.len(), 3)
    assert_eq(merged.contains("Alice"), true)
    assert_eq(merged.contains("Carol"), true)
    assert_eq(merged.contains("Dave"), true)

    // empty set (element-agnostic use only — E0301 requires an annotation)
    let empty: Set[Str] = Set()
    assert_eq(empty.len(), 0)
    assert_eq(empty.is_empty(), true)

    io.println("all set tests passed")
}
