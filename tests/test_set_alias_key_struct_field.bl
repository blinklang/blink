// A Set[Alias] struct field must encode the kops key type as the alias's
// underlying type (Int), not erase it to void.

type Alias = Int
type Wrap { s: Set[Alias] }

test "Set[Alias] struct field insert/contains resolve the aliased key type" {
    let mut w = Wrap { s: Set() }
    w.s.insert(5)
    assert(w.s.contains(5))
    assert(!w.s.contains(6))
}
