// hs3aqe — Set[Char] via the kops vtable (Char = U32 codepoint, inline_key=1,
// key_size 4 → blink_kops_char). Mirrors Map[Char, _] key support, which
// already works. Exercises the narrow inline-key path for Set.

fn main() ! IO {
    let mut s: Set[Char] = Set()

    let r1 = s.insert('a')
    assert_eq(r1, 1)
    let r2 = s.insert('a')
    assert_eq(r2, 0)
    s.insert('b')
    s.insert('z')

    assert_eq(s.len(), 3)
    assert_eq(s.contains('a'), 1)
    assert_eq(s.contains('z'), 1)
    assert_eq(s.contains('q'), 0)

    let r3 = s.remove('b')
    assert_eq(r3, 1)
    assert_eq(s.contains('b'), 0)
    assert_eq(s.len(), 2)

    io.println("PASS: Set[Char]")
}
