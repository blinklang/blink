// mv45y5 (CLOSED): codegen's get_set_elem_type (src/codegen_types.bl:3351)
// used to fabricate CT_STRING as the "unknown element" default. An
// UNANNOTATED `let mut s = Set()` never had its element stamped by the
// declared-annotation path (codegen_stmt.bl:3392-3429 only fills in from a
// type annotation or an RHS alias/union source), and emit_set_method's
// insert/contains/remove recovery (recover_elem_ct_from_arg,
// codegen_methods.bl:89) was a per-call local fix-up that boxed the argument
// correctly but never persisted the element type onto the Set's own scope
// var. So a later read of the same var (e.g. the for-in normalizer at
// codegen_stmt.bl:3713-3731) still saw the fabricated CT_STRING default and
// mistreated an int64-boxed key as a C string pointer.
//
// typecheck already knew the true element type via HM metavar inference
// (Set() mints make_set_type(make_metavar()), typecheck.bl:5658) — it was a
// codegen bug: fabricating a default for a fact it could read. Fixed:
// get_set_elem_type now returns -1 on unknown (no type_string() fallback),
// sv_tp's CT_SET arm no longer defaults, and recover_set_elem_from_tid /
// the for-in CT_SET normalizer are loud (SetElementTypeUnknownAtCodegen,
// I0002) instead of silently wrong. This test pins the fix.
//
// Spec: sections/03_types.md §3.3 (element type inference).

import compile_test_helpers

fn src() -> Str {
    let mut s = "fn main() ! IO \{\n"
    s = s.concat("    let mut st = Set()\n")
    s = s.concat("    st.insert(7)\n")
    s = s.concat("    let mut total = 0\n")
    s = s.concat("    for x in st \{\n")
    s = s.concat("        total = total + x\n")
    s = s.concat("    }\n")
    s = s.concat("    io.println(\"\{total}\")\n")
    s = s.concat("}\n")
    s
}

test "unannotated Set[Int] survives insert+for-in with the real element (not fabricated CT_STRING)" {
    let r = compile_test_helpers.compile_and_run(src(), "mv45y5_unannotated_set_forin")
    if r.exit_code != 0 { io.println("FAIL: exit {r.exit_code} out={r.out} err={r.err_out}") }
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "7")
}
