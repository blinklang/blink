// Set/Map hashability validators were annotation-only: an unannotated
// `mk[T]() -> Set[T]` whose T is inferred (here Option[Int], via the use_it param)
// bypassed the validator and reached codegen unsolved, emitting an
// UnsolvedTypeVarAtCodegen ICE instead of the MapKeyNotHashable diagnostic. The
// annotation route (`let s: Set[Option[Int]]`) is already covered by test_container_elem_hashability; this
// row guards the INFERENCE route specifically — it must raise the same E1400 diagnostic.

import compile_test_helpers

test "an inferred non-hashable Set element raises MapKeyNotHashable, not an ICE" {
    let src = "fn mk[T]() -> Set[T] \{ Set() }\nfn use_it(s: Set[Option[Int]]) -> Int \{ s.len() }\nfn main() \{ assert(use_it(mk()) == 0) }\n"
    compile_test_helpers.expect_compile_error(src, "set_elem_hashability_inference_infer_set_option", "MapKeyNotHashable")
}
