// Set[K] with K = Float / F32 / F64 must be rejected at typecheck,
// mirroring Map[Float, _] (E1400 / MapKeyNotHashable). Float does not implement
// Hash (NaN-inequality + bit-equality hazards). See
// decisions/map-runtime-architecture.md and decisions/set-type-implementation.md.

import compile_test_helpers

fn main() {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()

    let base = "{compile_test_helpers.scratch_root()}/_test_set_float_rejected"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/tests"]).unwrap()
    fs.write("{base}/blink.toml", "[package]\nname = \"sfr\"\nversion = \"0.1.0\"\n\n[dependencies]\n").unwrap()

    let cases = ["Float", "F32", "F64"]
    let mut ci = 0
    while ci < cases.len() {
        let ty = cases.get(ci).unwrap()
        let src = "fn main() \{\n    let _s: Set[{ty}] = Set()\n    io.println(\"unreachable\")\n\}\n"
        fs.write("{base}/main_{ci}.bl", src).unwrap()

        let cmd = "cd {base} && {blink_root}/build/blink check main_{ci}.bl 2>&1"
        let result = process.run("sh", ["-c", cmd]).unwrap()

        if result.success() {
            io.println("FAIL: Set[{ty}] should be rejected, but check exited 0")
            process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
            return
        }
        if !result.out.contains("E1400") && !result.out.contains("MapKeyNotHashable") {
            io.println("FAIL: Set[{ty}] did not emit E1400 / MapKeyNotHashable")
            io.println("got: {result.out}")
            process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
            return
        }
        ci = ci + 1
    }

    io.println("PASS: E1400 rejects Set[Float/F32/F64]")
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
