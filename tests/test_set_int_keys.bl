// hs3aqe — Set[Int] backed by the per-element kops vtable (mirror of Map int
// keys, minus the values array). Verifies insert/contains/remove/len/is_empty/
// union for Int elements. Before the kops migration, blink_set was str-only
// (const char** items, blink_set_new() no kops) and Set[Int].insert(3) called
// blink_set_insert(blink_set*, const char*) with an int → C compile error.

fn main() ! IO {
    let mut s: Set[Int] = Set()

    // insert returns true (1) if new, false (0) if already present
    let r1 = s.insert(3)
    assert_eq(r1, 1)
    let r2 = s.insert(3)
    assert_eq(r2, 0)
    s.insert(7)
    s.insert(42)

    assert_eq(s.len(), 3)
    assert_eq(s.is_empty(), 0)

    assert_eq(s.contains(3), 1)
    assert_eq(s.contains(42), 1)
    assert_eq(s.contains(99), 0)

    let r3 = s.remove(7)
    assert_eq(r3, 1)
    let r4 = s.remove(7)
    assert_eq(r4, 0)
    assert_eq(s.len(), 2)
    assert_eq(s.contains(7), 0)

    // union: disjoint + overlapping elements dedup
    let mut s2: Set[Int] = Set()
    s2.insert(42)
    s2.insert(100)
    let merged = s.union(s2)
    assert_eq(merged.len(), 3)
    assert_eq(merged.contains(3), 1)
    assert_eq(merged.contains(42), 1)
    assert_eq(merged.contains(100), 1)

    // empty set
    let empty: Set[Int] = Set()
    assert_eq(empty.len(), 0)
    assert_eq(empty.is_empty(), 1)

    // alias with no annotation must carry the element type across (else contains
    // boxes a bare int into a const void* param — the stale-global regression).
    let alias = s
    assert_eq(alias.contains(3), 1)
    assert_eq(alias.contains(999), 0)

    io.println("PASS: Set[Int]")
}
