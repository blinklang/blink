// br ht0bxj — a bare `Set[T]` parameter never bound its typevar, so every generic fn
// taking a Set[T] reached monomorphization with T unsolved (UnsolvedTypeVarAtCodegen).
// The parameter now binds T from the Set element type, so take_set over a Set[Int]
// resolves T=Int and returns the length.

fn take_set[T](s: Set[T]) -> Int { s.len() }

test "a bare Set[T] parameter binds its typevar from the argument" {
    let mut s: Set[Int] = Set()
    s.insert(3)
    assert_eq(take_set(s), 1)
}
