// A for-in over a struct-element Set's into_iter() emits a list-iterator typed
// for int elements and calls its `next` through a function-pointer cast to a
// different signature (`(blink_Option_int (*)(void*))blink_ListIterator_int_next`).
// This is undefined behavior per the C standard (a call through an incompatible
// function pointer type) even though on the pinned gcc/x86_64 toolchain the
// integer and pointer argument/return classes happen to coincide, so the value
// currently round-trips correctly for every field, not just the first as
// originally suspected. The erased iterator carrier name is still the
// observable codegen defect: it should carry the real element type identity.

import compile_test_helpers.{compile_and_emit_c}

test.failing(
    "a Set of a struct type's into_iter does not call next through a mismatched function pointer type",
    reason: "the set/list into_iter for a struct element always monomorphizes the iterator's next accessor as blink_ListIterator_int_next and calls it via a cast to (blink_Option_int (*)(void*)), which is a call through an incompatible function pointer type and undefined behavior by the C standard, even though it happens not to corrupt values under the pinned gcc calling convention",
    ticket: "0vzvk6",
) {
    let src = #"
import std.io

@derive(Hash, Eq)
pub type Point { x: Int, y: Int }

fn main() ! IO {
    let mut pts: Set[Point] = Set()
    pts.insert(Point { x: 1, y: 2 })
    for p in pts.into_iter() {
        io.println("{p.y}")
    }
}
"#
    let c = compile_and_emit_c(src, "_set_struct_element_into_iter_erased_iterator_type")
    let bad = c.contains("(blink_Option_int (*)(void*))blink_ListIterator_int_next")
    assert(!bad, "emitted C calls next through a mismatched function pointer type: {c}")
}
