// hs3aqe — Set element parity with Map keys: a @derive(Hash, Eq) struct and a
// tuple element must box through the kops-struct path (same as Map struct/tuple
// keys), not the inline-scalar path. Regression guard for the code-review
// finding that Set[Point]/Set[(Str,Int)] passed typecheck (validate_set_elem
// accepts them) but emitted `void _mkey = ...` (broken C).

@derive(Hash, Eq)
type Point { x: Int, y: Int }

fn main() ! IO {
    // Struct element
    let mut ps: Set[Point] = Set()
    let r1 = ps.insert(Point { x: 1, y: 2 })
    assert_eq(r1, 1)
    let r2 = ps.insert(Point { x: 1, y: 2 })
    assert_eq(r2, 0)
    ps.insert(Point { x: 3, y: 4 })
    assert_eq(ps.len(), 2)
    assert_eq(ps.contains(Point { x: 1, y: 2 }), 1)
    assert_eq(ps.contains(Point { x: 9, y: 9 }), 0)
    assert_eq(ps.remove(Point { x: 3, y: 4 }), 1)
    assert_eq(ps.len(), 1)

    // Struct-element union result must carry its element tag to an unannotated
    // binding (else u.contains boxes through the broken inline path).
    let mut ps2: Set[Point] = Set()
    ps2.insert(Point { x: 5, y: 6 })
    let u = ps.union(ps2)
    assert_eq(u.len(), 2)
    assert_eq(u.contains(Point { x: 1, y: 2 }), 1)
    assert_eq(u.contains(Point { x: 5, y: 6 }), 1)

    // Tuple element
    let mut ts: Set[(Str, Int)] = Set()
    ts.insert(("a", 1))
    ts.insert(("b", 2))
    assert_eq(ts.insert(("a", 1)), 0)
    assert_eq(ts.len(), 2)
    assert_eq(ts.contains(("a", 1)), 1)
    assert_eq(ts.contains(("a", 2)), 0)

    io.println("PASS: Set[struct] + Set[tuple]")
}
