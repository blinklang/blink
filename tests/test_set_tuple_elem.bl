// mmegcb — a Set[(Int,Str)] element reached through a tuple boundary (t.0)
// erases its element type. recover_elem_ct_from_arg must recover the tuple
// carrier so contains boxes the element through the kops-struct path (same as
// the direct Set[(Int,Str)]), not pass a bare tuple to blink_set_contains's
// const void* param.
fn wrap[T](x: T) -> (T, Int) {
    (x, 1)
}

test "set tuple elem through tuple boundary" {
    let mut s: Set[(Int, Str)] = Set()
    s.insert((1, "a"))
    let t = wrap(s)
    assert(t.0.contains((1, "a")))
}
