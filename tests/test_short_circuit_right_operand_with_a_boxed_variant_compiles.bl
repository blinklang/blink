// A recursive variant boxes its payload, and the Box binds a temporary when it prints. On
// the right of && or || that temporary must sit inside the guarded arm, or the tree does
// not verify.

type Chain {
    End
    Link(Chain, Int)
}

fn depth(c: Chain) -> Int {
    match c {
        End => 0
        Link(rest, _) => 1 + depth(rest)
    }
}

fn sized(n: Int) -> Str {
    match n {
        0 if n == 0 && depth(Link(End, n)) == 1 => "zero"
        k if k > 100 || depth(Link(Link(End, k), k)) == 2 => "any"
        _ => "none"
    }
}

test "a boxed variant on the right of or compiles" {
    let b = false
    assert_eq(b || depth(Link(Link(End, 1), 2)) == 2, true)
    assert_eq(b || depth(Link(End, 1)) == 2, false)
}

test "a boxed variant on the right of and compiles" {
    let a = true
    assert_eq(a && depth(Link(Link(End, 1), 2)) == 2, true)
    assert_eq(a && depth(Link(End, 1)) == 2, false)
}

test "a boxed variant on the right of and or of or in a while condition compiles" {
    let mut i = 0
    while i < 3 && depth(Link(End, i)) == 1 {
        i += 1
    }
    assert_eq(i, 3)
    let mut j = 0
    while j == 0 || depth(Link(Link(End, j), j)) > j {
        j += 1
    }
    assert_eq(j, 2)
}

test "a boxed variant on the right of and or of or in a match guard compiles" {
    assert_eq(sized(0), "zero")
    assert_eq(sized(7), "any")
}
