// A recursive variant boxes its payload, and the Box binds a temporary when it prints. On
// the right of && or || that temporary must sit inside the guarded arm, or the tree does
// not verify.

type Chain {
    End
    Link(Chain, Int)
}

fn depth(c: Chain) -> Int {
    match c {
        End => 0
        Link(rest, _) => 1 + depth(rest)
    }
}

test "a boxed variant on the right of or compiles" {
    let b = false
    assert_eq(b || depth(Link(Link(End, 1), 2)) == 2, true)
    assert_eq(b || depth(Link(End, 1)) == 2, false)
}

test "a boxed variant on the right of and compiles" {
    let a = true
    assert_eq(a && depth(Link(Link(End, 1), 2)) == 2, true)
    assert_eq(a && depth(Link(End, 1)) == 2, false)
}
