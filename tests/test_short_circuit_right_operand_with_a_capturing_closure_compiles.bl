// A closure that captures binds a temporary when it prints. On the right of && or || that
// temporary must sit inside the guarded arm, or the tree does not verify. The capture is
// what binds, so a closure body with or without interpolation behaves the same.

fn tagged(n: Int, xs: List[Str], name: Str) -> Str {
    match n {
        0 if n == 0 && xs.any(fn(l) { l == name }) => "zero, has"
        1 if n == 2 || xs.any(fn(l) { l == name }) => "one, has"
        _ => "none"
    }
}

test "a capturing closure on the right of and compiles" {
    let xs = ["a x(", "bc"]
    let name = "x"
    assert_eq(xs.len() > 0 && xs.any(fn(l) { l.contains(name) }), true)
    assert_eq(xs.len() > 0 && xs.any(fn(l) { l.contains(" {name}(") }), true)
    assert_eq(xs.len() > 0 && xs.any(fn(l) { l.contains(" {name}{name}(") }), false)
}

test "a capturing closure on the right of or compiles" {
    let xs = ["a x(", "bc"]
    let name = "x"
    assert_eq(xs.len() == 0 || xs.any(fn(l) { l.contains(name) }), true)
    assert_eq(xs.len() == 0 || xs.any(fn(l) { l.contains(" {name}(") }), true)
    assert_eq(xs.len() == 0 || xs.any(fn(l) { l == name }), false)
}

test "a capturing closure under or nested on the right of and compiles" {
    let xs = ["a x(", "bc"]
    let name = "bc"
    let empty = xs.len() == 0
    assert_eq(!empty && (empty || xs.any(fn(l) { l == name })), true)
}

test "a capturing closure on the right of and or of or in a while condition compiles" {
    let mut xs = ["a"]
    let name = "c"
    while xs.len() < 5 && !xs.any(fn(l) { l == name }) {
        xs.push(if xs.len() == 2 { "c" } else { "b" })
    }
    assert_eq(xs.len(), 3)
    let mut ys = ["a"]
    while ys.len() == 1 || !ys.any(fn(l) { l == name }) {
        ys.push(if ys.len() == 3 { "c" } else { "b" })
    }
    assert_eq(ys.len(), 4)
}

test "a capturing closure on the right of and or of or in a match guard compiles" {
    assert_eq(tagged(0, ["x"], "x"), "zero, has")
    assert_eq(tagged(0, ["x"], "y"), "none")
    assert_eq(tagged(1, ["x"], "x"), "one, has")
    assert_eq(tagged(1, ["x"], "y"), "none")
}
