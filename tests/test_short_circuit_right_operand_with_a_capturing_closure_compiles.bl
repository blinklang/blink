// A closure that captures binds a temporary when it prints. On the right of && or || that
// temporary must sit inside the guarded arm, or the tree does not verify. The capture is
// what binds, so a closure body with or without interpolation behaves the same.

test "a capturing closure on the right of and compiles" {
    let xs = ["a x(", "bc"]
    let name = "x"
    assert_eq(xs.len() > 0 && xs.any(fn(l) { l.contains(name) }), true)
    assert_eq(xs.len() > 0 && xs.any(fn(l) { l.contains(" {name}(") }), true)
    assert_eq(xs.len() > 0 && xs.any(fn(l) { l.contains(" {name}{name}(") }), false)
}

test "a capturing closure on the right of or compiles" {
    let xs = ["a x(", "bc"]
    let name = "x"
    assert_eq(xs.len() == 0 || xs.any(fn(l) { l.contains(name) }), true)
    assert_eq(xs.len() == 0 || xs.any(fn(l) { l.contains(" {name}(") }), true)
    assert_eq(xs.len() == 0 || xs.any(fn(l) { l == name }), false)
}

test "a capturing closure under or nested on the right of and compiles" {
    let xs = ["a x(", "bc"]
    let name = "bc"
    let empty = xs.len() == 0
    assert_eq(!empty && (empty || xs.any(fn(l) { l == name })), true)
}
