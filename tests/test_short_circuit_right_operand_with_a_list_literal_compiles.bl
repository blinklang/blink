// A filled list literal binds a temporary when it prints. On the right of && or || that
// temporary must sit inside the guarded arm, or the tree does not verify.

fn count(xs: List[Str]) -> Int { xs.len() }

fn ok() -> Bool { false }

fn either(a: Str, b: Str) -> Bool {
    ok() || process_run("echo", [a, b]).exit_code == 0
}

fn classify(n: Int) -> Str {
    match n {
        0 => "zero"
        k if k > 0 && count(["a"]) == 1 => "pos"
        _ => "neg"
    }
}

test "a list literal on the right of and compiles and reads its value" {
    let s = "x"
    assert_eq(s != "" && count(["a"]) == 1, true)
    assert_eq(s != "" && count(["a", "b"]) == 1, false)
}

test "a list literal on the right of or compiles and reads its value" {
    let s = "x"
    assert_eq(s == "" || count(["a"]) == 1, true)
    assert_eq(s == "" || count(["a", "b"]) == 1, false)
    assert_eq(either("x", "y"), true)
}

test "a list literal under or nested on the right of and compiles" {
    let a = true
    let b = false
    assert_eq(a && (b || count(["x"]) == 1), true)
    assert_eq(a && (b || count(["x", "y"]) == 1), false)
    assert_eq(b && (a || count(["x"]) == 1), false)
}

test "a list literal on the right of and in an if condition compiles" {
    let a = true
    let mut hit = 0
    if a && count(["y", "z"]) == 2 { hit = hit + 1 }
    if !a && count(["y"]) == 1 { hit = hit + 10 }
    assert_eq(hit, 1)
}

test "a list literal on the right of and in a while condition compiles" {
    let mut i = 0
    while i < 3 && count(["a"]) == 1 {
        i += 1
    }
    assert_eq(i, 3)
}

test "a list literal on the right of and in a match guard compiles" {
    assert_eq(classify(0), "zero")
    assert_eq(classify(3), "pos")
    assert_eq(classify(-3), "neg")
}
