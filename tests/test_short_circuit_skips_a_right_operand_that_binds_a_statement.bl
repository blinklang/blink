// The right operand of && or || runs only when the left one does not decide the result.
// A list literal, a capturing closure or a boxed variant there binds a temporary, and the
// work that builds it is part of the operand: it must not run when the operand is skipped.

type Chain {
    End
    Link(Chain, Int)
}

let mut runs = 0

fn noted(s: Str) -> Str {
    runs = runs + 1
    s
}

fn noted_end() -> Chain {
    runs = runs + 1
    End
}

fn count(xs: List[Str]) -> Int { xs.len() }

fn depth(c: Chain) -> Int {
    match c {
        End => 0
        Link(rest, _) => 1 + depth(rest)
    }
}

fn first(xs: List[Str]) -> Option[Str] { xs.get(0) }

fn guarded(n: Int) -> Str {
    match n {
        k if k > 0 && count([noted("x")]) == 1 => "pos"
        k if k < 0 || count([noted("y")]) == 1 => "rest"
        _ => "none"
    }
}

test "and skips a list literal when the left is false and builds it when true" {
    runs = 0
    let a = false
    assert_eq(a && count([noted("x")]) == 1, false)
    assert_eq(runs, 0)
    assert_eq(!a && count([noted("x")]) == 1, true)
    assert_eq(runs, 1)
}

test "or skips a list literal when the left is true and builds it when false" {
    runs = 0
    let a = true
    assert_eq(a || count([noted("x")]) == 1, true)
    assert_eq(runs, 0)
    assert_eq(!a || count([noted("x")]) == 1, true)
    assert_eq(runs, 1)
}

test "nested a and (b or ...) skips the list literal when either side decides" {
    runs = 0
    let t = true
    let f = false
    assert_eq(f && (f || count([noted("x")]) == 1), false)
    assert_eq(t && (t || count([noted("x")]) == 1), true)
    assert_eq(runs, 0)
    assert_eq(t && (f || count([noted("x")]) == 1), true)
    assert_eq(runs, 1)
}

test "and skips a capturing closure call when the left is false" {
    runs = 0
    let xs = ["a", "b"]
    let name = "b"
    let a = false
    assert_eq(a && xs.any(fn(l) { noted(l) == name }), false)
    assert_eq(runs, 0)
    assert_eq(!a && xs.any(fn(l) { noted(l) == name }), true)
    assert_eq(runs, 2)
}

test "or skips a boxed variant when the left is true" {
    runs = 0
    let a = true
    assert_eq(a || depth(Link(noted_end(), 1)) == 1, true)
    assert_eq(runs, 0)
    assert_eq(!a || depth(Link(noted_end(), 1)) == 1, true)
    assert_eq(runs, 1)
}

test "a while condition builds its list literal only while the left holds" {
    runs = 0
    let mut i = 0
    while i < 3 && count([noted("x")]) == 1 {
        i += 1
    }
    assert_eq(i, 3)
    assert_eq(runs, 3)
}

test "or skips a capturing closure call when the left is true" {
    runs = 0
    let xs = ["a", "b"]
    let name = "b"
    let a = true
    assert_eq(a || xs.any(fn(l) { noted(l) == name }), true)
    assert_eq(runs, 0)
    assert_eq(!a || xs.any(fn(l) { noted(l) == name }), true)
    assert_eq(runs, 2)
}

test "and skips a boxed variant when the left is false" {
    runs = 0
    let a = false
    assert_eq(a && depth(Link(noted_end(), 1)) == 1, false)
    assert_eq(runs, 0)
    assert_eq(!a && depth(Link(noted_end(), 1)) == 1, true)
    assert_eq(runs, 1)
}

test "a while condition with or builds its list literal only while the left fails" {
    runs = 0
    let mut i = 0
    while i < 2 || count([noted("x")]) == 0 {
        i += 1
    }
    assert_eq(i, 2)
    assert_eq(runs, 1)
}

test "a match guard skips its list literal when the left decides" {
    runs = 0
    assert_eq(guarded(-1), "rest")
    assert_eq(runs, 0)
    assert_eq(guarded(1), "pos")
    assert_eq(runs, 1)
    assert_eq(guarded(0), "rest")
    assert_eq(runs, 2)
}

test "assert decomposes a short-circuit and still skips the list literal" {
    runs = 0
    let t = true
    let f = false
    assert(!(f && count([noted("x")]) == 1))
    assert(t || count([noted("x")]) == 1)
    assert_eq(runs, 0)
    assert(t && count([noted("x")]) == 1)
    assert(f || count([noted("x")]) == 1)
    assert_eq(runs, 2)
}

test "a right operand that reads one value twice still runs once and only when not skipped" {
    runs = 0
    let f = false
    let t = true
    assert_eq(f && (first([noted("a")]) ?? "z") == "a", false)
    assert_eq(runs, 0)
    assert_eq(t && (first([noted("a")]) ?? "z") == "a", true)
    assert_eq(runs, 1)
    let s = "ab"
    assert_eq(t && count([s, s]) == s.len(), true)
}
