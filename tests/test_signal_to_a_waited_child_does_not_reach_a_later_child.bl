// A waited child is reaped, so a signal to it is Err. The runtime once let the next spawn
// take the waited slot, so the old handle signalled the new child instead.

import std.process.{SIGKILL, SIGTERM, ChildEnd}

test "a signal to a waited child is Err and does not touch a later child" {
    let a = process.spawn("echo", ["a"])?
    let _ = process.wait(a)?
    let b = process.spawn("sh", ["-c", "sleep 1; echo b"])?
    assert(process.signal(a, SIGKILL).is_err())
    assert(process.signal(a, SIGTERM).is_err())
    let rb = process.wait(b)?
    assert_eq(rb.end, ChildEnd.Exited(0))
    assert_eq(rb.out.trim(), "b")
}
