// Tests literal-to-sized-int coercion in Assignment / CompoundAssign position.
// Mirrors the LetBinding carve-out: an int literal (or negated int literal)
// may coerce into a sized-int target on assignment, just as it can on `let`.
// Regression: the assignment handler previously rejected `x = -1` for `x: I8`.

fn main() {
    // Negated int literal — the MVCE.
    let mut x: I8 = 0
    x = -1
    assert(x == -1)

    // Direct int literal.
    let mut y: I32 = 0
    y = 5
    assert(y == 5)

    // Compound assign with a literal.
    let mut z: I8 = 0
    z += 5
    assert(z == 5)

    // Unsigned target.
    let mut u: U8 = 0
    u = 200
    assert(u == 200)

    io.println("All sized int assign tests passed!")
}
