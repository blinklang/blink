// Sized-integer arithmetic against bare int literals (br fsq5ma).
// Spec sections/03_types.md:874 — an unadorned integer literal takes its type
// from the surrounding expression. So `a * 2` where `a: I32` must treat `2` as
// an I32 and yield I32, not reject as `I32 * Int`. Covers every arithmetic op
// and the literal-on-either-side cases for several sized types.

test "literal on the right coerces to the sized operand" {
    let i32a: I32 = 1000
    assert_eq(i32a + 2, 1002)
    assert_eq(i32a - 2, 998)
    assert_eq(i32a * 2, 2000)
    assert_eq(i32a / 2, 500)
    assert_eq(i32a % 7, 6)
}

test "literal on the left coerces to the sized operand" {
    let i32a: I32 = 1000
    assert_eq(2 + i32a, 1002)
    assert_eq(2 * i32a, 2000)
    assert_eq(3000 - i32a, 2000)
}

test "coercion holds across sized types" {
    let i8a: I8 = 27
    assert_eq(i8a * 4, 108)
    let u8a: U8 = 5
    assert_eq(u8a * 50, 250)
    let u16a: U16 = 60000
    assert_eq(u16a + 5535, 65535)
    let u64a: U64 = 1000000000000
    assert_eq(u64a + 2000000000000, 3000000000000)
}

test "result type stays sized so it chains" {
    let i32a: I32 = 100
    let chained: I32 = i32a * 2 + 50
    assert_eq(chained, 250)
}
