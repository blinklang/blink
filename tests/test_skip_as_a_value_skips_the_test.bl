// `skip(reason: Str) -> Never` (sections/02_syntax.md, Skipping Tests): a call fits any value
// slot, and wherever it stands the test stops there and reports skipped with its reason.

import compile_test_helpers.{compile_and_run_test_json}

fn assert_skipped(src: Str, name: Str, reason: Str) {
    let r = compile_and_run_test_json(src, name)
    assert(r.out.contains("\"status\":\"skipped\""), "{name} got {r.out}{r.err_out}")
    assert(r.out.contains("\"reason\":\"{reason}\""), "{name} got {r.out}{r.err_out}")
    assert(!r.out.contains("\"status\":\"failed\""), "{name} got {r.out}{r.err_out}")
}

test "a skip as a typed match arm stops the test" {
    assert_skipped(#"import std.testing.{skip}
test "x" {
    let n = 2
    let y: Int = match n {
        1 => 5
        _ => skip("arm")
    }
    assert_eq(y, 5)
}
"#, "skipval_arm", "arm")
}

test "a skip as a ?? default stops the test" {
    assert_skipped(#"import std.testing.{skip}
test "x" {
    let o: Option[Str] = None
    let s: Str = o ?? skip("default")
    assert_eq(s, "x")
}
"#, "skipval_default", "default")
}

test "a skip as a typed let initializer stops the test" {
    assert_skipped(#"import std.testing.{skip}
test "x" {
    let z: Int = skip("let")
    assert_eq(z, 1)
}
"#, "skipval_let", "let")
}

test "a skip as a call argument stops the test before the call" {
    assert_skipped(#"import std.testing
test "x" {
    let mut xs: List[Int] = []
    xs.push(testing.skip("arg"))
    assert_eq(xs.len(), 9)
}
"#, "skipval_arg", "arg")
}
