test "skip() produces status=skipped with reason in --test-json output" {
    let src = "test \"x\" \{ skip(\"not ready yet\")\n  assert_eq(1, 2)\n \}\n"
    write_file(".tmp/_test_skip_basic.bl", src)

    let build_res = process_run("build/blink", ["build", ".tmp/_test_skip_basic.bl"])
    assert_eq(build_res.exit_code, 0)

    let run = process_run("build/_test_skip_basic", ["--test-json"])
    assert(run.out.contains("\"status\":\"skipped\""))
    assert(run.out.contains("\"reason\":\"not ready yet\""))
    // assert_eq after skip must NOT have executed — runner must record skip, not fail
    assert(!run.out.contains("\"status\":\"fail\""))

    shell_exec("rm -f build/_test_skip_basic .tmp/_test_skip_basic.bl")
}
