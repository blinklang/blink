let mut log: List[Str] = []

fn log_has(needle: Str) -> Bool {
    let mut i = 0
    while i < log.len() {
        if log.get(i).unwrap() == needle { return true }
        i = i + 1
    }
    false
}

fn log_index_of(needle: Str) -> Int {
    let mut i = 0
    while i < log.len() {
        if log.get(i).unwrap() == needle { return i }
        i = i + 1
    }
    -1
}

type Outer { tag: Str }
type Inner { tag: Str }

impl BlockHandler for Outer {
    type Context = Int
    fn enter(self) -> Int { log.push("outer.enter"); 0 }
    fn exit(self, ok: Bool) {
        if ok { log.push("outer.exit:ok=true") } else { log.push("outer.exit:ok=false") }
    }
}

impl BlockHandler for Inner {
    type Context = Int
    fn enter(self) -> Int { log.push("inner.enter"); 0 }
    fn exit(self, ok: Bool) {
        if ok { log.push("inner.exit:ok=true") } else { log.push("inner.exit:ok=false") }
    }
}

test "a_skip_inside_nested_with_blocks" {
    with Outer { tag: "o" } as _o {
        with Inner { tag: "i" } as _i {
            skip("nested")
            log.push("SHOULD-NOT-REACH")
        }
    }
}

test "b_verify_lifo_cleanup_order" {
    assert(log_has("outer.enter"))
    assert(log_has("inner.enter"))
    assert(log_has("inner.exit:ok=false"))
    assert(log_has("outer.exit:ok=false"))
    assert(!log_has("SHOULD-NOT-REACH"))
    // LIFO: inner.exit before outer.exit
    let inner_idx = log_index_of("inner.exit:ok=false")
    let outer_idx = log_index_of("outer.exit:ok=false")
    assert(inner_idx < outer_idx)
}
