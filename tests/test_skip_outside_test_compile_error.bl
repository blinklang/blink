import compile_test_helpers.{expect_compile_error}

test "skip() at top level (not in test) — E0516" {
    let src = "fn main() \{\n  skip(\"nope\")\n}\n"
    expect_compile_error(src, "skip_outside_test", "E0516")
}

test "skip() in regular fn called from test — E0516" {
    let src = "fn helper() \{\n  skip(\"nope\")\n}\n" +
              "test \"t\" \{\n  helper()\n }\n"
    expect_compile_error(src, "skip_in_helper", "E0516")
}
