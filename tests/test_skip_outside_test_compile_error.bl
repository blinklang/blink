import compile_test_helpers.{expect_compile_error, compile_and_capture, expect_compiles_clean}

test "skip() at top level (not in test) — E0827" {
    let src = "fn main() \{\n  skip(\"nope\")\n}\n"
    expect_compile_error(src, "skip_outside_test", "E0827")
}

test "skip() in regular fn called from test — E0827" {
    let src = "fn helper() \{\n  skip(\"nope\")\n}\n"
              .concat("test \"t\" \{\n  helper()\n }\n")
    expect_compile_error(src, "skip_in_helper", "E0827")
}

// Identity is the resolved declaration: an explicitly imported real skip is still the
// intrinsic, so calling it outside a test body is still E0827, exactly like the bare,
// unimported form above.
test "imported std.testing.skip() at top level (not in test) — still E0827" {
    let src = "import std.testing.\{skip}\nfn main() \{\n  skip(\"nope\")\n}\n"
    expect_compile_error(src, "skip_imported_outside_test", "E0827")
}

// A user's own same-named fn is an ordinary declaration, not the intrinsic: it draws no
// diagnostic and needs no test body, unlike the real skip above.
test "a user's own fn named skip compiles cleanly, no test body needed" {
    let src = "fn skip(reason: Str) \{\n  let _ = reason\n}\nfn main() \{\n  skip(\"not the intrinsic\")\n}\n"
    let output = compile_and_capture(src, "skip_user_defined_no_test")
    expect_compiles_clean(output, "user-defined skip needs no test body")
}
