// Two-test pattern: test A calls skip() inside a `with` block; test B
// (sorted alphabetically after A) inspects the shared log to verify
// Timer.exit() ran with ok=false on the way out.

let mut log: List[Str] = []

fn log_has(needle: Str) -> Bool {
    let mut i = 0
    while i < log.len() {
        if log.get(i).unwrap() == needle { return true }
        i = i + 1
    }
    false
}

type Timer {
    id: Int
}

impl BlockHandler for Timer {
    type Context = Int
    fn enter(self) -> Int {
        log.push("timer.enter:" + self.id.to_string())
        0
    }
    fn exit(self, ok: Bool) {
        if ok {
            log.push("timer.exit:" + self.id.to_string() + ":ok=true")
        } else {
            log.push("timer.exit:" + self.id.to_string() + ":ok=false")
        }
    }
}

test "a_skip_inside_with_block fires cleanup with ok=false" {
    with Timer { id: 7 } as _t {
        log.push("before-skip")
        skip("not ready")
        log.push("SHOULD-NOT-REACH")
    }
}

test "b_verify_cleanup_ran" {
    assert(log_has("before-skip"))
    assert(log_has("timer.exit:7:ok=false"))
    assert(!log_has("SHOULD-NOT-REACH"))
}
