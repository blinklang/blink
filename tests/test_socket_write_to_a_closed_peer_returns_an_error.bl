// A write to a socket whose peer has closed gives the caller an error and leaves the process
// running. Before, the write raised SIGPIPE, which ends a process that has not set it aside:
// a daemon died whenever a client went away before reading its reply.

import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/socket_write_closed_peer"

// A connection whose other end is already closed.
fn orphaned_conn(name: Str) -> Int {
    let _ = process_run("sh", ["-c", "rm -rf {DIR}/{name}; mkdir -p {DIR}/{name}"])
    let path = "{DIR}/{name}/s.sock"
    let listener = unix_socket_listen(path)
    let client = unix_socket_connect(path)
    let conn = unix_socket_accept(listener)
    unix_socket_close(client)
    unix_socket_close(listener)
    conn
}

test "a write to a closed peer leaves the process running" {
    let conn = orphaned_conn("lives")
    assert(conn >= 0)
    socket_write(conn, "reply\n")
    socket_write(conn, "reply\n")
    unix_socket_close(conn)
    assert(true)
}

test "a write to a closed peer returns -1" {
    let conn = orphaned_conn("minus_one")
    assert(conn >= 0)
    let wrote = socket_write(conn, "reply\n")
    unix_socket_close(conn)
    assert_eq(wrote, -1)
}

test "a write to an open peer returns the bytes written" {
    let _ = process.run("sh", ["-c", "rm -rf {DIR}/open; mkdir -p {DIR}/open"])?
    let path = "{DIR}/open/s.sock"
    let listener = unix_socket_listen(path)
    let client = unix_socket_connect(path)
    let conn = unix_socket_accept(listener)
    let wrote = socket_write(client, "one line\nnext\n")
    let first = socket_read_line(conn)
    let second = socket_read_line(conn)
    unix_socket_close(client)
    let at_end = socket_read_line(conn)
    unix_socket_close(conn)
    unix_socket_close(listener)
    assert_eq(wrote, 14)
    assert_eq(first, "one line")
    assert_eq(second, "next")
    assert_eq(at_end, "")
}
