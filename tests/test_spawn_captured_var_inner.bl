// An un-annotated spawn whose body reads a CAPTURED outer `let` must take its task
// return type from that variable's type. The body is first walked by the
// annotation-blind name-resolution pass, where the capture has no type yet; that
// pass must not lock a Handle[Unknown] the typed pass then reuses. A bare-variable
// body (`fn() { m }`) is the sharpest form — no literal operand to pin the result.

test "spawn returning a bare captured Int var awaits the int" {
    let m = 7
    let h = async.spawn(fn() { m })
    assert_eq(h.await, 7)
}

test "spawn returning captured var times captured var awaits the product" {
    let m = 7
    let h = async.spawn(fn() { m * m })
    assert_eq(h.await, 49)
}

test "spawn over a captured var inside async.scope awaits it" {
    let base = 10
    async.scope {
        let h = async.spawn(fn() { base + base })
        assert_eq(h.await, 20)
    }
}

// A COMPOUND inner (here List[Int]) built from a captured var must upgrade too:
// the name-resolution pass memoizes Handle[List[?]], whose hole sits one level
// down. The determined-memo guard checks for a hole to any depth, so this is
// re-walked on the typed pass and the element type recovered — not left erased.
test "spawn returning a list built from a captured var awaits the list" {
    let n = 5
    let h = async.spawn(fn() { [n, n, n] })
    let r = h.await
    assert_eq(r.len(), 3)
    assert_eq(r.get(0).unwrap(), 5)
}
