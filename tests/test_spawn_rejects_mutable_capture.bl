import compile_test_helpers

// A closure handed to async.spawn may not capture a mutable root (§2.8, E0650): a `let mut`,
// a `mut` pattern binder, a `mut` parameter or `mut self`. The task and the enclosing scope
// would share one mutable root with no order between them.
// The rule is on the capture, not on a write, so a task that only reads the binding is
// rejected too. Copying the value into a `let` first is the fix the spec names, and a
// closure that captures a `let mut` but is never spawned is ordinary.

fn expect_rejected(src: Str, tag: Str, name: Str) ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0650", "{tag}: spawn capturing `{name}` is E0650")
    compile_test_helpers.expect_contains(out, "`{name}`", "{tag}: the report names `{name}`")
}

// The second label of the report spans the `mut` keyword exactly: three columns on its line.
fn expect_mut_label(out: Str, line: Int, col: Int, what: Str, label: Str) ! IO.Print {
    let span = "\"line\":{line},\"col\":{col},\"end_line\":{line},\"end_col\":{col + 3}\}"
    compile_test_helpers.expect_contains(out, "{span},\"message\":\"{what}\"", label)
}

fn expect_accepted(src: Str, tag: Str) ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, "{tag}: compiles with no error")
}

test "a spawned closure that assigns a let mut is rejected" {
    expect_rejected(#"fn main() ! Async {
    let mut counter = 0
    async.scope {
        let _h = async.spawn(fn() { counter += 1 })
    }
}
"#, "_spawnmut_assign", "counter")
}

test "a spawned closure that only reads a let mut is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    let mut counter = 0
    let h = async.spawn(fn() { counter + 1 })
    io.println("{h.await}")
}
"#, "_spawnmut_read", "counter")
}

test "a closure held in a let and then spawned is rejected for its let mut capture" {
    expect_rejected(#"fn main() ! Async, IO {
    let mut counter = 0
    let f = fn() { counter + 1 }
    let h = async.spawn(f)
    io.println("{h.await}")
}
"#, "_spawnmut_alias", "counter")
}

test "a closure nested in a spawned closure is rejected for its let mut capture" {
    expect_rejected(#"fn main() ! Async, IO {
    let mut counter = 0
    let h = async.spawn(fn() {
        let g = fn() { counter + 1 }
        g()
    })
    io.println("{h.await}")
}
"#, "_spawnmut_nested", "counter")
}

test "a let mut closure reassigned to one that captures a let mut is rejected when spawned" {
    expect_rejected(#"fn main() ! Async, IO {
    let mut counter = 0
    let mut f = fn() { 0 }
    f = fn() { counter + 1 }
    let h = async.spawn(f)
    io.println("{h.await}")
}
"#, "_spawnmut_reassigned", "counter")
}

test "a spawned closure in a method body is rejected for its let mut capture" {
    expect_rejected(#"type Box { n: Int }
trait Runner {
    fn run(self) -> Int ! Async
}
impl Runner for Box {
    fn run(self) -> Int ! Async {
        let mut total = self.n
        let h = async.spawn(fn() { total + 1 })
        h.await
    }
}
fn main() ! Async, IO {
    io.println("{Box { n: 1 }.run()}")
}
"#, "_spawnmut_method", "total")
}

test "a mut leaf of a destructuring let captured by a spawned closure is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    let (mut left, right) = (1, 2)
    let h = async.spawn(fn() { left + right })
    io.println("{h.await}")
}
"#, "_spawnmut_destructure", "left")
}

test "a snapshot of a let mut copied into a let may be spawned" {
    expect_accepted(#"fn main() ! Async, IO {
    let mut counter = 0
    counter = 5
    let snapshot = counter
    let h = async.spawn(fn() { snapshot + 1 })
    io.println("{h.await}")
}
"#, "_spawnmut_snapshot")
}

test "a let mut declared inside the spawned closure is the task's own" {
    expect_accepted(#"fn main() ! Async, IO {
    let h = async.spawn(fn() {
        let mut n = 0
        n += 2
        n
    })
    io.println("{h.await}")
}
"#, "_spawnmut_inner")
}

test "immutable captures of a list and a channel may be spawned" {
    expect_accepted(#"fn main() ! Async, IO {
    let xs = [1, 2, 3]
    let ch = channel.new[Int](buffer: 1)
    let h = async.spawn(fn() {
        ch.send(xs.len())
        0
    })
    let _ = h.await
    for got in ch {
        io.println("{got}")
        break
    }
}
"#, "_spawnmut_immutable")
}

test "a closure that captures a let mut and is called, not spawned, is accepted" {
    expect_accepted(#"fn main() ! Async, IO {
    let mut counter = 0
    let bump = fn() { counter += 1 }
    bump()
    let snapshot = counter
    let h = async.spawn(fn() { snapshot })
    io.println("{h.await}")
}
"#, "_spawnmut_sync_call")
}

// A `mut` pattern binder is a mutable root as a `let mut` is (§3.5 *Mutable Binders*), so
// the same rule holds for it. A name with no `mut` in the same pattern stays immutable.

test "a mut binder in a destructuring let captured by a spawned closure is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    let (mut a, b) = (1, 2)
    a += b
    let h = async.spawn(fn() { a + 1 })
    io.println("{h.await}")
}
"#, "_spawnmut_let_binder", "a")
}

test "a binder with no mut beside a mut binder may be spawned" {
    expect_accepted(#"fn main() ! Async, IO {
    let (mut a, b) = (1, 2)
    a += b
    let h = async.spawn(fn() { b + 1 })
    io.println("{a} {h.await}")
}
"#, "_spawnmut_let_plain_binder")
}

test "a mut binder in a for pattern captured by a spawned closure is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    for (k, mut v) in [(1, 2)] {
        v += k
        let h = async.spawn(fn() { v + 1 })
        io.println("{h.await}")
    }
}
"#, "_spawnmut_for_pattern", "v")
}

test "a for mut binder captured by a spawned closure is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    for mut i in [1, 2] {
        i += 1
        let h = async.spawn(fn() { i + 1 })
        io.println("{h.await}")
    }
}
"#, "_spawnmut_for_binder", "i")
}

test "a mut binder in a variant pattern captured by a spawned closure is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    let o: Int? = Some(1)
    match o {
        Some(mut v) => {
            v += 1
            let h = async.spawn(fn() { v + 1 })
            io.println("{h.await}")
        }
        None => {}
    }
}
"#, "_spawnmut_variant", "v")
}

test "a mut struct field shorthand captured by a spawned closure is rejected" {
    expect_rejected(#"type P { x: Int, y: Int }
fn main() ! Async, IO {
    let p = P { x: 1, y: 2 }
    match p {
        P { mut x, y } => {
            x += y
            let h = async.spawn(fn() { x + 1 })
            io.println("{h.await}")
        }
    }
}
"#, "_spawnmut_field", "x")
}

test "a mut name before as captured by a spawned closure is rejected" {
    expect_rejected(#"fn main() ! Async, IO {
    let o: Int? = Some(1)
    match o {
        mut whole as Some(v) => {
            whole = Some(v + 1)
            let h = async.spawn(fn() { whole ?? 0 })
            io.println("{h.await}")
        }
        _ => {}
    }
}
"#, "_spawnmut_as_name", "whole")
}

test "a binder with no mut inside a mut as pattern may be spawned" {
    expect_accepted(#"fn main() ! Async, IO {
    let o: Int? = Some(1)
    match o {
        mut whole as Some(v) => {
            whole = None
            let h = async.spawn(fn() { v + 1 })
            io.println("{whole ?? 0} {h.await}")
        }
        _ => {}
    }
}
"#, "_spawnmut_as_inner")
}

test "a closure assigned to a mut binder is rejected when spawned for its let mut capture" {
    expect_rejected(#"fn main() ! Async, IO {
    let mut counter = 0
    let zero = fn() { 0 }
    let (mut f, n) = (zero, 1)
    f = fn() { counter + n }
    let h = async.spawn(f)
    io.println("{h.await}")
}
"#, "_spawnmut_binder_reassigned", "counter")
}

// A `mut` parameter and `mut self` are mutable roots like a `let mut` (§2.8, §3.5): a mutating
// call from the task races with the spawner, so the capture is refused in check, and the
// report points at the binder's `mut`.

test "a spawned closure that pushes to a mut Bytes parameter is rejected" {
    let src = #"fn fill(mut b: Bytes) -> Int ! Async {
    async.scope {
        let h = async.spawn(fn() { b.push(1) })
        h.await
    }
    b.len()
}

fn main() ! Async, IO {
    io.println("{fill(Bytes.new())}")
}
"#
    expect_rejected(src, "_spawnmut_param_bytes", "b")
    let out = compile_test_helpers.compile_and_capture(src, "_spawnmut_param_bytes_note")
    expect_mut_label(out, 1, 9, "`b` is a `mut` parameter", "_spawnmut_param_bytes: the report underlines the parameter's `mut`")
}

test "a spawned closure that only reads a mut List parameter is rejected" {
    expect_rejected(#"fn count(mut xs: List[Int]) -> Int ! Async {
    xs.push(3)
    async.scope {
        let h = async.spawn(fn() { xs.len() })
        h.await
    }
}

fn main() ! Async, IO {
    io.println("{count([1, 2])}")
}
"#, "_spawnmut_param_read", "xs")
}

test "a spawned closure that reads mut self is rejected" {
    let src = #"type Pack { data: Bytes }

trait Run {
    fn run(mut self) -> Int ! Async
}

impl Run for Pack {
    fn run(mut self) -> Int ! Async {
        self.data.push(1)
        async.scope {
            let h = async.spawn(fn() { self.data.len() })
            h.await
        }
    }
}

fn main() ! Async, IO {
    let p = Pack { data: Bytes.new() }
    io.println("{p.run()}")
}
"#
    expect_rejected(src, "_spawnmut_self", "self")
    let out = compile_test_helpers.compile_and_capture(src, "_spawnmut_self_note")
    expect_mut_label(out, 8, 12, "`mut self` is a mutable root", "_spawnmut_self: the report underlines the receiver's `mut`")
}

test "a let mut capture report points at the binding's mut" {
    let out = compile_test_helpers.compile_and_capture(#"fn main() ! Async, IO {
    let mut counter = 0
    let h = async.spawn(fn() { counter + 1 })
    io.println("{h.await}")
}
"#, "_spawnmut_let_note")
    expect_mut_label(out, 2, 9, "`counter` is a `let mut` binding", "_spawnmut_let_note: the report underlines the `mut` of the `let mut`")
}

test "a mut pattern binder capture report points at the binder's mut" {
    let out = compile_test_helpers.compile_and_capture(#"fn main() ! Async, IO {
    let (mut a, b) = (1, 2)
    a += b
    let h = async.spawn(fn() { a + 1 })
    io.println("{h.await}")
}
"#, "_spawnmut_pattern_note")
    expect_mut_label(out, 2, 10, "`a` is a `mut` pattern binder", "_spawnmut_pattern_note: the report underlines the binder's `mut`")
}

test "a for mut binder capture report points at the binder's mut" {
    let out = compile_test_helpers.compile_and_capture(#"fn main() ! Async, IO {
    for mut i in [1, 2] {
        i += 1
        let h = async.spawn(fn() { i + 1 })
        io.println("{h.await}")
    }
}
"#, "_spawnmut_for_note")
    expect_mut_label(out, 2, 9, "`i` is a `mut` pattern binder", "_spawnmut_for_note: the report underlines the binder's `mut`")
}

test "a mut parameter captured by a closure held in a let and then spawned is rejected" {
    expect_rejected(#"fn fill(mut b: Bytes) -> Int ! Async {
    let f = fn() { b.len() }
    async.scope {
        let h = async.spawn(f)
        h.await
    }
}

fn main() ! Async, IO {
    io.println("{fill(Bytes.new())}")
}
"#, "_spawnmut_param_alias", "b")
}

test "a closure nested in a spawned closure is rejected for its mut parameter capture" {
    expect_rejected(#"fn fill(mut b: Bytes) -> Int ! Async {
    async.scope {
        let h = async.spawn(fn() {
            let g = fn() { b.len() }
            g()
        })
        h.await
    }
}

fn main() ! Async, IO {
    io.println("{fill(Bytes.new())}")
}
"#, "_spawnmut_param_nested", "b")
}

test "a closure assigned to the copy of a parameter is rejected when spawned for its let mut capture" {
    expect_rejected(#"fn run(g: fn() -> Int) -> Int ! Async {
    let mut g = g
    let mut c = 0
    g = fn() { c + 1 }
    c = 5
    let h = async.spawn(g)
    h.await
}

fn main() ! Async, IO {
    io.println("{run(fn() { 0 })}")
}
"#, "_spawnmut_param_reassigned", "c")
}

test "a parameter with no mut may be spawned" {
    expect_accepted(#"fn count(xs: List[Int]) -> Int ! Async {
    async.scope {
        let h = async.spawn(fn() { xs.len() })
        h.await
    }
}

fn main() ! Async, IO {
    io.println("{count([1, 2])}")
}
"#, "_spawnmut_param_plain")
}

test "a copy of a mut parameter bound with let may be spawned" {
    expect_accepted(#"fn fill(mut b: Bytes) -> Int ! Async {
    let snap = b
    let n = async.scope {
        let h = async.spawn(fn() { snap.len() })
        b.push(2)
        h.await
    }
    n + b.len()
}

fn main() ! Async, IO {
    io.println("{fill(Bytes.new())}")
}
"#, "_spawnmut_param_copy")
}
