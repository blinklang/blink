// A per-module build cuts a large module's unit into chunks. The cut changes how the C is
// laid out, never what the program does, and never the bytes a build leaves: after each edit
// of an edit loop, a build through the daemon writes the same headers, chunks and program as
// a cold build in a twin tree, and the program prints what a build that does not cut prints.
// BLINK_UNIT_CHUNK_DECLS makes the chunks small, so a small module splits; 0 cuts nothing.

import std.process.{ProcessResult}
import std.testing.{cleanup}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

// Twelve private functions, each with a call that can panic, so each one's C names a
// source position.
fn big_source() -> Str {
    let mut lines: List[Str] = []
    let mut i = 0
    while i < 12 {
        lines.push("fn part{i}(n: Int) -> Int \{")
        lines.push("    let xs = [n, {i}]")
        lines.push("    xs.get(1).unwrap() + n * {i + 1}")
        lines.push("}")
        lines.push("")
        i = i + 1
    }
    let mut calls: List[Str] = []
    i = 0
    while i < 12 {
        calls.push("part{i}(n)")
        i = i + 1
    }
    lines.push("pub fn total(n: Int) -> Int \{")
    lines.push("    {calls.join(" + ")}")
    lines.push("}")
    lines.push("")
    // Padding lifts the module over the split bar of sixteen times BLINK_UNIT_CHUNK_DECLS decls.
    let mut pads: List[Str] = []
    i = 0
    while i < 24 {
        lines.push("fn pad{i}() -> Int \{ 0 }")
        lines.push("")
        pads.push("pad{i}()")
        i = i + 1
    }
    lines.push("pub fn pads() -> Int \{ {pads.join(" + ")} }")
    lines.push("")
    lines.join("\n")
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"chunk_equal_app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/big.bl", big_source())
    write_file("{tree}/app/src/main.bl", [
        #"import big.{total}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("total {total(2)}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it serves only a client whose env is its own. Each build also checks
// that the units it took from the last build are the ones a cold emit writes.
fn env_of(tree: Str, chunk: Int) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_UNIT_CHUNK_DECLS={chunk} BLINK_EMIT_REUSE_VERIFY=1 BLINK_CACHE_DIR={tree}/objcache"
}

fn build(tree: Str, chunk: Int) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree}/app && {env_of(tree, chunk)} ../build/blink build src/main.bl -o out/app"])
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree, 2)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process_run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"])
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if up.exit_code != 0 {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// What two trees' last builds left that differs: a C file of the units, or the program.
fn output_differ(a_tree: Str, b_tree: Str) -> Str {
    sh("cd {b_tree}/app/out/app.units && for f in *.c *.h; do cmp -s $f {a_tree}/app/out/app.units/$f || echo $f; done; cd {a_tree}/app/out/app.units && for f in *.c *.h; do [ -e {b_tree}/app/out/app.units/$f ] || echo extra:$f; done; cmp -s {a_tree}/app/out/app {b_tree}/app/out/app || echo program").split("\n").join(" ")
}

fn edit_all(trees: List[Str], sed: Str) {
    for t in trees {
        let path = "{t}/app/src/big.bl"
        let before = read_file(path)
        shell_exec("sed -i '{sed}' {path}")
        assert(read_file(path) != before, "the edit `{sed}` did not change big.bl")
    }
}

// Builds in all three trees after the step named label; what differs, or "".
fn compare(warm: Str, cold: Str, whole: Str, label: Str) -> Str {
    let w = build(warm, 2)
    let c = build(cold, 2)
    let h = build(whole, 0)
    if w.exit_code != 0 || c.exit_code != 0 || h.exit_code != 0 {
        return "{label}: a build failed: {w.out}{w.err_out}{c.out}{c.err_out}{h.out}{h.err_out}"
    }
    let o = output_differ(warm, cold)
    if o != "" { return "{label}: {o}" }
    let ran_warm = sh("{warm}/app/out/app")
    let ran_whole = sh("{whole}/app/out/app")
    if ran_warm != ran_whole { return "{label} program: {ran_warm} vs {ran_whole}" }
    ""
}

test "a build that cuts a large module matches a cold build and a build that does not cut" {
    let root = sh("pwd -P")
    let warm = "{root}/.tmp/_chunk_equal_warm_{getpid()}"
    let cold = "{root}/.tmp/_chunk_equal_cold_{getpid()}"
    let whole = "{root}/.tmp/_chunk_equal_whole_{getpid()}"
    for t in [warm, cold, whole] { dev_tree(root, t) }
    let trees = [warm, cold, whole]
    let pid = start_daemon(warm)
    let mut problems: List[Str] = []
    let mut chunks = 0
    with cleanup(fn() { stop_daemon(pid) }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        problems.push(compare(warm, cold, whole, "first build"))
        chunks = sh("ls {warm}/app/out/app.units | grep -c '^big\\.p.*\\.c$'").to_int()

        edit_all(trees, "s/n \\* 8$/n * 80/")
        problems.push(compare(warm, cold, whole, "body edit"))

        edit_all(trees, "/^fn part3(/a\\    let _pad = 1")
        problems.push(compare(warm, cold, whole, "body edit that adds a line"))

        edit_all(trees, "/^fn part6(/i\\pub fn added(n: Int) -> Int \{ n + 1 \}\\n")
        problems.push(compare(warm, cold, whole, "new function"))
    }
    shell_exec("rm -rf {warm} {cold} {whole}")
    let found: List[Str] = problems.filter(fn(p) { p != "" })
    assert(chunks > 1, "the large module was not cut into chunks")
    assert_eq(found.join("\n"), "")
}
