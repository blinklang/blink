// A cut puts two functions of one module in two C files, and each file has its own copy of a
// string literal and of a default handler table. A program must not tell: a handler set up in
// one file serves a perform in another, a literal from one file equals and keys a map like the
// same literal from another, and a closure made in one file runs from another. The split build
// prints what the whole build prints. BLINK_UNIT_CHUNK_DECLS makes the chunks small, so a small
// module splits; 0 cuts nothing.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// The first functions and the last ones are more than four times the target apart, so a cut
// falls between them.
fn big_source() -> Str {
    let mut lines: List[Str] = [
        "effect Tally \{",
        "    effect Bump \{",
        "        fn bump(n: Int) -> Int",
        "    }",
        "}",
        "",
        "fn shared_key() -> Str \{ \"shared-key\" }",
        "",
        "fn adder(k: Int) -> fn(Int) -> Int \{",
        "    fn(n: Int) -> Int \{ n + k }",
        "}",
        "",
        "pub fn run() -> Str \{",
        "    with handler Tally \{",
        "        fn bump(n: Int) -> Int \{ n * 10 }",
        "    } \{",
        "        far_side(adder(5))",
        "    }",
        "}",
        "",
    ]
    let mut i = 0
    while i < 40 {
        lines.push("fn pad{i}() -> Int \{ {i} }")
        lines.push("")
        i = i + 1
    }
    lines.push("pub fn pads() -> Int \{ pad0() + pad39() }")
    lines.push("")
    lines.push("fn far_side(add: fn(Int) -> Int) -> Str ! Tally.Bump \{")
    lines.push("    let mut m: Map[Str, Int] = Map()")
    lines.push("    m.insert(\"shared-key\", 7)")
    lines.push("    let same = shared_key() == \"shared-key\"")
    lines.push("    let got = m.get(shared_key()) ?? -1")
    lines.push("    \"same \{same} got \{got} bump \{tally.bump(4)} add \{add(1)}\"")
    lines.push("}")
    lines.push("")
    lines.join("\n")
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"chunk_share_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/big.bl", big_source())
    write_file("{tree}/app/src/main.bl", [
        #"import big.{run}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println(run())"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// one unit, so the run drops them.
fn build(tree: Str, chunk: Int) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_UNIT_CHUNK_DECLS={chunk} BLINK_CACHE_DIR={tree}/objcache_{chunk} build/blink build app/src/main.bl -o {tree}/out_{chunk}/app --per-module"]).unwrap()
}

// The C file of big's split unit that holds text.
fn file_with(tree: Str, text: Str) -> Str {
    sh("cd {tree}/out_2/app.units && grep -l -F '{text}' big.*c")
}

test "functions of one module in two chunks share handlers, strings and closures" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_split_share_{getpid()}"
    dev_tree(root, tree)
    let split = build(tree, 2)
    let whole = build(tree, 0)
    let split_out = sh("{tree}/out_2/app")
    let whole_out = sh("{tree}/out_0/app")
    let key_file = file_with(tree, "blink_map_set(")
    let literal_file = file_with(tree, "blink_big_shared_1key(void) \{")
    let chunks = sh("ls {tree}/out_2/app.units | grep -c '^big\\..*c$'").to_int()
    shell_exec("rm -rf {tree}")
    assert(split.exit_code == 0, "split build failed: {split.out}{split.err_out}")
    assert(whole.exit_code == 0, "whole build failed: {whole.out}{whole.err_out}")
    assert(chunks > 2, "big was not cut: {chunks} files")
    assert(key_file != "" && literal_file != "", "no file holds the function: {key_file} {literal_file}")
    assert(key_file != literal_file, "both functions are in one chunk: {key_file}")
    assert_eq(split_out, "same true got 7 bump 40 add 6")
    assert_eq(split_out, whole_out)
}
