// There is no FFI effect (sections/07_trust_modules_metadata.md), so each @ffi binding in the
// compiler states the effects of the C it calls. The fns listed below still carry `! FFI`
// because the spec does not yet say which effect covers them: errno and the GC's switches are
// C global state, and the fd-table calls (close, pipe, dup, dup2, fcntl, flock) and setpgid
// have no named effect. Any other src fn in the symbol index under FFI fails this test.

import std.process.{ProcessResult}

fn ffi_fns_in(file: Str) -> ProcessResult {
    process_run("sh", ["-c", "$(pwd)/build/blink query src/{file} --effect FFI"])
}

// The "name" of each result, in the order the index gives them.
fn result_names(json: Str) -> List[Str] {
    let mut names: List[Str] = []
    let parts = json.split("\"name\":\"")
    let mut i = 1
    while i < parts.len() {
        names.push(parts.get(i).unwrap().split("\"").get(0) ?? "")
        i = i + 1
    }
    names
}

test "only the held src @ffi bindings carry an FFI row" {
    let held = [
        "build_fs.bl bfs_close",
        "build_fs.bl bfs_dup2",
        "build_fs.bl bfs_errno",
        "build_fs.bl bfs_fcntl",
        "build_fs.bl bfs_flock",
        "build_fs.bl bfs_pipe",
        "compiler.bl gc_disable",
        "compiler.bl gc_enable",
        "compiler.bl gc_is_disabled",
        "compiler.bl gc_set_free_space_divisor",
        "daemon.bl daemon_dup",
        "daemon.bl daemon_dup2",
        "daemon.bl daemon_errno",
        "daemon.bl daemon_gc_collect",
        "daemon.bl daemon_gc_start_markers",
        "daemon.bl daemon_setpgid",
        "sha256.bl sha256_close",
    ]
    let mut found: List[Str] = []
    for file in list_dir("src") {
        if !file.ends_with(".bl") { continue }
        let r = ffi_fns_in(file)
        if r.exit_code != 0 {
            io.eprintln("src/{file}:\n{r.out}\nstderr:\n{r.err_out}")
        }
        assert_eq(r.exit_code, 0)
        for name in result_names(r.out) {
            found.push("{file} {name}")
        }
    }
    assert_eq(found.sort().join("\n"), held.join("\n"))
}
