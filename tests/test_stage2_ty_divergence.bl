// Stage 2 of the tid collapse (decisions/compiler-type-representation.md Q2, 5-0):
// ScopeVar carries typecheck's tid, and a divergence counter turns an unbounded backlog
// into a finite enumerated list.
//
// WHAT STAGE 2 IS FOR. Codegen re-derives every type from ScopeVar's flat fields
// (ctype, inner1, inner2, sname, sname2, extra). The pair (CT_*, sname) represents depth
// 1, so everything at depth >= 2 is unrepresentable and sv_tp INVENTS an answer for the
// missing slot — `type_list(type_int())`, `type_map(type_string(), type_int())`. Every
// "erases the element to Int" ticket across nqq29j / ng2qd3 / 03p551 is that invention.
// Stage 2 does not fix any of them. It STAMPS the authoritative tid alongside the flat
// fields and MEASURES, per call site, where the two disagree — so Stage 3 works from an
// enumerated list instead of discovering cells one user bug report at a time.
//
// STAGE 2 CHANGES NO EMITTED C. Nothing in the emit path reads `sv.ty`; the flat fields
// still govern every decision. That is the byte-identity gate the plan puts on Stages 0-2,
// and it is why the instrument can be trusted: it observes without perturbing.
//
// THE FOUR ROWS THAT MATTER MOST, and why each is a row and not a comment:
//   * get_var_ty answers -1 on a miss. get_var_tp, its sibling, answers `type_int()` —
//     a FABRICATED Int for a variable that does not exist. Copying that default into the
//     tid seam would reintroduce, at the very first accessor of the collapse, exactly the
//     lie the collapse exists to remove.
//   * a stamped tid SURVIVES later flat-field refinement. All 34 mutation sites rebuild
//     the ScopeVar and carry `ty` across unchanged. Invalidating it there would be the
//     tempting move ("the flat fields were just refined, so the tid is stale") and it
//     would blind the instrument: a flat refinement that contradicts the stamped tid IS
//     the divergence the counter must report.
//   * the counter is keyed BY CALL SITE. A scalar total answers "how bad", which is not
//     actionable. Stage 3's exit criterion is the counter at 0, which needs a per-site
//     breakdown to work through.
//   * MISSING and DIVERGE are separate buckets. "No tid was stamped here" is a stamping
//     gap (Stage 2 work); "a tid was stamped and the flat fields say something else" is a
//     lowering bug (Stage 3 work). One number covering both would conflate the remaining
//     instrumentation with the remaining fixes.
//
// WHY THE COMPARISON IS STRUCTURAL, NOT STRING-EQUALITY. The two universes render types
// with different vocabularies (tp_display has no Set arm at all and spells a closure
// `Fn(sig)`; tc_type_str spells struct instances with their mono stem). Comparing the
// rendered strings would manufacture DIVERGE rows for pure spelling differences and bury
// the real cells. sv_ty_or_flat walks both trees in parallel comparing kinds through
// tk_to_ct — the translation layer that already exists and that Stage 4 deletes — and
// reports the two renderings only as row text for a human reading the sweep.
//
// SETUP HAZARDS (inherited from tests/test_tc_tid_structural_accessors.bl):
//  1. Base scalar tids (TYPE_INT et al) are private globals seeded during check_types, so
//     they are harvested from a probe program keyed by rendered type string.
//  2. Bare `import codegen_expr` is load-bearing even though `blink check` reports it
//     UNUSED: codegen_types resolves several globals out of the MERGED program rather than
//     importing them. Dropping it on the warning's advice fails at C compile, not at check.
//  3. Scope state is process-global, so every row calls reset_scope_state() +
//     reset_ty_divergence() first rather than trusting test ordering.

// The instrument lives in typecheck.bl because it is the only module that can see BOTH type
// universes — typecheck imports codegen_types, never the reverse — and it already owns
// tk_to_ct, the translation the comparison runs through.
import std.fs
import typecheck.{
    check_types, tc_lookup_node_tid, tc_type_str,
    make_list_type, make_map_type, make_set_type, make_option_type,
    tc_unknown_tid,
    TyDiv, sv_ty_or_flat, reset_ty_divergence,
    ty_divergence_count, ty_divergence_total, ty_divergence_rows,
}
import codegen_types.{
    CT_INT, CT_STRING, CT_LIST, CT_MAP, CT_SET, CT_OPTION,
    set_var, set_var_ty, get_var_ty, get_var_tp, set_var_option,
    set_list_elem_type, set_map_types, push_scope, pop_scope, reset_scope_state,
}
import parser.{nodes}
import compiler.{compile_to_program}
import std.io
import codegen_expr

fn assert_eq_int(label: Str, got: Int, want: Int) {
    if got != want { io.println("FAIL: {label} — got {got}, want {want}") }
    assert_eq(got, want)
}

fn div_name(b: TyDiv) -> Str {
    match b {
        TyDiv.Agree => "Agree"
        TyDiv.Diverge => "Diverge"
        TyDiv.Missing => "Missing"
        TyDiv.Unknown => "Unknown"
    }
}

fn assert_bucket(site: Str, b: TyDiv, want: Int) {
    let got = ty_divergence_count(site, b)
    if got != want {
        io.println("FAIL: site '{site}' bucket {div_name(b)} — got {got}, want {want}")
        let rows = ty_divergence_rows()
        let mut i = 0
        while i < rows.len() {
            io.println("  row: {rows.get(i).unwrap()}")
            i = i + 1
        }
    }
    assert_eq(got, want)
}

fn probe_src() -> Str {
    "fn probe() -> Int \{\n    let a = 1\n    let b = \"s\"\n    let c = true\n    a\n}\n"
}

fn harvest_scalars() -> Map[Str, Int] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/stage2_ty_divergence_probe.bl"
    write_file(path, probe_src())
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    let mut m: Map[Str, Int] = Map()
    let mut idx = 0
    let n = nodes.len()
    while idx < n {
        let tid = tc_lookup_node_tid(idx)
        if tid >= 0 {
            m.insert(tc_type_str(tid), tid)
        }
        idx = idx + 1
    }
    m
}

fn expect_tid(m: Map[Str, Int], key: Str) -> Int {
    let tid = m.get(key) ?? -1
    if tid == -1 {
        io.println("FAIL: harvested map has no tid for rendered type string '{key}'")
    }
    assert(tid != -1)
    tid
}

fn fresh() {
    reset_scope_state()
    reset_ty_divergence()
}

// ════ Half A — the stamping seam ═════════════════════════════════════════════

test "a variable created through set_var starts unstamped" {
    fresh()
    set_var("x", CT_INT, 0)
    assert_eq_int("unstamped ty", get_var_ty("x"), -1)
}

test "set_var_ty stamps a tid that get_var_ty reads back" {
    fresh()
    let m = harvest_scalars()
    let int_tid = expect_tid(m, "Int")
    reset_scope_state()
    set_var("x", CT_INT, 0)
    set_var_ty("x", int_tid)
    assert_eq_int("stamped ty", get_var_ty("x"), int_tid)
}

// get_var_tp answers a FABRICATED type_int() for a name that does not exist. The tid seam
// must not copy that: -1 is "codegen has no tid here", which is a different claim from
// "this variable is an Int", and the whole collapse depends on being able to tell them
// apart. This row pins the divergence between the two accessors deliberately.
test "get_var_ty answers -1 for an unknown name where get_var_tp fabricates" {
    fresh()
    assert_eq_int("unknown name has no tid", get_var_ty("nope"), -1)
    assert(get_var_tp("nope") >= 0)
}

test "set_var_ty on an unknown name is a no-op, not a creation" {
    fresh()
    set_var_ty("ghost", 7)
    assert_eq_int("ghost was not created", get_var_ty("ghost"), -1)
}

// The preservation invariant. set_list_elem_type rebuilds the ScopeVar to refine inner1;
// the stamped tid must ride through. If it were invalidated here the counter would report
// MISSING for every variable codegen refines, which is most of them — and the sweep would
// measure the instrument's own amnesia instead of the compiler's divergence.
test "a stamped tid survives a later flat-field refinement" {
    fresh()
    let m = harvest_scalars()
    let int_tid = expect_tid(m, "Int")
    let list_int = make_list_type(int_tid)
    reset_scope_state()
    set_var("xs", CT_LIST, 0)
    set_var_ty("xs", list_int)
    set_list_elem_type("xs", CT_INT)
    assert_eq_int("ty survived set_list_elem_type", get_var_ty("xs"), list_int)
}

test "a stamped tid survives set_map_types" {
    fresh()
    let m = harvest_scalars()
    let int_tid = expect_tid(m, "Int")
    let str_tid = expect_tid(m, "Str")
    let map_tid = make_map_type(str_tid, int_tid)
    reset_scope_state()
    set_var("mm", CT_MAP, 0)
    set_var_ty("mm", map_tid)
    set_map_types("mm", CT_STRING, CT_INT, "")
    assert_eq_int("ty survived set_map_types", get_var_ty("mm"), map_tid)
}

test "shadowed bindings carry independent tids" {
    fresh()
    let m = harvest_scalars()
    let int_tid = expect_tid(m, "Int")
    let str_tid = expect_tid(m, "Str")
    reset_scope_state()
    set_var("v", CT_INT, 0)
    set_var_ty("v", int_tid)
    push_scope()
    set_var("v", CT_STRING, 0)
    set_var_ty("v", str_tid)
    assert_eq_int("inner binding's tid", get_var_ty("v"), str_tid)
    pop_scope()
    assert_eq_int("outer binding's tid restored", get_var_ty("v"), int_tid)
}

// ════ Half B — the divergence instrument ═════════════════════════════════════

test "an unstamped variable lands in MISSING, not DIVERGE" {
    fresh()
    set_var("x", CT_INT, 0)
    assert_eq_int("no tid to hand back", sv_ty_or_flat("x", "unit.missing"), -1)
    assert_bucket("unit.missing", TyDiv.Missing, 1)
    assert_bucket("unit.missing", TyDiv.Diverge, 0)
    assert_bucket("unit.missing", TyDiv.Agree, 0)
}

test "a name with no binding at all is MISSING too" {
    fresh()
    assert_eq_int("no binding, no tid", sv_ty_or_flat("nope", "unit.nobinding"), -1)
    assert_bucket("unit.nobinding", TyDiv.Missing, 1)
}

test "a stamped tid matching the flat fields lands in AGREE and is returned" {
    fresh()
    let m = harvest_scalars()
    let int_tid = expect_tid(m, "Int")
    reset_scope_state()
    reset_ty_divergence()
    set_var("x", CT_INT, 0)
    set_var_ty("x", int_tid)
    assert_eq_int("tid handed back", sv_ty_or_flat("x", "unit.agree"), int_tid)
    assert_bucket("unit.agree", TyDiv.Agree, 1)
    assert_bucket("unit.agree", TyDiv.Diverge, 0)
    assert_bucket("unit.agree", TyDiv.Missing, 0)
}

test "a stamped tid contradicting the flat ctype lands in DIVERGE" {
    fresh()
    let m = harvest_scalars()
    let int_tid = expect_tid(m, "Int")
    let list_int = make_list_type(int_tid)
    reset_scope_state()
    reset_ty_divergence()
    // The flat fields say Str; the tid says List[Int]. Kind mismatch at the root.
    set_var("s", CT_STRING, 0)
    set_var_ty("s", list_int)
    assert_eq_int("the tid still governs the answer", sv_ty_or_flat("s", "unit.root"), list_int)
    assert_bucket("unit.root", TyDiv.Diverge, 1)
    assert_bucket("unit.root", TyDiv.Agree, 0)
}

// The bug family itself, reduced to one row. A depth-2 element type has nowhere to live in
// the flat fields, so sv_tp fabricates the inner element as Int — `List[List[Int]]` — while
// the tid says `List[List[Str]]`. This is the shape behind the "erases the element" tickets,
// and it must land in DIVERGE at depth 2, not be smoothed over by a root-kind-only check.
test "a depth-2 element the flat fields cannot hold lands in DIVERGE" {
    fresh()
    let m = harvest_scalars()
    let str_tid = expect_tid(m, "Str")
    let list_list_str = make_list_type(make_list_type(str_tid))
    reset_scope_state()
    reset_ty_divergence()
    set_var("xss", CT_LIST, 0)
    set_list_elem_type("xss", CT_LIST)
    set_var_ty("xss", list_list_str)
    assert_bucket("unit.depth2", TyDiv.Diverge, 0)
    sv_ty_or_flat("xss", "unit.depth2")
    assert_bucket("unit.depth2", TyDiv.Diverge, 1)
}

// mv45y5 hand-patched sv_tp's CT_SET arm to pass -1 through instead of fabricating Str, so
// an unknown Set element is an ERASED slot rather than a confident wrong answer. The counter
// must still call that a divergence when the tid knows the element: "I could not say" and
// "Set[Str]" are not the same type, and Stage 3 has to fill exactly these.
test "an erased flat slot against a known tid element is DIVERGE, not AGREE" {
    fresh()
    let m = harvest_scalars()
    let str_tid = expect_tid(m, "Str")
    let set_str = make_set_type(str_tid)
    reset_scope_state()
    reset_ty_divergence()
    set_var("ss", CT_SET, 0)
    set_var_ty("ss", set_str)
    sv_ty_or_flat("ss", "unit.seterased")
    assert_bucket("unit.seterased", TyDiv.Diverge, 1)
}

// br dyd8fk. The mirror image of the test above, and the distinction the exit criterion rests on. Here
// the tid does NOT know the element either — `Set[?]` against a flat slot that was never filled — so the
// two representations agree, and what they agree about is that the element is under-determined. Calling
// that DIVERGE made every site holding such a type unable to read 0; calling it AGREE would hide the
// population. It is its own bucket.
test "an erased flat slot against an unknown tid element is UNKNOWN, not DIVERGE" {
    fresh()
    let set_unknown = make_set_type(tc_unknown_tid())
    reset_scope_state()
    reset_ty_divergence()
    set_var("su", CT_SET, 0)
    set_var_ty("su", set_unknown)
    sv_ty_or_flat("su", "unit.setunknown")
    assert_bucket("unit.setunknown", TyDiv.Unknown, 1)
    assert_bucket("unit.setunknown", TyDiv.Diverge, 0)
    assert_bucket("unit.setunknown", TyDiv.Agree, 0)
    assert_bucket("unit.setunknown", TyDiv.Missing, 0)
}

// Ignorance requires BOTH sides to be ignorant, and this is the boundary the ticket is explicit about.
// Here the tid does not know the element but the flat side confidently claims Int — sv_tp fabricating an
// element nobody promised. That is the largest divergence class in the corpus and it must stay a cell:
// "I could not say" against "Int" is not agreement, it is one side making something up.
test "an unknown tid element against a fabricated flat element is still DIVERGE" {
    fresh()
    let list_unknown = make_list_type(tc_unknown_tid())
    reset_scope_state()
    reset_ty_divergence()
    set_var("lu", CT_LIST, 0)
    set_list_elem_type("lu", CT_INT)
    set_var_ty("lu", list_unknown)
    sv_ty_or_flat("lu", "unit.listfabricated")
    assert_bucket("unit.listfabricated", TyDiv.Diverge, 1)
    assert_bucket("unit.listfabricated", TyDiv.Unknown, 0)
}

test "counts are keyed by call site, not pooled" {
    fresh()
    set_var("a", CT_INT, 0)
    set_var("b", CT_INT, 0)
    sv_ty_or_flat("a", "unit.siteA")
    sv_ty_or_flat("b", "unit.siteB")
    sv_ty_or_flat("b", "unit.siteB")
    assert_bucket("unit.siteA", TyDiv.Missing, 1)
    assert_bucket("unit.siteB", TyDiv.Missing, 2)
    assert_eq_int("total across sites", ty_divergence_total(TyDiv.Missing), 3)
    assert_eq_int("one row per site", ty_divergence_rows().len(), 2)
}

test "reset clears every site" {
    fresh()
    set_var("a", CT_INT, 0)
    sv_ty_or_flat("a", "unit.reset")
    assert_eq_int("recorded", ty_divergence_total(TyDiv.Missing), 1)
    reset_ty_divergence()
    assert_eq_int("cleared", ty_divergence_total(TyDiv.Missing), 0)
    assert_eq_int("no rows left", ty_divergence_rows().len(), 0)
}

// An unqueried site must not appear. A sweep's value depends on a zero being a real zero:
// if querying a site created it, "0 divergences at site X" would be indistinguishable from
// "site X was never reached", which is the unexercised-tap failure the plan warns about.
test "querying an unrecorded site does not create it" {
    fresh()
    assert_bucket("unit.never", TyDiv.Missing, 0)
    assert_eq_int("still no rows", ty_divergence_rows().len(), 0)
}

// Option[List[Str]] vs the flat Option whose inner is spelled CT_LIST and whose element is
// therefore fabricated: the same depth-2 hole through a different carrier, so the walk is
// proven generic over the container rather than special-cased for List.
test "the depth-2 hole is reported through an Option carrier too" {
    fresh()
    let m = harvest_scalars()
    let str_tid = expect_tid(m, "Str")
    let opt_list_str = make_option_type(make_list_type(str_tid))
    reset_scope_state()
    reset_ty_divergence()
    set_var("o", CT_OPTION, 0)
    // The inner IS spelled, so the flat side reads Option[List[Int]] and the walk has to
    // reach the element to find the cell. Without this line the row would diverge at depth 1
    // and prove nothing about depth 2.
    set_var_option("o", CT_LIST)
    set_var_ty("o", opt_list_str)
    sv_ty_or_flat("o", "unit.optdepth2")
    assert_bucket("unit.optdepth2", TyDiv.Diverge, 1)
}
