// A program compiled by blinkc to C that includes bootstrap/runtime.h builds with cc alone.
// A closure that leaves `with arena` is promoted, and the promotion reports each capture to
// the trace runtime, so runtime.h must bring the trace runtime in as the flattened header
// does, or the program fails to link.

import compile_test_helpers
import std.process.{ChildEnd}

fn program() -> Str {
    #"fn make(f: fn(Int) -> Int) -> fn() -> Int {
    with arena {
        let g = fn() -> Int { f(1) }
        g
    }
}

fn main() {
    let h = make(fn(x: Int) -> Int { x + 1 })
    io.println("{h()}")
}
"#
}

test "a closure promoted out of with arena links and runs from blinkc and cc -Ibootstrap" {
    let dir = "{compile_test_helpers.scratch_root()}/_standalone_promote"
    process.run("sh", ["-c", "mkdir -p {dir}"]).unwrap()
    let src = "{dir}/promote.bl"
    let c_path = "{dir}/promote.c"
    let bin = "{dir}/promote"
    fs.write(src, program()).unwrap()
    let emit = process.run("build/blinkc", [src, c_path]).unwrap()
    assert_eq(emit.end, ChildEnd.Exited(0), "blinkc failed:\n{emit.out}{emit.err_out}")
    let cc = process.run("cc", ["-O0", "-w", "-Ibootstrap", "-o", bin, c_path, "-lm", "-lgc", "-pthread"]).unwrap()
    assert_eq(cc.end, ChildEnd.Exited(0), "cc failed:\n{cc.out}{cc.err_out}")
    let run = process.run(bin, []).unwrap()
    assert_eq(run.end, ChildEnd.Exited(0))
    assert_eq(run.out, "2\n")
    process.run("rm", ["-rf", dir]).unwrap()
}
