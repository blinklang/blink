// A codegen static-constructor intrinsic (Duration.seconds, Instant.from_epoch_secs,
// Bytes.new, Char, StringBuilder.new, ...) is gated on the receiver's bare spelling
// ("Duration") with no scope check, so a local binding that shadows the type name is
// ignored and the intrinsic constructor is emitted anyway. Once a local `let Duration = 5`
// is in scope, `Duration.seconds(2)` should typecheck as an instance-method call on Int
// (Int has no `.seconds`, so UnresolvedMethod is the spec-correct diagnostic) and must
// never reach the Duration intrinsic path at all.

import compile_test_helpers.{compile_and_capture, expect_error}

test "a local shadowing the Duration type name is not routed to the Duration static-constructor intrinsic" {
    let src = #"
import std.io
import std.time

fn main() ! IO {
    let Duration = 5
    let d = Duration.seconds(2)
    io.println("{d.nanos}")
}
"#
    let out = compile_and_capture(src, "_static_ctor_intrinsic_shadowed_by_local")
    expect_error(out, "E0505", "shadowed Duration local rejected as UnresolvedMethod on Int")
}
