// The stdlib archive's C is emitted in-process by the running compiler, so the archive cache
// key must hash that binary. A key that hashed some other file would stay the same across a
// compiler rebuild and link a new program against an archive emitted by the old compiler.
//
// The test runs copies of its own binary: each copy computes the key as the running
// compiler. Two copies at one path that differ by one byte must get different keys.

import std.process.{ChildEnd}
import std_cache_key.{compute_cache_key, archive_compiler_path}

let DIR = "build/std_cache_key_running_compiler_probe"
let OUT_VAR = "BLINK_STD_CACHE_KEY_PROBE_OUT"

fn probe_key() -> Str ! IO, FS.Read, Process.Spawn {
    compute_cache_key(archive_compiler_path(), DIR, "{DIR}/runtime.h", "manifest\n")
}

fn key_from(exe: Str) -> Str ! Process.Spawn, FS.Read {
    let out = "{DIR}/key.txt"
    process.run("sh", ["-c", "rm -f {out}"]).unwrap()
    let r = process.run("sh", ["-c", "{OUT_VAR}={out} {exe} >/dev/null 2>&1"]).unwrap()
    assert_eq(r.end, ChildEnd.Exited(0), r.err_out)
    fs.read(out).unwrap()
}

test "the cache key changes when the running compiler binary changes" {
    let probe_out = env.var(OUT_VAR) ?? ""
    if probe_out != "" {
        fs.write(probe_out, probe_key()).unwrap()
    } else {
        process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}"])?
        fs.write("{DIR}/runtime.h", "int blink_part(void);\n").unwrap()
        let exe = "{DIR}/compiler"
        let cp = process.run("sh", ["-c", "cp /proc/{getpid()}/exe {exe}"])?
        assert_eq(cp.end, ChildEnd.Exited(0), cp.err_out)
        let before = key_from(exe)
        let grow = process.run("sh", ["-c", "printf x >> {exe}"])?
        assert_eq(grow.end, ChildEnd.Exited(0), grow.err_out)
        let after = key_from(exe)
        let again = key_from(exe)
        process.run("sh", ["-c", "rm -rf {DIR}"])?
        assert(before != "")
        assert(before != after)
        assert_eq(after, again)
    }
}

test "the cache key is empty when the compiler binary is missing" {
    assert_eq(compute_cache_key("{DIR}_missing/compiler", DIR, "", "manifest\n"), "")
    assert_eq(compute_cache_key("", DIR, "", "manifest\n"), "")
}
