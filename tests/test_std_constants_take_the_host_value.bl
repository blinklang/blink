// Signal numbers, errno values and poll bits differ between hosts, so each std constant that
// names one is a foreign constant: the host's C headers set it (§4.4.8, §9.1). Each test reads
// the value back through something the host itself defines: its signal table, its strerror
// text, a real child's end, a real poll(2) result. test_std_constants_take_the_cross_target_value
// checks the targets this host cannot run.
import std.process.{signal_name, ChildEnd, SIGHUP, SIGINT, SIGQUIT, SIGABRT, SIGBUS, SIGKILL, SIGSEGV, SIGTERM, SIGXCPU}
import std.libc.{poll, Pollfd, ERR_INVAL, ERR_NOTSUP, ERR_EXIST, ERR_NOTEMPTY, POLL_EVT_IN, POLL_EVT_NVAL}
import std.fs.{FsError, FsOp}
import std.errno.{Errno}

test "each signal constant is the number the host names after it" {
    assert_eq(signal_name(SIGHUP), "SIGHUP")
    assert_eq(signal_name(SIGINT), "SIGINT")
    assert_eq(signal_name(SIGQUIT), "SIGQUIT")
    assert_eq(signal_name(SIGABRT), "SIGABRT")
    assert_eq(signal_name(SIGBUS), "SIGBUS")
    assert_eq(signal_name(SIGKILL), "SIGKILL")
    assert_eq(signal_name(SIGSEGV), "SIGSEGV")
    assert_eq(signal_name(SIGTERM), "SIGTERM")
    assert_eq(signal_name(SIGXCPU), "SIGXCPU")
}

test "a child killed by SIGBUS takes the guard arm that compares with SIGBUS" {
    let r = process.run("sh", ["-c", "kill -BUS $$"]).unwrap()
    let what = match r.end {
        ChildEnd.Signaled(n) if n == SIGBUS => "bus"
        ChildEnd.Signaled(n) => "other signal {n}"
        _ => "{r.end}"
    }
    assert_eq(what, "bus")
}

fn rendered(code: Int) -> Str {
    "{FsError { op: FsOp.Read, path: "p", code: Errno(code) }}"
}

test "each errno constant renders as the host's text for it" {
    assert_eq(rendered(ERR_INVAL), "read p: Invalid argument")
    assert_eq(rendered(ERR_NOTSUP), "read p: Operation not supported")
    assert_eq(rendered(ERR_EXIST), "read p: File exists")
    assert_eq(rendered(ERR_NOTEMPTY), "read p: Directory not empty")
}

test "a read of a missing file is not_found on this host" {
    match fs.read("/nonexistent/blink-host-constant-probe") {
        Ok(_) => assert(false, "the file must not exist")
        Err(e) => assert(e.not_found(), "got: {e}")
    }
}

test "poll reports a closed descriptor with the POLL_EVT_NVAL bit" {
    let fds = [Pollfd { fd: 9999.to_i32(), events: POLL_EVT_IN.to_i16(), revents: 0.to_i16() }]
    match poll(fds, 0) {
        Ok(out) => {
            let revents = out.get(0).unwrap().revents.to_int()
            assert_eq(revents & POLL_EVT_NVAL, POLL_EVT_NVAL)
        }
        Err(msg) => assert_eq(msg, "")
    }
}
