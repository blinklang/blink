// std.process: the Child handle that process.spawn, process.wait and process.signal share.

import std.process.{SIGTERM, SIGKILL, ChildEnd}

test "spawn returns a Child; wait gives stdout + zero exit" {
    let child = process.spawn("echo", ["std-process-spawn"])?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out.contains("std-process-spawn"))
}

test "signal SIGKILL terminates a sleeping child" {
    let child = process.spawn("sh", ["-c", "sleep 30"])?
    process.signal(child, SIGKILL)?
    let r = process.wait(child)?
    assert_eq(r.end, ChildEnd.Signaled(SIGKILL))
}

test "signal SIGTERM is observable by child" {
    let child = process.spawn("sh", ["-c", "trap 'exit 143' TERM; sleep 30"])?
    process.signal(child, SIGTERM)?
    let r = process.wait(child)?
    // The trap exits 143 if the shell had set it before the signal came; else the signal ends the shell.
    assert(r.end == ChildEnd.Exited(143) || r.end == ChildEnd.Signaled(SIGTERM), "ended with {r.end}")
}

test "signal on an already-reaped child is Err" {
    let child = process.spawn("echo", ["done"])?
    let _ = process.wait(child)?
    assert(process.signal(child, SIGTERM).is_err())
}
