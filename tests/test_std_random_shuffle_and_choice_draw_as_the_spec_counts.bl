// std.random has the generic helpers of the Rand effect (sections/04_effects.md §4.4.7).
// `shuffle` makes a new list with a Fisher-Yates shuffle of exactly `xs.len() - 1` draws, and
// leaves `xs` as it was. `choice` makes no draw for an empty list, and one draw otherwise.
// A handler that records each `int(lo, hi)` call counts the draws.

import std.random.{shuffle, choice}

// Answers every draw with its low end and records the call.
fn low_into(calls: List[Str]) -> Handler[Rand] {
    handler Rand {
        fn int(lo: Int, hi: Int) -> Int {
            calls.push("int({lo}, {hi})")
            lo
        }
    }
}

// Answers every draw with its high end and records the call.
fn high_into(calls: List[Str]) -> Handler[Rand] {
    handler Rand {
        fn int(lo: Int, hi: Int) -> Int {
            calls.push("int({lo}, {hi})")
            hi
        }
    }
}

fn sorted(xs: List[Int]) -> List[Int] {
    xs.sort()
}

test "shuffle makes len - 1 draws, one for each position from the end" {
    let calls: List[Str] = []
    let xs = [10, 20, 30, 40]
    with low_into(calls) {
        let _ = shuffle(xs)
    }
    assert_eq(calls, ["int(0, 3)", "int(0, 2)", "int(0, 1)"])
}

test "shuffle returns a permutation and leaves its input as it was" {
    let calls: List[Str] = []
    let xs = [10, 20, 30, 40]
    let mut out: List[Int] = []
    with low_into(calls) {
        out = shuffle(xs)
    }
    assert(out != xs)
    assert_eq(sorted(out), [10, 20, 30, 40])
    assert_eq(xs, [10, 20, 30, 40])
}

test "a draw of each position's own index keeps the order" {
    let calls: List[Str] = []
    with high_into(calls) {
        assert_eq(shuffle([1, 2, 3]), [1, 2, 3])
    }
}

test "shuffle of an empty or one-element list makes no draw" {
    let calls: List[Str] = []
    with low_into(calls) {
        let empty: List[Int] = []
        assert_eq(shuffle(empty), empty)
        assert_eq(shuffle(["only"]), ["only"])
    }
    assert_eq(calls.len(), 0)
}

test "the new list is not the input list" {
    let calls: List[Str] = []
    let xs = [1, 2]
    with high_into(calls) {
        let mut out = shuffle(xs)
        out.push(3)
    }
    assert_eq(xs, [1, 2])
}

test "choice of an empty list is None with no draw" {
    let calls: List[Str] = []
    with low_into(calls) {
        let empty: List[Str] = []
        assert_eq(choice(empty), None)
    }
    assert_eq(calls.len(), 0)
}

test "choice makes one draw over every index" {
    let calls: List[Str] = []
    with low_into(calls) {
        assert_eq(choice(["a", "b", "c"]), Some("a"))
    }
    with high_into(calls) {
        assert_eq(choice(["a", "b", "c"]), Some("c"))
    }
    assert_eq(calls, ["int(0, 2)", "int(0, 2)"])
}

test "the default handler shuffles to a permutation" {
    let xs = [1, 2, 3, 4, 5, 6, 7, 8]
    assert_eq(sorted(shuffle(xs)), xs)
    let c = choice(xs).unwrap()
    assert(xs.contains(c))
}
