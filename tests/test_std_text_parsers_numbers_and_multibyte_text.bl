import std.num.{parse_int, parse_float}
import std.json.{json_clear, json_parse, json_get, json_at, json_as_int, json_as_float, json_as_str, json_type, JSON_FLOAT}
import std.semver.{parse_version, version_matches, ver_major, ver_minor, ver_patch}
import std.toml.{toml_clear, toml_parse, toml_get, toml_get_int}

// These parsers read a Str one byte at a time and build numbers from the digits. A byte is a
// U8, so each digit value must widen to Int before it joins the total: values here go past
// 255 and below 0, which U8 arithmetic cannot hold. Multi-byte text next to the numbers must
// neither read as digits nor move the parser off the following fields.

test "num.parse_int reads values past one byte and of either sign" {
    assert_eq(parse_int("0"), 0)
    assert_eq(parse_int("9"), 9)
    assert_eq(parse_int("256"), 256)
    assert_eq(parse_int("65536"), 65536)
    assert_eq(parse_int("-300"), -300)
    assert_eq(parse_int("9223372036854775807"), 9223372036854775807)
}

test "num.parse_int stops at a multi-byte character" {
    assert_eq(parse_int("12é3"), 12)
    assert_eq(parse_int("7€"), 7)
    assert_eq(parse_int("😀5"), 0)
}

test "num.parse_float reads digits, a fraction and an exponent" {
    assert_eq(parse_float("2.5e3"), 2500.0)
    assert_eq(parse_float("-0.75"), -0.75)
    assert_eq(parse_float("+90.5"), 90.5)
    assert_eq(parse_float("1é5"), 1.0)
}

test "json reads a number after a multi-byte string value" {
    json_clear()
    let root = json_parse("\{\"a\":\"é€😀\",\"b\":-1234,\"c\":256,\"d\":-12.75}")
    assert_eq(json_as_str(json_get(root, "a")), "é€😀")
    assert_eq(json_as_int(json_get(root, "b")), -1234)
    assert_eq(json_as_int(json_get(root, "c")), 256)
    let d = json_get(root, "d")
    assert_eq(json_type(d), JSON_FLOAT)
    assert_eq(json_as_float(d), -12.75)
}

test "json reads digits 0 and 9 at the ends of a number" {
    json_clear()
    let root = json_parse("[90, 9.09, 0]")
    assert_eq(json_as_int(json_at(root, 0)), 90)
    assert_eq(json_as_float(json_at(root, 1)), 9.09)
    assert_eq(json_as_int(json_at(root, 2)), 0)
}

test "semver reads version parts past one byte" {
    parse_version("256.1000.65536")
    assert_eq(ver_major, 256)
    assert_eq(ver_minor, 1000)
    assert_eq(ver_patch, 65536)
    assert_eq(version_matches("300.0.0", ">=256.0.0"), 1)
    assert_eq(version_matches("255.9.9", ">=256.0.0"), 0)
    assert_eq(version_matches("10.20.300", "=10.20.300"), 1)
    assert_eq(version_matches("1.9.0", "~1.9"), 1)
}

test "toml reads an integer after a multi-byte string value" {
    toml_clear()
    toml_parse("name = \"é€😀\"\ncount = -300\nbig = +65536\nzero = 0\n")
    assert_eq(toml_get("name"), "é€😀")
    assert_eq(toml_get_int("count"), -300)
    assert_eq(toml_get_int("big"), 65536)
    assert_eq(toml_get_int("zero"), 0)
}
