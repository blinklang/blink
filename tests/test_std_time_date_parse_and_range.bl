// Date.from_ymd and Date.parse (sections/03_types.md, *Date and Weekday* and *Errors*): the
// accepted forms, every fixed message text word for word, the range edges and the panics of
// add_days. Each Date here is built through the API only, never a struct literal.

import std.time.{Date}

fn ymd_msg(y: Int, m: Int, d: Int) -> Str {
    match Date.from_ymd(y, m, d) {
        Ok(v) => "ok {v}"
        Err(e) => e.message
    }
}

fn parse_msg(s: Str) -> Str {
    match Date.parse(s) {
        Ok(v) => "ok {v}"
        Err(e) => e.message
    }
}

fn ymd(y: Int, m: Int, d: Int) -> Date {
    Date.from_ymd(y, m, d).unwrap()
}

test "from_ymd builds the day it names" {
    let d = ymd(2026, 10, 17)
    assert_eq(d.year(), 2026)
    assert_eq(d.month(), 10)
    assert_eq(d.day(), 17)
    assert_eq("{d}", "2026-10-17")
}

test "parse accepts YYYY-MM-DD and gives the same Date as from_ymd" {
    assert(Date.parse("2026-10-17").unwrap() == ymd(2026, 10, 17))
    assert(Date.parse("1970-01-01").unwrap() == ymd(1970, 1, 1))
}

test "the spec examples give their exact messages" {
    assert_eq(parse_msg("2026-1-07"), "invalid date: expected digit at byte 6 (found '-')")
    assert_eq(parse_msg("2026-02-30"), "invalid date: day 30 out of range 1..28 for 2026-02")
    assert_eq(ymd_msg(1677, 9, 21), "invalid date: 1677-09-21 outside 1677-09-22..2262-04-11")
}

test "each syntax error names the byte and what was found" {
    assert_eq(parse_msg(""), "invalid date: expected digit at byte 0 (found end of input)")
    assert_eq(parse_msg("x026-01-01"), "invalid date: expected digit at byte 0 (found 'x')")
    assert_eq(parse_msg("2026/01/01"), "invalid date: expected '-' at byte 4 (found '/')")
    assert_eq(parse_msg("2026-01"), "invalid date: expected '-' at byte 7 (found end of input)")
    assert_eq(parse_msg("2026-01-1"), "invalid date: expected digit at byte 9 (found end of input)")
    assert_eq(parse_msg("2026-01-01T"), "invalid date: unexpected text at byte 10 (found 'T')")
    assert_eq(parse_msg("2026-01-01 "), "invalid date: unexpected text at byte 10 (found ' ')")
    assert_eq(parse_msg(" 2026-01-01"), "invalid date: expected digit at byte 0 (found ' ')")
    assert_eq(parse_msg("2026-0é-01"), "invalid date: expected digit at byte 6 (found 'é')")
}

test "syntax is checked before the fields" {
    assert_eq(parse_msg("2026-13-01x"), "invalid date: unexpected text at byte 10 (found 'x')")
}

test "each field error names the field's range" {
    assert_eq(parse_msg("2026-00-01"), "invalid date: month 0 out of range 1..12")
    assert_eq(parse_msg("2026-13-01"), "invalid date: month 13 out of range 1..12")
    assert_eq(parse_msg("2026-04-31"), "invalid date: day 31 out of range 1..30 for 2026-04")
    assert_eq(parse_msg("2026-01-00"), "invalid date: day 0 out of range 1..31 for 2026-01")
    assert_eq(parse_msg("2026-13-40"), "invalid date: month 13 out of range 1..12")
    assert_eq(ymd_msg(2026, 0, 1), "invalid date: month 0 out of range 1..12")
    assert_eq(ymd_msg(2026, 12, 32), "invalid date: day 32 out of range 1..31 for 2026-12")
    assert_eq(ymd_msg(2026, 6, -1), "invalid date: day -1 out of range 1..30 for 2026-06")
}

test "the fields are checked before the range" {
    assert_eq(ymd_msg(1600, 2, 30), "invalid date: day 30 out of range 1..29 for 1600-02")
    assert_eq(parse_msg("0000-13-01"), "invalid date: month 13 out of range 1..12")
}

test "leap years follow the proleptic Gregorian calendar" {
    assert_eq(ymd_msg(2000, 2, 29), "ok 2000-02-29")
    assert_eq(ymd_msg(1900, 2, 29), "invalid date: day 29 out of range 1..28 for 1900-02")
    assert_eq(ymd_msg(2024, 2, 29), "ok 2024-02-29")
    assert_eq(ymd_msg(1700, 2, 29), "invalid date: day 29 out of range 1..28 for 1700-02")
    assert_eq(parse_msg("2000-02-29"), "ok 2000-02-29")
    assert_eq(parse_msg("1900-02-29"), "invalid date: day 29 out of range 1..28 for 1900-02")
}

test "the Date range edges, and one day past each" {
    assert_eq(ymd_msg(1677, 9, 22), "ok 1677-09-22")
    assert_eq(ymd_msg(1677, 9, 21), "invalid date: 1677-09-21 outside 1677-09-22..2262-04-11")
    assert_eq(ymd_msg(2262, 4, 11), "ok 2262-04-11")
    assert_eq(ymd_msg(2262, 4, 12), "invalid date: 2262-04-12 outside 1677-09-22..2262-04-11")
    assert_eq(parse_msg("1677-09-22"), "ok 1677-09-22")
    assert_eq(parse_msg("1677-09-21"), "invalid date: 1677-09-21 outside 1677-09-22..2262-04-11")
    assert_eq(parse_msg("2262-04-11"), "ok 2262-04-11")
    assert_eq(parse_msg("2262-04-12"), "invalid date: 2262-04-12 outside 1677-09-22..2262-04-11")
    assert_eq(parse_msg("0000-01-01"), "invalid date: 0000-01-01 outside 1677-09-22..2262-04-11")
    assert_eq(parse_msg("9999-12-31"), "invalid date: 9999-12-31 outside 1677-09-22..2262-04-11")
}

test "a from_ymd year is zero-padded to four places after its sign" {
    assert_eq(ymd_msg(5, 1, 1), "invalid date: 0005-01-01 outside 1677-09-22..2262-04-11")
    assert_eq(ymd_msg(-5, 1, 1), "invalid date: -005-01-01 outside 1677-09-22..2262-04-11")
    assert_eq(ymd_msg(12345, 1, 1), "invalid date: 12345-01-01 outside 1677-09-22..2262-04-11")
    assert_eq(ymd_msg(9223372036854775807, 1, 1), "invalid date: 9223372036854775807-01-01 outside 1677-09-22..2262-04-11")
    assert_eq(ymd_msg(-9223372036854775807, 2, 28), "invalid date: -9223372036854775807-02-28 outside 1677-09-22..2262-04-11")
    assert_eq(ymd_msg(-9223372036854775807, 2, 29), "invalid date: day 29 out of range 1..28 for -9223372036854775807-02")
    assert_eq(ymd_msg(-4, 2, 29), "invalid date: -004-02-29 outside 1677-09-22..2262-04-11")
}

test "add_days and days_since count whole days" {
    let d = ymd(2026, 2, 27)
    assert_eq("{d.add_days(2)}", "2026-03-01")
    assert_eq("{d.add_days(-58)}", "2025-12-31")
    assert_eq("{d.add_days(0)}", "2026-02-27")
    assert_eq(ymd(2026, 10, 17).days_since(ymd(2026, 2, 14)), 245)
    assert_eq(ymd(2026, 2, 14).days_since(ymd(2026, 10, 17)), -245)
    assert_eq(ymd(2262, 4, 11).days_since(ymd(1677, 9, 22)), 213502)
}

test "add_days reaches each end of the range" {
    let lo = ymd(1677, 9, 22)
    let hi = ymd(2262, 4, 11)
    assert(lo.add_days(213502) == hi)
    assert(hi.add_days(-213502) == lo)
}

test "add_days panics one day past the upper end" {
    assert_panics(matching: "date out of range: result outside 1677-09-22..2262-04-11") {
        let _ = ymd(2262, 4, 11).add_days(1)
    }
}

test "add_days panics one day past the lower end" {
    assert_panics(matching: "date out of range: result outside 1677-09-22..2262-04-11") {
        let _ = ymd(1677, 9, 22).add_days(-1)
    }
}

test "add_days panics with the range text, not Int overflow, for a huge n" {
    assert_panics(matching: "date out of range: result outside 1677-09-22..2262-04-11") {
        let _ = ymd(2026, 1, 1).add_days(9223372036854775807)
    }
}

test "to_instant is midnight UTC on that day" {
    assert_eq("{ymd(2026, 10, 17).to_instant()}", "2026-10-17T00:00:00Z")
    assert_eq("{ymd(1677, 9, 22).to_instant()}", "1677-09-22T00:00:00Z")
    assert_eq("{ymd(2262, 4, 11).to_instant()}", "2262-04-11T00:00:00Z")
    assert_eq(ymd(1970, 1, 1).to_instant().to_unix_secs(), 0)
}

test "Dates order by time" {
    let a = ymd(1999, 12, 31)
    let b = ymd(2000, 1, 1)
    assert(a < b)
    assert(b > a)
    assert(a <= a)
    assert(a != b)
    assert(a == ymd(1999, 12, 31))
}

test "Debug writes the same text as Display" {
    assert_eq(ymd(2026, 10, 17).debug(), "2026-10-17")
    assert_eq(ymd(1677, 9, 22).debug(), "1677-09-22")
}

test "a Date clones, and keys a Map and a Set" {
    let d = ymd(2026, 10, 17)
    assert(d.clone() == d)
    let mut m: Map[Date, Int] = Map()
    m.insert(d, 1)
    m.insert(ymd(2026, 10, 17), 2)
    m.insert(ymd(2026, 10, 18), 3)
    assert_eq(m.len(), 2)
    assert_eq(m.get(d).unwrap(), 2)
    let mut s: Set[Date] = Set()
    s.insert(d)
    s.insert(Date.parse("2026-10-17").unwrap())
    assert_eq(s.len(), 1)
}
