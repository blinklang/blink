// Instant.date, hour, minute and second (sections/03_types.md, *Instant and Duration*): UTC
// fields that round down before the epoch, a Date for every Instant at both ends of the
// std.time range, and the range panics of Instant.add and Instant.from_epoch_secs.

import std.time
import std.time.{Instant, Duration, Date}

fn min_instant() -> Instant { Instant.from_epoch_secs(-9223286400) }

fn max_instant() -> Instant { Instant.from_epoch_secs(9223372036).add(Duration.nanos(854775807)) }

fn fields(i: Instant) -> Str {
    "{i.date()} {i.hour()}:{i.minute()}:{i.second()}"
}

test "fields of an instant after the epoch" {
    let i = Instant.parse("2026-10-17T09:30:05.75Z").unwrap()
    assert_eq("{i.date()}", "2026-10-17")
    assert_eq(i.hour(), 9)
    assert_eq(i.minute(), 30)
    assert_eq(i.second(), 5)
}

test "fields round down before the epoch" {
    let i = Instant.from_epoch_secs(0).add(Duration.ms(-500))
    assert_eq("{i.date()}", "1969-12-31")
    assert_eq(i.hour(), 23)
    assert_eq(i.minute(), 59)
    assert_eq(i.second(), 59)
    assert_eq("{i}", "1969-12-31T23:59:59.5Z")
    assert_eq(fields(Instant.from_epoch_secs(0).add(Duration.nanos(-1))), "1969-12-31 23:59:59")
    assert_eq(fields(Instant.from_epoch_secs(-86400)), "1969-12-31 0:0:0")
    assert_eq(fields(Instant.from_epoch_secs(-86401)), "1969-12-30 23:59:59")
    assert_eq(fields(Instant.from_epoch_secs(0)), "1970-01-01 0:0:0")
}

test "every Instant has a Date, at both ends of the range" {
    assert_eq("{min_instant().date()}", "1677-09-22")
    assert_eq("{max_instant().date()}", "2262-04-11")
    assert_eq("{min_instant()}", "1677-09-22T00:00:00Z")
    assert_eq("{max_instant()}", "2262-04-11T23:47:16.854775807Z")
    assert_eq(fields(max_instant()), "2262-04-11 23:47:16")
    assert_eq(fields(min_instant()), "1677-09-22 0:0:0")
    assert(min_instant().date() == Date.from_ymd(1677, 9, 22).unwrap())
    assert(max_instant().date() == Date.from_ymd(2262, 4, 11).unwrap())
}

test "from_epoch_secs reaches each whole second of the range" {
    assert_eq("{Instant.from_epoch_secs(9223372036)}", "2262-04-11T23:47:16Z")
    assert_eq(Instant.from_epoch_secs(-9223286400).to_unix_secs(), -9223286400)
}

test "add stays inside the range at each end" {
    assert(max_instant().add(Duration.nanos(0)) == max_instant())
    assert(min_instant().add(Duration.nanos(0)) == min_instant())
    assert(min_instant().add(Duration.nanos(1)).since(min_instant()) == Duration.nanos(1))
}

test "add panics one nanosecond above the range" {
    assert_panics(matching: "instant out of range: result outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z") {
        let _ = max_instant().add(Duration.nanos(1))
    }
}

test "add panics one nanosecond below the range" {
    assert_panics(matching: "instant out of range: result outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z") {
        let _ = min_instant().add(Duration.nanos(-1))
    }
}

test "add panics with the range text for a Duration near Int's ends" {
    assert_panics(matching: "instant out of range: result outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z") {
        let _ = Instant.from_epoch_secs(1).add(Duration.nanos(9223372036854775807))
    }
}

test "from_epoch_secs panics one second above the range" {
    assert_panics(matching: "instant out of range: result outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z") {
        let _ = Instant.from_epoch_secs(9223372037)
    }
}

test "from_epoch_secs panics one second below the range" {
    assert_panics(matching: "instant out of range: result outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z") {
        let _ = Instant.from_epoch_secs(-9223286401)
    }
}

test "from_epoch_secs panics with the range text, not Int overflow, for a huge count" {
    assert_panics(matching: "instant out of range: result outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z") {
        let _ = Instant.from_epoch_secs(9223372036854775807)
    }
}

test "time.read gives an instant with a Date" {
    let now = time.read()
    let d = now.date()
    assert(d.year() >= 2026)
    assert(now.hour() >= 0 && now.hour() <= 23)
}
