// Instant.parse (sections/03_types.md, *Instant.parse grammar* and *Errors*): the closed RFC 3339
// production, every form outside it, every fixed message text word for word, the offset applied
// before the range check, and the range edges.

import std.time.{Instant, Duration}

fn msg(s: Str) -> Str {
    match Instant.parse(s) {
        Ok(i) => "ok {i}"
        Err(e) => e.message
    }
}

fn range_err(s: Str) -> Str {
    "invalid timestamp: {s} outside 1677-09-22T00:00:00Z..2262-04-11T23:47:16.854775807Z"
}

test "the accepted forms" {
    assert_eq(msg("2026-02-14T12:00:00Z"), "ok 2026-02-14T12:00:00Z")
    assert_eq(msg("2026-02-14 12:00:00Z"), "ok 2026-02-14T12:00:00Z")
    assert_eq(msg("2026-02-14T12:00:00.5Z"), "ok 2026-02-14T12:00:00.5Z")
    assert_eq(msg("2026-02-14T12:00:00.500Z"), "ok 2026-02-14T12:00:00.5Z")
    assert_eq(msg("2026-02-14T12:00:00.000000001Z"), "ok 2026-02-14T12:00:00.000000001Z")
    assert_eq(msg("2026-02-14T12:00:00.123456789Z"), "ok 2026-02-14T12:00:00.123456789Z")
    assert_eq(msg("2026-02-14T12:00:00+00:00"), "ok 2026-02-14T12:00:00Z")
    assert_eq(msg("2026-02-14T12:00:00-00:00"), "ok 2026-02-14T12:00:00Z")
    assert_eq(msg("2026-02-14T23:59:59Z"), "ok 2026-02-14T23:59:59Z")
}

test "the spec examples give their exact messages" {
    assert_eq(msg("2026-02-14t12:00:00Z"), "invalid timestamp: expected 'T' or ' ' at byte 10 (found 't')")
    assert_eq(msg("2026-02-14 12:00:00"), "invalid timestamp: no UTC offset at byte 19; append Z if the time is UTC")
    assert_eq(msg("2026-02-14 12:00:00+01:00"), "ok 2026-02-14T11:00:00Z")
}

test "each form outside the grammar is rejected with its message" {
    // lowercase z
    assert_eq(msg("2026-02-14T12:00:00z"), "invalid timestamp: expected 'Z', '+' or '-' at byte 19 (found 'z')")
    // comma fraction
    assert_eq(msg("2026-02-14T12:00:00,5Z"), "invalid timestamp: expected 'Z', '+' or '-' at byte 19 (found ',')")
    // missing seconds
    assert_eq(msg("2026-02-14T12:00Z"), "invalid timestamp: expected ':' at byte 16 (found 'Z')")
    // second 60
    assert_eq(msg("2026-12-31T23:59:60Z"), "invalid timestamp: second 60 out of range 0..59")
    // two spaces
    assert_eq(msg("2026-02-14  12:00:00Z"), "invalid timestamp: expected digit at byte 11 (found ' ')")
    // a space before the offset
    assert_eq(msg("2026-02-14T12:00:00 Z"), "invalid timestamp: expected 'Z', '+' or '-' at byte 19 (found ' ')")
    // 10 fraction digits
    assert_eq(msg("2026-02-14T12:00:00.1234567891Z"), "invalid timestamp: more than 9 fraction digits at byte 29")
    // text after the value
    assert_eq(msg("2026-02-14T12:00:00Zx"), "invalid timestamp: unexpected text at byte 20 (found 'x')")
    assert_eq(msg("2026-02-14T12:00:00+01:00 "), "invalid timestamp: unexpected text at byte 25 (found ' ')")
    // missing offset
    assert_eq(msg("2026-02-14T12:00:00"), "invalid timestamp: no UTC offset at byte 19; append Z if the time is UTC")
    assert_eq(msg("2026-02-14T12:00:00.25"), "invalid timestamp: no UTC offset at byte 22; append Z if the time is UTC")
    // text before the value
    assert_eq(msg(" 2026-02-14T12:00:00Z"), "invalid timestamp: expected digit at byte 0 (found ' ')")
}

test "each syntax position names what it expected" {
    assert_eq(msg(""), "invalid timestamp: expected digit at byte 0 (found end of input)")
    assert_eq(msg("2026"), "invalid timestamp: expected '-' at byte 4 (found end of input)")
    assert_eq(msg("2026-02-14"), "invalid timestamp: expected 'T' or ' ' at byte 10 (found end of input)")
    assert_eq(msg("2026-02-14T1"), "invalid timestamp: expected digit at byte 12 (found end of input)")
    assert_eq(msg("2026-02-14T12-00:00Z"), "invalid timestamp: expected ':' at byte 13 (found '-')")
    assert_eq(msg("2026-02-14T12:00:00.Z"), "invalid timestamp: expected digit at byte 20 (found 'Z')")
    assert_eq(msg("2026-02-14T12:00:00+1:00"), "invalid timestamp: expected digit at byte 21 (found ':')")
    assert_eq(msg("2026-02-14T12:00:00+0100"), "invalid timestamp: expected ':' at byte 22 (found '0')")
    assert_eq(msg("2026-02-14T12:00:00+01:0"), "invalid timestamp: expected digit at byte 24 (found end of input)")
    assert_eq(msg("2026-02-14T12:00:00+"), "invalid timestamp: expected digit at byte 20 (found end of input)")
    assert_eq(msg("2026-02-14T12:00:00€"), "invalid timestamp: expected 'Z', '+' or '-' at byte 19 (found '€')")
}

test "syntax is checked before the fields" {
    assert_eq(msg("2026-13-14T25:00:00"), "invalid timestamp: no UTC offset at byte 19; append Z if the time is UTC")
}

test "each field error names the field's range, left to right" {
    assert_eq(msg("2026-13-14T25:00:00Z"), "invalid timestamp: month 13 out of range 1..12")
    assert_eq(msg("2026-02-29T25:00:00Z"), "invalid timestamp: day 29 out of range 1..28 for 2026-02")
    assert_eq(msg("2026-02-14T24:00:00Z"), "invalid timestamp: hour 24 out of range 0..23")
    assert_eq(msg("2026-02-14T23:60:00Z"), "invalid timestamp: minute 60 out of range 0..59")
    assert_eq(msg("2026-02-14T23:59:99Z"), "invalid timestamp: second 99 out of range 0..59")
    assert_eq(msg("2026-02-14T23:59:59+24:00"), "invalid timestamp: offset hour 24 out of range 0..23")
    assert_eq(msg("2026-02-14T23:59:59-01:60"), "invalid timestamp: offset minute 60 out of range 0..59")
    assert_eq(msg("2026-02-14T23:59:60+24:60"), "invalid timestamp: second 60 out of range 0..59")
}

test "a numeric offset is applied to give the instant in UTC" {
    assert_eq(msg("2026-02-14T12:00:00+01:00"), "ok 2026-02-14T11:00:00Z")
    assert_eq(msg("2026-02-14T12:00:00-05:30"), "ok 2026-02-14T17:30:00Z")
    assert_eq(msg("2026-02-14T12:00:00.25+23:59"), "ok 2026-02-13T12:01:00.25Z")
}

test "an offset can move the instant across midnight" {
    assert_eq(msg("2026-02-14T00:30:00+01:00"), "ok 2026-02-13T23:30:00Z")
    assert_eq(msg("2026-02-14T23:30:00-05:30"), "ok 2026-02-15T05:00:00Z")
    assert_eq(msg("2025-12-31T22:00:00-05:30"), "ok 2026-01-01T03:30:00Z")
    let i = Instant.parse("2026-02-14T00:30:00+01:00").unwrap()
    assert_eq("{i.date()}", "2026-02-13")
}

test "the range is checked after the offset is applied" {
    // written inside the range, outside it once the offset is applied
    assert_eq(msg("1677-09-22T00:30:00+01:00"), range_err("1677-09-22T00:30:00+01:00"))
    assert_eq(msg("2262-04-11T23:47:16.854775807-00:01"), range_err("2262-04-11T23:47:16.854775807-00:01"))
    // written outside the range, inside it once the offset is applied
    assert_eq(msg("1677-09-21T23:30:00-01:00"), "ok 1677-09-22T00:30:00Z")
    assert_eq(msg("2262-04-12T00:30:00+01:00"), "ok 2262-04-11T23:30:00Z")
}

test "the range edges, and one step past each" {
    assert_eq(msg("1677-09-22T00:00:00Z"), "ok 1677-09-22T00:00:00Z")
    assert_eq(msg("1677-09-21T23:59:59Z"), range_err("1677-09-21T23:59:59Z"))
    assert_eq(msg("1677-09-21T23:59:59.999999999Z"), range_err("1677-09-21T23:59:59.999999999Z"))
    assert_eq(msg("2262-04-11T23:47:16.854775807Z"), "ok 2262-04-11T23:47:16.854775807Z")
    assert_eq(msg("2262-04-11T23:47:16.854775808Z"), range_err("2262-04-11T23:47:16.854775808Z"))
    assert_eq(msg("2262-04-11T23:47:17Z"), range_err("2262-04-11T23:47:17Z"))
    assert_eq(msg("0000-01-01T00:00:00Z"), range_err("0000-01-01T00:00:00Z"))
    assert_eq(msg("9999-12-31 23:59:59.999999999-23:59"), range_err("9999-12-31 23:59:59.999999999-23:59"))
    assert(Instant.parse("1677-09-21T23:59:59Z").is_err())
}

test "parse gives the same value as from_epoch_secs" {
    let r = Instant.parse("1970-01-01T00:00:00Z")
    assert(r.is_ok())
    assert(r.unwrap() == Instant.from_epoch_secs(0))
    assert(Instant.parse("2026-10-17T00:00:00Z").unwrap() == Instant.from_epoch_secs(1792195200))
    assert(Instant.parse("1969-12-31T23:59:59.5Z").unwrap() == Instant.from_epoch_secs(0).add(Duration.ms(-500)))
}
