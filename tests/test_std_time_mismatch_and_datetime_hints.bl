// Code written for a DateTime type meets std.time, which has Instant and Date and no
// DateTime (sections/03_types.md, *Why Date and no DateTime*). The diagnostics name the
// std.time spelling: an undefined `DateTime` points at `.date()`, `.hour()` and
// `time.read()`, and a Date/Instant mismatch names the conversion call. A user type named
// Date is not std.time's, so it gets no hint.

import compile_test_helpers.{compile_and_capture, expect_contains, expect_error, expect_compiles_clean}

fn expect_absent(output: Str, needle: Str, label: Str) {
    let found = output.contains(needle)
    if found { io.println("FAIL: {label} — unexpected '{needle}' in output: {output}") }
    assert(!found)
}

test "an undefined DateTime names the std.time spelling" {
    let src = "import std.time\nfn main() ! Time.Read \{\n  let x = time.read()\n  let d = DateTime.from(x)\n  io.println(\"\{d\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_from")
    expect_error(out, "E0506", "DateTime is undefined")
    expect_contains(out, "std.time has no DateTime", "help names the missing type")
    expect_contains(out, "`x.date()`", "help names .date()")
    expect_contains(out, "`x.hour()`", "help names .hour()")
    expect_contains(out, "`time.read().date()`", "help names today")
}

test "DateTime.now() gets the same help" {
    let src = "fn main() \{\n  let n = DateTime.now()\n  io.println(\"\{n\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_now")
    expect_contains(out, "std.time has no DateTime", "help on DateTime.now()")
}

test "an Instant passed where a Date goes names .date()" {
    let src = "import std.time.\{Date, Instant\}\nfn take(d: Date) -> Int \{ d.year() \}\nfn main() \{\n  let i = Instant.from_epoch_secs(0)\n  io.println(\"\{take(i)\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_arg")
    expect_contains(out, "argument 1 of `take` expects Date, got Instant: call `.date()` on the Instant to get its UTC calendar day", "argument mismatch")
}

test "an Instant bound to a Date variable names .date()" {
    let src = "import std.time.\{Date, Instant\}\nfn main() \{\n  let d: Date = Instant.from_epoch_secs(0)\n  io.println(\"\{d\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_let")
    expect_contains(out, "declared type Date but got Instant: call `.date()` on the Instant to get its UTC calendar day", "let mismatch")
}

test "a Date returned where an Instant goes names .to_instant()" {
    let src = "import std.time.\{Date, Instant\}\nfn start(d: Date) -> Instant \{ d \}\nfn main() \{\n  io.println(\"\{start(Date.from_ymd(2026, 1, 1).unwrap())\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_ret")
    expect_contains(out, "call `.to_instant()` on the Date to get its midnight in UTC", "return mismatch")
}

test "a user type named Date gets no std.time hint" {
    let src = "import std.time.\{Instant\}\ntype Date \{ n: Int \}\nfn take(d: Date) -> Int \{ d.n \}\nfn main() \{\n  io.println(\"\{take(Instant.from_epoch_secs(0))\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_user")
    expect_contains(out, "argument 1 of `take` expects Date, got Instant", "the mismatch is still reported")
    expect_absent(out, ".date()", "no std.time hint for a user Date")
}

test "a user program may declare its own Date and Weekday" {
    let src = "type Date \{ n: Int \}\ntype Weekday \{ Mon, Tue \}\nfn main() \{\n  let d = Date \{ n: 1 \}\n  let w = Weekday.Tue\n  io.println(\"\{d.n\} \{w.to_int()\}\")\n\}\n"
    let out = compile_and_capture(src, "_stmh_user_decl")
    expect_compiles_clean(out, "own Date and Weekday compile")
}
