// Weekday (sections/03_types.md, *Date and Weekday*; §3.4 *Tag Operations*): Monday has tag 0
// and Sunday 6, Display and Debug write the English name, and weekdays order Monday first.

import std.time.{Date, Weekday}

fn ymd(y: Int, m: Int, d: Int) -> Date {
    Date.from_ymd(y, m, d).unwrap()
}

test "the weekdays of known dates" {
    assert(ymd(2026, 10, 17).weekday() == Weekday.Saturday)
    assert(ymd(1970, 1, 1).weekday() == Weekday.Thursday)
    assert(ymd(2000, 2, 29).weekday() == Weekday.Tuesday)
    assert(ymd(1677, 9, 22).weekday() == Weekday.Wednesday)
    assert(ymd(2262, 4, 11).weekday() == Weekday.Friday)
    assert(ymd(1969, 12, 31).weekday() == Weekday.Wednesday)
    assert(ymd(1969, 12, 29).weekday() == Weekday.Monday)
    assert(ymd(1970, 1, 4).weekday() == Weekday.Sunday)
}

test "seven days on is the same weekday" {
    let mut d = ymd(1969, 12, 1)
    let mut i = 0
    while i < 60 {
        assert(d.add_days(7).weekday() == d.weekday())
        d = d.add_days(1)
        i = i + 1
    }
}

test "Monday is tag 0 and Sunday is tag 6" {
    assert_eq(Weekday.Monday.to_int(), 0)
    assert_eq(Weekday.Tuesday.to_int(), 1)
    assert_eq(Weekday.Wednesday.to_int(), 2)
    assert_eq(Weekday.Thursday.to_int(), 3)
    assert_eq(Weekday.Friday.to_int(), 4)
    assert_eq(Weekday.Saturday.to_int(), 5)
    assert_eq(Weekday.Sunday.to_int(), 6)
}

test "the ISO 8601 day number is to_int() + 1" {
    assert_eq(ymd(2026, 10, 12).weekday().to_int() + 1, 1)
    assert_eq(ymd(2026, 10, 18).weekday().to_int() + 1, 7)
}

test "Display writes the English name" {
    assert_eq("{Weekday.Monday}", "Monday")
    assert_eq("{Weekday.Tuesday}", "Tuesday")
    assert_eq("{Weekday.Wednesday}", "Wednesday")
    assert_eq("{Weekday.Thursday}", "Thursday")
    assert_eq("{Weekday.Friday}", "Friday")
    assert_eq("{Weekday.Saturday}", "Saturday")
    assert_eq("{Weekday.Sunday}", "Sunday")
    let d = ymd(2026, 10, 17)
    assert_eq("{d} is a {d.weekday()}", "2026-10-17 is a Saturday")
}

test "Debug writes the same text as Display" {
    assert_eq(Weekday.Monday.debug(), "Monday")
    assert_eq(Weekday.Sunday.debug(), "Sunday")
    assert_eq(ymd(2026, 10, 17).weekday().debug(), "Saturday")
}

test "weekdays order from Monday to Sunday" {
    assert(Weekday.Monday < Weekday.Tuesday)
    assert(Weekday.Saturday < Weekday.Sunday)
    assert(Weekday.Sunday > Weekday.Monday)
    assert(Weekday.Friday <= Weekday.Friday)
    assert(Weekday.Friday != Weekday.Saturday)
}

test "a Weekday clones and keys a Map" {
    let w = Weekday.Friday
    assert(w.clone() == w)
    let mut counts: Map[Weekday, Int] = Map()
    let mut d = ymd(2026, 10, 1)
    let mut i = 0
    while i < 31 {
        let k = d.weekday()
        counts.insert(k, (counts.get(k) ?? 0) + 1)
        d = d.add_days(1)
        i = i + 1
    }
    assert_eq(counts.len(), 7)
    assert_eq(counts.get(Weekday.Thursday).unwrap(), 5)
    assert_eq(counts.get(Weekday.Monday).unwrap(), 4)
}
