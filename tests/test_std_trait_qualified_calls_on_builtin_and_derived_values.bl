// `Trait.method(x, ..)` names the trait whose method runs on `x` (sections/03c_protocols.md
// *Explicit trait + method*). A std trait reaches a built-in value through the compiler's own
// impls and a struct or an enum through a derive, and the qualified call gives the same result
// as `x.method(..)` on each of them.

@derive(Eq, Hash, Debug, Clone, Ord)
type QualPoint {
    a: Int
}

@derive(Eq, Debug)
type QualBox[T] {
    v: T
}

fn qual_same[T: Eq](a: T, b: T) -> Bool {
    Eq.eq(a, b)
}

fn qual_show[T: Debug](x: T) -> Str {
    Debug.debug(x)
}

test "a qualified eq and cmp on a scalar" {
    assert(Eq.eq(1, 1))
    assert(!Eq.eq(1, 2))
    assert(Eq.eq("a", "a"))
    assert(Eq.eq(true, true))
    assert(Eq.eq(1.5, 1.5))
    assert_eq(Ord.cmp(1, 2), Ordering.Less)
    assert_eq(Ord.cmp("b", "a"), Ordering.Greater)
    assert_eq(Ord.cmp('c', 'c'), Ordering.Equal)
}

test "a qualified clone, debug and hash on a built-in value" {
    assert_eq(Clone.clone(7), 7)
    assert_eq(Clone.clone("s"), "s")
    assert_eq(Debug.debug([1, 2]), "[1, 2]")
    assert_eq(Debug.debug(Some("x")), "Some(\"x\")")
    assert_eq(Hash.hash("x"), "x".hash())
    assert_eq(Hash.hash(7), 7.hash())
}

test "a qualified eq on a container" {
    assert(Eq.eq([1], [1]))
    assert(!Eq.eq(Some(1), Some(2)))
    assert(Eq.eq((1, "a"), (1, "a")))
}

test "a qualified call on a derived struct" {
    let p = QualPoint { a: 1 }
    assert(Eq.eq(p, QualPoint { a: 1 }))
    assert(!Eq.eq(p, QualPoint { a: 2 }))
    assert_eq(Hash.hash(p), p.hash())
    assert_eq(Debug.debug(p), p.debug())
    assert_eq(Clone.clone(QualPoint { a: 3 }).a, 3)
    assert_eq(Ord.cmp(p, QualPoint { a: 2 }), Ordering.Less)
}

test "a qualified call on a derived generic struct" {
    assert(Eq.eq(QualBox { v: 1 }, QualBox { v: 1 }))
    assert_eq(Debug.debug(QualBox { v: "s" }), QualBox { v: "s" }.debug())
}

test "a qualified call through a bound runs the method of the instance" {
    assert(qual_same(1, 1))
    assert(!qual_same("a", "b"))
    assert(qual_same(QualPoint { a: 4 }, QualPoint { a: 4 }))
    assert_eq(qual_show(7), "7")
    assert_eq(qual_show([1]), "[1]")
    assert_eq(qual_show(QualPoint { a: 5 }), QualPoint { a: 5 }.debug())
}

// A written clone shows in the copy, so the test can tell that each bound of a range went through it.
@derive(Debug, Eq, Ord)
type QualStep {
    a: Int
}

impl Clone for QualStep {
    fn clone(self) -> QualStep { QualStep { a: self.a + 10 } }
}

test "a qualified clone and debug on a range is the method call" {
    let r = QualStep { a: 1 }..QualStep { a: 2 }
    assert_eq(Clone.clone(r).debug(), r.clone().debug())
    assert_eq(Debug.debug(Clone.clone(r)), "QualStep \{ a: 11 }..QualStep \{ a: 12 }")
    assert_eq(Debug.debug(0..3), "0..3")
    assert(Clone.clone(0..=3) == 0..=3)
}
