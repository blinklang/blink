// The stdlib archive compiles the test runtime's bodies in a unit of their own, beside the
// monolith and at the same time, so they do not lengthen the monolith's compile. The
// monolith only calls them; a binary that reaches one links that member's copy.

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

// The entry points of runtime_test.h that units and the stdlib call.
fn entry_points() -> List[Str] {
    [
        "__blink_assert_fail", "blink_set_case_label", "blink_record_case",
        "__blink_assert_fail_eq", "__blink_assert_fail_intro", "__blink_test_set_propagate",
        "__blink_test_set_skipped", "__blink_assert_panics_returned",
        "__blink_assert_panics_mismatch", "__blink_test_is_failed", "__blink_test_is_skipped",
        "blink_test_run",
    ]
}

fn defined_entry_points(member: Str) -> List[Str] {
    let fns = entry_points()
    let mut out: List[Str] = []
    for line in sh("nm --defined-only {member}").split("\n") {
        let parts = line.split(" ")
        let name = parts.get(parts.len() - 1).unwrap()
        if fns.contains(name) { out.push(name) }
    }
    out
}

test "the stdlib archive defines the test runtime in its own member, not in the monolith" {
    let root = sh("pwd -P")
    let dir = "{root}/.tmp/_archive_test_member_{getpid()}"
    let arc = sh("readlink -f build/libblink_std.a")
    shell_exec("rm -rf {dir}")
    shell_exec("mkdir -p {dir}")
    let members = sh("ar t {arc}").split("\n")
    shell_exec("cd {dir} && ar x {arc}")
    let in_monolith = defined_entry_points("{dir}/monolith.o")
    let in_member = defined_entry_points("{dir}/runtime_test.o")
    shell_exec("rm -rf {dir}")
    let mut missing: List[Str] = []
    for f in entry_points() {
        if !in_member.contains(f) { missing.push(f) }
    }
    assert_eq(members.join(" "), "monolith.o runtime_test.o")
    assert_eq(in_monolith.join(" "), "")
    assert_eq(missing.join(" "), "")
}
