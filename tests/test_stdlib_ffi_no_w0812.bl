// A stdlib-defined @ffi type must never emit W0812 MissingCanonicalHeader.
// Per §07:415 the sqlite3 native dep behind std.db_sqlite is compiler-managed
// and users never declare it in blink.toml; §07:833 scopes W0812 at user-defined
// @ffi.struct *outside* stdlib. So importing std.db_sqlite from a project that
// has a blink.toml (without a [native-dependencies] sqlite3 entry, which is the
// spec-correct state) must compile without the warning. The user-defined case
// (test_ffi_struct_w0812.bl) must still warn — this exempts only stdlib modules.

test "stdlib @ffi.opaque (compiler-managed native dep) does not emit W0812" {
    let tag = "z6hykk_stdlib"
    let bl_path = ".tmp/_test_{tag}.bl"
    let src = "import std.db_sqlite.\{sqlite_open, sqlite_close}\n\nfn main() \{\n    let h = sqlite_open(\":memory:\")\n    sqlite_close(h)\n}\n"
    write_file(bl_path, src)
    let result = process_run("build/blink", ["build", bl_path, "--emit", "c"])
    let combined = "{result.out}{result.err_out}"
    // Assert the build actually succeeded, else the no-warning check is vacuous
    // (a broken import or renamed fn would also lack the warning string).
    assert_eq(result.exit_code, 0)
    // Positive marker: the opaque typedef emit path — where W0812 fires — ran.
    let c_src = read_file("build/_test_{tag}.c")
    assert(c_src.contains("sqlite3"))
    assert(!combined.contains("MissingCanonicalHeader"))
    shell_exec("rm -f {bl_path} build/_test_{tag}.c")
}
