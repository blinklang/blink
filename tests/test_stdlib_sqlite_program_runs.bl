// A program that calls std.db_sqlite needs the vendored sqlite on its link line and the
// sqlite runtime shims in its unit. Both hang on the unit saying it uses sqlite, so this
// program only compiles, links and reads its row back when the unit says so.
import std.db_sqlite.{sqlite_open, sqlite_close, sqlite_exec_raw, sqlite_prepare, sqlite_bind_int,
    sqlite_step, sqlite_column_int, sqlite_column_text, sqlite_finalize}

fn main() {
    let h = sqlite_open(":memory:")
    assert_eq(sqlite_exec_raw(h, "CREATE TABLE t (id INTEGER, name TEXT)"), 0)
    assert_eq(sqlite_exec_raw(h, "INSERT INTO t VALUES (7, 'seven')"), 0)
    match sqlite_prepare(h, "SELECT id, name FROM t WHERE id = ?") {
        Some(stmt) => {
            assert_eq(sqlite_bind_int(stmt, 1, 7), 0)
            assert_eq(sqlite_step(stmt), 100)
            assert_eq(sqlite_column_int(stmt, 0), 7)
            assert_eq(sqlite_column_text(stmt, 1), "seven")
            let _ = sqlite_finalize(stmt)
        }
        None => assert(false, "the select statement must prepare")
    }
    let _ = sqlite_close(h)
    io.println("ok")
}
