import compile_test_helpers

test "non-tail stmt in stmt-position match arm is type-checked" {
    let src = "fn check_it(o: Option[Int]) \{\n    let mut total = 0\n    match o \{\n        Some(v) => \{\n            total = \"oops\"\n            total = total + v\n        \}\n        None => \{ total = 0 \}\n    \}\n\}\nfn main() \{ check_it(Some(1)) \}\n"
    write_file("{compile_test_helpers.scratch_root()}/_test_stmt_match_nontail_check_stmt_match.bl", src)
    let args = ["{compile_test_helpers.scratch_root()}/_test_stmt_match_nontail_check_stmt_match.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(output.contains("E0300"))
    assert(output.contains("TypeError"))
    assert(output.contains("cannot assign Str to Int"))
    shell_exec("rm -f {compile_test_helpers.scratch_root()}/_test_stmt_match_nontail_check_stmt_match.bl")
}
