// Str.byte_at returns a bare byte, so it cannot say "absent": an index below 0 or at or
// past the byte length panics (spec §3.2.1, Out-of-range indices). The message names the
// method, the index and the byte length, so a failing loop bound is easy to find.
// The fixtures hold 2-, 3- and 4-byte codepoints because on ASCII text a byte offset and
// a codepoint index agree, which hides a mix-up of the two units.

fn read(s: Str, i: Int) -> U8 {
    s.byte_at(i)
}

test "an index equal to the byte length panics" {
    assert_panics(matching: "Str.byte_at index out of bounds: idx=2 byte_len=2") {
        io.println("{read("hi", 2)}")
    }
}

test "a negative index panics and does not count from the end" {
    assert_panics(matching: "Str.byte_at index out of bounds: idx=-1 byte_len=2") {
        io.println("{read("hi", -1)}")
    }
}

test "an index far past the end panics instead of reading memory" {
    assert_panics(matching: "Str.byte_at index out of bounds: idx=100000000 byte_len=2") {
        io.println("{read("hi", 100000000)}")
    }
}

test "any index into the empty string panics" {
    assert_panics(matching: "Str.byte_at index out of bounds: idx=0 byte_len=0") {
        io.println("{read("", 0)}")
    }
}

test "the bound is the byte length, not the codepoint count" {
    // "é" is C3 A9, "€" is E2 82 AC, "😀" is F0 9F 98 80.
    assert_eq(read("é", 1), 169)
    assert_eq(read("€", 2), 172)
    assert_eq(read("😀", 3), 128)
    assert_panics(matching: "Str.byte_at index out of bounds: idx=2 byte_len=2") {
        io.println("{read("é", 2)}")
    }
    assert_panics(matching: "Str.byte_at index out of bounds: idx=3 byte_len=3") {
        io.println("{read("€", 3)}")
    }
    assert_panics(matching: "Str.byte_at index out of bounds: idx=4 byte_len=4") {
        io.println("{read("😀", 4)}")
    }
}

test "every in-range index reads its byte" {
    let s = "aé€😀"
    let want = [97, 195, 169, 226, 130, 172, 240, 159, 152, 128]
    assert_eq(s.byte_len(), 10)
    let mut i = 0
    while i < s.byte_len() {
        assert_eq(s.byte_at(i).to_int(), want.get(i).unwrap())
        i = i + 1
    }
}
