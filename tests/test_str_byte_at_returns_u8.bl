// Str.byte_at returns U8 (spec §3.2.1). U8 is its own type, not a narrow Int (§3.2 Sized
// Integer Types), so a byte reaches an Int only through an explicit widening, and arithmetic
// on a byte is U8 arithmetic with U8 overflow checks.
import compile_test_helpers
import std.traits.{StrOps}

fn is_high(b: U8) -> Bool { b >= 128 }

test "a byte passed where Int is required is a type error" {
    let src = "fn f(x: Int) -> Int \{ x }\nfn main() \{\n    io.println(\"\{f(\"a\".byte_at(0))}\")\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "byte_at_u8_int_param")
    compile_test_helpers.expect_contains(out, "\"name\":\"TypeError\"", "byte_at into an Int param")
    compile_test_helpers.expect_contains(out, "expects Int, got U8", "names both types")
}

test "a byte bound to a declared Int is a type error" {
    let src = "fn main() \{\n    let x: Int = \"a\".byte_at(0)\n    io.println(\"\{x}\")\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "byte_at_u8_let_int")
    compile_test_helpers.expect_contains(out, "declared type Int but got U8", "byte_at into let: Int")
}

test "a byte added to an Int is a type error" {
    let src = "fn main() \{\n    let n = 1\n    io.println(\"\{n + \"a\".byte_at(0)}\")\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "byte_at_u8_plus_int")
    compile_test_helpers.expect_contains(out, "incompatible types Int and U8", "Int + byte")
}

test "a byte binds to a declared U8" {
    let b: U8 = "héllo".byte_at(1)
    assert_eq(b, 195)
}

test "a byte passes where U8 is required" {
    assert(!is_high("a".byte_at(0)))
    assert(is_high("é".byte_at(0)))
    assert(is_high("😀".byte_at(3)))
}

test "a byte compares with an integer literal" {
    let s = "a€"
    assert(s.byte_at(0) == 97)
    assert(s.byte_at(1) >= 224 && s.byte_at(1) < 240)
    assert_eq(s.byte_at(3), 172)
}

test "two bytes compare with each other" {
    let s = "éé"
    assert(s.byte_at(0) == s.byte_at(2))
    assert(s.byte_at(0) != s.byte_at(1))
}

test "to_int widens a byte so Int arithmetic does not overflow" {
    let s = "😀"
    assert_eq(s.byte_at(0).to_int() * 1000, 240000)
    assert_eq(Int.from(s.byte_at(1)) + 256, 415)
}

test "arithmetic on a byte is U8 arithmetic" {
    let b = "é".byte_at(0)
    assert_eq(b - 3, 192)
    assert_panics(matching: "U8 overflow") {
        io.println("{b + 100}")
    }
}

test "the StrOps-qualified call returns U8 too" {
    let b: U8 = StrOps.byte_at("€", 0)
    assert_eq(b, 226)
}
