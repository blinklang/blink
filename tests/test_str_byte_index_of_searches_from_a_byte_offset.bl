// Str.byte_index_of(needle, from) gives the byte offset of the first match at or after
// byte offset `from` (spec §3.2.1). A `from` below 0 reads as 0, a `from` past byte_len
// gives None, and a `from` inside a multi-byte codepoint panics, so None always means
// "not found" and never "bad offset".
// The fixtures hold 2-, 3- and 4-byte codepoints because on ASCII text a byte offset and
// a codepoint index agree, which hides a mix-up of the two units.
import compile_test_helpers

test "the spec examples hold" {
    let s = "héllo"
    assert_eq(s.byte_index_of("l", 0), Some(3))
    assert_eq(s.byte_index_of("l", 4), Some(4))
}

test "offsets count bytes, not codepoints" {
    let s = "é€😀,x"
    assert_eq(s.byte_index_of(",", 0), Some(9))
    assert_eq(s.byte_index_of("€", 0), Some(2))
    assert_eq(s.byte_index_of("😀", 0), Some(5))
    assert_eq(s.byte_index_of("x", 9), Some(10))
}

test "a match before from is not found" {
    assert_eq("a,b,c".byte_index_of(",", 2), Some(3))
    assert_eq("a,b,c".byte_index_of(",", 4), None)
    assert_eq("abc".byte_index_of("z", 0), None)
}

test "a negative from reads as zero" {
    assert_eq("é,".byte_index_of(",", -1), Some(2))
    assert_eq("é,".byte_index_of("é", -100), Some(0))
}

test "from equal to the byte length searches the empty tail" {
    assert_eq("é,".byte_index_of(",", 3), None)
    assert_eq("é,".byte_index_of("", 3), Some(3))
}

test "from past the byte length gives None" {
    assert_eq("é,".byte_index_of(",", 4), None)
    assert_eq("é,".byte_index_of("", 4), None)
    assert_eq("".byte_index_of("", 1), None)
}

test "a from inside a 2-byte codepoint panics and names the codepoint it cuts" {
    assert_panics(matching: "Str.byte_index_of from=1 is inside a codepoint: cuts U+00E9 at bytes 0..2 byte_len=3") {
        let _r = "é,".byte_index_of(",", 1)
    }
}

test "a from inside a 3-byte codepoint panics" {
    assert_panics(matching: "Str.byte_index_of from=3 is inside a codepoint: cuts U+20AC at bytes 1..4 byte_len=4") {
        let _r = "a€".byte_index_of("a", 3)
    }
}

test "a from inside a 4-byte codepoint panics" {
    assert_panics(matching: "Str.byte_index_of from=1 is inside a codepoint: cuts U+1F600 at bytes 0..4 byte_len=4") {
        let _r = "😀".byte_index_of("x", 1)
    }
}

test "every match and its end are valid byte_slice bounds" {
    let s = "é,€,😀,a,"
    let needles = [",", "€", "😀", "a", "é,", ",€,"]
    for needle in needles {
        let mut from = 0
        let mut found = 0
        while from <= s.len() {
            match s.byte_index_of(needle, from) {
                Some(i) => {
                    let hit = s.byte_slice(i, i + needle.len())
                    assert_eq(hit, needle)
                    let before = s.byte_slice(0, i)
                    let after = s.byte_slice(i, s.len())
                    assert_eq(before.concat(after), s)
                    found = found + 1
                    from = i + needle.len()
                }
                None => {
                    from = s.len() + 1
                }
            }
        }
        assert(found > 0, "no match for {needle}")
    }
}

// There is no default `from`, so the needle alone is an arity error. Its help spells out the
// `, 0` that searches from the start; it is not a machine-applicable fix, because a fix
// replaces the reported span and the needle records no end.
test "byte_index_of with the needle alone is refused with help that adds a from of 0" {
    let src = "fn main() \{\n    let _i = \"a,b\".byte_index_of(\",\")\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "byte_index_of_no_from")
    compile_test_helpers.expect_contains(out, "\"name\":\"TypeError\"", "arity refused")
    compile_test_helpers.expect_contains(out, "expects 2 argument(s), got 1", "names the arity")
    compile_test_helpers.expect_contains(out, "add `, 0` after the needle", "help adds a from of 0")
    assert(!out.contains("\"fix\""))
}
