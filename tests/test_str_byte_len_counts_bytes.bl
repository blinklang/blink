// Str.byte_len() is the number of UTF-8 bytes in the string (spec §3.2.1). The fixtures hold
// 2-, 3- and 4-byte codepoints because on ASCII text the byte count and the codepoint count
// agree, which hides a mix-up of the two units.
import std.traits.{StrOps}

test "ASCII and the empty string" {
    assert_eq("".byte_len(), 0)
    assert_eq("a".byte_len(), 1)
    assert_eq("hello".byte_len(), 5)
}

test "a 2-byte codepoint counts as two bytes" {
    assert_eq("é".byte_len(), 2)
    assert_eq("café".byte_len(), 5)
}

test "a 3-byte codepoint counts as three bytes" {
    assert_eq("€".byte_len(), 3)
    assert_eq("5€".byte_len(), 4)
}

test "a 4-byte codepoint counts as four bytes" {
    assert_eq("😀".byte_len(), 4)
    assert_eq("a😀b".byte_len(), 6)
}

test "mixed widths add up" {
    assert_eq("aé€😀b".byte_len(), 11)
}

test "byte_len agrees with the UTF-8 encoding" {
    let s = "aé€😀b"
    assert_eq(s.byte_len(), Bytes.from_str(s).len())
}

test "a built string reports the bytes it holds" {
    let sb = StringBuilder.new()
    sb.write("é")
    sb.write("😀")
    assert_eq(sb.to_str().byte_len(), 6)
    assert_eq("€".concat("é").byte_len(), 5)
}

test "byte_len - 1 is the last index byte_at accepts" {
    let s = "é😀"
    let n = s.byte_len()
    assert_eq(s.byte_at(n - 1), 128)
    assert_panics(matching: "Str.byte_at index out of bounds") {
        io.println("{s.byte_at(n)}")
    }
}

test "byte_len bounds a byte_slice of the whole string" {
    let s = "€😀"
    assert_eq(s.byte_slice(0, s.byte_len()), s)
    assert_eq(s.byte_slice(3, s.byte_len()), "😀")
}

test "the StrOps-qualified call gives the same count" {
    assert_eq(StrOps.byte_len("é€😀"), 9)
}
