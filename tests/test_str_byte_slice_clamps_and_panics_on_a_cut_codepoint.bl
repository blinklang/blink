// Str.byte_slice(start, end) reads the bytes in [start, end). It follows the range rule
// of spec §3.2.1: a start below 0 reads as 0, an end past byte_len reads as byte_len, and
// start >= end gives "". After that clamp it panics when a bound falls inside a multi-byte
// codepoint, because the result would not be valid UTF-8.
// The fixtures hold 2-, 3- and 4-byte codepoints because on ASCII text a byte offset and
// a codepoint index agree, which hides a mix-up of the two units.

test "the spec examples hold" {
    let s = "héllo"
    assert_eq(s.byte_slice(0, 3), "hé")
    assert_eq("café".byte_slice(0, 5), "café")
    assert_panics(matching: "Str.byte_slice end=4 is inside a codepoint") {
        io.println("café".byte_slice(0, 4))
    }
}

test "bounds on codepoint boundaries give the codepoints between them" {
    let s = "aé€😀b"
    // a=0, é=1..3, €=3..6, 😀=6..10, b=10
    assert_eq(s.byte_slice(1, 3), "é")
    assert_eq(s.byte_slice(3, 6), "€")
    assert_eq(s.byte_slice(6, 10), "😀")
    assert_eq(s.byte_slice(0, 11), s)
    assert_eq(s.byte_slice(10, 11), "b")
}

test "a negative start reads as zero" {
    assert_eq("é€".byte_slice(-4, 2), "é")
    assert_eq("é€".byte_slice(-1, 99), "é€")
}

test "an end past the byte length reads as the byte length" {
    assert_eq("é€".byte_slice(2, 99), "€")
    assert_eq("😀".byte_slice(0, 5), "😀")
}

test "start at or past end gives the empty string and does not swap" {
    assert_eq("hello".byte_slice(3, 1), "")
    assert_eq("hello".byte_slice(5, 9), "")
    assert_eq("hello".byte_slice(2, 2), "")
    assert_eq("hello".byte_slice(1, -1), "")
    assert_eq("".byte_slice(0, 3), "")
}

test "a start inside a 2-byte codepoint panics" {
    assert_panics(matching: "Str.byte_slice start=2 is inside a codepoint: cuts U+00E9 at bytes 1..3 byte_len=4") {
        io.println("aéb".byte_slice(2, 4))
    }
}

test "an end inside a 2-byte codepoint panics" {
    assert_panics(matching: "Str.byte_slice end=2 is inside a codepoint: cuts U+00E9 at bytes 1..3 byte_len=4") {
        io.println("aéb".byte_slice(0, 2))
    }
}

test "a bound inside a 3-byte codepoint panics" {
    // "€" is U+20AC, bytes E2 82 AC.
    assert_panics(matching: "Str.byte_slice start=1 is inside a codepoint: cuts U+20AC at bytes 0..3 byte_len=3") {
        io.println("€".byte_slice(1, 3))
    }
    assert_panics(matching: "Str.byte_slice end=2 is inside a codepoint: cuts U+20AC at bytes 0..3 byte_len=3") {
        io.println("€".byte_slice(0, 2))
    }
}

test "a bound inside a 4-byte codepoint panics at each of its three inner bytes" {
    // "😀" is U+1F600, bytes F0 9F 98 80.
    assert_panics(matching: "Str.byte_slice end=2 is inside a codepoint: cuts U+1F600 at bytes 1..5 byte_len=6") {
        io.println("x😀y".byte_slice(0, 2))
    }
    assert_panics(matching: "Str.byte_slice start=2 is inside a codepoint: cuts U+1F600 at bytes 1..5 byte_len=6") {
        io.println("x😀y".byte_slice(2, 6))
    }
    assert_panics(matching: "Str.byte_slice start=3 is inside a codepoint: cuts U+1F600 at bytes 1..5 byte_len=6") {
        io.println("x😀y".byte_slice(3, 6))
    }
    assert_panics(matching: "Str.byte_slice end=4 is inside a codepoint: cuts U+1F600 at bytes 1..5 byte_len=6") {
        io.println("x😀y".byte_slice(0, 4))
    }
}

test "a clamped bound is never inside a codepoint" {
    assert_eq("😀".byte_slice(-3, 4), "😀")
    assert_eq("😀".byte_slice(0, 40), "😀")
}
