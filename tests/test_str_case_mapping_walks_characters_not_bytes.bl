// to_upper and to_lower walk the text one Char at a time. The fixtures put 2-, 3- and
// 4-byte characters between ASCII letters, so a walk that mixes byte offsets with
// character indices drops, splits or repeats a character, and the result shows it.

test "to_upper maps the ASCII letters around multi-byte characters" {
    assert_eq("a€b😀cé-z".to_upper(), "A€B😀Cé-Z")
}

test "to_lower maps the ASCII letters around multi-byte characters" {
    assert_eq("A€B😀Cé-Z".to_lower(), "a€b😀cé-z")
}

test "a text with no ASCII letters comes back unchanged" {
    assert_eq("€😀é".to_upper(), "€😀é")
    assert_eq("€😀é".to_lower(), "€😀é")
}

test "case mapping keeps the byte length of the text" {
    let s = "x€y😀z"
    assert_eq(s.to_upper().byte_len(), s.byte_len())
    assert_eq(s.to_lower().byte_len(), s.byte_len())
}
