// char_at(i) returns the codepoint at codepoint index i, and None out of bounds.
// Each fixture puts a multi-byte character before the index, so a byte index reads
// the wrong character or the middle of one. The expected characters are written as
// codepoint numbers because the lexer does not yet read a multi-byte char literal.

// -1 stands for None, which no codepoint can be.
fn cp_at(s: Str, i: Int) -> Int {
    match s.char_at(i) {
        Some(ch) => ch.to_int()
        None => -1
    }
}

test "char_at reads a multi-byte character at its codepoint index" {
    let s = "café"
    assert_eq(cp_at(s, 3), 233)
    assert_eq(cp_at(s, 0), 99)
}

test "char_at past a multi-byte character reads the next codepoint" {
    let s = "é€😀abc"
    assert_eq(cp_at(s, 0), 233)
    assert_eq(cp_at(s, 1), 8364)
    assert_eq(cp_at(s, 2), 128512)
    assert_eq(cp_at(s, 3), 97)
    assert_eq(cp_at(s, 5), 99)
}

test "char_at is None at and past the codepoint length" {
    let s = "é😀"
    assert_eq(cp_at(s, 1), 128512)
    assert_eq(cp_at(s, 2), -1)
    assert_eq(cp_at(s, 5), -1)
    assert_eq(cp_at(s, -1), -1)
}

test "char_at over every index gives the same characters as a for loop" {
    let s = "a€b😀cé"
    let mut i = 0
    for ch in s {
        assert_eq(cp_at(s, i), ch.to_int())
        i = i + 1
    }
    assert_eq(i, 6)
    assert_eq(i, s.len())
}
