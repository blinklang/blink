// index_of returns the codepoint index of the first match as Option[Int]. Each
// fixture puts a multi-byte character before the match, so a byte offset comes out
// too large.

test "index_of after a multi-byte character gives a codepoint index" {
    assert_eq("café".index_of("fé"), Some(2))
    assert_eq("café".index_of("é"), Some(3))
    assert_eq("é€😀abc".index_of("abc"), Some(3))
    assert_eq("😀😀x".index_of("x"), Some(2))
}

test "index_of finds the first of several matches" {
    assert_eq("é-é-é".index_of("é"), Some(0))
    assert_eq("ab€ab€".index_of("€"), Some(2))
}

test "index_of is None when the needle is absent" {
    assert_eq("café".index_of("x"), None)
    assert_eq("".index_of("é"), None)
}

test "index_of and substring use the same unit" {
    let s = "naïve 😀 café"
    match s.index_of("café") {
        Some(i) => assert_eq(s.substring(i, i + "café".len()), "café")
        None => assert(false)
    }
}
