// Str implements IntoIterator[Char] (§3c.1): `.into_iter()` yields the string's Unicode
// scalar values in order as a lazy Iterator[Char], the same Chars a `for c in s` loop walks.

test "into_iter collects a multi-byte string as its Chars" {
    let cs = "hé".into_iter().collect()
    assert_eq(cs.len(), 2)
    assert_eq(cs.get(0).unwrap(), 'h')
    assert_eq(cs.get(1).unwrap(), 'é')
}

test "an empty string yields no Char" {
    assert_eq("".into_iter().count(), 0)
    assert_eq("".into_iter().collect().len(), 0)
    let first = "".into_iter().find(fn(c) { c == 'x' })
    assert(first.is_none())
}

test "a lazy chain filters the Chars of a string" {
    let vowels = "hello".into_iter().filter(fn(c) { "aeiou".contains(c.to_str()) }).collect()
    assert_eq(vowels.len(), 2)
    assert_eq(vowels.get(0).unwrap(), 'e')
    assert_eq(vowels.get(1).unwrap(), 'o')
}

test "count counts scalar values, not bytes" {
    let s = "a😀b"
    assert_eq(s.byte_len(), 6)
    assert_eq(s.into_iter().count(), 3)
}

test "a for loop and into_iter give the same Chars" {
    let s = "añ€😀z"
    let mut looped: List[Char] = []
    for c in s {
        looped.push(c)
    }
    let pulled = s.into_iter().collect()
    assert_eq(pulled.len(), looped.len())
    let mut i = 0
    while i < looped.len() {
        assert_eq(pulled.get(i).unwrap(), looped.get(i).unwrap())
        i = i + 1
    }
}

test "each consumer starts over from the first Char" {
    let it = "abc".into_iter()
    assert_eq(it.count(), 3)
    let again = it.map(fn(c) { c.to_int() }).collect()
    assert_eq(again.len(), 3)
    assert_eq(again.get(0).unwrap(), 97)
    assert_eq(again.get(2).unwrap(), 99)
}

test "take stops early on a long string" {
    let got = "héllo wörld".into_iter().skip(1).take(3).collect()
    assert_eq(got.len(), 3)
    assert_eq(got.get(0).unwrap(), 'é')
    assert_eq(got.get(2).unwrap(), 'l')
}
