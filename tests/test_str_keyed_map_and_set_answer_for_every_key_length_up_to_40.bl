// A Str-keyed Map or Set finds a key by its hash and then by its bytes. The keys here
// run from 0 to 40 bytes long and come in byte classes (ASCII letters, low control bytes,
// 0x7f, and the lead and tail bytes of 2-, 3- and 4-byte UTF-8 chars). Beside each base
// key sit keys that differ from it in one byte only, at each byte in turn, so pairs differ
// only in the first byte, only in the last, and only past byte 8. Each lookup goes through
// equal copies made by other routes (concat, slice of a wider Str, interpolation), so a
// hash that reads a byte past the key, or misses one, gives a wrong answer here.
//
// Truth comes from a linear scan of the stored keys, never from a hash.

// 0 picks the filler family: ASCII letters that change from byte to byte.
fn families() -> List[Int] { [0, 1, 127, 233, 8364, 128512] }

fn fill_cp(j: Int) -> Int { 97 + (j * 7) % 26 }

fn unit_len(cp: Int) -> Int {
    if cp < 128 { return 1 }
    if cp < 2048 { return 2 }
    if cp < 65536 { return 3 }
    4
}

// The power of 64 that moves one byte of a UTF-8 char: the last byte for k = 0, one byte
// further to the front for each k. No family char carries out of the 6-bit group it moves.
fn pow64(k: Int) -> Int {
    let mut p = 1
    let mut i = 0
    while i < k {
        p = p * 64
        i = i + 1
    }
    p
}

fn write_cp(sb: StringBuilder, cp: Int) {
    sb.write_char(Char.from_code_point(cp).unwrap())
}

// n bytes of family `fam`. With `vary` in 0..n, byte `vary` differs from the base key and
// no other byte does. 0x7f moves down, as 0x80 would take two bytes.
fn build_key(fam: Int, n: Int, vary: Int) -> Str {
    let u = unit_len(fam)
    let pad = n % u
    let sb = StringBuilder.new()
    let mut j = 0
    while j < pad {
        if j == vary { write_cp(sb, fill_cp(j) + 1) } else { write_cp(sb, fill_cp(j)) }
        j = j + 1
    }
    let mut start = pad
    while start < n {
        let mut cp = fam
        if fam == 0 { cp = fill_cp(start) }
        if vary >= start && vary < start + u {
            let step = pow64(start + u - 1 - vary)
            if fam == 127 { cp = cp - step } else { cp = cp + step }
        }
        write_cp(sb, cp)
        start = start + u
    }
    sb.to_str()
}

// The byte offset of the char boundary nearest the middle of k.
fn mid_cut(k: Str) -> Int {
    let n = k.byte_len()
    let mut cut = n / 2
    while cut > 0 && cut < n && k.byte_at(cut).to_int() >= 128 && k.byte_at(cut).to_int() < 192 {
        cut = cut - 1
    }
    cut
}

fn by_concat(k: Str) -> Str {
    let cut = mid_cut(k)
    k.byte_slice(0, cut).concat(k.byte_slice(cut, k.byte_len()))
}

fn by_slice(k: Str) -> Str {
    let wide = "<".concat(k).concat(">>>>>>>>")
    wide.byte_slice(1, k.byte_len() + 1)
}

fn by_interp(k: Str) -> Str {
    let cut = mid_cut(k)
    let a = k.byte_slice(0, cut)
    let b = k.byte_slice(cut, k.byte_len())
    "{a}{b}"
}

fn index_of(keys: List[Str], k: Str) -> Int {
    let mut i = 0
    while i < keys.len() {
        if keys.get(i).unwrap() == k { return i }
        i = i + 1
    }
    -1
}

fn show(k: Str) -> Str { "{k.byte_len()} bytes {Bytes.from_str(k).to_hex()}" }

// Stored keys: each base key and its one-byte variants at even offsets. The variants at
// odd offsets are probes that must be absent, unless the same bytes are already stored.
fn stored_and_probes() -> (List[Str], List[Str]) {
    let mut stored: List[Str] = []
    let mut probes: List[Str] = []
    for fam in families() {
        let mut n = 0
        while n <= 40 {
            let base = build_key(fam, n, -1)
            if index_of(stored, base) < 0 { stored.push(base) }
            let mut i = 0
            while i < n {
                let k = build_key(fam, n, i)
                if i % 2 == 0 {
                    if index_of(stored, k) < 0 { stored.push(k) }
                } else {
                    probes.push(k)
                }
                i = i + 1
            }
            n = n + 1
        }
    }
    (stored, probes)
}

fn copies(k: Str) -> List[Str] { [by_concat(k), by_slice(k), by_interp(k)] }

test "the key builder makes keys of the asked length that differ in the asked byte only" {
    for fam in families() {
        let mut n = 0
        while n <= 40 {
            let base = build_key(fam, n, -1)
            assert_eq(base.byte_len(), n)
            let mut i = 0
            while i < n {
                let k = build_key(fam, n, i)
                assert_eq(k.byte_len(), n)
                let mut diff = 0
                let mut j = 0
                while j < n {
                    if k.byte_at(j) != base.byte_at(j) {
                        assert_eq(j, i)
                        diff = diff + 1
                    }
                    j = j + 1
                }
                assert_eq(diff, 1)
                i = i + 1
            }
            n = n + 1
        }
    }
}

test "a Str-keyed Map answers get, contains, insert over, remove and iteration for keys of 0 to 40 bytes" {
    let (stored, probes) = stored_and_probes()
    let mut m: Map[Str, Int] = Map()
    let mut i = 0
    while i < stored.len() {
        m.insert(stored.get(i).unwrap(), i)
        i = i + 1
    }
    assert_eq(m.len(), stored.len())

    let mut bad = 0
    i = 0
    while i < stored.len() {
        let k = stored.get(i).unwrap()
        for c in copies(k) {
            let got = m.get(c) ?? -1
            if got != i || !m.contains_key(c) {
                if bad < 10 { io.println("get {show(c)}: {got}, want {i}") }
                bad = bad + 1
            }
        }
        i = i + 1
    }
    for p in probes {
        let want = index_of(stored, p)
        for c in copies(p) {
            let got = m.get(c) ?? -1
            if got != want || m.contains_key(c) != (want >= 0) {
                if bad < 10 { io.println("probe {show(c)}: {got}, want {want}") }
                bad = bad + 1
            }
        }
    }
    assert_eq(bad, 0)

    i = 0
    while i < stored.len() {
        m.insert(by_slice(stored.get(i).unwrap()), i + 1000000)
        i = i + 1
    }
    assert_eq(m.len(), stored.len())
    i = 0
    while i < stored.len() {
        let got = m.get(by_concat(stored.get(i).unwrap())) ?? -1
        if got != i + 1000000 {
            if bad < 10 { io.println("insert over {show(stored.get(i).unwrap())}: {got}") }
            bad = bad + 1
        }
        i = i + 1
    }
    assert_eq(bad, 0)

    let mut seen: List[Int] = []
    i = 0
    while i < stored.len() {
        seen.push(0)
        i = i + 1
    }
    let mut visits = 0
    for (k, v) in m {
        let at = index_of(stored, k)
        if at < 0 || v != at + 1000000 {
            if bad < 10 { io.println("iteration gave {show(k)} => {v}, stored at {at}") }
            bad = bad + 1
        } else {
            seen.set(at, seen.get(at).unwrap() + 1)
        }
        visits = visits + 1
    }
    assert_eq(visits, stored.len())
    for s in seen { assert_eq(s, 1) }
    assert_eq(m.keys().len(), stored.len())
    assert_eq(bad, 0)

    i = 0
    while i < stored.len() {
        if i % 2 == 0 {
            let old = m.remove(by_interp(stored.get(i).unwrap())) ?? -1
            if old != i + 1000000 { bad = bad + 1 }
        }
        i = i + 1
    }
    assert_eq(m.len(), stored.len() - (stored.len() + 1) / 2)
    i = 0
    while i < stored.len() {
        let k = stored.get(i).unwrap()
        for c in copies(k) {
            if i % 2 == 0 {
                if m.contains_key(c) || m.get(c).is_some() {
                    if bad < 10 { io.println("removed key still found: {show(c)}") }
                    bad = bad + 1
                }
            } else {
                let got = m.get(c) ?? -1
                if got != i + 1000000 {
                    if bad < 10 { io.println("kept key lost after removes: {show(c)}: {got}") }
                    bad = bad + 1
                }
            }
        }
        if i % 2 == 0 && m.remove(k).is_some() { bad = bad + 1 }
        i = i + 1
    }
    assert_eq(bad, 0)
}

test "a Str-keyed Set answers insert, contains, remove and iteration for keys of 0 to 40 bytes" {
    let (stored, probes) = stored_and_probes()
    let mut s: Set[Str] = Set()
    let mut bad = 0
    for k in stored {
        if !s.insert(k) { bad = bad + 1 }
    }
    assert_eq(s.len(), stored.len())
    for k in stored {
        for c in copies(k) {
            if !s.contains(c) {
                if bad < 10 { io.println("set lost {show(c)}") }
                bad = bad + 1
            }
            if s.insert(c) {
                if bad < 10 { io.println("set took a second copy of {show(c)}") }
                bad = bad + 1
            }
        }
    }
    assert_eq(s.len(), stored.len())
    for p in probes {
        let want = index_of(stored, p) >= 0
        for c in copies(p) {
            if s.contains(c) != want {
                if bad < 10 { io.println("set probe {show(c)}: want {want}") }
                bad = bad + 1
            }
        }
    }
    assert_eq(bad, 0)

    let mut visits = 0
    let mut seen: Set[Int] = Set()
    for k in s {
        let at = index_of(stored, k)
        if at < 0 { bad = bad + 1 } else { seen.insert(at) }
        visits = visits + 1
    }
    assert_eq(visits, stored.len())
    assert_eq(seen.len(), stored.len())

    let mut i = 0
    while i < stored.len() {
        let k = stored.get(i).unwrap()
        if i % 3 == 0 {
            if !s.remove(by_slice(k)) { bad = bad + 1 }
            if s.remove(by_concat(k)) { bad = bad + 1 }
        }
        i = i + 1
    }
    i = 0
    while i < stored.len() {
        if s.contains(by_interp(stored.get(i).unwrap())) != (i % 3 != 0) {
            if bad < 10 { io.println("after removes {show(stored.get(i).unwrap())}") }
            bad = bad + 1
        }
        i = i + 1
    }
    assert_eq(bad, 0)
}
