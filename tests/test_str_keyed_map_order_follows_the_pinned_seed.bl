// The seed contract (sections/06_tooling.md, --deterministic and BLINK_MAP_SEED) holds for
// Str keys as it does for Int keys: with BLINK_MAP_SEED pinned, two processes iterate a
// Map[Str, Int] and a Set[Str] in the same order, and a different seed gives a different
// order. The keys span short, word-sized and long lengths, so each path of the Str hash
// takes the seed. The test runs this binary again as a child with `probe`.

fn key_order() -> Str {
    let mut m: Map[Str, Int] = Map()
    let mut s: Set[Str] = Set()
    let mut i = 0
    while i < 40 {
        let k = "k{i}".concat("abcdefghijklmnopqrstuvwxyz0123456789".byte_slice(0, i))
        m.insert(k, i)
        s.insert(k)
        i = i + 1
    }
    let mut out = ""
    for (_, v) in m { out = out.concat("{v},") }
    out = out.concat("|")
    for k in s { out = out.concat("{k.byte_len()},") }
    out
}

fn main() {
    let args = env.args()
    if args.len() > 1 && args.get(1).unwrap() == "probe" { io.println(key_order()) }
}

fn child(seed: Str) -> Str {
    let self_path = env.args().get(0).unwrap()
    let r = process_run("sh", ["-c", "BLINK_MAP_SEED={seed} '{self_path}' probe"])
    if r.exit_code != 0 { io.println("child exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
    r.out
}

test "a pinned seed gives one Str key order across processes, and another seed another" {
    let a = child("12345")
    let b = child("12345")
    let c = child("99999")
    assert(a.len() > 40)
    assert_eq(a, b)
    assert_ne(a, c)
}
