// Str.len() counts codepoints and byte_len() counts UTF-8 bytes. The fixtures hold
// 1-, 2-, 3- and 4-byte characters, and each text comes from a different producer,
// so a producer that records the wrong count shows up as a wrong len().

test "len counts each multi-byte character once" {
    assert_eq("café".len(), 4)
    assert_eq("café".byte_len(), 5)
    assert_eq("a€b".len(), 3)
    assert_eq("a€b".byte_len(), 5)
    assert_eq("😀".len(), 1)
    assert_eq("😀".byte_len(), 4)
    assert_eq("".len(), 0)
}

test "is_empty agrees with len on non-ASCII text" {
    assert("é".is_empty() == false)
    assert("".is_empty())
}

test "len of text built at run time counts codepoints" {
    let e = "é"
    let joined = "caf{e}"
    assert_eq(joined.len(), 4)
    assert_eq("ab".concat("😀é").len(), 4)
    let sb = StringBuilder.new()
    sb.write("x")
    sb.write("€")
    sb.write("😀")
    assert_eq(sb.to_str().len(), 3)
    assert_eq("a€b😀c".byte_slice(1, 4).len(), 1)
    assert_eq("a€b😀c".substring(1, 4).len(), 3)
}

test "len of text decoded from bytes counts codepoints" {
    match Bytes.from_str("naïve😀").to_str() {
        Ok(s) => assert_eq(s.len(), 6)
        Err(_) => assert(false)
    }
}

test "len of the parts of a split counts codepoints" {
    let parts = "é,€€,😀😀😀".split(",")
    assert_eq(parts.len(), 3)
    assert_eq(parts.get(0).unwrap().len(), 1)
    assert_eq(parts.get(1).unwrap().len(), 2)
    assert_eq(parts.get(2).unwrap().len(), 3)
}
