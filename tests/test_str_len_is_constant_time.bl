// Str.len() must not rescan the string: a byte loop bounded by s.len() stays
// linear in the length. A rescan makes the 1 MiB loop below quadratic (about
// 5e11 byte reads), which no machine finishes inside the bound.

fn build_str(n: Int) -> Str {
    let sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write(if i % 7 == 0 { "x" } else { "a" })
        i = i + 1
    }
    sb.to_str()
}

// Each iteration reads a byte so the compiler cannot lift s.len() out of the loop
// as a value it has proven constant.
fn count_x(s: Str) -> Int {
    let mut i = 0
    let mut hits = 0
    while i < s.len() {
        if s.byte_at(i) == 120 {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

test "a byte loop bounded by len over 1 MiB runs in linear time" {
    let n = 1048576
    let s = build_str(n)
    assert_eq(s.len(), n)
    let start = time.read()
    let hits = count_x(s)
    let elapsed_ms = time.read().since(start).to_ms()
    assert_eq(hits, (n + 6) / 7)
    // Linear work takes a few ms; the bound leaves wide room for slow or loaded
    // machines and debug builds, and still rejects a quadratic rescan.
    assert(elapsed_ms < 2000)
}
