// Str.len() counts codepoints, but a loop bounded by s.len() must stay linear in
// the length when the text is not ASCII. A len() that rescans the text on each call
// makes the 1 MiB loop below quadratic (about 5e11 byte reads), which no machine
// finishes inside the bound. `blink test` builds with --debug, so this also holds
// the debug check of the recorded count to linear time.

fn build_str(n: Int) -> Str {
    let sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write(if i % 7 == 0 { "é" } else { "a" })
        i = i + 1
    }
    sb.to_str()
}

// Each iteration reads a byte so the compiler cannot lift s.len() out of the loop
// as a value it has proven constant. Every index below len() is also below
// byte_len(), so the read is in bounds.
fn count_lead_bytes(s: Str) -> Int {
    let mut i = 0
    let mut hits = 0
    while i < s.len() {
        if s.byte_at(i) == 195 {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

test "a loop bounded by len over 1 MiB of non-ASCII text runs in linear time" {
    let n = 1048576
    let s = build_str(n)
    assert_eq(s.len(), n)
    assert_eq(s.byte_len(), n + (n + 6) / 7)
    let start = time.read()
    let hits = count_lead_bytes(s)
    let elapsed_ms = time.read().since(start).to_ms()
    assert(hits > 0)
    // Linear work takes a few ms; the bound leaves wide room for slow or loaded
    // machines and debug builds, and still rejects a quadratic rescan.
    assert(elapsed_ms < 2000)
}
