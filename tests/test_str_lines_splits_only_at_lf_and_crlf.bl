// Str.lines() follows the line rules of io.read_line() (sections/03_types.md, "Line
// splitting"): it splits at `\n` and `\r\n`, a final terminator makes no empty last item,
// and a lone `\r` is part of the line.

test "a final terminator makes no empty last item" {
    assert_eq("a\nb\n".lines(), ["a", "b"])
}

test "a CRLF terminator is removed and a last line with no terminator is a line" {
    assert_eq("a\r\nb".lines(), ["a", "b"])
}

test "a lone newline is one blank line and the empty string has no lines" {
    assert_eq("\n".lines(), [""])
    let none: List[Str] = []
    assert_eq("".lines(), none)
}

test "blank lines in the middle are kept" {
    assert_eq("a\n\n\r\nb".lines(), ["a", "", "", "b"])
}

test "a carriage return not before a newline stays in the line" {
    assert_eq("a\rb\nc\r".lines(), ["a\rb", "c\r"])
    assert_eq("\r".lines(), ["\r"])
}
