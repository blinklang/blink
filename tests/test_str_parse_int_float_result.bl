import compile_test_helpers

// Str.parse_int and Str.parse_float return Result[_, ConversionError] (§3.2.1 *Parsing*).
// parse_int takes an optional `-` and ASCII digits, nothing else, and refuses a value
// outside Int. parse_float takes `-? DIGITS ('.' DIGITS)? ('e' '-'? DIGITS)?` plus NaN, inf
// and -inf, rounds to nearest with ties to even, and refuses finite text whose value
// overflows (§3.6 *Float Text Form*).

fn int_of(r: Result[Int, ConversionError]) -> Option[Int] {
    match r {
        Ok(v) => Some(v)
        Err(_) => None
    }
}

fn float_of(r: Result[Float, ConversionError]) -> Option[Float] {
    match r {
        Ok(v) => Some(v)
        Err(_) => None
    }
}

fn int_err(s: Str) -> Bool {
    match s.parse_int() {
        Ok(_) => false
        Err(e) => e.source_type == "Str" && e.target_type == "Int" && e.message.len() > 0
    }
}

fn float_err(s: Str) -> Bool {
    match s.parse_float() {
        Ok(_) => false
        Err(e) => e.source_type == "Str" && e.target_type == "Float" && e.message.len() > 0
    }
}

// `==` on Float is total (NaN == NaN), so only the sign of zero needs a check of its own.
fn same_float(a: Float, b: Float) -> Bool {
    if a == 0.0 && b == 0.0 { return (1.0 / a < 0.0) == (1.0 / b < 0.0) }
    a == b
}

fn parses_to(s: Str, want: Float) -> Bool {
    match s.parse_float() {
        Ok(v) => same_float(v, want)
        Err(_) => false
    }
}

fn min_subnormal() -> Float {
    let mut x = 1.0
    let mut i = 0
    while i < 1074 {
        x = x / 2.0
        i = i + 1
    }
    x
}

// 2^1024 - 2^971, built from its factors so no literal rounds it.
fn max_finite() -> Float {
    let mut x = 1.0
    let mut i = 0
    while i < 1023 {
        x = x * 2.0
        i = i + 1
    }
    let mut ulp = 1.0
    let mut j = 0
    while j < 52 {
        ulp = ulp / 2.0
        j = j + 1
    }
    x * (2.0 - ulp)
}

fn sum_ports(a: Str, b: Str) -> Result[Int, ConversionError] {
    let x = a.parse_int()?
    let y = b.parse_int()?
    Ok(x + y)
}

fn scaled(a: Str) -> Result[Float, ConversionError] {
    let x = a.parse_float()?
    Ok(x * 2.0)
}

test "parse_int accepts an optional minus and digits" {
    assert_eq(int_of("42".parse_int()), Some(42))
    assert_eq(int_of("-42".parse_int()), Some(-42))
    assert_eq(int_of("0".parse_int()), Some(0))
    assert_eq(int_of("-0".parse_int()), Some(0))
    assert_eq(int_of("007".parse_int()), Some(7))
    assert_eq(int_of("9223372036854775807".parse_int()), Some(9223372036854775807))
    let min = int_of("-9223372036854775808".parse_int())
    assert(min.is_some(), "Int.MIN parses")
    assert_eq(min.unwrap(), -9223372036854775807 - 1)
}

test "parse_int refuses every other spelling and values outside Int" {
    let bad = ["", "-", "+1", " 1", "1 ", "12x", "abc", "1.0", "1e3", "--1", "0x10", "1_000", "9223372036854775808", "-9223372036854775809", "99999999999999999999"]
    for s in bad {
        assert(int_err(s), "parse_int must refuse `{s}`")
    }
}

test "parse_float accepts the display grammar and the integer form" {
    assert(parses_to("42", 42.0), "42")
    assert(parses_to("-42", -42.0), "-42")
    assert(parses_to("3.14", 3.14), "3.14")
    assert(parses_to("-2.5", -2.5), "-2.5")
    assert(parses_to("1.5e3", 1500.0), "1.5e3")
    assert(parses_to("1e3", 1000.0), "1e3")
    assert(parses_to("25e-1", 2.5), "25e-1")
    assert(parses_to("0.0", 0.0), "0.0")
    assert(parses_to("-0.0", -0.0), "-0.0 keeps its sign")
    assert(parses_to("1.0e-400", 0.0), "underflow to zero is Ok")
}

test "parse_float refuses every other spelling and finite text that overflows" {
    let bad = ["", "-", "1E5", "1e+5", "+1", ".5", "1.", "-.5", " 1.0", "1.0 ", "Infinity", "-Infinity", "nan", "-NaN", "+inf", "INF", "1e999", "-1e999", "1.0e", "1.0e-", "1.5x", "0x1p3", "1,5", "e5", "1..2", "1e5.0"]
    for s in bad {
        assert(float_err(s), "parse_float must refuse `{s}`")
    }
}

test "parse_float reads NaN, inf and -inf" {
    let zero = 0.0
    assert(parses_to("NaN", zero / zero), "NaN")
    assert(!parses_to("NaN", 0.0), "NaN is not a number")
    assert(parses_to("inf", 1.0 / 0.0), "inf")
    assert(parses_to("-inf", -1.0 / 0.0), "-inf")
}

test "parse_float rounds the display text of each branch back to its value" {
    assert(parses_to("0.1", 0.1), "0.1")
    assert(parses_to("0.30000000000000004", 0.1 + 0.2), "0.1 + 0.2")
    assert(parses_to("0.3333333333333333", 1.0 / 3.0), "1/3")
    assert(parses_to("9007199254740992.0", 9007199254740992.0), "2^53")
    assert(parses_to("1.0e16", 10000000000000000.0), "1.0e16")
    assert(parses_to("1.0e-5", 0.00001), "1.0e-5")
    assert(parses_to("1.5e-7", 0.00000015), "1.5e-7")
    assert(parses_to("5.0e-324", min_subnormal()), "smallest subnormal")
    assert(parses_to("1.7976931348623157e308", max_finite()), "largest finite")
    assert(parses_to("-1.7976931348623157e308", 0.0 - max_finite()), "most negative finite")
}

test "parse_float rounds a halfway decimal to the even neighbour" {
    // 2^53 + 1 lies halfway between 2^53 and 2^53 + 2; ties go to the even 2^53.
    assert(parses_to("9007199254740993", 9007199254740992.0), "2^53 + 1 ties down")
    // 2^53 + 3 lies halfway between 2^53 + 2 and 2^53 + 4; ties go to the even 2^53 + 4.
    assert(parses_to("9007199254740995", 9007199254740996.0), "2^53 + 3 ties up")
}

test.failing(
    "display text parses back to the same Float for each display branch",
    reason: "Float.display renders with %g today, not the shortest round-trip form of §3.6 Float Text Form",
) {
    let zero = 0.0
    let xs = [0.0, -0.0, 0.1, 1.0 / 3.0, 10000000000000000.0, 0.00001, min_subnormal(), max_finite(), zero / zero, 1.0 / zero, -1.0 / zero]
    for x in xs {
        let back = float_of(x.display().parse_float())
        assert(back.is_some(), "`{x.display()}` parses")
        assert(back.unwrap() == x, "`{x.display()}` parses back to the same Float")
    }
}

test "? propagates a parse failure" {
    assert_eq(int_of(sum_ports("8000", "80")), Some(8080))
    assert(int_of(sum_ports("8000", "x")).is_none(), "? returns the Err")
    assert_eq(float_of(scaled("1.5")), Some(3.0))
    assert(float_of(scaled("1.5.")).is_none(), "? returns the Err")
}

fn coalesce_src() -> Str {
    #"import std.io

fn main() {
    let a = "30".parse_int() ?? 5
    let b = "thirty".parse_int() ?? 5
    let c = "2.5".parse_float() ?? 0.0
    let d = "two".parse_float() ?? 0.5
    io.println("{a} {b} {c} {d}")
}
"#
}

test.failing(
    "?? supplies a default for a parse that fails",
    reason: "sections/03_types.md *Parsing* writes `parse_int() ?? 30` on a Result, but ?? takes only an Option (§7.3), so typecheck refuses it with CoalesceRequiresOption",
) {
    let r = compile_test_helpers.compile_and_run(coalesce_src(), "_parse_result_coalesce")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "30 5 2.5 0.5\n")
}
