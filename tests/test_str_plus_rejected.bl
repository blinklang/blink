// E0521 -- '+' does not work on Str. The spec (sections/02_syntax.md:1101-1112,
// vote 5-0) is explicit: use interpolation or .concat() to join strings. '+' on
// Str is rejected whenever EITHER operand is Str -- including Str + Str -- because
// it encourages O(n^2) loops and creates ambiguity with numeric '+'.

import compile_test_helpers

fn main() {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()

    let base = "{compile_test_helpers.scratch_root()}/_test_str_plus_rejected"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()
    fs.write("{base}/blink.toml", "[package]\nname = \"spr\"\nversion = \"0.1.0\"\n\n[dependencies]\n").unwrap()

    // Each case is a program body that must be rejected with E0521.
    let cases = [
        "let a: Str = \"x\"\n    let _c = a + 1",
        "let _c = \"x\" + 1",
        "let _c = 1 + \"x\"",
        "let a: Str = \"x\"\n    let b: Str = \"y\"\n    let _c = a + b",
    ]
    let mut ci = 0
    while ci < cases.len() {
        let body = cases.get(ci).unwrap()
        let src = "fn main() \{\n    {body}\n    io.println(\"unreachable\")\n\}\n"
        fs.write("{base}/case_{ci}.bl", src).unwrap()

        let cmd = "cd {base} && {blink_root}/build/blink check case_{ci}.bl 2>&1"
        let result = process.run("sh", ["-c", cmd]).unwrap()

        if result.success() {
            io.println("FAIL: case {ci} should be rejected, but check exited 0")
            process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
            return
        }
        if !result.out.contains("E0521") && !result.out.contains("StrPlusUnsupported") {
            io.println("FAIL: case {ci} did not emit E0521 / StrPlusUnsupported")
            io.println("got: {result.out}")
            process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
            return
        }
        ci = ci + 1
    }

    // Positive guard: .concat() is the supported idiom and must still compile + run.
    let ok_src = "fn main() \{\n    let a: Str = \"x\"\n    let b: Str = \"y\"\n    io.println(a.concat(b))\n\}\n"
    fs.write("{base}/ok.bl", ok_src).unwrap()
    let ok_cmd = "cd {base} && {blink_root}/build/blink run ok.bl 2>&1"
    let ok_result = process.run("sh", ["-c", ok_cmd]).unwrap()
    if !ok_result.success() {
        io.println("FAIL: a.concat(b) should compile + run, ended with {ok_result.end}")
        io.println("got: {ok_result.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    if !ok_result.out.contains("xy") {
        io.println("FAIL: a.concat(b) should print 'xy'")
        io.println("got: {ok_result.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    io.println("PASS: E0521 rejects Str + <anything>; .concat() still works")
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
