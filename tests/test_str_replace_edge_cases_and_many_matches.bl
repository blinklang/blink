// str_replace output on edge cases, and linear time over many matches: a
// rescan of the remaining input at each match makes the large case quadratic.

test "replace swaps every non-overlapping occurrence" {
    assert_eq("a,b,c".replace(",", ";;"), "a;;b;;c")
    assert_eq("xyz".replace("y", ""), "xz")
}

test "replace with an empty needle returns the input" {
    assert_eq("abc".replace("", "-"), "abc")
    assert_eq("".replace("", "-"), "")
}

test "replace scans left to right without overlap" {
    assert_eq("aaa".replace("aa", "b"), "ba")
    assert_eq("aaaa".replace("aa", "b"), "bb")
    assert_eq("abababa".replace("aba", "X"), "XbX")
}

test "replace handles a match at the start and at the end" {
    assert_eq("ab-cd".replace("ab", "1"), "1-cd")
    assert_eq("ab-cd".replace("cd", "2"), "ab-2")
    assert_eq("abab".replace("ab", "Z"), "ZZ")
}

test "replace with no match returns the input" {
    assert_eq("hello".replace("z", "q"), "hello")
    assert_eq("".replace("a", "b"), "")
    assert_eq("ab".replace("abc", "x"), "ab")
}

test "replace does not rescan its own replacement" {
    assert_eq("aa".replace("a", "aa"), "aaaa")
}

test "replace works on multi-byte text" {
    assert_eq("héllo é".replace("é", "e"), "hello e")
    assert_eq("a😀b😀".replace("😀", "::"), "a::b::")
    assert_eq("abc".replace("b", "éé"), "aééc")
}

fn repeat_str(s: Str, n: Int) -> Str {
    let sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write(s)
        i = i + 1
    }
    sb.to_str()
}

test "replace over 400000 matches runs in linear time" {
    let n = 400000
    let s = repeat_str("ab,", n)
    let start = time.read()
    let r = s.replace(",", ";;")
    let elapsed_ms = time.read().since(start).to_ms()
    assert_eq(r.len(), n * 4)
    assert_eq(r.substring(0, 8), "ab;;ab;;")
    assert_eq(r.substring(n * 4 - 4, 4), "ab;;")
    // Linear work takes tens of ms; a per-match rescan takes about 10 s.
    assert(elapsed_ms < 3000)
}
