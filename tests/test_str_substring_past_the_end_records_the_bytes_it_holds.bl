// substring(start, end) with a start or an end that runs past the end holds only the
// text the source has from start on. Its recorded length must count those bytes, not the
// range it was asked for, or .len() is wrong, == fails against the same text, and a Map
// lookup with it misses. The byte count from Bytes reads to the terminator and so does
// not trust the recorded length.

fn expect_text(got: Str, want: Str) {
    assert_eq(got.byte_len(), want.byte_len())
    assert_eq(Bytes.from_str(got).len(), want.byte_len())
    assert(got == want, "substring result differs from the expected text")
}

test "a count past the end keeps the rest of the source" {
    let s = "--verbose"
    expect_text(s.substring(2, s.len()), "verbose")
    expect_text(s.substring(0, 100), "--verbose")
    expect_text("abc".substring(1, 3), "bc")
}

test "a start at or past the end gives the empty Str" {
    expect_text("abc".substring(3, 2), "")
    expect_text("abc".substring(5, 2), "")
    expect_text("".substring(0, 4), "")
}

test "a negative count gives the empty Str" {
    expect_text("abc".substring(1, -1), "")
}

test "an in-range substring is unchanged" {
    expect_text("hello world".substring(6, 11), "world")
    expect_text("hello".substring(0, 0), "")
    expect_text("hello".substring(0, 5), "hello")
}

test "an end past the end of multi-byte text keeps the rest of its bytes" {
    expect_text("héllo".substring(1, 100), "éllo")
    expect_text("a😀".substring(1, 9), "😀")
}

test "a past-the-end substring finds its Map key" {
    let mut m: Map[Str, Int] = Map()
    m.insert("verbose", 1)
    let flag = "--verbose"
    assert_eq(m.get(flag.substring(2, flag.len())), Some(1))
}
