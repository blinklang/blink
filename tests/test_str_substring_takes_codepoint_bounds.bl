// substring(start, end) takes codepoint bounds over the half-open range [start, end)
// and clamps them. Each fixture puts a multi-byte character before or inside the
// range, so a byte bound cuts a character in two or lands on the wrong one.

test "substring counts a multi-byte character as one position" {
    let s = "café"
    assert_eq(s.substring(0, 4), "café")
    assert_eq(s.substring(3, 4), "é")
    assert_eq(s.substring(2, 4), "fé")
    assert_eq(s.substring(0, 3), "caf")
}

test "substring after multi-byte characters starts at the right codepoint" {
    let s = "é€😀abc"
    assert_eq(s.substring(3, 6), "abc")
    assert_eq(s.substring(1, 3), "€😀")
    assert_eq(s.substring(2, 4), "😀a")
}

test "substring clamps to the codepoint length, not the byte length" {
    let s = "é€😀"
    assert_eq(s.substring(0, 3), "é€😀")
    assert_eq(s.substring(0, 99), "é€😀")
    assert_eq(s.substring(2, 9), "😀")
    assert_eq(s.substring(3, 9), "")
    assert_eq(s.substring(-5, 1), "é")
    assert_eq(s.substring(2, 1), "")
}

test "adjacent substrings join back to the whole text" {
    let s = "naïve😀café"
    let n = s.len()
    let mut b = 0
    while b <= n {
        assert_eq(s.substring(0, b).concat(s.substring(b, n)), s)
        b = b + 1
    }
}

test "a substring records its own codepoint and byte counts" {
    let t = "x😀yé".substring(1, 4)
    assert_eq(t, "😀yé")
    assert_eq(t.len(), 3)
    assert_eq(t.byte_len(), 7)
}
