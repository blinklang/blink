test "lines returns list" {
    let result: List[Str] = "a\nb\nc".lines()
    assert_eq(result.len(), 3)
}

test "parse_float returns a Result of Float" {
    let r: Result[Float, ConversionError] = "3.14".parse_float()
    assert(r.unwrap() > 3.0)
}

test "parse_int returns a Result of Int" {
    let r: Result[Int, ConversionError] = "42".parse_int()
    assert_eq(r.unwrap(), 42)
}

test "is_empty returns bool" {
    let b: Bool = "".is_empty()
    assert(b)
}
