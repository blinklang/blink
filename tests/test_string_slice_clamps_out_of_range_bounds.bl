// Str.slice(start, end) takes byte offsets and clamps them: a negative start reads from
// 0, an end past the string reads to its end, and a range that is empty after clamping
// gives "".

test "an in-range slice gives the bytes between the bounds" {
    assert_eq("hello".slice(0, 5), "hello")
    assert_eq("hello".slice(1, 4), "ell")
    assert_eq("hello".slice(4, 5), "o")
}

test "an empty range gives the empty string" {
    assert_eq("hello".slice(0, 0), "")
    assert_eq("hello".slice(5, 5), "")
    assert_eq("hello".slice(3, 1), "")
}

test "a negative start is clamped to zero" {
    assert_eq("hello".slice(-2, 2), "he")
    assert_eq("hello".slice(-9, 99), "hello")
}

test "an end past the string is clamped to its length" {
    assert_eq("hello".slice(2, 99), "llo")
    assert_eq("hello".slice(0, 6), "hello")
}

test "a start at or past the end gives the empty string" {
    assert_eq("hello".slice(5, 9), "")
    assert_eq("hello".slice(7, 9), "")
    assert_eq("hello".slice(7, 3), "")
}

test "a negative end gives the empty string" {
    assert_eq("hello".slice(1, -1), "")
    assert_eq("hello".slice(-5, -1), "")
    assert_eq("hello".slice(0, -1), "")
}

test "slicing the empty string gives the empty string" {
    assert_eq("".slice(0, 0), "")
    assert_eq("".slice(0, 3), "")
    assert_eq("".slice(-1, 1), "")
}

test "offsets count bytes, not characters" {
    assert_eq("héllo".slice(1, 3), "é")
    assert_eq("héllo".slice(3, 6), "llo")
    assert_eq("héllo".len(), 6)
}

test "a slice near the start of a long string reads only its range" {
    let sb = StringBuilder.new()
    let mut i = 0
    while i < 100000 {
        sb.write("abcdefghij")
        i = i + 1
    }
    let s = sb.to_str()
    assert_eq(s.slice(0, 3), "abc")
    assert_eq(s.slice(999995, 1000005), "fghij")
    assert_eq(s.slice(999998, 2000000), "ij")
}
