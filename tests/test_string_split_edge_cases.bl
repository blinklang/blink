// Str.split at the edges: empty input, delimiters at either end or next to each other, a
// delimiter longer than one byte or than the input, UTF-8 text, and a long input whose
// pieces must come out in order and complete.

fn check_parts(got: List[Str], want: List[Str]) {
    assert_eq(got.len(), want.len())
    let mut i = 0
    while i < want.len() {
        assert_eq(got.get(i).unwrap(), want.get(i).unwrap())
        i = i + 1
    }
}

test "splitting the empty string gives one empty piece" {
    check_parts("".split(","), [""])
}

test "a delimiter at the start or end gives an empty piece there" {
    check_parts(",a".split(","), ["", "a"])
    check_parts("a,".split(","), ["a", ""])
    check_parts(",a,".split(","), ["", "a", ""])
}

test "a string that is only the delimiter gives two empty pieces" {
    check_parts(",".split(","), ["", ""])
    check_parts("abc".split("abc"), ["", ""])
}

test "adjacent delimiters give empty pieces between them" {
    check_parts("a,,,b".split(","), ["a", "", "", "b"])
    check_parts(",,".split(","), ["", "", ""])
}

test "a multi-byte delimiter splits on the whole delimiter" {
    check_parts("a::b::c".split("::"), ["a", "b", "c"])
    check_parts("a:b::c".split("::"), ["a:b", "c"])
    check_parts("::a::".split("::"), ["", "a", ""])
}

test "matches do not overlap and are taken left to right" {
    check_parts("aaa".split("aa"), ["", "a"])
    check_parts("aaaa".split("aa"), ["", "", ""])
}

test "a delimiter that is not found gives the whole string" {
    check_parts("abc".split(","), ["abc"])
    check_parts("ab".split("abc"), ["ab"])
}

test "an empty delimiter gives the whole string" {
    check_parts("a,b".split(""), ["a,b"])
    check_parts("".split(""), [""])
}

test "UTF-8 text and a UTF-8 delimiter split on bytes without breaking characters" {
    check_parts("héllo wörld".split(" "), ["héllo", "wörld"])
    check_parts("a→b→→c".split("→"), ["a", "b", "", "c"])
    check_parts("日本語".split("本"), ["日", "語"])
}

test "a long input splits into every piece in order" {
    let n = 20000
    let sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write("item")
        sb.write("{i}")
        sb.write(",")
        i = i + 1
    }
    let parts = sb.to_str().split(",")
    assert_eq(parts.len(), n + 1)
    assert_eq(parts.get(0).unwrap(), "item0")
    assert_eq(parts.get(12345).unwrap(), "item12345")
    assert_eq(parts.get(n - 1).unwrap(), "item19999")
    assert_eq(parts.get(n).unwrap(), "")
    let mut j = 0
    while j < n {
        assert_eq(parts.get(j).unwrap(), "item{j}")
        j = j + 1
    }
}
