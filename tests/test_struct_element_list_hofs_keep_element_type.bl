// Iterator-style HOFs (.take/.map/.filter) over a List of a STRUCT element
// must keep the struct element type through the whole chain, not erase it
// to void.

type Point { x: Int, y: Int }

test "take over a struct-element list keeps the struct type" {
    let pts: List[Point] = [Point { x: 1, y: 2 }]
    let e = pts.take(5)
    assert_eq(e.len(), 1)
    assert_eq(e.get(0).unwrap().x, 1)
}

test "map/filter over a struct-element list keep the struct type" {
    let pts: List[Point] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let xs = pts.map(fn(p: Point) -> Int { p.x })
    assert_eq(xs.get(0).unwrap(), 1)
    assert_eq(xs.get(1).unwrap(), 3)
    let filtered = pts.filter(fn(p: Point) -> Bool { p.x > 2 })
    assert_eq(filtered.len(), 1)
    assert_eq(filtered.get(0).unwrap().x, 3)
}
