// Bug e4eymz: matching a struct-style enum variant written BARE (no `Type.` prefix)
// emitted C that read fields off the scrutinee union directly instead of through
// `.data.<variant>.<field>`. Tuple-style variants and `Type.Variant { .. }` worked.

type DbError {
    ConnectionError(msg: Str)
    QueryError { sqlstate: Str, message: Str, detail: Int }
    Closed
}

fn describe(e: DbError) -> Str {
    match e {
        ConnectionError(m) => "conn:{m}"
        QueryError { sqlstate, message, detail } => "query:{sqlstate}:{message}:{detail}"
        Closed => "closed"
    }
}

fn summary(e: DbError) -> Str {
    match e {
        QueryError { sqlstate, .. } => "rest:{sqlstate}"
        _ => "other"
    }
}

test "bare struct-style variant binds fields through data path" {
    let e = DbError.QueryError { sqlstate: "42P01", message: "boom", detail: 7 }
    assert_eq(describe(e), "query:42P01:boom:7")
}

test "bare tuple-style variant still works" {
    let e = DbError.ConnectionError("refused")
    assert_eq(describe(e), "conn:refused")
}

test "bare unit variant still works" {
    let e = DbError.Closed
    assert_eq(describe(e), "closed")
}

test "bare struct-style variant with rest pattern" {
    let e = DbError.QueryError { sqlstate: "23505", message: "dup", detail: 1 }
    assert_eq(summary(e), "rest:23505")
}

test "rest pattern non-match falls through" {
    let e = DbError.ConnectionError("x")
    assert_eq(summary(e), "other")
}
