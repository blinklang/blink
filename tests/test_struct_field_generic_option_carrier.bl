// A struct FIELD of type List[Option[<generic-struct instance>]] emitted the
// element Option carrier's typedef with a `void* value` field instead of
// `blink_<mono>* value`: the field carrier-typedef dependency emission could not
// resolve the mono-mangled generic-instance name (Box_0Int) back to its struct,
// and first-writer-wins (the BLINK_TD guard) locked the void* form before the
// correct construction/accessor site could emit it. The `.unwrap()` consumer
// then dereferenced a `void*` -> cc "invalid initializer".
//
// A NON-generic struct inner (List[Option[Point]]) already worked, and a bare
// local List[Option[Box[Int]]] with no struct field already worked; only the
// generic-instance inner UNDER A STRUCT FIELD erased to void*.

type Box[T] {
    val: T
}

type GHolder {
    rows: List[Option[Box[Int]]]
}

fn get_field_bound() -> Int {
    let h = GHolder { rows: [Some(Box { val: 3 })] }
    h.rows.get(0).unwrap().unwrap().val
}

fn get_local_with_field_decl() -> Int {
    let xs: List[Option[Box[Int]]] = [Some(Box { val: 5 })]
    xs.get(0).unwrap().unwrap().val
}

fn find_field_bound() -> Int {
    let h = GHolder { rows: [Some(Box { val: 8 })] }
    h.rows.find(fn(e: Option[Box[Int]]) -> Bool { e.is_some() }).unwrap().unwrap().val
}

test "struct field List[Option[generic]] survives field-bound get" {
    assert_eq(get_field_bound(), 3)
}

test "struct field decl does not poison a local List[Option[generic]] get" {
    assert_eq(get_local_with_field_decl(), 5)
}

test "struct field List[Option[generic]] survives find" {
    assert_eq(find_field_bound(), 8)
}
