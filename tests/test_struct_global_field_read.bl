// A field read on a module-level `let` bound to a struct instance (plain or
// generic) must read the actual field, not fall back to a placeholder value.

type Box[T] { v: T }
let gbox: Box[Int] = Box { v: 7 }

type Plain { v: Int }
let gp: Plain = Plain { v: 5 }

test "generic struct module-level let field read" {
    assert_eq(gbox.v, 7)
}

test "plain struct module-level let field read" {
    assert_eq(gp.v, 5)
}
