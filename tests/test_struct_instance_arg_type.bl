// br qw7v90 (increment B) + 2bh76q (increment A) of the codegen-structured-tids
// epic (decisions/compiler-type-representation.md Q2, 5-0). Together these make a
// generic struct instantiation carry its CONCRETE type-args as a structured tid
// (Box[Int] as a TK_STRUCT entry with params=[Int]) on BOTH the annotation side
// (resolve_type_ann live return) and the literal side (infer_type of a StructLit,
// reverse-inferred from the field values). A (types_compatible) then compares two
// struct tids by name + params instead of raw tid identity.
//
// POSITIVE guards for the cases that codegen's string-mono path already handles.
// The soundness FIX (rejecting a mistyped generic-struct argument) is proven by
// test_qw7v90_struct_instance_mistype_rejected.
//
// NOT here (pre-existing codegen bug the tid change EXPOSES but does not own,
// filed as br wme0hh, blocked by the epic 4y09cs — codegen's string-mono lowering
// of a generic struct passed BY VALUE to a function is wrong, not typecheck;
// parked MVCEs live in .tmp/wme0hh/): passing Box[T] to a fn expecting Box[Int] /
// Box[Str] emits a bare `blink_Box` param type; two-param Pair args and nested
// Box[Box[Int]] erase their inner types. These are the exact "two type universes"
// failures the epic's reader-switch (increments C/D) fixes by having codegen read
// the structured instance tid. This file's guards therefore stay OFF the
// by-value-argument path (construction + field access + annotated let only), all
// of which the current string-mono path handles correctly.

type Box[T] {
    value: T
}

test "annotated Box[Int] instance type-checks and round-trips its field" {
    let b: Box[Int] = Box { value: 7 }
    assert_eq(b.value, 7)
}

test "annotated Box[Str] instance stays on the Str path" {
    let b: Box[Str] = Box { value: "hi" }
    assert_eq(b.value, "hi")
}

test "empty-Map field falls back to bare (no bind, no spurious error)" {
    let b: Box[Map[Str, Int]] = Box { value: Map() }
    assert_eq(b.value.len(), 0)
}

test "empty-Set field falls back cleanly" {
    let b: Box[Set[Int]] = Box { value: Set() }
    assert_eq(b.value.len(), 0)
}
