// Bug kvn6w8 (foundation spike): a generic struct has exactly ONE tid today
// regardless of instantiation, so Box[Int] and Box[Str] share a tid and a
// generic field `v: T` is stored as a permanent TK_TYPEVAR. The concrete inner
// (Int for Box[Int]) lives only in codegen's string-CSV mono registry, never in
// typecheck's tid pool — the "two type universes" split decisions/
// compiler-type-representation.md Q2 (5-0) exists to close.
//
// The spike lands the additive representation only: a make_struct_instance_type
// constructor (TK_STRUCT entry named "Box", params=[tid(Int)]) plus an OFF-PATH
// producer at resolve_type_ann that memoizes the instance tid onto the
// annotation node's tc_node_tid slot, plus read-only accessors
// (tc_tid_struct_arg_count / _arg_ct / _arg_struct). No emit reader is switched,
// so the change is byte-identical (Gen1==Gen2 holds; mono symbols unchanged).
//
// This test is the USER-FACING regression guard, NOT the spike's internal
// verification (that is a throwaway --blink-trace probe, per the plan). It
// locks the runtime behavior the later reader-switch increments must preserve:
// distinct instantiations of a generic struct round-trip their own field values,
// and the Str path is undisturbed. Green now (works via the string path); stays
// green as readers move to the structured tid.

import compile_test_helpers

type Box[T] {
    value: T
}

type Pair[A, B] {
    first: A
    second: B
}

fn unbox[T](b: Box[T]) -> T {
    b.value
}

test "distinct Box[Int] and Box[Str] round-trip their own field values" {
    let bi: Box[Int] = Box { value: 42 }
    let bs: Box[Str] = Box { value: "boxed" }
    assert_eq(bi.value, 42)
    assert_eq(bs.value, "boxed")
}

test "concrete-annotated Box[Int] flows through a generic fn" {
    let bi: Box[Int] = Box { value: 7 }
    assert_eq(unbox(bi), 7)
}

test "concrete-annotated Box[Str] control stays on the Str path" {
    let bs: Box[Str] = Box { value: "wrapped" }
    io.println(unbox(bs))
    assert_eq(bs.value, "wrapped")
}

test "two-param Pair[Int, Str] keeps each field's own type" {
    let p: Pair[Int, Str] = Pair { first: 5, second: "five" }
    assert_eq(p.first, 5)
    assert_eq(p.second, "five")
}

test "Pair[Str, Int] with swapped args keeps distinct field types" {
    let p: Pair[Str, Int] = Pair { first: "count", second: 99 }
    assert_eq(p.second, 99)
    io.println(p.first)
}

// ── INVERTED by br f8t5wb ──────────────────────────────────────────────────
//
// AUDIT TRAIL — what these two rows used to assert, verbatim, and why it was wrong:
//
//   "Regression guard (code-review finding): the off-path instance-tid producer
//    re-resolves a struct's type-args, and resolve_type_ann's Map/Set branches emit
//    non-deduped hashability diagnostics. A struct type-arg that transitively holds a
//    non-hashable Map key / Set element (Float) must NOT be rejected — the live
//    struct path never validated those args, so re-resolving them off-path must stay
//    silent (tc_suppress_ann_validation). This compiles iff the suppression holds; a
//    spurious MapKeyNotHashable would fail the build. The Map is never populated with
//    a Float key, so there is no real hashability hazard at runtime."
//
// The first half of that is still exactly right and is still what these rows guard: the
// off-path re-resolution must not emit a diagnostic of its own, and it still doesn't —
// tc_suppress_ann_validation is untouched. What was wrong is the conclusion drawn from
// "the live struct path never validated those args": that was an enforcement GAP, not a
// decision. `let m: Map[Float, Int] = Map()` is rejected outright by validate_map_key, so
// the same illegal key reached through a struct type-arg being accepted made
// MapKeyNotHashable depend on how the type was spelled. br f8t5wb closes it by validating
// on the LIVE path (each annotation visited exactly once), which is why these rows can
// invert without un-suppressing the off-path pass.
//
// "No real hashability hazard at runtime" was also only true by luck. Codegen has no kops
// vtable for a Float key: once any tier pinned the slot, kops_table_name fell through to
// BLINK_COMPILER_BUG_kops_unsupported_K_ct1_Float — an invalid C identifier — and before it
// got pinned the erased default emitted blink_kops_str, a Float hashed through the STRING
// vtable (the br hnyqe4 shape). These rows only ever passed because they never populate the
// container, which is precisely what made the hazard invisible here.
//
// Now capture-based rather than constructed: the programs no longer compile, which IS the
// assertion. The exhaustive row set (nested, multi-param, enum, typevar controls, and the
// once-per-site counts) lives in tests/test_f8t5wb_struct_typearg_hashability.bl; these two
// stay here because this is the fixture whose off-path producer created the question.

fn src_box_map_float() -> Str {
    let mut s = "type Box[T] \{ value: T }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let x: Box[Map[Float, Int]] = Box \{ value: Map() }\n")
    s = s.concat("    assert(x.value.len() == 0)\n")
    s = s.concat("}\n")
    s
}

fn src_box_set_float() -> Str {
    let mut s = "type Box[T] \{ value: T }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let y: Box[Set[Float]] = Box \{ value: Set() }\n")
    s = s.concat("    assert(y.value.len() == 0)\n")
    s = s.concat("}\n")
    s
}

test "struct type-arg holding Map[Float,_] is rejected, like the bare Map[Float,_]" {
    let out = compile_test_helpers.compile_and_capture(src_box_map_float(), "kvn6w8_mapfloat")
    assert(out.contains("MapKeyNotHashable"))
    // The off-path producer must still stay silent: one site, one diagnostic. Note this
    // checks the DIAGNOSTIC only — compile_and_capture discards the emitted C — so it is a
    // sentinel-leak tripwire, not emitted-C coverage. The program no longer reaches codegen,
    // so there is no emitted C to assert on and none is needed.
    assert(!out.contains("BLINK_COMPILER_BUG_kops_unsupported"))
}

test "struct type-arg holding Set[Float] is rejected, like the bare Set[Float]" {
    let out = compile_test_helpers.compile_and_capture(src_box_set_float(), "kvn6w8_setfloat")
    assert(out.contains("MapKeyNotHashable"))
    assert(out.contains("Set element type"))
    // Diagnostic-only, as above.
    assert(!out.contains("BLINK_COMPILER_BUG_kops_unsupported"))
}
