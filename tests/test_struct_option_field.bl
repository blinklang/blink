// Regression test for w1gv8f: struct fields and struct-style enum variant
// payload fields typed Option[T] were emitted as `void <field>;` in the
// generated C typedef, causing "variable or field declared void" errors.

type User {
    name: Str
    password: Option[Str]
    age: Option[Int]
}

type Event {
    Login { who: Str, token: Option[Str] }
    Logout(who: Str)
}

fn none_str() -> Option[Str] {
    None
}

fn none_int() -> Option[Int] {
    None
}

test "struct Option[Str] and Option[Int] fields hold Some" {
    let u = User { name: "alice", password: Some("hunter2"), age: Some(30) }
    assert_eq(u.name, "alice")
    assert(u.password.is_some())
    assert_eq(u.password.unwrap(), "hunter2")
    assert(u.age.is_some())
    assert_eq(u.age.unwrap(), 30)
}

test "struct Option fields hold None" {
    let u = User { name: "bob", password: none_str(), age: none_int() }
    assert(u.password.is_none())
    assert(u.age.is_none())
}

test "struct-style enum variant with Some Option payload field" {
    let e = Event.Login { who: "carol", token: Some("abc") }
    match e {
        Event.Login { who, token } => {
            assert_eq(who, "carol")
            assert(token.is_some())
            assert_eq(token.unwrap(), "abc")
        }
        Event.Logout(_) => assert(false)
    }
}

test "struct-style enum variant with None Option payload field" {
    let e = Event.Login { who: "dave", token: none_str() }
    match e {
        Event.Login { who, token } => {
            assert_eq(who, "dave")
            assert(token.is_none())
        }
        Event.Logout(_) => assert(false)
    }
}
