// A struct-pattern shorthand field binder (`SPt { xs }`) keeps the element
// type of a List[Str] field, so reading through the binder decodes elements
// as Str, not as a garbage Int.

type SPt { xs: List[Str] }

test "struct-pattern shorthand binder keeps List[Str] element type" {
    let p = SPt { xs: ["a", "b"] }
    match p {
        SPt { xs } => {
            assert_eq(xs.len(), 2)
            assert_eq(xs.get(0).unwrap(), "a")
        }
    }
}
