// jctkac: a plain struct or concrete generic-struct-instance return spells its C
// type from the return-annotation tid (c_type_from_tid), not the flat
// ann_mono_stem/ret_str carrier. Two emit sites route these returns through the
// carrier branch: emit_fn_decl (sig_ret_decl_carrier) and emit_fn_def
// (sig_ret_def_carrier). Each formerly spelled the return with
// c_type_c_name(ann_mono_stem-or-ret_str); the tid channel spells the same name
// (a `-> Box[Int]` return spells blink_Box_Int, not the erased bare blink_Box),
// so the read now moves to the tid directly.
//
// The functions below are the coverage: a plain struct return (Pt), two
// generic-struct-instance returns (Box[Int], Pair[Int,Str]), and a nested
// generic-instance return (Box[Pair[Int,Str]]). Each body reads a concrete field
// back through the returned value, so a wrong or empty return spelling would fail
// to compile or read the wrong field. Enum returns route through the separate
// enum branch (sig_ret_decl_enum) and are not part of this carrier-branch pin.
// The carrier-branch flat spelling and the tid spelling were byte-identical
// across the whole corpus (sig_ret_*_carrier: 2336 agrees, 0 diverge, 0 missing),
// so these rows are a characterization pin plus a regression guard against a
// future tid-decline at a struct-return position.

type Pt { x: Int, y: Int }
type Box[T] { val: T }
type Pair[A, B] { a: A, b: B }

fn plain_struct() -> Pt { Pt { x: 1, y: 2 } }
fn box_int() -> Box[Int] { Box { val: 7 } }
fn pair_int_str() -> Pair[Int, Str] { Pair { a: 3, b: "hi" } }
fn nested_box_pair() -> Box[Pair[Int, Str]] { Box { val: Pair { a: 9, b: "z" } } }

test "plain struct return carries its fields" {
    let p = plain_struct()
    assert(p.x == 1)
    assert(p.y == 2)
}

test "generic struct instance Box[Int] return carries its value" {
    let b = box_int()
    assert(b.val == 7)
}

test "generic struct instance Pair[Int,Str] return carries both fields" {
    let pr = pair_int_str()
    assert(pr.a == 3)
    assert(pr.b == "hi")
}

test "nested generic struct instance Box[Pair[Int,Str]] return round-trips" {
    let nb = nested_box_pair()
    assert(nb.val.a == 9)
    assert(nb.val.b == "z")
}
