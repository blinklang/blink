// A generic trait method whose body is a match with an explicit return in
// every arm, over a struct-typed generic parameter, must not synthesize a
// mismatched fall-through return after the match.

type Box[T] { v: T }

trait Firsty[T] { fn first_or(self, d: T) -> T }

impl[T] Firsty[T] for List[T] {
    fn first_or(self, d: T) -> T {
        match self.get(0) {
            Some(v) => return v
            None => return d
        }
    }
}

test "match with explicit return in every arm, Some branch" {
    let a: List[Box[Int]] = [Box { v: 7 }]
    assert_eq(a.first_or(Box { v: 0 }).v, 7)
}

test "match with explicit return in every arm, None branch" {
    let empty: List[Box[Int]] = []
    assert_eq(empty.first_or(Box { v: 42 }).v, 42)
}
