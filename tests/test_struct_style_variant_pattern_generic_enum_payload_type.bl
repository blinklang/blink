// Destructuring a struct-style variant of a generic enum must bind the payload field at
// the scrutinee instance's substituted concrete type, not the bare declared typevar.

type Choice[T] { First { value: T }, Second { tag: Int } }

test "struct-style variant pattern binds the substituted concrete payload type" {
    let c = First { value: 7 }
    match c {
        First { value } => assert_eq(value, 7)
        Second { tag: _tag } => assert(false)
    }
}
