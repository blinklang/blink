// A struct-style enum-variant field declared Void, destructured by name in a
// match pattern, must spell a real (zero-value) C slot for the binder, not a
// `void`-typed local.

import compile_test_helpers.{compile_and_run}

test.failing(
    "struct-style variant Void field binder compiles and reads the sibling field",
    reason: "the match-binder spelling for a Void struct-variant field does not apply the Void-to-int64_t storage rule that every other field-declaration site uses, so it declares an illegal `void x = ...` local",
    ticket: "5jm9c4",
) {
    let src = #"
import std.io

type E { V { x: Void, y: Int } }

fn main() ! IO {
    let e = E.V { x: (), y: 5 }
    match e {
        E.V { x, y } => io.println("y {y}")
    }
}
"#
    let r = compile_and_run(src, "_struct_variant_void_field_binder")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "y 5\n")
}
