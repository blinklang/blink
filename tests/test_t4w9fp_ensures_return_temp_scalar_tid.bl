// br t4w9fp — the return temps that emit_return_with_trace synthesizes for an @ensures fn
// (__ens_rv_) and a traced fn (__trace_rv_) now spell their C type from the tid of the return
// VALUE expression, not the return annotation (which carries no published tid). The value node is
// threaded in from every caller; c_type_from_tid leads and the flat c_type_str(ret_type) is kept
// only where the tid declines or is void.
//
// For a scalar return type the tid AGREES with the flat spelling, so the flip is byte-identical —
// this pins that the tid-authoritative path keeps spelling each scalar return temp with its correct
// C type. (A struct/enum/carrier return through this temp is left on the flat path by design, per
// the flat-vs-carrier licence; that residual void miscompile is tracked separately.)

import compile_test_helpers
import std.io

fn ens_scalar_src() -> Str {
    #"import std.io

@ensures(result >= 0)
fn clamp(x: Int) -> Int {
    if x < 0 { return 0 }
    return x
}

@ensures(result >= 0.0)
fn mag(x: Float) -> Float {
    return x
}

fn main() {
    io.println("{clamp(-5)} {mag(2.5)}")
}
"#
}

test "scalar @ensures return temp spells int64_t from the tid" {
    let c = compile_test_helpers.compile_and_emit_c(ens_scalar_src(), "t4w9fp_emit")
    if !c.contains("int64_t __ens_rv_") {
        io.println("FAIL: Int @ensures return temp not spelled int64_t")
    }
    assert(c.contains("int64_t __ens_rv_"))
    if !c.contains("double __ens_rv_") {
        io.println("FAIL: Float @ensures return temp not spelled double")
    }
    assert(c.contains("double __ens_rv_"))
}

test "scalar @ensures fn compiles and runs with the postcondition active" {
    let r = compile_test_helpers.compile_and_run(ens_scalar_src(), "t4w9fp_run")
    if r.exit_code != 0 {
        io.println("FAIL: did not run cleanly (exit {r.exit_code})")
        io.println(r.err_out)
    }
    assert(r.exit_code == 0)
    assert(r.out.contains("0 2.5"))
}
