// br t67cda — a mono generic-struct field whose type is a compound carrier
// (Result/Option) over a GENERIC-STRUCT-INSTANCE inner must substitute the
// inner's typevar. The value/unwrap paths spelled the inner's typevar literally
// (blink_Inner_0T) and a second typedef erased it (blink_Inner_str), so the same
// Result[Inner[T],Str] field was spelled three divergent ways and the C failed to
// compile. All spellings must come from the authoritative pinned tid.

type Inner[T] {
    v: T
}

type RB[T] {
    r: Result[Inner[T], Str]
}

test "a Result carrier over a generic-struct instance substitutes the inner typevar" {
    let b: RB[Int] = RB { r: Ok(Inner { v: 7 }) }
    let p = b.r.unwrap()
    assert_eq(p.v, 7)
}

type OB[T] {
    o: Option[Inner[T]]
}

test "an Option carrier over a generic-struct instance substitutes the inner typevar" {
    let b: OB[Int] = OB { o: Some(Inner { v: 42 }) }
    let got = b.o.unwrap().v
    assert_eq(got, 42)
}

// The inner instance (Inner[Int]) is NEVER built as a value here, so nothing
// registers it early: its typedef must still be forced ahead of the carrier that
// embeds it by value, or the emitted C forward-references blink_Inner_0Int.
test "a Result carrier whose Inner is never constructed still orders the inner typedef" {
    let b: RB[Int] = RB { r: Err("no inner") }
    match b.r {
        Ok(i) => assert_eq(i.v, 0)
        Err(e) => assert_eq(e, "no inner")
    }
}

test "an Option carrier whose Inner is never constructed still orders the inner typedef" {
    let b: OB[Int] = OB { o: None }
    assert_eq(b.o.is_none(), true)
}

// The carrier inner can be a generic ENUM instance, not only a struct. The forced
// pre-emit of the inner typedef must dispatch on the base kind: routing an enum
// instance (TE_0Int) to the struct emitter emits an empty struct that wins the shared
// include guard and suppresses the real tagged-union typedef, so the carrier embeds a
// bogus zero-size member. (Matching+binding the payload back out is blocked by a
// separate, pre-existing generic-enum-instance-field bug, so these only construct.)
type TE[T] {
    Leaf(v: T)
    Nil
}

type EB[T] {
    r: Result[TE[T], Str]
}

test "a Result carrier over a generic-enum instance emits the inner tagged union" {
    let b: EB[Int] = EB { r: Ok(Leaf(7)) }
    assert_eq(b.r.is_ok(), true)
}

type EO[T] {
    o: Option[TE[T]]
}

test "an Option carrier over a generic-enum instance whose inner is never constructed orders the typedef" {
    let b: EO[Int] = EO { o: None }
    assert_eq(b.o.is_none(), true)
}
