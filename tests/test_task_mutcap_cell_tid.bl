import compile_test_helpers

// A spawned task may not capture a `let mut` (§2.8, E0650), whatever the binding's type.
// These rows hold the aggregate shapes: a struct and a data enum. Both lower to a C struct,
// so a check keyed on scalar kinds would let them through.

fn expect_rejected(src: Str, tag: Str, name: Str) {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0650", "{tag}: spawn capturing `{name}` is E0650")
    compile_test_helpers.expect_contains(out, "`{name}`", "{tag}: the report names `{name}`")
}

test "spawn mutably capturing a struct is rejected" {
    expect_rejected(#"type Point { x: Int, y: Int }

fn main() ! Async, IO {
    let mut p = Point { x: 1, y: 2 }
    let h = async.spawn(fn() {
        p = Point { x: 10, y: 20 }
        p.x + p.y
    })
    io.println("{h.await}")
}
"#, "_mutcap_struct", "p")
}

test "spawn mutably capturing a data enum is rejected" {
    expect_rejected(#"type Shape { Circle(Int), Square(Int) }

fn area(s: Shape) -> Int {
    match s {
        Circle(r) => r * r
        Square(w) => w * w * 2
    }
}

fn main() ! Async, IO {
    let mut s = Circle(5)
    let h = async.spawn(fn() {
        s = Square(3)
        area(s)
    })
    io.println("{h.await}")
}
"#, "_mutcap_enum", "s")
}
