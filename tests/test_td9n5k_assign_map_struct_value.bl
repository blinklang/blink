// br td9n5k: the Assignment stmt arm (src/codegen_stmt.bl:2716-2755) has NO map-meta
// handling at all -- it never calls apply_map_binding_meta / carry_map_binding_meta,
// unlike emit_let_binding's Ident-target path (codegen_stmt.bl:3583-3589). A Map[Str,
// Box[Int]] value REASSIGNED to an existing var (not just let-bound) loses the value
// struct: the target keeps whatever meta it had before (or the CT_INT floor if it was
// never stamped), so `.get(k)` after the assignment reads back the wrong C type.
//
//     let mut m: Map[Str, Box[Int]] = Map()
//     m = build_map()   // build_map() returns Map[Str, Box[Int]]
//     m.get("k").unwrap().value   // erased -- reads back as if V were Int
//
// Model: test_1452w4_map_struct_instance_value.bl (let-only). This is the assignment
// twin -- same struct-value carrier, but reaching the target via `=` instead of `let`.
// The failure surfaces at runtime field access, so this MUST run via `task test`
// (archive-linked), not just compile.

type Box[T] {
    value: T
}

fn build_map() -> Map[Str, Box[Int]] {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 321 })
    m
}

test "Map[Str, Box[Int]] value struct survives a plain reassignment" {
    let mut m: Map[Str, Box[Int]] = Map()
    m = build_map()
    assert_eq(m.get("k").unwrap().value, 321)
}

test "Map[Str, Box[Int]] value struct survives reassignment from an alias" {
    let mut m: Map[Str, Box[Int]] = Map()
    let src = build_map()
    m = src
    assert_eq(m.get("k").unwrap().value, 321)
}
