import std.template.{TPL_INT, TPL_FLOAT, TPL_BOOL, TPL_STR}

// A string literal at a Template[C] parameter becomes a template value: the literal text
// between holes goes to parts(), each hole's value to the typed getters. The rows read
// back every part and every value, through an ordinary function and an effect operation,
// since both call shapes must build the same value.

pub effect Rd {
    effect Read {
        fn read(t: Template[Rd]) -> Str
    }
}

// One line per template: the parts joined by `|`, then each value as tag:value.
fn show(t: Template[Rd]) -> Str {
    let parts = t.parts()
    let mut out = "{parts.len()}/{t.count()}"
    let mut i = 0
    while i < parts.len() {
        let part = parts.get(i) ?? "?"
        out = "{out}|{part}"
        i = i + 1
    }
    i = 0
    while i < t.count() {
        let tag = t.type_tag(i)
        if tag == TPL_INT {
            out = "{out};i:{t.get_int(i)}"
        } else if tag == TPL_FLOAT {
            out = "{out};f:{t.get_float(i)}"
        } else if tag == TPL_BOOL {
            out = "{out};b:{t.get_bool(i)}"
        } else if tag == TPL_STR {
            out = "{out};s:{t.get_str(i)}"
        } else {
            out = "{out};?:{tag}"
        }
        i = i + 1
    }
    out
}

test "an ordinary fn reads back each part and each typed value" {
    let n = -7
    let f = 2.5
    let b = false
    let s = "it's"
    assert_eq(show("n={n} f={f} b={b} s={s} end"), "5/4|n=| f=| b=| s=| end;i:-7;f:2.5;b:false;s:it's")
}

test "a literal with no holes is one part and no values" {
    assert_eq(show("plain"), "1/0|plain")
    assert_eq(show(""), "1/0|")
}

test "holes at the ends and side by side give empty parts" {
    let a = 1
    let b = "x"
    assert_eq(show("{a}{b}"), "3/2|||;i:1;s:x")
    assert_eq(show("{a} mid {b}"), "3/2|| mid |;i:1;s:x")
}

test "a hole of any expression is one value of its own type" {
    let xs = [10, 20]
    let t = true
    assert_eq(show("{xs.len() + 1}:{!t}"), "3/2||:|;i:3;b:false")
}

@trusted(audit: "TEST-TEMPLATE-RAW")
fn show_raw(table: Str, id: Int) -> Str {
    show("SELECT * FROM {Raw(table)} WHERE id = {id}")
}

test "Raw() folds into the literal part and is not a value" {
    assert_eq(show_raw("items", 3), "2/1|SELECT * FROM items WHERE id = |;i:3")
}

test "an effect operation reads back the same parts and values" {
    with handler Rd {
        fn read(t: Template[Rd]) -> Str {
            show(t)
        }
    } {
        let n = 42
        let s = "hi"
        assert_eq(rd.read("n={n} s={s}"), "3/2|n=| s=|;i:42;s:hi")
        assert_eq(rd.read("none"), "1/0|none")
    }
}
