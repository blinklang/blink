// A test block's implicit return type is the unit type, or Result[(), TestError] when the
// body uses `?`. The unit type is written `()`; `Void` names only the pointee of an FFI
// pointer. The E0515 message and the E0514 / E0515 explain text must name the type as a user
// writes it, or they teach a spelling that is E0828 outside `Ptr`.

import compile_test_helpers
import diagnostics.{diag_explain}
import std.io

fn assert_no_void(text: Str, label: Str) {
    if text.contains("Void") { io.println("FAIL: {label} names Void\n{text}") }
    assert(!text.contains("Void"))
}

test "the E0515 message names the implicit return type as ()" {
    let out = compile_test_helpers.compile_and_capture("test \"x\" -> Int \{ let _ = 1 }\n", "test_block_ret_spells_unit")
    compile_test_helpers.expect_contains(out, "E0515", "E0515 fires")
    compile_test_helpers.expect_contains(out, "inferred — (), or Result[(), TestError]", "E0515 message")
    assert_no_void(out, "E0515 message")
}

test "the E0514 explain text names the elaborated return as Result[(), TestError]" {
    let text = diag_explain("E0514")
    assert(text.contains("Result[(), TestError]"))
    assert_no_void(text, "E0514 explain")
}

test "the E0515 explain text names the implicit return types with ()" {
    let text = diag_explain("E0515")
    assert(text.contains("Result[(), TestError]"))
    assert(text.contains("implicit return type is ()"))
    assert_no_void(text, "E0515 explain")
}
