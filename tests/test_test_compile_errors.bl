// Regression: `blink test` on sources with compile errors must fail fast
// with diagnostics — not hang in async.scope.

fn main() {
    let blink_root = process_run("sh", ["-c", "pwd -P"]).out.trim_right()

    let broken_file_count = 5

    // A fresh dir per run, so two runs at once (a test and its formatted copy)
    // do not clobber each other.
    let base = process_run("sh", ["-c", "mkdir -p .tmp && mktemp -d .tmp/_test_test_compile_errors_XXXXXX"]).out.trim_right()
    shell_exec("mkdir -p {base}/src {base}/tests")

    write_file("{base}/blink.toml", "[package]\nname = \"tcerr\"\nversion = \"0.1.0\"\n\n[dependencies]\n")
    write_file("{base}/src/tcerr.bl", "pub fn add(a: Int, b: Int) -> Int \{\n    a + b\n\}\n")

    let mut body = "import tcerr.\{add\}\n\n"
    let mut bi = 0
    while bi < broken_file_count {
        body = "{body}test \"broken_{bi}\" \{\n    let x = unknown_fn_{bi}() + bad_thing_{bi}()\n    if x \{ io.eprintln(\"a\") \}\n\}\n\n"
        bi = bi + 1
    }

    let mut idx = 0
    while idx < broken_file_count {
        write_file("{base}/tests/test_broken_{idx}.bl", body)
        idx = idx + 1
    }

    // BLINK_ROOT is set here, not inherited: without it blink test stops at the
    // runtime lookup before it compiles anything. The timeout only catches a
    // hang, so it is far above a cold run under load; a wall-time limit made
    // the outcome depend on machine load.
    let cmd = "cd {base} && BLINK_ROOT={blink_root} BLINK_CACHE_DIR= timeout 120 {blink_root}/build/blink test tests/ 2>&1"
    let result = process_run("sh", ["-c", cmd])
    shell_exec("rm -rf {base}")

    if result.exit_code == 124 {
        io.println("FAIL: blink test hung on compile errors (timed out)")
        return
    }
    if !result.out.contains("UndefinedFunction") {
        io.println("FAIL: expected compile error diagnostics, got: {result.out}")
        return
    }
    if result.exit_code == 0 {
        io.println("FAIL: expected non-zero exit on compile errors")
        return
    }
    io.println("PASS: blink test fails fast on compile errors")
}
