// test.failing(name, reason:) { body } is the whole form (§8.10.6). The record's
// xfail_reason is the reason as written: no tracker prefix, and no xfail_ticket field.
// A missing or empty reason: is E0835 and nothing else.
// Any other argument, `ticket:` included, is one UnexpectedToken.

import compile_test_helpers.{compile_and_run_test_json, compile_and_capture}

fn error_count(output: Str) -> Int {
    let mut n = 0
    for line in output.split("\n") {
        if line.contains("\"severity\":\"error\"") { n = n + 1 }
    }
    n
}

test "a reason-only test.failing row runs as an expected failure" {
    let src = "test.failing(\n  \"t\",\n  reason: \"not implemented yet\",\n) \{\n    assert(1 == 2)\n}\n"
    let r = compile_and_run_test_json(src, "_xfail_reason_only_red")
    assert(r.out.contains("\"status\":\"passed\""), "compile or run failed: {r.out}{r.err_out}")
    assert(r.out.contains("\"expected_fail\":true"))
    assert(r.out.contains("\"passed\":1"))
    assert(r.out.contains("\"failed\":0"))
}

test "a reason-only row's xfail_reason is the reason alone, with no xfail_ticket" {
    let src = "test.failing(\"t\", reason: \"not implemented yet\") \{\n    assert(1 == 2)\n}\n"
    let r = compile_and_run_test_json(src, "_xfail_reason_only_record")
    assert(r.out.contains("\"xfail_reason\":\"not implemented yet\""), "compile or run failed: {r.out}{r.err_out}")
    assert(!r.out.contains("br:"))
    assert(!r.out.contains("xfail_ticket"))
}

test "a reason-only row whose body passes is an unexpected pass" {
    let src = "test.failing(\"t\", reason: \"not implemented yet\") \{\n    assert(1 == 1)\n}\n"
    let r = compile_and_run_test_json(src, "_xfail_reason_only_unexpected_pass")
    assert(r.out.contains("\"status\":\"failed\""), "compile or run failed: {r.out}{r.err_out}")
    assert(r.out.contains("\"assertion\":\"expected failure, got pass\""))
    assert(r.out.contains("\"xfail_reason\":\"not implemented yet\""))
}

test "a test.failing row with no reason: is E0835 and only E0835" {
    let src = "test.failing(\"t\") \{\n    assert(1 == 2)\n}\n"
    let output = compile_and_capture(src, "_xfail_reason_missing")
    assert(output.contains("E0835"), output)
    assert(error_count(output) == 1, output)
}

test "a test.failing row with an empty reason: is E0835 and only E0835" {
    let src = "test.failing(\"t\", reason: \"\") \{\n    assert(1 == 2)\n}\n"
    let output = compile_and_capture(src, "_xfail_reason_empty")
    assert(output.contains("E0835"), output)
    assert(error_count(output) == 1, output)
}

test "a ticket: argument is one UnexpectedToken error and nothing else" {
    let src = "test.failing(\"t\", reason: \"not implemented yet\", ticket: \"abc\") \{\n    assert(1 == 2)\n}\n"
    let output = compile_and_capture(src, "_xfail_reason_only_ticket_rejected")
    assert(output.contains("UnexpectedToken"), output)
    assert(error_count(output) == 1, output)
}
