// `blink test --json` writes lines that any JSON parser accepts, whatever bytes a user's
// strings hold (spec §8.10). A test name, a tag, an assertion's text and message, the
// expected and actual values, a panic message, a skip reason, an expected-failure reason
// and a file path each reach the stream as a JSON string, so each one escapes `"`, `\` and
// every byte below 0x20. Each row parses each line with std.json and reads the user's
// string back unchanged.
//
// Fixture basenames must be unique per worker: `build/blink test` writes the compiled
// child binary to `build/<basename>`.

import std.json.{json_clear, json_parse, json_get, json_at, json_len, json_as_str}
import compile_test_helpers
import std.process.{ChildEnd}

// Every user string in the fixture carries these: a quote, a backslash, a newline, a tab
// and a backspace, which has no short escape in JSON.
fn nasty() -> Str { "q\"b\\n\nt\tc\b." }

// The same, as the fixture's source spells it inside a string literal.
fn nasty_src() -> Str { #"q\"b\\n\nt\tc\b."# }

fn fixture_lines() -> List[Str] {
    let n = nasty_src()
    [
        "@tags(\"{n}\")",
        "test \"pass {n}\" \{ assert(true) }",
        "test \"fail {n}\" \{",
        "    let s = \"{n}\"",
        "    assert(s == \"x\", \"msg {n}\")",
        "}",
        "test \"eq {n}\" \{ assert_eq(\"{n}\", \"y\") }",
        "test \"panic {n}\" \{ panic(\"boom {n}\") }",
        "test \"skip {n}\" \{ skip(\"why {n}\") }",
        "test.failing(\"xfail {n}\", reason: \"because {n}\") \{ assert(false) }",
        "",
    ]
}

type TestRun { out: Str, end: ChildEnd, fixture: Str }

fn run_json(tag: Str, dir_mode: Bool) -> TestRun {
    let scratch = "{compile_test_helpers.scratch_root()}/_test_json_escapes_{getpid()}_{tag}"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p {scratch}")
    let fixture = "{scratch}/json_esc_{tag}_{getpid()}.bl"
    write_file(fixture, fixture_lines().join("\n"))
    let target = if dir_mode { scratch } else { fixture }
    let r = process.run("build/blink", ["test", "--json", target]).unwrap()
    shell_exec("rm -rf {scratch}")
    TestRun { out: r.out, end: r.end, fixture: fixture }
}

// A JSON document holds no raw byte below 0x20 inside a string; outside one, only
// whitespace. The runner writes no whitespace but newlines between rows, so any other
// control byte, or a newline inside a string, means a string carried it raw. std.json
// accepts a raw newline inside a string, so the parse alone would not catch one.
fn assert_no_raw_control(out: Str) {
    let mut in_str = false
    let mut i = 0
    while i < out.byte_len() {
        let b = out.byte_at(i).to_int()
        assert(b >= 32 || (b == 10 && !in_str), "raw byte {b} at {i}:\n{out}")
        if in_str && b == 92 {
            i = i + 2
            continue
        }
        if b == 34 { in_str = !in_str }
        i = i + 1
    }
}

// An unescaped `"` inside a string ends that string early, so the byte after the close is
// the user's text instead of `,`, `:`, `]` or `}`. Checking that here keeps a bad report
// from reaching std.json, whose parser can loop forever on a bad token in an array.
fn assert_strings_close_cleanly(out: Str) {
    let mut in_str = false
    let mut i = 0
    while i < out.byte_len() {
        let b = out.byte_at(i).to_int()
        if in_str && b == 92 {
            i = i + 2
            continue
        }
        if b == 34 {
            if in_str {
                let next = if i + 1 < out.byte_len() { out.byte_at(i + 1).to_int() } else { 0 }
                assert(next == 44 || next == 58 || next == 93 || next == 125, "a string closes before byte {next} at {i}:\n{out}")
            }
            in_str = !in_str
        }
        i = i + 1
    }
    assert(!in_str, "the report ends inside a string:\n{out}")
}

// Checks the whole stream, then parses each line on its own: the stream is one JSON object
// per line, never one document.
fn check_stream(out: Str) {
    assert_no_raw_control(out)
    assert_strings_close_cleanly(out)
    for line in out.split("\n") {
        if line == "" { continue }
        json_clear()
        assert(json_parse(line) >= 0, "a line is not JSON:\n{line}\nin:\n{out}")
    }
}

// The line of the given record kind whose `key` is `value`, parsed, or -1.
fn line_where(out: Str, record: Str, key: Str, value: Str) -> Int {
    for line in out.split("\n") {
        if line == "" { continue }
        json_clear()
        let root = json_parse(line)
        if root < 0 { continue }
        if str_field(root, "record") == record && str_field(root, key) == value { return root }
    }
    -1
}

fn record_named(out: Str, name: Str) -> Int {
    line_where(out, "test", "name", name)
}

fn str_field(rec: Int, key: Str) -> Str {
    let v = json_get(rec, key)
    if v < 0 { return "<no {key}>" }
    json_as_str(v)
}

fn check_results(out: Str, fixture: Str) {
    let n = nasty()
    check_stream(out)
    let pass = record_named(out, "pass {n}")
    assert(pass >= 0, "no record for the passing test:\n{out}")
    assert_eq(str_field(pass, "file"), fixture)
    let tags = json_get(pass, "tags")
    assert(json_len(tags) == 1, out)
    assert_eq(json_as_str(json_at(tags, 0)), n)

    let fail = record_named(out, "fail {n}")
    assert(fail >= 0, "no record for the failing test:\n{out}")
    assert(str_field(fail, "assertion").contains("\"x\""), out)
    assert(str_field(fail, "user_message") == "msg {n}", out)

    let eq = record_named(out, "eq {n}")
    assert(eq >= 0, "no record for the assert_eq test:\n{out}")
    assert(str_field(eq, "message").contains(n), out)

    let p = record_named(out, "panic {n}")
    assert(p >= 0, "no record for the panicking test:\n{out}")
    assert(str_field(p, "message").contains("boom {n}"), out)

    let s = record_named(out, "skip {n}")
    assert(s >= 0, "no record for the skipped test:\n{out}")
    assert_eq(str_field(s, "reason"), "why {n}")

    let x = record_named(out, "xfail {n}")
    assert(x >= 0, "no record for the expected failure:\n{out}")
    assert_eq(str_field(x, "xfail_reason"), "because {n}")
}

test "a single-file run escapes every user string in its records" {
    let r = run_json("one", false)
    assert(r.end != ChildEnd.Exited(0), "the fixture fails, so the run must too:\n{r.out}")
    check_results(r.out, r.fixture)
}

test "a directory run escapes every user string in its records" {
    let r = run_json("dir", true)
    assert(r.end != ChildEnd.Exited(0), "the fixture fails, so the run must too:\n{r.out}")
    check_results(r.out, r.fixture)
    assert(line_where(r.out, "file", "file", r.fixture) >= 0, "no file line for the fixture:\n{r.out}")
}

test "a directory run escapes the file path of each record" {
    let scratch = "{compile_test_helpers.scratch_root()}/_test_json_escapes_{getpid()}_path"
    let dir = "{scratch}/q\"b\\s"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p '{dir}'")
    let fixture = "{dir}/json_esc_path_{getpid()}.bl"
    write_file(fixture, "test \"ok\" \{ assert(true) }\n")
    let r = process.run("build/blink", ["test", "--json", scratch])?
    shell_exec("rm -rf {scratch}")
    check_stream(r.out)
    assert(line_where(r.out, "file", "file", fixture) >= 0, "no file line for the fixture:\n{r.out}")
}
