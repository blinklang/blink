// Behavioral proof that the §2.20 test-only symbol fence is allowlist-gated
// (br tktdnc). The fence is driven by `is_test_only_symbol` in src/typecheck.bl
// — that predicate is the SINGLE extension point for future test-only symbols
// (e.g. assert_panics). Adding a symbol there should be a one-line append, not
// a new code path.

import compile_test_helpers.{expect_compile_error, expect_no_error}

// `skip` is on the allowlist: calling it outside a test body fences with E0827.
test "skip outside a test fences with E0827" {
    let src = "fn main() \{\n  skip(\"nope\")\n}\n"
    expect_compile_error(src, "fence_skip_outside", "E0827")
}

// `assert` is a builtin but NOT a test-only symbol: using it outside a test
// body must NOT trip the test-only fence (no E0827).
test "assert outside a test is not fenced by E0827" {
    let src = "fn main() \{\n  assert(1 == 1)\n}\n"
    expect_no_error(src, "fence_assert_outside", "E0827")
}
