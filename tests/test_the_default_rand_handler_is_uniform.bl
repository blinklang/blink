// The default Rand handler gives uniform results through the rand wrappers (sections/04_effects.md
// §4.4.7 Uniformity). Each row is a chi-square test whose threshold is the p = 1e-9 upper tail
// for its degrees of freedom, so an honest generator fails a row once in 1e9 runs.

fn chi_square(counts: List[Int], total: Int) -> Float {
    let expected = Float.from(total) / Float.from(counts.len())
    let mut sum = 0.0
    for c in counts {
        let d = Float.from(c) - expected
        sum = sum + d * d / expected
    }
    sum
}

fn zeros(n: Int) -> List[Int] {
    let mut out: List[Int] = []
    for _ in 0..n {
        out.push(0)
    }
    out
}

test "int over 0..10 is uniform" {
    let draws = 100000
    let mut counts = zeros(10)
    for _ in 0..draws {
        let v = rand.int(0..10)
        counts.set(v, counts.get(v).unwrap() + 1)
    }
    let x2 = chi_square(counts, draws)
    // df 9
    assert(x2 < 60.66, "chi-square {x2}")
}

// The bin of x in [0.0, 1.0) split into `bins` equal parts, found by comparison so no Float
// to Int conversion decides it.
fn bin_of(x: Float, bins: Int) -> Int {
    let mut b = 0
    while b + 1 < bins && x >= Float.from(b + 1) / Float.from(bins) {
        b = b + 1
    }
    b
}

test "float is uniform over 16 bins" {
    let draws = 160000
    let mut counts = zeros(16)
    for _ in 0..draws {
        let b = bin_of(rand.float(), 16)
        counts.set(b, counts.get(b).unwrap() + 1)
    }
    let x2 = chi_square(counts, draws)
    // df 15
    assert(x2 < 73.63, "chi-square {x2}")
}

test "bytes are uniform over 256 values" {
    let draws = 256000
    let mut counts = zeros(256)
    let b = rand.bytes(draws)
    for i in 0..draws {
        let v = b.get(i).unwrap()
        counts.set(v, counts.get(v).unwrap() + 1)
    }
    let x2 = chi_square(counts, draws)
    // df 255
    assert(x2 < 414.55, "chi-square {x2}")
}
