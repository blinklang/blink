// `blink build`, `blink run` and `blink test` report a failed C compile, link or native
// dependency step with the same codes (section 6.7.3), so the explain text of each code holds
// for all three. A missing header has its own code, so I0017 does not blame the headers.

import diagnostics.{diag_explain, GENERATED_C_DID_NOT_COMPILE, LINK_FAILED, NATIVE_DEPENDENCY_BUILD_FAILED}

test "the explain text of a link or native dependency failure is not for blink test only" {
    for code in [LINK_FAILED, NATIVE_DEPENDENCY_BUILD_FAILED] {
        let text = diag_explain(code)
        assert(!text.contains("blink test` only"), text)
        assert(text.contains("`blink build`"), text)
        assert(text.contains("exits 1"), text)
    }
}

test "the explain text of generated C that does not compile names the exit code and the @ffi cause" {
    let text = diag_explain(GENERATED_C_DID_NOT_COMPILE)
    assert(text.starts_with("I0017 -- GeneratedCDidNotCompile"), text)
    assert(!text.contains("Check the headers first"), text)
    assert(text.contains("exits 101"), text)
    assert(text.contains("passes\n`blink check`") || text.contains("passes `blink check`"), text)
    assert(text.contains("`@ffi` prototype"), text)
}
