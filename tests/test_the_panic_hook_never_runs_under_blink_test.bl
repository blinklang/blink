// Under `blink test` the runner frame takes every panic, so the hook never runs, even when a
// test calls `main` and `main` reaches its `with on_panic(f)` (sections/02_syntax.md §2.20
// *The hook in tests*). The test that panics is panicked and the next test still runs.

import compile_test_helpers.{compile_and_run_test_json}

test "a test that runs main with a hook gets the panic and the next test runs" {
    let src = #"fn report(p: PanicInfo) -> Never ! IO.Print, Env.Exit {
    io.println("hook: {p.message}")
    env.exit(70)
}

fn main() ! IO, Env {
    with on_panic(report) {
        panic("boom")
    }
}

test "runs main" {
    main()
}

test "runs next" {
    assert_eq(1 + 1, 2)
}
"#
    let r = compile_and_run_test_json(src, "ph_under_test_{getpid()}")
    assert(r.exit_code != 70, "the hook ran: {r.out}{r.err_out}")
    assert(!r.out.contains("hook:"), r.out)
    assert(r.out.contains(#""name":"runs main","status":"panicked""#), r.out)
    assert(r.out.contains("boom"), r.out)
    assert(r.out.contains(#""name":"runs next","status":"passed""#), r.out)
}
