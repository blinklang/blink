// D2 tuple slice (6zmspt): a top-level tuple argument bound to a bare typevar
// param `x: T` monomorphizes through tc_mono_csv on the structured-tid path
// (previously deferred to the string-tag path because tc_tid_encodable rejected
// TK_TUPLE). The mono symbol must stay byte-identical (Tuple{n}_<elem>...), so
// these exercise the scalar- and carrier-element tuple shapes that are provably
// identical between the two paths. Struct/enum-element tuples still defer (the
// module-qualifier spelling diverges) and are covered by the ci byte-equality
// gate, not here.

fn take[T](x: T) -> T {
    x
}

fn take_int[T](_x: T) -> Int {
    99
}

test "top-level (Int, Int) tuple arg binds through tc_mono_csv" {
    let p = (1, 2)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "top-level (Str, Int) tuple arg binds through tc_mono_csv" {
    let p = ("a", 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "top-level (Int, Float, Bool) tuple arg binds through tc_mono_csv" {
    let p = (1, 2.5, true)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "returned tuple round-trips through a generic bare-typevar param" {
    let p = (3, 4)
    let q = take(p)
    assert_eq(q.0, 3)
    assert_eq(q.1, 4)
}

test "tuple with a List element binds through tc_mono_csv" {
    let xs = [1, 2, 3]
    let p = (xs, 5)
    let n = take_int(p)
    assert_eq(n, 99)
}

// A List[T] param bound to a list-of-tuples. Pre-tid-slice this mangled to
// `first_Void` (type_name_from_ct has no CT_STRUCT case) and FAILED C
// compilation; the tid path now resolves the List element tid to Tuple2_int_str,
// so it compiles and the returned tuple's fields are accessible. Regression guard
// for the bug the D2 tuple slice fixed.
fn first[T](xs: List[T]) -> T {
    xs.get(0).unwrap()
}

test "List[(Int, Str)] through a List[T] param resolves the tuple element" {
    let xs = [(1, "a"), (2, "b"), (3, "c")]
    let r = first(xs)
    assert_eq(r.0, 1)
    assert_eq(r.1, "a")
}

test "List[(Int, Int, Bool)] through a List[T] param" {
    let xs = [(1, 2, true), (3, 4, false)]
    let r = first(xs)
    assert_eq(r.0, 1)
    assert_eq(r.2, true)
}

test "scalar List[T] still resolves (no regression)" {
    let xs = [10, 20, 30]
    assert_eq(first(xs), 10)
}
