// Instant renders as RFC 9557 in UTC with a trailing Z. Its fraction is left out when it
// is zero, and has no trailing zeros otherwise. Duration renders the way Go's
// time.Duration.String does. Duration.to_iso8601 gives the ISO 8601 duration form.

fn at(secs: Int, nanos: Int) -> Instant {
    Instant.from_epoch_secs(secs).add(Duration.nanos(nanos))
}

test "Instant at the epoch renders with no fraction" {
    assert_eq("{Instant.from_epoch_secs(0)}", "1970-01-01T00:00:00Z")
}

test "Instant renders a fixed date and time" {
    assert_eq("{Instant.from_epoch_secs(1771070400)}", "2026-02-14T12:00:00Z")
}

test "Instant fraction drops its trailing zeros" {
    assert_eq("{at(1771070400, 500000000)}", "2026-02-14T12:00:00.5Z")
    assert_eq("{at(1771070400, 123000000)}", "2026-02-14T12:00:00.123Z")
    assert_eq("{at(1771070400, 1)}", "2026-02-14T12:00:00.000000001Z")
}

test "Instant before the epoch rounds down to the earlier second" {
    assert_eq("{at(0, -500000000)}", "1969-12-31T23:59:59.5Z")
    assert_eq("{Instant.from_epoch_secs(-1)}", "1969-12-31T23:59:59Z")
    assert_eq("{Instant.from_epoch_secs(-2208988800)}", "1900-01-01T00:00:00Z")
}

test "Instant renders leap days" {
    assert_eq("{Instant.from_epoch_secs(1709251199)}", "2024-02-29T23:59:59Z")
    assert_eq("{Instant.from_epoch_secs(951782400)}", "2000-02-29T00:00:00Z")
}

test "Instant display agrees with interpolation" {
    let i = at(1771070400, 500000000)
    assert_eq(i.display(), "{i}")
}

test "Instant to_rfc3339 keeps whole seconds" {
    assert_eq(at(1771070400, 500000000).to_rfc3339(), "2026-02-14T12:00:00Z")
}

test "Duration below one second uses the largest unit that fits" {
    assert_eq("{Duration.nanos(0)}", "0s")
    assert_eq("{Duration.nanos(1)}", "1ns")
    assert_eq("{Duration.nanos(1500)}", "1.5µs")
    assert_eq("{Duration.ms(500)}", "500ms")
    assert_eq("{Duration.nanos(999999999)}", "999.999999ms")
}

test "Duration of one second or more uses h, m and s" {
    assert_eq("{Duration.nanos(3723500000000)}", "1h2m3.5s")
    assert_eq("{Duration.seconds(90)}", "1m30s")
    assert_eq("{Duration.minutes(1)}", "1m0s")
    assert_eq("{Duration.hours(1)}", "1h0m0s")
    assert_eq("{Duration.hours(48)}", "48h0m0s")
    assert_eq("{Duration.seconds(1)}", "1s")
}

test "negative Duration has a leading minus" {
    assert_eq("{Duration.ms(-1500)}", "-1.5s")
    assert_eq("{Duration.nanos(-1)}", "-1ns")
}

test "Duration at the Int limits renders" {
    assert_eq("{Duration.nanos(9223372036854775807)}", "2562047h47m16.854775807s")
    assert_eq("{Duration.nanos(-9223372036854775807 - 1)}", "-2562047h47m16.854775808s")
}

test "Duration display agrees with interpolation" {
    let d = Duration.nanos(3723500000000)
    assert_eq(d.display(), "{d}")
}

test "Duration to_iso8601" {
    assert_eq(Duration.nanos(3723500000000).to_iso8601(), "PT1H2M3.5S")
    assert_eq(Duration.nanos(0).to_iso8601(), "PT0S")
    assert_eq(Duration.ms(500).to_iso8601(), "PT0.5S")
    assert_eq(Duration.hours(48).to_iso8601(), "PT48H")
    assert_eq(Duration.minutes(1).to_iso8601(), "PT1M")
    assert_eq(Duration.ms(-1500).to_iso8601(), "-PT1.5S")
    assert_eq(Duration.nanos(-9223372036854775807 - 1).to_iso8601(), "-PT2562047H47M16.854775808S")
}

test "Instant and Duration render inside a tuple" {
    let pair = (Instant.from_epoch_secs(0), Duration.ms(500))
    assert_eq("{pair}", "(1970-01-01T00:00:00Z, 500ms)")
}
