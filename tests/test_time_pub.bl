import std.time.{Duration_ms, Duration_to_nanos, Duration_add, Duration_to_seconds, Instant_from_epoch_secs, Instant_since, Instant_to_unix_secs}

test "time constructors usable cross-module (unqualified import)" {
    let d = Duration_ms(5)
    assert_eq(Duration_to_nanos(d), 5000000)
    let i = Instant_from_epoch_secs(1000)
    assert_eq(Instant_to_unix_secs(i), 1000)
}

test "time combinators usable cross-module (unqualified import)" {
    let a = Duration_ms(2000)
    let b = Duration_ms(3000)
    assert_eq(Duration_to_seconds(Duration_add(a, b)), 5)
    let i1 = Instant_from_epoch_secs(100)
    let i2 = Instant_from_epoch_secs(105)
    assert_eq(Duration_to_seconds(Instant_since(i2, i1)), 5)
}
