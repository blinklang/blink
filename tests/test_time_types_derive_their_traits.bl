// Instant implements Eq, Ord, Hash, Clone and Debug; Duration implements Eq, Ord, Clone and
// Debug but not Hash (sections/03_types.md:576, :598). Both are sealed (03c_protocols.md:737),
// so only lib/std/time.bl can give them these traits, and it does so by @derive like any other
// struct. The operators, a Map key, a trait bound and the derived methods all read that one
// source, so a comparison that typechecks also has a method for codegen to call.
//
// Rejection rows run through the compiler in a SUBPROCESS: they are compile errors, so an in-file
// row could not be red without failing to compile the whole test file.

import std.time
import std.process.{ProcessResult}

fn larger[T: Ord](a: T, b: T) -> T {
    if a > b { a } else { b }
}

test "Duration supports every comparison operator" {
    let small = Duration.ms(5)
    let big = Duration.ms(50)
    assert(small < big)
    assert(big > small)
    assert(small <= small)
    assert(big >= small)
    assert(small == Duration.ms(5))
    assert(small != big)
    assert(!(big < small))
}

test "Instant compares by the moment it holds" {
    let early = Instant.from_epoch_secs(10)
    let late = Instant.from_epoch_secs(20)
    assert(early == Instant.from_epoch_secs(10))
    assert(early != late)
    assert(early < late)
    assert(late >= early)
    let t1 = time.read()
    let t2 = time.read()
    assert(t1 == t1)
    assert(t1 <= t2)
}

test "Instant is a Map key and a Set element" {
    let a = Instant.from_epoch_secs(1)
    let b = Instant.from_epoch_secs(2)
    let mut m: Map[Instant, Int] = Map.new()
    m.insert(a, 1)
    m.insert(b, 2)
    m.insert(Instant.from_epoch_secs(1), 3)
    assert_eq(m.len(), 2)
    assert_eq(m.get(a).unwrap(), 3)
    let mut s: Set[Instant] = Set.new()
    s.insert(a)
    s.insert(Instant.from_epoch_secs(1))
    assert_eq(s.len(), 1)
    assert(s.contains(a))
}

test "Duration satisfies an Ord bound" {
    let d = larger(Duration.ms(3), Duration.ms(7))
    assert_eq(d.to_ms(), 7)
    let i = larger(Instant.from_epoch_secs(4), Instant.from_epoch_secs(2))
    assert_eq(i.to_unix_secs(), 4)
}

test "Instant and Duration clone" {
    let d = Duration.seconds(2)
    let dc = d.clone()
    assert(dc == d)
    let i = Instant.from_epoch_secs(9)
    let ic = i.clone()
    assert(ic == i)
}

test "Duration debug shows its fields" {
    assert_eq(Duration.ms(1).debug(), "Duration \{ nanos: 1000000 \}")
}

// ── The same facts hold without import std.time, because std.time is in the prelude ──

fn check_src(tag: Str, src: Str) -> ProcessResult {
    let bl_path = ".tmp/_time_derive_{tag}.bl"
    write_file(bl_path, src)
    let r = process_run("build/blink", ["check", bl_path, "--format", "json"])
    shell_exec("rm -f {bl_path}")
    r
}

fn run_src(tag: Str, src: Str) -> ProcessResult {
    let bl_path = ".tmp/_time_derive_{tag}.bl"
    write_file(bl_path, src)
    let r = process_run("build/blink", ["run", bl_path])
    shell_exec("rm -f {bl_path}")
    r
}

fn expect_rejected(tag: Str, src: Str, code: Str, words: Str) {
    let r = check_src(tag, src)
    let out = "{r.out}{r.err_out}"
    if r.exit_code == 0 { io.println("FAIL[{tag}] accepted, expected rejection") }
    assert(r.exit_code != 0)
    if !out.contains(code) { io.println("FAIL[{tag}] want {code}, got: {out}") }
    assert(out.contains(code))
    if !out.contains(words) { io.println("FAIL[{tag}] want '{words}', got: {out}") }
    assert(out.contains(words))
}

test "time.read() values compare with no import of std.time" {
    let r = run_src("noimport", #"fn main() {
    let a = time.read()
    let b = time.read()
    io.println("{a == a} {a <= b}")
}
"#)
    let out = "{r.out}{r.err_out}"
    if r.exit_code != 0 { io.println("FAIL[noimport] exit {r.exit_code}: {out}") }
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("true true"))
}

// ── What the spec does not grant stays rejected ─────────────────────────────

test "Duration is not a Map key because it has no Hash" {
    expect_rejected("durkey", #"import std.time
fn main() {
    let m: Map[Duration, Int] = Map.new()
    io.println("{m.len()}")
}
"#, "E1400", "Duration")
}

test "Instant does not compare with Int" {
    expect_rejected("instint", #"import std.time
fn main() {
    let now = time.read()
    if now > 0 { io.println("x") }
}
"#, "E0300", "incompatible types Instant and Int")
}

test "Duration does not compare with Instant" {
    expect_rejected("durinst", #"import std.time
fn main() {
    let d = Duration.ms(1)
    let now = time.read()
    if d == now { io.println("x") }
}
"#, "E0300", "incompatible types Duration and Instant")
}

test "Instant is not a number" {
    expect_rejected("instadd", #"import std.time
fn main() {
    let now = time.read()
    let s = now + now
    io.println("{s.to_unix_secs()}")
}
"#, "E0300", "requires numeric operand, got Instant")
}
