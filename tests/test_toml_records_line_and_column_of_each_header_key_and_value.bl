// The TOML reader records where each [header], key and value sits, so a manifest diagnostic can
// point at the token at fault. Lines and columns count from 1; a column counts bytes, as the
// compiler's own diagnostics do; end_col is the first column after the token.

import std.toml.{toml_clear, toml_parse, toml_keys, toml_key_spans, toml_value_spans, toml_headers, toml_header_spans, toml_read_value, TomlSpan}

fn index_of(key: Str) -> Int {
    let mut i = 0
    while i < toml_keys.len() {
        if toml_keys.get(i).unwrap() == key { return i }
        i = i + 1
    }
    -1
}

fn key_span(key: Str) -> TomlSpan {
    toml_key_spans.get(index_of(key)).unwrap()
}

fn value_span(key: Str) -> TomlSpan {
    toml_value_spans.get(index_of(key)).unwrap()
}

fn assert_span(s: TomlSpan, line: Int, col: Int, end_line: Int, end_col: Int) {
    assert_eq(s.line, line)
    assert_eq(s.col, col)
    assert_eq(s.end_line, end_line)
    assert_eq(s.end_col, end_col)
}

let SAMPLE: Str = "# leading comment\n\n# another\n[package]\nname = \"probe\"\n\n  [lints]\n    W0703 = \"loud\"\n[[bin]]\npath = \"a.bl\"\n"

test "a header after comments and blank lines spans its brackets" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    assert_eq(toml_headers.len(), 3)
    assert_eq(toml_headers.get(0).unwrap(), "package")
    assert_span(toml_header_spans.get(0).unwrap(), 4, 1, 4, 10)
}

test "an indented header starts at its bracket" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    assert_eq(toml_headers.get(1).unwrap(), "lints")
    assert_span(toml_header_spans.get(1).unwrap(), 7, 3, 7, 10)
}

test "an array table header spans both bracket pairs" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    assert_eq(toml_headers.get(2).unwrap(), "bin")
    assert_span(toml_header_spans.get(2).unwrap(), 9, 1, 9, 8)
}

test "an indented key and its quoted value" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    assert_span(key_span("lints.W0703"), 8, 5, 8, 10)
    assert_span(value_span("lints.W0703"), 8, 13, 8, 19)
}

test "a value span gives the byte offsets of the token, quotes included" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    let s = value_span("package.name")
    assert_eq(SAMPLE.byte_slice(s.start_byte, s.end_byte), "\"probe\"")
}

test "a CRLF file gives the same lines and columns as an LF file" {
    toml_clear()
    let _ = toml_parse(SAMPLE.replace("\n", "\r\n"))
    assert_span(toml_header_spans.get(1).unwrap(), 7, 3, 7, 10)
    assert_span(key_span("lints.W0703"), 8, 5, 8, 10)
    assert_span(value_span("lints.W0703"), 8, 13, 8, 19)
}

test "a dotted key spans all its parts" {
    toml_clear()
    let _ = toml_parse("package . name = \"x\"\n")
    assert_span(key_span("package.name"), 1, 1, 1, 15)
    assert_span(value_span("package.name"), 1, 18, 1, 21)
}

test "integer and bool values span their token" {
    toml_clear()
    let _ = toml_parse("a = -42\nb = true\n")
    assert_span(value_span("a"), 1, 5, 1, 8)
    assert_span(value_span("b"), 2, 5, 2, 9)
}

test "an array value spans its brackets across lines, and each item its own token" {
    toml_clear()
    let _ = toml_parse("tags = [\n  \"a\",\n  \"bc\"\n]\n")
    assert_span(value_span("tags"), 1, 8, 4, 2)
    assert_span(value_span("tags[1]"), 3, 3, 3, 7)
    assert_span(key_span("tags[1]"), 1, 1, 1, 5)
}

test "an inline table entry has its own key and value, and the table spans its braces" {
    toml_clear()
    let _ = toml_parse("[dependencies]\nhttp = \{ git = \"u\", tag = \"v1\" \}\n")
    assert_span(key_span("dependencies.http.tag"), 2, 21, 2, 24)
    assert_span(value_span("dependencies.http.tag"), 2, 27, 2, 31)
    assert_span(key_span("dependencies.http"), 2, 1, 2, 5)
    assert_span(value_span("dependencies.http"), 2, 8, 2, 33)
}

test "a column counts bytes, so a multi-byte character before a token moves it by its byte length" {
    toml_clear()
    let _ = toml_parse("\"é\" = \"x\"\n")
    assert_span(key_span("é"), 1, 1, 1, 5)
    assert_span(value_span("é"), 1, 8, 1, 11)
}

test "toml_clear empties the span lists" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    toml_clear()
    assert_eq(toml_key_spans.len(), 0)
    assert_eq(toml_value_spans.len(), 0)
    assert_eq(toml_headers.len(), 0)
    assert_eq(toml_header_spans.len(), 0)
}

test "toml_read_value leaves the spans of the current parse in place" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    let _ = toml_read_value("[x]\ny = 1\n", "x", "y")
    assert_eq(toml_key_spans.len(), toml_keys.len())
    assert_eq(toml_headers.len(), 3)
    assert_span(value_span("lints.W0703"), 8, 13, 8, 19)
}

test "each entry has one key span and one value span" {
    toml_clear()
    let _ = toml_parse(SAMPLE)
    let _ = toml_parse("[more]\nz = [1, 2]\n")
    assert_eq(toml_key_spans.len(), toml_keys.len())
    assert_eq(toml_value_spans.len(), toml_keys.len())
    // A second parse counts lines from its own first line.
    assert_span(value_span("more.z[1]"), 2, 9, 2, 10)
    assert_span(toml_header_spans.get(3).unwrap(), 1, 1, 1, 7)
}
