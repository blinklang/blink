// A top-level `pub let` bound to a plain (non-tuple, non-generic) struct literal
// must get its own struct type at module scope, not a bare `void` field.

type Point { x: Int, y: Int }

pub let g = Point { x: 1, y: 2 }

test "top-level struct-literal global keeps its struct type" {
    assert_eq(g.x, 1)
    assert_eq(g.y, 2)
}
