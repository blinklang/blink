// A top-level fn whose declared return type is a generic-enum INSTANCE
// (`-> Tree[Int]`) must emit that instance's mono typedef before any forward
// declaration of the fn, and must mangle the instance name without a stray
// leading digit.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a fn returning a generic-enum instance builds and returns the right variant",
    reason: "the mono typedef for the generic-enum instance is emitted after the fn's forward declaration, so cc sees an unknown type name and then conflicting types for the fn",
    ticket: "ad4r35",
) {
    let src = #"
type Tree[T] { Leaf, Node(T) }

fn ret_tree() -> Tree[Int] { return Tree.Node(5) }

fn main() ! IO {
    let t = ret_tree()
    match t {
        Tree.Node(n) => io.println("{n}")
        Tree.Leaf => io.println("leaf")
    }
}
"#
    let r = compile_and_run(src, "_toplevel_fn_generic_enum_instance_return")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}
