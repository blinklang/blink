// An unannotated top-level `let mut s = Set()` must infer its element type
// from a later in-function `.insert()` use, the same way an unannotated
// LOCAL `let mut s = Set()` already does. The top-level-let inference loop
// skips a Call-node RHS entirely, so the element type is never pinned and the
// module-scope form is rejected even though the local-scope twin compiles.

import compile_test_helpers.{compile_and_run}

test.failing(
    "unannotated top-level let Set() infers its element from a later insert, like the local-let twin",
    reason: "the top-level-let inference loop only calls infer_type for literal RHS kinds (IntLit/FloatLit/BoolLit/InterpString), so a Call-node RHS like Set() never gets a real element type and later unification from main()'s .insert(7) has nothing to attach to",
) {
    let src = #"
let mut s = Set()
fn main() ! IO {
    s.insert(7)
    let mut total = 0
    for x in s { total = total + x }
    io.println("{total}")
}
"#
    let r = compile_and_run(src, "_toplevel_let_set_infers_from_later_insert")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}
