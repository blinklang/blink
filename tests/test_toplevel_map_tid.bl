// A module-level `let mut m: Map[K, V]` global is created by emit_top_level_let, which — unlike
// emit_let_binding for locals — never stamped the binding's type id onto the ScopeVar (`ty` stayed
// -1). So a top-level map could only answer its value type from the flat channels, never the tid.
// These rows pin the value-type round-trip for the three value shapes the flat channels encode
// separately (List via `extra`, struct via `sname2`, scalar via `inner2`), so stamping the tid at
// the top-level binding stays byte-identical: each map still returns the value it stored.

type Point {
    x: Int
    y: Int
}

let mut fields: Map[Str, List[Str]] = Map()
let mut counts: Map[Str, Int] = Map()
let mut origins: Map[Str, Point] = Map()

// ── List-valued top-level map (the escape.bl ea_struct_fields shape) ───────────────────────
test "a top-level Map[Str, List[Str]] round-trips its list value" {
    fields.insert("a", ["one", "two"])
    fields.insert("b", ["three"])
    let a = fields.get("a").unwrap()
    assert_eq(a.len(), 2)
    assert_eq(a.get(0).unwrap(), "one")
    assert_eq(fields.get("b").unwrap().len(), 1)
}

// ── scalar-valued top-level map ───────────────────────────────────────────────────────────
test "a top-level Map[Str, Int] round-trips its scalar value" {
    counts.insert("x", 7)
    counts.insert("y", 9)
    assert_eq(counts.get("x").unwrap(), 7)
    assert_eq(counts.get("y").unwrap(), 9)
}

// ── struct-valued top-level map ───────────────────────────────────────────────────────────
test "a top-level Map[Str, Point] round-trips its struct value" {
    origins.insert("home", Point { x: 3, y: 4 })
    let p = origins.get("home").unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}
