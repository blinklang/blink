// A top-level tuple global was registered through set_var_struct with the carrier
// name on the flat sname channel but no type id, so every field read on it
// resolved the carrier through the flat sname alone. The top-level-let path now
// also stamps the binding's tid on the global (guarded to the same carrier the
// flat write spells), so sv_struct_tid_first recovers the tuple from the tid.
// This is a tid-population step: the emitted C is unchanged; the tests guard that
// a tuple global still resolves its field access across the plain, nested,
// struct-element, and list-element shapes.
// Unlike a synthetic tuple temp, a source-named global can be captured by a
// closure and mutated, so the stamp is exercised on those paths too: the
// captured and mut cases guard that a stamped tid does not perturb closure
// capture or reassignment of a tuple global.
type Q { x: Int }

let g_plain: (Int, Int) = (3, 4)
let g_nested: ((Int, Int), Int) = ((1, 2), 5)
let g_struct: (Q, Int) = (Q { x: 9 }, 6)
let g_cap: (Int, Int) = (11, 22)
let mut g_mut: (Int, Int) = (1, 2)

test "plain tuple global resolves field access" {
    assert_eq(g_plain.0, 3)
    assert_eq(g_plain.1, 4)
}

test "nested tuple global resolves field access" {
    let inner = g_nested.0
    assert_eq(inner.0, 1)
    assert_eq(inner.1, 2)
    assert_eq(g_nested.1, 5)
}

test "tuple global with a struct element resolves both field paths" {
    assert_eq(g_struct.0.x, 9)
    assert_eq(g_struct.1, 6)
}

test "closure captures a tuple global and reads its fields" {
    let f = fn() -> Int { g_cap.0 + g_cap.1 }
    assert_eq(f(), 33)
}

test "mut tuple global reassigned then read" {
    g_mut = (5, 6)
    assert_eq(g_mut.0, 5)
    assert_eq(g_mut.1, 6)
}
