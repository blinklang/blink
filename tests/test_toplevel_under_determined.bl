// error[CannotInferType] (E0301) for an under-determined TOP-LEVEL `let` — the
// materialization boundary the region-boundary check already enforces for local
// bindings, applied at module scope too.
//
// Spec: sections/03_types.md §3.4 "Under-Determined Types" (decisions/under-determined-types.md,
// 8vcj2c, 6-0). "The judgment is a property of the type, not of the syntactic position" and
// "legality is judged at the binding, once — never contingent on a whole-function observability
// analysis." A top-level binding is judged at its own site by its RHS and annotation ALONE: a
// later cross-scope use (a `ch.send(1)` in some test or fn body) is action-at-a-distance the
// panel rejected, so it must NOT retroactively determine the top-level type.
//
// A `pub let ch = Channel(10)` whose element type nothing local pins, or a `let xs = []`, was
// silently accepted with the binding left TYPE_UNKNOWN, and codegen fabricated an arbitrary flat
// carrier — the forbidden "third default state." It must be E0301, exactly as the same shape is
// inside a fn body.

import compile_test_helpers

// ── the bug: an under-determined top-level channel is E0301 ──

test "a bare top-level channel with only cross-scope uses is E0301" {
    let src = "pub let ch = Channel(10)\ntest \"t\" \{ ch.send(1) let v = ch.recv() assert_eq(v, 1) }\n"
    compile_test_helpers.expect_compile_error(src, "toplevel_chan", "E0301")
}

test "a bare top-level empty list is E0301" {
    let src = "pub let xs = []\nfn use_it() -> Int \{ xs.len() }\n"
    compile_test_helpers.expect_compile_error(src, "toplevel_emptylist", "E0301")
}

// ── controls: an annotated / fully-determined top-level binding is NOT E0301 ──

test "an annotated top-level channel pins the element and is not E0301" {
    let src = "pub let ch: Channel[Int] = Channel(10)\ntest \"t\" \{ ch.send(1) let v = ch.recv() assert_eq(v, 1) }\n"
    compile_test_helpers.expect_no_error(src, "toplevel_chan_ann", "E0301")
}

test "an annotated top-level empty list is not E0301" {
    let src = "pub let xs: List[Int] = []\nfn use_it() -> Int \{ xs.len() }\n"
    compile_test_helpers.expect_no_error(src, "toplevel_list_ann", "E0301")
}

test "a determined top-level list literal is not E0301" {
    let src = "pub let xs = [1, 2, 3]\nfn use_it() -> Int \{ xs.len() }\n"
    compile_test_helpers.expect_no_error(src, "toplevel_list_lit", "E0301")
}
