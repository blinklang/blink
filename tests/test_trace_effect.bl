import std.fs
import compile_test_helpers

fn greet(name: Str) ! IO {
    io.println("hello {name}")
}

fn save(path: Str, data: Str) ! IO, FS.Write {
    io.println("saving to {path}")
    let _ = fs.write(path, data)
}

fn main() ! IO, FS.Write {
    greet("world")
    save("{compile_test_helpers.scratch_root()}/trace_test.txt", "test data")
}
