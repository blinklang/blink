// An argument of an effect event is a value string, so a value longer than 200 characters is
// cut to 200, and the event gets `"truncated":true` (§8.15.3).

import compile_test_helpers
import std.json.{json_clear, json_parse, json_get, json_as_str, json_as_bool}

let SRC = #"fn main() ! IO {
    let mut s = ""
    for _ in 0..250 { s = "{s}a" }
    io.println(s)
    io.println("short")
}
"#

test "an effect event cuts a long argument at 200 characters and says so" {
    let bin = compile_test_helpers.build_bin(SRC, "trace_effect_cut", ["--trace"])
    let r = process.run("env", ["BLINK_TRACE=event:effect", bin]).unwrap()
    compile_test_helpers.clean_bin("trace_effect_cut")
    assert(r.success())
    let mut seen: List[Str] = []
    for line in r.err_out.split("\n") {
        if !line.starts_with("\{") { continue }
        json_clear()
        let obj = json_parse(line)
        assert(obj >= 0)
        let msg = json_as_str(json_get(json_get(obj, "args"), "msg"))
        let t = json_get(obj, "truncated")
        let cut = t >= 0 && json_as_bool(t) == 1
        seen.push("{msg.len()} {cut}")
    }
    assert_eq(seen.join("\n"), "200 true\n5 false")
}
