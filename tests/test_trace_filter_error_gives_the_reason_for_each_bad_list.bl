// The check that `blink run` makes of a trace filter list before it builds (§8.15.5,
// §8.15.12). `all` is valid only when every item is `all`, `depth:` takes ASCII digits that
// fit in Int, a list with no items is good, and an unknown word gets the nearest known word
// as a did-you-mean.

import trace_filter.{trace_filter_error, trace_did_you_mean, trace_filter_has_items}

test "all is good alone or beside other all items only" {
    assert_eq(trace_filter_error("all"), "")
    assert_eq(trace_filter_error("all,"), "")
    assert_eq(trace_filter_error("all,all"), "")
    assert_eq(trace_filter_error(" all , all "), "")
    let why = "`all` cannot be used with another filter"
    assert_eq(trace_filter_error("all,fn:add"), why)
    assert_eq(trace_filter_error("fn:add,all"), why)
    assert_eq(trace_filter_error("all,fn:add,all"), why)
    assert_eq(trace_filter_error("fn:all"), "")
}

test "a bad item before all gives its own reason" {
    assert_eq(trace_filter_error("all,add"), "a filter is `key:value`, not `add`")
    assert_eq(trace_filter_error("add,all"), "a filter is `key:value`, not `add`")
}

test "depth takes ASCII digits that fit in Int" {
    assert_eq(trace_filter_error("depth:0"), "")
    assert_eq(trace_filter_error("depth:03"), "")
    assert_eq(trace_filter_error("depth:9223372036854775807"), "")
    assert_eq(trace_filter_error("depth:0009223372036854775807"), "")
    let digits = "depth takes digits only"
    assert_eq(trace_filter_error("depth:-1"), digits)
    assert_eq(trace_filter_error("depth:2x"), digits)
    assert_eq(trace_filter_error("depth:1+-1"), digits)
    let fit = "depth takes digits only, and the number must fit in Int"
    assert_eq(trace_filter_error("depth:9223372036854775808"), fit)
    assert_eq(trace_filter_error("depth:99999999999999999999"), fit)
}

test "a list with no items is good" {
    for value in ["", " ", ",", " , ", "\t,,\t"] {
        assert_eq(trace_filter_error(value), "")
    }
}

test "a list has items when one is not empty after the trim" {
    for value in ["", " ", ",", " , ", "\t,,\t"] {
        assert(!trace_filter_has_items(value))
    }
    for value in ["fn:add", " , all", "event:stat", "x"] {
        assert(trace_filter_has_items(value))
    }
}

test "each other bad item gives its reason" {
    assert_eq(trace_filter_error("1"), "a filter is `key:value`, not `1`")
    assert_eq(trace_filter_error("fn:"), "the key `fn` has no value")
    assert_eq(trace_filter_error("fn: + "), "the key `fn` has no value")
    assert_eq(trace_filter_error("nope:1"), "unknown key `nope`")
    assert_eq(trace_filter_error("modul:p"), "unknown key `modul`; did you mean `module`?")
    assert_eq(trace_filter_error("event:stat"), "unknown event type `stat`; did you mean `state`?")
    assert_eq(trace_filter_error("event:enter+bogus"), "unknown event type `bogus`")
}

test "did you mean takes the nearest word within a third of the length" {
    assert_eq(trace_did_you_mean("stat", ["enter", "exit", "state"]), "; did you mean `state`?")
    assert_eq(trace_did_you_mean("x", ["fn"]), "")
    assert_eq(trace_did_you_mean("fx", ["fn"]), "; did you mean `fn`?")
    assert_eq(trace_did_you_mean("exot", ["exit", "enter"]), "; did you mean `exit`?")
    assert_eq(trace_did_you_mean("zzzzzz", ["enter", "exit"]), "")
}
