// A `fn:` filter matches a function by whole dot segments from the end of its name (§8.15.5). A filter
// value longer than the name it is held against must not make the matcher read before the
// start of that name. The name is on the heap here, so AddressSanitizer stops the program
// on any such read.

import compile_test_helpers
import std.process.{ProcessResult}

let C_SRC = "#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <stdarg.h>
#include <time.h>
#include <errno.h>
#define BLINK_RT_FN static
#define BLINK_UNUSED __attribute__((unused))
typedef struct blink_arena_t blink_arena_t;
static blink_arena_t* __blink_current_arena;
#include \"runtime_trace.h\"
static char* heap(const char* s) \{
    char* p = malloc(strlen(s) + 1);
    memcpy(p, s, strlen(s) + 1);
    return p;
\}
int main(void) \{
    setenv(\"BLINK_TRACE\", \"fn:a_filter_value_longer_than_the_name\", 1);
    blink_trace_init(0, NULL);
    char* fn = heap(\"m.f\");
    char* m = heap(\"m\");
    printf(\"%d\\n\", blink_trace_match(fn, m, 0));
    setenv(\"BLINK_TRACE\", \"fn:f\", 1);
    blink_trace_init(0, NULL);
    printf(\"%d\\n\", blink_trace_match(fn, m, 0));
    free(fn);
    free(m);
    return 0;
\}
"

test "a fn filter longer than the function name reads nothing before the name" {
    let dir = compile_test_helpers.scratch_root()
    let src = "{dir}/_trace_fn_filter_long.c"
    let bin = "{dir}/_trace_fn_filter_long"
    fs.write(src, C_SRC).unwrap()
    let cc = process.run("cc", ["-fsanitize=address", "-g", "-Ibootstrap", src, "-o", bin]).unwrap()
    assert_eq(cc.err_out, "")
    assert(cc.success())
    let r: ProcessResult = process.run(bin, []).unwrap()
    assert_eq(r.err_out, "")
    assert_eq(r.out, "0\n1\n")
    assert(r.success())
    compile_test_helpers.sh("rm -f {src} {bin}")
}
