// The compiler reads BLINK_TRACE_CHANNELS itself in a few places that must know whether a
// channel is on (a message that renders types, the build cache). That read must agree with
// the runtime's reading for trace.log (§8.15.7): split on `,`, trim ASCII space and tab from
// the two ends of each item, skip an empty item, match by exact text, and `all` anywhere turns
// on every channel.

import ast.{trace_gate_read, trace_gate_on, trace_gate_items}

fn on_with(value: Str, ch: Str) -> Bool {
    trace_gate_read(value)
    trace_gate_on(ch)
}

test "a single item turns on its channel only" {
    assert(on_with("blink.mono", "blink.mono"))
    assert(!on_with("blink.mono", "blink.walk"))
}

test "items are trimmed of space and tab at their two ends" {
    assert(on_with("blink.mono, blink.walk", "blink.walk"))
    assert(on_with("\tblink.walk \t,x", "blink.walk"))
}

test "empty items are skipped" {
    trace_gate_read("blink.mono,,blink.walk,")
    assert_eq(trace_gate_items.join("|"), "blink.mono|blink.walk")
    trace_gate_read(" , ")
    assert_eq(trace_gate_items.len(), 0)
    assert(!trace_gate_on(""))
}

test "all anywhere in the list turns on every channel" {
    assert(on_with("all", "blink.mono"))
    assert(on_with("blink.walk,all", "blink.mono"))
    assert(on_with("x, all ", "blink.mono"))
}

test "a match is by exact text, and case counts" {
    assert(!on_with("Blink.mono", "blink.mono"))
    assert(!on_with("blink.mon", "blink.mono"))
    assert(!on_with("mono", "blink.mono"))
    assert(on_with("mo no", "mo no"))
    assert(!on_with("All", "blink.mono"))
}

test "an empty value turns on nothing" {
    assert(!on_with("", "blink.mono"))
}
