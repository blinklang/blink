    assert(direct.contains("`msg` calls `plain`, which writes `count`"), direct)
    let rowed = found.get(1).unwrap()
    assert(primary_at(rowed, 19, 22), rowed)
    assert(rowed.contains("`plus` has the row `! IO`"), rowed)
    let callee = found.get(2).unwrap()
