test "a nested trace.log in msg charges no row of the enclosing fn, its channel too" {
    let src = #"fn chan_io() -> Str ! IO { "c" }

fn io_fn() -> Int ! IO { 1 }

fn f() -> Int {
    trace.log("c", {
        trace.log(chan_io(), "inner")
        "outer"
    })
    0
}

fn g() -> Int {
    trace.log("c", {
        let h = fn() -> Int { io_fn() }
        trace.log("d", "inner {h()}")
        "x"
    })
    0
}

fn main() ! IO {
    let _ = f()
    let _ = g()
}
"#
    let out = check_via_cli(src, "e0566_nested_trace_row_{getpid()}")
    assert_eq(code_lines(out, "E0500").len(), 0)
    let found = e0566_lines(out)
    assert_eq(found.len(), 3)
    assert_eq(error_count(out), 3)
    let chan = found.get(0).unwrap()
    assert(primary_at(chan, 7, 19), chan)
    assert(chan.contains("`msg` calls `chan_io`, which has a row"), chan)
    let ran = found.get(1).unwrap()
    assert(primary_at(ran, 16, 32), ran)
    assert(ran.contains("`msg` runs `h`, which has a row"), ran)
    // The outer msg runs `h` too, through the nested one, and `h` is its own literal.
    let outer = found.get(2).unwrap()
    assert(primary_at(outer, 15, 31), outer)
    assert(outer.contains("`msg` calls `io_fn`, which has a row"), outer)
}

