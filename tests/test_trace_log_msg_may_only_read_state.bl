}

test "a with item method whose short call path reaches a fn that another method met at the depth cap is walked" {
    let mut parts = ["let mut count = 0\n\nfn hh() \{\n    count += 1\n\}\n\nfn ff() \{\n    hh()\n\}\n"]
    let mut i = 1
    while i < 63 {
        parts.push("\nfn a{i}() \{\n    a{i + 1}()\n\}\n")
        i = i + 1
    }
    parts.push("\nfn a63() \{\n    ff()\n\}\n\ntype T \{ n: Int \}\n\nimpl BlockHandler for T \{\n    type Context = ()\n")
    parts.push("    fn enter(self) -> () \{ a1() \}\n    fn exit(self, _ok: Bool) \{ ff() \}\n\}\n")
    parts.push("\nfn main() \{\n    trace.log(\"c\", \{\n        with T \{ n: 1 \} \{ let _ = 0 \}\n        \"x\"\n    \})\n\}\n")
    let e = only_e0566(check_via_cli(parts.join(""), "e0566_with_depth_cap_{getpid()}"))
    assert(e.contains("`msg` runs `T.exit`, which writes `count`"), e)
}

test "a fn value that msg passes as the init of fold is not run" {
    let src = #"fn shout(x: Int) -> Int ! IO {
    io.println("x")
    x
}

fn add(acc: Int, x: Int) -> Int ! IO {
    io.println("x")
    acc + x
}

fn one(f: fn(Int) -> Int) -> Int { 1 }

fn walk() ! IO {
    let fs = [shout]
    let k = fn(x: Int) -> Int { shout(x) }
    trace.log("c", "{one(fs.fold(shout, fn(acc: fn(Int) -> Int, f: fn(Int) -> Int) -> fn(Int) -> Int { f }))}")
    trace.log("c", "{one(fs.fold(fn(x: Int) -> Int { shout(x) }, fn(acc: fn(Int) -> Int, f: fn(Int) -> Int) -> fn(Int) -> Int { f }))}")
    trace.log("c", "{one(fs.fold(k, fn(acc: fn(Int) -> Int, f: fn(Int) -> Int) -> fn(Int) -> Int { f }))}")
    trace.log("c", "{[1, 2].fold(0, add)}")
}

fn main() ! IO {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_msg_fold_init_{getpid()}")
    let e = only_e0566(out)
    assert(primary_at(e, 19, 22), e)
    assert(e.contains("`msg` calls `add`, which has a row"), e)
}

