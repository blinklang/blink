    assert(mapped.contains("`msg` calls `go`, which writes `count`"), mapped)
    let folded = found.get(1).unwrap()
    assert(primary_at(folded, 24, 22), folded)
    assert(folded.contains("`msg` calls `add`, which writes `count`"), folded)
}

