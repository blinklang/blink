test "a generic named fn that msg passes to map or fold is walked at the element type" {
    let src = #"let mut count = 0

trait Bump {
    fn bump(self) -> Int
}

impl Bump for Int {
    fn bump(self) -> Int {
        count += self
        count
    }
}

impl Bump for Str {
    fn bump(self) -> Int { self.len() }
}

fn go[T: Bump](x: T) -> Int { x.bump() }

fn add[T: Bump](acc: Int, x: T) -> Int { acc + x.bump() }

fn walk() {
    trace.log("c", "{[1].map(go).len()}")
    trace.log("c", "{[1].fold(0, add)}")
    trace.log("c", "{["a"].map(go).len()}")
    trace.log("c", "{["a"].fold(0, add)}")
}

fn main() {
    walk()
}
