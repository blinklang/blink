}

test "the closures that a closure of an outer msg runs, when a nested msg runs it, charge no row" {
    let src = #"fn io_fn() -> Int ! IO { 1 }

fn chained() -> Int {
    trace.log("a", {
        let e = fn() -> Int { io_fn() }
        let d = fn() -> Int { e() }
        let c = fn() -> Int { d() }
        trace.log("b", "{c()}")
        "a"
    })
    0
}

fn mapped() -> Int {
    trace.log("a", {
        let d = fn(x: Int) -> Int { io_fn() + x }
        let c = fn() -> Int { [1].map(d).len() }
        trace.log("b", "{c()}")
        "a"
    })
    0
}

fn main() ! IO {
    let _ = chained()
    let _ = mapped()
}
"#
    let out = check_via_cli(src, "e0566_nested_run_chain_{getpid()}")
    assert_eq(code_lines(out, "E0500").len(), 0)
    let found = e0566_lines(out)
    assert_eq(found.len(), 4)
    assert_eq(error_count(out), 4)
    let chained = found.get(0).unwrap()
    assert(primary_at(chained, 8, 26), chained)
    assert(chained.contains("`msg` runs `c`, which has a row"), chained)
    // The outer msg runs the chain too, and walks its own literals down to the call.
    let chained_outer = found.get(1).unwrap()
    assert(primary_at(chained_outer, 5, 31), chained_outer)
    assert(chained_outer.contains("`msg` calls `io_fn`, which has a row"), chained_outer)
    let mapped = found.get(2).unwrap()
    assert(primary_at(mapped, 18, 26), mapped)
    assert(mapped.contains("`msg` runs `c`, which has a row"), mapped)
    let mapped_outer = found.get(3).unwrap()
    assert(primary_at(mapped_outer, 16, 37), mapped_outer)
    assert(mapped_outer.contains("`msg` calls `io_fn`, which has a row"), mapped_outer)
}

