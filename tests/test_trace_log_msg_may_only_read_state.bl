let cb = fn() -> Int {
    count += 1
    count
}
let mut cbm = fn() -> Int { 1 }
let step = fn(x: Int) -> Int {
    count += x
    count
}

fn walk() {
    trace.log("c", "{cb()}")
    trace.log("c", "{cbm()}")
    trace.log("c", "{[1].map(step).len()}")
}

fn main() {
    cbm = fn() -> Int {
        count += 1
        count
    }
    walk()
}
