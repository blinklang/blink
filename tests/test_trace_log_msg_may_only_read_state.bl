}

fn walk() ! IO {
    trace.log("c", "{[1].fold(init: 0, plain)}")
    trace.log("c", "{[1].fold(init: 0, plus)}")
    trace.log("c", "{inner()}")
}

fn main() ! IO {
    walk()
}
