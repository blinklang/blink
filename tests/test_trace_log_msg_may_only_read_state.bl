test "a closure literal msg assigns and runs through a closure declared outside it is walked as msg" {
    let src = #"fn io_fn() -> Int ! IO { 1 }

fn writes() -> Int {
    let mut x = 0
    let mut g = fn() -> Int { 0 }
    let k = fn() -> Int { g() }
    trace.log("a", {
        g = fn() -> Int {
            x = 1
            0
        }
        "{k()}"
    })
    x
}

fn rowed() -> Int {
    let mut g = fn() -> Int { 0 }
    let k = fn() -> Int { g() }
    trace.log("a", {
        g = fn() -> Int { io_fn() }
        "{k()}"
    })
    0
}

fn main() ! IO {
    let _ = writes()
    let _ = rowed()
}
"#
    let out = check_via_cli(src, "e0566_literal_run_through_outside_{getpid()}")
    assert_eq(code_lines(out, "E0500").len(), 0)
    let found = e0566_lines(out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 8, 9) && e.contains("`msg` writes `g`") }), out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 9, 13) && e.contains("`msg` writes `x`") }), out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 21, 27) && e.contains("`msg` calls `io_fn`, which has a row") }), out)
}

test "a closure literal of an outer msg that a nested msg runs is walked as the outer msg" {
    let src = #"fn io_fn() -> Int ! IO { 1 }

fn direct() -> Int {
    let mut x = 0
    trace.log("a", {
        let h = fn() -> Int {
            x = 1
            0
        }
        trace.log("b", "{h()}")
        "s"
    })
    x
}

fn through_outside() -> Int {
    let mut xs = [0]
    let mut g = fn() -> Int { 0 }
    let k = fn() -> Int { g() }
    trace.log("a", {
        g = fn() -> Int {
            xs.push(1)
            io_fn()
        }
        trace.log("b", "{k()}")
        "s"
    })
    xs.len()
}

fn writes_outer_local() -> Int {
    trace.log("a", {
        let mut y = 0
        let h = fn() -> Int {
            y = 1
            y
        }
        trace.log("b", "{h()}")
        "s"
    })
    0
}

fn main() ! IO {
    let _ = direct()
    let _ = through_outside()
    let _ = writes_outer_local()
}
"#
    let out = check_via_cli(src, "e0566_outer_literal_nested_run_{getpid()}")
    assert_eq(code_lines(out, "E0500").len(), 0)
    let found = e0566_lines(out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 7, 13) && e.contains("`msg` writes `x`") }), out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 21, 9) && e.contains("`msg` writes `g`") }), out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 22, 13) && e.contains("`xs`") }), out)
    assert(found.any(fn(e: Str) -> Bool { primary_at(e, 23, 13) && e.contains("`msg` calls `io_fn`, which has a row") }), out)
    assert_eq(found.filter(fn(e: Str) -> Bool { e.contains("`y`") }).len(), 0)
    assert(!found.any(fn(e: Str) -> Bool { primary_at(e, 35, 13) }), out)
}

test "a named fn that msg passes to a built-in that runs its callback is checked as a call of it" {
    let src = #"let mut count = 0

fn shout(x: Int) -> Int ! IO {
    io.println("x")
    x
}

fn bump(x: Int) -> Int {
    count += x
    count
}

fn peek(x: Int) -> Int { x + count }

fn walk() ! IO {
    let g = shout
    trace.log("c", "{[1].map(shout).len()}")
    trace.log("c", "{[1].map(bump).len()}")
    trace.log("c", "{[1].map(peek).len()}")
    trace.log("c", "{[1].map(g).len()}")
}

fn main() ! IO {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_msg_named_fn_callback_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 4)
    assert_eq(error_count(out), 4)
    let rowed = found.get(0).unwrap()
    assert(primary_at(rowed, 17, 22), rowed)
    assert(rowed.contains("`msg` calls `shout`, which has a row"), rowed)
    assert(rowed.contains("`shout` has the row `! IO`"), rowed)
    let written = found.get(1).unwrap()
    assert(primary_at(written, 18, 22), written)
    assert(written.contains("`msg` calls `bump`, which writes `count`"), written)
    let read = found.get(2).unwrap()
    assert(primary_at(read, 19, 22), read)
    assert(read.contains("`msg` calls `peek`, which reads `count`"), read)
    let through = found.get(3).unwrap()
    assert(primary_at(through, 20, 22), through)
    assert(through.contains("`msg` calls `shout`, which has a row"), through)
}

