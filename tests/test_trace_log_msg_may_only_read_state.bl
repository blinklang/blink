    assert(held.contains("`msg` runs `cb`, which writes `count`"), held)
    let assigned = found.get(1).unwrap()
    assert(primary_at(assigned, 15, 22), assigned)
    assert(assigned.contains("`msg` runs `cbm`, which writes `count`"), assigned)
    let mapped = found.get(2).unwrap()
    assert(primary_at(mapped, 16, 22), mapped)
    assert(mapped.contains("`msg` runs `step`, which writes `count`"), mapped)
}

// A qualified call has no callee node, so the check reads the `let` from the call itself.
test "a msg that calls a module let closure through its module qualifier runs the closure it holds" {
    let helper = #"pub let say = fn() -> Int {
    io.println("said")
    1
}
let mut count = 0
pub let bump = fn() -> Int {
    count += 1
    count
}
"#
    let entry = #"import st

fn main() {
    trace.log("c", "{st.say()}")
    trace.log("c", "{st.bump()}")
}
"#
    let out = check_package(entry, "st", helper, "e0566_qualified_let_closure_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert_eq(error_count(out), 2)
    let row = found.get(0).unwrap()
    assert(row.contains("`msg` runs `st.say`, which has a row"), row)
    assert(row.contains("`st.say` calls `io.println`, a handler operation"), row)
    let wrote = found.get(1).unwrap()
    assert(wrote.contains("`msg` runs `st.bump`, which writes `count`"), wrote)
}

// The closure a `let mut` holds can change, so a call of it reads the `let mut`.
test "a fn that calls a module let mut closure reads it, through a bare name or a module qualifier" {
