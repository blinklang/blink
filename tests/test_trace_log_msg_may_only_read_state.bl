// `msg` of `trace.log` runs only when its channel is on, so it may only read state: a direct
// read of a module `let` or `let mut`, and calls of fns with an empty row
// (sections/06_tooling.md §8.15.7 *`msg` is lazy*). A write to state, a call of a fn that has a
// row, and any handler operation in `msg` is TraceMessageEffect (E0566), with the primary span
// on the offending expression.

import compile_test_helpers.{check_via_cli, scratch_root, verify_catalog_entry}

fn e0566_lines(out: Str) -> List[Str] {
    let mut found: List[Str] = []
    for line in out.split("\n") {
        if line.contains("\"code\":\"E0566\"") { found.push(line) }
    }
    found
}

fn error_count(out: Str) -> Int {
    let mut n = 0
    for line in out.split("\n") {
        if line.contains("\"severity\":\"error\"") { n = n + 1 }
    }
    n
}

// The one E0566 line, after a check that the report holds that error and no other.
fn only_e0566(out: Str) -> Str {
    let found = e0566_lines(out)
    assert_eq(found.len(), 1)
    assert_eq(error_count(out), 1)
    found.get(0).unwrap()
}

// `blink check` of a package of two files, the entry and a helper module it imports.
fn check_package(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str) -> Str ! FS.Write, Process.Spawn, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let _mk = process.run("mkdir", ["-p", "{root}/src"]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{root}/src/{helper_name}.bl", helper_src).unwrap()
    fs.write("{root}/src/{tag}.bl", entry_src).unwrap()
    let result = process.run("build/blink", ["check", "{root}/src/{tag}.bl", "--format", "json"]).unwrap()
    "{result.out}{result.err_out}"
}

fn primary_at(entry: Str, line: Int, col: Int) -> Bool {
    entry.contains("\"line\":{line},\"col\":{col}")
}

test "blink explain E0566 names TraceMessageEffect" {
    verify_catalog_entry("E0566", "TraceMessageEffect")
}

test "msg may read module bindings and call fns with an empty row" {
    let src = #"let limit = 3
let mut depth = 0

fn twice(n: Int) -> Int { n * 2 }

fn boom() -> Str {
    panic("only when the channel is on")
}

fn show(f: fn() -> Int) -> Int {
    trace.log("c", "f={f()}")
    f()
}

fn walk(n: Int) -> Int {
    trace.log("c", "limit={limit} depth={depth}")
    trace.log("c", "twice={twice(depth)}")
    trace.log("c", if depth > 0 { boom() } else { "none" })
    trace.log("c", match n {
        0 => "zero"
        _ => "n={n + limit}"
    })
    trace.log("c", {
        let pick = fn() { depth + 1 }
        "pick={pick()}"
    })
    trace.log("outer", {
        trace.log("inner", "depth={depth}")
        "x"
    })
    n
}

fn main() {
    depth = 1
    let _ = walk(1)
    let _ = show(fn() { 4 })
}
"#
    let out = check_via_cli(src, "e0566_reads_ok_{getpid()}")
    assert(!out.contains("\"severity\":\"error\""), out)
}

test "a handler operation in msg is E0566" {
    let src = #"fn walk(n: Int) -> Int {
    trace.log("walk", "dir={env.cwd()}")
    n
}

fn main() {
    let _ = walk(1)
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_env_cwd_{getpid()}"))
    assert(primary_at(e, 2, 29), e)
    assert(e.contains("`msg` calls `env.cwd`, a handler operation"), e)
}

test "a handler operation in msg is E0566 in main too" {
    let src = #"fn main() ! IO {
    trace.log("c", {
        io.println("x")
        "m"
    })
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_io_main_{getpid()}"))
    assert(primary_at(e, 3, 9), e)
    assert(e.contains("`msg` calls `io.println`, a handler operation"), e)
}

test "an operation of a user effect in msg is E0566" {
    let src = #"effect Metrics {
    effect Emit {
        fn count(name: Str, n: Int) -> Int
    }
}

fn walk() -> Int ! Metrics.Emit {
    trace.log("c", "n={metrics.count("w", 2)}")
    1
}

fn main() {
    let _ = walk()
}
"#
    let out = check_via_cli(src, "e0566_user_op_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 1)
    let e = found.get(0).unwrap()
    assert(primary_at(e, 8, 24), e)
    assert(e.contains("a handler operation"), e)
}

test "a call of a fn with a row is E0566 and not E0500" {
    let src = #"let mut depth = 0

fn next_id() -> Int ! State {
    depth
}

fn walk(n: Int) -> Int {
    trace.log("walk", "next={next_id()}")
    n
}

fn main() {
    let _ = walk(1)
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_next_id_{getpid()}"))
    assert(primary_at(e, 8, 30), e)
    assert(e.contains("`msg` calls `next_id`, which has a row"), e)
}

test "a call of a method with a row is E0566" {
    let src = #"type Probe { n: Int }

trait Labeled {
    fn label(self) -> Str ! IO
}

impl Labeled for Probe {
    fn label(self) -> Str ! IO {
        io.println("probe")
        "p{self.n}"
    }
}

fn walk(p: Probe) ! IO {
    trace.log("c", "p={p.label()}")
}

fn main() ! IO {
    walk(Probe { n: 1 })
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_method_row_{getpid()}"))
    assert(e.contains("`msg` calls `label`, which has a row"), e)
}

test "a call of an ffi decl with the row FFI is E0566" {
    let src = #"@ffi("c", "getpid")
fn libc_getpid() -> I32 ! FFI

fn walk() {
    trace.log("c", "pid={libc_getpid()}")
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_ffi_row_{getpid()}"))
    assert(primary_at(e, 5, 26), e)
    assert(e.contains("`msg` calls `libc_getpid`, which has a row"), e)
}

test "a write to a module let mut in msg is E0566" {
    let src = #"let mut depth = 0

fn walk() {
    trace.log("c", {
        depth = 1
        "x"
    })
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_module_write_{getpid()}"))
    assert(primary_at(e, 5, 9), e)
    assert(e.contains("`msg` writes `depth`"), e)
}

test "a bad msg of a trace.log nested in msg is still E0566" {
    let src = #"fn walk() {
    trace.log("outer", {
        trace.log("inner", "dir={env.cwd()}")
        "x"
    })
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_nested_{getpid()}"))
    assert(primary_at(e, 3, 34), e)
    assert(e.contains("`msg` calls `env.cwd`, a handler operation"), e)
}

test "a call of a fn that writes a module let mut is E0566" {
    let src = #"let mut depth = 0

fn bump() -> Int {
    depth = depth + 1
    depth
}

fn walk() {
    trace.log("walk", "d={bump()}")
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_bump_{getpid()}"))
    assert(primary_at(e, 9, 27), e)
    assert(e.contains("`msg` calls `bump`, which writes `depth`"), e)
}

test "a call of a fn that reads a module let mut is E0566" {
    let src = #"let mut depth = 0

fn level() -> Int {
    depth * 2
}

fn walk() {
    trace.log("walk", "l={level()}")
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_reader_{getpid()}"))
    assert(primary_at(e, 8, 27), e)
    assert(e.contains("`msg` calls `level`, which reads `depth`"), e)
}

test "a fn that changes module state through a callee is E0566 in msg" {
    let src = #"let mut seen: List[Int] = []

fn note(n: Int) -> Int {
    seen.push(n)
    n
}

fn tag(n: Int) -> Str {
    "n={note(n)}"
}

fn walk() {
    trace.log("walk", tag(1))
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_transitive_{getpid()}"))
    assert(primary_at(e, 13, 23), e)
    assert(e.contains("`msg` calls `tag`, which writes `seen`"), e)
}

test "a fn that reads a module let only or its own locals is allowed in msg" {
    let src = #"let limit = 3

fn spread(n: Int) -> Int {
    let mut total = 0
    for i in 0..n { total = total + i * limit }
    total
}

fn walk() {
    trace.log("walk", "s={spread(4)}")
}

fn main() {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_local_mut_ok_{getpid()}")
    assert(!out.contains("\"severity\":\"error\""), out)
}

test "the walk example of the spec gives its three errors" {
    let src = #"let mut depth = 0

fn next_id() -> Int ! State {
    depth
}

fn bump() -> Int {
    depth = depth + 1
    depth
}

fn walk(n: Int) -> Int {
    trace.log("walk", "depth={depth}")
    trace.log("walk", "dir={env.cwd()}")
    trace.log("walk", "next={next_id()}")
    trace.log("walk", "d={bump()}")
    n
}

fn main() {
    let _ = walk(1)
}
"#
    let out = check_via_cli(src, "e0566_walk_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 3)
    assert_eq(error_count(out), 3)
    let cwd = found.get(0).unwrap()
    assert(primary_at(cwd, 14, 29), cwd)
    assert(cwd.contains("`msg` calls `env.cwd`, a handler operation"), cwd)
    let next = found.get(1).unwrap()
    assert(primary_at(next, 15, 30), next)
    assert(next.contains("`msg` calls `next_id`, which has a row"), next)
    let bump = found.get(2).unwrap()
    assert(primary_at(bump, 16, 27), bump)
    assert(bump.contains("`msg` calls `bump`, which writes `depth`"), bump)
}

test "a with item in msg whose enter and exit have a row is E0566" {
    let src = #"effect Note {
    effect Say {
        fn say(s: Str)
    }
}

type T { n: Int }

impl BlockHandler for T {
    type Context = ()
    fn enter(self) -> () ! Note.Say { note.say("enter {self.n}") }
    fn exit(self, _ok: Bool) ! Note.Say { note.say("exit {self.n}") }
}

fn walk() {
    trace.log("c", {
        with T { n: 1 } { let _ = 0 }
        "x"
    })
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_with_enter_{getpid()}"))
    assert(primary_at(e, 17, 14), e)
    assert(e.contains("`msg` runs `T.enter` and `T.exit`, which have a row"), e)
}

test "a with item in msg whose close has a row is E0566" {
    let src = #"type Log { name: Str }

impl Closeable for Log {
    fn close(self) ! IO.Print { io.println("closed {self.name}") }
}

fn walk() {
    trace.log("c", {
        with Log { name: "a" } as l { let _ = l.name }
        "x"
    })
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_with_close_row_{getpid()}"))
    assert(primary_at(e, 9, 14), e)
    assert(e.contains("`msg` runs `Log.close`, which has a row"), e)
}

test "a with item whose close writes a module let mut is E0566 in msg and in a callee" {
    let src = #"let mut count = 0

type Quiet { name: Str }

impl Closeable for Quiet {
    fn close(self) { count += self.name.len() }
}

fn shut_one() -> Int {
    with Quiet { name: "a" } { }
    1
}

fn walk() {
    trace.log("c", {
        with Quiet { name: "a" } { }
        "x"
    })
    trace.log("c", "{shut_one()}")
}

fn main() {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_with_close_write_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert_eq(error_count(out), 2)
    let direct = found.get(0).unwrap()
    assert(primary_at(direct, 16, 14), direct)
    assert(direct.contains("`msg` runs `Quiet.close`, which writes `count`"), direct)
    let callee = found.get(1).unwrap()
    assert(primary_at(callee, 19, 22), callee)
    assert(callee.contains("`msg` calls `shut_one`, which writes `count`"), callee)
}

test "a generic fn whose bound method's impl touches a module let mut is E0566 in msg" {
    let src = #"let mut count = 0

trait Show {
    fn show(self) -> Str
}

type A { x: Int }

impl Show for A {
    fn show(self) -> Str { "{count}{self.x}" }
}

type Quiet { name: Str }

impl Closeable for Quiet {
    fn close(self) { count += self.name.len() }
}

fn gen[T: Show](t: T) -> Str { t.show() }

fn outer[T: Show](t: T) -> Str { gen(t) }

fn shut[T: Closeable](t: T) ! _ { t.close() }

fn walk() {
    trace.log("c", "{gen(A { x: 1 })}")
    trace.log("c", "{outer(A { x: 2 })}")
    trace.log("c", {
        shut(Quiet { name: "b" })
        "x"
    })
}

fn main() {
    count = 1
    walk()
}
"#
    let out = check_via_cli(src, "e0566_bound_impl_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 3)
    assert_eq(error_count(out), 3)
    let read = found.get(0).unwrap()
    assert(primary_at(read, 26, 22), read)
    assert(read.contains("`msg` calls `gen`, which reads `count`"), read)
    let deep = found.get(1).unwrap()
    assert(primary_at(deep, 27, 22), deep)
    assert(deep.contains("`msg` calls `outer`, which reads `count`"), deep)
    let write = found.get(2).unwrap()
    assert(primary_at(write, 29, 9), write)
    assert(write.contains("`msg` calls `shut`, which writes `count`"), write)
}

test "a generic fn in msg is E0566 only at a type whose impl touches a module let mut" {
    let src = #"let mut count = 0

trait Show {
    fn show(self) -> Str
}

type A { x: Int }

impl Show for A {
    fn show(self) -> Str { "{count}{self.x}" }
}

type B { y: Int }

impl Show for B {
    fn show(self) -> Str { "{self.y}" }
}

fn gen[T: Show](t: T) -> Str { t.show() }

fn both() -> Str { "{gen(B { y: 1 })}{gen(A { x: 2 })}" }

fn walk() {
    trace.log("c", "{gen(B { y: 3 })}")
    trace.log("c", "{both()}")
}

fn main() {
    count = 1
    walk()
}
"#
    let out = check_via_cli(src, "e0566_bound_instance_{getpid()}")
    let found = only_e0566(out)
    assert(primary_at(found, 25, 22), found)
    assert(found.contains("`msg` calls `both`, which reads `count`"), found)
}

test "an op of the rand handle in msg is E0566 as a handler operation" {
    let src = #"fn walk() {
    trace.log("c", "{rand.int(1..=6)}")
    trace.log("c", "{rand.bytes(2).len()}")
}

fn main() {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_rand_op_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert_eq(error_count(out), 2)
    let int_op = found.get(0).unwrap()
    assert(primary_at(int_op, 2, 22), int_op)
    assert(int_op.contains("`msg` calls `rand.int`, a handler operation"), int_op)
    let bytes_op = found.get(1).unwrap()
    assert(primary_at(bytes_op, 3, 22), bytes_op)
    assert(bytes_op.contains("`msg` calls `rand.bytes`, a handler operation"), bytes_op)
}

test "msg names a call or write through a module qualifier as the source spells it" {
    let helper = #"pub let mut counter = 0

pub fn get() -> Int ! IO { 1 }

pub fn level() -> Int { counter }
"#
    let entry = #"import st

fn peek() -> Int { st.counter }

fn main() ! IO {
    trace.log("c", "{st.get()}")
    trace.log("c", "{st.level()}")
    trace.log("c", "{peek()}")
    trace.log("c", {
        st.counter = 1
        "x"
    })
}
"#
    let out = check_package(entry, "st", helper, "e0566_qualified_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 4)
    assert_eq(error_count(out), 4)
    let row = found.get(0).unwrap()
    assert(row.contains("`msg` calls `st.get`, which has a row"), row)
    assert(row.contains("`st.get` has the row `! IO`"), row)
    let read = found.get(1).unwrap()
    assert(read.contains("`msg` calls `st.level`, which reads `counter`"), read)
    let deep = found.get(2).unwrap()
    assert(deep.contains("`msg` calls `peek`, which reads `st.counter`"), deep)
    let write = found.get(3).unwrap()
    assert(write.contains("`msg` writes `st.counter`"), write)
}
