    x
}

type B {
    fold: fn(Int, fn(Int, Int) -> Int) -> Int
    map: fn(fn(Int) -> Int) -> Int
    any: fn(fn(Int) -> Int) -> Int
    apply: fn(fn(Int) -> Int) -> Int
}

fn keep(a: Int, f: fn(Int, Int) -> Int) -> Int { a }

fn hold(f: fn(Int) -> Int) -> Int { 1 }

fn mk() -> B {
    B { fold: keep, map: hold, any: hold, apply: hold }
}

fn walk() {
    let b = mk()
    trace.log("c", "{b.fold(1, writer)}")
    trace.log("c", "{b.map(wm)}")
    trace.log("c", "{b.any(wm)}")
    trace.log("c", "{mk().map(wm)}")
    trace.log("c", "{b.apply(wm)}")
}

fn main() {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_msg_fn_field_named_like_builtin_{getpid()}")
    assert_eq(e0566_lines(out).len(), 0)
    assert_eq(error_count(out), 0)
}

