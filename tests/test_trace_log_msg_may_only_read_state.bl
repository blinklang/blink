}

test "a with item on a local named arena in a closure that msg runs counts its close row" {
    let src = #"type Loud { name: Str }

impl Closeable for Loud {
    fn close(self) ! IO.Print { io.println("closed {self.name}") }
}

fn direct() ! IO.Print {
    let arena = Loud { name: "a" }
    trace.log("c", {
        with arena as l { l.name }
    })
}

fn outside() ! IO.Print {
    let arena = Loud { name: "a" }
    let c = fn() -> Str {
        with arena as l { l.name }
    }
    trace.log("c", "{c()}")
}

fn main() ! IO {
    direct()
    outside()
}
"#
    let out = check_via_cli(src, "e0566_arena_local_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert_eq(error_count(out), 2)
    let direct = found.get(0).unwrap()
    assert(primary_at(direct, 10, 14), direct)
    assert(direct.contains("`msg` runs `Loud.close`, which has a row"), direct)
    let outside = found.get(1).unwrap()
    assert(primary_at(outside, 19, 22), outside)
    assert(outside.contains("`msg` runs `c`, which has a row"), outside)
    assert(outside.contains("`c` runs `Loud.close`, which has the row `! IO.Print`"), outside)
}

