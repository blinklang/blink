test "a trait method with a row State or _ at a binder of the caller is E0566 for every impl" {
    let src = #"trait Tick {
    fn tick(self) -> Int ! State
}

impl Tick for Str {
    fn tick(self) -> Int ! State { 0 }
}

trait Open {
    fn open(self) -> Int ! _
}

impl Open for Str {
    fn open(self) -> Int { 0 }
}

fn go[T: Tick](x: T) -> Int ! State { x.tick() }

fn so[T: Open](x: T) -> Int ! _ { x.open() }

fn at_state[U: Tick](x: U, xs: List[U]) ! State {
    trace.log("c", "{x.tick()}")
    trace.log("c", "{go(x)}")
    trace.log("c", "{xs.map(go).len()}")
}

fn at_wild[U: Open](x: U, xs: List[U]) ! _ {
    trace.log("c", "{x.open()}")
    trace.log("c", "{so(x)}")
    trace.log("c", "{xs.map(so).len()}")
}

fn main() ! State {
    at_state("a", ["a"])
    at_wild("a", ["a"])
}
"#
    let out = check_via_cli(src, "e0566_msg_trait_row_at_binder_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 6)
    assert(found.get(0).unwrap().contains("`tick` has the row `! State`"), found.get(0).unwrap())
    assert(found.get(1).unwrap().contains("`go` has the row `! State`"), found.get(1).unwrap())
    assert(found.get(2).unwrap().contains("`go` has the row `! State`"), found.get(2).unwrap())
    assert(found.get(3).unwrap().contains("`open` has the row `! _`"), found.get(3).unwrap())
    assert(found.get(4).unwrap().contains("`so` has the row `! _`"), found.get(4).unwrap())
    assert(found.get(5).unwrap().contains("`so` has the row `! _`"), found.get(5).unwrap())
}

test "a closure that msg passes to Bytes with_ptr runs there and is held to the msg rule" {
    let src = #"let mut count = 0

@trusted(audit: "probe")
fn walk() {
    let by = Bytes.new()
    trace.log("c", "{by.with_ptr(fn(p: Ptr[U8]) -> Int { 1 })}")
    trace.log("c", "{by.with_ptr(fn(p: Ptr[U8]) -> Int {
        count += 1
        1
    })}")
}

fn main() {
    walk()
}
"#
    let e = only_e0566(check_via_cli(src, "e0566_msg_bytes_with_ptr_{getpid()}"))
    assert(primary_at(e, 8, 9), e)
    assert(e.contains("`msg` writes `count`"), e)
}

test "a with item in msg names the first method that reads, and a let mut binding its first closure with a touch" {
    let src = #"let mut a = 0

let mut b = 0

fn ra() -> Int { a }

fn r2() -> Int { ra() }

type T1 { n: Int }

impl BlockHandler for T1 {
    type Context = ()
    fn enter(self) -> () { let _ = r2() }
    fn exit(self, _ok: Bool) { let _ = b }
}

fn walk() {
    trace.log("c", {
        with T1 { n: 1 } { let _ = 0 }
        "x"
    })
    let mut k = fn() -> Int { r2() }
    k = fn() -> Int { b }
    trace.log("c", "{k()}")
}

fn main() {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_msg_label_order_across_walks_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert_eq(error_count(out), 2)
    assert(found.get(0).unwrap().contains("`msg` runs `T1.enter`, which reads `a`"), found.get(0).unwrap())
    assert(found.get(1).unwrap().contains("`msg` runs `k`, which reads `a`"), found.get(1).unwrap())
}

test "a binder of a named fn that only the result type of the built-in solves reads the row at that type" {
    let src = #"type Mute { n: Int }
type Loud { n: Int }

impl Closeable for Mute {
    fn close(self) { }
}

impl Closeable for Loud {
    fn close(self) ! IO { io.println("x") }
}

fn build[T: Closeable](x: Int) -> Option[T] ! _ { None }

fn walk() {
    trace.log("c", {
        let ys: List[Option[Mute]] = [1].map(build)
        "{ys.len()}"
    })
    trace.log("c", {
        let ys: List[Option[Mute]] = [1].into_iter().map(build).collect()
        "{ys.len()}"
    })
}

fn loud() {
    trace.log("c", {
        let ys: List[Option[Loud]] = [1].map(build)
        "{ys.len()}"
    })
}

fn open() {
    trace.log("c", "{[1].map(build).len()}")
}

fn main() {
    walk()
    loud()
}
"#
    let out = check_via_cli(src, "e0566_binder_from_result_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert(found.get(0).unwrap().contains("`IO`") || found.get(0).unwrap().contains("! IO"), found.get(0).unwrap())
    assert(found.get(1).unwrap().contains("! _"), found.get(1).unwrap())
}
