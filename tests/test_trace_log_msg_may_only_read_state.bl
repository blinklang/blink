    let helper = "pub let mut op: fn(Int) -> Int = fn(x: Int) -> Int \{ x + 1 }\n"
    let entry = "import st\n\nfn callop() -> Int \{ st.op(1) }\n\nfn main() \{\n    trace.log(\"c\", \"\{callop()}\")\n}\n"
    let q = only_e0566(check_package(entry, "st", helper, "e0566_qualified_let_mut_closure_{getpid()}"))
    assert(q.contains("`msg` calls `callop`, which reads `st.op`"), q)
}

test "a msg that runs a closure declared outside it is E0566 when a with item in the closure has a row" {
    let src = #"type Log { name: Str }

impl Closeable for Log {
    fn close(self) ! IO.Print { io.println("closed {self.name}") }
}

type T { n: Int }

impl BlockHandler for T {
    type Context = ()
    fn enter(self) -> () ! IO { io.println("in {self.n}") }
    fn exit(self, _ok: Bool) ! IO { io.println("out {self.n}") }
}

fn walk() ! IO {
    let shut = fn() -> Int {
        with Log { name: "a" } as l { let _ = l.name }
        1
    }
    let held = fn() -> Int {
        with T { n: 1 } { 1 }
    }
    trace.log("c", "{shut()}")
    trace.log("c", "{held()}")
}

fn main() ! IO {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_outer_closure_with_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 2)
    assert_eq(error_count(out), 2)
    let closed = found.get(0).unwrap()
    assert(primary_at(closed, 23, 22), closed)
    assert(closed.contains("`msg` runs `shut`, which has a row"), closed)
    assert(closed.contains("`shut` runs `Log.close`, which has the row `! IO.Print`"), closed)
    let entered = found.get(1).unwrap()
    assert(primary_at(entered, 24, 22), entered)
    assert(entered.contains("`msg` runs `held`, which has a row"), entered)
    assert(entered.contains("`held` runs `T.enter`, which has the row `! IO`"), entered)
}

test "a msg that runs a closure an if, match or block yields runs each closure it may yield" {
    let src = #"let mut count = 0

fn bump() -> Int {
    count += 1
    count
}

fn walk(flag: Bool, n: Int) {
    let picked = if flag { fn() -> Int { bump() } } else { fn() -> Int { 2 } }
    let matched = match n {
        0 => fn() -> Int { 0 }
        _ => fn() -> Int { bump() }
    }
    let blocked = {
        let k = 1
        fn() -> Int { bump() + k }
    }
    let pure = if flag { fn() -> Int { 1 } } else { fn() -> Int { 2 } }
    trace.log("c", "{picked()}")
    trace.log("c", "{matched()}")
    trace.log("c", "{blocked()}")
    trace.log("c", "{pure()}")
}

fn main() {
    walk(true, 1)
}
"#
    let out = check_via_cli(src, "e0566_branch_closure_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 3)
    assert_eq(error_count(out), 3)
    let picked = found.get(0).unwrap()
    assert(primary_at(picked, 19, 22), picked)
    assert(picked.contains("`msg` runs `picked`, which writes `count`"), picked)
    let matched = found.get(1).unwrap()
    assert(primary_at(matched, 20, 22), matched)
    assert(matched.contains("`msg` runs `matched`, which writes `count`"), matched)
    let blocked = found.get(2).unwrap()
    assert(primary_at(blocked, 21, 22), blocked)
    assert(blocked.contains("`msg` runs `blocked`, which writes `count`"), blocked)
}

test "a closure literal in msg that msg does not run is held to the row of the enclosing fn" {
    let src = #"fn shout() -> Int ! IO {
    io.println("x")
    1
}

fn apply(f: fn() -> Int) -> Int { f() }

fn walk() {
    trace.log("c", "{apply(fn() -> Int { shout() })}")
    trace.log("c", {
        let d = fn() -> Int { shout() }
        "x"
    })
    trace.log("c", "{[1].map(fn(x: Int) -> Int { x + shout() }).len()}")
}

fn main() ! IO {
    walk()
}
