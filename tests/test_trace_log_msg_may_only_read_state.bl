test "a msg that runs a closure declared outside it is E0566 when the closure's body has a row" {
    let src = #"fn shout(s: Str) ! IO {
    io.println(s)
}

fn walk() ! IO, Env.Read {
    let cwd = fn() -> Str { env.cwd() }
    let loud = fn() -> Int {
        shout("x")
        1
    }
    let nested = fn() -> Int {
        let inner = fn() -> Str { env.cwd() }
        inner().len()
    }
    trace.log("c", "{cwd()}")
    trace.log("c", "{loud()}")
    trace.log("c", "{[1].map(fn(x: Int) -> Int { x + nested() }).len()}")
}

fn main() ! IO {
    walk()
}
"#
    let out = check_via_cli(src, "e0566_outer_closure_row_{getpid()}")
    let found = e0566_lines(out)
    assert_eq(found.len(), 3)
    assert_eq(error_count(out), 3)
    let op = found.get(0).unwrap()
    assert(primary_at(op, 15, 22), op)
    assert(op.contains("`msg` runs `cwd`, which has a row"), op)
    assert(op.contains("`cwd` calls `env.cwd`, a handler operation"), op)
    let rowed = found.get(1).unwrap()
    assert(primary_at(rowed, 16, 22), rowed)
    assert(rowed.contains("`msg` runs `loud`, which has a row"), rowed)
    assert(rowed.contains("`loud` calls `shout`, which has the row `! IO`"), rowed)
    let deep = found.get(2).unwrap()
    assert(primary_at(deep, 17, 54), deep)
    assert(deep.contains("`msg` runs `nested`, which has a row"), deep)
    assert(deep.contains("`nested` calls `env.cwd`, a handler operation"), deep)
}

fn code_lines(out: Str, code: Str) -> List[Str] {
    let mut found: List[Str] = []
    for line in out.split("\n") {
        if line.contains("\"code\":\"{code}\"") { found.push(line) }
    }
    found
}

test "a fn the walk first meets at its depth cap is walked again when a shorter call path reaches it" {
    let mut parts = ["let mut counter = 0\n\nfn z() \{\n    counter += 1\n\}\n\nfn w() \{\n    z()\n\}\n"]
    let mut i = 1
    while i < 63 {
        parts.push("\nfn c{i}() \{\n    c{i + 1}()\n\}\n")
        i = i + 1
    }
    parts.push("\nfn c63() \{\n    w()\n\}\n\nfn a() -> Int \{\n    c1()\n    w()\n    1\n\}\n")
    parts.push("\nfn main() \{\n    trace.log(\"c\", \"v=\{a()\}\")\n\}\n")
    let e = only_e0566(check_via_cli(parts.join(""), "e0566_depth_cap_{getpid()}"))
    assert(e.contains("`msg` calls `a`, which writes `counter`"), e)
}

test "a msg that calls a module let closure runs the closure it holds" {
