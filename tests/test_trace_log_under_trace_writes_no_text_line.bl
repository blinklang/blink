// When `--trace` is on, a `trace.log` call writes a `note` event to the NDJSON stream in place
// of its text line, so that each stderr line is valid JSON (§8.15.7, *The form*).

import compile_test_helpers
import std.json.{json_clear, json_parse, json_get, json_as_str}

let LOWER_SRC = #"fn lower(id: Int) -> Int {
    trace.log("mono", "lower {id}")
    id + 1
}

fn main() ! IO {
    io.println("{lower(4)}")
}
"#

fn traced_stderr(tag: Str, filter: Str) -> Str ! FS.Write, Process.Spawn, Env.Read {
    let dir = "{compile_test_helpers.scratch_root()}/trace_log_note_{tag}"
    compile_test_helpers.sh("mkdir -p {dir}")
    let path = "{dir}/trace_log_note.bl"
    let bin = "{dir}/trace_log_note_bin"
    fs.write(path, LOWER_SRC).unwrap()
    let b = process.run("build/blink", ["build", "--trace", path, "-o", bin]).unwrap()
    assert(b.success())
    let r = process.run("env", ["BLINK_TRACE_CHANNELS=mono", "BLINK_TRACE={filter}", bin]).unwrap()
    assert_eq(r.out, "5\n")
    assert(r.success())
    compile_test_helpers.sh("rm -rf {dir}")
    r.err_out
}

test "under --trace a trace call writes no text line, so each stderr line is JSON" {
    for line in traced_stderr("json", "all").split("\n") {
        if line == "" { continue }
        json_clear()
        assert(json_parse(line) >= 0, "not JSON: {line}")
    }
}

test.failing(
    "under --trace a trace call writes a note event with its channel and msg",
    reason: "the note event under --trace is not built",
) {
    let err = traced_stderr("note", "event:note")
    let lines = err.split("\n").filter(fn(l) { l != "" })
    assert_eq(lines.len(), 1, "stderr: {err}")
    json_clear()
    let obj = json_parse(lines.get(0).unwrap())
    assert(obj >= 0)
    assert_eq(json_as_str(json_get(obj, "event")), "note")
    assert_eq(json_as_str(json_get(obj, "fn")), "trace_log_note.lower")
    assert_eq(json_as_str(json_get(obj, "module")), "trace_log_note")
    assert_eq(json_as_str(json_get(obj, "channel")), "mono")
    assert_eq(json_as_str(json_get(obj, "msg")), "lower 4")
}
