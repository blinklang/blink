// A `blink test` binary reads BLINK_TRACE_CHANNELS when it starts, as a program does, so a
// `trace.log` call in a test writes its line with the channel on. `--verbose` shows the
// output of a test that passes, which the runner passes on to its own stdout.

import compile_test_helpers
import std.process.{ProcessResult}

fn run_fixture(tag: Str, channels: Str) -> ProcessResult ! FS.Write, Process.Spawn, Env.Read {
    let scratch = "{compile_test_helpers.scratch_root()}/{tag}"
    compile_test_helpers.sh("mkdir -p {scratch}")
    let fixture = "{scratch}/{tag}.bl"
    fs.write(fixture, [
        #"fn helper(n: Int) -> Int {"#,
        #"    trace.log("in_test_chan", "helper {n}")"#,
        #"    n + 1"#,
        #"}"#,
        #""#,
        #"test "calls the helper" {"#,
        #"    assert_eq(helper(1), 2)"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    let r = process.run("env", ["BLINK_TRACE_CHANNELS={channels}", "build/blink", "test", "--verbose", fixture]).unwrap()
    process.run("sh", ["-c", "rm -rf {scratch} build/{tag} build/{tag}.c"]).unwrap()
    r
}

test "a trace call in a test writes its line when its channel is on" {
    let r = run_fixture("trace_log_test_binary_on", "in_test_chan")
    assert(r.success(), "{r.out}{r.err_out}")
    assert("{r.out}{r.err_out}".contains("[trace:in_test_chan] helper 1\n"), "{r.out}{r.err_out}")
}

test "a trace call in a test writes nothing when its channel is off" {
    let r = run_fixture("trace_log_test_binary_off", "other_chan")
    assert(r.success(), "{r.out}{r.err_out}")
    assert(!"{r.out}{r.err_out}".contains("[trace:"), "{r.out}{r.err_out}")
}
