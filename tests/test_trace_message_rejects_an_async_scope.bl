// A trace message may not suspend the task (sections/06_tooling.md §8.15.7). E0566 names what
// suspends: an async scope, an await, a channel send or receive, or a for-in over a channel.
// A message that suspends is E0566 alone: trace.log charges no effect, and a charge of Async
// here would say to add a row that does not make the message legal.

import compile_test_helpers

fn expect_tm(src: Str, tag: Str, shown: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0566", tag)
    compile_test_helpers.expect_contains(out, shown, tag)
    assert(!out.contains("E0500"), "E0500 as well: {out}")
}

test "async.scope in a trace message is E0566" {
    expect_tm(#"fn f() ! Async {
    trace.log("c", "{async.scope { 1 }}")
}
fn main() {
    f()
}
"#, "trace_msg_scope", "async.scope")
}

test "await in a trace message is E0566" {
    expect_tm(#"fn f(h: Handle[Int]) ! Async {
    trace.log("c", "{h.await}")
}
fn main() {
    f(async.spawn(fn() -> Int { 1 }))
}
"#, "trace_msg_await", "h.await")
}

test "a channel receive in a trace message is E0566" {
    expect_tm(#"fn f(ch: Channel[Int]) ! Async {
    trace.log("c", "{ch.recv() ?? 0}")
}
fn main() {
    f(channel.new[Int](buffer: 1))
}
"#, "trace_msg_recv", "ch.recv")
}

test "a message with no suspension stays clean" {
    let out = compile_test_helpers.compile_and_capture(#"fn f(n: Int) {
    trace.log("c", "n is {n}")
}
fn main() {
    f(1)
}
"#, "trace_msg_clean")
    compile_test_helpers.expect_compiles_clean(out, "clean")
}
