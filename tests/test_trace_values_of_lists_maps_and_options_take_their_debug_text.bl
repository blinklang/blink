// A list, a map and an option have Debug when what they hold has Debug (§3.6.1), so a traced
// value of one shows its Debug text (§8.15.9). One that holds a type with no Debug shows its
// type name. A list of a type whose Debug is written by hand also shows its type name for
// now, and the build with --trace does not stop on it.

import compile_test_helpers
import std.json.{json_clear, json_parse, json_get, json_as_str, json_len, json_key_at, json_obj_child_at}

let SRC = #"@derive(Debug)
type P { x: Int }
type H { v: Int }
impl Debug for H {
    fn debug(self) -> Str { "H:{self.v}" }
}
type N { v: Int }
fn take(xs: List[Int], ps: List[P], o: Option[Int], none: Option[Str], m: Map[Str, Int], nested: List[Option[P]], hs: List[H], ns: List[N]) -> Int {
    xs.len() + ps.len() + (o ?? 0) + (none ?? "").len() + m.len() + nested.len() + hs.len() + ns.len()
}
fn main() ! IO {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let n = take([3, 1], [P { x: 2 }], Some(4), None, m, [Some(P { x: 5 }), None], [H { v: 6 }], [N { v: 7 }])
    io.println("{n}")
}
"#

fn args_of(text: Str) -> Str {
    for line in text.split("\n") {
        if !line.starts_with("\{") { continue }
        json_clear()
        let obj = json_parse(line)
        assert(obj >= 0)
        if json_as_str(json_get(obj, "event")) != "enter" { continue }
        let args = json_get(obj, "args")
        if args < 0 || json_len(args) == 0 { continue }
        let mut parts: List[Str] = []
        let mut i = 0
        while i < json_len(args) {
            parts.push("{json_key_at(args, i)}={json_as_str(json_obj_child_at(args, i))}")
            i = i + 1
        }
        return parts.join("\n")
    }
    ""
}

test "a list, a map and an option show their Debug text when what they hold has Debug" {
    let bin = compile_test_helpers.build_bin(SRC, "trace_container_values", ["--trace"])
    let r = process.run("env", ["BLINK_TRACE=fn:take", bin]).unwrap()
    assert_eq(r.out, "12\n")
    assert(r.success())
    assert_eq(args_of(r.err_out), [
        "xs=[3, 1]",
        "ps=[P \{ x: 2 }]",
        "o=Some(4)",
        "none=None",
        "m=\{\"a\": 1}",
        "nested=[Some(P \{ x: 5 }), None]",
        "hs=<List[H]>",
        "ns=<List[N]>",
    ].join("\n"))
    compile_test_helpers.clean_bin("trace_container_values")
}
