// A program built with --trace writes only the event types of §8.15.2 (enter, exit, state,
// effect, note). A `with arena { expr }` block whose tail is promoted out of the arena writes
// no `arena.promote` and no `arena.promote.capture` event, and the promotion still gives the
// program the right value.

import compile_test_helpers

fn build_and_run(tag: Str, src: Str, runtime_trace: Int) -> Str ! FS.Write, Process.Spawn, Env.Read {
    fs.write("{compile_test_helpers.scratch_root()}/_test_{tag}.bl", src).unwrap()
    // A traced binary traces with BLINK_TRACE unset, so only the build says whether it traces.
    let mut build_args = ["build", "{compile_test_helpers.scratch_root()}/_test_{tag}.bl", "--output", "{compile_test_helpers.scratch_root()}/_{tag}_bin"]
    if runtime_trace != 0 { build_args.push("--trace") }
    let _ = process.run("build/blink", build_args).unwrap()
    let result = process.run("{compile_test_helpers.scratch_root()}/_{tag}_bin", []).unwrap()
    let combined = "{result.out}{result.err_out}"
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_{tag}.bl {compile_test_helpers.scratch_root()}/_{tag}_bin {compile_test_helpers.scratch_root()}/_{tag}_bin.c"]).unwrap()
    combined
}

test "a traced int tail writes no arena.promote event" {
    let src = "fn main() \{\n    let n = with arena \{\n        let a = 10\n        let b = 32\n        a + b\n    \}\n    io.println(n)\n\}\n"
    let out = build_and_run("arena_promote_int", src, 1)
    assert(!out.contains("arena.promote"))
    assert(out.contains("\"event\":\"enter\""))
    assert(out.contains("42"))
}

test "a traced list tail writes no arena.promote event" {
    let src = "fn main() \{\n    let xs = with arena \{\n        [1, 2, 3]\n    \}\n    io.println(xs.len())\n\}\n"
    let out = build_and_run("arena_promote_list", src, 1)
    assert(!out.contains("arena.promote"))
    assert(out.contains("3"))
}

test "a traced str tail writes no arena.promote event" {
    let src = "fn main() \{\n    let s = with arena \{\n        \"hello\"\n    \}\n    io.println(s)\n\}\n"
    let out = build_and_run("arena_promote_span", src, 1)
    assert(!out.contains("arena.promote"))
    assert(out.contains("hello"))
}

test "a traced nested arena tail writes no arena.promote event" {
    let src = "fn main() \{\n    let n = with arena \{ with arena \{ 5 \} \}\n    io.println(n)\n\}\n"
    let out = build_and_run("arena_promote_outer", src, 1)
    assert(!out.contains("arena.promote"))
    assert(out.contains("5"))
}

test "an untraced arena tail writes no arena.promote event" {
    let src = "fn main() \{\n    let n = with arena \{ 1 + 2 \}\n    io.println(n)\n\}\n"
    let out = build_and_run("arena_promote_off", src, 0)
    assert(out.contains("3"))
    assert(!out.contains("arena.promote"))
}

test "a traced promoted closure tail writes no arena.promote.capture event" {
    let src = "fn main() \{\n    let k = 5\n    let g = with arena \{\n        let mut n = 0\n        let xs = [1, 2]\n        fn() -> Int \{\n            n = n + 1\n            n + xs.len() + k\n        \}\n    \}\n    io.println(g())\n\}\n"
    let out = build_and_run("arena_promote_capture", src, 1)
    assert(!out.contains("arena.promote"))
    assert(out.contains("8"))
}
