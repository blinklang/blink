// A trait method that declares its OWN type parameter (independent of the
// impl's binders) must monomorphize that parameter the same way a free
// function's generic parameter does. Codegen currently erases it to a bare
// C `void`, which cc rejects as a named void parameter.
//
// This mono gap is the reason test_call_site_trait_bound_enforced.bl's accept
// side only exercises a free-fn generic param, not a method's own bounded
// type param -- that file documents the gap; this file pins it down directly.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a trait method's own generic type parameter monomorphizes instead of erasing to void",
    reason: "codegen never monomorphizes a trait method's own type parameter (as opposed to the impl's binders), emitting it as a bare unnamed-only C void parameter, which cc rejects; reproduces with an unbounded [U], independent of any trait bound",
    ticket: "22sytt",
) {
    let src = #"
import std.io

trait Combiner { fn combine[U](self, a: U, b: U) -> U }
type Calc { base: Int }
impl Combiner for Calc {
    fn combine[U](self, a: U, b: U) -> U { a }
}

fn main() ! IO {
    let c = Calc { base: 0 }
    io.println("{c.combine(2, 3)}")
}
"#
    let r = compile_and_run(src, "_trait_method_own_type_param_monomorphizes")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
