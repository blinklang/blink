// Bug 4tbbjm: trait methods on stdlib-imported types (param typed `mod.Type`)
// must resolve. The impl registers under the bare name "TcpSocket" but the
// param stores the qualified var-struct "net.TcpSocket"; lookup must strip
// the module qualifier so the method resolves (not "type Void").
import std.net

fn read_one(sock: net.TcpSocket) -> Int {
    let b = match sock.read_bytes(8) {
        Ok(x) => x
        Err(_) => Bytes.new()
    }
    b.len()
}

test "trait method resolves on stdlib-qualified param type" {
    assert(true)
}
