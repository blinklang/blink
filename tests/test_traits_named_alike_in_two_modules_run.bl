// A trait is known by its module and its name (sections/07 §10.6, *A shadow has module scope*).
// Each program here declares two traits of one spelling in two modules; each must build, link
// and print what its own impls answer.

import std.process.{ProcessResult}

fn run_fixture(name: Str, flags: List[Str]) -> ProcessResult {
    let mut args = ["run"]
    for f in flags { args.push(f) }
    args.push("tests/zzti_traits/src/{name}.bl")
    process.run("build/blink", args).unwrap()
}

fn assert_prints_with(name: Str, flags: List[Str], want: Str) {
    let r = run_fixture(name, flags)
    let out = "{r.out}{r.err_out}"
    if !r.out.contains(want) { io.println("FAIL[{name}] want '{want}', got: {out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains(want))
}

fn assert_prints(name: Str, want: Str) {
    assert_prints_with(name, [], want)
}

// A one-unit build and a per-module build spell the same symbols, and only the per-module
// build links them across units.
fn assert_prints_both(name: Str, want: Str) {
    assert_prints_with(name, [], want)
    assert_prints_with(name, ["--per-module"], want)
}

test "the prelude Eq and a module's own Eq both run in one program" {
    assert_prints("main_core_eq_beside_a_shadow", "true true true true")
}

test "two traits named Tr in two modules each run their own impls" {
    assert_prints("main_two_traits_named_tr", "1 b2 20 c3")
}

test "a module's own Eq and the prelude Eq on one type each reach their own impl" {
    assert_prints_both("main_local_and_core_eq_on_one_type", "true false true false true false true false")
}

test "a module's own Display and the prelude Display on one type each reach their own impl" {
    assert_prints_both("main_local_and_core_display_on_one_type", "local7 core7 core7")
}

test "two traits named Tr on one type each reach their own impl through their bound" {
    assert_prints_both("main_two_traits_named_tr_on_one_type", "400 d4k3")
}

test "two traits named Tr on one generic type each reach their own per-instance impl" {
    assert_prints_both("main_two_traits_named_tr_on_one_generic_type", "40 b4k5 40 b4k3")
}
