// A `let mut` local assigned inside a closure that is itself nested inside another
// closure must be captured transitively: the outer closure captures the cell and
// forwards it to the inner closure, which mutates through its own capture slot.

import compile_test_helpers.{compile_and_run}

test.failing(
    "two-level nested closure mutating an outer local compiles and runs",
    reason: "the outer closure never gets a cell for the local, so the inner closure body references an undeclared name and the outer assignment targets a non-lvalue",
    ticket: "063qcp",
) {
    let src = #"
fn main() ! IO {
    let mut n = 1
    let outer = fn() {
        let inner = fn() { n = 5 }
        inner()
    }
    outer()
    io.println("n={n}")
}
"#
    let r = compile_and_run(src, "_transitive_mut_capture_nested_closure")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=5\n")
}
