import compile_test_helpers

// A transparent newtype (single-Int-payload enum lowering to bare int64_t)
// used as another enum's variant payload must lower consistently: the
// match binder for it must expect int64_t, not the struct spelling.

fn transparent_newtype_nested_field_src() -> Str {
    #"pub type Errno {
    Errno(Int)
}

type Holder {
    Wrap(Errno)
    Bare(Int)
}

fn main() ! IO {
    let h = Holder.Wrap(Errno(31))
    let code = match h {
        Holder.Wrap(e) => match e {
            Errno(rc) => rc
        }
        Holder.Bare(n) => n
    }
    io.println("code={code}")
}
"#
}

test.failing(
    "a transparent newtype nested as an enum field round-trips",
    reason: "Holder.Wrap's field is typed blink_Errno (a struct) in the container typedef, but the inner match binder for the transparent newtype expects int64_t, so cc rejects the mismatched initializer",
    ticket: "q7hqen",
) {
    let r = compile_test_helpers.compile_and_run(transparent_newtype_nested_field_src(), "_nested_newtype")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "code=31\n")
}
