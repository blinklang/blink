import compile_test_helpers

// A single-payload enum nested as another enum's variant payload must lower to ONE
// spelling: the container field, the outer binder and the inner scrutinee all name the
// same C type. They once disagreed -- the field was the struct and the inner binder
// expected a bare word -- and cc rejected the initializer.
//
// Which spelling they agree on is a separate question, and this row does not fix it. The
// transparent-newtype fact belongs to a declaration, not to a shape: layout marks it from
// a table keyed on the qualified stdlib name, so std.errno's Errno lowers to a bare word
// while a user type of the same shape, like the one below, keeps the ordinary tagged
// struct. Either way the three spellings must match, which is what this row reads.

fn transparent_newtype_nested_field_src() -> Str {
    #"pub type Errno {
    Errno(Int)
}

type Holder {
    Wrap(Errno)
    Bare(Int)
}

fn main() ! IO {
    let h = Holder.Wrap(Errno(31))
    let code = match h {
        Holder.Wrap(e) => match e {
            Errno(rc) => rc
        }
        Holder.Bare(n) => n
    }
    io.println("code={code}")
}
"#
}

test "a single-payload newtype nested as an enum field round-trips" {
    let r = compile_test_helpers.compile_and_run(transparent_newtype_nested_field_src(), "_nested_newtype")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "code=31\n")
}
