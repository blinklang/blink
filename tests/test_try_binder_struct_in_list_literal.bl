// `let c = expr?` where expr is Result[Struct, E] binds c with a ctype that
// agrees with its struct name, so putting c into a List[Struct] literal
// builds and keeps the right value.

type PgError { msg: Str }
type Conn { name: Str, fd: Int }

fn connect() -> Result[Conn, PgError] { Ok(Conn { name: "hi", fd: 7 }) }

fn run() -> Result[Str, PgError] {
    let c = connect()?
    let l: List[Conn] = [c]
    Ok(l.get(0).unwrap().name)
}

test "? binder on a struct Result can be placed in a List literal" {
    match run() {
        Ok(s) => { assert_eq(s, "hi") }
        Err(e) => { assert(false, "unexpected error: {e.msg}") }
    }
}
