// `Percent.try_from(..)` is the prelude TryFrom static constructor
// (lib/std/traits.bl): its contract is `try_from(T) -> Result[Self, ConversionError]`.
// A user type impls the prelude trait; it must not redefine `trait TryFrom`.
impl TryFrom[Int] for Percent {
    fn try_from(value: Int) -> Result[Percent, ConversionError] {
        if value < 0 {
            Err(ConversionError {
                message: "negative percentage",
                source_type: "Int",
                target_type: "Percent",
            })
        } else {
            Ok(Percent { value: value })
        }
    }
}

type Percent {
    value: Int
}

test "try_from basic" {
    let result = Percent.try_from(42)
    assert(result.is_ok())
}
