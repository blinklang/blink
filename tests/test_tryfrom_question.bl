// `?`-operator propagation over the prelude TryFrom static constructor
// (lib/std/traits.bl): `try_from(T) -> Result[Self, ConversionError]`. The
// user types impl the prelude trait; they must not redefine `trait TryFrom`.
// Every fallible helper therefore threads ConversionError as its error type.

type Percent {
    value: Int
}

type Rating {
    score: Int
}

impl TryFrom[Int] for Percent {
    fn try_from(value: Int) -> Result[Percent, ConversionError] {
        if value < 0 {
            Err(ConversionError { message: "negative percentage", source_type: "Int", target_type: "Percent" })
        } else if value > 100 {
            Err(ConversionError { message: "percentage exceeds 100", source_type: "Int", target_type: "Percent" })
        } else {
            Ok(Percent { value: value })
        }
    }
}

impl TryFrom[Int] for Rating {
    fn try_from(value: Int) -> Result[Rating, ConversionError] {
        if value < 1 {
            Err(ConversionError { message: "rating too low", source_type: "Int", target_type: "Rating" })
        } else if value > 5 {
            Err(ConversionError { message: "rating too high", source_type: "Int", target_type: "Rating" })
        } else {
            Ok(Rating { score: value })
        }
    }
}

fn test_err(msg: Str) -> ConversionError {
    ConversionError { message: msg, source_type: "test", target_type: "test" }
}

fn validate_percent(n: Int) -> Result[Int, ConversionError] {
    let v = Percent.try_from(n)?
    Ok(v.value)
}

fn validate_rating(n: Int) -> Result[Int, ConversionError] {
    let r = Rating.try_from(n)?
    Ok(r.score)
}

fn validate_both(pct: Int, rate: Int) -> Result[Int, ConversionError] {
    let p = Percent.try_from(pct)?
    let r = Rating.try_from(rate)?
    Ok(p.value + r.score)
}

fn error_should_propagate(n: Int) -> Result[Int, ConversionError] {
    let v = validate_percent(n)?
    Ok(999)
}

fn test_error_propagation() -> Result[Int, ConversionError] {
    let e1 = error_should_propagate(-5)
    let ok1 = error_should_propagate(50)?
    if ok1 != 999 { return Err(test_err("error_prop: valid call failed")) }

    let e2 = validate_both(-1, 3)
    let ok2 = validate_both(10, 2)?
    if ok2 != 12 { return Err(test_err("error_prop: chain failed")) }

    let e3 = validate_both(50, 0)
    let ok3 = validate_both(20, 5)?
    if ok3 != 25 { return Err(test_err("error_prop: chain2 failed")) }

    let e4 = error_should_propagate(150)
    let ok4 = error_should_propagate(25)?
    if ok4 != 999 { return Err(test_err("error_prop: boundary failed")) }

    Ok(0)
}

fn run_all() -> Result[Int, ConversionError] {
    let v1 = Percent.try_from(42)?
    if v1.value != 42 { return Err(test_err("test1")) }

    let v2 = validate_percent(75)?
    if v2 != 75 { return Err(test_err("test2")) }

    let v3 = Rating.try_from(3)?
    if v3.score != 3 { return Err(test_err("test3")) }

    let v4 = validate_rating(5)?
    if v4 != 5 { return Err(test_err("test4")) }

    let v5 = validate_both(50, 4)?
    if v5 != 54 { return Err(test_err("test5")) }

    let v6 = Percent.try_from(0)?
    if v6.value != 0 { return Err(test_err("test6")) }

    let v7 = Percent.try_from(100)?
    if v7.value != 100 { return Err(test_err("test7")) }

    let ep = test_error_propagation()?

    Ok(0)
}

test "try_from with question mark operator" {
    let r = run_all()
    assert(r.is_ok())
}
