type Cmd { Quit }
type M { x: Int }

fn pick(m: M, b: Bool) -> (M, Option[Cmd]) {
    if b { (m, Some(Cmd.Quit)) } else { (m, None) }
}

fn pick2(m: M, b: Bool) -> (M, Option[Cmd]) {
    (m, if b { Some(Cmd.Quit) } else { None })
}

test "bare None in tuple slot via if-arm return Some" {
    let (_m, oc) = pick(M { x: 0 }, true)
    assert_eq(oc.is_some(), 1)
}

test "bare None in tuple slot via if-arm return None" {
    let (_m, oc) = pick(M { x: 1 }, false)
    assert_eq(oc.is_some(), 0)
}

test "bare None in tuple slot via typed let binding" {
    let t: (M, Option[Cmd]) = (M { x: 2 }, None)
    let (_m, oc) = t
    assert_eq(oc.is_some(), 0)
}

test "bare None in tuple slot via nested if-expr" {
    let (_m, oc) = pick2(M { x: 3 }, false)
    assert_eq(oc.is_some(), 0)
}
