// An if/else whose branches are TUPLES carrying a sum-variant element must merge the
// tuple element-wise, so a carrier metavar left open in one branch is pinned by the
// sibling branch — exactly as a bare Option/Result branch already is (type_merge).
//
// `if c { (m, None) } else { (m, Some(5)) }` leaves the None's inner α open in the
// then-branch; the Some(5) branch pins α=Int. Before the Tuple arm in type_merge the
// merge fell through and returned the then-branch tuple with α still unbound, so the
// if-expression's node tid resolved to `(M, Option[?])` — a declining carrier the flat
// fields had to fabricate. With the Tuple arm the element merge binds α and the tid is
// faithful. The return annotation is deliberately omitted from what pins α: the merge
// alone must do it.

type BM { x: Int }

fn opt_pick(m: BM, take: Bool) -> (BM, Option[Int]) {
    if take { (m, Some(5)) } else { (m, None) }
}

test "tuple-branch Option merge pins the None inner from the Some sibling" {
    let (_a, some_side) = opt_pick(BM { x: 0 }, true)
    let (_b, none_side) = opt_pick(BM { x: 0 }, false)
    let read = match some_side { Some(v) => v None => -1 }
    assert_eq(read, 5)
    assert_eq(none_side.is_some(), 0)
}

fn res_pick(m: BM, ok: Bool) -> (BM, Result[Int, Bool]) {
    if ok { (m, Ok(7)) } else { (m, Err(false)) }
}

// A non-Str err type: the merge must carry Bool into the Ok-branch's open Err slot, not
// let the flat carrier default it to a string spelling.
test "tuple-branch Result merge pins a non-default err type across branches" {
    let (_a, ok_side) = res_pick(BM { x: 0 }, true)
    let (_b, err_side) = res_pick(BM { x: 0 }, false)
    let ok_read = match ok_side { Ok(v) => v Err(_e) => -1 }
    assert_eq(ok_read, 7)
    let err_read = match err_side { Ok(_v) => 1 Err(e) => if e { 2 } else { 3 } }
    assert_eq(err_read, 3)
}
