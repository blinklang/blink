// br yap7h7 (codegen-structured-tids). A free/method fn with a TUPLE return type,
// emitted before the test bodies, left cg_current_fn_node dangling: emit_fn_def
// (codegen_stmt.bl) set cg_current_fn_node but never restored it, and the test-body
// emitter (codegen.bl) set cg_current_fn_name/ret but NOT cg_current_fn_node. So a
// bare tuple literal in any subsequent test body hit emit_tuple_lit's fn-return-ann
// branch (node_return_type(cg_current_fn_node) == "Tuple"), adopted the STALE fn's
// return annotation as parent_tuple_ann, and collapsed onto that fn's tuple carrier
// (e.g. Tuple2_Option_int_int) — the mono param of a generic fn taking the tuple
// then erased to `void` and C compilation failed with incompatible types.
//
// make_opt_tuple() below returns (Option[Int], Int); the tests after it construct
// tuples of DISTINCT compound shapes that must each keep their own carrier
// (Tuple2_Option_char_int, Tuple2_Option_list_int, Tuple2_Result_int_int_int, ...).
// Pre-fix, they all collapsed onto Tuple2_Option_int_int and failed to compile.

fn take_int[T](_x: T) -> Int {
    99
}

// The trigger: a tuple-RETURNING free fn emitted before the test bodies.
fn make_opt_tuple() -> (Option[Int], Int) {
    (Some(11), 12)
}

test "the tuple-returning fn itself still round-trips" {
    let p = make_opt_tuple()
    assert_eq(p.0.unwrap(), 11)
    assert_eq(p.1, 12)
}

test "(Option[Char], Int) keeps its own carrier after a tuple-returning fn" {
    let p = (Some('a'), 7)
    assert_eq(take_int(p), 99)
    assert_eq(p.0.unwrap(), 'a')
    assert_eq(p.1, 7)
}

test "(Option[List[Int]], Int) keeps its own carrier" {
    let o: Option[List[Int]] = Some([1, 2, 3])
    let p = (o, 7)
    assert_eq(take_int(p), 99)
    assert_eq(p.1, 7)
}

test "(Result[Int, Int], Int) keeps its own carrier" {
    let r: Result[Int, Int] = Ok(5)
    let p = (r, 8)
    assert_eq(take_int(p), 99)
    assert_eq(p.1, 8)
}

test "(Option[Float], Int) keeps its own carrier" {
    let p = (Some(1.5), 7)
    assert_eq(take_int(p), 99)
    assert_eq(p.1, 7)
}
