// Bug kyfh26: `let (a, b) = give()?` where give returns Result[(Int,Bytes),Str]
// must give `b` the 2nd tuple element type (Bytes), not the 1st (Int).
// The tuple OK type was being dropped during return-type registration because
// tuples weren't recognized in the compound-tag resolution path.
fn give() -> Result[(Int, Bytes), Str] {
    Ok((5, Bytes.new()))
}

fn use_it() -> Result[Int, Str] {
    let (a, b) = give()?
    Ok(a + b.len())
}

test "tuple destructure with ? propagates element types" {
    assert_eq(use_it(), Ok(5))
}
