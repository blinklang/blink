// Two structurally-different 2-tuples whose struct-element names contain
// underscores must not collide on the same Tuple2_* C typedef name. Joining
// element tags with a bare '_' cannot tell (A_B, C) apart from (A, B_C) --
// both join to "A_B_C" -- so the second tuple's typedef gets silently dropped
// by the #ifndef guard and reuses the first tuple's (wrong) field types.

import compile_test_helpers.{compile_and_run}

test.failing(
    "tuples (A_B, C) and (A, B_C) get distinct C typedefs, not a name collision",
    reason: "the C names of tuple types join element names with an unescaped underscore, so (A_B, C) and (A, B_C) get one typedef and the second tuple is built with the first one's field types, which cc rejects",
) {
    let src = #"
type A_B { p: Int }
type C { q: Int }
type A { r: Int }
type B_C { s: Int }

fn main() ! IO {
    let x: (A_B, C) = (A_B { p: 1 }, C { q: 2 })
    let y: (A, B_C) = (A { r: 3 }, B_C { s: 4 })
    io.println("{x.0.p} {x.1.q}")
    io.println("{y.0.r} {y.1.s}")
}
"#
    let r = compile_and_run(src, "_tuple_elem_tag_underscore_collision")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1 2\n3 4\n")
}
