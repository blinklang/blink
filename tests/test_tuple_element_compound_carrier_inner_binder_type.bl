// A tuple element whose carrier's PAYLOAD is itself a compound carrier (Result[Option[T], E])
// must keep the inner compound's shape through the tuple field-access boundary, so the
// match binder over the outer carrier's Ok slot types as the real inner carrier, not void.

test "Ok(inner) over a.0 typed Result[Option[Int], Str] binds the real Option[Int] inner" {
    let a: (Result[Option[Int], Str], Int) = (Ok(Some(9)), 0)
    let mut got = -1
    match a.0 {
        Ok(inner) => { got = inner.unwrap() }
        Err(_e) => {}
    }
    assert_eq(got, 9)
}
