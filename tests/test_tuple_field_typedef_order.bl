// br g812z0: a generic struct field instantiated at a tuple must not emit its own
// typedef before the tuple's, an illegal forward reference in C.
//
// MVCE (found while implementing br dq15j7's anti-collapse control, which needs exactly
// this shape and has nothing to do with Void):
//   type Box[T] { v: T }
//   let bi: Box[(Int, Int)] = Box { v: (3, 9) }
//
// emit_mono_struct_typedef (src/codegen_stmt.bl) resolves the `v: T` field to the tuple
// stem "Tuple2_int_int" and takes the same branch a plain struct/enum reference takes
// (ensure_tuple_type registers a tuple stem into struct_reg_set too), but unlike the
// Option/Result branches in the same function it never forces that tuple's own typedef
// (a separate emission stream, emitted_tuple_entries) to emit first. Before the fix this
// produced `typedef struct { blink_Tuple2_int_int v; } blink_Box_Tuple2_int_int;` BEFORE
// `blink_Tuple2_int_int` was declared — `cc` rejects the forward reference, then cascades
// into "incompatible types" at every construction/read site.
type Box[T] {
    v: T
}

test "a generic struct field instantiated at a tuple compiles and runs" {
    let bi: Box[(Int, Int)] = Box { v: (3, 9) }
    assert_eq(bi.v.0, 3)
    assert_eq(bi.v.1, 9)
}
