import compile_test_helpers

// A Set or Map whose key is a tuple over a type parameter has its key table at each instance
// of the generic body. The body names no concrete tuple, so the table exists only as the
// instance writes it.

fn runs(src: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let r = compile_test_helpers.compile_and_run(src, tag)
    if r.exit_code != 0 || r.out != want {
        io.println("FAIL: {tag}: exit {r.exit_code}, out '{r.out}', err '{r.err_out}'")
    }
    assert(r.exit_code == 0 && r.out == want)
}

test "a Set keyed on a tuple of a type parameter builds at each instance" {
    let src = "fn f[T: Hash + Eq](x: T) -> Int \{\n    let mut s: Set[(T, Int)] = Set()\n    s.insert((x, 1))\n    s.insert((x, 1))\n    s.len()\n}\nfn main() \{ io.println(\"\{f(1)} \{f(\"a\")}\") }\n"
    runs(src, "tkey_generic_set", "1 1\n")
}

test "an empty Set keyed on a tuple of a type parameter builds" {
    let src = "fn f[T: Hash + Eq](x: T) -> Int \{\n    let s: Set[(T, Int)] = Set()\n    s.len()\n}\nfn main() \{ io.println(\"\{f(1)}\") }\n"
    runs(src, "tkey_generic_empty_set", "0\n")
}

test "a Set keyed on an alias of a tuple of a type parameter builds" {
    let src = "type P[T] = (T, Int)\nfn f[T: Hash + Eq](x: T) -> Int \{\n    let s: Set[P[T]] = Set()\n    s.len()\n}\nfn main() \{ io.println(\"\{f(1)}\") }\n"
    runs(src, "tkey_generic_alias_set", "0\n")
}

test "a Map keyed on a tuple of a type parameter builds and finds its key" {
    let src = "fn f[T: Hash + Eq](x: T) -> Int \{\n    let mut m: Map[(T, Int), Int] = Map()\n    m.insert((x, 1), 2)\n    m.insert((x, 3), 4)\n    m.get((x, 3)) ?? 0\n}\nfn main() \{ io.println(\"\{f(7)}\") }\n"
    runs(src, "tkey_generic_map", "4\n")
}
