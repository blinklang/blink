import compile_test_helpers

fn tuple_keyed_map_param_src() -> Str {
    #"fn count_pairs(m: Map[(Int, Int), Str]) -> Int {
    m.len()
}

fn lookup(m: Map[(Int, Int), Str]) -> Str {
    m.get((1, 2)) ?? "missing"
}

fn main() {
    let mut m: Map[(Int, Int), Str] = Map()
    m.insert((1, 2), "a")
    m.insert((3, 4), "b")
    io.println("{count_pairs(m)}")
    io.println("{lookup(m)}")
}
"#
}

fn tuple_keyed_set_param_src() -> Str {
    #"fn has_pair(s: Set[(Int, Int)]) -> Bool {
    s.contains((1, 2))
}

fn main() {
    let mut s: Set[(Int, Int)] = Set()
    s.insert((1, 2))
    io.println("{has_pair(s)}")
}
"#
}

test "a tuple-keyed Map reached only through a parameter compiles" {
    let r = compile_test_helpers.compile_and_run(tuple_keyed_map_param_src(), "_tuple_keyed_map_named_by_param")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("2"), "expected count 2: out={r.out}")
    assert(r.out.contains("a"), "expected lookup to find the inserted value: out={r.out}")
}

test "a tuple-element Set reached only through a parameter compiles" {
    let r = compile_test_helpers.compile_and_run(tuple_keyed_set_param_src(), "_tuple_keyed_set_named_by_param")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("true"), "expected has_pair to find the inserted tuple: out={r.out}")
}
