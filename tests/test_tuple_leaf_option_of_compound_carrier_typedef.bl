// A tuple element whose type is Option[Result[T, E]] (a compound carrier nested inside
// another compound carrier) reached as a tuple LEAF must emit the inner Result carrier's
// typedef before the Option wrapper references it, and the value must round-trip intact.

type Box[T] { value: T }

test "tuple leaf Option[Result[Box[Int], Str]] carries the real inner value" {
    let t: (Option[Result[Box[Int], Str]], Int) = (Some(Ok(Box { value: 3 })), 9)
    assert_eq(t.1, 9)
    match t.0 {
        Some(r) => {
            match r {
                Ok(b) => { assert_eq(b.value, 3) }
                Err(_e) => { assert(false) }
            }
        }
        None => { assert(false) }
    }
}
