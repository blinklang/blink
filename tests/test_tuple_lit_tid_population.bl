// A tuple literal's result temp (`_tupN`) was registered through set_var_struct
// with the carrier name on the flat sname channel but no type id, so every field
// read on it resolved the carrier through the flat sname alone. emit_tuple_lit now
// also stamps the literal's tid on the temp (guarded to the same carrier the flat
// write spells), so sv_struct_tid_first recovers the tuple from the tid. This is a
// tid-population step: the emitted C is unchanged; the tests guard that a tuple
// literal temp still resolves its field access across the plain, nested, in-list,
// and struct-element shapes.
type P { x: Int }

test "plain tuple literal temp resolves field access" {
    let t = (7, 9)
    assert_eq(t.0, 7)
    assert_eq(t.1, 9)
}

test "nested tuple literal temp resolves field access" {
    let t = ((1, 2), 3)
    let inner = t.0
    assert_eq(inner.0, 1)
    assert_eq(inner.1, 2)
    assert_eq(t.1, 3)
}

test "tuple literal element in a list resolves field access" {
    let xs: List[(Int, Int)] = [(4, 5), (6, 7)]
    let a = xs.get(0).unwrap()
    let b = xs.get(1).unwrap()
    assert_eq(a.0, 4)
    assert_eq(b.1, 7)
}

test "tuple literal with a struct element resolves both field paths" {
    let t = (P { x: 42 }, 8)
    assert_eq(t.0.x, 42)
    assert_eq(t.1, 8)
}
