type M { x: Int }

fn pick(m: M, ok: Bool) -> (M, Option[Result[Int, Str]]) {
    if ok { (m, Some(Ok(7))) } else { (m, Some(Err("no"))) }
}

test "tuple-payload Option[Result[Int, Str]] Ok variant" {
    let (_m, or1) = pick(M { x: 0 }, true)
    assert_eq(or1.is_some(), 1)
}

test "tuple-payload Option[Result[Int, Str]] Err variant" {
    let (_m, or2) = pick(M { x: 0 }, false)
    assert_eq(or2.is_some(), 1)
}
