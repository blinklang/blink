type Cmd { Quit }
type M { x: Int }

fn make_none() -> Option[Cmd] { None }

fn pick(m: M, b: Bool) -> (M, Option[Cmd]) {
    if b { (m, Some(Cmd.Quit)) } else { (m, make_none()) }
}

test "tuple-payload Option[UserEnum] Some destructures" {
    let (_m1, oc1) = pick(M { x: 0 }, true)
    assert_eq(oc1.is_some(), 1)
}

test "tuple-payload Option[UserEnum] None destructures" {
    let (_m2, oc2) = pick(M { x: 0 }, false)
    assert_eq(oc2.is_some(), 0)
}
