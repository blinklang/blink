type Payload { v: Int }
type M { x: Int }

fn make_none() -> Option[Payload] { None }

fn pick(m: M, b: Bool) -> (M, Option[Payload]) {
    if b { (m, Some(Payload { v: 42 })) } else { (m, make_none()) }
}

test "tuple-payload Option[UserStruct] Some destructures" {
    let (_m1, op1) = pick(M { x: 0 }, true)
    assert_eq(op1.is_some(), 1)
    assert_eq(op1.unwrap().v, 42)
}

test "tuple-payload Option[UserStruct] None destructures" {
    let (_m2, op2) = pick(M { x: 0 }, false)
    assert_eq(op2.is_some(), 0)
}
