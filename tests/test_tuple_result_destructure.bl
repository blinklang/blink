type M { x: Int }

fn pick(m: M, ok: Bool) -> (M, Result[Int, Str]) {
    if ok { (m, Ok(7)) } else { (m, Err("no")) }
}

test "tuple-payload Result destructure Ok keeps ok type" {
    let (_m, r) = pick(M { x: 0 }, true)
    match r {
        Ok(v) => assert_eq(v, 7)
        Err(_e) => assert_eq(0, 1)
    }
}

test "tuple-payload Result destructure Err keeps err type" {
    let (_m, r) = pick(M { x: 0 }, false)
    match r {
        Ok(_v) => assert_eq(0, 1)
        Err(e) => assert_eq(e, "no")
    }
}
