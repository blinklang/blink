// A match on a tuple LITERAL whose element is a struct materializes each element
// into a _tup_ codegen temp (emit_match_expr, codegen_stmt.bl) that has no
// typecheck node of its own, so let_binding_tid never stamps it — the temp's
// struct name has lived only on the flat ScopeVar.sname channel.
// sv_struct_tid_first now recovers that name from the tuple element's own tid, so
// the flat sname is only a fallback. These guard that binding + field access
// through such a temp still resolve once the flat channel is gone.
type Point { x: Int, y: Int }

test "match on tuple literal with one struct element" {
    let p = Point { x: 3, y: 7 }
    match (p, 5) {
        (q, n) => {
            assert_eq(q.x, 3)
            assert_eq(q.y, 7)
            assert_eq(n, 5)
        }
    }
}

test "match on tuple literal with two struct elements" {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 8, y: 9 }
    match (a, b) {
        (u, v) => {
            assert_eq(u.x, 1)
            assert_eq(v.y, 9)
        }
    }
}
