// br 637sy9 (codegen-structured-tids). A tuple whose element is a generic-struct
// INSTANCE: (LocBox[Int], Int). resolve_tuple_ann's struct/enum-instance arm read
// the bare struct HEAD (c_type_tag_for_struct → "LocBox") for the element, so the
// tuple emitted `blink_Tuple2_LocBox_int` with member `blink_LocBox _0;` (arg-
// erased) — but the value stored is `blink_LocBox_Int`, so GCC errors with
// incompatible types / member access on a non-struct. The fix recurses the
// element annotation's type-args via mono_name_from_ann to the mono stem
// (LocBox_Int), mirroring the compound-carrier spellers.
//
// Spec §03_types.md:2066/2114 (monomorphization): each distinct instantiation is a
// separate C type with the concrete type-arg substituted. Runtime field access, so
// this MUST run via `task test` (archive-linked), not just compile.

type LocBox[T] {
    value: T
}

// A tuple element that is a struct instance appearing ONLY as a param type (never
// constructed) — exercises tuple-leaf registration off the annotation tid, not the
// construction path (code-review finding).
fn take_tuple(x: (LocBox[Int], Int)) -> Int { x.1 }

fn mk(v: Int) -> LocBox[Int] { LocBox { value: v } }

test "tuple element that is a struct instance preserves its concrete arg" {
    let b = mk(9)
    let t: (LocBox[Int], Int) = (b, 100)
    assert_eq(t.0.value, 9)
    assert_eq(t.1, 100)
}

test "tuple with two struct-instance elements of different args" {
    let bi = mk(3)
    let t: (LocBox[Int], LocBox[Int]) = (bi, mk(4))
    assert_eq(t.0.value, 3)
    assert_eq(t.1.value, 4)
}

// Nested struct-instance element (LocBox[LocBox[Int]]): the tuple field name must
// carry the FULL recursive stem (LocBox_LocBox_Int), which the shallow string path
// gets one level short — mono_name_from_ann now recurses nested-instance args
// (code-review finding).
test "tuple element that is a NESTED struct instance" {
    let inner = mk(5)
    let outer: LocBox[LocBox[Int]] = LocBox { value: inner }
    let t: (LocBox[LocBox[Int]], Int) = (outer, 9)
    assert_eq(t.0.value.value, 5)
}

// Struct-instance tuple element that appears ONLY as a fn param type, never
// constructed — the leaf mono instance is registered from the tuple annotation tid
// so its by-value member typedef exists (code-review finding).
test "tuple-instance param that is never constructed compiles and calls" {
    assert_eq(take_tuple((mk(2), 7)), 7)
}
