// A tuple pattern used as a LIST-pattern element panics the compiler instead of
// compiling. bind_pattern_vars' ListPattern element loop rebuilds match_scruts as a
// ONE-entry list and recurses into the TuplePattern sub-pattern with scrut_len == 1
// but n_elems == 2. The repair for that shape is gated on the rebuilt entry's
// scrut_sname being non-empty, but the rebuilt entry always carries scrut_sname: "",
// so the repair never runs and the per-element loop unwraps a None reading past the
// single scrutinee entry.
//
// Neither a bare tuple match nor a bare list-of-tuple element read (List[(Int, Int)]
// via .get()) trips this — only a tuple SUB-PATTERN nested inside a LIST pattern does.

import compile_test_helpers.{compile_and_run}

test "a tuple sub-pattern nested inside a list pattern compiles instead of panicking" {
    let src = #"
import std.io

fn pick(xs: List[(Int, Int)]) -> Int {
    match xs {
        [(a, b)] => a + b
        _ => 0
    }
}

fn main() {
    io.println("{pick([(3, 4)])}")
}
"#
    let r = compile_and_run(src, "_tuple_subpattern_in_list_pattern")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}
