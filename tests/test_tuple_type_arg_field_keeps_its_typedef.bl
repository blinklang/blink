// A tuple used as the TYPE ARGUMENT of a generic struct or enum is embedded in the
// instance by value, so the tuple's own carrier typedef must be registered before the
// instance that names it. Without that registration is_mono_struct_instance rejects the
// member and the field erases to `void`, which the C compiler rejects outright.

type TBox[T] { v: T }

type TPair[A, B] { a: A, b: B }

type TEnum[T] {
    TSome { p: T }
}

fn take_box(b: TBox[(Int, Int)]) -> Int {
    b.v.0 + b.v.1
}

fn take_pair(p: TPair[(Int, Int), Str]) -> Int {
    p.a.0 + p.a.1
}

test "an Option over a generic struct whose type argument is a tuple" {
    let empty: Option[TBox[(Int, Int)]] = None
    assert_eq(empty.is_some(), false)
    let filled: Option[TBox[(Int, Int)]] = Some(TBox { v: (3, 4) })
    assert_eq(filled.unwrap().v.0, 3)
    assert_eq(filled.unwrap().v.1, 4)
}

test "an Option over a generic struct with a Str tuple argument" {
    let s: Option[TBox[(Str, Int)]] = Some(TBox { v: ("hi", 5) })
    assert_eq(s.unwrap().v.0, "hi")
    assert_eq(s.unwrap().v.1, 5)
}

test "a nested generic instance whose inner argument is a tuple" {
    let n: Option[TBox[TBox[(Int, Int)]]] = Some(TBox { v: TBox { v: (7, 8) } })
    assert_eq(n.unwrap().v.v.0, 7)
    assert_eq(n.unwrap().v.v.1, 8)
}

test "a two-parameter generic struct with a tuple in the first slot" {
    let p: Option[TPair[(Int, Int), Str]] = Some(TPair { a: (1, 2), b: "x" })
    assert_eq(p.unwrap().a.0, 1)
    assert_eq(p.unwrap().a.1, 2)
    assert_eq(p.unwrap().b, "x")
}

test "a generic enum whose type argument is a tuple" {
    let e: Option[TEnum[(Int, Int)]] = Some(TEnum.TSome { p: (5, 6) })
    let total = match e.unwrap() {
        TEnum.TSome { p } => p.0 + p.1
    }
    assert_eq(total, 11)
}

test "a tuple type argument at a parameter position" {
    assert_eq(take_box(TBox { v: (10, 20) }), 30)
    assert_eq(take_pair(TPair { a: (4, 5), b: "y" }), 9)
}

test "a scalar type argument still registers" {
    let i: Option[TBox[Int]] = Some(TBox { v: 42 })
    assert_eq(i.unwrap().v, 42)
}
