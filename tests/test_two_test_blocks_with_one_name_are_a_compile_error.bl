import compile_test_helpers

// Two `test` blocks with one name in one module are E0851 DuplicateTestName (sections/02_syntax.md
// test blocks). Today `blink check` accepts them and `blink test` fails later, in the C
// compiler, on two definitions of one test symbol.

test.failing(
    "two test blocks with one name in one module are E0851 at blink check",
    reason: "the checker does not compare test names yet",
) {
    let dir = "{compile_test_helpers.scratch_root()}/two_test_blocks_one_name_{getpid()}"
    process.run("sh", ["-c", "rm -rf {dir}"])?
    process.run("sh", ["-c", "mkdir -p {dir}"])?
    let path = "{dir}/two_test_blocks_one_name.bl"
    fs.write(path, "test \"a\" \{ assert(true) }\ntest \"a\" \{ assert(true) }\n").unwrap()
    let r = process.run("build/blink", ["check", path]).unwrap()
    process.run("sh", ["-c", "rm -rf {dir}"])?
    let out = "{r.out}{r.err_out}"
    assert(!r.success(), "blink check accepted two test blocks named \"a\":\n{out}")
    assert(out.contains("DuplicateTestName"), out)
    assert(out.contains("E0851"), out)
}
