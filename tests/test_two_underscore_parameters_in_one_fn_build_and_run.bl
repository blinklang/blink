// A `_` parameter binds no name, so one fn or closure may have many of them. Each is still
// a parameter the caller passes, and the program must build and run in both modes.

import compile_test_helpers
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn expect_prints(tag: Str, lines: List[Str], want: Str) ! IO, FS.Write, Process.Spawn, Env.Read {
    let dir = "{compile_test_helpers.scratch_root()}/underscore_{tag}"
    let _ = sh("rm -rf {dir} && mkdir -p {dir}")
    fs.write("{dir}/x.bl", lines.join("\n").concat("\n")).unwrap()
    let mut bad = 0
    for mode in ["--per-module", "--no-per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE timeout 120 $B run {mode} x.bl < /dev/null")
        if !r.success() || r.out.trim() != want {
            io.eprintln("{tag} {mode}: ended {r.end}, printed [{r.out.trim()}], want [{want}]\n{r.err_out}")
            bad = bad + 1
        }
    }
    let _ = sh("rm -rf {dir}")
    assert_eq(bad, 0)
}

test "a fn with two underscore parameters" {
    expect_prints("fn", [
        "fn two(_: Int, _: Int) -> Int \{",
        "    7",
        "}",
        "fn three(_: Int, b: Int, _: Str) -> Int \{",
        "    b",
        "}",
        "fn main() \{",
        "    io.println(\"\{two(1, 2)} \{three(1, 2, \"z\")}\")",
        "}",
    ], "7 2")
}

test "a closure with two underscore parameters" {
    expect_prints("closure", [
        "fn apply(f: fn(Int, Int) -> Int) -> Int \{",
        "    f(1, 2)",
        "}",
        "fn main() \{",
        "    let k = 40",
        "    let g = fn(_: Int, _: Int) -> Int \{ k + 2 }",
        "    io.println(\"\{apply(g)}\")",
        "}",
    ], "42")
}
