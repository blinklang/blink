// The recursive shapes that are not a cycle of aliases (sections/03_types.md §3.4): a struct or
// enum stops the alias walk, and a generic alias applied to itself at a use is no cycle.

type P[X] = List[X]

type Node { name: Str, kids: Kids }
type Kids = List[Node]

type Tree[T] { Leaf(v: T), Branch(kids: Forest[T]) }
type Forest[T] = List[Tree[T]]

type A = B
type B = List[C]
type C = Int

fn count(n: Node) -> Int {
    let mut total = 1
    for k in n.kids { total = total + count(k) }
    total
}

fn sum(t: Tree[Int]) -> Int {
    match t {
        Tree.Leaf(v) => v
        Tree.Branch(kids) => {
            let mut total = 0
            for k in kids { total = total + sum(k) }
            total
        }
    }
}

test "a generic alias applied to itself names a list of lists" {
    let grid: P[P[Int]] = [[1, 2], [3]]
    assert_eq(grid.len(), 2)
    assert_eq(grid.get(0).unwrap().len(), 2)
}

test "an alias of a list of a struct holds that struct" {
    let leaf = Node { name: "leaf", kids: [] }
    let root = Node { name: "root", kids: [leaf, Node { name: "mid", kids: [leaf] }] }
    assert_eq(count(root), 4)
}

test "an alias of a list of a generic enum holds that enum" {
    let t: Tree[Int] = Tree.Branch([Tree.Leaf(1), Tree.Branch([Tree.Leaf(2), Tree.Leaf(3)])])
    assert_eq(sum(t), 6)
}

test "an alias chain with no cycle names its end" {
    let xs: A = [1, 2, 3]
    assert_eq(xs.len(), 3)
}
