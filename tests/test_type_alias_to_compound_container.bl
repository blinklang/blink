// A type alias to a compound container (Map[K,V]) must lower to the
// container's real runtime type, not a bare "blink_<AliasName>" struct
// typedef. Covers both a local annotation and a fn return type.

type IntMap = Map[Int, Str]

fn mkmap() -> IntMap {
    let mut m: IntMap = Map()
    m.insert(256, "lo")
    m
}

test "type alias to a compound container works as a local annotation" {
    let mut m: IntMap = Map()
    m.insert(256, "lo")
    assert_eq(m.get(256).unwrap(), "lo")
}

test "type alias to a compound container works as a fn return type" {
    let m = mkmap()
    assert_eq(m.get(256).unwrap(), "lo")
}
