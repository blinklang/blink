import compile_test_helpers

test "wrong arg count emits E0300" {
    let src = "fn add(a: Int, b: Int) -> Int \{ a + b \}\nfn main() \{ add(1, 2, 3) \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_argc", "E0300")
}

test "return type mismatch emits E0300" {
    let src = "fn give_int() -> Int \{ \"hello\" \}\nfn main() \{ give_int() \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_ret", "E0300")
}

test "nonexistent method emits E0505" {
    let src = "fn main() \{ let x = 42\n x.nonexistent_method()\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_method", "E0505")
}

test "unknown type name emits E0507" {
    let src = "fn main() \{ let _x: Piont = 42\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_unknown", "E0507")
}

test "List.contains wrong elem type emits E0300" {
    let src = "fn main() \{ let l = [1, 2, 3]\n let _ = l.contains(2.0)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_list_contains", "E0300")
}

test "List.push wrong elem type emits E0300" {
    let src = "fn main() \{ let mut l = [1, 2, 3]\n l.push(2.0)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_list_push", "E0300")
}

test "Str.contains non-Str arg emits E0300" {
    let src = "fn main() \{ let _ = \"hi\".contains(5)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_str_contains", "E0300")
}

test "Str.starts_with non-Str arg emits E0300" {
    let src = "fn main() \{ let _ = \"hi\".starts_with(5)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_str_starts", "E0300")
}

test "Set.contains non-Str arg emits E0300" {
    let src = "fn main() \{ let mut s: Set[Str] = Set()\n let _ = s.contains(5)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_set_contains", "E0300")
}

test "Set.insert non-Str arg emits E0300" {
    let src = "fn main() \{ let mut s: Set[Str] = Set()\n s.insert(5)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_set_insert", "E0300")
}

test "Map.get wrong key type emits E0300" {
    let src = "fn main() \{ let mut m: Map[Str, Int] = Map()\n let _ = m.get(5)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_map_get", "E0300")
}

test "Map.insert wrong value type emits E0300" {
    let src = "fn main() \{ let mut m: Map[Str, Int] = Map()\n m.insert(\"a\", 2.0)\n \}\n"
    compile_test_helpers.expect_compile_error(src, "type_err_map_insert", "E0300")
}
