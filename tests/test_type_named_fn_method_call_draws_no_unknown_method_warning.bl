// A free fn named `{Type}_{method}` gives `value.method()` and `Type.method()` (the stdlib
// method convention, used by lib/std/time.bl). Name resolution cannot see the method name in
// any impl, so it records the call for a later W0501; once inference resolves the call to the
// fn, that record must not turn into "method resolves to nothing". The controls keep the
// warning and the error for a name that resolves to nothing.

import compile_test_helpers.{compile_and_capture, expect_compiles_clean, expect_warning, expect_error}

fn expect_no_w0501(output: Str, label: Str) {
    let warned = output.contains("W0501")
    if warned { io.println("FAIL: {label} — unexpected W0501 in output: {output}") }
    assert(!warned)
}

test "an instance call of a Type_method fn draws no W0501" {
    let src = "type Box \{ v: Int \}\nfn Box_doubled(b: Box) -> Int \{ b.v * 2 \}\nfn main() \{\n  let b = Box \{ v: 3 \}\n  io.println(\"\{b.doubled()\}\")\n\}\n"
    let out = compile_and_capture(src, "_tnfm_instance")
    expect_compiles_clean(out, "instance call compiles")
    expect_no_w0501(out, "instance call")
}

test "a static call of a Type_method fn draws no W0501" {
    let src = "type Box \{ v: Int \}\nfn Box_make(v: Int) -> Box \{ Box \{ v: v \} \}\nfn main() \{\n  let b = Box.make(4)\n  io.println(\"\{b.v\}\")\n\}\n"
    let out = compile_and_capture(src, "_tnfm_static")
    expect_compiles_clean(out, "static call compiles")
    expect_no_w0501(out, "static call")
}

test "the std.time Date and Instant methods draw no W0501" {
    let src = "import std.time.\{Date, Instant\}\nfn main() \{\n  let d = Date.from_ymd(2026, 10, 17).unwrap()\n  let i = Instant.parse(\"2026-10-17T09:30:00Z\").unwrap()\n  io.println(\"\{d.weekday()\} \{d.add_days(1)\} \{i.date().days_since(d)\} \{i.hour()\}\")\n\}\n"
    let out = compile_and_capture(src, "_tnfm_time")
    expect_compiles_clean(out, "std.time calls compile")
    expect_no_w0501(out, "std.time calls")
}

test "a method name with no fn and an unknown receiver still warns W0501" {
    let src = "fn first[T](xs: List[T]) -> T \{ xs.get(0).unwrap() \}\nfn poke[T](x: T) \{\n  x.no_such_method_anywhere()\n\}\nfn main() \{\n  poke(first([1]))\n\}\n"
    let out = compile_and_capture(src, "_tnfm_control_warn")
    expect_warning(out, "W0501", "unknown name on a type variable")
}

test "a method name with no fn on a known receiver is still E0505" {
    let src = "type Box \{ v: Int \}\nfn main() \{\n  let b = Box \{ v: 3 \}\n  let _ = b.no_such_method_anywhere()\n\}\n"
    let out = compile_and_capture(src, "_tnfm_control_err")
    expect_error(out, "E0505", "unknown name on a known type")
}
