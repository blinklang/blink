// A type parameter of the body being checked has only the bounds its binders give (§3.6
// Trait Bounds). A callee's bound holds at the type its binder takes, whether the call's
// arguments fill that type, a use after the call fills it (`let mut l = []` then `l.push(x)`),
// the callee is named as a fn value whose type an annotation fills, or the call names the
// trait (`Same.same(l)`). Each path judges the bound by the same rule, against the
// binders of the body that made the call: a bound met through a generic impl
// (`impl[T: Eq] Same for List[T]`) and a bound on a generic trait at its trait arguments
// (`V: Conv[K]`). A miss is one E0306 in that body, with the help that adds the bound. A bound
// written on the binder, in an impl's where clause, or given through a supertrait meets it, and
// so does a concrete type that has the trait. An `@allow` on the body silences the miss there.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, TypeCheck}
import diagnostics.{diag_entries, diag_reset, Diag}
import embedded_stdlib_registry.{init_embedded_stdlib}
import lexer.{Lex}
import parser.{Parse}

fn probe(path: Str, src: Str) -> Int ! FS, Env.Exit, Env.Read, IO {
    with handler Diag {}, handler Lex {}, handler Parse {}, handler TypeCheck {} {
        init_embedded_stdlib()
        fs.write(path, src).unwrap()
        diag_reset()
        let program = compile_to_program(path, 1)
        check_types(program)
        let _ = fs.delete(path)
        program
    }
}

fn errors_reported() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" { out.push("{d.code} {d.line}:{d.col} | {d.help}") }
    }
    out
}

// The program shares one prelude, so the body under test starts on line 15.
fn errors_for(name: Str, body: Str) -> List[Str] ! FS, Env.Exit, Env.Read, IO {
    let src = [
        "trait Same \{ fn same(self) -> Bool }",
        "impl[T: Eq] Same for List[T] \{ fn same(self) -> Bool \{ self.len() < 2 || self.get(0).unwrap() == self.get(1).unwrap() } }",
        "fn all_same[X: Same](x: X) -> Bool \{ x.same() }",
        "trait Conv[A] \{ fn conv(self) -> Int }",
        "trait Wide[K]: Conv[K] \{ fn wide(self) -> Int }",
        "impl Conv[Int] for Int \{ fn conv(self) -> Int \{ 7 } }",
        "type Px[K, V] \{ k: K, v: V }",
        "trait Shown \{ fn shown(self) -> Int }",
        "impl[K, V: Conv[K]] Shown for Px[K, V] \{ fn shown(self) -> Int \{ self.v.conv() } }",
        "fn show_it[X: Shown](x: X) -> Int \{ x.shown() }",
        "fn need_list[K, V: Conv[K]](k: K, vs: List[V]) -> Int \{ vs.len() }",
        "type Hd[T] \{ v: T }",
        "trait Ck \{ fn chk(self) -> Bool }",
        "type NoEq \{ a: Int }",
        body,
        "fn main() \{ }",
        "",
    ].join("\n")
    let _ = probe("build/tc_late_bound_{name}.bl", src)
    errors_reported()
}

// Refused: a bound met through a generic impl, at a type that holds a body parameter.

test "a callee bound met through an impl is E0306 when a use after the call fills the type" {
    assert_eq(errors_for("late", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(x)",
        "    r",
        "}",
    ].join("\n")), ["E0306 17:13 | write the bound on the binder: `[T: Eq]`"])
}

test "a callee bound met through an impl is E0306 when the callee is a fn value" {
    assert_eq(errors_for("fn_value", [
        "fn h[T](x: List[T]) -> Bool \{",
        "    let f: fn(List[T]) -> Bool = all_same",
        "    f(x)",
        "}",
    ].join("\n")), ["E0306 16:34 | write the bound on the binder: `[T: Eq]`"])
}

test "a trait-qualified call is E0306 when a use after the call fills the type" {
    assert_eq(errors_for("static_late", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = Same.same(l)",
        "    l.push(x)",
        "    r",
        "}",
    ].join("\n")), ["E0306 17:13 | write the bound on the binder: `[T: Eq]`"])
}

test "an impl method body without the bound is E0306 at each deferred path" {
    assert_eq(errors_for("impl_body", [
        "impl[T] Ck for Hd[T] \{",
        "    fn chk(self) -> Bool \{",
        "        let mut l = []",
        "        let r = all_same(l)",
        "        l.push(self.v)",
        "        let f: fn(List[T]) -> Bool = all_same",
        "        r && f([self.v])",
        "    }",
        "}",
    ].join("\n")), [
        "E0306 18:17 | write the bound on the binder: `[T: Eq]`",
        "E0306 20:38 | write the bound on the binder: `[T: Eq]`",
    ])
}

// Refused: a bound on a generic trait at its trait arguments.

test "a callee bound at a trait argument is E0306 when a use after the call fills the type" {
    assert_eq(errors_for("late_args", [
        "fn f[K2, A: Conv[Int]](k: K2, a: A) -> Int \{",
        "    let mut l = []",
        "    let r = need_list(k, l)",
        "    l.push(a)",
        "    r",
        "}",
    ].join("\n")), ["E0306 17:13 | write ` + Conv[K2]` on the bound list of `A`"])
}

test "a callee bound at a trait argument is E0306 when the callee is a fn value" {
    assert_eq(errors_for("fn_value_args", [
        "fn f[K2, A: Conv[Int]](k: K2, a: A) -> Int \{",
        "    let f: fn(K2, List[A]) -> Int = need_list",
        "    f(k, [a])",
        "}",
    ].join("\n")), ["E0306 16:37 | write ` + Conv[K2]` on the bound list of `A`"])
}

test "an impl bound at a trait argument is E0306 at each deferred path" {
    assert_eq(errors_for("impl_args", [
        "fn g[K2, A: Conv[Int]](p: Px[K2, A]) -> Int \{",
        "    let f: fn(Px[K2, A]) -> Int = show_it",
        "    f(p)",
        "}",
        "fn s[X: Shown](xs: List[X]) -> Int \{ xs.len() }",
        "fn q[K2, A: Conv[Int]](k: K2, a: A) -> Int \{",
        "    let mut l = []",
        "    let r = s(l)",
        "    l.push(Px \{ k: k, v: a })",
        "    r",
        "}",
    ].join("\n")), [
        "E0306 22:13 | write ` + Conv[K2]` on the bound list of `A`",
        "E0306 16:35 | write ` + Conv[K2]` on the bound list of `A`",
    ])
}

test "an allow on the body silences each deferred path there and nowhere else" {
    assert_eq(errors_for("allowed", [
        "@allow(TraitBoundNotSatisfied)",
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(x)",
        "    let f: fn(List[T]) -> Bool = all_same",
        "    let mut m = []",
        "    let s = Same.same(m)",
        "    m.push(x)",
        "    r && f([x]) && s",
        "}",
        "fn g[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(x)",
        "    r",
        "}",
    ].join("\n")), ["E0306 28:13 | write the bound on the binder: `[T: Eq]`"])
}

// Accepted: the bound written, in each form.

test "a bound on the binder meets the bound at each deferred path" {
    assert_eq(errors_for("met_inline", [
        "fn h[T: Eq](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(x)",
        "    let f: fn(List[T]) -> Bool = all_same",
        "    let mut m = []",
        "    let s = Same.same(m)",
        "    m.push(x)",
        "    r && f([x]) && s",
        "}",
        "fn k[K2, A: Conv[K2]](k: K2, a: A, p: Px[K2, A]) -> Int \{",
        "    let mut l = []",
        "    let r = need_list(k, l)",
        "    l.push(a)",
        "    let f: fn(K2, List[A]) -> Int = need_list",
        "    let g: fn(Px[K2, A]) -> Int = show_it",
        "    r + f(k, [a]) + g(p)",
        "}",
    ].join("\n")), [])
}

test "a bound in an impl's where clause meets the bound at each deferred path" {
    assert_eq(errors_for("met_where", [
        "impl[T] Ck for Hd[T] where T: Eq \{",
        "    fn chk(self) -> Bool \{",
        "        let mut l = []",
        "        let r = all_same(l)",
        "        l.push(self.v)",
        "        let f: fn(List[T]) -> Bool = all_same",
        "        let mut m = []",
        "        let s = Same.same(m)",
        "        m.push(self.v)",
        "        r && f([self.v]) && s",
        "    }",
        "}",
    ].join("\n")), [])
}

test "a bound given through a supertrait meets the bound at each deferred path" {
    assert_eq(errors_for("met_super", [
        "fn h[T: Ord](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(x)",
        "    let f: fn(List[T]) -> Bool = all_same",
        "    let mut m = []",
        "    let s = Same.same(m)",
        "    m.push(x)",
        "    r && f([x]) && s",
        "}",
        "fn k[K2, A: Wide[K2]](k: K2, a: A, p: Px[K2, A]) -> Int \{",
        "    let mut l = []",
        "    let r = need_list(k, l)",
        "    l.push(a)",
        "    let f: fn(K2, List[A]) -> Int = need_list",
        "    let g: fn(Px[K2, A]) -> Int = show_it",
        "    r + f(k, [a]) + g(p)",
        "}",
    ].join("\n")), [])
}

test "a concrete type that has the trait meets the bound at each deferred path" {
    assert_eq(errors_for("met_concrete", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(1)",
        "    let f: fn(List[Str]) -> Bool = all_same",
        "    r && f([\"a\"])",
        "}",
        "fn k[K2](k: K2) -> Int \{",
        "    let mut l = []",
        "    let r = need_list(1, l)",
        "    l.push(2)",
        "    let g: fn(Px[Int, Int]) -> Int = show_it",
        "    r + g(Px \{ k: 1, v: 2 })",
        "}",
    ].join("\n")), [])
}

test "a concrete type without the trait is still E0306 at each deferred path" {
    assert_eq(errors_for("concrete_miss", [
        "fn h() -> Bool \{",
        "    let mut l = []",
        "    let r = all_same(l)",
        "    l.push(NoEq \{ a: 1 })",
        "    let f: fn(List[NoEq]) -> Bool = all_same",
        "    r && f([NoEq \{ a: 1 }])",
        "}",
    ].join("\n")), [
        "E0306 17:13 | add `@derive(Eq)` to `type NoEq`",
        "E0306 19:37 | add `@derive(Eq)` to `type NoEq`",
    ])
}
