// A conversion through a generic From or TryFrom impl holds that impl's bounds at the type
// arguments the call gives its binders (§3.6 Trait Bounds, "Polymorphic Trait
// Implementations"; §3c.2), by the same rule as a call to `fn f[X: Eq](x: X)`. A type parameter
// of the body being checked has only the bounds its binders give, so `Wr.from(l)` with
// `l: List[T]` through `impl[T: Eq] From[List[T]] for Wr[T]` is E0306 in that body, with the
// help that adds the bound. The rule holds for `Type.from(x)`, `Type.try_from(x)` and
// `x.into()`, for an argument the body's parameters type, and for one a use after the call
// fills (`let mut l = []` then `l.push(x)`). A miss is one report. A bound written on the binder,
// in an impl's where clause, or given through a supertrait meets it, and so does a concrete
// type that has the trait. An `@allow` on the body silences the miss there.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn probe(path: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    init_embedded_stdlib()
    fs.write(path, src).unwrap()
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    program
}

fn errors_reported() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" { out.push("{d.code} {d.line}:{d.col} | {d.help}") }
    }
    out
}

// The program shares one prelude, so the body under test starts on line 14.
fn errors_for(name: Str, body: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    let src = [
        "type NoEq \{ a: Int }",
        "type Wr[T] \{ v: List[T] }",
        "impl[T: Eq] From[List[T]] for Wr[T] \{ fn from(v: List[T]) -> Wr[T] \{ Wr \{ v: v } } }",
        "type Tw[T] \{ v: List[T] }",
        "impl[T: Eq] TryFrom[List[T]] for Tw[T] \{ fn try_from(v: List[T]) -> Result[Tw[T], ConversionError] \{ Ok(Tw \{ v: v }) } }",
        "trait Conv[A] \{ fn conv(self) -> Int }",
        "trait Wide[K]: Conv[K] \{ fn wide(self) -> Int }",
        "impl Conv[Int] for Int \{ fn conv(self) -> Int \{ 7 } }",
        "type Pc[K, V] \{ vs: List[V] }",
        "impl[K, V: Conv[K]] From[List[V]] for Pc[K, V] \{ fn from(v: List[V]) -> Pc[K, V] \{ Pc \{ vs: v } } }",
        "trait Ck \{ fn chk(self) -> Int }",
        "type Bx[T] \{ v: T }",
        "type Sb[T] \{ v: List[T] }",
        body,
        "fn main() \{ }",
        "",
    ].join("\n")
    let _ = probe("build/tc_conversion_impl_bound_{name}.bl", src)
    errors_reported()
}

// Refused: a bound met through a generic conversion impl, at a type that holds a body parameter.

test "a static from call is E0306 when its argument holds a body parameter" {
    assert_eq(errors_for("from", [
        "fn h[T](l: List[T]) -> Int \{",
        "    let w = Wr.from(l)",
        "    w.v.len()",
        "}",
    ].join("\n")), ["E0306 15:13 | write the bound on the binder: `[T: Eq]`"])
}

test "a static try_from call is E0306 when its argument holds a body parameter" {
    assert_eq(errors_for("try_from", "fn h[T](l: List[T]) -> Bool \{ Tw.try_from(l).is_ok() }"),
        ["E0306 14:31 | write the bound on the binder: `[T: Eq]`"])
}

test "an into call is E0306 when its receiver holds a body parameter" {
    assert_eq(errors_for("into", [
        "fn h[T](l: List[T]) -> Int \{",
        "    let w: Wr[T] = l.into()",
        "    w.v.len()",
        "}",
    ].join("\n")), ["E0306 15:20 | write the bound on the binder: `[T: Eq]`"])
}

test "a static from call is E0306 when a use after the call fills the argument" {
    assert_eq(errors_for("from_late", [
        "fn h[T](x: T) -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(x)",
        "    w.v.len()",
        "}",
    ].join("\n")), ["E0306 16:13 | write the bound on the binder: `[T: Eq]`"])
}

test "a static try_from call is E0306 when a use after the call fills the argument" {
    assert_eq(errors_for("try_from_late", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let w = Tw.try_from(l)",
        "    l.push(x)",
        "    w.is_ok()",
        "}",
    ].join("\n")), ["E0306 16:13 | write the bound on the binder: `[T: Eq]`"])
}

test "an into call is E0306 when a use after the call fills the receiver" {
    assert_eq(errors_for("into_late", [
        "fn h[T](x: T) -> Int \{",
        "    let mut l = []",
        "    let w: Wr[T] = l.into()",
        "    l.push(x)",
        "    w.v.len()",
        "}",
    ].join("\n")), ["E0306 16:20 | write the bound on the binder: `[T: Eq]`"])
}

test "an impl method body without the bound is E0306 at a conversion" {
    assert_eq(errors_for("impl_body", [
        "impl[T] Ck for Bx[T] \{",
        "    fn chk(self) -> Int \{",
        "        let mut l = []",
        "        let w = Wr.from(l)",
        "        l.push(self.v)",
        "        w.v.len() + Wr.from([self.v]).v.len()",
        "    }",
        "}",
    ].join("\n")), [
        "E0306 19:21 | write the bound on the binder: `[T: Eq]`",
        "E0306 17:17 | write the bound on the binder: `[T: Eq]`",
    ])
}

test "a static conversion a generic callee's argument holds is E0306 at a body parameter" {
    assert_eq(errors_for("callee", [
        "fn take[U](w: Wr[U]) -> Int \{ w.v.len() }",
        "fn tk2[U](r: Result[Tw[U], ConversionError]) -> Int \{ r.unwrap().v.len() }",
        "fn h[T](l: List[T]) -> Int \{",
        "    let a = take(Wr.from(l))",
        "    a + tk2(Tw.try_from(l))",
        "}",
    ].join("\n")), [
        "E0306 17:18 | write the bound on the binder: `[T: Eq]`",
        "E0306 18:13 | write the bound on the binder: `[T: Eq]`",
    ])
}

test "a field default is E0533, and E0306 at a conversion its type's parameters do not bound" {
    assert_eq(errors_for("field_default", [
        "type S[T] \{ w: Wr[T] = Wr.from([]) }",
        "type S2[T] \{ w: Wr[T] = [].into() }",
    ].join("\n")), [
        "E0533 14:24 | compute the value in a constructor fn: `fn s[T]() -> S[T] \{ S \{ w: ... } }`, or make the field `Option[Wr[T]]`",
        "E0306 14:24 | write the bound on the binder: `[T: Eq]`",
        "E0533 15:25 | compute the value in a constructor fn: `fn s2[T]() -> S2[T] \{ S2 \{ w: ... } }`, or make the field `Option[Wr[T]]`",
        "E0306 15:25 | write the bound on the binder: `[T: Eq]`",
    ])
}

test "a trait default method is E0306 at a conversion of Self without the trait" {
    assert_eq(errors_for("trait_default", [
        "trait Q \{ fn q(self) -> Int \{",
        "    let w: Wr[Self] = [self].into()",
        "    w.v.len() } }",
    ].join("\n")), ["E0306 15:23 | write ` + Eq` on the bound list of `Self`"])
}

// A concrete type at the call rules the impl out, so there is no conversion (E0312). One that
// a use after the call puts in the argument misses the bound of the impl the call chose (E0306).
test "a concrete type without the trait is refused at each conversion" {
    assert_eq(errors_for("concrete_miss", [
        "fn h() -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(NoEq \{ a: 1 })",
        "    let v: Wr[NoEq] = [NoEq \{ a: 1 }].into()",
        "    w.v.len() + v.v.len() + Wr.from([NoEq \{ a: 1 }]).v.len()",
        "}",
    ].join("\n")), [
        "E0312 18:23 | declare the impl, or name the conversion: `.to_float()` widens, `.truncate()` drops a fraction, `.to_int_checked()` checks the range, `Wr[NoEq].try_from(x)` can fail, `.to_string()` renders text",
        "E0312 19:29 | declare the impl, or name the conversion: `.to_float()` widens, `.truncate()` drops a fraction, `.to_int_checked()` checks the range, `Wr.try_from(x)` can fail, `.to_string()` renders text",
        "E0306 16:13 | add `@derive(Eq)` to `type NoEq`",
    ])
}

// Refused: a bound on a generic trait at its trait arguments, reached by a conversion.

test "a conversion is E0306 at a trait argument the body's binders do not give" {
    assert_eq(errors_for("args", [
        "fn f[K2, A: Conv[Int]](l: List[A]) -> Int \{",
        "    let p: Pc[K2, A] = Pc.from(l)",
        "    let q: Pc[K2, A] = l.into()",
        "    p.vs.len() + q.vs.len()",
        "}",
    ].join("\n")), [
        "E0306 15:24 | write ` + Conv[K2]` on the bound list of `A`",
        "E0306 16:24 | write ` + Conv[K2]` on the bound list of `A`",
    ])
}

test "an allow on the body silences the conversion there and nowhere else" {
    assert_eq(errors_for("allowed", [
        "@allow(TraitBoundNotSatisfied)",
        "fn h[T](x: T, y: List[T]) -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(x)",
        "    w.v.len() + Wr.from(y).v.len()",
        "}",
        "fn g[T](x: T) -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(x)",
        "    w.v.len()",
        "}",
    ].join("\n")), ["E0306 23:13 | write the bound on the binder: `[T: Eq]`"])
}

// A bound that names `Self` reads it as the conversion's target.

test "a conversion is E0306 at a bound that names Self, the target type" {
    assert_eq(errors_for("self_arg", [
        "impl[T: Conv[Self]] From[List[T]] for Sb[T] \{ fn from(v: List[T]) -> Sb[T] \{ Sb \{ v: v } } }",
        "fn k[T](l: List[T]) -> Int \{ Sb.from(l).v.len() }",
    ].join("\n")), ["E0306 15:30 | write the bound on the binder: `[T: Conv[Sb[T]]]`"])
}

test "a bound that names Self is met by the target type" {
    assert_eq(errors_for("self_met", [
        "impl[T: Conv[Self]] From[List[T]] for Sb[T] \{ fn from(v: List[T]) -> Sb[T] \{ Sb \{ v: v } } }",
        "impl Conv[Sb[Int]] for Int \{ fn conv(self) -> Int \{ 1 } }",
        "fn g(l: List[Int]) -> Int \{ Sb.from(l).v.len() }",
        "fn k[T: Conv[Sb[T]]](l: List[T]) -> Int \{",
        "    let s: Sb[T] = l.into()",
        "    Sb.from(l).v.len() + s.v.len()",
        "}",
    ].join("\n")), [])
}

// Accepted: the bound written, in each form.

test "a bound on the binder meets the bound at each conversion path" {
    assert_eq(errors_for("met_inline", [
        "fn h[T: Eq](x: T, y: List[T]) -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(x)",
        "    let mut m = []",
        "    let t = Tw.try_from(m)",
        "    m.push(x)",
        "    let mut n = []",
        "    let u: Wr[T] = n.into()",
        "    n.push(x)",
        "    let v: Wr[T] = y.into()",
        "    w.v.len() + u.v.len() + v.v.len() + Wr.from(y).v.len() + Tw.try_from(y).unwrap().v.len() + t.unwrap().v.len()",
        "}",
        "fn k[K2, A: Conv[K2]](l: List[A]) -> Int \{",
        "    let p: Pc[K2, A] = Pc.from(l)",
        "    let q: Pc[K2, A] = l.into()",
        "    p.vs.len() + q.vs.len()",
        "}",
    ].join("\n")), [])
}

test "a bound in an impl's where clause meets the bound at each conversion path" {
    assert_eq(errors_for("met_where", [
        "impl[T] Ck for Bx[T] where T: Eq \{",
        "    fn chk(self) -> Int \{",
        "        let mut l = []",
        "        let w = Wr.from(l)",
        "        l.push(self.v)",
        "        let u: Wr[T] = [self.v].into()",
        "        w.v.len() + u.v.len() + Wr.from([self.v]).v.len() + Tw.try_from([self.v]).unwrap().v.len()",
        "    }",
        "}",
    ].join("\n")), [])
}

test "a bound given through a supertrait meets the bound at each conversion path" {
    assert_eq(errors_for("met_super", [
        "fn h[T: Ord](x: T, y: List[T]) -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(x)",
        "    let u: Wr[T] = y.into()",
        "    w.v.len() + u.v.len() + Wr.from(y).v.len() + Tw.try_from(y).unwrap().v.len()",
        "}",
        "fn k[K2, A: Wide[K2]](l: List[A]) -> Int \{",
        "    let p: Pc[K2, A] = Pc.from(l)",
        "    let q: Pc[K2, A] = l.into()",
        "    p.vs.len() + q.vs.len()",
        "}",
    ].join("\n")), [])
}

test "a concrete type that has the trait meets the bound at each conversion path" {
    assert_eq(errors_for("met_concrete", [
        "fn h[T](x: T) -> Int \{",
        "    let mut l = []",
        "    let w = Wr.from(l)",
        "    l.push(1)",
        "    let u: Wr[Str] = [\"a\"].into()",
        "    let p: Pc[Int, Int] = Pc.from([1])",
        "    w.v.len() + u.v.len() + p.vs.len() + Tw.try_from([1]).unwrap().v.len()",
        "}",
    ].join("\n")), [])
}

test "a bound on the binder meets the bound where a generic callee's argument holds the conversion" {
    assert_eq(errors_for("met_callee", [
        "fn take[U](w: Wr[U]) -> Int \{ w.v.len() }",
        "fn tk2[U](r: Result[Tw[U], ConversionError]) -> Int \{ r.unwrap().v.len() }",
        "fn h[T: Eq](l: List[T]) -> Int \{ take(Wr.from(l)) + tk2(Tw.try_from(l)) + take(l.into()) }",
    ].join("\n")), [])
}

test "a bound on the type's parameter or a supertrait of the trait meets the bound in a default, which is only E0533" {
    assert_eq(errors_for("met_default", [
        "type S[T: Eq] \{ w: Wr[T] = Wr.from([]), u: Wr[T] = [].into() }",
        "trait Q: Eq \{ fn q(self) -> Int \{",
        "    let w: Wr[Self] = [self].into()",
        "    w.v.len() } }",
    ].join("\n")), [
        "E0533 14:28 | compute the value in a constructor fn: `fn s[T]() -> S[T] \{ S \{ w: ... } }`, or make the field `Option[Wr[T]]`",
        "E0533 14:52 | compute the value in a constructor fn: `fn s[T]() -> S[T] \{ S \{ u: ... } }`, or make the field `Option[Wr[T]]`",
    ])
}
