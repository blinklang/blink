// A `pub import` re-export forwards only the pub items of its source module. The qualified
// privacy check asked only whether the facade module itself kept the name private, and a
// facade declares nothing, so `facade.private_fn()` passed while name resolution followed the
// re-export to the private declaration.

import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

fn probe(path: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    diag_reset()
    check_types(compile_to_program(path, 1))
}

fn errors() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    out
}

fn has_error_naming(name: Str, subject: Str) -> Bool {
    for e in errors() {
        if e.starts_with("{name}: ") && e.contains(subject) { return true }
    }
    false
}

fn expect_private(path: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, IO {
    probe(path)
    if !has_error_naming("PrivateItemAccess", "zzfp_secret") {
        io.println("FAIL: no PrivateItemAccess for 'zzfp_secret' in {path}; got:")
        for e in errors() { io.println("  {e}") }
    }
    assert(has_error_naming("PrivateItemAccess", "zzfp_secret"))
}

test "a private function called through a facade's qualifier is E1003" {
    expect_private("tests/zzfp_facade_private/src/main_facade_private.bl")
}

test "a private function called through a facade over a facade is E1003" {
    expect_private("tests/zzfp_facade_private/src/main_two_hop_private.bl")
}

test "a bare private function with only the facade imported is E1003, not a facade suggestion" {
    expect_private("tests/zzfp_facade_private/src/main_facade_bare_private.bl")
    for e in errors() { assert(!e.contains("zzfp_facade.zzfp_secret")) }
}

test "a private type named through a facade's qualifier is E1003" {
    probe("tests/zzfp_facade_private/src/main_facade_private_type.bl")
    if !has_error_naming("PrivateItemAccess", "ZzfpHidden") {
        io.println("FAIL: no PrivateItemAccess for 'ZzfpHidden'; got:")
        for e in errors() { io.println("  {e}") }
    }
    assert(has_error_naming("PrivateItemAccess", "ZzfpHidden"))
}

test "a pub function called through a facade still resolves" {
    probe("tests/zzfp_facade_private/src/main_facade_pub.bl")
    let errs = errors()
    if errs.len() != 0 {
        io.println("FAIL: a pub item through a facade reported:")
        for e in errs { io.println("  {e}") }
    }
    assert(errs.len() == 0)
}
