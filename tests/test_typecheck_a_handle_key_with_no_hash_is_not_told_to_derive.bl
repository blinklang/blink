// A handle type has no fields, so @derive(Hash) on it is refused (NonDerivableTrait). An E1400
// for a handle key with no Hash must not tell the program to add that derive.

import compile_test_helpers

fn has(text: Str, part: Str, label: Str) {
    assert(text.contains(part), "{label}: expected `{part}` in:\n{text}")
}

fn lacks(text: Str, part: Str, label: Str) {
    assert(!text.contains(part), "{label}: did not expect `{part}` in:\n{text}")
}

test "a standard library handle with no Hash is refused as a key, with no derive in the help" {
    let out = compile_test_helpers.compile_and_capture(#"import std.db_sqlite.{Sqlite3Stmt}
fn count(m: Map[Sqlite3Stmt, Int]) -> Int { m.len() }
fn main() {
    let s: Set[Sqlite3Stmt] = Set.new()
    io.println("{s.len()}")
}
"#, "handle_key_std")
    has(out, "\"code\":\"E1400\"", "the handle has no Hash")
    has(out, "a program cannot give it one", "the reason says no impl can be written")
    lacks(out, "@derive(Hash, Eq) to", "the help")
}

test "a handle the program declares is told to write the impls, not to derive them" {
    let out = compile_test_helpers.compile_and_capture(#"@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
fn main() {
    let s: Set[CFile] = Set.new()
    io.println("{s.len()}")
}
"#, "handle_key_own")
    has(out, "\"code\":\"E1400\"", "the handle has no Hash")
    has(out, "write `impl Hash` and `impl Eq` for `CFile`", "the help")
    lacks(out, "@derive(Hash, Eq) to", "the help")
}
