// A call such as `rand.shuffle(deck)` loads std.random so that its fix can check the call
// with the helper's signature (sections/04_effects.md §4.4.7). The file did not import the
// module, so the load binds no name in it and adds no diagnostic of its own.

import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

let DIR: Str = "tests/zzhl_helper_load/src"

fn diags_of(file: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    diag_reset()
    check_types(compile_to_program("{DIR}/{file}", 1))
    let mut out: List[Str] = []
    for d in diag_entries { out.push("{d.severity} {d.name} {d.line}:{d.col}") }
    out
}

test "a selected shuffle of another module stays the bare call's callee" {
    assert_eq(diags_of("main_selected.bl"), ["error UnresolvedMethod 4:5"])
}

test "a bare helper call is an undefined function, not a missing selection" {
    assert_eq(diags_of("main_bare.bl"), ["error UndefinedFunction 2:13", "error UnresolvedMethod 3:5"])
}

test "a bare helper call is checked against no signature" {
    assert_eq(diags_of("main_bare_typed.bl"), ["error UndefinedFunction 2:18", "error UnresolvedMethod 4:5"])
}

test "a bare helper name read as a value has no type" {
    assert_eq(diags_of("main_bare_value.bl"), ["error UndefinedVariable 2:13", "error UnresolvedMethod 4:5"])
}

test "the helper's qualifier with no import is an unknown name, with no signature or module" {
    assert_eq(diags_of("main_unbound_qualifier.bl"), [
        "error UndefinedVariable 2:18", "error UnresolvedMethod 4:5", "warning UnknownMethod 2:18",
    ])
}

// A whole import binds only its qualifier, so the bare call names the module that declares it,
// and the helper of the same spelling takes no part.
test "a name a whole import declares beside a helper names that import" {
    assert_eq(diags_of("main_whole_namesake.bl"), ["error UnresolvedMethod 4:24", "error ImportNotSelected 5:5"])
    let mut help = ""
    for d in diag_entries {
        if d.name == "ImportNotSelected" { help = d.message }
    }
    assert(help.contains("zzhl_cards.shuffle"))
}
