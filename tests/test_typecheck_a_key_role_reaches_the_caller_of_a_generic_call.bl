// sections/03_types.md §3.6 "Non-hashable keys and elements in general": a Map key or Set
// element type that does not implement Hash is E1400 MapKeyNotHashable at type-check. A generic
// fn that keys a Map or Set by its type parameter is judged at each call, by the type the call
// gives that parameter. A generic fn that passes its own type parameter on to such a fn (bare,
// in a tuple, or in a @derive(Hash, Eq) type) uses it as a key too, so its own callers are
// judged the same way, through any depth of calls and through recursion, in any declaration
// order. Before, only the innermost call was judged: a call one level up passed `blink check`
// and stopped the build with an internal error. Each refused row has an accepted control, so a
// check that refuses every nested key cannot pass.
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import std.fs
import std.io

// Every error as `Name@line: message`, one per line, in report order.
fn probe(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO, Process.Spawn {
    let path = "build/{stem}_probe.bl"
    fs.write(path, src).unwrap()
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process.run("rm", ["-f", path]).unwrap()
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}@{d.line}: {d.message}") }
    }
    out.join("\n")
}

fn expect(label: Str, got: Str, want: Str) ! IO.Print {
    if got != want { io.println("FAIL: {label}:\n  got:  {got}\n  want: {want}") }
    assert(got == want)
}

let types_src = "type Widget \{ id: Int }\n@derive(Hash, Eq)\ntype HWidget \{ id: Int }\n"

let wrap_set = "fn wrap[K](k: K) -> Int \{\n    let mut s = Set()\n    s.insert(k)\n    s.len()\n}\n"
let wrap_map = "fn wrap[K](k: K) -> Int \{\n    let mut m = Map()\n    m.insert(k, 1)\n    m.len()\n}\n"
let wrap_written = "fn wrap[K](k: K) -> Int \{\n    let mut s: Set[K] = Set()\n    s.insert(k)\n    s.len()\n}\n"

// The program `fns`, then a last line `main` that calls `outer` with `arg`.
fn src_of(fns: Str, arg: Str) -> Str {
    "{types_src}{fns}fn main() \{ assert(outer({arg}) >= 0) }\n"
}

// The line of `main` in `src_of`, which is the last.
fn main_line(src: Str) -> Int { src.lines().len() }

fn set_elem(f: Str, tp: Str, ty: Str) -> Str { "`{ty}` does not implement Hash — `{f}` uses its type parameter {tp} as a Set element" }
fn map_key(f: Str, tp: Str, ty: Str) -> Str { "`{ty}` does not implement Hash — `{f}` uses its type parameter {tp} as a Map key" }

let outer_bare = "fn outer[T](t: T) -> Int \{ wrap(t) }\n"

fn refused(stem: Str, fns: Str, f: Str, tp: Str, set: Bool) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO, Process.Spawn {
    let src = src_of(fns, "Widget \{ id: 1 }")
    let words = if set { set_elem(f, tp, "Widget") } else { map_key(f, tp, "Widget") }
    expect(stem, probe(stem, src), "MapKeyNotHashable@{main_line(src)}: {words}")
    expect("{stem} control", probe("{stem}_ok", src_of(fns, "HWidget \{ id: 1 }")), "")
}

test "a type parameter passed to an inferred Set element is refused at the outer call" {
    refused("tc_nkey_set", "{wrap_set}{outer_bare}", "outer", "T", true)
}

test "a type parameter passed to an inferred Map key is refused at the outer call" {
    refused("tc_nkey_map", "{wrap_map}{outer_bare}", "outer", "T", false)
}

test "a type parameter passed to a written Set element is refused at the outer call" {
    refused("tc_nkey_written", "{wrap_written}{outer_bare}", "outer", "T", true)
}

test "a key role reaches through three calls in either declaration order" {
    let mid = "fn mid[U](u: U) -> Int \{ wrap(u) }\n"
    let outer = "fn outer[T](t: T) -> Int \{ mid(t) }\n"
    refused("tc_nkey_depth", "{wrap_set}{mid}{outer}", "outer", "T", true)
    refused("tc_nkey_depth_rev", "{outer}{mid}{wrap_set}", "outer", "T", true)
}

test "a type parameter passed in a tuple is refused at the outer call" {
    refused("tc_nkey_tuple", "{wrap_set}fn outer[T](t: T) -> Int \{ wrap((t, 1)) }\n", "outer", "T", true)
}

test "a type parameter passed in a derived Hash type is refused at the outer call" {
    let boxed = "@derive(Hash, Eq)\ntype Boxed[A] \{ v: A }\nfn outer[T](t: T) -> Int \{ wrap(Boxed \{ v: t }) }\n"
    refused("tc_nkey_boxed", "{wrap_set}{boxed}", "outer", "T", true)
}

test "a type parameter passed through a local fn value is refused at the outer call" {
    let outer = "fn outer[T](t: T) -> Int \{\n    let g = wrap\n    g(t)\n}\n"
    refused("tc_nkey_fn_value", "{wrap_set}{outer}", "outer", "T", true)
}

test "a key role reaches a recursive pair in either declaration order" {
    let ping = "fn outer[A](a: A, n: Int) -> Int \{\n    if n <= 0 \{ return 0 }\n    pong(a, n - 1)\n}\n"
    let pong = "fn pong[B](b: B, n: Int) -> Int \{\n    let mut s = Set()\n    s.insert(b)\n    s.len() + outer(b, n - 1)\n}\n"
    let fwd = "{types_src}{ping}{pong}fn main() \{ assert(outer(Widget \{ id: 1 }, 3) >= 0) }\n"
    expect("recursion", probe("tc_nkey_rec", fwd), "MapKeyNotHashable@{main_line(fwd)}: {set_elem("outer", "A", "Widget")}")
    let rev = "{types_src}{pong}{ping}fn main() \{ assert(outer(Widget \{ id: 1 }, 3) >= 0) }\n"
    expect("recursion reversed", probe("tc_nkey_rec_rev", rev), "MapKeyNotHashable@{main_line(rev)}: {set_elem("outer", "A", "Widget")}")
    let ok = "{types_src}{ping}{pong}fn main() \{ assert(outer(HWidget \{ id: 1 }, 3) + outer(1, 2) >= 0) }\n"
    expect("recursion control", probe("tc_nkey_rec_ok", ok), "")
}

test "a type parameter passed on only as a value is not a key" {
    let fns = "fn wrap[K, V](k: K, v: V) -> Int \{\n    let mut m = Map()\n    m.insert(k, v)\n    m.len()\n}\nfn outer[T](t: T) -> Int \{ wrap(1, t) }\n"
    expect("value", probe("tc_nkey_value", src_of(fns, "Widget \{ id: 1 }")), "")
}

test "a Hash bound on the outer parameter admits the nested key" {
    let fns = "{wrap_set}fn outer[T: Hash + Eq](t: T) -> Int \{ wrap(t) }\n"
    expect("bound", probe("tc_nkey_bound", src_of(fns, "HWidget \{ id: 1 }")), "")
}

test "scalar, string and tuple arguments build through a nested key" {
    let fns = "{wrap_set}{outer_bare}"
    let src = "{types_src}{fns}fn main() \{ assert(outer(1) + outer(\"a\") + outer((1, 'c')) == 3) }\n"
    expect("scalars", probe("tc_nkey_scalars", src), "")
}
