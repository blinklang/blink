// A keyword argument is a label on a value, so its node has the value's type. A closure given
// by keyword to a built-in method takes its parameter types from the method, as a positional
// one does; the label must not keep the type the closure had before that.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_type_str}
import parser.{node_count, node_kind, node_value}
import ast.{NodeKind}
import std.io

fn label_types(src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    let path = "/tmp/blink_keyword_arg_type.bl"
    fs.write(path, src).unwrap()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    let mut out: List[Str] = []
    let mut i = 0
    while i < node_count() {
        if node_kind(i) == NodeKind.NamedArg && node_kind(node_value(i)) == NodeKind.Closure {
            out.push("{tc_type_str(tc_lookup_node_tid(i))} = {tc_type_str(tc_lookup_node_tid(node_value(i)))}")
        }
        i = i + 1
    }
    out
}

test "a closure given by keyword to a built-in method has the type the method gives it" {
    let got = label_types("fn main() \{\n    let a = [1, 2].map(f: fn(x) \{ \"\{x}\" })\n    let b = [1, 2].fold(0, f: fn(acc, x) \{ acc + x })\n    io.println(\"\{a.len()} \{b}\")\n}\n")
    for g in got { io.println(g) }
    assert_eq(got, ["Fn(Int) -> Str = Fn(Int) -> Str", "Fn(Int, Int) -> Int = Fn(Int, Int) -> Int"])
}
