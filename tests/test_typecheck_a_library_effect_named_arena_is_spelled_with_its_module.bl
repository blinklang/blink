// `Arena` is built in but not reserved (§5.2), so a library may declare its own `effect
// Arena`. In a file that declares another `Arena`, the bare name reaches that one, so the
// report and its fix must spell the library's effect with its module.

import compile_test_helpers

let HELPER: Str = #"pub effect Arena {
    effect Grow {
        fn grow() -> Int
    }
}

pub fn lg() -> Int ! Arena {
    arena.grow()
}
"#

test "the fix for a library's own effect Arena names its module" {
    let entry = #"import lib_arena_spelled

effect Arena {
    effect Grow {
        fn grow() -> Int
    }
}

fn h() -> Int ! IO {
    lib_arena_spelled.lg()
}

fn main() { }
"#
    let out = compile_test_helpers.compile_xmod_capture(entry, "lib_arena_spelled", HELPER, "arena_effect_spelled")
    compile_test_helpers.expect_error(out, "E0500", "h lacks the library's Arena")
    compile_test_helpers.expect_contains(out, "\"fix\":\{\"action\":\"add effect\",\"text\":\"lib_arena_spelled.Arena\"}", "the fix names the module")
}

test "the fix for a reserved effect stays bare" {
    let entry = #"import lib_fs_bare

fn h() -> Str ! IO {
    lib_fs_bare.peek()
}

fn main() { }
"#
    let helper = #"pub fn peek() -> Str ! FS.Read {
    fs.read("/dev/null") ?? ""
}
"#
    let out = compile_test_helpers.compile_xmod_capture(entry, "lib_fs_bare", helper, "reserved_effect_bare")
    compile_test_helpers.expect_error(out, "E0500", "h lacks FS.Read")
    compile_test_helpers.expect_contains(out, "\"fix\":\{\"action\":\"add effect\",\"text\":\"FS.Read\"}", "the fix is the bare name")
}
