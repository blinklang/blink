// A method call through a generic impl holds that impl's bounds at the receiver's type
// arguments (§3.6 Trait Bounds, "Polymorphic Trait Implementations"), by the same rule as a
// call to `fn all_same[X: Same](x: X)`. A type parameter of the body being checked has only
// the bounds its binders give, so `x.same()` with `x: List[T]` through
// `impl[T: Eq] Same for List[T]` is E0306 in that body, with the help that adds the bound.
// The rule holds for a receiver the body's parameters type, for one a use after the call fills
// (`let mut l = []` then `l.push(x)`), and for the trait-qualified call `Same.same(l)`, on a
// builtin receiver and on a struct. A miss is one report. A bound written on the binder, in an
// impl's where clause, or given through a supertrait meets it, and so does a concrete type that
// has the trait. An `@allow` on the body silences the miss there.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, TypeCheck}
import diagnostics.{diag_entries, diag_reset, Diag}
import embedded_stdlib_registry.{init_embedded_stdlib}
import lexer.{Lex}
import parser.{Parse}

fn probe(path: Str, src: Str) -> Int ! FS, Env.Exit, Env.Read, IO {
    with handler Diag {}, handler Lex {}, handler Parse {}, handler TypeCheck {} {
        init_embedded_stdlib()
        fs.write(path, src).unwrap()
        diag_reset()
        let program = compile_to_program(path, 1)
        check_types(program)
        let _ = fs.delete(path)
        program
    }
}

fn errors_reported() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" { out.push("{d.code} {d.line}:{d.col} | {d.help}") }
    }
    out
}

// The program shares one prelude, so the body under test starts on line 14.
fn errors_for(name: Str, body: Str) -> List[Str] ! FS, Env.Exit, Env.Read, IO {
    let src = [
        "trait Same \{ fn same(self) -> Bool }",
        "impl[T: Eq] Same for List[T] \{ fn same(self) -> Bool \{ self.len() < 2 || self.get(0).unwrap() == self.get(1).unwrap() } }",
        "type Hd[T] \{ v: List[T] }",
        "impl[T: Eq] Same for Hd[T] \{ fn same(self) -> Bool \{ self.v.same() } }",
        "trait Conv[A] \{ fn conv(self) -> Int }",
        "trait Wide[K]: Conv[K] \{ fn wide(self) -> Int }",
        "impl Conv[Int] for Int \{ fn conv(self) -> Int \{ 7 } }",
        "trait Total \{ fn total(self) -> Int }",
        "type Pl[K, V] \{ k: K, vs: List[V] }",
        "impl[K, V: Conv[K]] Total for Pl[K, V] \{ fn total(self) -> Int \{ self.vs.len() } }",
        "trait Ck \{ fn chk(self) -> Bool }",
        "type NoEq \{ a: Int }",
        "type Bx[T] \{ v: T }",
        body,
        "fn main() \{ }",
        "",
    ].join("\n")
    let _ = probe("build/tc_method_impl_bound_{name}.bl", src)
    errors_reported()
}

// Refused: a bound met through a generic impl, at a type that holds a body parameter.

test "a method call on a builtin receiver is E0306 when the receiver holds a body parameter" {
    assert_eq(errors_for("direct", "fn h[T](x: List[T]) -> Bool \{ x.same() }"),
        ["E0306 14:31 | write the bound on the binder: `[T: Eq]`"])
}

test "a trait-qualified call on a builtin receiver is E0306 when the receiver holds a body parameter" {
    assert_eq(errors_for("qualified", "fn h[T](x: List[T]) -> Bool \{ Same.same(x) }"),
        ["E0306 14:31 | write the bound on the binder: `[T: Eq]`"])
}

test "a method call on a struct receiver is E0306 when the receiver holds a body parameter" {
    assert_eq(errors_for("struct", "fn h[T](x: Hd[T]) -> Bool \{ x.same() }"),
        ["E0306 14:29 | write the bound on the binder: `[T: Eq]`"])
}

test "a method call is E0306 when a use after the call fills the receiver" {
    assert_eq(errors_for("late", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(x)",
        "    r",
        "}",
    ].join("\n")), ["E0306 16:13 | write the bound on the binder: `[T: Eq]`"])
}

test "a trait-qualified call is E0306 when a use after the call fills the receiver" {
    assert_eq(errors_for("qualified_late", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = Same.same(l)",
        "    l.push(x)",
        "    r",
        "}",
    ].join("\n")), ["E0306 16:13 | write the bound on the binder: `[T: Eq]`"])
}

test "a method call on a struct is E0306 when a use after the call fills the receiver" {
    assert_eq(errors_for("struct_late", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut b = Hd \{ v: [] }",
        "    let r = b.same()",
        "    b.v.push(x)",
        "    let mut c = Hd \{ v: [] }",
        "    let s = Same.same(c)",
        "    c.v.push(x)",
        "    r && s",
        "}",
    ].join("\n")), [
        "E0306 16:13 | write the bound on the binder: `[T: Eq]`",
        "E0306 19:13 | write the bound on the binder: `[T: Eq]`",
    ])
}

test "an impl method body without the bound is E0306 at a method call a later use fills" {
    assert_eq(errors_for("impl_body", [
        "impl[T] Ck for Bx[T] \{",
        "    fn chk(self) -> Bool \{",
        "        let mut l = []",
        "        let r = l.same()",
        "        l.push(self.v)",
        "        r",
        "    }",
        "}",
    ].join("\n")), ["E0306 17:17 | write the bound on the binder: `[T: Eq]`"])
}

// Refused: a bound on a generic trait at its trait arguments, reached by a method call.

test "a method call is E0306 at a trait argument the body's binders do not give" {
    assert_eq(errors_for("args", [
        "fn f[K2, A: Conv[Int]](p: Pl[K2, A]) -> Int \{ p.total() }",
        "fn g[K2, A: Conv[Int]](k: K2, a: A) -> Int \{",
        "    let mut l = Pl \{ k: k, vs: [] }",
        "    let r = l.total()",
        "    l.vs.push(a)",
        "    r",
        "}",
    ].join("\n")), [
        "E0306 14:47 | write ` + Conv[K2]` on the bound list of `A`",
        "E0306 17:13 | write ` + Conv[K2]` on the bound list of `A`",
    ])
}

test "an allow on the body silences the method call there and nowhere else" {
    assert_eq(errors_for("allowed", [
        "@allow(TraitBoundNotSatisfied)",
        "fn h[T](x: T, y: List[T]) -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(x)",
        "    r && y.same()",
        "}",
        "fn g[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(x)",
        "    r",
        "}",
    ].join("\n")), ["E0306 23:13 | write the bound on the binder: `[T: Eq]`"])
}

// Accepted: the bound written, in each form.

test "a bound on the binder meets the bound at each method call path" {
    assert_eq(errors_for("met_inline", [
        "fn h[T: Eq](x: T, y: List[T], z: Hd[T]) -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(x)",
        "    let mut m = []",
        "    let s = Same.same(m)",
        "    m.push(x)",
        "    r && s && y.same() && Same.same(y) && z.same()",
        "}",
        "fn k[K2, A: Conv[K2]](k: K2, a: A, ps: Pl[K2, A]) -> Int \{",
        "    let mut l = Pl \{ k: k, vs: [] }",
        "    let r = l.total()",
        "    l.vs.push(a)",
        "    r + ps.total()",
        "}",
    ].join("\n")), [])
}

test "a bound in an impl's where clause meets the bound at each method call path" {
    assert_eq(errors_for("met_where", [
        "impl[T] Ck for Bx[T] where T: Eq \{",
        "    fn chk(self) -> Bool \{",
        "        let mut l = []",
        "        let r = l.same()",
        "        l.push(self.v)",
        "        let mut m = []",
        "        let s = Same.same(m)",
        "        m.push(self.v)",
        "        r && s && [self.v].same() && Same.same([self.v]) && Hd \{ v: [self.v] }.same()",
        "    }",
        "}",
    ].join("\n")), [])
}

test "a bound given through a supertrait meets the bound at each method call path" {
    assert_eq(errors_for("met_super", [
        "fn h[T: Ord](x: T, y: List[T]) -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(x)",
        "    r && y.same() && Same.same(y)",
        "}",
        "fn k[K2, A: Wide[K2]](k: K2, a: A, ps: Pl[K2, A]) -> Int \{",
        "    let mut l = Pl \{ k: k, vs: [] }",
        "    let r = l.total()",
        "    l.vs.push(a)",
        "    r + ps.total()",
        "}",
    ].join("\n")), [])
}

test "a concrete type that has the trait meets the bound at each method call path" {
    assert_eq(errors_for("met_concrete", [
        "fn h[T](x: T) -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(1)",
        "    let mut b = Hd \{ v: [] }",
        "    let s = b.same()",
        "    b.v.push(\"a\")",
        "    let mut p = Pl \{ k: 1, vs: [] }",
        "    let t = p.total()",
        "    p.vs.push(2)",
        "    r && s && t > 0",
        "}",
    ].join("\n")), [])
}

test "a concrete type without the trait is still E0306 at a method call a later use fills" {
    assert_eq(errors_for("concrete_miss", [
        "fn h() -> Bool \{",
        "    let mut l = []",
        "    let r = l.same()",
        "    l.push(NoEq \{ a: 1 })",
        "    r && [NoEq \{ a: 1 }].same()",
        "}",
    ].join("\n")), [
        "E0306 18:10 | add `@derive(Eq)` to `type NoEq`",
        "E0306 16:13 | add `@derive(Eq)` to `type NoEq`",
    ])
}

// A bound that names `Self` reads it as the receiver's type.

test "a method call is E0306 at a bound that names Self, the receiver's type" {
    assert_eq(errors_for("self_arg", [
        "type Sb[T] \{ v: T }",
        "impl[T: Conv[Self]] Total for Sb[T] \{ fn total(self) -> Int \{ 1 } }",
        "impl Conv[Int] for Str \{ fn conv(self) -> Int \{ 1 } }",
        "fn g(b: Sb[Str]) -> Int \{ b.total() }",
        "fn g2(b: Sb[Str]) -> Int \{ Total.total(b) }",
        "fn k[T](b: Sb[T]) -> Int \{ b.total() }",
        "fn h() -> Int \{",
        "    let mut b = Sb \{ v: [] }",
        "    let r = b.total()",
        "    b.v.push(\"a\")",
        "    r",
        "}",
    ].join("\n")), [
        "E0306 17:27 | pass an argument whose type implements Conv[Sb[Str]], or write `impl Conv[Sb[Str]] for Str`",
        "E0306 18:28 | pass an argument whose type implements Conv[Sb[Str]], or write `impl Conv[Sb[Str]] for Str`",
        "E0306 19:28 | write the bound on the binder: `[T: Conv[Sb[T]]]`",
        "E0306 22:13 | pass an argument whose type implements Conv[Sb[List[Str]]], or write `impl Conv[Sb[List[Str]]] for List[Str]`",
    ])
}

test "a method call is E0306 at a where clause on Self the receiver's type does not meet" {
    assert_eq(errors_for("self_where", [
        "trait Sh \{ fn sh(self) -> Int }",
        "type Sw[T] \{ v: T }",
        "impl[T: Eq] Sh for Sw[T] \{ fn sh(self) -> Int \{ 1 } }",
        "impl[T] Total for Sw[T] where Self: Sh \{ fn total(self) -> Int \{ 1 } }",
        "fn g(b: Sw[NoEq]) -> Int \{ b.total() }",
        "fn g2(b: Sw[NoEq]) -> Int \{ Total.total(b) }",
        "fn g3(b: Sw[Int]) -> Int \{ b.total() + Total.total(b) }",
    ].join("\n")), [
        "E0306 18:28 | add `@derive(Eq)` to `type NoEq`",
        "E0306 19:29 | add `@derive(Eq)` to `type NoEq`",
    ])
}

test "a bound that names Self is met by the receiver's type" {
    assert_eq(errors_for("self_met", [
        "type Sb[T] \{ v: T }",
        "impl[T: Conv[Self]] Total for Sb[T] \{ fn total(self) -> Int \{ 1 } }",
        "impl Conv[Sb[Int]] for Int \{ fn conv(self) -> Int \{ 1 } }",
        "fn g(b: Sb[Int]) -> Int \{ b.total() + Total.total(b) }",
        "fn k[T: Conv[Sb[T]]](b: Sb[T]) -> Int \{ b.total() + Total.total(b) }",
    ].join("\n")), [])
}

// A struct field default is a body of its own: a call there that inference fills later is
// judged when the default's walk ends. A call is not const, so each default is also E0533.

test "a method call in a field default is E0533, and E0306 when a later use fills the receiver" {
    assert_eq(errors_for("default_method", [
        "type Df \{",
        "    ok: Bool = \{",
        "        let mut l = []",
        "        let r = l.same()",
        "        l.push(NoEq \{ a: 1 })",
        "        r",
        "    }",
        "}",
    ].join("\n")), [
        "E0533 15:16 | compute the value in a constructor fn: `fn df() -> Df \{ Df \{ ok: ... } }`, or make the field `Option[Bool]`",
        "E0306 17:17 | add `@derive(Eq)` to `type NoEq`",
    ])
}

test "a call in a field default is E0533, and E0306 when a later use fills the argument" {
    assert_eq(errors_for("default_call", [
        "fn all_same[X: Same](x: X) -> Bool \{ x.same() }",
        "type Df \{",
        "    ok: Bool = \{",
        "        let mut l = []",
        "        let r = all_same(l)",
        "        l.push(NoEq \{ a: 1 })",
        "        r",
        "    }",
        "}",
    ].join("\n")), [
        "E0533 16:16 | compute the value in a constructor fn: `fn df() -> Df \{ Df \{ ok: ... } }`, or make the field `Option[Bool]`",
        "E0306 18:17 | add `@derive(Eq)` to `type NoEq`",
    ])
}
