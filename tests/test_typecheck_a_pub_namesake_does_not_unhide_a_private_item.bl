// Privacy belongs to one declaration in one module. A pub item of the same name in another
// module must not make a private one reachable, in any use form, and a private item must not
// make its pub namesake unreachable. For a built-in op's default body the first direction is a
// sandbox escape: a user module with a pub `read_all` or `fs_do_write` must not open std's.

import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

let DIR: Str = "tests/zzpn_pub_namesake/src"

fn probe(file: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    diag_reset()
    check_types(compile_to_program("{DIR}/{file}", 1))
}

fn errors() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    out
}

fn has_error_naming(name: Str, subject: Str) -> Bool {
    for e in errors() {
        if e.starts_with("{name}: ") && e.contains(subject) { return true }
    }
    false
}

fn expect_private(file: Str, subject: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, IO {
    probe(file)
    if !has_error_naming("PrivateItemAccess", subject) {
        io.println("FAIL: no PrivateItemAccess for '{subject}' in {file}; got:")
        for e in errors() { io.println("  {e}") }
    }
    assert(has_error_naming("PrivateItemAccess", subject))
}

fn expect_clean(file: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, IO {
    probe(file)
    let errs = errors()
    if errs.len() != 0 {
        io.println("FAIL: {file} reported:")
        for e in errs { io.println("  {e}") }
    }
    assert(errs.len() == 0)
}

test "a qualified call of a private function with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_qual_call.bl", "zzpn_f")
}

test "a qualified private function taken as a value with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_qual_value.bl", "zzpn_f")
}

test "a qualified private let with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_qual_let.bl", "ZZPN_K")
}

test "a qualified private type with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_qual_type.bl", "ZzpnT")
}

test "a selected private function with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_sel_call.bl", "zzpn_f")
}

test "a selected private function taken as a value with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_sel_value.bl", "zzpn_f")
}

test "a selected private let with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_sel_let.bl", "ZZPN_K")
}

test "a selected private type with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_sel_type.bl", "ZzpnT")
}

test "a selected private trait with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_sel_trait.bl", "ZzpnTr")
}

test "a renamed private function with a pub namesake elsewhere is E1003" {
    expect_private("main_hide_alias.bl", "zzpn_f")
}

test "a user pub read_all does not open the qualified io_read.read_all default body" {
    expect_private("main_hide_std_qual.bl", "`read_all` is the default body of `io.read_all`")
}

test "a user pub fs_do_write does not open the selected fs_ops default body" {
    expect_private("main_hide_std_sel.bl", "`fs_do_write` is the default body of `fs.write`")
}

// A bare name that no import selects resolves to no declaration, so the check asks every
// declaration of the spelling: with only private ones, the use is E1003.
test "a bare unselected name that only a private item declares is E1003" {
    expect_private("main_bare_unselected_only.bl", "zzpn_only")
}

// The same bare use where a pub namesake exists: the file did not select the pub one, so the
// error is ImportNotSelected naming it, and the private one is never offered.
test "a bare unselected name with a private and a pub declaration points at the pub one" {
    probe("main_bare_unselected_namesake.bl")
    if !has_error_naming("ImportNotSelected", "zzpn_open.zzpn_f") {
        io.println("FAIL: no ImportNotSelected naming zzpn_open.zzpn_f; got:")
        for e in errors() { io.println("  {e}") }
    }
    assert(has_error_naming("ImportNotSelected", "zzpn_open.zzpn_f"))
    for e in errors() { assert(!e.contains("zzpn_hidden.zzpn_f")) }
}

test "a qualified call of a pub function with a private namesake elsewhere resolves" {
    expect_clean("main_open_qual_call.bl")
}

test "a qualified pub let with a private namesake elsewhere resolves" {
    expect_clean("main_open_qual_let.bl")
}

test "a qualified pub type with a private namesake elsewhere resolves" {
    expect_clean("main_open_qual_type.bl")
}

test "a selected pub function with a private namesake elsewhere resolves" {
    expect_clean("main_open_sel_call.bl")
}

test "a selected pub function taken as a value with a private namesake elsewhere resolves" {
    expect_clean("main_open_sel_value.bl")
}

test "a selected pub let with a private namesake elsewhere resolves" {
    expect_clean("main_open_sel_let.bl")
}

test "a selected pub type with a private namesake elsewhere resolves" {
    expect_clean("main_open_sel_type.bl")
}

test "a selected pub trait with a private namesake elsewhere resolves" {
    expect_clean("main_open_sel_trait.bl")
}

test "a renamed pub function with a private namesake elsewhere resolves" {
    expect_clean("main_open_alias.bl")
}

test "a selected user read_all and fs_do_write are not the std default bodies" {
    expect_clean("main_open_std_namesake.bl")
}
