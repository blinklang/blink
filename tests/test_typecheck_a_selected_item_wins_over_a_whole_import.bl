// A whole import binds only its qualifier (sections/07), so a bare call of a name that a
// selective import brings means the selected item, even where the wholly imported module
// declares a generic function of the same name.

import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

let DIR: Str = "tests/zzwi_whole_import/src"

fn errors_of(file: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    diag_reset()
    check_types(compile_to_program("{DIR}/{file}", 1))
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    out
}

test "a selected shuffle wins over the shuffle of a whole import of std.random" {
    assert_eq(errors_of("main_selected_shuffle.bl"), [])
}

test "a selected map_merge wins over the map_merge of a whole import of std.map" {
    assert_eq(errors_of("main_selected_map_merge.bl"), [])
}
