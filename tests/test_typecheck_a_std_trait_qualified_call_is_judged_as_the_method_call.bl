// A std trait-qualified call `Trait.method(x, ..)` is judged as `x.method(..)` is: a type
// without the trait is refused, a method the compiler cannot build yet is refused as not built,
// and the arguments after `x` are checked against the trait's signature
// (sections/03c_protocols.md *Explicit trait + method*, sections/03_types.md *Built-in Trait
// Implementations*).

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}
import std.io

fn typecheck_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    init_embedded_stdlib()
    fs.write(path, src).unwrap()
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

// Each error as "name: message | note | note | help: help".
fn errors_of(src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    typecheck_probe("build/test_typecheck_a_std_trait_qualified_call_probe.bl", src)
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            let mut line = "{d.name}: {d.message}"
            for n in d.notes { line = "{line} | {n}" }
            out.push("{line} | help: {d.help}")
        }
    }
    for e in out { io.println("  diag: {e}") }
    out
}

fn body(decls: Str, stmts: Str) -> Str {
    "{decls}fn main() \{\n{stmts}}\n"
}

fn one_error(src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    let errs = errors_of(src)
    assert_eq(errs.len(), 1)
    errs.get(0).unwrap()
}

let PLAIN = "type QjPlain \{\n    a: Int\n}\n"

test "a qualified call is typed by the trait's signature" {
    let src = body("@derive(Eq, Debug, Hash, Clone)\ntype QjDerived \{\n    a: Int\n}\n",
        "    let a: Bool = Eq.eq(1, 2)\n    let b: Str = Debug.debug([1])\n    let c: U64 = Hash.hash(\"x\")\n    let d: QjDerived = Clone.clone(QjDerived \{ a: 1 })\n    let e: Bool = Eq.eq(d, d)\n    let f: Ordering = Ord.cmp(1.5, 2.5)\n    let g: U64 = Hash.hash((1, \"x\"))\n")
    assert_eq(errors_of(src).len(), 0)
    let wrong = one_error(body("", "    let x: Str = Eq.eq(1, 1)\n"))
    assert(wrong.contains("Str") && wrong.contains("Bool"), wrong)
}

test "a qualified call on a type without the trait is refused" {
    let clone = one_error(body(PLAIN, "    let _ = Clone.clone(QjPlain \{ a: 1 })\n"))
    assert(clone.contains("QjPlain") && clone.contains("clone"), clone)
    let eq = one_error(body(PLAIN, "    let _ = Eq.eq(QjPlain \{ a: 1 }, QjPlain \{ a: 1 })\n"))
    assert(eq.contains("QjPlain") && eq.contains("eq"), eq)
    let hash = one_error(body("", "    let _ = Hash.hash(1.5)\n"))
    assert(hash.contains("`Float` does not implement `Hash`"), hash)
    let debug = one_error(body(PLAIN, "    let _ = Debug.debug([QjPlain \{ a: 1 }])\n"))
    assert(debug.contains("`List[QjPlain]` does not implement `Debug`"), debug)
}

test "a qualified call the compiler cannot build yet is refused as not built" {
    let cmp = one_error(body("", "    let _ = Ord.cmp((1, 2), (1, 3))\n"))
    assert(cmp.contains("`cmp` on `(Int, Int)` is not built yet: the compiler cannot order a tuple"), cmp)
    let debug = one_error(body("", "    let _ = Debug.debug((1, 2))\n"))
    assert(debug.contains("`debug` on `(Int, Int)` is not built yet"), debug)
}

test "a qualified call checks its argument count and the other value's type" {
    let few = one_error(body("", "    let _ = Eq.eq(1)\n"))
    assert(few.contains("`Eq.eq` expects 2 argument(s) including the receiver, got 1"), few)
    let many = one_error(body("", "    let _ = Clone.clone(1, 2)\n"))
    assert(many.contains("`Clone.clone` expects 1 argument(s) including the receiver, got 2"), many)
    let other = one_error(body("", "    let _ = Eq.eq(1, \"a\")\n"))
    assert(other.contains("Int") && other.contains("Str"), other)
    let list = one_error(body("", "    let _ = Eq.eq([1], [\"a\"])\n"))
    assert(list.contains("List[Int]") || list.contains("Int"), list)
}
