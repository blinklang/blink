// A trait method named as a value with no call (`Sized.len`) is a read of the trait's
// function (section 3.4). Where nothing fixes Self, or Self does not hold the trait, the program
// is wrong (sections 3.4 and 3c.4), so `blink check` must not pass it: a clean check promises
// the build. Each row asserts only that check reports, so it holds whether the report is the
// program's own error or an internal error at a node the checker left with no type.
import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, TypeCheck}
import diagnostics.{diag_count, diag_ice_count, diag_reset, Diag}
import embedded_stdlib_registry.{init_embedded_stdlib}
import lexer.{Lex}
import parser.{Parse}

fn check_src(path: Str, src: Str) ! FS, Env.Exit, Env.Read, IO {
    with handler Diag {}, handler Lex {}, handler Parse {}, handler TypeCheck {} {
        init_embedded_stdlib()
        fs.write(path, src).unwrap()
        diag_reset()
        let _program = compile_to_program(path, 1)
        check_types(_program)
        let _ = fs.delete(path)
    }
}

test "Sized.len as a value with nothing to fix Self does not pass check" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let f = Sized.len\n")
    s = s.concat("}\n")
    check_src("build/tc_trait_fn_value_open_self.bl", s)
    assert(diag_count + diag_ice_count > 0)
}

test "Sized.len as a value where Self has no Sized does not pass check" {
    let mut s = "type Bites \{ v: Int }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let bs = [Bites \{ v: 3 }]\n")
    s = s.concat("    let ns: List[Int] = bs.map(Sized.len)\n")
    s = s.concat("    io.println(\"\{ns.len()}\")\n")
    s = s.concat("}\n")
    check_src("build/tc_trait_fn_value_no_impl.bl", s)
    assert(diag_count + diag_ice_count > 0)
}
