// A type alias names the same type as its target (sections/03_types.md, "A type alias is not a
// newtype"), so a Map key or Set element written as an alias is hashable exactly when the
// aliased type is (sections/03_types.md, *Hash Contract and Seeding*: "a tuple is hashable if and
// only if every one of its elements is", and a Float or any type containing one is E1400).
//
// The key check read the written NAME. A tuple alias does not resolve to a name that carries its
// elements, so the check stopped at the alias's own name and asked whether that name derives
// Hash. A `@derive(Hash, Eq)` on the alias then admitted `(Float, Float)` as a key, and an alias
// with no derive was refused even for `(Int, Str)`, with help to add a derive to the alias.
// Each row runs with and without a derive on the alias: the derive must change nothing.
import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import std.io

let PROBE = "build/tc_alias_key_hash_probe.bl"

fn probe(src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    write_file(PROBE, src)
    diag_reset()
    let program = compile_to_program(PROBE, 1)
    check_types(program)
    let _ = fs.delete(PROBE)
}

fn entries() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            out.push("{d.name} {d.code} {d.line}:{d.col}: {d.message} | help: {d.help}")
        }
    }
    out
}

fn show(label: Str) {
    io.eprintln("FAIL: {label}: got:")
    for e in entries() { io.eprintln("  {e}") }
}

// The first line of every probe: the alias that follows carries a derive, or it does not. A
// comment in its place keeps every later line number the same.
fn head(derived: Bool) -> Str {
    if derived { "@derive(Hash, Eq)" } else { "// no derive" }
}

// Exactly one error: `code` at line:col, its message holds `names`, and its help does not tell
// the author to derive on the alias.
fn expect_one(label: Str, code: Str, line: Int, col: Int, names: Str) {
    let errs = entries()
    let mut ok = errs.len() == 1
    if ok {
        let e = errs.get(0).unwrap()
        ok = e.starts_with("{code} {line}:{col}: ") && e.contains(names) && !e.contains("to the `")
    }
    if !ok {
        io.eprintln("want: {code} {line}:{col}: ...{names}...")
        show(label)
    }
    assert(ok)
}

fn expect_clean(label: Str) {
    let ok = entries().len() == 0
    if !ok { show(label) }
    assert(ok)
}

let FLOAT_KEY = "MapKeyNotHashable E1400"
let NOT_DERIVABLE = "NonDerivableTrait E1401"

fn float_pair_key_src(derived: Bool) -> Str {
    "{head(derived)}\ntype Pair = (Float, Float)\nfn main() \{\n    let m: Map[Pair, Int] = Map.new()\n    io.println(\"\{m.len()}\")\n}\n"
}

fn option_pair_key_src(derived: Bool) -> Str {
    "{head(derived)}\ntype P = (Int, Option[Int])\nfn main() \{\n    let m: Map[P, Int] = Map.new()\n    io.println(\"\{m.len()}\")\n}\n"
}

fn list_elem_src(derived: Bool) -> Str {
    "{head(derived)}\ntype L = List[Int]\nfn main() \{\n    let s: Set[L] = Set.new()\n    io.println(\"\{s.len()}\")\n}\n"
}

fn nested_alias_src(derived: Bool) -> Str {
    "type Pair = (Float, Float)\n{head(derived)}\ntype P2 = Pair\nfn main() \{\n    let s: Set[P2] = Set.new()\n    io.println(\"\{s.len()}\")\n}\n"
}

fn generic_alias_src(derived: Bool, arg: Str) -> Str {
    "{head(derived)}\ntype G[T] = (T, Int)\nfn main() \{\n    let s: Set[G[{arg}]] = Set.new()\n    io.println(\"\{s.len()}\")\n}\n"
}

fn written_tuple_holds_alias_src(derived: Bool) -> Str {
    "{head(derived)}\ntype Pair = (Float, Float)\nfn main() \{\n    let m: Map[(Pair, Int), Int] = Map.new()\n    io.println(\"\{m.len()}\")\n}\n"
}

fn type_arg_src(derived: Bool, target: Str) -> Str {
    "{head(derived)}\ntype Pair = {target}\ntype Holder[T] \{\n    items: Set[T]\n}\nfn main() \{\n    let h: Holder[Pair] = Holder \{ items: Set.new() }\n    io.println(\"\{h.items.len()}\")\n}\n"
}

fn derive_field_src(derived: Bool) -> Str {
    "{head(derived)}\ntype Pair = (Float, Float)\n@derive(Hash, Eq)\ntype S \{\n    p: Pair\n}\nfn main() \{\n    let s = S \{ p: (1.0, 2.0) }\n    io.println(\"\{s.p.0}\")\n}\n"
}

fn ord_list_field_src(derived: Bool) -> Str {
    "{head(derived)}\ntype L = List[Int]\n@derive(Eq, Ord)\ntype S \{\n    xs: L\n}\nfn main() \{\n    let s = S \{ xs: [1] }\n    io.println(\"\{s.xs.len()}\")\n}\n"
}

fn hashable_pair_key_src(derived: Bool) -> Str {
    "{head(derived)}\ntype K = (Int, Str)\nfn main() \{\n    let mut m: Map[K, Int] = Map.new()\n    m.insert((1, \"a\"), 10)\n    io.println(\"\{m.get((1, \"a\")) ?? 0}\")\n}\n"
}

// ── Rejected: the aliased type has no Hash ────────────────────────────────────────────

test "an alias of a Float tuple is not a Map key" {
    for derived in [true, false] {
        probe(float_pair_key_src(derived))
        expect_one("Map[Pair, Int], derive {derived}", FLOAT_KEY, 4, 20, "`Float` is not hashable")
    }
}

test "an alias of a tuple holding an Option is not a Map key" {
    for derived in [true, false] {
        probe(option_pair_key_src(derived))
        expect_one("Map[P, Int], derive {derived}", FLOAT_KEY, 4, 17, "Option has no Hash")
    }
}

test "an alias of a List is not a Set element" {
    for derived in [true, false] {
        probe(list_elem_src(derived))
        expect_one("Set[L], derive {derived}", FLOAT_KEY, 4, 17, "List has no Hash")
    }
}

test "an alias of an alias of a Float tuple is not a Set element" {
    for derived in [true, false] {
        probe(nested_alias_src(derived))
        expect_one("Set[P2], derive {derived}", FLOAT_KEY, 5, 18, "`Float` is not hashable")
    }
}

test.failing(
    "a generic tuple alias given a Float is not a Set element",
    reason: "a generic alias drops its type arguments, so G[Float] reads as (T, Int) and the key check sees no Float",
) {
    for derived in [true, false] {
        probe(generic_alias_src(derived, "Float"))
        expect_one("Set[G[Float]], derive {derived}", FLOAT_KEY, 4, 24, "`Float` is not hashable")
    }
}

test "an alias inside a written tuple key is judged by its target" {
    for derived in [true, false] {
        probe(written_tuple_holds_alias_src(derived))
        expect_one("Map[(Pair, Int), Int], derive {derived}", FLOAT_KEY, 4, 21, "`Float` is not hashable")
    }
}

test "an alias of a Float tuple is not a type argument a Set element takes" {
    for derived in [true, false] {
        probe(type_arg_src(derived, "(Float, Float)"))
        expect_one("Holder[Pair], derive {derived}", FLOAT_KEY, 7, 23, "`Float` is not hashable")
    }
}

// A derived Hash hashes each field, so a field of the alias type needs what a key needs.
test "a derive on the alias does not make its Float tuple a Hash field" {
    for derived in [true, false] {
        probe(derive_field_src(derived))
        expect_one("S.p: Pair, derive {derived}", NOT_DERIVABLE, 5, 12, "field `p` has type `Pair`")
    }
}

// The same reading for Ord: a List has no order, behind an alias or not.
test "an alias of a List is not an Ord field" {
    for derived in [true, false] {
        probe(ord_list_field_src(derived))
        expect_one("S.xs: L, derive {derived}", NOT_DERIVABLE, 5, 10, "field `xs` has type `L` which does not implement Ord")
    }
}

// ── Accepted: the aliased type is Hash ────────────────────────────────────────────────

test "an alias of a tuple of hashable types is a Map key" {
    for derived in [true, false] {
        probe(hashable_pair_key_src(derived))
        expect_clean("Map[K, Int], derive {derived}")
    }
}

test "a generic tuple alias given hashable arguments is a Set element" {
    for derived in [true, false] {
        probe(generic_alias_src(derived, "Str"))
        expect_clean("Set[G[Str]], derive {derived}")
    }
}

test "an alias of a tuple of hashable types is a type argument a Set element takes" {
    for derived in [true, false] {
        probe(type_arg_src(derived, "(Int, Str)"))
        expect_clean("Holder[Pair], derive {derived}")
    }
}
