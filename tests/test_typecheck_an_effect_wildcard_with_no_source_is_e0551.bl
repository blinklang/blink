// A `_` in the row of a fn or of an impl method stands for what a parameter brings: a `! _`
// callback or handler parameter, or a type parameter whose bound has a method with a `_`
// row. With no such parameter it is E0551 (sections/04_effects.md §4.15.2). A `_` in a trait
// method declaration is the impl-chosen contract and needs no source.

import compile_test_helpers

fn base_src() -> Str {
    #"effect Note { effect Say { fn say(s: Str) } }
type Res { n: Int }
"#
}

fn with_base(body: Str) -> Str {
    "{base_src()}{body}"
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "a fn with _ and no parameter that brings one is E0551" {
    let src = with_base(#"fn g() ! _ { }
fn main() { }
"#)
    let out = compile_test_helpers.compile_and_capture(src, "wild_source_bare_fn")
    compile_test_helpers.expect_error(out, "E0551", "g has no source for _")
    compile_test_helpers.expect_contains(out, "`_` in the row of `g` has no source", "the message names the fn")
    compile_test_helpers.expect_contains(out, "no `! _` parameter, and no type parameter whose bound has a `_` method", "the label names both sources")
    compile_test_helpers.expect_contains(out, "name the effects `g` performs", "the help says to name the effects")
    compile_test_helpers.expect_contains(out, "\"line\":3,\"col\":10", "the diagnostic points at the _")
    assert_eq(count(out, "\"code\":\"E0551\""), 1)
}

test "an impl method with _ and no source is E0551" {
    let src = with_base(#"impl Closeable for Res {
    fn close(self) ! _ { note.say("close {self.n}") }
}
fn main() { }
"#)
    let out = compile_test_helpers.compile_and_capture(src, "wild_source_impl_method")
    compile_test_helpers.expect_error(out, "E0551", "Res.close has no source for _")
    compile_test_helpers.expect_contains(out, "`_` in the row of `Res.close` has no source", "the message names the impl method")
    compile_test_helpers.expect_contains(out, "name the effects `close` performs", "the help names the method")
    assert_eq(count(out, "\"code\":\"E0551\""), 1)
}

test "a bound with no _ method is no source" {
    let src = with_base(#"fn h[T: Eq](a: T, b: T) -> Bool ! _ { a == b }
fn main() { }
"#)
    let out = compile_test_helpers.compile_and_capture(src, "wild_source_bound_without_wild")
    compile_test_helpers.expect_error(out, "E0551", "Eq has no method with a _ row")
    assert_eq(count(out, "\"code\":\"E0551\""), 1)
}

test "a bound with a _ method and a forwarding impl are each a source" {
    let src = with_base(#"fn shut[T: Closeable](t: T) ! _ { t.close() }
type Guard[T] { inner: T }
impl[T: Closeable] Closeable for Guard[T] {
    fn close(self) ! _ { self.inner.close() }
}
trait Named: Closeable { fn name(self) -> Str }
fn named[T: Named](t: T) ! _ { t.close() }
trait Cleans { fn clean(self) ! _ }
fn main() { }
"#)
    let out = compile_test_helpers.compile_and_capture(src, "wild_source_sourced")
    compile_test_helpers.expect_compiles_clean(out, "each _ has a source, and a trait method's _ needs none")
}

test "main with _ and no source is E0551" {
    let src = with_base(#"fn main() ! _ { }
"#)
    let out = compile_test_helpers.compile_and_capture(src, "wild_source_main")
    compile_test_helpers.expect_contains(out, "`_` in the row of `main` has no source", "main is checked too")
    assert_eq(count(out, "\"code\":\"E0551\""), 1)
}
