// An empty `[]`, a `Map()` or a struct literal whose type parameter nothing reaches is
// under-determined wherever its value goes, not only at a `let` (sections/03_types.md §3.4
// *Under-Determined Types*: "The judgment is a property of the type, not of the syntactic
// position"). When no binding holds the value, as for a statement, `let _`, a temporary
// receiver or field base, an operand, an argument or an interpolation hole, the error is one
// E0301 at the open value, and the help is an annotated binding for it. A value that a later
// use fills, or that an annotation, a parameter or a return type types, stays accepted.
//
// Each row checks the exact set of diagnostics a program gets, so an extra error, a missing
// one or an internal error fails it as surely as a wrong message.

import typecheck.{check_types, TypeCheck}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_reset, Diag}
import embedded_stdlib_registry.{init_embedded_stdlib}
import std.fs
import std.io
import lexer.{Lex}
import parser.{Parse}

// Every error, warning and internal error the program gets: span, code, message and help.
fn diags_of(src: Str) -> List[Str] ! FS, Env.Exit, Env.Read, IO {
    with handler Diag {}, handler Lex {}, handler Parse {}, handler TypeCheck {} {
        let path = "build/tc_open_value_no_binding_src.bl"
        init_embedded_stdlib()
        fs.write(path, src).unwrap()
        diag_reset()
        let program = compile_to_program(path, 1)
        check_types(program)
        let _ = fs.delete(path)
        let mut out: List[Str] = []
        for d in diag_entries {
            out.push("{d.line}:{d.col}-{d.end_col}: {d.code} {d.message} | help: {d.help}")
        }
        out
    }
}

fn line_of(src: Str, marker: Str) -> Int ! IO.Eprint {
    let lines = src.split("\n")
    let mut i = 0
    while i < lines.len() {
        if lines.get(i).unwrap().contains(marker) { return i + 1 }
        i = i + 1
    }
    io.eprintln("FAIL: probe has no line marked '{marker}'")
    assert(false)
    -1
}

// "line:col-0" at the first `word` on the line marked `marker`: the caret is a point at the
// start of the open value, since an expression node records no end column.
fn span(src: Str, marker: Str, word: Str) -> Str ! IO.Eprint {
    let line = line_of(src, marker)
    let col = src.split("\n").get(line - 1).unwrap().index_of(word).unwrap() + 1
    "{line}:{col}-0"
}

fn assert_diags(src: Str, want: List[Str]) ! FS, Env.Exit, Env.Read, IO {
    let got = diags_of(src)
    let mut ok = got.len() == want.len()
    for w in want {
        if !got.contains(w) { ok = false }
    }
    if !ok {
        io.eprintln("FAIL: want:")
        for w in want { io.eprintln("    {w}") }
        io.eprintln("  got:")
        for g in got { io.eprintln("    {g}") }
    }
    assert(ok)
}

fn open_at(src: Str, marker: Str, word: Str, hint: Str) -> Str ! IO.Eprint {
    "{span(src, marker, word)}: E0301 cannot infer a type for this value: it is left under-determined | help: add a type annotation on a binding for this value, e.g. `let x{hint} = ...` (replace each placeholder with the intended type)"
}

test "an empty list statement is E0301 at the list" {
    let src = #"fn main() {
    []  // STMT
}
"#
    assert_diags(src, [open_at(src, "STMT", "[]", ": List[T]")])
}

test "an empty list bound to the wildcard is E0301 at the list" {
    let src = #"fn main() {
    let _ = []  // WILD
}
"#
    assert_diags(src, [open_at(src, "WILD", "[]", ": List[T]")])
}

test "a Map construction statement is E0301 at the construction" {
    let src = #"fn main() {
    Map()  // STMT
}
"#
    assert_diags(src, [open_at(src, "STMT", "Map()", ": Map[K, V]")])
}

test "a Map construction bound to the wildcard is E0301 at the construction" {
    let src = #"fn main() {
    let _ = Map()  // WILD
}
"#
    assert_diags(src, [open_at(src, "WILD", "Map()", ": Map[K, V]")])
}

test "a Map construction as a temporary receiver is E0301 at the construction" {
    let src = #"fn main() {
    let k = Map().len()  // RECV
    io.println("{k}")
}
"#
    assert_diags(src, [open_at(src, "RECV", "Map()", ": Map[K, V]")])
}

test "an empty list in a tuple whose other field is read is E0301 at the list" {
    let src = #"fn main() {
    let k = ([], 1).1  // TUPLE
    io.println("{k}")
}
"#
    assert_diags(src, [open_at(src, "TUPLE", "[]", ": List[T]")])
}

test "an empty list in a tuple bound to the wildcard is E0301 at the list" {
    let src = #"fn main() {
    let _ = ([], 1)  // TUPLE
}
"#
    assert_diags(src, [open_at(src, "TUPLE", "[]", ": List[T]")])
}

test "an empty list beside a Map construction in a tuple is one E0301 at the list" {
    let src = #"fn main() {
    let _ = ([], Map())  // TUPLE
}
"#
    assert_diags(src, [open_at(src, "TUPLE", "[]", ": List[T]")])
}

test "two empty lists in a tuple are one E0301 at the first" {
    let src = #"fn main() {
    let _ = ([], [])  // TUPLE
}
"#
    assert_diags(src, [open_at(src, "TUPLE", "[]", ": List[T]")])
}

test "an empty list in a nested tuple is E0301 at the list" {
    let src = #"fn main() {
    let _ = (1, ([], 2))  // NESTED
}
"#
    assert_diags(src, [open_at(src, "NESTED", "[]", ": List[T]")])
}

test "an empty list in a tuple statement is E0301 at the list" {
    let src = #"fn main() {
    ([], 1)  // STMT
}
"#
    assert_diags(src, [open_at(src, "STMT", "[]", ": List[T]")])
}

test "an empty list in Some bound to the wildcard is E0301 at the list" {
    let src = #"fn main() {
    let _ = Some([])  // SOME
}
"#
    assert_diags(src, [open_at(src, "SOME", "[]", ": List[T]")])
}

// The one E0301 a destructuring `let` gets: at the `let`, naming the pattern as written, with
// the whole pattern annotated as the repair. No internal binder name reaches the text.
fn assert_pattern_open(src: Str, marker: Str, pattern: Str, ann: Str) ! FS, Env.Exit, Env.Read, IO {
    let line = line_of(src, marker)
    let got = diags_of(src).filter(fn(d) { d.contains(" E0301 ") })
    let want = "E0301 cannot infer a type for the pattern `{pattern}`: it is never given one by an annotation or a later use | help: add a type annotation, e.g. `let {pattern}: {ann} = ...` (replace each placeholder with the intended type)"
    let ok = got.len() == 1 && got.get(0).unwrap().starts_with("{line}:5-") && got.get(0).unwrap().ends_with(want)
    if !ok {
        io.eprintln("FAIL: want {line}:5-..: {want}")
        for g in got { io.eprintln("  got: {g}") }
    }
    assert(ok)
}

test "an empty list in a destructured tuple is one E0301 at the let that names the pattern" {
    let src = #"fn main() {
    let (_, b) = ([], 1)  // LET
    io.println("{b}")
}
"#
    assert_eq(diags_of(src).len(), 1)
    assert_pattern_open(src, "LET", "(_, b)", "(List[T], Int)")
}

test "a nested destructured tuple names the nested pattern and the nested annotation" {
    let src = #"fn main() {
    let (a, (_b, c)) = (1, ([], 2))  // LET
    io.println("{a} {c}")
}
"#
    assert_eq(diags_of(src).len(), 1)
    assert_pattern_open(src, "LET", "(a, (_b, c))", "(Int, (List[T], Int))")
}

test "an open Map and an open list in one destructured tuple get distinct placeholders" {
    let src = #"fn main() {
    let ((_a, _b), c) = (([], Map()), 1)  // LET
    io.println("{c}")
}
"#
    assert_eq(diags_of(src).len(), 1)
    assert_pattern_open(src, "LET", "((_a, _b), c)", "((List[T], Map[K, V]), Int)")
}

test "a mutable binder keeps its mut in the annotated pattern" {
    let src = #"fn main() {
    let (mut _a, b) = ([], 1)  // LET
    io.println("{b}")
}
"#
    assert_eq(diags_of(src).len(), 1)
    assert_pattern_open(src, "LET", "(mut _a, b)", "(List[T], Int)")
}

test "a destructured None and a destructured struct literal no field types name their own slots" {
    let none_src = #"fn main() {
    let (_, b) = (None, 1)  // LET
    io.println("{b}")
}
"#
    assert_eq(diags_of(none_src).len(), 1)
    assert_pattern_open(none_src, "LET", "(_, b)", "(Option[T], Int)")
    let w_src = #"type W[T] { n: Int }

fn main() {
    let (_w, b) = (W { n: 1 }, 1)  // LET
    io.println("{b}")
}
"#
    assert_eq(diags_of(w_src).len(), 1)
    assert_pattern_open(w_src, "LET", "(_w, b)", "(W[T], Int)")
}

test "a destructured struct literal with an open field and a pointer name their own slots" {
    let box_src = #"type Box[T] { v: Option[T] }

fn main() {
    let (_bx, n) = (Box { v: None }, 1)  // LET
    io.println("{n}")
}
"#
    assert_eq(diags_of(box_src).len(), 1)
    assert_pattern_open(box_src, "LET", "(_bx, n)", "(Box[T], Int)")
    let ptr_src = #"fn main() {
    let (_p, q) = (null_ptr(), 1)  // LET
    io.println("{q}")
}
"#
    assert_eq(diags_of(ptr_src).len(), 1)
    assert_pattern_open(ptr_src, "LET", "(_p, q)", "(Ptr[T], Int)")
}

test "a destructured value whose whole type is open gets a placeholder in the pattern's own shape" {
    let src = #"fn mk[T]() -> T { panic("never") }

fn main() {
    let (_a, (_b, _c)) = mk()  // LET
}
"#
    assert_eq(diags_of(src).len(), 1)
    assert_pattern_open(src, "LET", "(_a, (_b, _c))", "(T, (T, T))")
}

// A pattern the value's type cannot take gets no annotation on the pattern: the repair binds the
// whole value to one name.
fn assert_pattern_unfit(src: Str, marker: Str, pattern: Str, name: Str, ty: Str) ! FS, Env.Exit, Env.Read, IO {
    let line = line_of(src, marker)
    let got = diags_of(src).filter(fn(d) { d.contains(" E0301 ") })
    let want = "E0301 cannot infer a type for the pattern `{pattern}`: it is never given one by an annotation or a later use | help: the pattern does not fit a value of type `{ty}`; bind the value to one name with an annotation, e.g. `let {name}: {ty} = ...` (replace each placeholder with the intended type)"
    let ok = got.len() == 1 && got.get(0).unwrap().starts_with("{line}:5-") && got.get(0).unwrap().ends_with(want)
    if !ok {
        io.eprintln("FAIL: want {line}:5-..: {want}")
        for g in got { io.eprintln("  got: {g}") }
    }
    assert(ok)
}

test "a tuple pattern over a value that is not a tuple of its arity gets no annotation on the pattern" {
    let opt = #"fn main() {
    let (_x, _y) = (None, 1).0  // LET
}
"#
    assert_pattern_unfit(opt, "LET", "(_x, _y)", "value", "Option[T]")
    let list = #"fn main() {
    let (_e, _f) = List.new()  // LET
}
"#
    assert_pattern_unfit(list, "LET", "(_e, _f)", "value", "List[T]")
    let paren = #"fn main() {
    let (_b) = []  // LET
}
"#
    assert_pattern_unfit(paren, "LET", "(_b)", "_b", "List[T]")
    let nested = #"fn main() {
    let ((_c)) = []  // LET
}
"#
    assert_pattern_unfit(nested, "LET", "((_c))", "_c", "List[T]")
}

test "a parse error in a destructuring let is the one report on that let" {
    let src = #"fn main() {
    let (_a,) = ([],)
    let (_d, ..) = ([], 1)
}
"#
    let got = diags_of(src)
    assert(got.len() > 0)
    for d in got { assert(!d.contains(" E0301 "), d) }
}

test "a report after a parse error names the pattern, never an internal binder" {
    let src = #"fn main() {
    let S { x, y } = 3
    let ((a1, _), mut c): (Int, Int) = ((1, 2), 3)
}
"#
    let got = diags_of(src)
    assert(got.filter(fn(d) { d.contains("the pattern `((a1, _), mut c)`: declared type (Int, Int) but got ((Int, Int), Int)") }).len() == 1)
    for d in got { assert(!d.contains("_destructure"), d) }
}

test "a module-level destructuring let names its pattern in a mismatch and an ffi scope report" {
    let mismatch = #"let (ga, gb): (Int, Int) = ("s", 1)

fn main() { }
"#
    let got = diags_of(mismatch)
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().contains("the pattern `(ga, gb)`: declared type (Int, Int) but got (Str, Int)"), got.get(0).unwrap())
    let scope_src = #"import blink.ffi

let (gc, gd) = (ffi.scope(), 1)

fn main() { }
"#
    let scoped = diags_of(scope_src).filter(fn(d) { d.contains(" E0819 ") })
    assert_eq(scoped.len(), 1)
    assert(scoped.get(0).unwrap().contains("`with ffi.scope() as <name> \{ ... \}`"), scoped.get(0).unwrap())
    for d in [..got, ..diags_of(scope_src)] { assert(!d.contains("_destructure"), d) }
}

test "mut before a destructured tuple is one E0613 and no E0301 over the rewritten pattern" {
    let src = #"fn main() {
    let mut (_a, b) = ([], 1)  // LET
    io.println("{b}")
}
"#
    let got = diags_of(src)
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().contains(" E0613 "), got.get(0).unwrap())
}

test "other reports on a destructuring let name the pattern, never an internal binder" {
    let mismatch = #"fn main() {
    let (a, b): (Int, Int) = ("s", 1)  // LET
    io.println("{a}{b}")
}
"#
    let got = diags_of(mismatch)
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().contains("the pattern `(a, b)`: declared type (Int, Int) but got (Str, Int)"), got.get(0).unwrap())
    let scope_src = #"import blink.ffi

fn main() {
    let (_s, x) = (ffi.scope(), 1)
    io.println("{x}")
}
"#
    let scoped = diags_of(scope_src).filter(fn(d) { d.contains(" E0819 ") })
    assert_eq(scoped.len(), 1)
    assert(scoped.get(0).unwrap().contains("`with ffi.scope() as <name> \{ ... \}`"), scoped.get(0).unwrap())
    for d in [..got, ..diags_of(scope_src)] { assert(!d.contains("_destructure"), d) }
}

test "a tuple binding that nothing types gets the tuple annotation, open slots only" {
    let src = #"fn main() {
    let t = ([], 1)  // LET
}
"#
    let line = line_of(src, "LET")
    let got = diags_of(src).filter(fn(d) { d.contains(" E0301 ") })
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().starts_with("{line}:5-"), got.get(0).unwrap())
    assert(got.get(0).unwrap().contains("E0301 cannot infer a type for `t`"), got.get(0).unwrap())
    assert(got.get(0).unwrap().contains("e.g. `let t: (List[T], Int) = ...`"), got.get(0).unwrap())
}

test "a struct literal no field reaches the type parameter of is E0301 when a field is read" {
    let src = #"type W[T] { n: Int }

fn main() {
    let k = W { n: 1 }.n  // FIELD
    io.println("{k}")
}
"#
    assert_diags(src, [open_at(src, "FIELD", "W", ": W[...]")])
}

test "a struct literal statement no field reaches the type parameter of is E0301" {
    let src = #"type W[T] { n: Int }

fn main() {
    W { n: 1 }  // STMT
}
"#
    assert_diags(src, [open_at(src, "STMT", "W", ": W[...]")])
}

test "a struct literal no field reaches the type parameter of is reported once, at its binding" {
    let src = #"type W[T] { n: Int }

fn main() {
    let w = W { n: 1 }  // LET
    io.println("{w.n}")
}
"#
    let line = line_of(src, "LET")
    let got = diags_of(src)
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().starts_with("{line}:5-"))
    assert(got.get(0).unwrap().contains("E0301 cannot infer a type for `w`"))
}

test "an empty list field read through a temporary struct is E0301 at the list" {
    let src = #"type B[X] { xs: List[X] }

fn main() {
    io.println("{B { xs: [] }.xs.len()}")  // FIELD
}
"#
    assert_diags(src, [open_at(src, "FIELD", "[]", ": List[T]")])
}

test "the length of an empty list in a hole is E0301 at the list" {
    let src = #"fn main() {
    io.println("{[].len()}")  // HOLE
}
"#
    assert_diags(src, [open_at(src, "HOLE", "[]", ": List[T]")])
}

test "two empty lists compared are one E0301 at the first" {
    let src = #"fn main() {
    io.println("{[] == []}")  // EQ
}
"#
    assert_diags(src, [open_at(src, "EQ", "[]", ": List[T]")])
}

test "two Map constructions compared are one E0301 at the first" {
    let src = #"fn main() {
    io.println("{Map() == Map()}")  // EQ
}
"#
    assert_diags(src, [open_at(src, "EQ", "Map()", ": Map[K, V]")])
}

test "an empty list passed to a method of an empty list is one E0301 at the receiver" {
    let src = #"fn main() {
    io.println("{[].contains([])}")  // ARG
}
"#
    assert_diags(src, [open_at(src, "ARG", "[]", ": List[T]")])
}

test "a struct with an empty list field in a hole whose Display impl has a bound is E0301 at the list" {
    let src = #"trait Tag { fn tag(self) -> Int }
impl Tag for Int { fn tag(self) -> Int { self } }
type Cx[T] { v: T }
impl[T: Tag] Display for Cx[T] { fn fmt(self, sb: StringBuilder) { sb.write("cx{self.v.tag()}") } }

fn main() {
    io.println("{Cx { v: [] }}")  // HOLE
}
"#
    assert_diags(src, [open_at(src, "HOLE", "[]", ": List[T]")])
}

test "the length of an empty list is E0301 although it reads no element" {
    let src = #"fn main() {
    let n = [].len()  // LEN
    let e = [].is_empty()  // EMPTY
    io.println("{n} {e}")
}
"#
    assert_diags(src, [open_at(src, "LEN", "[]", ": List[T]"), open_at(src, "EMPTY", "[]", ": List[T]")])
}

test "an empty List.new or List.with_capacity no binding holds is E0301 at the construction" {
    let src = #"fn main() {
    List.new()  // STMT
    let _ = List.new()  // WILD
    let n = List.new().len()  // LEN
    let e = List.new().is_empty()  // EMPTY
    let k = (List.new(), 1).1  // TUPLE
    let c = List.with_capacity(4).len()  // CAP
    io.println("{n} {e} {k} {c}")
}
"#
    let h = ": List[T]"
    assert_diags(src, [open_at(src, "STMT", "List", h), open_at(src, "WILD", "List", h), open_at(src, "LEN", "List", h),
        open_at(src, "EMPTY", "List", h), open_at(src, "TUPLE", "List", h), open_at(src, "CAP", "List", h)])
}

test "a struct literal inside a struct literal that reaches no type parameter is E0301 at the inner literal" {
    let src = #"type W[T] { n: Int }
type O[T] { w: W[T] }

fn main() {
    let k = O { w: W { n: 2 } }.w.n  // NESTED
    io.println("{k}")
    O { w: W { n: 3 } }.w.n  // STMT
}
"#
    assert_diags(src, [open_at(src, "NESTED", "W", ": W[...]"), open_at(src, "STMT", "W", ": W[...]")])
}

test "a struct literal passed where a generic parameter names its type parameter is one E0301" {
    let src = #"type W[T] { n: Int }

fn f[T](w: W[T]) -> Int { w.n }

fn main() {
    io.println("{f(W { n: 1 })}")  // ARG
}
"#
    let line = line_of(src, "ARG")
    let got = diags_of(src)
    if got.len() != 1 { for g in got { io.eprintln("got: {g}") } }
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().starts_with("{line}:"))
    assert(got.get(0).unwrap().contains("E0301"))
}

test "a method no type answers is one E0505 for an open receiver or argument" {
    for body in ["let a = [].foo()", "let a = Map().foo()", "let a = [1].concat([])", "let a = 3.trim([])", "let a = 3.concat(None)"] {
        let got = diags_of("fn main() \{\n    {body}\n    io.println(\"\{a\}\")\n\}\n")
        if got.len() != 1 { for g in got { io.eprintln("{body}: {g}") } }
        assert_eq(got.len(), 1)
        assert(got.get(0).unwrap().contains("E0505 unresolved method"))
    }
}

test "the note on an open value names what would fix it" {
    let _ = diags_of(#"fn main() {
    let _ = []
}
"#)
    assert_eq(diag_entries.len(), 1)
    assert_eq(diag_entries.get(0).unwrap().notes, ["no annotation, parameter type or return type gives this value its type"])
}

test "an empty list that a later push fills is not E0301" {
    assert_diags(#"fn main() {
    let mut xs = []
    xs.push(1)
    let mut m = Map()
    m.insert("k", 1)
    io.println("{xs.len()} {m.len()}")
}
"#, [])
}

test "an empty list that an annotation, a parameter or a return type types is not E0301" {
    assert_diags(#"fn empty_ints() -> List[Int] { [] }

fn count(xs: List[Int]) -> Int { xs.len() }

fn main() {
    let typed: List[Int] = []
    io.println("{typed == []} {[] == typed} {empty_ints().len()} {count([])}")
}
"#, [])
}

test "an empty list argument the receiver types is not E0301" {
    assert_diags(#"fn main() {
    let nested: List[List[Int]] = [[1]]
    io.println("{nested.contains([])}")
}
"#, [])
}

test "an empty list in a tuple that a later use or an annotation types is not E0301" {
    assert_diags(#"fn main() {
    let (mut a, b) = ([], 1)
    a.push(2)
    let t = ([], 1)
    let x: List[Int] = t.0
    let (c, d): (List[Str], Int) = ([], 3)
    let e: (List[Int], Int) = ([], 4)
    io.println("{a.len()} {b} {x.len()} {c.len()} {d} {e.1}")
}
"#, [])
}

test "an empty List.new or List.with_capacity a later push fills is not E0301" {
    assert_diags(#"fn main() {
    let mut l = List.new()
    l.push(1)
    let mut c = List.with_capacity(4)
    c.push("a")
    io.println("{l.len()} {c.len()}")
}
"#, [])
}

test "a struct literal whose type parameter another argument of a generic call fills is not E0301" {
    assert_diags(#"type W[T] { n: Int }

fn f[T](_w: W[T], x: T) -> T { x }

fn usew[T](w: W[T]) -> Int { w.n }

fn main() {
    let w: W[Int] = W { n: 2 }
    io.println("{f(W { n: 1 }, 5)} {usew(w)}")
}
"#, [])
}

test "a Map construction with its type arguments written is not E0301" {
    assert_diags(#"fn main() {
    io.println("{Map[Str, Int]().len()} {Map.new[Str, Int]().len()}")
}
"#, [])
}

test "a struct literal an annotation or a return type types is not E0301" {
    assert_diags(#"type W[T] { n: Int }
type B[X] { xs: List[X] }

fn wint() -> W[Int] { W { n: 4 } }

fn main() {
    let w: W[Str] = W { n: 2 }
    let mut b = B { xs: [] }
    let c: B[Int] = b
    io.println("{w.n} {wint().n} {c.xs.len()}")
}
"#, [])
}

test "a hole a later push fills is not E0301 when its Display bound is inline, in a where clause or through a supertrait" {
    assert_diags(#"trait Tag { fn tag(self) -> Int }
impl Tag for Int { fn tag(self) -> Int { self * 2 } }
trait Tag2: Tag { fn two(self) -> Int }
impl Tag2 for Int { fn two(self) -> Int { self } }
type Cx[T] { v: List[T] }
impl[T: Tag] Display for Cx[T] { fn fmt(self, sb: StringBuilder) { sb.write("cx{self.v.get(0).unwrap().tag()}") } }
type Cw[T] { v: List[T] }
impl[T] Display for Cw[T] where T: Tag { fn fmt(self, sb: StringBuilder) { sb.write("cw{self.v.get(0).unwrap().tag()}") } }
type Cs[T] { v: List[T] }
impl[T: Tag2] Display for Cs[T] { fn fmt(self, sb: StringBuilder) { sb.write("cs{self.v.get(0).unwrap().two()}") } }

fn main() {
    let mut xs = []
    let mut ys = []
    let mut zs = []
    let mut out = ""
    for i in 0..2 {
        if i > 0 {
            out = "{Cx { v: xs }} {Cw { v: ys }} {Cs { v: zs }}"
        }
        xs.push(1)
        ys.push(2)
        zs.push(3)
    }
    io.println(out)
}
"#, [])
}
