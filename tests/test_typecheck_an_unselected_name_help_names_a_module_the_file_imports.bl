// A bare name that a whole import's module declares but the file does not select is
// ImportNotSelected, and its help names qualified access through that import
// (sections/07_trust_modules_metadata.md). Two modules declare `shuffle` here: the file
// imports zzns_b_cards, and zzns_a_cards is reached only through another file's import, so
// the help names zzns_b_cards whatever the order of the loads. A module the file imports that
// keeps its `shuffle` private (zzns_p_cards) offers no qualified form, so it never takes the
// help from the pub one. A facade the file imports that re-exports `shuffle` (zzns_f_facade)
// is a module the file imports too.

import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

let DIR: Str = "tests/zzns_namesake/src"

fn not_selected_help(file: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    diag_reset()
    check_types(compile_to_program("{DIR}/{file}", 1))
    let mut out = ""
    for d in diag_entries {
        if d.name == "ImportNotSelected" { out = "{d.line}:{d.col} {d.message}" }
    }
    out
}

test "the help names the module the file imports when a helper load is the last declaration" {
    let got = not_selected_help("main_helper_call.bl")
    assert(got.starts_with("5:13 "))
    assert(got.contains("zzns_b_cards.shuffle"))
    assert(!got.contains("zzns_a_cards"))
}

test "the help names the module the file imports when another import loads the other one last" {
    let got = not_selected_help("main_import_order.bl")
    assert(got.starts_with("5:13 "))
    assert(got.contains("zzns_b_cards.shuffle"))
    assert(!got.contains("zzns_a_cards"))
}

test "a private namesake in a whole import imported first does not take the help" {
    let got = not_selected_help("main_private_first.bl")
    assert(got.starts_with("6:13 "))
    assert(got.contains("zzns_b_cards.shuffle"))
    assert(!got.contains("zzns_a_cards"))
}

test "a private namesake in a whole import imported last does not take the help" {
    let got = not_selected_help("main_private_last.bl")
    assert(got.starts_with("6:13 "))
    assert(got.contains("zzns_b_cards.shuffle"))
    assert(!got.contains("zzns_a_cards"))
}

test "a facade the file imports with a selective import takes the help" {
    let got = not_selected_help("main_facade_selective.bl")
    assert(got.starts_with("5:13 "))
    assert(got.contains("zzns_f_facade.shuffle"))
    assert(!got.contains("zzns_a_cards"))
}

test "a facade the file imports with a whole import takes the help" {
    let got = not_selected_help("main_facade_whole.bl")
    assert(got.starts_with("5:13 "))
    assert(got.contains("zzns_f_facade.shuffle"))
    assert(!got.contains("zzns_a_cards"))
}
