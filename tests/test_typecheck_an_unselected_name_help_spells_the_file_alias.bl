// The help for a bare name the file does not select offers the qualified form through the
// qualifier this file binds. After `import M as b` that is `b`, not the leaf of the module
// path (sections/07, Import Aliases). A leaf the file binds to another module is not one.

import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

let DIR: Str = "tests/zzns_namesake/src"

fn not_selected_help(file: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    diag_reset()
    check_types(compile_to_program("{DIR}/{file}", 1))
    let mut out = ""
    for d in diag_entries {
        if d.name == "ImportNotSelected" { out = "{d.line}:{d.col} {d.message}" }
    }
    out
}

test "the help after a whole import with an alias names the alias" {
    let got = not_selected_help("main_alias.bl")
    assert(got.starts_with("4:13 "))
    assert(got.contains("`b.shuffle`"))
    assert(!got.contains("zzns_b_cards"))
}

test "the help after a selective import with an alias names the alias" {
    let got = not_selected_help("main_alias_selective.bl")
    assert(got.starts_with("4:13 "))
    assert(got.contains("`b.shuffle`"))
    assert(!got.contains("zzns_b_cards"))
}

test "the help never names a leaf the file binds to another module" {
    diag_reset()
    check_types(compile_to_program("{DIR}/main_alias_takes_a_leaf.bl", 1))
    for d in diag_entries {
        assert(!d.message.contains("zzns_a_cards.shuffle"))
    }
}
