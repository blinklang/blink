// assert_eq and assert_ne are `fn assert_eq[T: Eq + Debug](left: T, right: T, msg: Str = "")`
// (sections/02_syntax.md, Built-in Assertions): both values have one type. Each argument was
// inferred on its own, so a U8 and an Int got through and codegen compared them after it
// narrowed the Int to a byte. The call is now checked against that signature, the same way a
// user `fn eq[T: Eq](a: T, b: T)` is, and an integer literal still takes its type from the
// other argument.
import lower_test_helpers.{probe, probe_but, assert_eq_str}
import diagnostics.{diag_entries}

fn u8_int_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    let n: Int = 456
    assert_eq(u, n)
}
"#
}

fn ne_u8_int_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    let n: Int = 456
    assert_ne(u, n)
}
"#
}

fn u8_list_elem_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    let xs = [456]
    assert_eq(u, xs.get(0).unwrap())
}
"#
}

fn int_float_src() -> Str {
    #"fn main() {
    let n: Int = 1
    let f: Float = 1.0
    assert_eq(n, f)
}
"#
}

fn str_int_src() -> Str {
    #"fn main() {
    let s = "1"
    let n: Int = 1
    assert_eq(s, n)
}
"#
}

fn u16_u32_src() -> Str {
    #"fn main() {
    let a: U16 = 3
    let b: U32 = 3
    assert_ne(a, b)
}
"#
}

fn with_msg_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    let n: Int = 456
    assert_eq(u, n, "bytes")
}
"#
}

fn literal_adapts_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    let a: I32 = -3
    assert_eq(u, 200)
    assert_ne(u, 7)
    assert_eq(a, -3)
    assert_eq(u, 200, "with a message")
}
"#
}

fn same_type_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    let v: U8 = 200
    let s = "x"
    let xs = [1, 2]
    assert_eq(u, v)
    assert_ne(s, "y")
    assert_eq(xs, [1, 2])
    let r: Result[Int, Str] = Ok(1)
    assert_eq(r, Ok(1))
    let o: Option[Int] = None
    assert_eq(None, o)
}
"#
}

fn no_eq_src() -> Str {
    #"type P { x: Int }

fn main() {
    let p = P { x: 1 }
    assert_eq(p, p)
}
"#
}

fn type_error_message() -> Str {
    let mut msg = ""
    for d in diag_entries {
        if d.name == "TypeError" { msg = d.message }
    }
    msg
}

test "assert_eq refuses a U8 and an Int" {
    let program = probe_but("aeq_u8_int", u8_int_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_eq` expects U8, got Int")
}

test "assert_ne refuses a U8 and an Int" {
    let program = probe_but("aeq_ne_u8_int", ne_u8_int_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_ne` expects U8, got Int")
}

test "assert_eq refuses a U8 and a List[Int] element" {
    let program = probe_but("aeq_u8_list_elem", u8_list_elem_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_eq` expects U8, got Int")
}

test "assert_eq refuses an Int and a Float" {
    let program = probe_but("aeq_int_float", int_float_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_eq` expects Int, got Float")
}

test "assert_eq refuses a Str and an Int" {
    let program = probe_but("aeq_str_int", str_int_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_eq` expects Str, got Int")
}

test "assert_ne refuses a U16 and a U32" {
    let program = probe_but("aeq_u16_u32", u16_u32_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_ne` expects U16, got U32")
}

test "a trailing message does not hide the mismatch" {
    let program = probe_but("aeq_with_msg", with_msg_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "argument 2 of `assert_eq` expects U8, got Int")
}

test "an integer literal takes the type of the other argument" {
    let program = probe("aeq_literal_adapts", literal_adapts_src())
    assert(program >= 0)
}

test "two values of one type pass" {
    let program = probe("aeq_same_type", same_type_src())
    assert(program >= 0)
}

test "a type with no Eq is still refused" {
    let program = probe_but("aeq_no_eq", no_eq_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
}

fn one_arg_src() -> Str {
    #"fn main() {
    let u: U8 = 200
    assert_eq(u)
}
"#
}

test "a call with one value is refused by its count" {
    let program = probe_but("aeq_one_arg", one_arg_src(), "TypeError")
    assert(program >= 0)
    assert_eq_str("message", type_error_message(), "function `assert_eq` expects 2 or 3 argument(s), got 1")
}
