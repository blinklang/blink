// A plain `=` to a name with no binding is a typo for a variable, the same as a read of
// that name, so it reports E0506. Name resolution walked only the value of such an
// assignment, so the target reached the end of typechecking with no type and stopped as
// an internal compiler error.

import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    write_file(path, src)
    diag_reset()
    check_types(compile_to_program(path, 1))
    let _ = fs.delete(path)
}

fn reported(name: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    probe("build/tc_assign_undeclared_{name}.bl", src)
    let mut out = ""
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out = out.concat("{d.code} {d.message}\n") }
    }
    io.println("{name}: {out}")
    out
}

test "assigning a name with no binding reports E0506" {
    assert_eq(reported("bare", "fn main() \{\n    zz = 1\n}\n"), "E0506 undefined variable `zz`\n")
}

test "a misspelled accumulator in a loop body reports E0506 for the misspelling" {
    let src = "fn total() -> Int \{\n    let mut acc = 0\n    for v in [1, 2] \{\n        aScc = acc + v\n    }\n    acc\n}\n\nfn main() \{\n    io.println(\"\{total()}\")\n}\n"
    assert_eq(reported("loop", src), "E0506 undefined variable `aScc`\n")
}

test "a compound assignment to a name with no binding reports E0506" {
    assert_eq(reported("compound", "fn main() \{\n    zz += 1\n}\n"), "E0506 undefined variable `zz`\n")
}

test "assigning a declared local reports nothing" {
    assert_eq(reported("local", "fn main() \{\n    let mut x = 0\n    x = 1\n    io.println(\"\{x}\")\n}\n"), "")
}

test "assigning a module-level mutable global reports nothing" {
    assert_eq(reported("global", "let mut count = 0\n\nfn main() \{\n    count = 1\n    io.println(\"\{count}\")\n}\n"), "")
}
