// A read of a cross-module global the file never imported is rejected with
// ImportNotSelected. A plain `=` assignment to the same unimported global must be rejected
// the same way: today the Assignment arm of nr_check_node records the write without ever
// running the read arm's selective-import gate, so the program is accepted by typecheck and
// only fails much later, as an unrelated internal compiler error in codegen.

import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

fn probe(path: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    diag_reset()
    check_types(compile_to_program(path, 1))
}

fn errors() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    out
}

fn has_error_naming(name: Str, subject: Str) -> Bool {
    for e in errors() {
        if e.starts_with("{name}: ") && e.contains(subject) { return true }
    }
    false
}

test "assigning an unimported cross-module global is rejected with ImportNotSelected" {
    probe("tests/zzcdg_calls/src/main_assign_unimported.bl")
    if !has_error_naming("ImportNotSelected", "zzcdg_count") {
        io.println("FAIL: no ImportNotSelected for 'zzcdg_count'; got:")
        for e in errors() { io.println("  {e}") }
    }
    assert(has_error_naming("ImportNotSelected", "zzcdg_count"))
}

// The same assignment, with zzcdg_count properly selected. Tightening the unimported case
// must not reject a file whose import list names what it assigns.
test "assigning a properly imported cross-module global reports no error" {
    probe("tests/zzcdg_calls/src/main_assign_imported.bl")
    let errs = errors()
    if errs.len() != 0 {
        io.println("FAIL: importing the name still reported:")
        for e in errs { io.println("  {e}") }
    }
    assert(errs.len() == 0)
}
