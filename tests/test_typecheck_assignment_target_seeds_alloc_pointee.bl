// An assignment target is a declared type, exactly as a let annotation is. The arena
// allocators read the type expected of the call to learn what they point at, and that
// channel had a let site and no assignment site — so `p = scope.alloc_n(4)` could not see
// the `Ptr[I64]` that `p` was declared with, one line up. The allocation then had no
// pointee at all: first it was sized from `sizeof(void)`, four bytes for four 8-byte cells,
// and since the under-determined-type decision it is a refusal to compile valid code.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_type_str, tc_tid_child, tc_tid_child_count}
import parser.{nodes, node_kind, node_method, node_elements, sublist_length}
import ast.{NodeKind}
import diagnostics.{diag_entries, diag_reset, diag_file_for_node}
import std.io

fn typecheck_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

fn diag_names() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push(d.name) }
    }
    out
}

fn assert_no_errors(label: Str) {
    let names = diag_names()
    if names.len() != 0 {
        io.println("FAIL: {label}: unexpected diagnostics:")
        for n in names { io.println("  {n}") }
    }
    assert(names.len() == 0)
}

// The one MethodCall naming `method`. -2 marks an ambiguous measurement.
fn only_method_call(method: Str) -> Int {
    let mut found = -1
    let mut hits = 0
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.MethodCall && node_method(i) == method {
            hits = hits + 1
            found = i
        }
        i = i + 1
    }
    if hits > 1 { return -2 }
    found
}

fn tid_str(t: Int) -> Str ! Diag.Report {
    if t < 0 { return "<unset>" }
    tc_type_str(t)
}

fn assert_tid(label: Str, t: Int, want: Str) ! Diag.Report {
    let got = tid_str(t)
    if got != want { io.println("FAIL: {label}: tid is {got}, want {want}") }
    assert(got == want)
}

fn alloc_n_assign_src() -> Str {
    #"
@trusted(audit: "x")
fn go() ! FFI {
    with ffi.scope() as scope {
        let mut p: Ptr[I64] = scope.alloc()
        p.write(5)
        p = scope.alloc_n(4)
        p.write(1)
    }
}
fn main() { go() }
"#
}

test "an assignment target's declared type names the pointee of an alloc_n on its right" {
    typecheck_probe("build/tc_assign_alloc_n.bl", alloc_n_assign_src())
    assert_no_errors("alloc_n in assignment position")
    let c = only_method_call("alloc_n")
    assert(c >= 0)
    let t = tc_lookup_node_tid(c)
    // Ptr[Int], not Ptr[I64]: `I64` is a spelling of `Int` that name resolution collapses, so
    // there is no distinct I64 tid for the pointee to be. The row below carries a width that
    // does stay distinct, which is where "the pointee is carried, not defaulted" is proved.
    assert_tid("alloc_n call", t, "Ptr[Int]")
    // The head being right is not the claim. The pointee is what sizes the allocation.
    assert(tc_tid_child_count(t) == 1)
    assert_tid("pointee", tc_tid_child(t, 0), "Int")
}

fn alloc_assign_src() -> Str {
    #"
@trusted(audit: "x")
fn go() ! FFI {
    with ffi.scope() as scope {
        let mut p: Ptr[U8] = scope.alloc()
        p = scope.alloc()
        p.write(7)
    }
}
fn main() { go() }
"#
}

// alloc reads the same channel as alloc_n, so the seed has to serve both or the fix is
// specific to one method name rather than to the missing channel.
test "the same assignment seed answers a plain alloc on the right" {
    typecheck_probe("build/tc_assign_alloc.bl", alloc_assign_src())
    assert_no_errors("alloc in assignment position")
    let mut i = 0
    let mut hits = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.MethodCall && node_method(i) == "alloc" {
            assert_tid("alloc call", tc_lookup_node_tid(i), "Ptr[U8]")
            hits = hits + 1
        }
        i = i + 1
    }
    // The let's allocator and the assignment's, both typed.
    assert(hits == 2)
}

fn mismatch_src() -> Str {
    #"
@trusted(audit: "x")
fn go() ! FFI {
    with ffi.scope() as scope {
        let mut p: Ptr[I64] = scope.alloc()
        let mut q: Ptr[U8] = scope.alloc()
        p = q
        p.write(1)
    }
}
fn main() { go() }
"#
}

// The seed must not become a way to pass an assignment that disagrees. A hint says what is
// expected of a value that has no type of its own; it does not overwrite one that has.
test "seeding the target type still rejects an assignment between unlike pointers" {
    typecheck_probe("build/tc_assign_ptr_mismatch.bl", mismatch_src())
    let mut hits = 0
    for n in diag_names() {
        if n == "TypeError" { hits = hits + 1 }
    }
    assert(hits >= 1)
}

fn both_positions_src() -> Str {
    #"
@trusted(audit: "x")
fn go() ! FFI {
    with ffi.scope() as scope {
        let mut p: Ptr[U8] = scope.alloc_n(2)
        let mut q: Ptr[U8] = scope.alloc()
        q = scope.alloc_n(3)
        p.write(1)
        q.write(2)
    }
}
fn main() { go() }
"#
}

// The claim of the fix is that the two positions are the same channel, not that assignment
// grew a channel of its own that happens to work. Measured as an equality between the two
// calls rather than against a written-out type, so the row keeps its meaning if the
// spelling of the pointee ever changes.
test "an alloc_n on the right of an assignment carries the same type as one in a let" {
    typecheck_probe("build/tc_assign_alloc_n_both.bl", both_positions_src())
    assert_no_errors("alloc_n in both positions")
    let mut found: List[Int] = []
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.MethodCall && node_method(i) == "alloc_n" {
            found.push(tc_lookup_node_tid(i))
        }
        i = i + 1
    }
    assert(found.len() == 2)
    let in_let = found.get(0).unwrap()
    let in_assign = found.get(1).unwrap()
    if in_let != in_assign {
        io.println("FAIL: let says {tid_str(in_let)}, assignment says {tid_str(in_assign)}")
    }
    assert(in_let == in_assign)
    assert_tid("alloc_n in a let", in_let, "Ptr[U8]")
}

fn empty_list_src() -> Str {
    #"
fn go() {
    let ys: List[Str] = []
    let mut xs: List[Int] = [1, 2]
    xs = []
    let _ = xs.len()
    let _ = ys.len()
}
fn main() { go() }
"#
}

// The arena allocators are not the only reader of the expected type at an assignment's
// right. A container literal with nothing in it has no element type of its own and can only
// take the one the target was declared with, so it fails the same way when that channel is
// missing.
test "an empty list on the right of an assignment takes the target's element type" {
    typecheck_probe("build/tc_assign_empty_list.bl", empty_list_src())
    assert_no_errors("empty list in assignment position")
    // The pool holds the whole prelude too, and it writes empty lists of its own.
    let mut found: List[Int] = []
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.ListLit && sublist_length(node_elements(i)) == 0 && diag_file_for_node(i) == "build/tc_assign_empty_list.bl" {
            found.push(i)
        }
        i = i + 1
    }
    assert(found.len() == 2)
    // Written in this order: the let's empty list, then the assignment's. Both are here so
    // the row says the two positions agree, and the two element types differ so neither can
    // pass by reading the other's.
    let in_let = tc_lookup_node_tid(found.get(0).unwrap())
    let in_assign = tc_lookup_node_tid(found.get(1).unwrap())
    assert_tid("empty list in a let", in_let, "List[Str]")
    assert_tid("empty list in an assignment", in_assign, "List[Int]")
    assert(tc_tid_child_count(in_assign) == 1)
    assert_tid("element", tc_tid_child(in_assign, 0), "Int")
}
