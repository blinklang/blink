// `=` or `op=` whose path takes a step through a `Ptr` is `error[NotAPlace]` (E0611,
// sections/02_syntax.md §2.22 *Writes that are not to a place*, case 1;
// sections/07_trust_modules_metadata.md §9.1.3). A field behind a `Ptr` is written with
// `.write()`. The case comes first, so the root kind does not matter: a `let`, a `let mut` and
// a parameter all give E0611 and nothing else. The fix calls `.write()` on the same path.
// `p.f.write(rhs)` reads `p` before `rhs` runs and `p.f = rhs` reads it after, so the fix writes
// `rhs` in place only when it runs no code; any other `rhs` of a statement in a block moves to a
// `let` on the line before. Anywhere else, and for `op=`, it is help only. A temporary root,
// case 2, is E0611 too, with help only. The build must report the same error, never an
// internal compiler error.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import compile_test_helpers
import std.io

fn probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

fn errors() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            out.push("{d.name} {d.code} {d.line}:{d.col}: {d.message} | label: {d.label} | help: {d.help} | notes: {d.notes.join(\"; \")} | fix: {d.fix_action} `{d.fix_text}` at {d.fix_line}:{d.fix_col}-{d.fix_end_line}:{d.fix_end_col}")
        }
    }
    out
}

fn show(label: Str) {
    io.println("FAIL: {label}: got:")
    for e in errors() { io.println("  {e}") }
}

// One error, and it is E0611 at line:col with this label and help, the not-a-place note
// plus `extra_note` when it is not empty, and a fix that puts `fix` in place of the statement
// from line:col on, or no fix when `fix` is empty.
fn expect_e0611(label: Str, line: Int, col: Int, ptr_label: Str, help: Str, extra_note: Str, fix: Str) {
    let mut ok = errors().len() == 1
    for d in diag_entries {
        if d.severity == "error" {
            if d.name != "NotAPlace" || d.code != "E0611" { ok = false }
            if d.message != "cannot assign through a `Ptr`" { ok = false }
            if d.line != line || d.col != col { ok = false }
            if d.label != ptr_label || d.help != help { ok = false }
            if !d.notes.contains("a field behind a `Ptr` is not a place; write it with `.write()`") { ok = false }
            if extra_note != "" && !d.notes.contains(extra_note) { ok = false }
            if fix == "" {
                if d.fix_action != "" || d.fix_text != "" { ok = false }
            } else if d.fix_action != WRITE_FIX || d.fix_text != fix || d.fix_line != line || d.fix_col != col {
                ok = false
            }
        }
    }
    if !ok { show(label) }
    assert(ok)
}

let WRITE_FIX = "call `.write()`"

let IOVEC = "@ffi.struct(header: \"sys/uio.h\", name: \"iovec\")\npub type IoVec \{ iov_base: Ptr[U8], iov_len: U64 }\n\n"

let NOT_ATOMIC = "this is a read and then a write, not one atomic step"

let OWN_LINE = "the right side runs before `p` is read, so the fix keeps it on its own line"

test "a write through a Ptr held by a plain let is E0611" {
    probe(".tmp/ptr_place_let.bl", "{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len = 4\n    }\n}\n")
    expect_e0611("let", 7, 9, "`p` is a `Ptr[IoVec]`", "`p.iov_len.write(4)`", "", "p.iov_len.write(4)")
}

test "a write through a Ptr held by a let mut is E0611, not a mutability error" {
    probe(".tmp/ptr_place_let_mut.bl", "{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let mut p = s.alloc[IoVec]()\n        p.iov_len = 4\n        p = s.alloc[IoVec]()\n    }\n}\n")
    expect_e0611("let mut", 7, 9, "`p` is a `Ptr[IoVec]`", "`p.iov_len.write(4)`", "", "p.iov_len.write(4)")
}

test "a write through a Ptr parameter is E0611, not a parameter error" {
    probe(".tmp/ptr_place_param.bl", "{IOVEC}@trusted(audit: \"ptr-place-param\")\nfn set_len(p: Ptr[IoVec], n: U64) \{\n    p.iov_len = n\n}\n\nfn main() \{}\n")
    expect_e0611("param", 6, 5, "`p` is a `Ptr[IoVec]`", "`p.iov_len.write(n)`", "", "p.iov_len.write(n)")
}

test "a write through a Ptr reached through a field of a plain let is E0611, not a mutability error" {
    probe(".tmp/ptr_place_mid_path.bl", "{IOVEC}type Holder \{ v: Ptr[IoVec] }\n\nfn main() \{\n    with ffi.scope() as s \{\n        let h = Holder \{ v: s.alloc[IoVec]() }\n        h.v.iov_len = 4\n    }\n}\n")
    expect_e0611("mid path", 9, 9, "`h.v` is a `Ptr[IoVec]`", "`h.v.iov_len.write(4)`", "", "h.v.iov_len.write(4)")
}

test "a write to a field nested in the pointee of a Ptr is E0611" {
    let src = "@ffi.struct\ntype Inner \{ b: Int, c: Int }\n\n@ffi.struct\ntype Outer \{ a: Inner, n: Int }\n\nfn main() \{\n    with ffi.scope() as s \{\n        let p: Ptr[Outer] = s.alloc()\n        p.a.b = 5\n    }\n}\n"
    probe(".tmp/ptr_place_nested.bl", src)
    expect_e0611("nested", 10, 9, "`p` is a `Ptr[Outer]`", "`p.a.b.write(5)`", "", "p.a.b.write(5)")
}

test "a compound write through a Ptr is E0611 with a read-then-write help" {
    probe(".tmp/ptr_place_compound.bl", "{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len += 1\n    }\n}\n")
    expect_e0611("op=", 7, 9, "`p` is a `Ptr[IoVec]`", "`p.iov_len.write(p.iov_len.read() + 1)`", NOT_ATOMIC, "")
}

test "a write through a Ptr with a right side that runs code keeps the right side on its own line" {
    probe(".tmp/ptr_place_effectful_rhs.bl", "{IOVEC}fn next() -> U64 \{ 9 }\n\nfn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len = next()\n    }\n}\n")
    expect_e0611("call rhs", 9, 9, "`p` is a `Ptr[IoVec]`", "`let iov_len = next()`, then `p.iov_len.write(iov_len)`", OWN_LINE, "let iov_len = next()\n        p.iov_len.write(iov_len)")
}

test "build reports E0611 for a write through a Ptr, never an internal error" {
    let out = compile_test_helpers.compile_and_capture("{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len = 4\n    }\n}\n", "ptr_place_build")
    compile_test_helpers.expect_error(out, "E0611", "build gives E0611")
    let no_ice = !out.contains("\"severity\":\"ice\"")
    if !no_ice { io.println("FAIL: build ICE: {out}") }
    assert(no_ice)
}

test "a field written and read through a Ptr with write and read runs" {
    let src = "import std.io\n\n{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len.write(4)\n        p.iov_len.write(p.iov_len.read() + 1)\n        io.println(\"\{p.iov_len.read()}\")\n    }\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "ptr_place_write_runs")
    if r.exit_code != 0 { io.println("FAIL: run: {r.err_out}") }
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "5")
}

// One error, and it is NoSuchField (E0525) at line:col: a field the pointee lacks is reported
// as missing, with no `.write()` help for a field that does not exist.
fn expect_no_such_field(label: Str, line: Int, col: Int, message: Str) {
    let mut ok = errors().len() == 1
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            if d.name != "NoSuchField" || d.code != "E0525" { ok = false }
            if d.message != message { ok = false }
            if d.line != line || d.col != col { ok = false }
        }
    }
    if !ok { show(label) }
    assert(ok)
}

test "a write through a Ptr to a field the pointee lacks reports the missing field" {
    probe(".tmp/ptr_place_missing_field.bl", "{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.nope = 4\n    }\n}\n")
    expect_no_such_field("missing field write", 7, 9, "type IoVec has no field `nope`")
}

test "a read and a write call through a Ptr on a field the pointee lacks report the missing field" {
    probe(".tmp/ptr_place_missing_field_read.bl", "{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        let y = p.nope\n        let _ = y\n    }\n}\n")
    expect_no_such_field("missing field read", 7, 17, "type IoVec has no field `nope`")
    probe(".tmp/ptr_place_missing_field_write_call.bl", "{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.nope.write(4)\n    }\n}\n")
    expect_no_such_field("missing field write call", 7, 9, "type IoVec has no field `nope`")
}

test "a field through a Ptr to a type with no fields reports the missing field" {
    probe(".tmp/ptr_place_scalar_pointee.bl", "fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[I32]()\n        p.x = 4\n    }\n}\n")
    expect_no_such_field("scalar pointee write", 4, 9, "type Ptr[I32] has no field `x`")
    probe(".tmp/ptr_place_scalar_pointee_read.bl", "fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[I32]()\n        let y = p.x\n        let _ = y\n    }\n}\n")
    expect_no_such_field("scalar pointee read", 4, 17, "type Ptr[I32] has no field `x`")
}

test "build reports a missing field through a Ptr, never an internal error" {
    let out = compile_test_helpers.compile_and_capture("{IOVEC}fn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        let y = p.nope\n        let _ = y\n    }\n}\n", "ptr_place_missing_field_build")
    compile_test_helpers.expect_error(out, "E0525", "build gives E0525")
    let no_ice = !out.contains("\"severity\":\"ice\"")
    if !no_ice { io.println("FAIL: build ICE: {out}") }
    assert(no_ice)
}

test "the name the help binds is not one already in scope" {
    let node = "@ffi.struct\ntype Node \{ p: Int, n: Int }\n\nfn next() -> Int \{ 9 }\n\n"
    probe(".tmp/ptr_place_help_name_root.bl", "{node}fn main() \{\n    with ffi.scope() as s \{\n        let p: Ptr[Node] = s.alloc()\n        p.p = next()\n    }\n}\n")
    expect_e0611("name is the root", 9, 9, "`p` is a `Ptr[Node]`", "`let p_1 = next()`, then `p.p.write(p_1)`", OWN_LINE, "let p_1 = next()\n        p.p.write(p_1)")
    probe(".tmp/ptr_place_help_name_local.bl", "{node}fn main() \{\n    let n = 1\n    let n_1 = 2\n    with ffi.scope() as s \{\n        let p: Ptr[Node] = s.alloc()\n        p.n = next() + n + n_1\n    }\n}\n")
    expect_e0611("name is a local", 11, 9, "`p` is a `Ptr[Node]`", "`let n_2 = next() + n + n_1`, then `p.n.write(n_2)`", OWN_LINE, "let n_2 = next() + n + n_1\n        p.n.write(n_2)")
}

test "a right side the help cannot quote still gets the write help" {
    probe(".tmp/ptr_place_unquoted_rhs.bl", "{IOVEC}fn main() \{\n    let c = true\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len = if c \{ 1 } else \{ 2 }\n    }\n}\n")
    expect_e0611("unquoted rhs", 8, 9, "`p` is a `Ptr[IoVec]`", "`let iov_len = if c \{ 1 } else \{ 2 }`, then `p.iov_len.write(iov_len)`", OWN_LINE, "let iov_len = if c \{ 1 } else \{ 2 }\n        p.iov_len.write(iov_len)")
    probe(".tmp/ptr_place_unquoted_rhs_compound.bl", "{IOVEC}fn main() \{\n    let c = true\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len += if c \{ 1 } else \{ 2 }\n    }\n}\n")
    expect_e0611("unquoted rhs op=", 8, 9, "`p` is a `Ptr[IoVec]`", "`p.iov_len.write(p.iov_len.read() + ...)`", NOT_ATOMIC, "")
}

test "a write through a Ptr in a match arm with no braces gets a fix only for an inert right side" {
    let head = "{IOVEC}fn next() -> U64 \{ 9 }\n\nfn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        let k = 1\n        match k \{\n"
    let tail = "            _ => \{}\n        }\n    }\n}\n"
    probe(".tmp/ptr_place_arm_inert.bl", "{head}            1 => p.iov_len = 4\n{tail}")
    expect_e0611("arm inert", 11, 18, "`p` is a `Ptr[IoVec]`", "`p.iov_len.write(4)`", "", "p.iov_len.write(4)")
    probe(".tmp/ptr_place_arm_call.bl", "{head}            1 => p.iov_len = next()\n{tail}")
    expect_e0611("arm call", 11, 18, "`p` is a `Ptr[IoVec]`", "`let iov_len = next()`, then `p.iov_len.write(iov_len)`", OWN_LINE, "")
}

test "a right side over several lines moves whole to the let" {
    probe(".tmp/ptr_place_multiline_rhs.bl", "{IOVEC}fn add(a: U64, b: U64) -> U64 \{ a + b }\n\nfn main() \{\n    with ffi.scope() as s \{\n        let p = s.alloc[IoVec]()\n        p.iov_len = add(\n            1,\n            2)\n    }\n}\n")
    expect_e0611("multi-line rhs", 9, 9, "`p` is a `Ptr[IoVec]`", "`let iov_len = add(1, 2)`, then `p.iov_len.write(iov_len)`", OWN_LINE, "let iov_len = add(\n            1,\n            2)\n        p.iov_len.write(iov_len)")
}

test "a Ptr field of a temporary is the Ptr case, and the fix keeps the call" {
    let src = "{IOVEC}type H \{ p: Ptr[IoVec] }\n\n@trusted(audit: \"ptr-place-temp-mk\")\nfn mkh(p: Ptr[IoVec]) -> H \{ H \{ p: p } }\n\n@trusted(audit: \"ptr-place-temp\")\nfn f(p: Ptr[IoVec]) \{\n    mkh(p).p.iov_len = 5\n}\n\nfn main() \{}\n"
    probe(".tmp/ptr_place_temp_root.bl", src)
    expect_e0611("temporary holds the Ptr", 11, 5, "`mkh(p).p` is a `Ptr[IoVec]`", "`mkh(p).p.iov_len.write(5)`", "", "mkh(p).p.iov_len.write(5)")
}

// One error, and it is E0611 for a temporary root at line:col, with the label on the root,
// this help, and no fix.
fn expect_temporary(label: Str, line: Int, col: Int, help: Str) {
    let mut ok = errors().len() == 1
    for d in diag_entries {
        if d.severity == "error" {
            if d.name != "NotAPlace" || d.code != "E0611" { ok = false }
            if d.message != "cannot assign to a temporary value" { ok = false }
            if d.line != line || d.col != col { ok = false }
            if d.label != "no name holds this value, so the store is lost" || d.help != help { ok = false }
            if d.fix_action != "" || d.fix_text != "" { ok = false }
        }
    }
    if !ok { show(label) }
    assert(ok)
}

let TEMP_TYPES = "type Pt \{ x: Int }\n\ntype Box \{ pt: Pt }\n\ntrait Again \{\n    fn again(self) -> Self\n}\n\nimpl Again for Pt \{\n    fn again(self) -> Pt \{ self }\n}\n\nfn mk() -> Pt \{ Pt \{ x: 1 } }\n\nfn mkb() -> Box \{ Box \{ pt: mk() } }\n\n"

test "a write to a field of a call result is E0611 with a bind-it-first help" {
    probe(".tmp/temp_root_call.bl", "{TEMP_TYPES}fn main() \{\n    mk().x = 5\n}\n")
    expect_temporary("call", 18, 5, "bind it first: `let mut p = mk()`, then `p.x = 5`")
    probe(".tmp/temp_root_nested.bl", "{TEMP_TYPES}fn main() \{\n    mkb().pt.x = 6\n}\n")
    expect_temporary("nested", 18, 5, "bind it first: `let mut b = mkb()`, then `b.pt.x = 6`")
    probe(".tmp/temp_root_compound.bl", "{TEMP_TYPES}fn main() \{\n    mk().x += 1\n}\n")
    expect_temporary("op=", 18, 5, "bind it first: `let mut p = mk()`, then `p.x += 1`")
}

test "a write to a field of a method result is E0611, and the help names a free name" {
    probe(".tmp/temp_root_method.bl", "{TEMP_TYPES}fn main() \{\n    let p = mk()\n    p.again().x = 2\n    let _ = p\n}\n")
    expect_temporary("method", 19, 5, "bind it first: `let mut p_1 = p.again()`, then `p_1.x = 2`")
    probe(".tmp/temp_root_deref.bl", "{IOVEC}@trusted(audit: \"temp-root-deref\")\nfn f(p: Ptr[IoVec]) \{\n    p.deref().iov_len = 4\n}\n\nfn main() \{}\n")
    expect_temporary("deref", 6, 5, "bind it first: `let mut i = p.deref()`, then `i.iov_len = 4`")
}

test "build reports E0611 for a write to a temporary, never an internal error" {
    let out = compile_test_helpers.compile_and_capture("{TEMP_TYPES}fn main() \{\n    mk().x = 5\n}\n", "temp_root_build")
    compile_test_helpers.expect_error(out, "E0611", "build gives E0611")
    let no_ice = !out.contains("\"severity\":\"ice\"")
    if !no_ice { io.println("FAIL: build ICE: {out}") }
    assert(no_ice)
}
