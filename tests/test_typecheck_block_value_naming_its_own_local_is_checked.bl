// A block, `if` or `match` value whose tail names a binding the block declares has the type
// of that tail, so a consumer checks it as it checks the binding written in its place: a U64
// where a U8 goes is a TypeError at the same place, and not a value that passes unchecked.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, tc_hints}
import diagnostics.{diag_entries, diag_reset}
import compile_test_helpers
import std.io

fn probe(name: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    let path = "{compile_test_helpers.scratch_root()}/{name}.bl"
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

fn errors() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            out.push("{d.name} {d.code} {d.line}:{d.col}: {d.message}")
        }
    }
    out
}

// The errors are exactly `want`, in order.
fn expect(label: Str, want: List[Str]) {
    let got = errors()
    let mut ok = got.len() == want.len()
    let mut i = 0
    while ok && i < got.len() {
        if got.get(i).unwrap() != want.get(i).unwrap() { ok = false }
        i = i + 1
    }
    if !ok {
        io.println("FAIL: {label}: got:")
        for e in got { io.println("  {e}") }
    }
    assert(ok)
}

test "a block value into a U8 field or a U8 assignment is a TypeError" {
    probe("block_own_local_field_assign", "type Box \{ v: U8 }\nfn main() \{\n    let q: U64 = 300\n    let b = Box \{ v: \{\n        let h = q\n        h\n    } }\n    let mut x: U8 = 0\n    x = \{\n        let g = q\n        g\n    }\n    io.println(\"\{b.v} \{x}\")\n}\n")
    expect("field and assign", [
        "TypeError E0300 4:22: field `v` of `Box`: declared type U8 but got U64",
        "TypeError E0300 9:5: assignment: cannot assign U64 to U8",
    ])
}

test "a block value added into a U8 is a TypeError, not a run-time overflow" {
    probe("block_own_local_compound", "fn main() \{\n    let q: U64 = 300\n    let mut x: U8 = 1\n    x += \{\n        let h = q\n        h\n    }\n    io.println(\"\{x}\")\n}\n")
    expect("compound assign", ["TypeError E0300 4:5: assignment: cannot assign U64 to U8"])
}

test "an operator checks a block operand as it checks the binding the block names" {
    probe("block_own_local_operators", "fn main() \{\n    let q: U64 = 3\n    let x: U32 = 1\n    let y: U8 = 1\n    let s = x << \{ let a = q\n        a }\n    let c = \{ let h = y\n        h } == 300\n    let t = y + \{ let g = q\n        g }\n    io.println(\"\{s} \{c} \{t}\")\n}\n")
    expect("operators", [
        "TypeError E0300 5:15: shift `<<` amount must be U32, got U64",
        "IntLiteralOutOfRange E0318 8:16: 300 does not fit in U8 (0 to 255)",
        "TypeError E0300 9:15: binary `+`: incompatible types U8 and U64",
    ])
}

test "an if or match argument whose branch block names its own local is checked" {
    probe("block_own_local_branch_arg", "fn n8(x: U8) -> U8 \{ x }\nfn main() \{\n    let q: U64 = 300\n    let c = true\n    let r = n8(if c \{\n        let h = q\n        h\n    } else \{ 1 })\n    let r2 = n8(match c \{\n        true => \{\n            let h = q\n            h\n        }\n        false => 1\n    })\n    io.println(\"\{r} \{r2}\")\n}\n")
    expect("if and match argument", [
        "TypeError E0300 5:16: if branches have incompatible types: U64 vs U8",
        "TypeError E0300 5:16: argument 1 of `n8` expects U8, got U64",
        "TypeError E0300 14:18: match arms have incompatible types: U64 vs U8",
        "TypeError E0300 9:17: argument 1 of `n8` expects U8, got U64",
    ])
}

test "a keyword argument error stays on its label" {
    probe("block_own_local_keyword_arg", "fn f(a: Int, -- b: U8) -> Int \{ a + b.to_int() }\nfn main() \{\n    let q: U64 = 3\n    let r = f(1, b: \{\n        let h = q\n        h\n    })\n    let r2 = f(1, b: q)\n    io.println(\"\{r} \{r2}\")\n}\n")
    expect("keyword argument", [
        "TypeError E0300 4:18: argument 2 of `f` expects U8, got U64",
        "TypeError E0300 8:19: argument 2 of `f` expects U8, got U64",
    ])
}

test "branch blocks whose tails name their own locals compare by those tails" {
    probe("block_own_local_branch_agree", "fn q() -> U64 \{ 7 }\nfn main() \{\n    let c = true\n    let d: U64 = if c \{\n        let h = q()\n        h * 2\n    } else \{ 1 }\n    io.println(\"\{d}\")\n}\n")
    expect("agreeing branches", [])
    probe("block_own_local_branch_disagree", "fn q() -> U64 \{ 7 }\nfn main() \{\n    let c = true\n    let a = if c \{\n        let h = q()\n        h + 1\n    } else \{\n        let s = \"x\"\n        s\n    }\n    io.println(\"\{a}\")\n}\n")
    expect("disagreeing branches", ["TypeError E0300 4:13: if branches have incompatible types: U64 vs Str"])
}

test "a block value nested many levels deep is checked against its consumer" {
    probe("block_own_local_deep", "fn n8(x: U8) -> U8 \{ x }\nfn main() \{\n    let q: U64 = 300\n    let c = true\n    let d = n8(\{\n        let _a = 1\n        \{ \{ \{ \{ \{ \{ \{ \{ \{ q } } } } } } } } }\n    })\n    let e: U8 = \{\n        let h = q\n        if c \{ if c \{ if c \{ if c \{ h } else \{ h } } else \{ h } } else \{ h } } else \{ h }\n    }\n    io.println(\"\{d} \{e}\")\n}\n")
    expect("deep nest", [
        "TypeError E0300 5:16: argument 1 of `n8` expects U8, got U64",
        "TypeError E0300 9:5: variable `e`: declared type U8 but got U64",
    ])
}

test "a block whose tail is a mismatched if reports the if and its consumer" {
    probe("block_own_local_tail_if_mismatch", "fn n8(x: U8) -> U8 \{ x }\nfn main() \{\n    let c = true\n    let q: U64 = 300\n    let v = n8(\{\n        let _a = 1\n        if c \{ q } else \{ 1 }\n    })\n    io.println(\"\{v}\")\n}\n")
    expect("tail if mismatch", [
        "TypeError E0300 7:9: if branches have incompatible types: U64 vs U8",
        "TypeError E0300 5:16: argument 1 of `n8` expects U8, got U64",
    ])
}

test "a block value argument is walked once, so its error is reported once" {
    probe("block_own_local_walked_once", "fn takes(xs: List[Int]) -> Int \{ xs.len() }\nfn main() \{\n    let mut l = []\n    let n = takes(\{\n        let k = l\n        let z: Str = k\n        k\n    })\n    io.println(\"\{n}\")\n}\n")
    let mut z_errors = 0
    for e in errors() {
        if e.contains("variable `z`") { z_errors = z_errors + 1 }
    }
    if z_errors != 1 { io.println("FAIL: walked once: got {z_errors} errors for `z`") }
    assert(z_errors == 1)
}

test "a let inside a block value gets one inlay hint" {
    probe("block_own_local_one_hint", "fn main() \{\n    let q: U64 = 3\n    let s = \{\n        let a = \{\n            let deep_b = q\n            deep_b\n        }\n        a\n    }\n    io.println(\"\{s}\")\n}\n")
    // The name is one no stdlib module declares, since tc_hints holds every module's lets.
    let mut b_hints = 0
    for h in tc_hints {
        if h.name == "deep_b" { b_hints = b_hints + 1 }
    }
    if b_hints != 1 { io.println("FAIL: one hint: got {b_hints} hints for `deep_b`") }
    assert(b_hints == 1)
}

test "a closure result with an unresolved method reports only that method" {
    probe("block_own_local_closure_cascade", "fn take(v: Int) -> Int \{ v }\nfn main() \{\n    let b = Bytes.from_str(\"hi\")\n    let t = async.scope \{ take(async.spawn(fn() \{ let q = b.nope3()  q.addr() }).await) }\n    let v = take(b.with_ptr(fn(_p) \{ let q = b.nope5()  q.addr() }))\n    let w = b.with_ptr(fn(_p) \{ let q = b.nope6()  q.addr() }) + 1\n    let s = async.scope \{ async.spawn(fn() \{ let q = b.nope7()  q.addr() }).await + 1 }\n    let d = b.with_ptr(fn(_p) \{ b.nope8().addr() })\n    let e = d + 1\n    io.println(\"\{t} \{v} \{w} \{s} \{d} \{e}\")\n}\n")
    expect("closure cascade", [
        "UnresolvedMethod E0505 4:59: unresolved method `.nope3` on type Bytes",
        "UnresolvedMethod E0505 5:46: unresolved method `.nope5` on type Bytes",
        "UnresolvedMethod E0505 6:41: unresolved method `.nope6` on type Bytes",
        "UnresolvedMethod E0505 7:54: unresolved method `.nope7` on type Bytes",
        "UnresolvedMethod E0505 8:33: unresolved method `.nope8` on type Bytes",
    ])
}

// The help text of the one FfiScopeNotWithResource error.
fn ffi_scope_help() -> Str {
    for d in diag_entries {
        if d.name == "FfiScopeNotWithResource" { return d.help }
    }
    ""
}

test "an ffi scope inside a block value names the binding that holds it" {
    probe("block_own_local_ffi_inner", "fn main() \{\n    let total = \{\n        let _junk = 1\n        ffi.scope()\n        5\n    }\n    io.println(\"\{total}\")\n}\n")
    let inner = ffi_scope_help()
    probe("block_own_local_ffi_arg", "fn f(x: Int) -> Int \{ x }\nfn main() \{\n    let total = f(\{\n        let _junk = 1\n        ffi.scope()\n        5\n    })\n    io.println(\"\{total}\")\n}\n")
    let arg = ffi_scope_help()
    probe("block_own_local_ffi_tail", "fn main() \{\n    let total = \{\n        let _junk = 1\n        ffi.scope()\n    }\n    io.println(\"x\")\n}\n")
    let tail = ffi_scope_help()
    let ok = inner.contains("as <name>") && arg.contains("as <name>") && tail.contains("as total")
    if !ok { io.println("FAIL: ffi binder: inner `{inner}` arg `{arg}` tail `{tail}`") }
    assert(ok)
}
