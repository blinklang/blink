// A bound's trait arguments are part of the bound (sections/03_types.md §3.6). They are
// resolved and counted where the bound is written, on every binder that carries one, and a
// call meets the bound only when the argument's type implements the trait at those arguments:
// `Pt` with `impl Tr[Int]` does not meet `U: Tr[Str]`. A wrong count is E0910 (§3.4, trait
// references), an unmet bound is E0306 at the call.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}
import compile_test_helpers

fn bound_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

// Everything the probe reported that is not a warning, as `name: message` lines.
fn problems_reported() -> Str {
    let mut out = ""
    for d in diag_entries {
        if d.severity != "warning" { out = out.concat("{d.name}: {d.message}\n") }
    }
    out
}

fn problem_count() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity != "warning" { n = n + 1 }
    }
    n
}

// `Pt` implements `Tr[Int]` and `Plain`; `Bx[T]` implements `Tr[T]` for every `T`.
fn bounded_src(decls: Str, call: Str) -> Str {
    let head = #"type Pt {
    v: Int
}

type Bx[T] {
    t: T
}

trait Tr[T] {
    fn put(self, x: T) -> T
}

trait Plain {
    fn p(self) -> Int
}

trait Other {
    fn o(self) -> Int
}

impl Tr[Int] for Pt {
    fn put(self, x: Int) -> Int {
        x + self.v
    }
}

impl Plain for Pt {
    fn p(self) -> Int {
        self.v
    }
}

impl[T] Tr[T] for Bx[T] {
    fn put(self, x: T) -> T {
        x
    }
}

"#
    head.concat(decls).concat("\n\nfn main() \{\n    let _ = {call}\n}\n")
}

test "a type that implements the trait at other arguments does not meet the bound" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_wrong.bl", bounded_src("fn probe[U: Tr[Str]](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied"), "expected E0306 at the call, got:\n{p}")
    assert(p.contains("Tr[Str]"), "expected the message to name the bound Tr[Str], got:\n{p}")
    assert(p.contains("Tr[Int]"), "expected the message to name the impl Pt has, Tr[Int], got:\n{p}")
}

test "a type that implements the trait at the bound's arguments meets the bound" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_right.bl", bounded_src("fn probe[U: Tr[Int]](u: U) -> Int \{\n    u.put(1)\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p == "", "expected no problems, got:\n{p}")
}

test "a type with no impl of a user trait does not meet its bound" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_noimpl.bl", bounded_src("fn probe[U: Other](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied"), "expected E0306 at the call, got:\n{p}")
    assert(p.contains("Other"), "expected the message to name the trait, got:\n{p}")
}

test "the second of two bounds is checked at its arguments" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_two.bl", bounded_src("fn probe[U: Plain + Tr[Str]](u: U) -> Int \{\n    u.p()\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied"), "expected E0306 at the call, got:\n{p}")
    assert(p.contains("Tr[Str]"), "expected the message to name the bound Tr[Str], got:\n{p}")
}

test "a bound argument naming another type parameter is read at the call's type for it" {
    let decls = "fn probe[V, U: Tr[V]](v: V, u: U) -> Int \{\n    0\n}"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_tv_bad.bl", bounded_src(decls, "probe(\"s\", Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied") && p.contains("Tr[Str]"), "expected E0306 naming Tr[Str] at V = Str, got:\n{p}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_tv_ok.bl", bounded_src(decls, "probe(1, Pt \{ v: 1 })"))
    let q = problems_reported()
    assert(q == "", "expected no problems at V = Int, got:\n{q}")
}

test "a generic impl meets the bound at the instance its arguments give" {
    let decls = "fn probe[U: Tr[Int]](u: U) -> Int \{\n    0\n}"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_poly_ok.bl", bounded_src(decls, "probe(Bx \{ t: 1 })"))
    let p = problems_reported()
    assert(p == "", "expected Bx[Int] to meet Tr[Int], got:\n{p}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_poly_bad.bl", bounded_src(decls, "probe(Bx \{ t: \"s\" })"))
    let q = problems_reported()
    assert(q.contains("TraitBoundNotSatisfied") && q.contains("Tr[Int]"), "expected Bx[Str] not to meet Tr[Int], got:\n{q}")
}

test "a bound that leaves out a generic trait's arguments is a trait arity error" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_bare.bl", bounded_src("fn probe[U: Tr](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Tr` takes 1 type argument(s), 0 were given"), "expected E0910 at the bound, got:\n{p}")
}

test "a bound with too many trait arguments is a trait arity error" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_extra.bl", bounded_src("fn probe[U: Tr[Int, Str]](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Tr` takes 1 type argument(s), 2 were given"), "expected E0910 at the bound, got:\n{p}")
}

test "a bound on a trait with no type parameters given arguments is a trait arity error" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_plain_args.bl", bounded_src("fn probe[U: Plain[Int]](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Plain` takes 0 type argument(s), 1 were given"), "expected E0910 at the bound, got:\n{p}")
}

test "an unknown type in a bound's arguments is reported once without a call through it" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_nope.bl", bounded_src("fn probe[U: Tr[Nope]](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("UnknownType") && p.contains("Nope"), "expected an unknown-type error at Nope, got:\n{p}")
    assert(problem_count() == 1, "expected exactly one problem, got:\n{p}")
}

test "an unknown type nested in a bound's arguments is reported" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_nested.bl", bounded_src("fn probe[U: Tr[List[Nope]]](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("UnknownType") && p.contains("Nope"), "expected an unknown-type error at Nope, got:\n{p}")
}

test "a constructor in a bound's arguments is counted" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_nested_arity.bl", bounded_src("fn probe[U: Tr[List[Int, Str]]](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TypeArgArity") && p.contains("`List`"), "expected E0303 at List[Int, Str], got:\n{p}")
}

test "an impl where-bound's arguments are counted and resolved" {
    let shw = "trait Shw \{\n    fn shw(self) -> Int\n}\n\n"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_where_nope.bl", bounded_src(shw.concat("impl[T] Shw for Bx[T] where T: Tr[Nope] \{\n    fn shw(self) -> Int \{\n        0\n    }\n}"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let p = problems_reported()
    assert(p.contains("UnknownType") && p.contains("Nope"), "expected an unknown-type error at Nope, got:\n{p}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_where_bare.bl", bounded_src(shw.concat("impl[T] Shw for Bx[T] where T: Tr \{\n    fn shw(self) -> Int \{\n        0\n    }\n}"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let q = problems_reported()
    assert(q.contains("TraitContract: trait `Tr` takes 1 type argument(s), 0 were given"), "expected E0910 at the where-bound, got:\n{q}")
}

test "an impl binder's bound arguments are counted and resolved" {
    let shw = "trait Shw \{\n    fn shw(self) -> Int\n}\n\n"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_implb.bl", bounded_src(shw.concat("impl[T: Tr[Nope]] Shw for Bx[T] \{\n    fn shw(self) -> Int \{\n        0\n    }\n}"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let p = problems_reported()
    assert(p.contains("UnknownType") && p.contains("Nope"), "expected an unknown-type error at Nope, got:\n{p}")
}

test "a bound on a trait method's own type parameter is counted" {
    let decls = "trait Q \{\n    fn q[U: Tr](self, u: U) -> Int\n}"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_tmeth.bl", bounded_src(decls, "0"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Tr` takes 1 type argument(s), 0 were given"), "expected E0910 at the bound, got:\n{p}")
}

test "a bound on an impl method's own type parameter is counted" {
    let decls = "trait Q \{\n    fn q[U: Plain](self, u: U) -> Int\n}\n\nimpl Q for Pt \{\n    fn q[U: Tr](self, u: U) -> Int \{\n        0\n    }\n}"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_imeth.bl", bounded_src(decls, "0"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Tr` takes 1 type argument(s), 0 were given"), "expected E0910 at the bound, got:\n{p}")
}

test "a bound on a type declaration's parameter is counted" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bargs_tdecl.bl", bounded_src("type Hold[U: Tr] \{\n    u: U\n}", "0"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Tr` takes 1 type argument(s), 0 were given"), "expected E0910 at the bound, got:\n{p}")
}

// An impl's `where` bound is a bound on the impl's binder: a method call on an instance whose
// argument does not meet it is E0306 at the call, as `unwrap` on a Result whose error type has
// no Debug is (sections/05_memory_compile_errors.md, "Checked at the call").
fn shw_impl(where_clause: Str) -> Str {
    "trait Shw \{\n    fn shw(self) -> Int\n}\n\nimpl[T] Shw for Bx[T] where {where_clause} \{\n    fn shw(self) -> Int \{\n        0\n    }\n}"
}

test "an instance whose argument implements the trait at other arguments does not meet a where-bound" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_wrong.bl", bounded_src(shw_impl("T: Tr[Str]"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied"), "expected E0306 at the call, got:\n{p}")
    assert(p.contains("Tr[Str]") && p.contains("Tr[Int]"), "expected the message to name Tr[Str] and Pt's Tr[Int], got:\n{p}")
}

test "an instance whose argument implements the trait at the where-bound's arguments meets it" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_right.bl", bounded_src(shw_impl("T: Tr[Int]"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let p = problems_reported()
    assert(p == "", "expected no problems, got:\n{p}")
}

test "an instance whose argument has no impl of a user trait does not meet a where-bound" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_noimpl.bl", bounded_src(shw_impl("T: Other"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied") && p.contains("Other"), "expected E0306 naming Other, got:\n{p}")
}

test "the second of two where-bounds is checked at its arguments" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_two.bl", bounded_src(shw_impl("T: Plain + Tr[Str]"), "Bx \{ t: Pt \{ v: 1 } }.shw()"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied") && p.contains("Tr[Str]"), "expected E0306 naming Tr[Str], got:\n{p}")
}

test "a where-bound argument naming another impl binder is read at the instance's type for it" {
    let decls = "type Two[A, B] \{\n    a: A\n    b: B\n}\n\ntrait Shw \{\n    fn shw(self) -> Int\n}\n\nimpl[A, B] Shw for Two[A, B] where A: Tr[B] \{\n    fn shw(self) -> Int \{\n        0\n    }\n}"
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_tv_bad.bl", bounded_src(decls, "Two \{ a: Pt \{ v: 1 }, b: \"s\" }.shw()"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied") && p.contains("Tr[Str]"), "expected E0306 naming Tr[Str] at B = Str, got:\n{p}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_tv_ok.bl", bounded_src(decls, "Two \{ a: Pt \{ v: 1 }, b: 1 }.shw()"))
    let q = problems_reported()
    assert(q == "", "expected no problems at B = Int, got:\n{q}")
}

test "an impl whose where-bound the instance does not meet does not meet a bound on its trait" {
    let decls = shw_impl("T: Tr[Str]").concat("\n\nfn probe[U: Shw](u: U) -> Int \{\n    u.shw()\n}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_where_through.bl", bounded_src(decls, "probe(Bx \{ t: Pt \{ v: 1 } })"))
    let p = problems_reported()
    assert(p.contains("TraitBoundNotSatisfied") && p.contains("Shw"), "expected E0306 naming Shw at the call, got:\n{p}")
}

// A bound names a trait, so a name no trait declares is the impl header's error at the bound.
test "a bound naming no trait is reported where it is written" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bound_undef_fn.bl", bounded_src("fn probe[U: Nonexist](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Nonexist` is not defined"), "expected the undefined-trait error at a fn bound, got:\n{p}")
    assert(problem_count() == 1, "expected exactly one problem, got:\n{p}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bound_undef_impl.bl", bounded_src("trait Shw \{\n    fn shw(self) -> Int\n}\n\nimpl[T: Nonexist] Shw for Bx[T] \{\n    fn shw(self) -> Int \{\n        0\n    }\n}", "0"))
    let q = problems_reported()
    assert(q.contains("TraitContract: trait `Nonexist` is not defined"), "expected the undefined-trait error at an impl binder bound, got:\n{q}")
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bound_undef_where.bl", bounded_src(shw_impl("T: Nonexist"), "0"))
    let r = problems_reported()
    assert(r.contains("TraitContract: trait `Nonexist` is not defined"), "expected the undefined-trait error at a where-bound, got:\n{r}")
}

test "a bound naming a type that is not a trait is reported where it is written" {
    bound_probe("{compile_test_helpers.scratch_root()}/_tc_bound_type_not_trait.bl", bounded_src("fn probe[U: Pt](u: U) -> Int \{\n    0\n}", "probe(Pt \{ v: 1 })"))
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `Pt` is not defined"), "expected the undefined-trait error, got:\n{p}")
}

// The arithmetic and serialization traits have no declaration to find, yet a bound may name them.
test "a bound naming a compiler-known trait with no declaration resolves" {
    for name in ["Add", "Neg", "Serialize", "Deserialize"] {
        bound_probe("{compile_test_helpers.scratch_root()}/_tc_bound_known_{name}.bl", bounded_src("fn probe[U: {name}](u: U) -> Int \{\n    0\n}", "0"))
        let p = problems_reported()
        assert(p == "", "expected `U: {name}` to resolve, got:\n{p}")
    }
}

fn module_probe(path: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    diag_reset()
    check_types(compile_to_program(path, 1))
}

test "a bound reads a trait another module declares, qualified or selected" {
    module_probe("tests/zzwb_bounds/src/main_qualified.bl")
    let p = problems_reported()
    assert(p == "", "expected a qualified bound to resolve, got:\n{p}")
    module_probe("tests/zzwb_bounds/src/main_selected.bl")
    let q = problems_reported()
    assert(q == "", "expected a selected bound to resolve, got:\n{q}")
}

test "a qualified bound naming no trait of that module is reported" {
    module_probe("tests/zzwb_bounds/src/main_qualified_missing.bl")
    let p = problems_reported()
    assert(p.contains("TraitContract: trait `zzwb_traits.ZNope` is not defined"), "expected the undefined-trait error, got:\n{p}")
}

test "a bound naming another module's private trait is reported" {
    module_probe("tests/zzwb_bounds/src/main_qualified_private.bl")
    let p = problems_reported()
    assert(p.contains("PrivateItemAccess") && p.contains("ZHidden"), "expected a private-access error, got:\n{p}")
}

test "a bound naming a trait the import list does not select is reported" {
    module_probe("tests/zzwb_bounds/src/main_unselected.bl")
    let p = problems_reported()
    assert(p.contains("ImportNotSelected") && p.contains("ZOther"), "expected ImportNotSelected naming ZOther, got:\n{p}")
}
