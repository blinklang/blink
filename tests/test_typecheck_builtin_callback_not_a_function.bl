// A value that is not a function is no callback, and the message says which argument wanted one.

import compile_test_helpers

fn rejects(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("{body}\n", tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, want, tag)
}

test "a number or a string is not a callback" {
    rejects("fn main() \{ let _ = [1].map(3) }", "cbn_map", "argument 1 of `List.map` expects Fn(Int)")
    rejects("fn main() \{ let _ = [1].filter(\"x\") }", "cbn_filter", "`List.filter` expects Fn(Int) -> Bool, got Str")
    rejects("fn main() \{ let _ = [1].fold(0, 3) }", "cbn_fold", "argument 2 of `List.fold`")
    rejects("fn main() \{ let _ = [1].sort_by(3) }", "cbn_sort", "`List.sort_by`")
    rejects("fn main() \{ let _ = [1].into_iter().map(3).collect() }", "cbn_it_map", "`Iterator.map`")
}

test "a local that holds no function is not a callback" {
    rejects("fn main() \{\n    let n = 3\n    let _ = [1].map(n)\n}", "cbn_local", "`List.map`")
}
