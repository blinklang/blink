// What a callback returns is part of the method's signature: a predicate returns Bool, a
// fold step returns the accumulator, a flat_map step returns a carrier.

import compile_test_helpers

fn rejects(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let src = "fn gi(x: Int) -> Int \{ x }\nfn gl(x: Int) -> List[Int] \{ [x] }\nfn gt(x: Int) -> Iterator[Int] \{ [x].into_iter() }\nfn gs(a: Int, x: Int) -> Str \{ \"\{a}\{x}\" }\nfn cmpi(a: Int, b: Int) -> Int \{ a + b }\nfn die(x: Int) -> Never \{ panic(\"\{x}\") }\n{body}\n"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, want, tag)
}

test "a predicate must return Bool" {
    rejects("fn main() \{ let _ = [1].filter(gi) }", "cbr_filter", "`List.filter` expects Fn(Int) -> Bool, got Fn(Int) -> Int")
    rejects("fn main() \{ let _ = [1].any(gi) }", "cbr_any", "`List.any` expects Fn(Int) -> Bool")
    rejects("fn main() \{ let _ = [1].all(gi) }", "cbr_all", "`List.all` expects Fn(Int) -> Bool")
    rejects("fn main() \{ let _ = [1].find(gi) }", "cbr_find", "`List.find` expects Fn(Int) -> Bool")
    rejects("fn main() \{ let _ = [1].into_iter().filter(gi).collect() }", "cbr_it_filter", "`Iterator.filter` expects Fn(Int) -> Bool")
}

test "a fold step must return the accumulator" {
    rejects("fn main() \{ let _ = [1].fold(0, gs) }", "cbr_fold", "`List.fold` expects Fn(Int, Int) -> Int")
    rejects("fn main() \{ let _ = [1].into_iter().fold(0, gs) }", "cbr_it_fold", "`Iterator.fold` expects Fn(Int, Int) -> Int")
}

test "a comparator must return Ordering" {
    rejects("fn main() \{ let _ = [1].sort_by(cmpi) }", "cbr_sort", "`List.sort_by` expects Fn(Int, Int) -> Ordering")
}

test "a flat_map step must return the receiver's carrier" {
    rejects("fn main() \{ let _ = [1].flat_map(gi) }", "cbr_flat", "`List.flat_map` expects Fn(Int) -> List[")
    rejects("fn main() \{ let _ = [1].into_iter().flat_map(gi).collect() }", "cbr_it_flat", "`Iterator.flat_map` expects Fn(Int) -> Iterator[")
    rejects("fn main() \{ let _ = [1].flat_map(gt) }", "cbr_flat_iter", "got Fn(Int) -> Iterator[Int]")
    rejects("fn main() \{ let _ = [1].into_iter().flat_map(gl).collect() }", "cbr_it_flat_list", "got Fn(Int) -> List[Int]")
    rejects("fn main() \{ let _ = [1].flat_map(die) }", "cbr_flat_never", "`List.flat_map` expects Fn(Int) -> List[")
}

test "for_each takes a function that returns nothing" {
    rejects("fn main() \{ [1].for_each(gi) }", "cbr_each", "`List.for_each` expects Fn(Int) -> ()")
    rejects("fn main() \{ [1].into_iter().for_each(gi) }", "cbr_it_each", "`Iterator.for_each` expects Fn(Int) -> ()")
}

test "the callback's return sets the map result" {
    rejects("fn main() \{ let _: List[Str] = [1].map(gi) }", "cbr_map", "List[Str]")
}

// sections/03_types.md: "`fn() -> Never` is not a `fn() -> Int`": the subtype does not reach
// through a function type.
test "a function that returns Never does not stand in for another return type" {
    rejects("fn main() \{ let _ = [1].filter(die) }", "cbr_never_filter", "`List.filter` expects Fn(Int) -> Bool")
    rejects("fn main() \{ let _: List[Int] = [1].map(die) }", "cbr_never_map", "List[Never]")
}
