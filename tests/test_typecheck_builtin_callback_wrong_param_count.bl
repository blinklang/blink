// A callback takes as many parameters as the method hands it. A named fn with another count
// has no value to give its extra parameter, and a missing one drops an element.

import compile_test_helpers

fn rejects(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let src = "fn none() -> Int \{ 1 }\nfn one(a: Int) -> Int \{ a }\nfn two(a: Int, b: Int) -> Int \{ a + b }\n{body}\n"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, want, tag)
}

test "map takes one parameter" {
    rejects("fn main() \{ let _ = [1].map(two) }", "cbc_two", "expects 1 parameter, got 2")
    rejects("fn main() \{ let _ = [1].map(none) }", "cbc_none", "expects 1 parameter, got 0")
    rejects("fn main() \{ let _ = [1].into_iter().map(two).collect() }", "cbc_it_two", "expects 1 parameter, got 2")
}

test "fold takes two parameters" {
    rejects("fn main() \{ let _ = [1].fold(0, one) }", "cbc_fold", "expects 2 parameters, got 1")
    rejects("fn main() \{ let _ = [1].into_iter().fold(0, one) }", "cbc_it_fold", "expects 2 parameters, got 1")
}

test "sort_by takes two parameters" {
    rejects("fn main() \{ let _ = [1].sort_by(one) }", "cbc_sort", "expects 2 parameters, got 1")
}
