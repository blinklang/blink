// A closure with no `-> R` takes R from the method's signature (sections/03_types.md), so its
// body answers to that R on the built-ins as it does on a named fn's fn-typed parameter.

import compile_test_helpers

fn rejects(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ {body} }\n", tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, want, tag)
}

test "a predicate's body must be a Bool" {
    rejects("let _ = [1].filter(fn(x) \{ x })", "bcbt_filter", "Bool")
    rejects("let _ = [1].any(fn(x) \{ x })", "bcbt_any", "Bool")
    rejects("let _ = [1].all(fn(x) \{ x })", "bcbt_all", "Bool")
    rejects("let _ = [1].find(fn(x) \{ \"s\" })", "bcbt_find", "Bool")
    rejects("let _ = [1].into_iter().filter(fn(x) \{ x }).collect()", "bcbt_it_filter", "Bool")
    rejects("let _ = [1].into_iter().any(fn(x) \{ x })", "bcbt_it_any", "Bool")
    rejects("let _ = [1].into_iter().all(fn(x) \{ x })", "bcbt_it_all", "Bool")
    rejects("let _ = [1].into_iter().find(fn(x) \{ x })", "bcbt_it_find", "Bool")
}

test "a return in a predicate must be a Bool" {
    rejects("let _ = [1].filter(fn(x) \{ return x })", "bcbt_filter_ret", "Bool")
}

test "a fold's body must be the accumulator" {
    rejects("let _ = [1].fold(0, fn(a, x) \{ \"s\" })", "bcbt_fold", "Str")
    rejects("let _ = [1].into_iter().fold(0, fn(a, x) \{ \"s\" })", "bcbt_it_fold", "Str")
    rejects("let _ = [1].into_iter().fold(0, fn(a, x) -> Str \{ \"s\" })", "bcbt_it_fold_ann", "Str")
}

test "Int is not Bool in a closure of a predicate or a fold" {
    rejects("let _ = [1].filter(fn(x) -> Int \{ x })", "bcbt_filter_ann", "must return Bool, got Int")
    rejects("let _ = [1].filter(fn(x) \{ x })", "bcbt_filter_label", "closure of `List.filter` must return Bool, got Int")
    rejects("let _ = [1].any(fn(x) \{ x })", "bcbt_any_label", "closure of `List.any` must return Bool, got Int")
    rejects("let _ = [1].fold(false, fn(a, x) \{ x })", "bcbt_fold_bool", "closure of `List.fold` must return Bool, got Int")
    rejects("let _ = [1].fold(0, fn(a, x) \{ x > 0 })", "bcbt_fold_int", "closure of `List.fold` must return Int, got Bool")
    rejects("let _ = [1].filter(fn(x: Bool) \{ true })", "bcbt_param", "expects Int, got Bool")
    rejects("let _ = [1].fold(false, fn(a: Int, x) \{ false })", "bcbt_fold_param", "expects Bool, got Int")
}

test "the error names the method that holds the closure" {
    rejects("let _ = [1].filter(fn(x) \{ x })", "bcbt_label_filter", "closure of `List.filter` must return Bool, got Int")
    rejects("let _ = [1].filter(fn(x) \{ return x })", "bcbt_label_filter_ret", "closure of `List.filter` must return Bool, got Int")
    rejects("let _ = [1].fold(false, fn(a, x) \{ return x })", "bcbt_label_fold_ret", "closure of `List.fold` must return Bool, got Int")
    rejects("let _ = [1].fold(0, fn(a, x) \{ \"s\" })", "bcbt_label_fold_str", "closure of `List.fold` must return Int, got Str")
    rejects("let _ = [1].into_iter().find(fn(x) \{ \"s\" })", "bcbt_label_it_find", "closure of `Iterator.find` must return Bool, got Str")
}

test "a closure inside a held closure does not take the method's name" {
    rejects("let _ = [1].filter(fn(x) \{\n    let f: fn(Int) -> Bool = fn(y) \{ y }\n    f(x)\n})", "bcbt_label_inner", "function `closure` return type Bool")
}

test "a handler clause inside a held closure keeps its own name" {
    let out = compile_test_helpers.compile_and_capture("effect M \{ effect E \{ fn op() -> Bool } }\nfn main() \{\n    let _ = [1].filter(fn(x) \{\n        let _h = handler M \{\n            fn op() -> Bool \{ 1 }\n        }\n        x > 0\n    })\n}\n", "bcbt_label_handler")
    compile_test_helpers.expect_contains(out, "function `op` return type Bool", "bcbt_label_handler")
}

test "a comparator's body must be an Ordering" {
    rejects("let _ = [1].sort_by(fn(a, b) \{ 1 })", "bcbt_sort", "Ordering")
}

test "for_each gives an annotated result nowhere to go" {
    rejects("[1].for_each(fn(x) -> Int \{ x })", "bcbt_each_ann", "Int")
    rejects("[1].into_iter().for_each(fn(x) -> Int \{ x })", "bcbt_it_each_ann", "Int")
}
