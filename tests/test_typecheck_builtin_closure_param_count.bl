// A closure literal is held to the parameter count of the method it goes to, as a named fn is.
// One report: an extra parameter has no hint, and must not also read as E0301.

import compile_test_helpers

fn rejects(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ {body} }\n", tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, want, tag)
    assert(!out.contains("E0301"), "{tag}: a second report: {out}")
}

test "the one-element methods of List take one parameter" {
    rejects("let _ = [1].map(fn(a, b) \{ a })", "bcpc_map2", "expects 1 parameter, got 2")
    rejects("let _ = [1].map(fn() \{ 1 })", "bcpc_map0", "expects 1 parameter, got 0")
    rejects("let _ = [1].filter(fn(a, b) \{ true })", "bcpc_filter2", "expects 1 parameter, got 2")
    rejects("let _ = [1].any(fn() \{ true })", "bcpc_any0", "expects 1 parameter, got 0")
    rejects("let _ = [1].all(fn(a, b) \{ true })", "bcpc_all2", "expects 1 parameter, got 2")
    rejects("let _ = [1].find(fn() \{ true })", "bcpc_find0", "expects 1 parameter, got 0")
    rejects("let _ = [1].flat_map(fn(a, b) \{ [a] })", "bcpc_flat2", "expects 1 parameter, got 2")
    rejects("[1].for_each(fn(a, b) \{ })", "bcpc_each2", "expects 1 parameter, got 2")
}

test "the one-element methods of Iterator take one parameter" {
    rejects("let _ = [1].into_iter().map(fn(a, b) \{ a }).collect()", "bcpc_it_map2", "expects 1 parameter, got 2")
    rejects("let _ = [1].into_iter().filter(fn() \{ true }).collect()", "bcpc_it_filter0", "expects 1 parameter, got 0")
    rejects("let _ = [1].into_iter().any(fn(a, b) \{ true })", "bcpc_it_any2", "expects 1 parameter, got 2")
    rejects("let _ = [1].into_iter().find(fn() \{ true })", "bcpc_it_find0", "expects 1 parameter, got 0")
    rejects("let _ = [1].into_iter().flat_map(fn() \{ [1].into_iter() }).collect()", "bcpc_it_flat0", "expects 1 parameter, got 0")
    rejects("[1].into_iter().for_each(fn(a, b) \{ })", "bcpc_it_each2", "expects 1 parameter, got 2")
}

test "fold takes two parameters" {
    rejects("let _ = [1].fold(0, fn(a) \{ a })", "bcpc_fold1", "expects 2 parameters, got 1")
    rejects("let _ = [1].fold(0, fn(a, b, c) \{ a })", "bcpc_fold3", "expects 2 parameters, got 3")
    rejects("let _ = [1].into_iter().fold(0, fn(a) \{ a })", "bcpc_it_fold1", "expects 2 parameters, got 1")
}

test "sort_by takes two parameters" {
    rejects("let _ = [1].sort_by(fn(a) \{ a.cmp(a) })", "bcpc_sort1", "expects 2 parameters, got 1")
    rejects("let _ = [1].sort_by(fn(a, b, c) \{ a.cmp(b) })", "bcpc_sort3", "expects 2 parameters, got 3")
}

test "a closure given as a keyword argument is held the same" {
    rejects("let _ = [1].map(f: fn(a, b) \{ a })", "bcpc_kw_map", "expects 1 parameter, got 2")
    rejects("let _ = [1].fold(0, f: fn(a) \{ a })", "bcpc_kw_fold", "expects 2 parameters, got 1")
}

test "with_ptr takes one parameter" {
    rejects("let _ = Bytes.new().with_ptr(fn() \{ 1 })", "bcpc_ptr0", "expects 1 parameter, got 0")
}
