// The closure of `flat_map` returns the receiver's own carrier: `fn(T) -> List[U]` on a List,
// `fn(T) -> Iterator[U]` on an Iterator (sections/03_types.md, sections/03c_protocols.md).

import compile_test_helpers

fn rejects(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ {body} }\n", tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, want, tag)
    assert(!out.contains("UnresolvedMethod"), "{tag}: a second report: {out}")
}

test "a List's flat_map closure returns a List" {
    rejects("let _ = [1].flat_map(fn(x) \{ x })", "bfmc_val", "`List.flat_map` must return a List, got Int")
    rejects("let _ = [1].flat_map(fn(x) \{ [x].into_iter() })", "bfmc_iter", "`List.flat_map` must return a List, got Iterator[Int]")
    rejects("let _ = [1].flat_map(fn(x) -> Iterator[Int] \{ [x].into_iter() })", "bfmc_iter_ann", "`List.flat_map` must return a List, got Iterator[Int]")
    rejects("let _ = [1].flat_map(fn(x) -> Int \{ x })", "bfmc_val_ann", "`List.flat_map` must return a List, got Int")
}

test "an Iterator's flat_map closure returns an Iterator" {
    rejects("let _ = [1].into_iter().flat_map(fn(x) \{ x }).collect()", "bfmc_it_val", "`Iterator.flat_map` must return an Iterator, got Int")
    rejects("let _ = [1].into_iter().flat_map(fn(x) \{ [x] }).collect()", "bfmc_it_list", "`Iterator.flat_map` must return an Iterator, got List[Int]")
    rejects("let _ = [1].into_iter().flat_map(fn(x) -> List[Int] \{ [x] }).collect()", "bfmc_it_list_ann", "`Iterator.flat_map` must return an Iterator, got List[Int]")
}
