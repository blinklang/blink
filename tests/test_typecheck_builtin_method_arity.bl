// A builtin method has no fnsig, so nothing counted the arguments a caller wrote: the count
// is implicit in which `if method ==` arm runs inside infer_type_uncached. Extra arguments
// were discarded in silence and a missing one reached codegen, which reads an argument that
// is not there.
//
// docs/codegen-rewrite/builtin_method_arity.md is the survey these rows enforce. Two of its
// findings are what the rows below are shaped around: no index is optional, because the
// language has neither default parameters nor variadics; and three arms cover methods whose
// counts differ, so the count belongs to the method name and not to the arm.
import lower_test_helpers.{probe, probe_but, assert_eq_str}
import diagnostics.{diag_entries}

fn list_len_extra_src() -> Str {
    #"fn main() {
    let xs = [1, 2, 3]
    io.println("{xs.len(1, 2, 3)}")
}
"#
}

fn str_len_extra_src() -> Str {
    #"fn main() {
    let n = "abc".len(9)
    io.println("{n}")
}
"#
}

fn sb_clear_extra_src() -> Str {
    #"fn main() {
    let sb = StringBuilder()
    sb.clear(1)
}
"#
}

fn template_count_extra_src() -> Str {
    #"pub effect Tpl {
    effect Run {
        fn run(t: Template[Tpl]) -> Int
    }
}

fn peek(t: Template[Tpl]) -> Int {
    t.count(1, 2, 3)
}

fn main() {
    let n = 1
    io.println("{n}")
}
"#
}

fn list_get_short_src() -> Str {
    #"fn main() {
    let xs = [1, 2, 3]
    let hit = xs.get()
    io.println("{hit.unwrap()}")
}
"#
}

// Int.abs takes nothing and Int.min takes one, and both live in the same `if method ==`
// arm. One count forced on that arm would reject one of these two.
fn int_abs_and_min_src() -> Str {
    #"fn main() {
    let n = 7
    let a = n.abs()
    let b = n.min(3)
    io.println("{a} {b}")
}
"#
}

// The sized-int wrapping family is the second such arm: wrapping_neg takes nothing, the
// other five take one.
fn wrapping_both_forms_src() -> Str {
    #"fn main() {
    let u: U8 = 250
    let v: U8 = 5
    let w = u.wrapping_neg()
    let y = u.wrapping_add(v)
    io.println("{w} {y}")
}
"#
}

fn well_formed_calls_src() -> Str {
    #"fn main() {
    let xs = [1, 2, 3]
    let sb = StringBuilder()
    sb.clear()
    io.println("{xs.len()} {"abc".len()} {sb.len()}")
}
"#
}

test "a nullary List method refuses extra arguments" {
    let program = probe_but("arity_list_len_extra", list_len_extra_src(), "TypeError")
    assert(program >= 0)
}

test "the refusal counts what was written and what was wanted" {
    let program = probe_but("arity_list_len_message", list_len_extra_src(), "TypeError")
    assert(program >= 0)
    let mut msg = ""
    for d in diag_entries {
        if d.name == "TypeError" { msg = d.message }
    }
    assert_eq_str("message", msg, "method `List.len` expects 0 argument(s), got 3")
}

test "a nullary Str method refuses an extra argument" {
    let program = probe_but("arity_str_len_extra", str_len_extra_src(), "TypeError")
    assert(program >= 0)
}

test "a nullary StringBuilder method refuses an argument" {
    let program = probe_but("arity_sb_clear_extra", sb_clear_extra_src(), "TypeError")
    assert(program >= 0)
}

test "a nullary Template method refuses extra arguments" {
    let program = probe_but("arity_template_count_extra", template_count_extra_src(), "TypeError")
    assert(program >= 0)
}

test "a call with too few arguments is refused as well" {
    let program = probe_but("arity_list_get_short", list_get_short_src(), "TypeError")
    assert(program >= 0)
}

test "both counts in the abs/min arm are kept" {
    let program = probe("arity_int_abs_and_min", int_abs_and_min_src())
    assert(program >= 0)
}

test "both counts in the wrapping arm are kept" {
    let program = probe("arity_wrapping_both_forms", wrapping_both_forms_src())
    assert(program >= 0)
}

test "the well-formed calls still pass" {
    let program = probe("arity_well_formed", well_formed_calls_src())
    assert(program >= 0)
}
