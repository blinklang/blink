// `Bytes.with_ptr` is `fn[R](self, fn(Ptr[U8]) -> R ! _) -> R ! _`: a named fn is checked against
// that type, and the call has the fn's R, not Void.

import compile_test_helpers

test "a named fn of the wrong type is E0300" {
    let src = "fn f(s: Str) -> Int \{ s.len() }\nfn main() \{ let _ = Bytes.new().with_ptr(f) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "bwpn_param")
    compile_test_helpers.expect_error(out, "E0300", "bwpn_param")
    compile_test_helpers.expect_contains(out, "argument 1 of `Bytes.with_ptr`", "bwpn_param")
}

test "a value that is not a fn is E0300" {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let _ = Bytes.new().with_ptr(1) }\n", "bwpn_int")
    compile_test_helpers.expect_error(out, "E0300", "bwpn_int")
}

test "the call has the fn's result" {
    let src = "@trusted(audit: \"A\")\nfn f(p: Ptr[U8]) -> Str \{ \"s\" }\n@trusted(audit: \"A\")\nfn g() -> Int \{ Bytes.new().with_ptr(f) }\nfn main() \{ }\n"
    let out = compile_test_helpers.compile_and_capture(src, "bwpn_ret")
    compile_test_helpers.expect_error(out, "E0300", "bwpn_ret")
    compile_test_helpers.expect_contains(out, "Str", "bwpn_ret")
}
