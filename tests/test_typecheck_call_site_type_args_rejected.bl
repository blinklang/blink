// Brackets after a callee are its type-argument list (03_types.md:1297), so a call that
// writes them checks clean. A value in the brackets is NoIndexOperator (03_types.md §3.4),
// and a list the callee has no parameters for is rejected before codegen.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, TypeCheck}
import diagnostics.{diag_entries, diag_reset, diag_explain, TYPE_ARG_ARITY, TYPE_ARGS_WITHOUT_CALL, Diag}
import std.io
import lexer.{Lex}
import parser.{Parse}

fn typecheck_probe(path: Str, src: Str) ! FS, Env.Exit, Env.Read, IO {
    with handler Diag {}, handler Lex {}, handler Parse {}, handler TypeCheck {} {
        fs.write(path, src).unwrap()
        diag_reset()
        let program = compile_to_program(path, 1)
        check_types(program)
        let _ = fs.delete(path)
    }
}

fn error_messages() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    out
}

fn count_named(name: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            if d.name == name { n = n + 1 }
        }
    }
    n
}

// Someone who wrote brackets after a value meant indexing, so each of these diagnostics must
// name the repair that exists for that: element access through `.get(...)`.
fn help_of(name: Str) -> Str {
    for d in diag_entries {
        if d.name == name { return d.help }
    }
    ""
}

fn notes_of(name: Str) -> Str {
    for d in diag_entries {
        if d.name == name { return d.notes.join("\n") }
    }
    ""
}

fn report(label: Str) ! IO.Print {
    let errs = error_messages()
    if errs.len() != 0 {
        io.println("  [{label}] diagnostics:")
        for e in errs { io.println("    {e}") }
    }
}

test "a method call carrying bracketed type arguments is accepted" {
    typecheck_probe("build/tc_cs_targs_method.bl", #"import blink.ffi
fn main() {
    with ffi.scope() as scope {
        let p: Ptr[U8] = scope.alloc[U8]()
        let _ = p
    }
}
"#)
    report("method")
    assert(error_messages().len() == 0)
}

test "a free function call carrying bracketed type arguments is accepted" {
    typecheck_probe("build/tc_cs_targs_free.bl", #"fn make[T]() -> Int { 0 }
fn main() {
    let v = make[Int]()
    let _ = v
}
"#)
    report("free fn")
    assert(error_messages().len() == 0)
}

test "the same call typed from its annotation instead is accepted" {
    typecheck_probe("build/tc_cs_targs_annotated.bl", #"import blink.ffi
fn main() {
    with ffi.scope() as scope {
        let p: Ptr[U8] = scope.alloc()
        let _ = p
    }
}
"#)
    report("annotated")
    assert(count_named("TypeArgArity") == 0)
    assert(error_messages().len() == 0)
}

test "a literal in call brackets is NoIndexOperator with a note that names .get" {
    typecheck_probe("build/tc_cs_targs_index.bl", #"fn a() -> Int { 1 }
fn b() -> Int { 2 }
fn main() {
    let fns: List[fn() -> Int] = [a, b]
    let v = fns[0]()
    let _ = v
}
"#)
    report("index call")
    assert(count_named("NoIndexOperator") == 1)
    assert(error_messages().len() == 1)
    assert(notes_of("NoIndexOperator").contains("`fns.get(0)` returns an `Option`"))
}

test "a type name in call brackets names the type even when a local shadows it" {
    typecheck_probe("build/tc_cs_targs_shadow.bl", #"type Slot { n: Int }
fn a() -> Int { 1 }
fn main() {
    let Slot = 0
    let fns: List[fn() -> Int] = [a]
    let v = fns[Slot]()
    let _ = v
}
"#)
    report("shadowed type name")
    assert(count_named("TypeArgArity") == 1)
    assert(count_named("UnknownType") == 0)
    assert(help_of("TypeArgArity").contains("`.get("))
}

test "the retired code's explanation names the codes that replace it" {
    let text = diag_explain("E0307")
    assert(text.contains("retired"))
    assert(text.contains("TypeArgArity (E0303)"))
    assert(text.contains("NoIndexOperator (E0313)"))
    assert(text.contains("TypeArgsWithoutCall (E0314)"))
}

test "the explanations of E0303 and E0314 describe a list at a call" {
    let arity = diag_explain(TYPE_ARG_ARITY)
    assert(arity.contains("At a call head"))
    assert(arity.contains("decode[Forecast, Str](body)"))
    let no_call = diag_explain(TYPE_ARGS_WITHOUT_CALL)
    assert(no_call.contains("let f = identity[Int]"))
}
