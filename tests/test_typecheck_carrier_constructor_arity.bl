// A prelude carrier constructor called with the wrong number of arguments is
// VariantArgumentCount (E0321) from typecheck, with the same wording as a user enum variant of
// the wrong arity (sections/03_types.md §3.4). Some, Ok and Err take one argument, None takes
// none. `Ok` takes one at every success type, so `Ok()` is a count error at `()` too, with the
// fix `Ok(())` there. The bare and the qualified spelling are typed by one path, so each is
// checked here. Every row also builds, so a program that typecheck lets through never reaches
// codegen as an internal error.

import compile_test_helpers

// A whole program. Every row also builds, so none may reach codegen as an internal error.
fn expect_program_error(src: Str, tag: Str, msg: Str) ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0321", tag)
    compile_test_helpers.expect_contains(out, msg, "{tag} names the variant and counts")
    assert(!out.contains("\"severity\":\"ice\""))
}

fn expect_program_ok(src: Str, tag: Str) ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_compiles_clean(out, tag)
    assert(!out.contains("\"severity\":\"ice\""))
}

fn expect_arity_error(body: Str, tag: Str, msg: Str) ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read, IO.Print {
    expect_program_error("fn main() \{\n{body}\n\}\n", tag, msg)
}

fn expect_arity_ok(body: Str, tag: Str) ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read, IO.Print {
    expect_program_ok("fn main() \{\n{body}\n\}\n", tag)
}

test "None with an argument is rejected" {
    expect_arity_error("    let o: Option[Int] = None(1)\n    let _ = o", "carrier_arity_none_1", "variant `None` takes no arguments, got 1")
}

test "Some with no argument is rejected" {
    expect_arity_error("    let o: Option[Int] = Some()\n    let _ = o", "carrier_arity_some_0", "variant `Some` takes 1 argument, got 0")
}

test "Some with two arguments is rejected" {
    expect_arity_error("    let o: Option[Int] = Some(1, 2)\n    let _ = o", "carrier_arity_some_2", "variant `Some` takes 1 argument, got 2")
}

test "Err with no argument is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Err()\n    let _ = r", "carrier_arity_err_0", "variant `Err` takes 1 argument, got 0")
}

test "Err with two arguments is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Err(\"a\", \"b\")\n    let _ = r", "carrier_arity_err_2", "variant `Err` takes 1 argument, got 2")
}

test "Ok with two arguments under a non-unit payload is rejected with the count that payload takes" {
    expect_arity_error("    let r: Result[Int, Str] = Ok(1, 2)\n    let _ = r", "carrier_arity_ok_2", "variant `Ok` takes 1 argument, got 2")
}

test "Ok with two arguments under a unit payload is rejected with both counts" {
    expect_arity_error("    let r: Result[(), Str] = Ok(1, 2)\n    let _ = r", "carrier_arity_ok_2_unit", "variant `Ok` takes 1 argument, got 2")
}

test "qualified Option.None with an argument is rejected" {
    expect_arity_error("    let o: Option[Int] = Option.None(1)\n    let _ = o", "carrier_arity_q_none_1", "variant `None` takes no arguments, got 1")
}

test "qualified Option.Some with no argument is rejected" {
    expect_arity_error("    let o: Option[Int] = Option.Some()\n    let _ = o", "carrier_arity_q_some_0", "variant `Some` takes 1 argument, got 0")
}

test "qualified Option.Some with two arguments is rejected" {
    expect_arity_error("    let o: Option[Int] = Option.Some(1, 2)\n    let _ = o", "carrier_arity_q_some_2", "variant `Some` takes 1 argument, got 2")
}

test "qualified Result.Err with no argument is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Result.Err()\n    let _ = r", "carrier_arity_q_err_0", "variant `Err` takes 1 argument, got 0")
}

test "qualified Result.Err with two arguments is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Result.Err(\"a\", \"b\")\n    let _ = r", "carrier_arity_q_err_2", "variant `Err` takes 1 argument, got 2")
}

test "qualified Result.Ok with two arguments is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Result.Ok(1, 2)\n    let _ = r", "carrier_arity_q_ok_2", "variant `Ok` takes 1 argument, got 2")
}

test "carrier constructors of the right arity compile clean" {
    expect_arity_ok("    let a: Option[Int] = Some(1)\n    let b: Option[Int] = None\n    let c: Result[Int, Str] = Ok(1)\n    let d: Result[(), Str] = Ok(())\n    let e: Result[Int, Str] = Err(\"x\")\n    let _ = (a, b, c, d, e)", "carrier_arity_bare_ok")
    expect_arity_ok("    let a: Option[Int] = Option.Some(1)\n    let b: Option[Int] = Option.None\n    let c: Result[Int, Str] = Result.Ok(1)\n    let d: Result[(), Str] = Result.Ok(())\n    let e: Result[Int, Str] = Result.Err(\"x\")\n    let _ = (a, b, c, d, e)", "carrier_arity_qualified_ok")
}

test "Ok with no argument under a non-unit payload is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Ok()\n    let _ = r", "carrier_arity_ok_0_int", "variant `Ok` takes 1 argument, got 0")
}

test "qualified Result.Ok with no argument under a non-unit payload is rejected" {
    expect_arity_error("    let r: Result[Int, Str] = Result.Ok()\n    let _ = r", "carrier_arity_q_ok_0_int", "variant `Ok` takes 1 argument, got 0")
}

test "Ok with no argument as a non-unit return is rejected" {
    let src = "fn f() -> Result[Int, Str] \{ Ok() \}\nfn main() \{ let _ = f() \}\n"
    expect_program_error(src, "carrier_arity_ok_0_return", "variant `Ok` takes 1 argument, got 0")
}

test "Ok with no argument under a generic payload is rejected" {
    let src = "fn g[T](x: T) -> Result[T, Str] \{\n    let _ = x\n    Ok()\n\}\nfn main() \{ let _ = g(1) \}\n"
    expect_program_error(src, "carrier_arity_ok_0_generic", "variant `Ok` takes 1 argument, got 0")
}

// A rejected term gives the binding no type, so a later use reports nothing more.
test "Ok with no argument and no expected type is the count error only" {
    let src = "fn main() \{\n    let r = Ok()\n    let s: Result[Int, Str] = r\n    let _ = s\n\}\n"
    let tag = "carrier_arity_ok_0_later_use"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0321", tag)
    compile_test_helpers.expect_contains(out, "variant `Ok` takes 1 argument, got 0", "{tag} names the variant and counts")
    assert(!out.contains("\"code\":\"E0300\""), out)
    assert(!out.contains("\"code\":\"E0301\""), out)
    assert(!out.contains("\"fix\":"), out)
}

test "Some and Err with no argument under a generic payload are rejected" {
    let some_src = "fn g[T](x: T) -> Option[T] \{\n    let _ = x\n    Some()\n\}\nfn main() \{ let _ = g(1) \}\n"
    expect_program_error(some_src, "carrier_arity_some_0_generic", "variant `Some` takes 1 argument, got 0")
    let err_src = "fn g[T](x: T) -> Result[Int, T] \{\n    let _ = x\n    Err()\n\}\nfn main() \{ let _ = g(1) \}\n"
    expect_program_error(err_src, "carrier_arity_err_0_generic", "variant `Err` takes 1 argument, got 0")
}

test "Ok with no argument at the success type unit is rejected" {
    expect_arity_error("    let a: Result[(), Str] = Ok()\n    let b = Ok(())\n    let c = if a.is_ok() \{ a \} else \{ b \}\n    let _ = c", "carrier_arity_ok_0_is_unit", "variant `Ok` takes 1 argument, got 0")
    expect_program_error("fn f() -> Result[(), Str] \{ Ok() \}\nfn main() \{ let _ = f() \}\n", "carrier_arity_ok_0_unit_return", "variant `Ok` takes 1 argument, got 0")
}

test "Ok of unit, annotated or not, is one type, and a unit success return builds" {
    expect_arity_ok("    let a: Result[(), Str] = Ok(())\n    let b = Ok(())\n    let c = if a.is_ok() \{ a \} else \{ b \}\n    let _ = c", "carrier_arity_ok_unit_is_one_type")
    expect_program_ok("fn f() -> Result[(), Str] \{ Ok(()) \}\nfn main() \{ let _ = f() \}\n", "carrier_arity_ok_unit_return")
}

test "Ok with no argument under an expectation that already names its error side is rejected" {
    let src = "fn main() \{\n    let mut r = Ok(5)\n    r = Ok()\n    let _: Result[Int, Str] = r\n\}\n"
    expect_program_error(src, "carrier_arity_ok_0_open_err", "variant `Ok` takes 1 argument, got 0")
}

test "Ok with no argument in an if branch under a non-unit payload is rejected" {
    let src = "fn main() \{\n    let r: Result[Int, Str] = if true \{ Ok() \} else \{ Err(\"x\") \}\n    let _ = r\n\}\n"
    expect_program_error(src, "carrier_arity_ok_0_if_branch", "variant `Ok` takes 1 argument, got 0")
}

// The expected type of a block's tail is not the expected type of a `let` inside the block, so
// the `let`'s own unit success type gives each `Ok()` the fix.
test "Ok with no argument at a let of unit success inside a block under a non-unit tail gets the fix" {
    let src = "fn check(r: Result[(), Str]) -> Bool \{ r.is_ok() \}\nfn f() -> Result[Int, Str] \{\n    let u: Result[(), Str] = Ok()\n    if check(u) \{ Ok(1) \} else \{ Err(\"e\") \}\n\}\nfn main() \{\n    let s: Result[Int, Str] = \{\n        let u: Result[(), Str] = Ok()\n        if check(u) \{ Ok(2) \} else \{ Err(\"e\") \}\n    \}\n    let _ = (f(), s)\n\}\n"
    let tag = "carrier_arity_ok_0_let_in_block"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0321", tag)
    assert_eq(out.split("\"fix\":\{\"action\":\"write `Ok(())`\"").len() - 1, 2)
    assert(!out.contains("\"severity\":\"ice\""))
}

// The enclosing value's success type is Int, so it gives no fix. A `==` with a unit success
// on its other side gives the fix, since `Ok(())` is what that comparison takes.
test "Ok with no argument as a scrutinee or a condition takes no expectation from the enclosing value" {
    let srcs = [
        "fn main() \{\n    let r: Result[Int, Str] = match Ok() \{\n        Ok(_) => Ok(1)\n        Err(e) => Err(e)\n    \}\n    let _ = r\n\}\n",
        "fn mk() -> Result[(), Str] \{ Ok(()) \}\nfn main() \{\n    let r: Result[Int, Str] = if Ok() == mk() \{ Ok(1) \} else \{ Err(\"e\") \}\n    let _ = r\n\}\n",
    ]
    let mut i = 0
    for src in srcs {
        let tag = "carrier_arity_ok_0_not_hinted_{i}"
        let out = compile_test_helpers.compile_and_capture(src, tag)
        compile_test_helpers.expect_contains(out, "variant `Ok` takes 1 argument, got 0", tag)
        assert_eq(out.contains("\"fix\":\{\"action\":\"write `Ok(())`\""), i == 1)
        assert(!out.contains("\"severity\":\"ice\""))
        i = i + 1
    }
}
