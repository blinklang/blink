// A later stage deciding what the left of a dot names asks typecheck, through the pub
// register of type names. `Char` has no Blink declaration, so a register built from the
// declared types alone answers no for it, and a call on it classifies as a call on a VALUE:
// the bare name `Char` is then asked for its own type, which it does not have, and the
// report blames typecheck for not stamping a node that was never an expression.
//
// So the register has to answer for the types the compiler provides as well as the ones a
// program declares. These rows pin that answer for Char and the type the call it enables
// produces.
import lower_test_helpers.{probe, rhs_of, assert_eq_str}
import typecheck.{tc_names_a_type, tc_lookup_node_tid, tc_resolve, tc_type_str}
import std.io

fn from_code_point_src() -> Str {
    #"fn main() {
    let c = Char.from_code_point(65)
    assert(c.is_ok())
}
"#
}

test "the register of type names answers for a type the compiler provides" {
    assert(tc_names_a_type("Char"))
}

test "the register still answers for a declared type and still refuses a bare word" {
    assert(tc_names_a_type("Str"))
    assert(!tc_names_a_type("Charcoal"))
}

// A code point out of range has no character to answer with, so the call answers a
// Result and the caller reads which it got. The row pins the whole carrier: a bare
// `Char` here would let a program drop the failure without saying so.
test "a static call on the provided type is typed as the carrier it answers" {
    let _p = probe("char_from_code_point", from_code_point_src())
    let tid = tc_lookup_node_tid(rhs_of("c"))
    if tid < 0 { io.println("FAIL: Char.from_code_point(65) has no recorded type") }
    assert(tid >= 0)
    assert_eq_str("Char.from_code_point(65)", tc_type_str(tc_resolve(tid)), "Result[Char, ConversionError]")
}
