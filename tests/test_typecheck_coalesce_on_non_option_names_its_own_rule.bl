// sections/02_syntax.md:53 — `??` is Option defaulting: `val ?? default` desugars to a match
// on Some/None. A left operand that is not an Option has no Some/None to match, so the
// operator does not apply, and typecheck already refused it.
//
// What it did not do is say WHICH rule refused it. The refusal went out as the catch-all
// TypeError, while the diagnostic index has carried E0513 CoalesceRequiresOption — with
// explain text a reader can run `blink explain E0513` against — since before this test. A
// code that names no diagnostic is a promise the tool does not keep, and a reader who looks
// up the message finds the general type-error page instead of the rule they broke.
//
// This changes no program's acceptance. The same sources are refused; only the name and the
// help text a reader sees are the rule's own.
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import std.io

// The diagnostic names a source draws, joined, so a row can state the whole answer rather
// than assert that one entry is present somewhere among others.
fn probe_diag_names(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    env.set_var("BLINK_ROOT", process_run("pwd", []).out.trim())
    let path = "build/{stem}_probe.bl"
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process_run("rm", ["-f", path])
    let mut out = ""
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out = "{out}{d.name} " }
    }
    out.trim()
}

fn int_left_src() -> Str {
    #"fn main() {
    let x = 5
    let y = x ?? 9
    io.println("{y}")
}
"#
}

fn option_left_src() -> Str {
    #"fn main() {
    let xs = [1, 2, 3]
    let y = xs.get(0) ?? 9
    io.println("{y}")
}
"#
}

fn assert_names(label: Str, got: Str, want: Str) {
    if got != want { io.println("FAIL: {label}: drew '{got}', want '{want}'") }
    assert(got == want)
}

test "a non-Option left operand of '??' is refused under the coalesce rule's own code" {
    assert_names("Int left", probe_diag_names("tc_coalesce_int", int_left_src()),
        "CoalesceRequiresOption")
}

// The rule's acceptance is unchanged: an Option left operand is what `??` is for.
test "an Option left operand of '??' is accepted" {
    assert_names("Option left", probe_diag_names("tc_coalesce_opt", option_left_src()), "")
}
