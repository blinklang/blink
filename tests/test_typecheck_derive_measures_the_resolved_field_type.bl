// What @derive checks a field against is the type the field's name resolves to, not the
// name itself. An alias stands for its target everywhere else in the type system, so a
// field written as an alias of a derivable type derives, and one written as an alias of
// a type the trait rejects is still rejected. The message names what the author wrote,
// because that is the text they can change.

import lower_test_helpers.{probe, probe_but}
import diagnostics.{diag_entries}

fn src_alias_of_derivable() -> Str {
    #"type Id = Int
@derive(Eq)
type Rec { i: Id }
fn main() { }
"#
}

fn src_alias_of_rejected() -> Str {
    #"type Names = List[Str]
@derive(Eq)
type Rec { n: Names }
fn main() { }
"#
}

fn src_opaque_handle() -> Str {
    #"@derive(Eq)
@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
fn main() { }
"#
}

// The message for the most recent E1401, or "".
fn last_non_derivable_message() -> Str {
    let mut found = ""
    let mut i = 0
    while i < diag_entries.len() {
        let d = diag_entries.get(i).unwrap()
        if d.code == "E1401" { found = d.message }
        i = i + 1
    }
    found
}

test "a field whose type is an alias of a derivable type is accepted" {
    let _p = probe("tc_derive_alias_ok", src_alias_of_derivable())
}

test "a field whose type is an alias of a type the trait rejects is still rejected" {
    let _p = probe_but("tc_derive_alias_rejected", src_alias_of_rejected(), "NonDerivableTrait")
}

test "the rejection names the type the author wrote, not the one it resolves to" {
    let _p = probe_but("tc_derive_alias_named", src_alias_of_rejected(), "NonDerivableTrait")
    assert(last_non_derivable_message().contains("'Names'"))
}

test "a derive on a handle that exposes no fields is refused while the types are checked" {
    let _p = probe_but("tc_derive_opaque", src_opaque_handle(), "NonDerivableTrait")
}
