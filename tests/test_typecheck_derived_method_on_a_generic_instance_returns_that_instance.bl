// A derived method on a generic type is declared over the type's own parameters, so the
// type a call answers with is the declaration read at the receiver's instance. A clone of a
// `Box[Int]` is a `Box[Int]`, and not the bare declaration that has no C shape.

import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_type_str}
import parser.{nodes, node_kind, node_method}
import ast.{NodeKind}
import diagnostics.{diag_reset}

fn typecheck_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

// The type of the last call to `method` in the node table, which is the most recent probe's.
fn call_tid_str(method: Str) -> Str ! Diag.Report {
    let mut found = -1
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.MethodCall && node_method(i) == method { found = i }
        i = i + 1
    }
    if found < 0 { return "<no call>" }
    let t = tc_lookup_node_tid(found)
    if t < 0 { return "<unset>" }
    tc_type_str(t)
}

fn assert_call_type(src: Str, method: Str, want: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    typecheck_probe("build/tc_derived_generic_{method}.bl", src)
    let got = call_tid_str(method)
    if got != want { io.println("FAIL: .{method}() is {got}, want {want}") }
    assert(got == want)
}

test "a derived clone of a generic instance is that instance" {
    assert_call_type(#"@derive(Clone)
type Box[T] { v: T }
fn main() {
    let b: Box[Int] = Box { v: 5 }
    let _c = b.clone()
}
"#, "clone", "Box[Int]")
}

test "a derived clone of a generic enum instance is that instance" {
    assert_call_type(#"@derive(Clone)
type Opt[T] { Has(v: T), Empty }
fn main() {
    let o: Opt[Str] = Opt.Has(v: "a")
    let _c = o.clone()
}
"#, "clone", "Opt[Str]")
}

test "a derived clone of a monomorphic type is still that type" {
    assert_call_type(#"@derive(Clone)
type Rec { v: Int }
fn main() {
    let r = Rec { v: 5 }
    let _c = r.clone()
}
"#, "clone", "Rec")
}
