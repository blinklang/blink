// Section 3 makes an enum distinct from Int and names `.to_int()` as the one total way across:
// every enum answers it with its tag. Whether a variant carries a payload does not change
// that, so a unit enum, a payload enum and a one-variant newtype all type the call as Int.
// Nothing registered the method, so it typed as unknown and any use of the answer passed.
import lower_test_helpers.{probe, probe_but, assert_eq_str}
import diagnostics.{diag_entries}

fn unit_enum_src() -> Str {
    #"type Latch { Open Shut Done }

fn main() {
    let n: Int = Latch.Done.to_int()
    io.println("{n}")
}
"#
}

fn payload_enum_src() -> Str {
    #"type Shape { Dot Circle { r: Int } }

fn main() {
    let s = Shape.Circle(r: 2)
    let n: Int = s.to_int() + Shape.Dot.to_int()
    io.println("{n}")
}
"#
}

fn newtype_src() -> Str {
    #"type Code { Code(Int) }

fn main() {
    let n: Int = Code(5).to_int()
    io.println("{n}")
}
"#
}

fn answer_is_not_str_src() -> Str {
    #"type Latch { Open Shut }

fn main() {
    let s: Str = Latch.Open.to_int()
    io.println(s)
}
"#
}

fn extra_argument_src() -> Str {
    #"type Latch { Open Shut }

fn main() {
    let n = Latch.Open.to_int(1)
    io.println("{n}")
}
"#
}

// A method the program declares for itself wins over the one every enum is given, the
// same way a hand-written method wins over a derived one.
fn declared_wins_src() -> Str {
    #"type Latch { Open Shut }

trait Named {
    fn to_int(self) -> Str
}

impl Named for Latch {
    fn to_int(self) -> Str { "declared" }
}

fn main() {
    let s: Str = Latch.Open.to_int()
    io.println(s)
}
"#
}

fn error_message() -> Str {
    let mut msg = ""
    for d in diag_entries {
        if d.severity == "error" { msg = d.message }
    }
    msg
}

test "a unit enum's to_int is an Int" {
    assert(probe("enum_to_int_unit", unit_enum_src()) >= 0)
}

test "a payload enum's to_int is an Int for either kind of variant" {
    assert(probe("enum_to_int_payload", payload_enum_src()) >= 0)
}

test "a one-variant newtype's to_int is an Int" {
    assert(probe("enum_to_int_newtype", newtype_src()) >= 0)
}

test "the answer is an Int and not whatever the binding asks for" {
    assert(probe_but("enum_to_int_not_str", answer_is_not_str_src(), "TypeError") >= 0)
}

test.failing(
    "to_int takes no argument",
    reason: "typecheck counts no call's arguments against a declared method signature, so the surplus argument passes check and codegen stops on it as an internal error",
    ticket: "13etx9",
) {
    assert(probe_but("enum_to_int_extra_arg", extra_argument_src(), "TypeError") >= 0)
    assert_eq_str("message", error_message(), "method `Latch.to_int` expects 0 argument(s), got 1")
}

test "a to_int the program declares is the one that answers" {
    assert(probe("enum_to_int_declared", declared_wins_src()) >= 0)
}
