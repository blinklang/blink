// A field access is defined on a struct (its declared fields) and on a tuple (`.0`, `.1`,
// within its arity), sections/03_types.md. Every other value has no fields at all, so `.1`
// or `.name` on it is the same NoSuchField a struct gets for a field it never declared.
// The node then carries the error-recovery type, so its uses report nothing further.
import lower_test_helpers.{probe, probe_but, assert_eq_str}
import diagnostics.{diag_entries}

fn no_such_field_count() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.name == "NoSuchField" { n = n + 1 }
    }
    n
}

fn no_such_field_message() -> Str {
    let mut msg = ""
    for d in diag_entries {
        if d.name == "NoSuchField" { msg = d.message }
    }
    msg
}

fn list_elem_index_src() -> Str {
    #"fn main() {
    let xs = ["a"]
    for p in xs { io.println("{p.1}") }
}
"#
}

fn str_index_src() -> Str {
    #"fn main() {
    let s = "x"
    let _a = s.0
}
"#
}

fn int_index_src() -> Str {
    #"fn main() {
    let n = 5
    let _a = n.1
}
"#
}

fn str_named_src() -> Str {
    #"fn main() {
    let s = "x"
    let _a = s.foo
}
"#
}

fn float_index_src() -> Str {
    #"fn main() {
    let f = 1.5
    let _a = f.0
}
"#
}

fn option_index_src() -> Str {
    #"fn main() {
    let o = Some(1)
    let _a = o.0
}
"#
}

fn map_index_src() -> Str {
    #"fn main() {
    let m: Map[Str, Int] = Map()
    let _a = m.0
}
"#
}

fn list_named_src() -> Str {
    #"fn main() {
    let xs = [1]
    let _a = xs.len
}
"#
}

fn enum_index_src() -> Str {
    #"type C { R, G }
fn main() {
    let c = C.R
    let _a = c.0
}
"#
}

fn fn_index_src() -> Str {
    #"fn main() {
    let f = fn(x: Int) -> Int { x }
    let _a = f.0
}
"#
}

fn struct_index_src() -> Str {
    #"type P { x: Int }
fn main() {
    let p = P { x: 1 }
    let _a = p.0
}
"#
}

fn tuple_out_of_range_src() -> Str {
    #"fn main() {
    let t = (1, 2)
    let _a = t.5
}
"#
}

// The declared type on the binding meets the recovery type, so the one error stands alone.
fn str_index_into_typed_let_src() -> Str {
    #"fn main() {
    let s = "x"
    let a: Int = s.1
    io.println("{a + 1}")
}
"#
}

fn tuple_index_src() -> Str {
    #"fn main() {
    let t = (1, "a")
    let a: Int = t.0
    let b: Str = t.1
    io.println("{a} {b}")
}
"#
}

fn list_of_tuples_index_src() -> Str {
    #"fn main() {
    let xs = [(1, "a"), (2, "b")]
    for p in xs { io.println("{p.0} {p.1}") }
}
"#
}

// The receiver's type comes from a generic call, so it is open when the call is inferred
// and only later is it known to be a tuple.
fn generic_tuple_index_src() -> Str {
    #"fn first[T](xs: List[T]) -> T { xs.get(0).unwrap() }
fn main() {
    let t = first([(1, "a")])
    let a: Int = t.0
    io.println("{a}")
}
"#
}

test "a numeric field on a List element that is a Str is NoSuchField" {
    let program = probe_but("nofield_list_elem_index", list_elem_index_src(), "NoSuchField")
    assert(program >= 0)
    assert_eq_str("message", no_such_field_message(), "`Str` has no field `1`")
}

test "a numeric field on a Str is NoSuchField" {
    let program = probe_but("nofield_str_index", str_index_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on an Int is NoSuchField" {
    let program = probe_but("nofield_int_index", int_index_src(), "NoSuchField")
    assert(program >= 0)
    assert_eq_str("message", no_such_field_message(), "`Int` has no field `1`")
}

test "a named field on a Str is NoSuchField" {
    let program = probe_but("nofield_str_named", str_named_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on a Float is NoSuchField" {
    let program = probe_but("nofield_float_index", float_index_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on an Option is NoSuchField" {
    let program = probe_but("nofield_option_index", option_index_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on a Map is NoSuchField" {
    let program = probe_but("nofield_map_index", map_index_src(), "NoSuchField")
    assert(program >= 0)
}

test "a method name read as a field on a List is NoSuchField" {
    let program = probe_but("nofield_list_named", list_named_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on an enum value is NoSuchField" {
    let program = probe_but("nofield_enum_index", enum_index_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on a function value is NoSuchField" {
    let program = probe_but("nofield_fn_index", fn_index_src(), "NoSuchField")
    assert(program >= 0)
}

test "a numeric field on a struct is NoSuchField" {
    let program = probe_but("nofield_struct_index", struct_index_src(), "NoSuchField")
    assert(program >= 0)
    assert_eq_str("message", no_such_field_message(), "`P` has no field `0`")
}

test "a tuple index past the arity is NoSuchField" {
    let program = probe_but("nofield_tuple_oob", tuple_out_of_range_src(), "NoSuchField")
    assert(program >= 0)
    assert_eq_str("message", no_such_field_message(), "tuple (Int, Int) has no field `5`")
}

test "the field error is the only error its uses report" {
    let program = probe_but("nofield_str_typed_let", str_index_into_typed_let_src(), "NoSuchField")
    assert(program >= 0)
    assert(no_such_field_count() == 1)
}

test "a tuple index within the arity still checks" {
    let program = probe("nofield_tuple_index", tuple_index_src())
    assert(program >= 0)
}

test "a tuple index on a List element that is a tuple still checks" {
    let program = probe("nofield_list_of_tuples", list_of_tuples_index_src())
    assert(program >= 0)
}

test "a tuple index on a receiver a generic call types still checks" {
    let program = probe("nofield_generic_tuple", generic_tuple_index_src())
    assert(program >= 0)
}
