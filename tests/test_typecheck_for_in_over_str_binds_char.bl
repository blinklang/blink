// A Str implements IntoIterator[Char] (sections/03_types.md, and the IntoIterator table in
// sections/03c_protocols.md), so the element of a `for` loop over a Str, or of a zip that
// takes a Str, is a Char and not a one-character Str.
import cg_test_helpers.{cg_probe_begin, cg_probe_errors_named}
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries}
import std.io

// Checks `src` and answers the TypeError count. Any other error fails the row.
fn type_errors_in(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    env.set_var("BLINK_ROOT", process_run("pwd", []).out.trim())
    let path = "build/{stem}_probe.bl"
    cg_probe_begin(path)
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process_run("rm", ["-f", path])
    let mut others = 0
    for d in diag_entries {
        if d.severity == "error" && d.name != "TypeError" {
            io.println("FAIL: {stem} recorded an error the row does not expect: {d.name}: {d.message}")
            others = others + 1
        }
    }
    assert_eq(others, 0)
    cg_probe_errors_named("TypeError")
}

fn push_into_list_of_str_src() -> Str {
    #"fn main() {
    let mut xs: List[Str] = []
    for c in "hi" { xs.push(c) }
    io.println("{xs.len()}")
}
"#
}

fn push_into_list_of_char_src() -> Str {
    #"fn main() {
    let mut xs: List[Char] = []
    for c in "hi" { xs.push(c) }
    io.println("{xs.len()}")
}
"#
}

fn binder_from_local_src() -> Str {
    #"fn main() {
    let s = "hello"
    let mut n = 0
    for c in s {
        let k: Char = c
        if k == 'l' { n = n + 1 }
    }
    io.println("{n}")
}
"#
}

fn binder_as_str_src() -> Str {
    #"fn main() {
    let s = "hello"
    for c in s {
        let k: Str = c
        io.println(k)
    }
}
"#
}

fn zip_as_char_src() -> Str {
    #"fn main() {
    let z: List[(Int, Char)] = [1, 2].into_iter().zip("ab").collect()
    io.println("{z.len()}")
}
"#
}

fn zip_as_str_src() -> Str {
    #"fn main() {
    let z: List[(Int, Str)] = [1, 2].into_iter().zip("ab").collect()
    io.println("{z.len()}")
}
"#
}

test "a loop over a Str does not bind a Str" {
    assert_eq(type_errors_in("typecheck_str_iter_push_str", push_into_list_of_str_src()), 1)
}

test "a loop over a Str binds a Char" {
    assert_eq(type_errors_in("typecheck_str_iter_push_char", push_into_list_of_char_src()), 0)
}

test "a loop over a Str local binds a Char that compares to a char literal" {
    assert_eq(type_errors_in("typecheck_str_iter_binder_char", binder_from_local_src()), 0)
}

test "a loop binder over a Str is not a Str" {
    assert_eq(type_errors_in("typecheck_str_iter_binder_str", binder_as_str_src()), 1)
}

test "zip with a Str pairs each item with a Char" {
    assert_eq(type_errors_in("typecheck_str_iter_zip_char", zip_as_char_src()), 0)
}

test "zip with a Str does not pair each item with a Str" {
    assert_eq(type_errors_in("typecheck_str_iter_zip_str", zip_as_str_src()), 1)
}
