// A monomorphized enum instance is a different type per argument, and the surface rendering
// has to say so. Rendered bare, `ZzTree[Int]` and `ZzTree[Str]` are one word, which makes a
// mismatch between them read "declared type ZzTree but got ZzTree" — a line that contradicts
// itself and names no repair. A struct instance has always rendered its args; an enum
// instance is the same kind of type and is now rendered the same way.
//
// The rows read the rendering directly and then read one diagnostic built from it, because
// the rendering is a lens on the type and the diagnostic is what it is for.

import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_type_str}
import parser.{nodes, node_kind, node_name, node_obj, node_type_name}
import ast.{NodeKind}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn enum_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

// The type of the one Ident read spelled `nm`, rendered. The declaration spells its name in
// a type position, which is not an Ident node, so a read is what this finds. -2 marks an
// ambiguous one, so a row fails rather than reading whichever came last.
fn rendered_type_of_read(nm: Str) -> Str {
    let mut hit = -1
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.Ident && node_name(i) == nm {
            if hit != -1 { return "<ambiguous>" }
            hit = i
        }
        i = i + 1
    }
    if hit == -1 { return "<absent>" }
    tc_type_str(tc_lookup_node_tid(hit))
}

// The rendered type of the one MethodCall whose receiver is spelled `nm`. A variant
// constructor is written as one, so this reads the type the constructor itself answers,
// which is not the same node as the binding it is assigned to. -2 marks an ambiguous one.
fn rendered_type_of_call_on(nm: Str) -> Str {
    let mut hit = -1
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.MethodCall {
            let o = node_obj(i)
            if o != -1 {
                if node_kind(o) == NodeKind.Ident && node_name(o) == nm {
                    if hit != -1 { return "<ambiguous>" }
                    hit = i
                }
            }
        }
        i = i + 1
    }
    if hit == -1 { return "<absent>" }
    tc_type_str(tc_lookup_node_tid(hit))
}

// The rendered type of the one StructLit whose name starts with `nm`. The field-named
// variant construction is a StructLit, not a MethodCall, so it needs its own reader.
fn rendered_type_of_structlit(nm: Str) -> Str {
    let mut hit = -1
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.StructLit && node_type_name(i).starts_with(nm) {
            if hit != -1 { return "<ambiguous>" }
            hit = i
        }
        i = i + 1
    }
    if hit == -1 { return "<absent>" }
    tc_type_str(tc_lookup_node_tid(hit))
}

fn errors_saying(text: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "error" && d.message.contains(text) { n = n + 1 }
    }
    n
}

fn instances_src() -> Str {
    #"type ZzTree[T] {
    Leaf
    Node(v: T)
}

fn zzreads() -> Int {
    let zzint: ZzTree[Int] = ZzTree.Node(1)
    let zzstr: ZzTree[Str] = ZzTree.Node("x")
    let zzintread = zzint
    let zzstrread = zzstr
    match zzintread {
        ZzTree.Node(v) => v
        ZzTree.Leaf => 0
    }
}

fn main() {
    let _ = zzreads()
}
"#
}

fn mismatch_src() -> Str {
    #"type ZzTree[T] {
    Leaf
    Node(v: T)
}

fn zzmismatch() {
    let zzint: ZzTree[Int] = ZzTree.Node(1)
    let zzwrong: ZzTree[Str] = zzint
    io.println("{zzwrong}")
}

fn main() {
    zzmismatch()
}
"#
}

fn hint_src() -> Str {
    #"type ZzSide[L, R] {
    Left(l: L)
    Right(r: R)
}

fn zzhint() -> Int {
    let zzpicked: ZzSide[Int, Str] = ZzSide.Left(7)
    match zzpicked {
        ZzSide.Left(l) => l
        ZzSide.Right(r) => r.len()
    }
}

fn main() {
    let _ = zzhint()
}
"#
}

fn untouched_src() -> Str {
    #"type ZzBox[T] {
    Full(value: T)
    Empty(sentinel: Int)
}

fn zzempty() -> Int {
    let zzbare: ZzBox[Int] = ZzBox.Empty(0)
    match zzbare {
        ZzBox.Full(v) => v
        ZzBox.Empty(s) => s
    }
}

fn main() {
    let _ = zzempty()
}
"#
}

fn untouched_fieldform_src() -> Str {
    #"type ZzCrate[T] {
    Full(value: T)
    Empty(sentinel: Int)
}

fn zzempty() -> Int {
    let zzbare: ZzCrate[Int] = ZzCrate.Empty { sentinel: 0 }
    match zzbare {
        ZzCrate.Full(v) => v
        ZzCrate.Empty(s) => s
    }
}

fn main() {
    let _ = zzempty()
}
"#
}

fn unannotated_src() -> Str {
    #"type ZzPail[T] {
    Full(value: T)
    Empty(sentinel: Int)
}

fn zzempty() -> Int {
    let zzbare = ZzPail.Empty(0)
    match zzbare {
        ZzPail.Full(_) => 1
        ZzPail.Empty(s) => s
    }
}

fn main() {
    let _ = zzempty()
}
"#
}

test "a generic enum instance renders its type arguments" {
    enum_probe("build/generic_enum_render.bl", instances_src())

    // Two instances of the same enum, distinct types, and the rendering now says which is
    // which. Rendered bare, both of these read "ZzTree".
    assert_eq(rendered_type_of_read("zzint"), "ZzTree[Int]")
    assert_eq(rendered_type_of_read("zzstr"), "ZzTree[Str]")
}

test "a mismatch between two instances of one enum names both sides apart" {
    enum_probe("build/generic_enum_mismatch.bl", mismatch_src())

    // The whole point of the rendering: before this, the line read "declared type ZzTree but
    // got ZzTree", which states no difference and asks for no repair.
    assert_eq(errors_saying("declared type ZzTree[Str] but got ZzTree[Int]"), 1)
    assert_eq(errors_saying("declared type ZzTree but got ZzTree"), 0)
}

// A variant that writes only one of the enum's parameters leaves the rest to the enclosing
// annotation, and that hint is matched to the enum by BASE name. The rendering is not that
// name once an instance spells its arguments, so a hint read through the rendering stops
// matching the enum it pins and the untouched parameter is left unfilled. The pool holds the
// base name whatever the rendering does, and that is what the match reads.
test "an annotation still pins the parameter a variant leaves untouched" {
    enum_probe("build/generic_enum_hint.bl", hint_src())

    // The binding takes its type from its own annotation either way, so it is the
    // CONSTRUCTOR that shows whether the hint reached the untouched parameter. Read
    // through the rendering, the hint stops matching and this answers ZzSide[Int, R].
    assert_eq(rendered_type_of_call_on("ZzSide"), "ZzSide[Int, Str]")
    assert_eq(rendered_type_of_read("zzpicked"), "ZzSide[Int, Str]")
}

// The row above pins the parameter a variant leaves untouched while a SIBLING argument
// binds another one. A variant whose whole payload mentions none of the enum's parameters
// binds nothing at all, and the annotation is then the only place those parameters can come
// from. The constructor used to answer the bare head, which names no instance and has no C
// layout, so a program that builds one could not be lowered.
test "an annotation pins the parameters when no argument touches any of them" {
    enum_probe("build/generic_enum_untouched.bl", untouched_src())

    assert_eq(rendered_type_of_call_on("ZzBox"), "ZzBox[Int]")
    assert_eq(rendered_type_of_read("zzbare"), "ZzBox[Int]")
}

// The same construction written with field names reaches a different builder, which carried
// the same bare-head fallback.
test "the field-named form of that constructor is pinned the same way" {
    enum_probe("build/generic_enum_untouched_fieldform.bl", untouched_fieldform_src())

    assert_eq(rendered_type_of_structlit("ZzCrate"), "ZzCrate[Int]")
    assert_eq(rendered_type_of_read("zzbare"), "ZzCrate[Int]")
}

// With nothing to read the parameter from, the bare head is still the honest answer: the
// annotation is what pins it, not the construction, so removing the annotation must not
// leave the fix inventing one.
test "with no annotation the same constructor stays on the bare head" {
    enum_probe("build/generic_enum_unannotated.bl", unannotated_src())

    assert_eq(rendered_type_of_call_on("ZzPail"), "ZzPail")
}
