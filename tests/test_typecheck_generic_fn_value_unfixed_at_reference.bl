// A generic function's name whose binders nothing fixes is under-determined, and the report is
// at the reference, where the repair attaches (sections/03_types.md, "A generic function named
// as a value"). A binder its function type does not mention is open whatever the expected type
// says, and the program must not reach codegen with it unsolved.

import compile_test_helpers

test "a let with no annotation reports at the reference" {
    let out = compile_test_helpers.compile_and_capture("fn identity[T](x: T) -> T \{ x }
fn main() \{
    let f = identity
    let _ = f
}
", "gfvu_let")
    compile_test_helpers.expect_error(out, "E0301", "let")
    compile_test_helpers.expect_contains(out, "type parameter `T` of `identity` is unbound at this reference and nothing supplies it", "let msg")
    compile_test_helpers.expect_contains(out, "let f: fn(T) -> T = identity", "let help")
    compile_test_helpers.expect_contains(out, "\"line\":3,\"col\":13", "let column")
}

test "a binder the function type does not mention is an error at the argument" {
    let out = compile_test_helpers.compile_and_capture("fn phantom[T]() -> Int \{ 1 }
fn ap(f: fn() -> Int) -> Int \{ f() }
fn main() \{
    let _ = ap(phantom)
}
", "gfvu_arg")
    compile_test_helpers.expect_error(out, "E0301", "phantom arg")
    compile_test_helpers.expect_contains(out, "type parameter `T` of `phantom` is unbound at this reference", "phantom arg msg")
    compile_test_helpers.expect_contains(out, "does not mention", "phantom arg help")
}

test "an annotation cannot fix a binder the function type does not mention" {
    let out = compile_test_helpers.compile_and_capture("fn phantom[T]() -> Int \{ 1 }
fn main() \{
    let f: fn() -> Int = phantom
    let _ = f()
}
", "gfvu_ann")
    compile_test_helpers.expect_error(out, "E0301", "phantom annotation")
}

test "only the binders still open are named" {
    let out = compile_test_helpers.compile_and_capture("fn second[A, B](_a: A, b: Int) -> Int \{ b }
fn main() \{
    let f: fn(Str, Int) -> Int = second
    let _ = f(\"a\", 1)
}
", "gfvu_part")
    compile_test_helpers.expect_error(out, "E0301", "second")
    compile_test_helpers.expect_contains(out, "type parameter `B` of `second`", "second names B")
}
