import compile_test_helpers

// A generic struct literal takes its type arguments from its fields. The expected type
// (a parameter, an annotated let, a return type) only fills the arguments no field
// determines, so a field that contradicts the expected instance is a type error.

test "a Box[Str] literal passed where Box[Int] is expected is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn want(b: Box[Int]) -> Int { b.value }
fn main() { let _ = want(Box { value: "s" }) }
"#, "gslit_param")
    compile_test_helpers.expect_error(out, "E0300", "Box[Str] literal into a Box[Int] parameter")
}

test "a Box[Str] literal bound to a Box[Int] let is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn main() {
    let b: Box[Int] = Box { value: "s" }
    let _ = b
}
"#, "gslit_let")
    compile_test_helpers.expect_error(out, "E0300", "Box[Str] literal into a Box[Int] let")
}

test "a Box[Str] literal returned as Box[Int] is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn mk() -> Box[Int] { Box { value: "s" } }
fn main() { let _ = mk() }
"#, "gslit_ret")
    compile_test_helpers.expect_error(out, "E0300", "Box[Str] literal returned as Box[Int]")
}

test "a nested field that contradicts the expected instance is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn main() {
    let b: Box[List[Int]] = Box { value: ["a"] }
    let _ = b
}
"#, "gslit_nested")
    compile_test_helpers.expect_error(out, "E0300", "Box[List[Str]] literal into a Box[List[Int]] let")
}

test "a field contradicts the expected instance while an empty Map takes the other argument from it" {
    let out = compile_test_helpers.compile_and_capture(#"
type Pair[K, V] { seen: Map[K, Int], v: V }
fn main() {
    let p: Pair[Int, Int] = Pair { seen: Map(), v: "s" }
    let _ = p
}
"#, "gslit_pair_bad")
    compile_test_helpers.expect_error(out, "E0300", "Pair[_, Str] literal into a Pair[Int, Int] let")
}

test "a Box[Int] literal passed where Box[Int] is expected compiles" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn want(b: Box[Int]) -> Int { b.value }
fn main() { let _ = want(Box { value: 5 }) }
"#, "gslit_param_ok")
    compile_test_helpers.expect_compiles_clean(out, "Box[Int] literal into a Box[Int] parameter")
}

test "an empty Map field still takes its key from the expected instance" {
    let out = compile_test_helpers.compile_and_capture(#"
type Pair[K, V] { seen: Map[K, Int], v: V }
fn main() {
    let p: Pair[Int, Int] = Pair { seen: Map(), v: 3 }
    assert(p.seen.len() == 0)
}
"#, "gslit_pair_ok")
    compile_test_helpers.expect_compiles_clean(out, "Pair literal with an empty Map field into a Pair[Int, Int] let")
}

test "a literal built from a type parameter matches the generic return type" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn wrap[T](x: T) -> Box[T] { Box { value: x } }
fn main() {
    let b: Box[Str] = wrap("a")
    assert(b.value == "a")
}
"#, "gslit_generic_ok")
    compile_test_helpers.expect_compiles_clean(out, "Box \{ value: x \} returned as Box[T]")
}

test "an empty Map field inside a generic body still takes the type parameter from the return type" {
    let out = compile_test_helpers.compile_and_capture(#"
type Bag[T] { seen: Map[T, Int] }
fn empty_bag[T]() -> Bag[T] { Bag { seen: Map() } }
fn main() {
    let b: Bag[Int] = empty_bag()
    assert(b.seen.len() == 0)
}
"#, "gslit_bag_ok")
    compile_test_helpers.expect_compiles_clean(out, "Bag \{ seen: Map() \} returned as Bag[T]")
}

test "empty container fields take their element types from the expected instance" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn main() {
    let b: Box[List[Int]] = Box { value: [] }
    let c: Box[Option[Int]] = Box { value: None }
    let d: Box[Map[Str, Int]] = Box { value: Map() }
    assert(b.value.len() == 0)
    assert(c.value.is_none())
    assert(d.value.len() == 0)
}
"#, "gslit_empty_ok")
    compile_test_helpers.expect_compiles_clean(out, "empty List, None and Map() fields under a concrete expected instance")
}

test "an empty Map field in a generic call argument takes its types from the let" {
    let src = #"
import std.io
type Box[T] { value: T }
fn unbox[T](b: Box[T]) -> T { b.value }
fn main() {
    let mut m: Map[Int, Str] = unbox(Box { value: Map() })
    m.insert(256, "a")
    io.println(m.get(256) ?? "-")
}
"#
    let out = compile_test_helpers.compile_and_capture(src, "gslit_unbox_ok")
    compile_test_helpers.expect_compiles_clean(out, "unbox(Box \{ value: Map() \}) into a Map[Int, Str] let")
    let r = compile_test_helpers.compile_and_run(src, "gslit_unbox_run")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "a\n")
}

test "a tuple field whose empty Map fits the expected instance but whose other element does not is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn main() {
    let b: Box[(Map[Str, Str], Str)] = Box { value: (Map(), 1) }
    let _ = b
}
"#, "gslit_tuple_partial_bad")
    compile_test_helpers.expect_error(out, "E0300", "Box[(Map, Int)] literal into a Box[(Map[Str, Str], Str)] let")
}

test "a partly open field from a generic call that contradicts the expected instance is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
type P[A, B] { a: A, b: B }
fn mkp[K, V](n: Int) -> P[Map[K, V], Int] { P { a: Map(), b: n } }
fn main() {
    let b: Box[P[Map[Str, Str], Str]] = Box { value: mkp(1) }
    let _ = b
}
"#, "gslit_call_partial_bad")
    compile_test_helpers.expect_error(out, "E0300", "Box[P[Map[_, _], Int]] literal into a Box[P[Map[Str, Str], Str]] let")
}
