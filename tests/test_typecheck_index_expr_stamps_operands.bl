// `xs[i]` is NoIndexOperator (E0313): Blink has no index operator. Typecheck still infers
// both operands, so the help can name the receiver's type and a name used only in the
// brackets draws no second error. The read itself has no settled type, so no other check
// reports on it.

import lower_test_helpers.{probe_but, rhs_of, assert_eq_str}
import typecheck.{check_types, tc_lookup_node_tid, tc_resolve, tc_type_str, TYPE_INT}
import parser.{node_kind, node_obj, node_index}
import ast.{NodeKind}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_entry_count, diag_truncate}
import std.fs
import std.io

fn src_index() -> Str {
    #"fn pick(nums: List[Int], at: Int) -> Int {
    let elem = nums[at]
    let first = nums[0]
    let shifted = nums[at + 1]
    let words = ["a", "b"]
    let word = words[at]
    elem + first + shifted + word.len()
}

fn main() {
    let _keep = pick([1, 2, 3], 1)
}
"#
}

fn stamp_of(label: Str, node: Int) -> Int {
    let tid = tc_lookup_node_tid(node)
    if tid < 0 { io.println("FAIL: {label} (node {node}) has no recorded type") }
    assert(tid >= 0)
    tid
}

fn assert_index_stamped(name: Str, want_recv: Str) {
    let idx = rhs_of(name)
    assert(node_kind(idx) == NodeKind.IndexExpr)
    let read = tc_lookup_node_tid(idx)
    let settled = read >= 0 && tc_type_str(tc_resolve(read)) != "?"
    if settled { io.println("FAIL: {name}: the rejected read has type {tc_type_str(tc_resolve(read))}") }
    assert(!settled)
    let recv = stamp_of("{name}: receiver", node_obj(idx))
    assert_eq_str("{name}: receiver type", tc_type_str(tc_resolve(recv)), want_recv)
    let index = stamp_of("{name}: index", node_index(idx))
    assert(tc_resolve(index) == TYPE_INT)
}

test "a rejected index read carries no element type, and both operands carry theirs" {
    let _p = probe_but("index_expr_stamps", src_index(), "NoIndexOperator")
    assert_index_stamped("elem", "List[Int]")
    assert_index_stamped("word", "List[Str]")
}

test "a literal index and a compound index are stamped like a named one" {
    let _p = probe_but("index_expr_stamps_forms", src_index(), "NoIndexOperator")
    assert_index_stamped("first", "List[Int]")
    assert_index_stamped("shifted", "List[Int]")
}

fn src_str_index() -> Str {
    #"fn main() {
    let nums = [1, 2, 3]
    let key = "one"
    let _elem = nums[key]
}
"#
}

// Diagnostics this probe adds that name the wanted error. The shared buffer is truncated
// back afterwards so the entry cannot surface as a failure of a later test in this binary.
fn count_errors(path: Str, src: Str, name: Str, must_mention: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    write_file(path, src)
    let program = compile_to_program(path, 1)
    let before = diag_entry_count()
    check_types(program)
    let _ = fs.delete(path)
    let mut hits = 0
    let mut i = before
    while i < diag_entries.len() {
        let d = diag_entries.get(i).unwrap()
        if d.name == name && d.severity == "error" && d.message.contains(must_mention) {
            hits = hits + 1
        }
        i = i + 1
    }
    diag_truncate(before)
    hits
}

// The read is refused whatever the index type, so a Str index gets no TypeError beside it.
test "a non-Int index is NoIndexOperator, with no type error on the index operand" {
    let path = "build/index_expr_str_index.bl"
    let typed = count_errors(path, src_str_index(), "TypeError", "index must be an Int")
    if typed != 0 { io.println("FAIL: {typed} TypeError for a Str index") }
    assert_eq(typed, 0)
    let refused = count_errors(path, src_str_index(), "NoIndexOperator", "no index operator")
    if refused != 1 { io.println("FAIL: {refused} NoIndexOperator for a Str index, want 1") }
    assert_eq(refused, 1)
}

fn src_open_index() -> Str {
    #"fn main() {
    let nums = [1, 2, 3]
    let mut holder = []
    let last = holder.pop().unwrap()
    let picked = nums[last]
    let _keep = [picked]
}
"#
}

// `holder` is never constrained elsewhere, so the brackets are the only thing that can settle
// its element type. The help names `.get`, which takes an Int, so the index is pinned to Int;
// left open it would add an E0301 that the repair does not have.
test "an index whose type is still open is pinned to Int, with no error beside NoIndexOperator" {
    let _p = probe_but("index_expr_open_index", src_open_index(), "NoIndexOperator")
    assert_index_stamped("picked", "List[Int]")
}
