// `List[T].contains` is a linear scan over `==`, so it needs `T: Eq` (sections/03_types.md,
// *The `Contains` Trait* and *Container Equality*). A struct, enum, nested collection,
// Option or tuple element is accepted when it is `Eq`, and refused when it is not.
//
// The refusal stays in typecheck, at the call, so it names a line of Blink and the element
// type that has no `==`. A refusal left to codegen would come with no source location worth
// reading, and an acceptance with no `==` behind it would answer from addresses.
//
// The rows below fix both halves: what is refused, and what must keep working.

import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn probe(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    init_embedded_stdlib()
    let path = "/tmp/zz_lc_{stem}.bl"
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    let mut out = ""
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out = out.concat("{d.name}: {d.message}\n") }
    }
    out
}

fn assert_refused(stem: Str, src: Str, want_type: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let errs = probe(stem, src)
    let want = "UnresolvedMethod: unresolved method `.contains` on type {want_type}"
    if !errs.contains(want) { io.println("FAIL: {stem}: want '{want}', got:\n{errs}") }
    assert(errs.contains(want))
}

fn assert_accepted(stem: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let errs = probe(stem, src)
    if errs != "" { io.println("FAIL: {stem}: unexpected diagnostics:\n{errs}") }
    assert(errs == "")
}

fn struct_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let xs: List[Pt] = [Pt { x: 1 }]
    let hit = xs.contains(Pt { x: 1 })
    io.println("{hit}")
}
"#
}

fn enum_src() -> Str {
    #"type Tag {
    A
    B
}

fn main() {
    let xs: List[Tag] = [Tag.A]
    let hit = xs.contains(Tag.B)
    io.println("{hit}")
}
"#
}

fn nested_list_src() -> Str {
    #"fn main() {
    let xs: List[List[Int]] = [[1, 2]]
    let hit = xs.contains([1, 2])
    io.println("{hit}")
}
"#
}

fn nested_map_src() -> Str {
    #"fn main() {
    let m: Map[Str, Int] = Map()
    let xs: List[Map[Str, Int]] = [m]
    let hit = xs.contains(m)
    io.println("{hit}")
}
"#
}

fn nested_set_src() -> Str {
    #"fn main() {
    let s: Set[Str] = Set()
    let xs: List[Set[Str]] = [s]
    let hit = xs.contains(s)
    io.println("{hit}")
}
"#
}

fn option_src() -> Str {
    #"fn main() {
    let xs: List[Option[Int]] = [Some(1)]
    let hit = xs.contains(Some(1))
    io.println("{hit}")
}
"#
}

fn tuple_src() -> Str {
    #"fn main() {
    let xs: List[(Int, Int)] = [(1, 2)]
    let hit = xs.contains((1, 2))
    io.println("{hit}")
}
"#
}

fn primitives_src() -> Str {
    #"fn main() {
    let ints = [1, 2, 3]
    let bools = [true, false]
    let strs = ["a", "b"]
    let floats = [1.5, 2.5]
    io.println("{ints.contains(2)} {bools.contains(true)} {strs.contains("a")} {floats.contains(1.5)}")
}
"#
}

// The refusal is about List's linear scan over `==`. A Set hashes its elements and a Map
// looks its key up, so neither is reached by this rule and neither may be broken by it.
fn other_receivers_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let s: Set[Str] = Set()
    let m: Map[Str, Int] = Map()
    let text = "hello"
    io.println("{s.contains("a")} {m.contains("k")} {text.contains("ell")}")
}
"#
}

fn qualified_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let xs: List[Pt] = [Pt { x: 1 }]
    let hit = ListOps.contains(xs, Pt { x: 1 })
    io.println("{hit}")
}
"#
}

fn derived_struct_src() -> Str {
    #"@derive(Eq)
type Pt { x: Int }

fn main() {
    let xs: List[Pt] = [Pt { x: 1 }]
    let hit = xs.contains(Pt { x: 1 })
    io.println("{hit}")
}
"#
}

fn nested_struct_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let xs: List[List[Pt]] = [[Pt { x: 1 }]]
    let hit = xs.contains([Pt { x: 1 }])
    io.println("{hit}")
}
"#
}

fn payload_enum_src() -> Str {
    #"type Pt { x: Int }

type Holder {
    Empty
    Full(p: Pt)
}

fn main() {
    let xs: List[Holder] = [Holder.Empty]
    let hit = xs.contains(Holder.Empty)
    io.println("{hit}")
}
"#
}

fn generic_src() -> Str {
    #"fn has[T](xs: List[T], x: T) -> Bool {
    xs.contains(x)
}

fn main() {
    io.println("{has([1], 1)}")
}
"#
}

fn generic_eq_src() -> Str {
    #"fn has[T: Eq](xs: List[T], x: T) -> Bool {
    xs.contains(x)
}

fn main() {
    io.println("{has([1], 1)}")
}
"#
}

test "a list of structs with no Eq refuses contains" {
    assert_refused("struct", struct_src(), "List[Pt]")
}

test "a list of payload-free enums answers contains" {
    assert_accepted("enum", enum_src())
}

test "a list of lists answers contains" {
    assert_accepted("nested_list", nested_list_src())
}

test "a list of maps answers contains" {
    assert_accepted("nested_map", nested_map_src())
}

test "a list of sets answers contains" {
    assert_accepted("nested_set", nested_set_src())
}

test "a list of options answers contains" {
    assert_accepted("option", option_src())
}

test "a list of tuples answers contains" {
    assert_accepted("tuple", tuple_src())
}

test "a list of structs that derive Eq answers contains" {
    assert_accepted("derived_struct", derived_struct_src())
}

// The element is asked through every type it is built from, so a struct with no `Eq`
// two lists down is still the reason.
test "a list of lists of structs with no Eq refuses contains" {
    assert_refused("nested_struct", nested_struct_src(), "List[List[Pt]]")
}

test "a list of enums whose payload has no Eq refuses contains" {
    assert_refused("payload_enum", payload_enum_src(), "List[Holder]")
}

test "a list over a type parameter needs the Eq bound for contains" {
    assert_refused("generic", generic_src(), "List[T]")
    assert_accepted("generic_eq", generic_eq_src())
}

// `ListOps.contains(xs, v)` denotes the same call as `xs.contains(v)`. A rule that only one
// of the two spellings carries is not a rule; it is a spelling the program picks to opt out.
test "the qualified spelling refuses the same element types" {
    assert_refused("qualified", qualified_src(), "List[Pt]")
}

// The other half of the rule. Widening the element types must not cost the four the spec
// always allowed.
test "the four primitive element types still answer contains" {
    assert_accepted("primitives", primitives_src())
}

test "Set, Map and Str keep their own contains" {
    assert_accepted("other_receivers", other_receivers_src())
}
