// `List[T].last` is `fn(self) -> Option[T]` and `List[T].index_of` is
// `fn(self, T) -> Option[Int]` (sections/03_types.md, *The `ListOps` Trait*). `index_of`
// compares by `==`, so like `contains` it needs `T: Eq`. Str has an `index_of` of its own,
// and these rows hold that the List call is typed by the List signature, not by Str's.
import lower_test_helpers.{probe, probe_but}

fn well_formed_src() -> Str {
    #"@derive(Eq)
type Pt { x: Int }

fn main() {
    let xs: List[Int] = [3, 1, 2]
    let a: Option[Int] = xs.last()
    let b: Option[Int] = xs.index_of(1)
    let names = ["a", "b"]
    let c: Option[Str] = names.last()
    let d: Option[Int] = names.index_of("b")
    let pts = [Pt { x: 1 }]
    let e: Option[Pt] = pts.last()
    let f: Option[Int] = pts.index_of(Pt { x: 1 })
    let g: Option[Int] = ListOps.index_of(xs, 2)
    let h: Option[Int] = ListOps.last(xs)
    io.println("{a.unwrap()} {b.unwrap()} {c.unwrap()} {d.unwrap()} {e.unwrap().x} {f.unwrap()} {g.unwrap()} {h.unwrap()}")
}
"#
}

fn generic_eq_src() -> Str {
    #"fn find_in[T: Eq](xs: List[T], x: T) -> Option[Int] {
    xs.index_of(x)
}

fn tail[T](items: List[T]) -> Option[T] {
    items.last()
}

fn main() {
    io.println("{find_in([1], 1).unwrap()} {tail([1]).unwrap()}")
}
"#
}

fn non_eq_struct_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let xs: List[Pt] = [Pt { x: 1 }]
    let i = xs.index_of(Pt { x: 1 })
}
"#
}

fn non_eq_qualified_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let xs: List[Pt] = [Pt { x: 1 }]
    let i = ListOps.index_of(xs, Pt { x: 1 })
}
"#
}

fn closure_elem_src() -> Str {
    #"fn main() {
    let f = fn(x: Int) -> Int { x }
    let xs = [f]
    let i = xs.index_of(f)
}
"#
}

fn generic_no_bound_src() -> Str {
    #"fn find_in[T](xs: List[T], x: T) -> Option[Int] {
    xs.index_of(x)
}

fn main() {
    let i = find_in([1], 1)
}
"#
}

// `last` asks nothing of the element, so a list of a type with no `==` still answers it.
fn last_non_eq_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let xs: List[Pt] = [Pt { x: 1 }]
    let p: Option[Pt] = xs.last()
    io.println("{p.unwrap().x}")
}
"#
}

fn wrong_arg_type_src() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let i = xs.index_of("a")
}
"#
}

fn index_of_no_arg_src() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let i = xs.index_of()
}
"#
}

fn index_of_two_args_src() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let i = xs.index_of(1, 0)
}
"#
}

fn last_with_arg_src() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let l = xs.last(1)
}
"#
}

fn last_is_not_bare_src() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let l: Int = xs.last()
}
"#
}

fn index_of_is_not_str_carrier_src() -> Str {
    #"fn main() {
    let xs: List[Str] = ["a"]
    let i: Option[Str] = xs.index_of("a")
}
"#
}

test "last and index_of typecheck on Int, Str and Eq struct lists" {
    let program = probe("list_last_index_of_well_formed", well_formed_src())
    assert(program >= 0)
}

test "index_of through an Eq bound and last through no bound" {
    let program = probe("list_last_index_of_generic_eq", generic_eq_src())
    assert(program >= 0)
}

test "last asks nothing of the element type" {
    let program = probe("list_last_index_of_last_non_eq", last_non_eq_src())
    assert(program >= 0)
}

test "index_of refuses a struct element with no Eq" {
    let program = probe_but("list_last_index_of_non_eq", non_eq_struct_src(), "UnresolvedMethod")
    assert(program >= 0)
}

test "the qualified index_of refuses the same element type" {
    let program = probe_but("list_last_index_of_non_eq_qualified", non_eq_qualified_src(), "UnresolvedMethod")
    assert(program >= 0)
}

test "index_of refuses a closure element" {
    let program = probe_but("list_last_index_of_closure", closure_elem_src(), "UnresolvedMethod")
    assert(program >= 0)
}

test "index_of over a type parameter needs the Eq bound" {
    let program = probe_but("list_last_index_of_generic_no_bound", generic_no_bound_src(), "UnresolvedMethod")
    assert(program >= 0)
}

test "index_of refuses an argument of another type" {
    let program = probe_but("list_last_index_of_wrong_arg", wrong_arg_type_src(), "TypeError")
    assert(program >= 0)
}

test "index_of refuses a call with no argument" {
    let program = probe_but("list_last_index_of_no_arg", index_of_no_arg_src(), "TypeError")
    assert(program >= 0)
}

test "index_of refuses a second argument" {
    let program = probe_but("list_last_index_of_two_args", index_of_two_args_src(), "TypeError")
    assert(program >= 0)
}

test "last refuses an argument" {
    let program = probe_but("list_last_index_of_last_arg", last_with_arg_src(), "TypeError")
    assert(program >= 0)
}

test "last answers an Option, not the bare element" {
    let program = probe_but("list_last_index_of_last_bare", last_is_not_bare_src(), "TypeError")
    assert(program >= 0)
}

test "index_of answers Option[Int] on a list of Strs" {
    let program = probe_but("list_last_index_of_str_carrier", index_of_is_not_str_carrier_src(), "TypeError")
    assert(program >= 0)
}
