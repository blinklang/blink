// `List[T].sort` is `fn(self) -> List[T]` and needs `T: Ord`; `List[T].sort_by` is
// `fn(self, fn(T, T) -> Ordering ! _) -> List[T] ! _` and needs nothing of `T`
// (sections/03_types.md, *The `ListOps` Trait*, *Sorting*). The bound is a real one: a sort
// over an element with no `Ord` is TraitBoundNotSatisfied naming that element, and its help
// shows a `sort_by` over a part of the element that is `Ord` (§3.2.4 *Tuples*).
import lower_test_helpers.{probe, probe_but, assert_eq_str}
import diagnostics.{diag_entries, DiagEntry}

fn last_named(name: Str) -> Option[DiagEntry] {
    let mut found: Option[DiagEntry] = None
    for d in diag_entries {
        if d.name == name { found = Some(d) }
    }
    found
}

fn well_formed_src() -> Str {
    #"type Pt { x: Int, y: Int }

@derive(Ord)
type Rank { r: Int }

@derive(Ord)
type Suit { Clubs, Hearts(Int) }

fn sort_any[T: Ord](ords: List[T]) -> List[T] {
    ords.sort()
}

fn sort_with[T](elems: List[T], cmp: fn(T, T) -> Ordering) -> List[T] {
    elems.sort_by(cmp)
}

fn main() {
    let xs: List[Int] = [3, 1, 2]
    let a: List[Int] = xs.sort()
    let b: List[Int] = xs.sort_by(fn(m, n) { n.cmp(m) })
    let c: List[Str] = ["b", "a"].sort()
    let d: List[Float] = [1.5, 0.5].sort()
    let e: List[Rank] = [Rank { r: 2 }].sort()
    let f: List[Suit] = [Suit.Clubs].sort()
    let pts = [Pt { x: 1, y: 2 }]
    let g: List[Pt] = pts.sort_by(fn(u, v) { u.x.cmp(v.x) })
    let h: List[Int] = sort_any(xs)
    let i: List[Pt] = sort_with(pts, fn(s: Pt, t: Pt) -> Ordering { s.y.cmp(t.y) })
    let j: List[Int] = ListOps.sort(xs)
    let flags = [true, false]
    let l: List[Bool] = flags.sort_by(fn(p, q) { if p == q { Equal } else if p { Greater } else { Less } })
    io.println("{a.len()} {b.len()} {c.len()} {d.len()} {e.len()} {f.len()} {g.len()} {h.len()} {i.len()} {j.len()} {l.len()}")
}
"#
}

fn non_ord_struct_src() -> Str {
    #"type Pt { name: Str, x: Int }

fn main() {
    let pts: List[Pt] = [Pt { name: "a", x: 1 }]
    let s = pts.sort()
}
"#
}

// The spec's own example (§3.2.4 *Tuples*): the help sorts by the part that is `Ord`.
fn non_ord_tuple_src() -> Str {
    #"type Canvas { w: Int }

fn main() {
    let shapes: List[(Int, Canvas)] = [(1, Canvas { w: 1 })]
    let sorted = shapes.sort()
}
"#
}

fn bool_src() -> Str {
    #"fn main() {
    let flags = [true, false]
    let s = flags.sort()
}
"#
}

fn generic_no_bound_src() -> Str {
    #"fn sort_any[T](items: List[T]) -> List[T] {
    items.sort()
}

fn main() {
    let s = sort_any([1])
}
"#
}

fn generic_eq_only_src() -> Str {
    #"fn sort_any[T: Eq](items: List[T]) -> List[T] {
    items.sort()
}

fn main() {
    let s = sort_any([1])
}
"#
}

fn non_ord_qualified_src() -> Str {
    #"type Pt { x: Int }

fn main() {
    let pts: List[Pt] = [Pt { x: 1 }]
    let s = ListOps.sort(pts)
}
"#
}

fn sort_with_arg_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort(fn(a: Int, b: Int) -> Ordering { a.cmp(b) })
}
"#
}

fn sort_by_no_arg_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by()
}
"#
}

fn sort_by_two_args_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by(fn(a: Int, b: Int) -> Ordering { a.cmp(b) }, 1)
}
"#
}

fn sort_by_bool_comparator_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by(fn(a: Int, b: Int) -> Bool { a < b })
}
"#
}

fn sort_by_unannotated_bool_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by(fn(a, b) { a < b })
}
"#
}

fn sort_by_void_comparator_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by(fn(a, b) { io.println("{a}{b}") })
}
"#
}

fn sort_by_wrong_param_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by(fn(a: Str, b: Str) -> Ordering { a.cmp(b) })
}
"#
}

fn sort_by_not_a_fn_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by(1)
}
"#
}

fn sort_answers_list_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s: List[Str] = xs.sort()
}
"#
}

fn sort_by_answers_list_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s: Int = xs.sort_by(fn(a, b) { a.cmp(b) })
}
"#
}

fn sorted_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sorted()
}
"#
}

fn sort_by_key_src() -> Str {
    #"fn main() {
    let xs = [2, 1]
    let s = xs.sort_by_key(fn(a: Int) -> Int { a })
}
"#
}

test "sort and sort_by typecheck over Ord scalars, Ord types, bounds and comparators" {
    let program = probe("list_sort_well_formed", well_formed_src())
    assert(program >= 0)
}

test "sort on a struct with no Ord names it and shows sort_by on an Ord field" {
    let program = probe_but("list_sort_non_ord_struct", non_ord_struct_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
    let d = last_named("TraitBoundNotSatisfied").unwrap()
    assert_eq_str("code", d.code, "E0306")
    assert_eq_str("message", d.message, "`Pt` does not implement `Ord`")
    assert_eq_str("help", d.help, "implement `Ord` for `Pt`, or sort with a comparator: `pts.sort_by(fn(a, b) \{ a.name.cmp(b.name) })`")
}

test "sort on a tuple with a part that has no Ord gives the spec's three lines" {
    let program = probe_but("list_sort_non_ord_tuple", non_ord_tuple_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
    let d = last_named("TraitBoundNotSatisfied").unwrap()
    assert_eq_str("message", d.message, "`(Int, Canvas)` does not implement `Ord`")
    assert_eq(d.notes.len(), 1)
    assert_eq_str("note", d.notes.get(0).unwrap(), "`Canvas` does not implement `Ord` (element .1 of tuple)")
    assert_eq_str("help", d.help, "implement `Ord` for `Canvas`, or sort with a comparator: `shapes.sort_by(fn(a, b) \{ a.0.cmp(b.0) })`")
}

test "sort on Bool refuses it and offers only a comparator" {
    let program = probe_but("list_sort_bool", bool_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
    let d = last_named("TraitBoundNotSatisfied").unwrap()
    assert_eq_str("message", d.message, "`Bool` does not implement `Ord`")
    assert(d.help.contains("`flags.sort_by`"))
    assert(!d.help.contains("implement `Ord` for"))
}

test "sort over a type parameter needs the Ord bound" {
    let program = probe_but("list_sort_generic_no_bound", generic_no_bound_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
    let d = last_named("TraitBoundNotSatisfied").unwrap()
    assert_eq_str("message", d.message, "`T` does not implement `Ord`")
    assert(d.help.starts_with("add the bound `[T: Ord]`"))
}

test "an Eq bound is not an Ord bound" {
    let program = probe_but("list_sort_generic_eq_only", generic_eq_only_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
}

test "the qualified sort refuses the same element type" {
    let program = probe_but("list_sort_non_ord_qualified", non_ord_qualified_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
}

test "sort refuses an argument" {
    let program = probe_but("list_sort_with_arg", sort_with_arg_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses a call with no comparator" {
    let program = probe_but("list_sort_by_no_arg", sort_by_no_arg_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses a second argument" {
    let program = probe_but("list_sort_by_two_args", sort_by_two_args_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses a comparator that answers Bool" {
    let program = probe_but("list_sort_by_bool_comparator", sort_by_bool_comparator_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses an unannotated comparator whose body answers Bool" {
    let program = probe_but("list_sort_by_unannotated_bool", sort_by_unannotated_bool_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses an unannotated comparator whose body answers nothing" {
    let program = probe_but("list_sort_by_void_comparator", sort_by_void_comparator_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses a comparator over another element type" {
    let program = probe_but("list_sort_by_wrong_param", sort_by_wrong_param_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by refuses an argument that is not a function" {
    let program = probe_but("list_sort_by_not_a_fn", sort_by_not_a_fn_src(), "TypeError")
    assert(program >= 0)
}

test "sort answers the receiver's list type" {
    let program = probe_but("list_sort_answers_list", sort_answers_list_src(), "TypeError")
    assert(program >= 0)
}

test "sort_by answers the receiver's list type" {
    let program = probe_but("list_sort_by_answers_list", sort_by_answers_list_src(), "TypeError")
    assert(program >= 0)
}

test "sorted is not a method and its help says sort returns a new list" {
    let program = probe_but("list_sorted", sorted_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", last_named("UnresolvedMethod").unwrap().help,
        "there is no `.sorted()`: `.sort()` already returns a new sorted list and leaves the receiver as it was")
}

test "sort_by_key is not a method and its help shows the sort_by rewrite" {
    let program = probe_but("list_sort_by_key", sort_by_key_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", last_named("UnresolvedMethod").unwrap().help,
        "there is no `.sort_by_key(key)`: compare the keys in a `.sort_by` comparator, `.sort_by(fn(a, b) \{ key(a).cmp(key(b)) })`")
}
