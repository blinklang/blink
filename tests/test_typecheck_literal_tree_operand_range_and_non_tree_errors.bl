// A literal tree in operand position takes the other operand's integer type, and the range
// check applies to each literal in it at that type (sections/03_types.md §3.2 *A literal tree
// that does not fit*): a literal that does not fit is E0318 at that literal, and nothing else
// is reported for it. A tree with a name in it is not a literal tree, so it keeps its own type.
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import std.io

// Every error a source draws, as `line:col code message`, so a row states the whole answer.
fn probe_errors(stem: Str, src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    let path = "build/{stem}_probe.bl"
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process_run("rm", ["-f", path])
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.line}:{d.col} {d.code} {d.message}") }
    }
    out
}

fn assert_errors(stem: Str, src: Str, want: List[Str]) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    let got = probe_errors(stem, src)
    if got != want { io.println("FAIL: {stem}:\n got  {got.join(" | ")}\n want {want.join(" | ")}") }
    assert(got == want)
}

// The rows bind the operator to a `let` with no annotation, so no expected type reaches the
// tree and the type it takes comes from the other operand alone.
test "a literal that does not fit the type the tree takes is E0318 at that literal" {
    assert_errors("tree_right_literal_too_big", #"fn f(u: U8) { let k = u + (300 - 100) }
"#, ["1:28 E0318 300 does not fit in U8 (0 to 255)"])
    assert_errors("tree_left_literal_too_big", #"fn f(x: I8) { let r = (2 * 200) + x }
"#, ["1:28 E0318 200 does not fit in I8 (-128 to 127)"])
    assert_errors("tree_comparison_literal_too_big", #"fn f(u: U16) -> Bool { u < (70000 + 1) }
"#, ["1:29 E0318 70000 does not fit in U16 (0 to 65535)"])
    assert_errors("tree_negative_literal_unsigned", #"fn f(u: U32) { let r = u + (2 * -1) }
"#, ["1:33 E0318 -1 does not fit in U32"])
    assert_errors("tree_wide_literal_takes_u64", #"fn f(m: U64) { let a = m & (9223372036854775808 | 1) }
fn g(m: U64) { let b = m & (18446744073709551616 | 1) }
"#, ["2:29 E0318 no integer type holds 18446744073709551616"])
    assert_errors("tree_without_parentheses", #"fn f(x: I8) { let b = x + 2 * 3 }
fn g(x: I8) { let c = x + 300 * 1 }
"#, ["2:27 E0318 300 does not fit in I8 (-128 to 127)"])
}

test "every literal of a tree that fits compiles, even when an operation overflows" {
    assert_errors("tree_fits_and_overflows", #"fn f(u: U8) { let a = u + (200 + 100) }
fn g(x: I8) { let b = (127 + 1) + x }
"#, [])
}

test "the shift amount tree is U32 and the shifted literal takes the tree's type" {
    assert_errors("tree_shift_amount_too_big", #"fn f(q: U64) -> U64 { q << (4294967296 - 1) }
"#, ["1:29 E0318 4294967296 does not fit in U32 (0 to 4294967295)"])
    assert_errors("tree_shift_left_takes_tree_type", #"fn f(u: U8) { let a = u & (256 << 1) }
"#, ["1:28 E0318 256 does not fit in U8 (0 to 255)"])
    assert_errors("tree_shift_amount_past_tree_width", #"fn f(u: U8) { let a = u & (1 << 9) }
fn g(u: U8) { let b = (1 << 7) | u }
"#, ["1:30 E0300 shift `<<` amount 9 out of range for U8 (must be 0..8)"])
    assert_errors("tree_shift_amount_past_expected_width", #"fn h() { let a: U8 = 1 << 9 }
fn k() { let b: U8 = (1 << 9) | 1 }
"#, [
        "1:24 E0300 shift `<<` amount 9 out of range for U8 (must be 0..8)",
        "2:25 E0300 shift `<<` amount 9 out of range for U8 (must be 0..8)",
    ])
}

// An amount of 64 or more is out of range for Int as well, so the message must name the type
// the tree takes and not the Int the tree has before it takes one.
test "a shift amount past the tree's width names the type the tree takes" {
    assert_errors("tree_shift_amount_past_int_width", #"type Byte = U8
fn f(u: U8) { let a = u & (1 << 70) }
fn g(u: U8) -> U8 { (1 << 64) | u }
fn h(b: Byte) { let c = b == (1 >> 9) }
fn k() { let d = 1 << 70 }
"#, [
        "2:30 E0300 shift `<<` amount 70 out of range for U8 (must be 0..8)",
        "3:24 E0300 shift `<<` amount 64 out of range for U8 (must be 0..8)",
        "4:33 E0300 shift `>>` amount 9 out of range for U8 (must be 0..8)",
        "5:20 E0300 shift `<<` amount 70 out of range for Int (must be 0..64)",
    ])
}

test "a shift of a value that is not an integer reports the left operand only" {
    assert_errors("shift_float_left_operand", #"fn f(x: Float) -> Float { x << 70 }
"#, ["1:29 E0300 shift `<<` requires integer left operand, got Float"])
}

// `-(2 * 3)` is a call to Neg, and unsigned types do not implement Neg (sections/03_types.md
// §3.2 *Integer literal range*), so the tree's unsigned type does not make it compile.
test "unary minus over a literal tree that takes an unsigned type is an error" {
    assert_errors("tree_neg_unsigned", #"fn f(u: U8) { let a = u + -(2 * 3) }
fn g(x: I8) { let b = x + -(2 * 3) }
"#, ["1:27 E0300 unary `-` requires a signed operand, got U8"])
}

test "a tree with a name in it is not a literal tree" {
    assert_errors("tree_with_name", #"fn f(x: I8) -> I8 {
    let n = 2
    x + (n * 3)
}
"#, ["3:7 E0300 binary `+`: incompatible types I8 and Int"])
}

test "a literal tree beside an operand that is not an integer reports the operator only" {
    assert_errors("tree_beside_float", #"fn f(x: Float) -> Float { x + (1 + 2) }
"#, ["1:29 E0300 binary `+`: incompatible types Float and Int"])
    assert_errors("wide_tree_beside_float", #"fn f(x: Float) -> Float { x + (9223372036854775808 + -9223372036854775809) }
"#, ["1:29 E0300 binary `+`: incompatible types Float and Int"])
}

// A tree beside an operand that nothing has solved yet does not wait for a later line, so the
// variable becomes Int, as it does beside a lone literal.
test "a literal tree beside a closure parameter makes the parameter Int" {
    assert_errors("tree_beside_closure_param", #"fn main() {
    let n: U64 = 3
    let h = fn(x) { (1 + 1) + x }
    io.println("{h(n)}")
}
"#, ["4:18 E0300 function `h` argument 0 expects Int, got U64"])
    assert_errors("tree_beside_closure_param_expected", #"fn main() {
    let n: U64 = 3
    let h = fn(x) {
        let r: U64 = x * (2 << 1)
        r
    }
    io.println("{h(n)}")
}
"#, [])
}
