// sections/03_types.md, "The `MapOps` Trait", fixes the Map method surface at nine
// methods, plus len/is_empty from Sized and contains from Contains. lib/std/traits.bl
// holds the written form of that surface, so the trait must declare those nine names and
// no other: a name only the trait has is a method users read and cannot call.
//
// The trait text is read from the file rather than asked of the typechecker because a
// probe resolves the prelude through the compiler that built this binary, whose stdlib is
// pinned; the file beside this test is the one the change lands in.
//
// Two of the nine are not callable yet (`entries`, `get_or_default`) and one non-spec name
// still is (`set`); those are open bugs against the method surface, not the trait text, so
// the resolution test below covers the seven the front end implements.
import lower_test_helpers.{probe, probe_but}

fn mapops_declared_methods() -> List[Str] {
    let text = read_file("lib/std/traits.bl")
    let lines = text.lines()
    let mut names: List[Str] = []
    let mut inside = false
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        if inside && line.starts_with("}") { return names }
        if inside {
            let decl = line.trim()
            if decl.starts_with("fn ") {
                let rest = decl.substring(3, decl.len())
                let open = rest.index_of("(")
                if open > 0 { names.push(rest.substring(0, open)) }
            }
        }
        if line.starts_with("pub trait MapOps[") { inside = true }
        i = i + 1
    }
    names
}

fn implemented_surface_src() -> Str {
    #"fn main() {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let got: Int = m.get("a").unwrap()
    let ks: List[Str] = m.keys()
    let vs: List[Int] = m.values()
    let had: Bool = m.contains_key("a")
    let n: Int = m.len()
    let empty: Bool = m.is_empty()
    m.remove("a")
    m.clear()
    assert(got == 1)
    assert(ks.len() == 1)
    assert(vs.len() == 1)
    assert(had)
    assert(n == 1)
    assert(empty == false)
}
"#
}

fn has_src() -> Str {
    #"fn main() {
    let m: Map[Str, Int] = Map()
    let b = m.has("x")
    assert(b == false)
}
"#
}

test "the MapOps trait declares every method the spec gives Map" {
    let names = mapops_declared_methods()
    assert(names.contains("get"))
    assert(names.contains("keys"))
    assert(names.contains("values"))
    assert(names.contains("entries"))
    assert(names.contains("get_or_default"))
    assert(names.contains("insert"))
    assert(names.contains("remove"))
    assert(names.contains("contains_key"))
    assert(names.contains("clear"))
}

test "the MapOps trait declares no method the spec withholds from Map" {
    let names = mapops_declared_methods()
    assert(names.contains("has") == false)
    assert(names.contains("set") == false)
    assert_eq(names.len(), 9)
}

test "every trait method the front end implements resolves on a Map receiver" {
    let program = probe("typecheck_map_implemented_surface", implemented_surface_src())
    assert(program >= 0)
}

test "a method the spec does not give Map does not resolve: has" {
    let program = probe_but("typecheck_map_no_has", has_src(), "UnresolvedMethod")
    assert(program >= 0)
}
