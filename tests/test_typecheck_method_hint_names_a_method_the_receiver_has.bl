// The help line under an UnresolvedMethod names a method to call instead. A hint that names
// the method the caller just wrote, or one this receiver does not answer, sends the reader
// in a circle, so every suggestion must be a method the receiver resolves.
import lower_test_helpers.{probe_but, assert_eq_str}
import diagnostics.{diag_entries}

fn unresolved_help() -> Str {
    let mut help = ""
    for d in diag_entries {
        if d.name == "UnresolvedMethod" { help = d.help }
    }
    help
}

fn set_add_src() -> Str {
    #"fn main() {
    let mut s: Set[Int] = Set()
    s.add(3)
}
"#
}

// `char_at` is a Str method, so the name-level builtin table holds it; a List does not
// answer it.
fn list_char_at_src() -> Str {
    #"fn main() {
    let xs: List[Str] = ["a"]
    let c = xs.char_at(0)
}
"#
}

// `index_of` is a builtin name both Str and List answer, so a typo of it on a List names it.
fn list_indexof_src() -> Str {
    #"fn main() {
    let xs: List[Str] = ["a"]
    let i = xs.indexof("a")
}
"#
}

fn list_lenn_src() -> Str {
    #"fn main() {
    let xs: List[Str] = ["a"]
    let n = xs.lenn()
}
"#
}

fn str_indexof_src() -> Str {
    #"fn main() {
    let s = "abc"
    let i = s.indexof("a")
}
"#
}

// `pussh` is one edit from `push`, a builtin name that a List answers and a Set does not.
fn set_pussh_src() -> Str {
    #"fn main() {
    let mut s: Set[Int] = Set()
    s.pussh(3)
}
"#
}

// The spec closes the Map surface, and `slice` is not in it.
fn map_slise_src() -> Str {
    #"fn main() {
    let m: Map[Str, Int] = Map()
    let e = m.slise(0, 1)
}
"#
}

test "set add names insert" {
    let program = probe_but("typecheck_hint_set_add", set_add_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "a Set is written with `.insert(value)`")
}

test "a list call to char_at is not told to call char_at" {
    let program = probe_but("typecheck_hint_list_char_at", list_char_at_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "")
}

test "a typo of index_of on a List names index_of" {
    let program = probe_but("typecheck_hint_list_indexof", list_indexof_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "did you mean `.index_of`?")
}

test "a real typo on a list still names the method" {
    let program = probe_but("typecheck_hint_list_lenn", list_lenn_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "did you mean `.len`?")
}

test "a typo of index_of on a Str names index_of" {
    let program = probe_but("typecheck_hint_str_indexof", str_indexof_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "did you mean `.index_of`?")
}

test "a set is not told to call a builtin name only other receivers have" {
    let program = probe_but("typecheck_hint_set_pussh", set_pussh_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "")
}

test "a map is not told to call a method outside its surface" {
    let program = probe_but("typecheck_hint_map_slise", map_slise_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "")
}
