// Whether a bare name names a type is one fact with one owner. Typecheck already decides it
// for every static call it types, over the compiler's own type names and the program's
// declarations together, and codegen has to read that decision rather than rebuild a
// smaller one: a qualifier only half of the readers know is a type is lowered as a value,
// and a type name is not a value.

import lower_test_helpers.{probe}
import typecheck.{tc_names_a_type}
import std.io

fn src() -> Str {
    #"type Parsed { n: Int }

type Shape {
    Circle(Int)
    Empty
}

fn helper(n: Int) -> Int { n }

fn main() {
    let p = Parsed { n: 1 }
    let s = Shape.Empty
    let _keep = helper(p.n)
    let _also = s
}
"#
}

fn expect(name: Str, want: Bool) {
    let got = tc_names_a_type(name)
    if got != want { io.println("FAIL: tc_names_a_type('{name}') answered {got}, want {want}") }
    assert(got == want)
}

test "a builtin scalar name is a type" {
    let _p = probe("names_a_type_builtin", src())
    expect("Char", true)
    expect("Int", true)
    expect("Str", true)
    expect("I8", true)
}

test "a builtin container or carrier name is a type" {
    let _p = probe("names_a_type_container", src())
    expect("Bytes", true)
    expect("StringBuilder", true)
    expect("Map", true)
    expect("Result", true)
}

test "a declared struct and a declared enum are types" {
    let _p = probe("names_a_type_declared", src())
    expect("Parsed", true)
    expect("Shape", true)
}

test "a function, a binding, a variant and an unknown word are not types" {
    let _p = probe("names_a_type_not", src())
    expect("helper", false)
    expect("p", false)
    expect("Empty", false)
    expect("io", false)
    expect("Nothing", false)
}
