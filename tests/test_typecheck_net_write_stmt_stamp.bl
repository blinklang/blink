// A statement-position namespace-intrinsic call answers a type like any other call: the
// prelude registers net.write and net.close under one signature table, and the arm that
// resolves a namespace call reads a return type off that table regardless of what the
// call's result is used for. This pins that both calls carry a concrete Void tid after
// typecheck, so a future regression in either the table or the resolving arm shows here
// first rather than as a codegen-side internal error with no type on the node.
import lower_test_helpers.{probe}
import parser.{node_kind, node_method, node_obj, node_name, nodes}
import ast.{NodeKind, nk_of}
import typecheck.{tc_lookup_node_tid, tc_tid_is_concrete, type_kind, TyKind}
import mono.{run_mono}
import std.io

fn qualified_call(qualifier: Str, member: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.MethodCall && node_method(i) == member {
            let obj = node_obj(i)
            if obj != -1 && nk_of(node_kind(obj)) == NodeKind.Ident && node_name(obj) == qualifier {
                return i
            }
        }
        i = i + 1
    }
    -1
}

fn src_net_write() -> Str {
    #"fn main() {
    let a = net.connect("localhost", 8080)
    net.write(a, "hello")
}
"#
}

test "a statement-position net.write call node carries a concrete Void tid" {
    run_mono(probe("tc_net_write_stamp", src_net_write()))
    let call = qualified_call("net", "write")
    if call < 0 {
        io.println("FAIL: no net.write call node found")
        assert(false)
    }
    let tid = tc_lookup_node_tid(call)
    if !tc_tid_is_concrete(tid) {
        io.println("FAIL: net.write call node has no concrete tid")
        assert(false)
    }
    assert_eq(type_kind(tid), TyKind.Void)
}

fn src_net_close() -> Str {
    #"fn main() {
    let a = net.connect("localhost", 8080)
    net.close(a)
}
"#
}

test "a statement-position net.close call node carries a concrete Void tid" {
    run_mono(probe("tc_net_close_stamp", src_net_close()))
    let call = qualified_call("net", "close")
    if call < 0 {
        io.println("FAIL: no net.close call node found")
        assert(false)
    }
    let tid = tc_lookup_node_tid(call)
    if !tc_tid_is_concrete(tid) {
        io.println("FAIL: net.close call node has no concrete tid")
        assert(false)
    }
    assert_eq(type_kind(tid), TyKind.Void)
}
