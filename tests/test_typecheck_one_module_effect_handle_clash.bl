// Two top-level effects of one module whose lowercase names are equal give one handle, so the
// second declaration is EffectHandleCollision (E0562) at its name, with a note at the first
// (sections/04_effects.md §4.12 *Two effects of one module with one handle*). It is a rule
// about declarations, so it holds with no use of the handle.
import lower_test_helpers.{probe_but}
import diagnostics.{diag_entries}

fn rows(stem: Str, source: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO, Env.Write, Process.Spawn {
    let program = probe_but(stem, source, "EffectHandleCollision")
    assert(program >= 0)
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity != "error" { continue }
        out.push("{d.name} {d.code} {d.line}:{d.col}: {d.message}")
    }
    out
}

fn notes_of(code: Str) -> List[Str] {
    for d in diag_entries {
        if d.code == code { return d.notes }
    }
    []
}

test "a second effect of one module with the same handle is E0562 at its name" {
    let got = rows("handle_clash_pair", #"effect Ab { effect Go { fn ping() -> Int } }
effect AB { effect Go { fn pong() -> Int } }
fn main() {}
"#)
    assert_eq(got, ["EffectHandleCollision E0562 2:8: `AB` has the handle `ab`, the handle of `Ab`"])
    let notes = notes_of("E0562")
    assert(notes.len() == 1)
    assert(notes.get(0).unwrap().contains("`Ab` is declared here"))
    assert(notes.get(0).unwrap().contains(":1:8"))
}

test "two effects whose names differ only in case and op set clash" {
    let got = rows("handle_clash_metrics", #"effect Metrics { effect Emit { fn counter(name: Str) } }
effect METRICS { effect Emit { fn counter(name: Str) } }
fn main() {}
"#)
    assert_eq(got, ["EffectHandleCollision E0562 2:8: `METRICS` has the handle `metrics`, the handle of `Metrics`"])
}

test "an effect with its own handle beside a clashing pair is not reported" {
    let got = rows("handle_clash_beside", #"effect Ab { effect Go { fn ping() -> Int } }
effect AB { effect Go { fn ping() -> Int } }
effect Cd { effect Go { fn ping() -> Int } }
fn main() {}
"#)
    assert_eq(got, ["EffectHandleCollision E0562 2:8: `AB` has the handle `ab`, the handle of `Ab`"])
}
