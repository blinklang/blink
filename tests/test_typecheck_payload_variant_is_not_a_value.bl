// A variant that takes a payload is not a function value: the spec gives no rule that makes a
// constructor first-class, so naming one with no argument list is a user error, never an
// internal compiler error, and never a silent value of the enum type. The help offers a closure
// that calls the constructor. A variant with no payload stays a value.

import compile_test_helpers

fn expect_not_a_value(decls: Str, body: Str, tag: Str, msg: Str, help: Str) {
    let src = "{decls}fn main() \{\n{body}\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, msg, "{tag} names the variant")
    compile_test_helpers.expect_contains(out, help, "{tag} offers the closure")
    assert(!out.contains("\"severity\":\"ice\""))
}

test "bare Some named as a value is rejected" {
    expect_not_a_value("", "    let f = Some\n    let _ = f", "payload_value_some", "variant `Some` takes 1 argument(s) and is not a function value", "fn(x) \{ Some(x) \}")
}

test "qualified Option.Some named as a value is rejected" {
    expect_not_a_value("", "    let f = Option.Some\n    let _ = f", "payload_value_q_some", "variant `Some` takes 1 argument(s) and is not a function value", "fn(x) \{ Option.Some(x) \}")
}

test "bare Ok named as a value is rejected" {
    expect_not_a_value("", "    let f = Ok\n    let _ = f", "payload_value_ok", "variant `Ok` takes 0 or 1 argument(s) and is not a function value", "fn(x) \{ Ok(x) \}")
}

test "qualified Result.Ok named as a value is rejected" {
    expect_not_a_value("", "    let f = Result.Ok\n    let _ = f", "payload_value_q_ok", "variant `Ok` takes 0 or 1 argument(s) and is not a function value", "fn(x) \{ Result.Ok(x) \}")
}

test "bare Err named as a value is rejected" {
    expect_not_a_value("", "    let f = Err\n    let _ = f", "payload_value_err", "variant `Err` takes 1 argument(s) and is not a function value", "fn(x) \{ Err(x) \}")
}

test "a carrier constructor passed to map is rejected" {
    expect_not_a_value("", "    let xs = [1, 2]\n    let ys = xs.map(Some)\n    let _ = ys", "payload_value_map_some", "variant `Some` takes 1 argument(s) and is not a function value", "fn(x) \{ Some(x) \}")
}

test "a carrier constructor under a fn annotation is rejected" {
    expect_not_a_value("", "    let f: fn(Int) -> Option[Int] = Some\n    let _ = f", "payload_value_annotated_some", "variant `Some` takes 1 argument(s) and is not a function value", "fn(x) \{ Some(x) \}")
}

test "a bare user payload variant named as a value is rejected" {
    expect_not_a_value("type Wrap \{ Leaf(Int) \}\n", "    let f = Leaf\n    let _ = f", "payload_value_user", "variant `Leaf` takes 1 argument(s) and is not a function value", "fn(x: Int) \{ Leaf(x) \}")
}

test "a user payload variant under its enum annotation is rejected" {
    expect_not_a_value("type Wrap \{ Leaf(Int) \}\n", "    let w: Wrap = Leaf\n    let _ = w", "payload_value_user_annotated", "variant `Leaf` takes 1 argument(s) and is not a function value", "fn(x: Int) \{ Leaf(x) \}")
}

test "a qualified user payload variant named as a value is rejected" {
    expect_not_a_value("type Pair \{ Two(Int, Str) \}\n", "    let f = Pair.Two\n    let _ = f", "payload_value_user_qualified", "variant `Two` takes 2 argument(s) and is not a function value", "fn(x1: Int, x2: Str) \{ Pair.Two(x1, x2) \}")
}

test "a user payload variant passed to a function is rejected" {
    expect_not_a_value("type Wrap \{ Leaf(Int) \}\nfn apply(f: fn(Int) -> Wrap, n: Int) -> Wrap \{ f(n) \}\n", "    let w = apply(Leaf, 1)\n    let _ = w", "payload_value_user_passed", "variant `Leaf` takes 1 argument(s) and is not a function value", "fn(x: Int) \{ Leaf(x) \}")
}

test "the closure the help offers compiles" {
    let src = "type Wrap \{ Leaf(Int) \}\ntype Pair \{ Two(Int, Str) \}\nfn main() \{\n    let xs = [1, 2]\n    let ys = xs.map(fn(x) \{ Some(x) \})\n    let f = fn(x: Int) \{ Leaf(x) \}\n    let g = fn(x1: Int, x2: Str) \{ Pair.Two(x1, x2) \}\n    let _ = (ys, f(1), g(2, \"b\"))\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "payload_value_help_compiles")
    compile_test_helpers.expect_compiles_clean(out, "payload_value_help_compiles")
}

test "a variant with no payload stays a value" {
    let src = "type Color \{ Red\n Green \}\nfn main() \{\n    let a: Option[Int] = None\n    let b: Option[Int] = Option.None\n    let c = Red\n    let d = Color.Green\n    let _ = (a, b, c, d)\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "payload_value_nullary_ok")
    compile_test_helpers.expect_compiles_clean(out, "payload_value_nullary_ok")
}

test "a type named like its own payload variant still heads a static call" {
    let src = "type Errno \{ Errno(Int) \}\nimpl From[Int] for Errno \{ fn from(x: Int) -> Errno \{ Errno(x) \} \}\ntrait Zero \{ fn zero() -> Self \}\nimpl Zero for Errno \{ fn zero() -> Errno \{ Errno(0) \} \}\ntype Key \{ Char(ch: Char) \}\nfn main() \{\n    let e = Errno.from(3)\n    let z = Errno.zero()\n    let c = Char.from_code_point(97)\n    let k = Key.Char(ch: 'a')\n    let _ = (e, z, c, k)\n\}\n"
    let out = compile_test_helpers.compile_and_capture(src, "payload_value_type_head")
    compile_test_helpers.expect_compiles_clean(out, "payload_value_type_head")
}

test "a payload variant named like its type is rejected as a value" {
    expect_not_a_value("type Errno \{ Errno(Int) \}\n", "    let e: Errno = Errno\n    let _ = e", "payload_value_type_namesake", "variant `Errno` takes 1 argument(s) and is not a function value", "fn(x: Int) \{ Errno(x) \}")
}
