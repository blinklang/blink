// Ptr[Int] and Ptr[Float] are two types. Unification must compare what a pointer points
// at, as it does for a List's element; else a list whose element type is still being
// solved takes both pointers as one type. The List twin is the control: the same shape
// over List[Int] and List[Float] is refused today.
import cg_test_helpers.{cg_probe_begin, cg_probe_errors_named}
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries}
import std.io

// The empty list leaves the element type unsolved, which sends the check through
// unification rather than a plain comparison; that also draws CannotInferType for `xs`.
fn type_errors_in(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    env.set_var("BLINK_ROOT", process_run("pwd", []).out.trim())
    let path = "build/{stem}_probe.bl"
    cg_probe_begin(path)
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process_run("rm", ["-f", path])
    let mut others = 0
    for d in diag_entries {
        if d.severity == "error" && d.name != "TypeError" && d.name != "CannotInferType" {
            io.println("FAIL: {stem} recorded an error the row does not expect: {d.name}: {d.message}")
            others = others + 1
        }
    }
    assert_eq(others, 0)
    cg_probe_errors_named("TypeError")
}

fn pointer_src() -> Str {
    #"fn main() {
    with ffi.scope() as scope {
        let p: Ptr[Int] = scope.alloc()
        let q: Ptr[Float] = scope.alloc()
        let xs = [(p, []), (q, [1])]
        io.println("{xs.len()}")
    }
}
"#
}

fn list_src() -> Str {
    #"fn main() {
    let p: List[Int] = [1]
    let q: List[Float] = [1.5]
    let xs = [(p, []), (q, [1])]
    io.println("{xs.len()}")
}
"#
}

test "a list refuses two pointers to different types while its element type is unsolved" {
    assert_eq(type_errors_in("typecheck_pointer_pointees", pointer_src()), 1)
}

test "a list refuses two lists of different types while its element type is unsolved" {
    assert_eq(type_errors_in("typecheck_list_elements_control", list_src()), 1)
}
