// sections/07_trust_modules_metadata.md §9.1.3: `p.field` through a `Ptr[T]` is defined for an
// `@ffi.struct T` alone, and the `.read()` / `.write(v)` pair on it is claimed on that same
// pointee. Both halves must ask one question, or a `Ptr[plain struct]` that E0810 already
// refused types its field at the field's own type and puts `read` and `write` on an Int.
//
// The opaque and scalar rows pin what the other pointees keep: their methods type as before.
import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types, tc_lookup_node_tid, tc_tid_is_concrete, tc_tid_kind, TyKind, TYPE_VOID}
import parser.{nodes, node_kind, node_name, node_method, node_body, node_obj, node_value_child_ids}
import ast.{NodeKind}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn ffi_struct_src() -> Str {
    #"@ffi.struct(header: "poll.h", name: "pollfd")
type Pollfd { fd: I32, events: I16, revents: I16 }

@trusted(audit: "ptr-field-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[Pollfd] = scope.alloc()
        p.fd.write(7)
        let v = p.fd.read()
        io.println("{v}")
    }
}

fn main() ! FFI { go() }
"#
}

fn plain_struct_src() -> Str {
    #"type Zs { zf: Int }

@trusted(audit: "ptr-field-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let zp: Ptr[Zs] = scope.alloc()
        zp.zf.write(9)
        let v = zp.zf.read()
        io.println("{v}")
    }
}

fn main() ! FFI { go() }
"#
}

fn opaque_src() -> Str {
    #"@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile

@trusted(audit: "ptr-field-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[CFile] = scope.alloc()
        io.println("{p.is_null()}")
    }
}

fn main() ! FFI { go() }
"#
}

fn scalar_src() -> Str {
    #"@trusted(audit: "ptr-field-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[I32] = scope.alloc()
        p.write(3)
        let v = p.deref()
        io.println("{v} {p.is_null()}")
    }
}

fn main() ! FFI { go() }
"#
}

fn compile_probe(path: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    program
}

fn body_of(nm: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == nm { return node_body(i) }
        i = i + 1
    }
    -1
}

// Walks the body's own subtree: the prelude calls `read` and `write` too.
fn call_in(body: Int, method: Str) -> Int {
    if body == -1 { return -1 }
    let mut stack: List[Int] = [body]
    while stack.len() > 0 {
        let n = stack.pop().unwrap()
        if node_kind(n) == NodeKind.MethodCall && node_method(n) == method { return n }
        for kid in node_value_child_ids(n) { stack.push(kid) }
    }
    -1
}

fn error_count() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" {
            io.println("  diag: {d.code} {d.name}: {d.message}")
            n = n + 1
        }
    }
    n
}

test "a field through a Ptr to an ffi.struct types at the field type and its pair is claimed" {
    let _p = compile_probe("build/tc_ptr_field_ffi_struct.bl", ffi_struct_src())
    assert_eq(error_count(), 0)
    let read = call_in(body_of("go"), "read")
    let write = call_in(body_of("go"), "write")
    assert(read >= 0 && write >= 0)
    let field_t = tc_lookup_node_tid(node_obj(read))
    assert_eq(tc_tid_is_concrete(field_t), 1)
    assert(tc_tid_kind(field_t) == TyKind.I32)
    assert_eq(tc_lookup_node_tid(read), field_t)
    assert_eq(tc_lookup_node_tid(write), TYPE_VOID)
}

// E0810 already refused the pointee, so the field is poisoned and nothing reads it as an Int.
test "a field through a Ptr to a plain struct gives the one E0810 and nothing downstream" {
    let _p = compile_probe("build/tc_ptr_field_plain_struct.bl", plain_struct_src())
    assert_eq(error_count(), 1)
    let d = diag_entries.get(0).unwrap()
    assert_eq(d.name, "InvalidPtrType")
    assert_eq(d.code, "E0810")
    let read = call_in(body_of("go"), "read")
    assert(read >= 0)
    assert(tc_tid_kind(tc_lookup_node_tid(node_obj(read))) == TyKind.Unknown)
}

test "a Ptr to an ffi.opaque handle keeps its null check" {
    let _p = compile_probe("build/tc_ptr_field_opaque.bl", opaque_src())
    assert_eq(error_count(), 0)
    let call = call_in(body_of("go"), "is_null")
    assert(call >= 0)
    assert(tc_tid_kind(tc_lookup_node_tid(call)) == TyKind.Bool)
}

test "a Ptr to a scalar keeps deref, write and its null check" {
    let _p = compile_probe("build/tc_ptr_field_scalar.bl", scalar_src())
    assert_eq(error_count(), 0)
    let deref = call_in(body_of("go"), "deref")
    let write = call_in(body_of("go"), "write")
    let is_null = call_in(body_of("go"), "is_null")
    assert(deref >= 0 && write >= 0 && is_null >= 0)
    assert(tc_tid_kind(tc_lookup_node_tid(deref)) == TyKind.I32)
    assert_eq(tc_lookup_node_tid(write), TYPE_VOID)
    assert(tc_tid_kind(tc_lookup_node_tid(is_null)) == TyKind.Bool)
}
