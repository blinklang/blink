// sections/07_trust_modules_metadata.md, §9.1.3: a `Ptr[T]` pointee must be one of the
// FFI-compatible types, and a C record reaches Blink only as an `@ffi.struct`. The typed
// field pair `p.field.read()` / `p.field.write(v)` is given to `Ptr[@ffi.struct T]` alone.
//
// E0810 already says that, but only a parameter or a return type was ever measured
// against it, so a `let` annotation named any pointee at all. A plain struct behind a
// pointer then typed `p.f` at the field's own type, which put `read` and `write` on an
// Int, and the front end passed a program no back end can lower.
import lower_test_helpers.{probe, probe_but}

fn plain_pointee_let_src() -> Str {
    #"type Zs { zf: Int }

@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let zp: Ptr[Zs] = scope.alloc()
        zp.zf.write(9)
        io.println("{zp.zf.read()}")
    }
}

fn main() ! FFI { go() }
"#
}

fn ffi_struct_pointee_let_src() -> Str {
    #"@ffi.struct(header: "poll.h", name: "pollfd")
type Pollfd { fd: I32, events: I16, revents: I16 }

@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[Pollfd] = scope.alloc()
        p.fd.write(7)
        io.println("{p.fd.read()}")
    }
}

fn main() ! FFI { go() }
"#
}

fn scalar_pointee_let_src() -> Str {
    #"@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[U8] = scope.alloc_n(4)
        let q: Ptr[Void] = scope.alloc()
        io.println("{p.is_null()} {q.is_null()}")
    }
}

fn main() ! FFI { go() }
"#
}

fn plain_pointee_param_src() -> Str {
    #"type Zs { zf: Int }

@ffi("zs_peek")
@trusted(audit: "ptr-pointee-test")
fn zs_peek(p: Ptr[Zs]) -> Int ! FFI { }

fn main() { }
"#
}

fn plain_pointee_nested_let_src() -> Str {
    #"type Zs { zf: Int }

@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let zs: List[Ptr[Zs]] = []
        io.println("{zs.len()}")
    }
}

fn main() ! FFI { go() }
"#
}

test "a let annotation whose pointee is a plain struct is refused" {
    let program = probe_but("tc_ptr_pointee_plain_let", plain_pointee_let_src(), "InvalidPtrType")
    assert(program >= 0)
}

test "a let annotation whose pointee is an ffi.struct is accepted with its field pair" {
    let program = probe("tc_ptr_pointee_ffi_struct_let", ffi_struct_pointee_let_src())
    assert(program >= 0)
}

test "a let annotation whose pointee is a scalar or Void is accepted" {
    let program = probe("tc_ptr_pointee_scalar_let", scalar_pointee_let_src())
    assert(program >= 0)
}

test "a parameter whose pointee is a plain struct is still refused" {
    let program = probe_but("tc_ptr_pointee_plain_param", plain_pointee_param_src(), "InvalidPtrType")
    assert(program >= 0)
}

// The annotation is walked, not matched at its head: a pointer named inside another type
// carries the same pointee rule.
test "a plain struct pointee nested inside a let annotation is refused" {
    let program = probe_but("tc_ptr_pointee_plain_nested", plain_pointee_nested_let_src(), "InvalidPtrType")
    assert(program >= 0)
}

// Every place a type can be written resolves its annotation the same way, so the pointee rule
// holds at each of them, and not only where a declaration happened to ask for it.
fn plain_decl_src(decl: Str) -> Str {
    "type Zs \{ zf: Int }\n\n".concat(decl).concat("\nfn main() \{ }\n")
}

fn ffi_decl_src(decl: Str) -> Str {
    let ffi = #"@ffi.struct(header: "poll.h", name: "pollfd")
type Zs { fd: I32, events: I16, revents: I16 }
"#
    ffi.concat("\n").concat(decl).concat("\nfn main() \{ }\n")
}

// The declaration comes after its uses, so the check cannot rely on source order.
fn ffi_decl_after_src(decl: Str) -> Str {
    let ffi = #"@ffi.struct(header: "poll.h", name: "pollfd")
type Zs { fd: I32, events: I16, revents: I16 }
"#
    decl.concat("\n").concat(ffi).concat("\nfn main() \{ }\n")
}

fn alias_decl() -> Str { "type ZP = Ptr[Zs]\n" }
fn field_decl() -> Str { "type W \{ p: Ptr[Zs] }\n" }
fn named_payload_decl() -> Str { "type E \{ A(p: Ptr[Zs]), B }\n" }
fn payload_decl() -> Str { "type E \{ A(Ptr[Zs]), B }\n" }
fn global_decl() -> Str { "let zg: List[Ptr[Zs]] = []\n" }
fn trait_sig_decl() -> Str { "trait Zt \{\n    fn peek(self, p: Ptr[Zs]) -> Int\n}\n" }

fn closure_param_decl() -> Str {
    #"@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    let f = fn(p: Ptr[Zs]) -> Bool { p.is_null() }
    io.println("x")
}
"#
}

fn closure_return_decl() -> Str {
    #"@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    let f = fn(q: Ptr[Zs]) -> Ptr[Zs] { q }
    io.println("x")
}
"#
}

fn impl_method_decl() -> Str {
    #"type Hz { n: Int }
trait Zt {
    fn put(self, q: Ptr[Zs]) -> Int
}
impl Zt for Hz {
    fn put(self, q: Ptr[Zs]) -> Int { self.n }
}
"#
}

fn effect_op_decl() -> Str {
    #"effect Zeff {
    effect Op {
        fn put(p: Ptr[Zs])
    }
}
"#
}

fn effect_op_ret_decl() -> Str {
    #"effect Zeff {
    effect Op {
        fn get() -> Ptr[Zs]
    }
}
"#
}

fn nested_let_decl() -> Str {
    #"@trusted(audit: "ptr-pointee-test")
fn go() ! FFI {
    with ffi.scope() as scope {
        let zp: Ptr[Ptr[Zs]] = scope.alloc()
        io.println("{zp.is_null()}")
    }
}
"#
}

fn nested_param_decl() -> Str {
    #"@ffi("zs_pp")
@trusted(audit: "ptr-pointee-test")
fn zs_pp(p: Ptr[Ptr[Zs]]) -> Int ! FFI { }
"#
}

test "a type alias whose pointee is a plain struct is refused" {
    assert(probe_but("tc_ptr_pointee_alias", plain_decl_src(alias_decl()), "InvalidPtrType") >= 0)
}

test "a struct field whose pointee is a plain struct is refused" {
    assert(probe_but("tc_ptr_pointee_field", plain_decl_src(field_decl()), "InvalidPtrType") >= 0)
}

test "an enum payload whose pointee is a plain struct is refused, named or positional" {
    assert(probe_but("tc_ptr_pointee_named_payload", plain_decl_src(named_payload_decl()), "InvalidPtrType") >= 0)
    assert(probe_but("tc_ptr_pointee_payload", plain_decl_src(payload_decl()), "InvalidPtrType") >= 0)
}

test "a closure parameter or return whose pointee is a plain struct is refused" {
    assert(probe_but("tc_ptr_pointee_closure_param", plain_decl_src(closure_param_decl()), "InvalidPtrType") >= 0)
    assert(probe_but("tc_ptr_pointee_closure_ret", plain_decl_src(closure_return_decl()), "InvalidPtrType") >= 0)
}

test "a trait or impl method signature whose pointee is a plain struct is refused" {
    assert(probe_but("tc_ptr_pointee_trait_sig", plain_decl_src(trait_sig_decl()), "InvalidPtrType") >= 0)
    assert(probe_but("tc_ptr_pointee_impl_sig", plain_decl_src(impl_method_decl()), "InvalidPtrType") >= 0)
}

test "an effect operation whose pointee is a plain struct is refused" {
    assert(probe_but("tc_ptr_pointee_effect_param", plain_decl_src(effect_op_decl()), "InvalidPtrType") >= 0)
    assert(probe_but("tc_ptr_pointee_effect_ret", plain_decl_src(effect_op_ret_decl()), "InvalidPtrType") >= 0)
}

test "a top-level let whose pointee is a plain struct is refused" {
    assert(probe_but("tc_ptr_pointee_global", plain_decl_src(global_decl()), "InvalidPtrType") >= 0)
}

// A pointer to a pointer is legal, and the rule applies again to what the inner one points at.
test "a plain struct behind a pointer to a pointer is refused" {
    assert(probe_but("tc_ptr_pointee_nested_ptr_let", plain_decl_src(nested_let_decl()), "InvalidPtrType") >= 0)
    assert(probe_but("tc_ptr_pointee_nested_ptr_param", plain_decl_src(nested_param_decl()), "InvalidPtrType") >= 0)
}

test "an ffi.struct pointee is accepted in declarations, before or after its own declaration" {
    for decl in [alias_decl(), field_decl(), named_payload_decl(), payload_decl(), nested_param_decl()] {
        assert(probe("tc_ptr_pointee_ffi_decl", ffi_decl_src(decl)) >= 0)
        assert(probe("tc_ptr_pointee_ffi_decl_after", ffi_decl_after_src(decl)) >= 0)
    }
}

// A type parameter is not a pointee yet: what it stands for is known only per instantiation.
fn generic_struct_decl() -> Str { "type GS[T] \{ p: Ptr[T] }\n" }
fn generic_enum_decl() -> Str { "type GE[T] \{ V \{ p: Ptr[T] } Nil }\n" }
fn generic_fn_decl() -> Str {
    #"@trusted(audit: "p")
fn hold[T]() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[T] = scope.alloc()
        io.println("{p.is_null()}")
    }
}
"#
}

test "a type parameter pointee is not judged where it is declared" {
    for decl in [generic_struct_decl(), generic_enum_decl(), generic_fn_decl()] {
        assert(probe("tc_ptr_pointee_typevar", plain_decl_src(decl)) >= 0)
    }
}
