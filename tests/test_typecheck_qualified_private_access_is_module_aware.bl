// Whether a qualified access reaches a private declaration is a question about the module
// named by the qualifier. The predicate asked only whether the CURRENT module privately
// declares the spelling, so a reader that happened to declare its own non-pub function of
// the same name was folded into the set of private declarers and the call passed.

import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

fn probe(path: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    diag_reset()
    check_types(compile_to_program(path, 1))
}

fn errors() -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    out
}

fn has_error_naming(name: Str, subject: Str) -> Bool {
    for e in errors() {
        if e.starts_with("{name}: ") && e.contains(subject) { return true }
    }
    false
}

test "a qualified call to another module's private function is refused even where the reader declares the same name" {
    probe("tests/zzcd_calls/src/main_qualified_private_shadowed.bl")
    if !has_error_naming("PrivateItemAccess", "zzcd_stash") {
        io.println("FAIL: no PrivateItemAccess for 'zzcd_stash'; got:")
        for e in errors() { io.println("  {e}") }
    }
    assert(has_error_naming("PrivateItemAccess", "zzcd_stash"))
}

// The reader's own declaration of that spelling is its own, and a namesake in another module
// has nothing to say about it.
test "the reader's own private function of that name still resolves bare" {
    probe("tests/zzcd_calls/src/main_private_namesake_bare.bl")
    let errs = errors()
    if errs.len() != 0 {
        io.println("FAIL: the reader's own namesake reported:")
        for e in errs { io.println("  {e}") }
    }
    assert(errs.len() == 0)
}
