// `rand.<name>` always means the `rand` handle, so a call of a std.random helper through it,
// such as `rand.shuffle(deck)`, is E0505. The diagnostic lists the operations of `Rand`, names
// both spellings (`rand` is the handle, the qualifier is the module) and gives the first fix of
// the candidate walk that resolves the callee to the helper and adds no diagnostic: reuse a
// binding the file has, else add `import std.random` and call through `random`. A call that
// would not type-check with the new callee gets help only (sections/04_effects.md §4.4.7).
import lower_test_helpers.{probe_but}
import diagnostics.{diag_entries}

let OPS_NOTE = "`Rand` operations are `int`, `float`, `bytes`"

// One row per error, and per UnknownMethod warning, which a resolved E0505 must not repeat.
fn rows(stem: Str, src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO, Env.Write, Process.Spawn {
    let program = probe_but(stem, src, "UnresolvedMethod")
    assert(program >= 0)
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity != "error" && d.name != "UnknownMethod" { continue }
        let mut row = "{d.name} {d.code} {d.line}:{d.col}: {d.message} | help: {d.help} | notes: {d.notes.join(\"; \")}"
        if d.fix_action != "" {
            row = row.concat(" | fix: {d.fix_action} `{d.fix_text}` at {d.fix_line}:{d.fix_col}-{d.fix_end_line}:{d.fix_end_col}")
        }
        for m in d.fix_more {
            row = row.concat(" | and: `{m.text}` at {m.line}:{m.col}-{m.end_line}:{m.end_col}")
        }
        out.push(row)
    }
    out
}

fn help(name: Str, qualifier: Str) -> Str {
    "`{name}` is a function in module `std.random`; `rand` is the handle of `Rand` and `{qualifier}` is the module"
}

fn head(name: Str) -> Str {
    "UnresolvedMethod E0505 2:5: `{name}` is not an operation of effect `Rand` | help: {help(name, \"random\")} | notes: {OPS_NOTE}"
}

let ADD_IMPORT = "add `import std.random` and call"

test "rand.shuffle is E0505 with a fix that adds import std.random and calls random.shuffle" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_shuffle_no_imports", src), [
        head("shuffle").concat(" | fix: {ADD_IMPORT} `random.shuffle(deck)` at 2:5-2:23 | and: `import std.random\n\n` at 1:1-1:1"),
    ])
}

test "the import goes after the last import of the file" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    let top: Option[Int] = rand.choice(deck)
    deck
}
"#
    let with_import = "import std.fs\n\n".concat(src).concat("\nfn main() \{}\n")
    let got = rows("rs_choice_after_import", with_import)
    assert_eq(got.len(), 1)
    assert(got.get(0).unwrap().contains("| fix: {ADD_IMPORT} `random.choice(deck)` at 4:28-4:45 | and: `\nimport std.random` at 1:14-1:14"))
}

test "a call that runs over lines gets the callee rewritten and keeps its arguments as written" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(
        deck,
    )
}

fn main() {}
"#
    assert_eq(rows("rs_shuffle_multiline", src), [
        head("shuffle").concat(" | fix: {ADD_IMPORT} `random.shuffle` at 2:5-2:17 | and: `import std.random\n\n` at 1:1-1:1"),
    ])
}

test "a name that is no helper lists the operations and gets no help or fix" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.mix(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_not_a_helper", src), [
        "UnresolvedMethod E0505 2:5: `mix` is not an operation of effect `Rand` | help:  | notes: {OPS_NOTE}",
    ])
}

test "a file with its own function of the helper's name still gets the qualified call" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn shuffle(xs: List[Int]) -> List[Int] {
    xs
}

fn main() {}
"#
    assert_eq(rows("rs_own_shuffle_fn", src), [
        head("shuffle").concat(" | fix: {ADD_IMPORT} `random.shuffle(deck)` at 2:5-2:23 | and: `import std.random\n\n` at 1:1-1:1"),
    ])
}

test "a local of the helper's name still gets the qualified call" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    let shuffle = 3
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_local_shuffle", src), [
        "UnresolvedMethod E0505 3:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")} | notes: {OPS_NOTE} | fix: {ADD_IMPORT} `random.shuffle(deck)` at 3:5-3:23 | and: `import std.random\n\n` at 1:1-1:1",
    ])
}

test "an import that binds the name to another helper gets a call through the qualifier it binds" {
    let src = #"import std.random.{choice as shuffle}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_alias_target_shuffle", src), [
        "UnresolvedMethod E0505 4:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")} | notes: {OPS_NOTE} | fix: call `random.shuffle(deck)` at 4:5-4:23",
    ])
}

test "two helpers called through the handle carry the same import edit, so blink fix can apply both" {
    let src = #"fn deal(deck: List[Int]) -> Option[Int] ! Rand {
    let d: List[Int] = rand.shuffle(deck)
    rand.choice(d)
}

fn main() {}
"#
    let edit = "| and: `import std.random\n\n` at 1:1-1:1"
    assert_eq(rows("rs_shuffle_and_choice", src), [
        "UnresolvedMethod E0505 2:24: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")} | notes: {OPS_NOTE} | fix: {ADD_IMPORT} `random.shuffle(deck)` at 2:24-2:42 {edit}",
        "UnresolvedMethod E0505 3:5: `choice` is not an operation of effect `Rand` | help: {help(\"choice\", \"random\")} | notes: {OPS_NOTE} | fix: {ADD_IMPORT} `random.choice(d)` at 3:5-3:19 {edit}",
    ])
}

// Line 4 of a file whose first line imports std.random.
fn reuse_row(qualifier: Str, rest: Str) -> Str {
    "UnresolvedMethod E0505 4:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", qualifier)} | notes: {OPS_NOTE}{rest}"
}

fn deal_after(import_line: Str) -> Str {
    import_line.concat("\n\nfn deal(deck: List[Int]) -> List[Int] ! Rand \{\n    rand.shuffle(deck)\n}\n\nfn main() \{}\n")
}

test "a whole import of std.random gets a call through random and no import edit" {
    assert_eq(rows("rs_reuse_whole", deal_after("import std.random")), [
        reuse_row("random", " | fix: call `random.shuffle(deck)` at 4:5-4:23"),
    ])
}

test "a selective import of the helper gets the bare call and no rewrite to the qualified form" {
    assert_eq(rows("rs_reuse_selected", deal_after("import std.random.\{shuffle}")), [
        reuse_row("random", " | fix: call `shuffle(deck)` at 4:5-4:23"),
    ])
}

test "a selective import of another helper gets a call through random and no merge into its list" {
    assert_eq(rows("rs_reuse_other_selected", deal_after("import std.random.\{choice}")), [
        reuse_row("random", " | fix: call `random.shuffle(deck)` at 4:5-4:23"),
    ])
}

test "an import of std.random under an alias gets a call through the alias, which the help names" {
    assert_eq(rows("rs_reuse_alias", deal_after("import std.random as r")), [
        reuse_row("r", " | fix: call `r.shuffle(deck)` at 4:5-4:23"),
    ])
}

test "a call with the wrong number of arguments gets help only, with the count" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck, 3)
}

fn main() {}
"#
    assert_eq(rows("rs_shuffle_arity", src), [
        "UnresolvedMethod E0505 2:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}\n`random.shuffle` takes 1 argument, found 2 | notes: {OPS_NOTE}",
    ])
}

test "a call whose argument does not fit the helper gets help only, with the mismatch" {
    let src = #"fn deal(n: Int) -> List[Int] ! Rand {
    rand.shuffle(n)
}

fn main() {}
"#
    assert_eq(rows("rs_shuffle_arg_type", src), [
        "UnresolvedMethod E0505 2:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}\nargument 1 of `random.shuffle` expects List[T], got Int | notes: {OPS_NOTE}",
    ])
}

test "a label on a positional parameter of the helper gets help only" {
    let src = #"fn top(deck: List[Int]) -> Option[Int] ! Rand {
    rand.choice(xs: deck)
}

fn main() {}
"#
    assert_eq(rows("rs_choice_label", src), [
        "UnresolvedMethod E0505 2:5: `choice` is not an operation of effect `Rand` | help: {help(\"choice\", \"random\")}\n`xs` is a positional parameter of `random.choice` | notes: {OPS_NOTE}",
    ])
}

test "a helper whose result does not fit the return type gets help only" {
    let src = #"fn top(deck: List[Int]) -> Int ! Rand {
    rand.choice(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_choice_tail_type", src), [
        "UnresolvedMethod E0505 2:5: `choice` is not an operation of effect `Rand` | help: {help(\"choice\", \"random\")}\n`random.choice` returns Option[Int], and Int is expected here | notes: {OPS_NOTE}",
    ])
}

test "a helper whose result does not fit the declared type of its let gets help only" {
    let src = #"fn top(deck: List[Int]) -> Int ! Rand {
    let n: Int = rand.choice(deck)
    n
}

fn main() {}
"#
    assert_eq(rows("rs_choice_let_type", src), [
        "UnresolvedMethod E0505 2:18: `choice` is not an operation of effect `Rand` | help: {help(\"choice\", \"random\")}\n`random.choice` returns Option[Int], and Int is expected here | notes: {OPS_NOTE}",
    ])
}

// The fix is given only where the place declares the type the call must have, which the
// helper's result then is checked against. Elsewhere nothing proves the fixed call checks.
fn help_only_row(stem: Str, name: Str, at: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO, Env.Write, Process.Spawn {
    assert_eq(rows(stem, src), ["UnresolvedMethod E0505 {at}: `{name}` is not an operation of effect `Rand` | help: {help(name, \"random\")} | notes: {OPS_NOTE}"])
}

test "a helper compared with == gets help only" {
    help_only_row("rs_choice_eq", "choice", "2:5", "fn deal(d: List[Int]) -> Bool ! Rand \{\n    rand.choice(d) == 3\n}\n\nfn main() \{}\n")
}

test "a helper in an if condition gets help only" {
    help_only_row("rs_choice_if_cond", "choice", "2:8", "fn deal(d: List[Bool]) -> Int ! Rand \{\n    if rand.choice(d) \{ 1 } else \{ 0 }\n}\n\nfn main() \{}\n")
}

test "a helper in the tail of a closure whose result type is inferred gets help only" {
    let src = "fn deal(ds: List[List[Int]]) -> List[Int] ! Rand \{\n    let xs: List[Int] = ds.map(fn(x) \{ rand.choice(x) })\n    xs\n}\n\nfn main() \{}\n"
    help_only_row("rs_choice_closure_tail", "choice", "2:40", src)
}

test "a helper whose result a method is called on gets help only" {
    help_only_row("rs_choice_receiver", "choice", "2:5", "fn deal(d: List[Int]) -> Int ! Rand \{\n    rand.choice(d).len()\n}\n\nfn main() \{}\n")
}

// The two files match up to the call, so the call is the same node in each: a type the first
// check seeds at it must not reach the second.
test "a type seeded at a call in one check does not reach the next check" {
    let seeded = "fn deal(d: List[Int]) -> Int ! Rand \{\n    rand.choice(d)\n}\n\nfn main() \{}\n"
    assert_eq(rows("rs_choice_seeded_first", seeded), [
        "UnresolvedMethod E0505 2:5: `choice` is not an operation of effect `Rand` | help: {help(\"choice\", \"random\")}\n`random.choice` returns Option[Int], and Int is expected here | notes: {OPS_NOTE}",
    ])
    help_only_row("rs_choice_unseeded_next", "choice", "2:5", "fn deal(d: List[Int]) -> Int ! Rand \{\n    rand.choice(d).len()\n}\n\nfn main() \{}\n")
}

// A generic callee's parameter expects its own `T`, which says nothing of the type the place
// beyond that callee wants.
test "a helper in an argument of a generic function gets help only under a typed let" {
    let src = "fn id[T](x: T) -> T \{\n    x\n}\n\nfn deal(d: List[Int]) -> Int ! Rand \{\n    let a: Int = id(rand.choice(d))\n    a\n}\n\nfn main() \{}\n"
    help_only_row("rs_choice_generic_arg_let", "choice", "6:21", src)
}

test "a helper in an argument of a generic function gets help only under a typed parameter" {
    let src = "fn id[T](x: T) -> T \{\n    x\n}\n\nfn want_int(n: Int) -> Int \{\n    n\n}\n\nfn deal(d: List[Int]) -> Int ! Rand \{\n    want_int(id(rand.choice(d)))\n}\n\nfn main() \{}\n"
    help_only_row("rs_choice_generic_arg_param", "choice", "10:17", src)
}

// The result holds the function's own `T` only through the helper's binds, which this check
// does not prove.
test "a helper whose result type is the function's own type parameter gets help only" {
    help_only_row("rs_choice_own_typevar", "choice", "2:5", "fn pick[T](xs: List[T]) -> Option[T] ! Rand \{\n    rand.choice(xs)\n}\n\nfn main() \{}\n")
}

test "a helper bound by a let with no type gets help only" {
    help_only_row("rs_choice_untyped_let", "choice", "2:13", "fn deal(d: List[Int]) -> Int ! Rand \{\n    let x = rand.choice(d)\n    x + 1\n}\n\nfn main() \{}\n")
}

test "a helper in an argument of a method gets help with the mismatch when the result does not fit" {
    let src = "fn deal(deck: List[Int]) -> List[List[Str]] ! Rand \{\n    let mut o: List[List[Str]] = []\n    o.push(rand.shuffle(deck))\n    o\n}\n\nfn main() \{}\n"
    assert_eq(rows("rs_shuffle_method_arg_type", src), [
        "UnresolvedMethod E0505 3:12: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}\n`random.shuffle` returns List[Int], and List[Str] is expected here | notes: {OPS_NOTE}",
    ])
}

test "a helper in an argument of a method gets the fix when the result fits" {
    let src = "fn deal(deck: List[Int]) -> List[List[Int]] ! Rand \{\n    let mut o: List[List[Int]] = []\n    o.push(rand.shuffle(deck))\n    o\n}\n\nfn main() \{}\n"
    assert_eq(rows("rs_shuffle_method_arg", src), [
        "UnresolvedMethod E0505 3:12: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")} | notes: {OPS_NOTE} | fix: {ADD_IMPORT} `random.shuffle(deck)` at 3:12-3:30 | and: `import std.random\n\n` at 1:1-1:1",
    ])
}

// A place that drops the result expects no type of it, so the fix needs only the arguments
// to fit.
fn dropped_row(stem: Str, at: Str, end_col: Int, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO, Env.Write, Process.Spawn {
    assert_eq(rows(stem, src), [
        "UnresolvedMethod E0505 {at}: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")} | notes: {OPS_NOTE} | fix: {ADD_IMPORT} `random.shuffle(deck)` at {at}-2:{end_col} | and: `import std.random\n\n` at 1:1-1:1",
    ])
}

test "a helper whose result a statement drops gets the fix" {
    dropped_row("rs_shuffle_dropped_stmt", "2:5", 23, "fn deal(deck: List[Int]) -> List[Int] ! Rand \{\n    rand.shuffle(deck)\n    deck\n}\n\nfn main() \{}\n")
}

test "a helper bound to the discard of a let with no type gets the fix" {
    dropped_row("rs_shuffle_dropped_let", "2:13", 31, "fn deal(deck: List[Int]) -> List[Int] ! Rand \{\n    let _ = rand.shuffle(deck)\n    deck\n}\n\nfn main() \{}\n")
}

test "a helper in the tail of a function with no result type gets the fix" {
    dropped_row("rs_shuffle_dropped_void_tail", "2:5", 23, "fn deal(deck: List[Int]) ! Rand \{\n    rand.shuffle(deck)\n}\n\nfn main() \{}\n")
}

test "a dropped helper whose argument does not fit gets help only, with the mismatch" {
    let src = "fn deal(n: Int) ! Rand \{\n    rand.shuffle(n)\n}\n\nfn main() \{}\n"
    assert_eq(rows("rs_shuffle_dropped_arg_type", src), [
        "UnresolvedMethod E0505 2:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}\nargument 1 of `random.shuffle` expects List[T], got Int | notes: {OPS_NOTE}",
    ])
}

test "a helper in the tail of a block that a statement drops gets help only" {
    help_only_row("rs_shuffle_dropped_block_tail", "shuffle", "3:9", "fn deal(deck: List[Int]) -> List[Int] ! Rand \{\n    if deck.len() > 1 \{\n        rand.shuffle(deck)\n    }\n    deck\n}\n\nfn main() \{}\n")
}

test "a file that does not import std.random gets the one error and nothing from std.random" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    let program = probe_but("rs_no_import_exact", src, "UnresolvedMethod")
    assert(program >= 0)
    let mut got: List[Str] = []
    for d in diag_entries { got.push("{d.severity} {d.name} {d.file}:{d.line}:{d.col}") }
    assert_eq(got, ["error UnresolvedMethod build/rs_no_import_exact_probe.bl:2:5"])
}

let ALIAS_HELP = "import it under another name and call through that name: `import std.random as rng`, then `rng.shuffle(deck)`"

test "a local random hides the qualifier, so the fix imports the helper by name and says why" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    let random = 7
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_local_random", src), [
        "UnresolvedMethod E0505 3:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the local at 2:9, so `random.shuffle` is not available here | notes: {OPS_NOTE} | fix: add `import std.random.\{shuffle}` and call `shuffle(deck)` at 3:5-3:23 | and: `import std.random.\{shuffle}\n\n` at 1:1-1:1",
    ])
}

test "a parameter named random is named at its own position" {
    let src = #"fn deal(random: Int, deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_param_random", src), [
        "UnresolvedMethod E0505 2:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the local at 1:9, so `random.shuffle` is not available here | notes: {OPS_NOTE} | fix: add `import std.random.\{shuffle}` and call `shuffle(deck)` at 2:5-2:23 | and: `import std.random.\{shuffle}\n\n` at 1:1-1:1",
    ])
}

test "a function named random blocks both imports, so the help names it and shows an alias" {
    let src = #"fn random() -> Int {
    4
}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_fn_random", src), [
        "UnresolvedMethod E0505 6:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the function at 1:4, so `import std.random` would bind it twice\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
}

test "a module let named random blocks both imports whether or not shuffle is free" {
    let src = #"let random = 4

fn shuffle(xs: List[Int]) -> List[Int] {
    xs
}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_let_random", src), [
        "UnresolvedMethod E0505 8:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the `let` at 1:5, so `import std.random` would bind it twice\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
}

test "an item of another import named random blocks both imports and the help gives its place" {
    let src = #"import std.path.{path_join as random}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_item_random", src), [
        "UnresolvedMethod E0505 4:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the import at 1:18, so `import std.random` would bind it twice\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
}

test "another module imported as random blocks both imports and the help gives the place of its path" {
    let src = #"import std.path as random

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_module_as_random", src), [
        "UnresolvedMethod E0505 4:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the import at 1:8, so `import std.random` would bind it twice\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
    assert_eq(rows("rs_pub_module_as_random", "pub {src}"), [
        "UnresolvedMethod E0505 4:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the import at 1:12, so `import std.random` would bind it twice\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
}

test "a local random and a local shuffle both block, and the help gives each place" {
    let src = #"fn deal(deck: List[Int]) -> List[Int] ! Rand {
    let random = 7
    let shuffle = 3
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_local_random_and_shuffle", src), [
        "UnresolvedMethod E0505 4:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the local at 2:9 and `shuffle` is the local at 3:9, so neither `random.shuffle` nor `shuffle` is available here\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
}

test "a local random and a function shuffle both block, and the help names the function" {
    let src = #"fn shuffle(xs: List[Int]) -> List[Int] {
    xs
}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    let random = 7
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_local_random_fn_shuffle", src), [
        "UnresolvedMethod E0505 7:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the local at 6:9 and `shuffle` is the function at 1:4, so neither `random.shuffle` nor `shuffle` is available here\n{ALIAS_HELP} | notes: {OPS_NOTE}",
    ])
}

test "the alias help takes rng2 when the file binds rng" {
    let src = #"fn random() -> Int {
    4
}

fn rng() -> Int {
    5
}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck)
}

fn main() {}
"#
    let alias = "import it under another name and call through that name: `import std.random as rng2`, then `rng2.shuffle(deck)`"
    assert_eq(rows("rs_rng_bound", src), [
        "UnresolvedMethod E0505 10:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the function at 1:4, so `import std.random` would bind it twice\n{alias} | notes: {OPS_NOTE}",
    ])
}

test "a whole import of std.random that a local random hides gets the helper imported by name" {
    let src = #"import std.random

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    let random = 7
    rand.shuffle(deck)
}

fn main() {}
"#
    assert_eq(rows("rs_whole_import_local_random", src), [
        "UnresolvedMethod E0505 5:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the local at 4:9, so `random.shuffle` is not available here | notes: {OPS_NOTE} | fix: add `import std.random.\{shuffle}` and call `shuffle(deck)` at 5:5-5:23 | and: `\nimport std.random.\{shuffle}` at 1:18-1:18",
    ])
}

test "two helpers that each import by name carry one edit that imports both" {
    let src = #"fn deal(deck: List[Int]) -> Option[Int] ! Rand {
    let random = 7
    let cards: List[Int] = rand.shuffle(deck)
    rand.choice(cards)
}

fn main() {}
"#
    let action = "add `import std.random.\{choice, shuffle}` and call"
    let edit = "| and: `import std.random.\{choice, shuffle}\n\n` at 1:1-1:1"
    assert_eq(rows("rs_two_by_name", src), [
        "UnresolvedMethod E0505 3:28: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the local at 2:9, so `random.shuffle` is not available here | notes: {OPS_NOTE} | fix: {action} `shuffle(deck)` at 3:28-3:46 {edit}",
        "UnresolvedMethod E0505 4:5: `choice` is not an operation of effect `Rand` | help: {help(\"choice\", \"random\")}. `random` is the local at 2:9, so `random.choice` is not available here | notes: {OPS_NOTE} | fix: {action} `choice(cards)` at 4:5-4:23 {edit}",
    ])
}

test "a call with the wrong arguments that a blocker stops gets the alias help and the count" {
    let src = #"fn random() -> Int {
    4
}

fn deal(deck: List[Int]) -> List[Int] ! Rand {
    rand.shuffle(deck, 3)
}

fn main() {}
"#
    let alias = "import it under another name and call through that name: `import std.random as rng`, then `rng.shuffle(deck, 3)`"
    assert_eq(rows("rs_fn_random_arity", src), [
        "UnresolvedMethod E0505 6:5: `shuffle` is not an operation of effect `Rand` | help: {help(\"shuffle\", \"random\")}. `random` is the function at 1:4, so `import std.random` would bind it twice\n{alias}\n`rng.shuffle` takes 1 argument, found 2 | notes: {OPS_NOTE}",
    ])
}
