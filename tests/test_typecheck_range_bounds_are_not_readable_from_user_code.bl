// A Range has no public bound accessor. The stdlib reads a range's bounds through a compiler
// intrinsic that only lib/std modules resolve, so a user call is the usual undefined-function
// error, and a user function of the same name is an ordinary function.

import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}
import std.io

fn typecheck_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    init_embedded_stdlib()
    fs.write(path, src).unwrap()
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
}

fn errors_of(src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    typecheck_probe("build/test_typecheck_range_bounds_probe.bl", src)
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == "error" || d.severity == "ice" { out.push("{d.name}: {d.message}") }
    }
    for e in out { io.println("  diag: {e}") }
    out
}

test "a user call of range_bounds is undefined" {
    let src = "fn main() \{\n    let (lo, hi, inc) = range_bounds(0..3)\n    io.println(\"\{lo} \{hi} \{inc}\")\n}\n"
    let errs = errors_of(src)
    assert(errs.len() >= 1)
    assert(errs.get(0).unwrap().contains("range_bounds"), errs.join("; "))
    assert(errs.get(0).unwrap().contains("UndefinedFunction"), errs.join("; "))
}

test "a program that uses rand still cannot call range_bounds" {
    let src = "fn main() ! IO, Rand \{\n    io.println(\"\{rand.int(0..3)}\")\n    let (lo, hi, inc) = range_bounds(0..3)\n    io.println(\"\{lo} \{hi} \{inc}\")\n}\n"
    let errs = errors_of(src)
    assert_eq(errs.len(), 1)
    assert(errs.get(0).unwrap().contains("UndefinedFunction"), errs.join("; "))
}

test "a user function named range_bounds is an ordinary function" {
    let src = "fn range_bounds(n: Int) -> Int \{ n + 1 }\nfn main() \{\n    io.println(\"\{range_bounds(2)}\")\n}\n"
    assert_eq(errors_of(src).len(), 0)
}

test "a user function named range_bounds leaves the std reads of a range alone" {
    let src = "fn range_bounds(n: Int) -> Int \{ n + 1 }\nfn main() ! IO, Rand \{\n    io.println(\"\{range_bounds(2)} \{rand.int(0..3)} \{(0..3).into_iter().count()}\")\n}\n"
    assert_eq(errors_of(src).len(), 0)
}

test "a pub user function named range_bounds leaves the std reads of a range alone" {
    let src = "pub fn range_bounds(n: Int) -> Int \{ n + 1 }\nfn main() ! IO, Rand \{\n    io.println(\"\{range_bounds(2)} \{rand.int(0..3)} \{(0..3).into_iter().count()}\")\n}\n"
    assert_eq(errors_of(src).len(), 0)
}
