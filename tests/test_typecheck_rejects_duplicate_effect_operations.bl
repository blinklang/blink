// The operations under one root effect share a single vtable, so their names must be
// unique across the sub-effects. Codegen carries an ICE backstop for the collision;
// the declaration itself is what is wrong, so typecheck rejects it first.
import lower_test_helpers.{probe, probe_but}

fn repeated_src() -> Str {
    #"effect Zzdup {
    effect A { fn zzsame() }
    effect B { fn zzsame() }
}
fn main() {
    assert(true)
}
"#
}

fn distinct_src() -> Str {
    #"effect Zzok {
    effect A { fn zzfirst() }
    effect B { fn zzsecond() }
}
fn main() {
    assert(true)
}
"#
}

test "two sub-effects of one effect declaring one operation name is rejected" {
    let program = probe_but("typecheck_effect_op_repeated", repeated_src(), "DuplicateEffectOperation")
    assert(program >= 0)
}

test "sub-effects of one effect declaring distinct operation names are accepted" {
    let program = probe("typecheck_effect_op_distinct", distinct_src())
    assert(program >= 0)
}
