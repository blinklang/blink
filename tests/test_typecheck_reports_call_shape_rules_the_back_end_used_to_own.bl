fn trusted_raw_interpolation_src() -> Str {
    #"@trusted(audit: "AUDIT-1")
fn build_query(col: Str) -> Str {
    "select {Raw(col)} from t"
}

fn main() {
    io.println(build_query("name"))
}
"#
}

test "a keyword argument naming no parameter is refused" {
    assert_names("unknown label", probe_error_names("tc_kw_unknown", unknown_label_src()),
        "InvalidKeywordArg")
}

test "a positional argument after a keyword argument is refused" {
    assert_names("positional after named",
        probe_error_names("tc_kw_positional_after", positional_after_named_src()),
        "PositionalAfterKeyword")
}

// The repeated label leaves another keyword parameter with nothing bound to it, but the
// repetition is the mistake the author made and the deletion is the repair.
test "the same label written twice in one call is refused" {
    assert_names("repeated label", probe_error_names("tc_kw_repeated", repeated_label_src()),
        "DuplicateKeywordArg")
}

test "keyword arguments in any order are accepted" {
    assert_names("keywords in order",
        probe_error_names("tc_kw_ok", keyword_args_in_order_src()), "")
}

// The separator exists to make the swap in `transfer(300, bob, alice)` impossible. A value
// that arrives in a keyword slot without its label is that swap, spelled legally.
test "a keyword parameter supplied positionally is refused" {
    assert_names("unlabeled keyword",
        probe_error_names("tc_kw_unlabeled", unlabeled_keyword_src()),
        "UnlabeledKeywordArg")
}

// Opposite condition to the row above: the value is absent, not unlabelled, and the repair
// inserts an argument rather than annotating one.
test "a keyword parameter that receives no argument is refused" {
    assert_names("missing keyword",
        probe_error_names("tc_kw_missing", missing_keyword_src()),
        "MissingKeywordArg")
}

test "a label naming no keyword parameter of the callee is refused" {
    assert_names("unknown keyword label",
        probe_error_names("tc_kw_unknown_kw", unknown_keyword_label_src()),
        "InvalidKeywordArg")
}

// A label resolves in the keyword-parameter namespace and nothing else, so naming a
// positional parameter is not a near miss to be allowed through.
test "a label naming a positional parameter is refused" {
    assert_names("label on positional",
        probe_error_names("tc_kw_on_positional", label_on_positional_src()),
        "InvalidKeywordArg")
}

// A rule that held for `f(x: 1)` and not for `b.f(x: 1)` would select two behaviours by the
// receiver's spelling.
test "a method's keyword parameter supplied positionally is refused" {
    assert_names("method unlabeled keyword",
        probe_error_names("tc_kw_method_unlabeled", method_unlabeled_keyword_src()),
        "UnlabeledKeywordArg")
}

test "a label naming no keyword parameter of a method is refused" {
    assert_names("method unknown keyword label",
        probe_error_names("tc_kw_method_unknown", method_unknown_keyword_label_src()),
        "InvalidKeywordArg")
}

test "a method's keyword arguments in any order are accepted" {
    assert_names("method keywords in order",
        probe_error_names("tc_kw_method_ok", method_keyword_args_in_order_src()), "")
}

// The free-fn row above proves a label on a positional parameter is refused. A receiver
// does not change which namespace a label resolves in.
test "a label naming a positional parameter of a method is refused" {
    assert_names("method label on positional",
        probe_error_names("tc_kw_method_on_positional", method_label_on_positional_src()),
        "InvalidKeywordArg")
}

// A struct literal's labels name fields, not keyword parameters, so the keyword rule has
// no jurisdiction over them.
test "struct literal field labels are outside the keyword rule" {
    assert_names("struct literal labels",
        probe_error_names("tc_kw_struct_literal", struct_literal_field_labels_src()), "")
}


// A generic function's name is a value wherever a function value is expected, and the
// expected type is what fixes its binders. The refusal this row used to assert distinguished
// two spellings of one value: `apply(identity, 3)` was refused and `let f = identity;
// apply(f, 3)` accepted, so one `let` walked past it.
test "a bare generic function passed where a closure is expected is accepted" {
    assert_names("generic fn value",
        probe_error_names("tc_generic_fn_value", generic_fn_as_value_src()), "")
}

test "an annotated binding fixes a bare generic function's binders" {
    assert_names("generic fn annotated let",
        probe_error_names("tc_generic_fn_ann_let", generic_fn_annotated_let_src()), "")
}

// The repair has to be a form the author can write. An annotation is the only thing that
// fixes a binder nothing else fixes, and it has to carry the function's shape to be one.
test "the inference failure names the annotation that would fix it" {
    assert_names("generic fn unpinned help",
        probe_first_help("tc_generic_fn_help", generic_fn_unpinned_let_src()),
        "add a type annotation, e.g. `let f: fn(T) -> T = ...` (replace the placeholder with the intended element type)")
}

// The residual the deleted rule used to cover: nothing here says which instantiation the
// name means, which is a failure of inference and is reported as one.
test "a bare generic function that nothing fixes is an inference failure" {
    assert_names("generic fn unpinned let",
        probe_error_names("tc_generic_fn_unpinned", generic_fn_unpinned_let_src()),
        "CannotInferType")
}

test "a bare concrete function passed where a closure is expected is accepted" {
    assert_names("concrete fn value",
        probe_error_names("tc_concrete_fn_value", concrete_fn_as_value_src()), "")
}

// The allocations an ffi scope hands out are freed when its block ends, so a scope with no
// block would free them at a point no reader can name.
test "an ffi scope bound outside a with-resource is refused" {
    assert_names("scope in let", probe_error_names("tc_ffi_scope_let", ffi_scope_as_let_src()),
        "FfiScopeNotWithResource")
}

test "an ffi scope used as a with-resource is accepted" {
    assert_names("scope as resource",
        probe_error_names("tc_ffi_scope_with", ffi_scope_as_resource_src()), "")
}

// The rule belongs to the type, so it holds at every position the type can be written, not
// only at the call that produces one. A scope reachable through a parameter, a return, a
// field or a type argument outlives the block that frees its arena just as surely.
test "an ffi scope written as a parameter type is refused" {
    assert_names("scope as param",
        probe_error_names("tc_ffi_scope_param", ffi_scope_as_param_src()),
        "FfiScopeNotWithResource")
}

test "an ffi scope written as a return type is refused" {
    assert_names("scope as return",
        probe_error_names("tc_ffi_scope_ret", ffi_scope_as_return_src()),
        "FfiScopeNotWithResource")
}

test "an ffi scope written as a field type is refused" {
    assert_names("scope as field",
        probe_error_names("tc_ffi_scope_field", ffi_scope_as_field_src()),
        "FfiScopeNotWithResource")
}

test "an ffi scope written as a type argument is refused" {
    assert_names("scope as type arg",
        probe_error_names("tc_ffi_scope_targ", ffi_scope_as_type_arg_src()),
        "FfiScopeNotWithResource")
}

// A repair a reader can apply names the binding they wrote, and it offers the one plain
// allocation as the alternative to wrapping the rest of the function in a block.
test "the repair for a let-bound ffi scope names the binder the author wrote" {
    let h = probe_first_help("tc_ffi_scope_help", ffi_scope_as_let_src())
    if h.contains("as arena") == 0 { io.println("FAIL: help was '{h}'") }
    assert(h.contains("as arena") != 0)
    assert(h.contains("alloc_ptr[T]()") != 0)
}

// No fixer can decide where the block ends, so the rewrite is shown and not applied.
test "the let-to-with rewrite is not offered as a machine-applicable fix" {
    let _r = run_probe("tc_ffi_scope_fix", ffi_scope_as_let_src())
    let mut seen = 0
    for d in diag_entries {
        if d.name == "FfiScopeNotWithResource" {
            seen = seen + 1
            assert(d.fix_action == "")
        }
    }
    assert(seen > 0)
}

// A `Raw[T]` is the un-parameterized fragment, and the `Template[C]` coercion is the one
// thing that consumes it. The warning belongs at that coercion and nowhere else.
test "a Raw folded into a template warns that it bypasses parameterization" {
    assert_names("raw into template",
        probe_warning_names("tc_raw_warn", template_raw_src()), "RawBypassesParam")
}

test "a Raw folded into a template is not itself an error" {
    assert_names("raw into template errors",
        probe_error_names("tc_raw_warn_err", template_raw_src()), "")
}

// The marker rides the binding, which is the whole reason it is a type: writing the wrapper
// one line earlier is the same bypass and carries the same audit obligation.
test "a Raw reaching a template through a binding still warns" {
    assert_names("raw through binding",
        probe_warning_names("tc_raw_bound", template_raw_through_binding_src()),
        "RawBypassesParam")
}

// An ordinary interpolation does not consume a Raw. Reporting E0523 there would prescribe
// three repairs that are impossible on a compiler-known marker type.
test "a Raw interpolated into an ordinary string is refused" {
    assert_names("raw outside template",
        probe_error_names("tc_raw_outside", raw_interpolation_src()), "RawOutsideTemplate")
}

test "nothing strips a Raw back to the type it wraps" {
    assert_names("raw is not str",
        probe_error_names("tc_raw_not_str", raw_as_str_src()), "TypeError")
}

test "a Raw folded into a template inside an audited function does not warn" {
    assert_names("trusted raw",
        probe_warning_names("tc_raw_trusted", template_raw_trusted_src()), "")
}

// Q4-supp. A diagnostic on the section 7 list exists to force a record, so a channel that
// records nothing must not reach it -- and must say so rather than fail quietly. A
// suppression that silently fails to apply and one that silently succeeds are equally bad:
// the author cannot tell which happened.
test "naming an audit-gated warning in @allow is refused" {
    assert_names("allow names W0310",
        probe_error_names("tc_allow_raw", allow_raw_bypasses_param_src()),
        "AuditGatedSuppression")
}

test "the refused @allow does not suppress the warning it named" {
    let w = probe_warning_names("tc_allow_raw_w", allow_raw_bypasses_param_src())
    if w.contains("RawBypassesParam") == 0 { io.println("FAIL: warnings were '{w}'") }
    assert(w.contains("RawBypassesParam") != 0)
}

test "the refusal for an audit-gated warning names the channel that does reach it" {
    let h = probe_first_help("tc_allow_raw_help", allow_raw_bypasses_param_src())
    if h.contains("@trusted(audit:") == 0 { io.println("FAIL: help was '{h}'") }
    assert(h.contains("@trusted(audit:") != 0)
}

test "naming the unaudited-ffi warning in @allow is refused" {
    assert_names("allow names W0800",
        probe_error_names("tc_allow_ffi", allow_unaudited_ffi_src()),
        "AuditGatedSuppression")
}

// The list is a turnstile, not a wall, and it is narrow. An ordinary lint keeps the channel
// it has always had.
test "naming an ordinary lint in @allow is still accepted" {
    assert_names("allow names ordinary lint",
        probe_error_names("tc_allow_ordinary", allow_ordinary_lint_src()), "")
}

// The second channel. `[lints] RawBypassesParam = "off"` reaches the same override table a
// whole project wide, so carving `@allow` alone would bolt a door beside an open window.
test "naming an audit-gated warning under [lints] is refused" {
    diag_reset()
    lint_set_override("RawBypassesParam", "off")
    let mut names = ""
    for d in diag_entries {
        if d.severity == "error" { names = "{names}{d.name} " }
    }
    assert_names("lints names W0310", names.trim(), "AuditGatedSuppression")
}

test "a W-code names the same diagnostic and is refused too" {
    diag_reset()
    lint_set_override("W0800", "off")
    let mut names = ""
    for d in diag_entries {
        if d.severity == "error" { names = "{names}{d.name} " }
    }
    assert_names("lints names W0800", names.trim(), "AuditGatedSuppression")
}

test "an ordinary lint is still settable from [lints]" {
    diag_reset()
    lint_set_override("UnusedVariable", "off")
    let mut names = ""
    for d in diag_entries {
        if d.severity == "error" { names = "{names}{d.name} " }
    }
    assert_names("lints names ordinary", names.trim(), "")
    diag_reset()
}
