fn template_raw_trusted_src() -> Str {
    #"fn run(_t: Template[IO]) -> Int {
    1
}

@trusted(audit: "AUDIT-1")
fn go() -> Int {
    let table = "items"
    run("select * from {Raw(table)}")
}

fn main() {
    io.println("{go()}")
}
"#
}

