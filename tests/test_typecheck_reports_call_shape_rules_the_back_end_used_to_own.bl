fn method_unlabeled_keyword_src() -> Str {
    #"trait Transfers {
    fn transfer(self, amount: Int, -- from: Int, to: Int) -> Int
}

type Bank {
    total: Int
}

impl Transfers for Bank {
    fn transfer(self, amount: Int, -- from: Int, to: Int) -> Int { amount + from + to + self.total }
}

fn main() {
    let b = Bank { total: 0 }
    io.println("{b.transfer(300, 1, 2)}")
}
"#
}

