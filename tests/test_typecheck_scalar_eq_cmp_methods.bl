// The built-in trait table (sections/03_types.md) gives Int, the sized ints, Char and Str
// both Eq and Ord, and Bool Eq alone. `eq` answers Bool and `cmp` answers Ordering, and
// each compares against exactly one value of the receiver's own type.
import lower_test_helpers.{probe, probe_but}

fn well_formed_src() -> Str {
    #"fn main() {
    let a: Ordering = 1.cmp(2)
    let b: Bool = 1.eq(2)
    let c: Ordering = "a".cmp("b")
    let d: Bool = "a".eq("b")
    let e: Ordering = 'a'.cmp('b')
    let f: Bool = 'a'.eq('b')
    let g: Ordering = 1.to_u8().cmp(2.to_u8())
    let h: Bool = 1.to_i32().eq(2.to_i32())
    let i: Bool = true.eq(false)
    io.println("{b} {d} {f} {h} {i}")
}
"#
}

fn bool_cmp_src() -> Str {
    #"fn main() {
    let o = true.cmp(false)
}
"#
}

// Bool is Eq and not Ord, so an Ord bound refuses it at the call as `<` on two Bools is
// refused, and an Eq bound takes it.
fn bool_through_ord_bound_src() -> Str {
    #"fn order_of[T: Ord](a: T, b: T) -> Ordering { a.cmp(b) }

fn main() {
    let o = order_of(true, false)
}
"#
}

fn bool_through_eq_bound_src() -> Str {
    #"fn equal_to[T: Eq](a: T, b: T) -> Bool { a.eq(b) }

fn main() {
    io.println("{equal_to(true, false)}")
}
"#
}

fn int_cmp_str_arg_src() -> Str {
    #"fn main() {
    let o = 1.cmp("a")
}
"#
}

fn str_eq_int_arg_src() -> Str {
    #"fn main() {
    let same = "a".eq(1)
    io.println("{same}")
}
"#
}

fn sized_cmp_other_width_src() -> Str {
    #"fn main() {
    let o = 1.to_i8().cmp(1.to_i16())
}
"#
}

fn char_cmp_short_src() -> Str {
    #"fn main() {
    let o = 'a'.cmp()
}
"#
}

fn int_eq_extra_src() -> Str {
    #"fn main() {
    let same = 1.eq(1, 2)
    io.println("{same}")
}
"#
}

fn cmp_is_not_bool_src() -> Str {
    #"fn main() {
    let b: Bool = 1.cmp(2)
    io.println("{b}")
}
"#
}

test "eq and cmp on every scalar in the trait table typecheck" {
    let program = probe("scalar_eq_cmp_well_formed", well_formed_src())
    assert(program >= 0)
}

test "Bool has no cmp" {
    let program = probe_but("scalar_eq_cmp_bool_cmp", bool_cmp_src(), "UnresolvedMethod")
    assert(program >= 0)
}

test "an Ord bound refuses a Bool" {
    let program = probe_but("scalar_eq_cmp_bool_ord_bound", bool_through_ord_bound_src(), "TraitBoundNotSatisfied")
    assert(program >= 0)
}

test "an Eq bound takes a Bool" {
    let program = probe("scalar_eq_cmp_bool_eq_bound", bool_through_eq_bound_src())
    assert(program >= 0)
}

test "Int.cmp refuses a Str argument" {
    let program = probe_but("scalar_eq_cmp_int_str_arg", int_cmp_str_arg_src(), "TypeError")
    assert(program >= 0)
}

test "Str.eq refuses an Int argument" {
    let program = probe_but("scalar_eq_cmp_str_int_arg", str_eq_int_arg_src(), "TypeError")
    assert(program >= 0)
}

test "a sized int compares only against its own width" {
    let program = probe_but("scalar_eq_cmp_sized_width", sized_cmp_other_width_src(), "TypeError")
    assert(program >= 0)
}

test "Char.cmp refuses a call with no argument" {
    let program = probe_but("scalar_eq_cmp_char_short", char_cmp_short_src(), "TypeError")
    assert(program >= 0)
}

test "Int.eq refuses a second argument" {
    let program = probe_but("scalar_eq_cmp_int_extra", int_eq_extra_src(), "TypeError")
    assert(program >= 0)
}

test "cmp answers an Ordering, not a Bool" {
    let program = probe_but("scalar_eq_cmp_not_bool", cmp_is_not_bool_src(), "TypeError")
    assert(program >= 0)
}
