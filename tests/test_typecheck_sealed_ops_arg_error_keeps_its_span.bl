// A type error inside an argument of a sealed ops trait's qualified call is reported on
// that argument, not on the call. The build later rewrites the call into its method form;
// the error must name the position the programmer wrote either way.

import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}

// `1 + "x"` spans columns 37 to 43 of line 4; the call itself starts at column 14.
fn probe_src() -> Str {
    #"import std.traits.{StrOps}

fn main() {
    let ok = StrOps.contains("abc", 1 + "x")
    assert(ok)
}
"#
}

test "the error inside the second argument is reported on that argument" {
    let path = "build/sealed_ops_arg_error_span_probe.bl"
    write_file(path, probe_src())
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    let mut errors = 0
    let mut on_arg = 0
    for d in diag_entries {
        if d.severity == "error" {
            errors = errors + 1
            io.println("[error] {d.name} at {d.line}:{d.col}: {d.message}")
            if d.line == 4 && d.col >= 37 && d.col <= 43 { on_arg = on_arg + 1 }
        }
    }
    assert(errors >= 1)
    assert_eq(on_arg, errors)
}
