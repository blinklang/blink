// sections/03_types.md gives the sized integer types three wrapping methods: wrapping_add,
// wrapping_sub and wrapping_mul. There is no wrapping_neg, wrapping_div or wrapping_rem, so
// a call to one is an unresolved method, reported once and with no cascade into its uses.
import cg_test_helpers.{cg_probe_begin, cg_probe_errors_named}
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_ice_count}
import std.io

// Checks `src` and answers the UnresolvedMethod count. Any other error, or an internal
// error, fails the row.
fn unresolved_in(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    env.set_var("BLINK_ROOT", process_run("pwd", []).out.trim())
    let path = "build/{stem}_probe.bl"
    cg_probe_begin(path)
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process_run("rm", ["-f", path])
    let mut others = 0
    for d in diag_entries {
        if d.severity == "error" && d.name != "UnresolvedMethod" {
            io.println("FAIL: {stem} recorded an error the row does not expect: {d.name}: {d.message}")
            others = others + 1
        }
    }
    assert_eq(others, 0)
    assert_eq(diag_ice_count, 0)
    cg_probe_errors_named("UnresolvedMethod")
}

fn neg_src() -> Str {
    #"fn main() {
    let m: I8 = -128
    let w = m.wrapping_neg()
    io.println("{w.wrapping_add(1)}")
}
"#
}

fn div_src() -> Str {
    #"fn main() {
    let h: U8 = 200
    let q = h.wrapping_div(3)
    io.println("{q}")
}
"#
}

fn rem_src() -> Str {
    #"fn main() {
    let e: I32 = 7
    let r = e.wrapping_rem(2)
    io.println("{r}")
}
"#
}

fn spec_ops_src() -> Str {
    #"fn main() {
    let a: I8 = 100
    let b: U8 = 250
    let c: I32 = 5
    io.println("{a.wrapping_add(a)} {b.wrapping_sub(251)} {c.wrapping_mul(c)}")
}
"#
}

test "wrapping_neg is not a method of a sized int" {
    assert_eq(unresolved_in("typecheck_wrap_neg", neg_src()), 1)
}

test "wrapping_div is not a method of a sized int" {
    assert_eq(unresolved_in("typecheck_wrap_div", div_src()), 1)
}

test "wrapping_rem is not a method of a sized int" {
    assert_eq(unresolved_in("typecheck_wrap_rem", rem_src()), 1)
}

test "wrapping_add, wrapping_sub and wrapping_mul still check" {
    assert_eq(unresolved_in("typecheck_wrap_spec_ops", spec_ops_src()), 0)
}
