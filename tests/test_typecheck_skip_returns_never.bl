// `skip(reason: Str) -> Never` (sections/02_syntax.md, Skipping Tests): the call unwinds to the
// test runner, so it fits a match arm, a `??` default and a fn tail of any type, in its bare
// form and as `testing.skip`.
import lower_test_helpers.{probe}

fn arm_src() -> Str {
    #"import std.testing.{skip}

test "t" {
    let n = 2
    let y: Int = match n {
        1 => 5
        _ => skip("r")
    }
    assert_eq(y, 5)
}
"#
}

fn qualified_arm_src() -> Str {
    #"import std.testing

test "t" {
    let n = 2
    let y = match n {
        1 => 5
        _ => testing.skip("r")
    }
    assert_eq(y, 5)
}
"#
}

fn default_src() -> Str {
    #"import std.testing.{skip}

test "t" {
    let o: Option[Str] = None
    let s: Str = o ?? skip("no value")
    assert_eq(s, "x")
}
"#
}

test "a bare skip fits an Int match arm" {
    assert(probe("skip_never_arm", arm_src()) >= 0)
}

test "a qualified skip fits a match arm and the arm keeps the other type" {
    assert(probe("skip_never_qual_arm", qualified_arm_src()) >= 0)
}

test "a skip fits a ?? default" {
    assert(probe("skip_never_default", default_src()) >= 0)
}
