// `Type.method(args)` reaching a trait impl's static method produces the type the impl is
// written for. The impl declares `-> Self`, and inside the impl `Self` is that type
// (sections/03_types.md, "The `Self` Type"), so the call's recorded type is the type name,
// never the `Self` typevar. A typevar here reaches codegen with no C spelling.
import lower_test_helpers.{probe, rhs_of, assert_eq_str}
import typecheck.{tc_lookup_node_tid, tc_resolve, tc_type_str}
import std.io

fn src() -> Str {
    #"trait Spawn { fn make(n: Int) -> Self }
type Gadget { v: Int }
impl Spawn for Gadget {
    fn make(a: Int) -> Self { Gadget { v: a } }
}
trait Pair { fn twin(n: Int) -> Result[Self, Str] }
impl Pair for Gadget {
    fn twin(b: Int) -> Result[Self, Str] { Ok(Gadget { v: b }) }
}
fn main() {
    let g = Gadget.make(5)
    let t = Gadget.twin(6)
    let _keep = g.v
    assert(t.is_ok())
}
"#
}

fn type_of_rhs(name: Str) -> Str {
    let tid = tc_lookup_node_tid(rhs_of(name))
    if tid < 0 { io.println("FAIL: {name}: call node has no recorded type") }
    assert(tid >= 0)
    tc_type_str(tc_resolve(tid))
}

test "a trait static call through the type is typed as the type, not Self" {
    let _p = probe("typecheck_static_self", src())
    assert_eq_str("Gadget.make(5)", type_of_rhs("g"), "Gadget")
}

test "a trait static call returning a carrier over Self is typed over the type" {
    let _p = probe("typecheck_static_self_carrier", src())
    assert_eq_str("Gadget.twin(6)", type_of_rhs("t"), "Result[Gadget, Str]")
}
