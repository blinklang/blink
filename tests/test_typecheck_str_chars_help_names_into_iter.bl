// Str has no `.chars()`: `.into_iter()` is the one door from a Str to its Chars. A caller who
// writes `.chars()` from another language gets UnresolvedMethod, and its help names the door.
import lower_test_helpers.{probe_but, assert_eq_str}
import diagnostics.{diag_entries}

fn unresolved_help() -> Str {
    let mut help = ""
    for d in diag_entries {
        if d.name == "UnresolvedMethod" { help = d.help }
    }
    help
}

fn str_chars_src() -> Str {
    #"fn main() {
    let s = "abc"
    let cs = s.chars()
}
"#
}

test "chars on a Str names into_iter" {
    let program = probe_but("typecheck_hint_str_chars", str_chars_src(), "UnresolvedMethod")
    assert(program >= 0)
    assert_eq_str("help", unresolved_help(), "Str has no `.chars()`: call `.into_iter()` for an Iterator[Char] of its Unicode scalar values")
}
