// A struct's declared shape lives in typecheck's field pool, not in an AST `type` node.
// A struct no module in this program declares -- ProcessResult, minted for a builtin's
// return -- reaches its readers through a declaration typecheck synthesizes out of that same
// pool, and that node names no module. The slot accessors answer for every struct the pool
// knows, in declaration order.
import typecheck.{tc_type_str, tc_tid_decl_node, tc_struct_field_slots, tc_sfield_name, tc_sfield_tid}
import parser.{node_source_module}
import cname_test_helpers.{assert_eq_str, tid_of, compile_probe}
import std.io

fn probe_src() -> Str {
    #"import std.traits.{ConversionError}
fn main() {
    let e = ConversionError { message: "m", source_type: "Int", target_type: "I8" }
    let pid = process_spawn("echo", ["hi"])
    let r = process_pid_wait(pid)
    let n: Int = r.exit_code
    assert(e.message == "m" && n == 0)
}
"#
}

fn field_names(tid: Int) -> Str {
    let mut names: List[Str] = []
    for slot in tc_struct_field_slots(tid) { names.push(tc_sfield_name(slot)) }
    names.join(",")
}

fn field_types(tid: Int) -> Str {
    let mut types: List[Str] = []
    for slot in tc_struct_field_slots(tid) { types.push(tc_type_str(tc_sfield_tid(slot))) }
    types.join(",")
}

test "a declared struct's fields come back in declaration order with their types" {
    let m = compile_probe("typecheck_sfield_pool", probe_src())
    let ce = tid_of(m, "ConversionError")
    assert_eq_str("ConversionError field names", field_names(ce), "message,source_type,target_type")
    assert_eq_str("ConversionError field types", field_types(ce), "Str,Str,Str")
}

// The module a struct's declaration node names, or a word no module can be called when the
// struct has no declaration at all.
fn declaring_module(tid: Int) -> Str {
    let decl = tc_tid_decl_node(tid)
    if decl < 0 { return "<none>" }
    node_source_module(decl)
}

test "a struct no module declares still answers from the pool" {
    let m = compile_probe("typecheck_sfield_pool", probe_src())
    let pr = tid_of(m, "ProcessResult")
    let ce = tid_of(m, "ConversionError")
    if declaring_module(ce) == "" {
        io.println("FAIL: the probe reached no struct a module wrote, so the contrast proves nothing")
    }
    assert(declaring_module(ce) != "")
    assert_eq_str("ProcessResult declaring module", declaring_module(pr), "")
    assert_eq_str("ProcessResult field names", field_names(pr), "out,err_out,exit_code")
    assert_eq_str("ProcessResult field types", field_types(pr), "Str,Str,Int")
}

test "a non-struct has no slots and a slot outside the pool reads as nothing" {
    let m = compile_probe("typecheck_sfield_pool", probe_src())
    assert_eq(tc_struct_field_slots(tid_of(m, "Int")).len(), 0)
    assert_eq_str("name of slot -1", tc_sfield_name(-1), "")
    assert_eq(tc_sfield_tid(-1), -1)
    assert_eq_str("name of a slot past the pool", tc_sfield_name(1000000), "")
}
