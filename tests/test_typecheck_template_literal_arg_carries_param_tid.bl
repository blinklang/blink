// A string literal at a Template[C] parameter is coerced to a template, and codegen reads
// that from the literal's own stamp. So the coerced literal must carry the parameter's
// Template tid, a plain interpolation must stay Str, and no later stamp may undo either.

import lower_test_helpers.{probe, rhs_of, assert_eq_str}
import typecheck.{tc_lookup_node_tid, tc_resolve, tc_type_str}
import parser.{node_args, sublist_get}

fn src_template_args() -> Str {
    #"type Q {}

pub effect Rd {
    effect Read {
        fn read(t: Template[Q]) -> Int
    }
}

fn takes(t: Template[Q]) -> Int {
    t.count()
}

fn main() {
    let a = 1
    let plain = "a={a}"
    let by_fn = takes("a={a}")
    let no_holes = takes("none")
    with handler Rd {
        fn read(op_t: Template[Q]) -> Int {
            op_t.count()
        }
    } {
        let by_op = rd.read("a={a}")
        io.println("{plain}{by_fn}{no_holes}{by_op}")
    }
}
"#
}

fn stamp_str(label: Str, node: Int) -> Str {
    let tid = tc_lookup_node_tid(node)
    if tid < 0 { io.println("FAIL: {label} (node {node}) has no recorded type") }
    assert(tid >= 0)
    tc_type_str(tc_resolve(tid))
}

fn first_arg(name: Str) -> Int {
    sublist_get(node_args(rhs_of(name)), 0)
}

test "a literal passed to a Template param carries the param's Template tid" {
    let _p = probe("template_literal_arg_tid", src_template_args())
    assert_eq_str("fn argument", stamp_str("by_fn arg", first_arg("by_fn")), "Template[Q]")
    assert_eq_str("literal with no holes", stamp_str("no_holes arg", first_arg("no_holes")), "Template[Q]")
}

test "a literal passed to an effect operation's Template param carries the same tid" {
    let _p = probe("template_literal_op_tid", src_template_args())
    assert_eq_str("operation argument", stamp_str("by_op arg", first_arg("by_op")), "Template[Q]")
}

test "an interpolation that no Template param takes stays Str" {
    let _p = probe("template_literal_plain_tid", src_template_args())
    assert_eq_str("plain interpolation", stamp_str("plain", rhs_of("plain")), "Str")
}
