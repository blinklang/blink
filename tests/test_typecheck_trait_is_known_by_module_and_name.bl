// A trait is the declaration a name resolves to, not its spelling (sections/03_types.md §3.4,
// sections/07 §10.6 *Shadowing a Prelude Trait*). A written trait name resolves through the
// file's own scope: its module's traits, then its imports, then the compiler-known trait. So a
// trait named like a prelude trait changes `Eq` only where it is declared or selected, and two
// modules may each declare a trait `Tr` with its own contract.

import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn module_probe(name: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    diag_reset()
    check_types(compile_to_program("tests/zzti_traits/src/{name}.bl", 1))
}

// Everything the probe reported that is not a warning, as `name: message` lines.
fn problems_reported() -> Str {
    let mut out = ""
    for d in diag_entries {
        if d.severity != "warning" { out = out.concat("{d.name}: {d.message}\n") }
    }
    out
}

fn warnings_named(name: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "warning" && d.name == name { n = n + 1 }
    }
    n
}

fn assert_clean(name: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    module_probe(name)
    let p = problems_reported()
    assert(p == "", "expected {name} to check clean, got:\n{p}")
}

fn assert_reported(name: Str, words: List[Str]) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    module_probe(name)
    let p = problems_reported()
    for w in words { assert(p.contains(w), "expected {name} to report '{w}', got:\n{p}") }
}

test "a file that imports a shadowing module without selecting the shadow means the prelude Eq" {
    assert_clean("main_core_eq_beside_a_shadow")
}

test "the shadow warning prints once for its declaration" {
    module_probe("main_core_eq_beside_a_shadow")
    let n = warnings_named("ShadowedPreludeName")
    assert(n == 1, "expected one ShadowedPreludeName warning, got {n}")
}

test "two modules may each declare a trait of one name with its own contract" {
    assert_clean("main_two_traits_named_tr")
}

test "a file that selects the shadow checks its impl against the shadow's contract" {
    assert_reported("main_selected_shadow_contract", ["TraitContract", "expected `Int`"])
}

test "an impl of the shadow does not make == legal, since == needs the prelude Eq" {
    assert_reported("main_shadow_impl_is_not_core_eq", ["`Q` does not implement `Eq`"])
}

test "a derived prelude Eq does not satisfy a bound on the shadow" {
    assert_reported("main_core_eq_does_not_meet_shadow_bound", ["TraitBoundNotSatisfied", "`P`"])
}

test "a bound naming a trait the file never imports is reported" {
    assert_reported("main_bound_on_unimported_trait", ["Tr"])
}

test "a program's own TryFrom leaves the stdlib's TryFrom impls alone" {
    assert_clean("main_user_tryfrom")
}

test "a program's own Display leaves the stdlib's Display impls alone" {
    assert_clean("main_user_display")
}

test "a bound on a program's own trait named like an operator trait reads that trait" {
    assert_clean("main_user_sub_bound")
}
