import compile_test_helpers

// A type parameter declares no fields, and a bound adds only methods, so a field read
// or write on a value of type T is error[NoSuchField] at the definition (§3
// Parametricity). A field of a concrete type stays readable inside a generic body.

test "a field read on an unbounded type parameter is E0525" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[E](e: E) -> Int { e.code }
fn main() { io.println("never calls f") }
"#, "tp_field_read")
    compile_test_helpers.expect_error(out, "E0525", "e.code on an unbounded E")
}

test "a field read on a T bound by a match pattern is E0525" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T](r: Result[T, Str]) -> Int {
    match r {
        Ok(v) => { return v.x }
        Err(_m) => { return 0 }
    }
}
fn main() { io.println("never calls f") }
"#, "tp_field_pattern")
    compile_test_helpers.expect_error(out, "E0525", "v.x on a T from an Ok pattern")
}

test "a field read on a bounded type parameter is E0525" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T: Display](x: T) -> Int { x.code }
fn main() { io.println("never calls f") }
"#, "tp_field_bounded")
    compile_test_helpers.expect_error(out, "E0525", "x.code on a T: Display")
}

test "a field write on a type parameter is E0525" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T](x: T) -> Int {
    let mut y: T = x
    y.code = 1
    0
}
fn main() { io.println("never calls f") }
"#, "tp_field_write")
    compile_test_helpers.expect_error(out, "E0525", "y.code = 1 on a T")
}

test "a tuple index on a type parameter is E0525" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T](x: T) -> Int { x.0 }
fn main() { io.println("never calls f") }
"#, "tp_field_index")
    compile_test_helpers.expect_error(out, "E0525", "x.0 on a T")
}

test "a field read on Self in a trait default body is E0525" {
    let out = compile_test_helpers.compile_and_capture(#"
trait Coded {
    fn tag(self) -> Int { self.code }
}
fn main() { io.println("no impl") }
"#, "tp_field_self")
    compile_test_helpers.expect_error(out, "E0525", "self.code in a default body")
}

test "a bounded method call on a type parameter compiles" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T: Display](x: T) -> Str { x.display() }
fn main() { assert(f(3) == "3") }
"#, "tp_field_method_ok")
    compile_test_helpers.expect_compiles_clean(out, "x.display() on a T: Display")
}

test "a field read on a concrete struct inside a generic body compiles" {
    let out = compile_test_helpers.compile_and_capture(#"
type S { code: Int }
fn f[T](_x: T, s: S) -> Int { s.code }
fn main() { assert(f(true, S { code: 3 }) == 3) }
"#, "tp_field_concrete_ok")
    compile_test_helpers.expect_compiles_clean(out, "s.code on a concrete S in a generic body")
}

test "a T field of a generic struct read inside a generic body compiles" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn f[T](b: Box[T]) -> T { b.value }
fn main() { assert(f(Box { value: 3 }) == 3) }
"#, "tp_field_box_ok")
    compile_test_helpers.expect_compiles_clean(out, "b.value on a Box[T] in a generic body")
}
