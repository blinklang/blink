import compile_test_helpers

// Inside its own generic body a type parameter stands for every type at once, so it
// is equal only to itself. A body that uses T where a concrete type is wanted is a
// type error at the definition, whatever the body is later instantiated at.

test "a bare T bound to an Int let is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T](x: T) -> Int {
    let y: Int = x
    y
}
fn main() { let _ = f(1) }
"#, "rigid_let")
    compile_test_helpers.expect_error(out, "E0300", "T bound to an Int let")
}

test "a Box[T] bound to a Box[Int] let is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn f[T](x: Box[T]) -> Int {
    let b: Box[Int] = x
    b.value
}
fn main() { let _ = f(Box { value: 1 }) }
"#, "rigid_box_let")
    compile_test_helpers.expect_error(out, "E0300", "Box[T] bound to a Box[Int] let")
}

test "a struct literal field of type T in a Box[Int] let is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn f[T](x: T) -> Int {
    let b: Box[Int] = Box { value: x }
    b.value
}
fn main() { let _ = f(1) }
"#, "rigid_lit")
    compile_test_helpers.expect_error(out, "E0300", "Box literal with a T field in a Box[Int] let")
}

test "a T returned as Int is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T](x: T) -> Int { x }
fn main() { let _ = f(1) }
"#, "rigid_ret")
    compile_test_helpers.expect_error(out, "E0300", "T returned as Int")
}

test "a T passed to an Int parameter is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
fn want(n: Int) -> Int { n }
fn f[T](x: T) -> Int { want(x) }
fn main() { let _ = f(1) }
"#, "rigid_arg")
    compile_test_helpers.expect_error(out, "E0300", "T passed to an Int parameter")
}

test "a generic body that is never called is still E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
fn f[T](x: T) -> Int {
    let y: Int = x
    y
}
fn main() { io.println("never calls f") }
"#, "rigid_uncalled")
    compile_test_helpers.expect_error(out, "E0300", "uncalled generic body binds T to Int")
}

test "a polymorphic impl method that reads its T field as Int is E0300" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
impl[T] Box[T] {
    fn as_int(self) -> Int { self.value }
}
fn main() {
    let b = Box { value: 1 }
    let _ = b.as_int()
}
"#, "rigid_impl")
    compile_test_helpers.expect_error(out, "E0300", "impl[T] method returns its T field as Int")
}

test "a T passed on as T and returned as T compiles" {
    let out = compile_test_helpers.compile_and_capture(#"
type Box[T] { value: T }
fn id[U](u: U) -> U { u }
fn f[T](x: T) -> Box[T] {
    let y: T = id(x)
    Box { value: y }
}
fn main() {
    let n: Int = f(1).value
    assert(n == 1)
}
"#, "rigid_ok")
    compile_test_helpers.expect_compiles_clean(out, "T kept as T through a generic call and a literal")
}

test "a bounded T reaches a concrete type only through its bound" {
    let out = compile_test_helpers.compile_and_capture(#"
fn show[T: Display](x: T) -> Str {
    let s: Str = x.display()
    s
}
fn main() { assert(show(3) == "3") }
"#, "rigid_bound_ok")
    compile_test_helpers.expect_compiles_clean(out, "T: Display turned into Str by its bound")
}
