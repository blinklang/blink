// A method call that no rule of inference answers, in a program with no other error, stops
// the type check (section 6.7): a clean `blink check` must not hand the build a node with no
// type. Where the spec gives the call a meaning, the missing rule is the compiler's fault, so
// the report is an internal error and not an error in the program.
import std.fs
import compiler.{compile_to_program}
import typecheck.{check_types, tc_unresolved_call_count}
import diagnostics.{diag_count, diag_entries, diag_ice_count, diag_reset, lint_set_override}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn check_src(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    check_src_lint(path, src, "", "")
}

// With one [lints] entry in force, as blink.toml would set it.
fn check_src_lint(path: Str, src: Str, lint: Str, level: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS, Env.Exit, Env.Read, IO {
    init_embedded_stdlib()
    fs.write(path, src).unwrap()
    diag_reset()
    if lint != "" { lint_set_override(lint, level) }
    let _program = compile_to_program(path, 1)
    check_types(_program)
    let _ = fs.delete(path)
}

fn sites(severity: Str) -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == severity { out.push("{d.line}:{d.col} {d.message}") }
    }
    out
}

fn codes(severity: Str) -> List[Str] {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.severity == severity { out.push(d.code) }
    }
    out
}

fn assert_starts(got: List[Str], want: List[Str]) {
    assert_eq(got.len(), want.len())
    let mut i = 0
    while i < want.len() {
        assert(got.get(i).unwrap().starts_with(want.get(i).unwrap()))
        i = i + 1
    }
}

// F32.from_bits is in the spec (section 3.2) and inference has no rule for it yet, so it
// stands for any call the spec allows and the compiler cannot type.
test "F32.from_bits with no rule to type it is internal error I0023 at check" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let f = F32.from_bits(1)\n")
    s = s.concat("    io.println(\"\{f}\")\n")
    s = s.concat("}\n")
    check_src("build/tc_unclaimed_spec_valid.bl", s)
    assert(tc_unresolved_call_count() > 0)
    assert_eq(diag_count, 0)
    assert_eq(codes("ice"), ["I0023"])
    assert_starts(sites("ice"), ["2:13 no rule of inference answered the call `from_bits`"])
}

test "Sized.len of an unanswered F32.from_bits is one I0023, not one per call" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let n = Sized.len(F32.from_bits(1))\n")
    s = s.concat("    io.println(\"\{n}\")\n")
    s = s.concat("}\n")
    check_src("build/tc_unclaimed_nested.bl", s)
    assert_eq(diag_count, 0)
    assert_eq(codes("ice"), ["I0023"])
}

test "Sized.len() with no argument is E0505 at check: it has no receiver" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let n = Sized.len()\n")
    s = s.concat("    io.println(\"\{n}\")\n")
    s = s.concat("}\n")
    check_src("build/tc_unclaimed_no_receiver.bl", s)
    assert_eq(diag_ice_count, 0)
    assert_eq(codes("error"), ["E0505"])
    assert_starts(sites("error"), ["2:13 `Sized.len` has no receiver"])
}

// A [lints] level reaches only warnings (section 4.16.8). An E0505 it lowered would let check
// pass over a call with no type.
test "UnresolvedMethod set to warn under [lints] stays E0505 on a missing static" {
    let mut s = "type P \{ n: Int }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let v = P.nope(1)\n")
    s = s.concat("    io.println(\"\{v}\")\n")
    s = s.concat("}\n")
    check_src_lint("build/tc_unclaimed_lint_static.bl", s, "UnresolvedMethod", "warn")
    assert_eq(codes("error"), ["E0505"])
    assert_eq(diag_ice_count, 0)
}

test "UnresolvedMethod set to warn under [lints] stays E0505 on a missing method" {
    let mut s = "type P \{ n: Int }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let p = P \{ n: 1 }\n")
    s = s.concat("    let v = p.nope(1)\n")
    s = s.concat("    io.println(\"\{v}\")\n")
    s = s.concat("}\n")
    check_src_lint("build/tc_unclaimed_lint_method.bl", s, "UnresolvedMethod", "warn")
    assert_eq(codes("error"), ["E0505"])
    assert_eq(diag_ice_count, 0)
}

test "UnresolvedMethod set to off under [lints] does not give a clean check on F32.from_bits" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let f = F32.from_bits(1)\n")
    s = s.concat("    io.println(\"\{f}\")\n")
    s = s.concat("}\n")
    check_src_lint("build/tc_unclaimed_lint_off.bl", s, "UnresolvedMethod", "off")
    assert_eq(codes("ice"), ["I0023"])
}
