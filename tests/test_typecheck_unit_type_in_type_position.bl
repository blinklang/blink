// The spec calls `()` an ordinary type: section 3 says a block whose tail type is `()`
// satisfies `-> ()`, and that the success payload of a fallible operation returning
// nothing is written `Result[(), E]`. The parser read `(` in type position as the start
// of a tuple and then demanded an element, so neither spelling could be written at all.
//
// `()` and the omitted return type name the same type, so these rows compare the tid
// `()` resolves to against the one the other spellings already produce, rather than
// against a string alone.
import lower_test_helpers.{probe, rhs_of, assert_eq_str}
import typecheck.{tc_lookup_node_tid, tc_resolve, tc_type_str}
import std.io

fn unit_return_src() -> Str {
    #"fn explicit() -> () { }
fn omitted() { }
fn main() {
    let a = explicit()
    let b = omitted()
}
"#
}

fn unit_carrier_src() -> Str {
    #"fn step() -> Result[(), Str] {
    Ok(())
}
fn main() {
    let r = step()
}
"#
}

fn tid_of_let(label: Str, name: Str) -> Int {
    let tid = tc_lookup_node_tid(rhs_of(name))
    if tid < 0 { io.println("FAIL: {label} has no recorded type") }
    assert(tid >= 0)
    tid
}

test "a function may write its unit return type as ()" {
    let _p = probe("unit_return", unit_return_src())
    let explicit = tid_of_let("explicit()", "a")
    assert_eq_str("explicit()", tc_type_str(tc_resolve(explicit)), "Void")
}

test "the explicit unit return type is the type an omitted one already names" {
    let _p = probe("unit_return_same", unit_return_src())
    let explicit = tid_of_let("explicit()", "a")
    let omitted = tid_of_let("omitted()", "b")
    assert_eq(tc_resolve(explicit), tc_resolve(omitted))
}

test "the unit type is writable as a generic argument" {
    let _p = probe("unit_carrier", unit_carrier_src())
    let carrier = tid_of_let("step()", "r")
    assert_eq_str("step()", tc_type_str(tc_resolve(carrier)), "Result[Void, Str]")
}
