// UnixConn and UnixStream have the same methods and differ only in the call that makes them,
// so a type mismatch between them has a note that names each type and its maker
// (sections/04_effects.md §4.4.6). A type the user declares with one of these names is not
// std's and gets no note.

import compile_test_helpers

fn conn_first() -> Str {
    "`UnixConn` is made by `UnixListener.accept`; `UnixStream` is made by `unix_connect`"
}

fn stream_first() -> Str {
    "`UnixStream` is made by `unix_connect`; `UnixConn` is made by `UnixListener.accept`"
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

fn mismatches(body: Str, tag: Str) -> Str ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let src = "import std.net.\{NetError, UnixConn, UnixStream, UnixListener}\n{body}\nfn main() \{ }\n"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0300", "{tag} is a type mismatch")
    out
}

test "a UnixStream given for a UnixConn argument names both makers" {
    let out = mismatches(#"fn handle(c: UnixConn) { }
fn relay(s: UnixStream) {
    handle(s)
}"#, "unix_maker_arg")
    compile_test_helpers.expect_contains(out, stream_first(), "the note names the found type first")
    assert_eq(count(out, "is made by `unix_connect`"), 1)
}

test "a UnixConn given for a UnixStream names the found type first" {
    let out = mismatches(#"fn handle(s: UnixStream) { }
fn relay(c: UnixConn) {
    handle(c)
}"#, "unix_maker_arg_back")
    compile_test_helpers.expect_contains(out, conn_first(), "the note names UnixConn first")
}

test "a let, a return, an assignment and a field each carry the note" {
    let out = mismatches(#"type Box { c: UnixConn }
fn bind(s: UnixStream) {
    let _c: UnixConn = s
}
fn tail(s: UnixStream) -> UnixConn { s }
fn early(s: UnixStream) -> UnixConn { return s }
fn store(s: UnixStream, c: UnixConn) {
    let mut x = c
    x = s
    let _ = x
}
fn wrap(s: UnixStream) -> Box { Box { c: s } }
fn accepted(l: UnixListener) -> UnixStream ! Net.Listen { l.accept().unwrap() }"#, "unix_maker_sites")
    assert_eq(count(out, "\"code\":\"E0300\""), 6)
    assert_eq(count(out, stream_first()), 5)
    assert_eq(count(out, conn_first()), 1)
}

test "a mismatch with a user type named UnixConn has no maker note" {
    let src = #"import std.net.{UnixStream}
type UnixConn { n: Int }
fn handle(c: UnixConn) { }
fn relay(s: UnixStream) {
    handle(s)
}
fn main() { }
"#
    let out = compile_test_helpers.compile_and_capture(src, "unix_maker_user_type")
    compile_test_helpers.expect_error(out, "E0300", "the user type does not take a UnixStream")
    assert_eq(count(out, "is made by"), 0)
}

test "an if, a match and a ?? default each carry the note" {
    let out = mismatches(#"fn pick(b: Bool, s: UnixStream, c: UnixConn) -> UnixConn {
    if b { c } else { s }
}
fn bare(b: Bool, s: UnixStream, c: UnixConn) {
    let _x = if b { c } else { s }
}
fn arms(b: Bool, s: UnixStream, c: UnixConn) -> UnixConn {
    match b {
        true => c
        false => s
    }
}
fn fallback(o: Option[UnixConn], s: UnixStream) {
    let _ = o ?? s
}"#, "unix_maker_branches")
    assert_eq(count(out, "\"code\":\"E0300\""), 4)
    assert_eq(count(out, stream_first()), 4)
}

test "a closure parameter and a closure return each carry the note" {
    let out = mismatches(#"fn takes(g: fn(UnixConn)) { }
fn gives(g: fn() -> UnixConn) { }
fn param(s: UnixStream) {
    takes(fn(x: UnixStream) { let _ = x })
}
fn ret(s: UnixStream) {
    gives(fn() -> UnixStream { s })
}"#, "unix_maker_closure_sig")
    assert_eq(count(out, "\"code\":\"E0300\""), 2)
    assert_eq(count(out, stream_first()), 2)
}

test "a closure with no return type carries the note for a return and for a sibling closure" {
    let out = mismatches(#"fn early(b: Bool, s: UnixStream, c: UnixConn) {
    let g = fn() {
        if b { return c }
        s
    }
    let _ = g
}
fn listed(s: UnixStream, c: UnixConn) {
    let gs = [fn() { c }, fn() { s }]
    let _ = gs
}"#, "unix_maker_closure_ret")
    assert_eq(count(out, "\"code\":\"E0300\""), 2)
    assert_eq(count(out, conn_first()), 1)
    assert_eq(count(out, stream_first()), 1)
}

test "a comparison names the left operand first" {
    let out = mismatches(#"fn same(s: UnixStream, c: UnixConn) -> Bool { s == c }
fn other(s: UnixStream, c: UnixConn) -> Bool { c != s }"#, "unix_maker_compare")
    assert_eq(count(out, "\"code\":\"E0300\""), 2)
    assert_eq(count(out, stream_first()), 1)
    assert_eq(count(out, conn_first()), 1)
}

test "a call of a fn value carries the note" {
    let out = mismatches(#"fn apply(g: fn(UnixConn), s: UnixStream) {
    g(s)
}"#, "unix_maker_fn_value")
    compile_test_helpers.expect_contains(out, stream_first(), "the call of a fn value has the note")
}

test "a pair inside a Result, an Option, a List, a tuple or a fn type carries the note" {
    let out = mismatches(#"fn ok(s: UnixStream) -> Result[UnixConn, NetError] {
    Ok(s)
}
fn wrapped(s: UnixStream) {
    let _o: Option[UnixConn] = Some(s)
    let _l: List[UnixConn] = [s]
    let _t: (UnixConn, Int) = (s, 1)
}
fn mk(s: UnixStream) -> UnixStream { s }
fn fn_type() {
    let _g: fn(UnixStream) -> UnixConn = mk
}"#, "unix_maker_nested")
    assert_eq(count(out, "\"code\":\"E0300\""), 5)
    assert_eq(count(out, stream_first()), 5)
}
