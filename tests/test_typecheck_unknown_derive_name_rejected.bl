// @derive names a trait the compiler synthesizes. A name outside that set is the author's
// mistake, and it has to be named where the author can still see the annotation: while the
// types are checked. Reporting it from the derive stage of codegen means a program that
// never reaches codegen keeps the misspelling, and the failure then arrives as a missing
// method far from the line that asked for it.

import lower_test_helpers.{probe, probe_but}

fn src_unknown_derive() -> Str {
    #"@derive(Eqq)
type Point {
    x: Int
}

fn main() {
    let p = Point { x: 1 }
    let _keep = p.x
}
"#
}

fn src_known_derive() -> Str {
    #"@derive(Eq)
type Point {
    x: Int
}

fn main() {
    let p = Point { x: 1 }
    let _keep = p.x
}
"#
}

test "a misspelled derive name is rejected while the types are checked" {
    let _p = probe_but("tc_unknown_derive", src_unknown_derive(), "UnknownDerive")
}

test "a derive name the compiler synthesizes is accepted" {
    let _p = probe("tc_known_derive", src_known_derive())
}
