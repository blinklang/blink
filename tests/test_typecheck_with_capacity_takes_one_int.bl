// `List.with_capacity(n)` and `StringBuilder.with_capacity(n)` take exactly one Int
// (sections/03_types.md *Capacity*). Any other argument, or any other count, is refused by the
// front end, so no such call reaches codegen.
import cg_test_helpers.{cg_probe_begin}
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_ice_count}

// Checks `src` and answers how many errors it recorded. An internal error fails the row.
fn errors_in(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    env.set_var("BLINK_ROOT", process.run("pwd", []).unwrap().out.trim())
    let path = "build/{stem}_probe.bl"
    cg_probe_begin(path)
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    let _rm = process.run("rm", ["-f", path]).unwrap()
    assert_eq(diag_ice_count, 0)
    let mut n = 0
    for d in diag_entries {
        if d.severity == "error" { n = n + 1 }
    }
    n
}

fn diags_of(severity: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == severity { n = n + 1 }
    }
    n
}

fn errors_named(name: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "error" && d.name == name { n = n + 1 }
    }
    n
}

fn first_error_help() -> Str {
    for d in diag_entries {
        if d.severity == "error" { return d.help }
    }
    ""
}

fn wrap(body: Str) -> Str {
    "fn main() \{\n{body}\n}\n"
}

test "List.with_capacity(n) with an Int n checks clean, with no warning" {
    assert_eq(errors_in("wcap_list_int", wrap("    let n = 4\n    let mut xs = List.with_capacity(n)\n    xs.push(1)\n    let c: Int = xs.capacity()\n    io.println(\"\{c}\")")), 0)
    assert_eq(diags_of("warning"), 0)
}

test "capacity() on a List is an Int" {
    assert_eq(errors_in("wcap_list_cap_int", wrap("    let xs: List[Int] = List.with_capacity(3)\n    let c: Str = xs.capacity()\n    io.println(c)")), 1)
    assert_eq(errors_named("UnresolvedMethod"), 0)
}

test "List.with_capacity with a Str is a type error" {
    assert_eq(errors_in("wcap_list_str", wrap("    let xs: List[Int] = List.with_capacity(\"8\")\n    io.println(\"\{xs.len()}\")")), 1)
}

test "List.with_capacity with a Float is a type error" {
    assert_eq(errors_in("wcap_list_float", wrap("    let xs: List[Int] = List.with_capacity(8.0)\n    io.println(\"\{xs.len()}\")")), 1)
}

test "List.with_capacity with no argument is an error" {
    assert_eq(errors_in("wcap_list_none", wrap("    let xs: List[Int] = List.with_capacity()\n    io.println(\"\{xs.len()}\")")), 1)
}

test "List.with_capacity with two arguments is an error" {
    assert_eq(errors_in("wcap_list_two", wrap("    let xs: List[Int] = List.with_capacity(1, 2)\n    io.println(\"\{xs.len()}\")")), 1)
}

test "StringBuilder.with_capacity with a Str is a type error" {
    assert_eq(errors_in("wcap_sb_str", wrap("    let sb = StringBuilder.with_capacity(\"8\")\n    io.println(\"\{sb.len()}\")")), 1)
}

test "StringBuilder.with_capacity with no argument is an error" {
    assert_eq(errors_in("wcap_sb_none", wrap("    let sb = StringBuilder.with_capacity()\n    io.println(\"\{sb.len()}\")")), 1)
}

test "StringBuilder.with_capacity with two arguments is an error" {
    assert_eq(errors_in("wcap_sb_two", wrap("    let sb = StringBuilder.with_capacity(1, 2)\n    io.println(\"\{sb.len()}\")")), 1)
}

test "capacity() takes no argument on a List" {
    assert_eq(errors_in("wcap_list_cap_arg", wrap("    let xs: List[Int] = List.new()\n    io.println(\"\{xs.capacity(1)}\")")), 1)
    assert_eq(errors_named("UnresolvedMethod"), 0)
}

test "the repair for a bare List(n) names List.with_capacity" {
    assert_eq(errors_in("wcap_list_bare", wrap("    let xs: List[Int] = List(8)\n    io.println(\"\{xs.len()}\")")), 1)
    assert(first_error_help().contains("List.with_capacity("))
}
