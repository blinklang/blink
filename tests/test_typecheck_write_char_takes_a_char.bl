// Section 3 signs `StringBuilder.write_char(self, c: Char)`. Typecheck let any argument
// through, so `buf.write_char("x")` passed the front end and codegen then handed a string
// to the Char-to-text conversion, which the C compiler rejects. A Str argument is a type
// error at the call, the same one any other builtin method reports.

import std.fs
import std.io
import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_entries, diag_reset}
import embedded_stdlib_registry.{init_embedded_stdlib}

fn probe(path: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS {
    init_embedded_stdlib()
    write_file(path, src)
    diag_reset()
    let program = compile_to_program(path, 1)
    check_types(program)
    let _ = fs.delete(path)
    program
}

fn messages_reported() -> Str {
    let mut out = ""
    for d in diag_entries {
        if d.severity == "error" { out = out.concat("{d.code} {d.message}\n") }
    }
    out
}

fn sb_src(arg: Str) -> Str {
    "fn main() \{\n    let buf = StringBuilder.new()\n    buf.write_char({arg})\n    assert(buf.len() == 1)\n}\n"
}

test "write_char rejects a Str argument" {
    let _ = probe("build/tc_write_char_str.bl", sb_src("\"x\""))
    let got = messages_reported()
    let want = "E0300 argument 1 of `StringBuilder.write_char` expects Char, got Str\n"
    if got != want { io.println("FAIL: write_char(\"x\"): got '{got}'") }
    assert_eq(got, want)
}

test "write_char rejects an Int argument" {
    let _ = probe("build/tc_write_char_int.bl", sb_src("7"))
    let got = messages_reported()
    let want = "E0300 argument 1 of `StringBuilder.write_char` expects Char, got Int\n"
    if got != want { io.println("FAIL: write_char(7): got '{got}'") }
    assert_eq(got, want)
}

test "write_char accepts a Char literal" {
    let _ = probe("build/tc_write_char_lit.bl", sb_src("'x'"))
    let got = messages_reported()
    if got != "" { io.println("FAIL: write_char('x'): got '{got}'") }
    assert_eq(got, "")
}

test "write_char accepts a Char value" {
    let _ = probe("build/tc_write_char_val.bl", sb_src("\"xy\".char_at(0).unwrap()"))
    let got = messages_reported()
    if got != "" { io.println("FAIL: write_char(char_at): got '{got}'") }
    assert_eq(got, "")
}
