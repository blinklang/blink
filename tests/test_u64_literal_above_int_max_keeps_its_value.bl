// An integer literal takes its type from the expected type (03_types.md §3.2 *Integer literal
// range*): a literal is a value, never a bit pattern. A U64 literal above the Int maximum must
// keep its value in every position; held in a signed temp, 2^63 reads back as the Int minimum.

import compile_test_helpers

type U64Box { v: U64 }

type U64IntPair { a: U64, b: Int }

const U64_BIG: U64 = 18446744073709551614

const U64_HALF: U64 = 9223372036854775808

fn u64_id(x: U64) -> U64 { x }

fn u64_tail_sub[T](_x: T) -> U64 {
    let m: U64 = 18446744073709551615
    m - 9223372036854775808
}

fn u64_band(x: U64) -> Str {
    match x {
        18446744073709551615 => "max"
        9223372036854775808 => "half"
        _ => "other"
    }
}

fn u64_range(x: U64) -> Str {
    match x {
        9223372036854775808..=18446744073709551615 => "high"
        _ => "low"
    }
}

test "a U64 plus a literal above Int max adds the literal's value" {
    let t: U64 = 5
    let s = t + 9223372036854775808
    assert_eq("{s}", "9223372036854775813")
}

test "a literal above Int max on the left of a U64 add keeps its value" {
    let t: U64 = 5
    assert_eq("{9223372036854775808 + t}", "9223372036854775813")
}

test "a U64 minus a literal above Int max subtracts the literal's value" {
    let t: U64 = 18446744073709551615
    assert_eq("{t - 9223372036854775808}", "9223372036854775807")
}

test "an annotated let keeps a literal above Int max" {
    let a: U64 = 18446744073709551615
    assert_eq("{a}", "18446744073709551615")
}

test "a call argument keeps a literal above Int max" {
    assert_eq("{u64_id(9223372036854775809)}", "9223372036854775809")
}

test "a struct field init keeps a literal above Int max" {
    let bx = U64Box { v: 9223372036854775810 }
    assert_eq("{bx.v}", "9223372036854775810")
    let p = U64IntPair { a: 18446744073709551615, b: -9223372036854775808 }
    assert_eq("{p.a} {p.b}", "18446744073709551615 -9223372036854775808")
}

test "a const keeps a literal above Int max" {
    assert_eq("{U64_BIG}", "18446744073709551614")
    assert_eq("{U64_HALF}", "9223372036854775808")
}

test "a compound assign adds a literal above Int max" {
    let mut t: U64 = 1
    t += 9223372036854775808
    assert_eq("{t}", "9223372036854775809")
}

test "a method argument keeps a literal above Int max" {
    let mut xs: List[U64] = []
    xs.push(9223372036854775808)
    assert_eq("{xs.get(0).unwrap()}", "9223372036854775808")
}

test "comparisons against a literal above Int max use its value on either side" {
    let t: U64 = 9223372036854775809
    assert(t > 9223372036854775808)
    assert(9223372036854775808 < t)
    assert(t == 9223372036854775809)
    assert(9223372036854775809 == t)
    let small: U64 = 5
    assert(small < 9223372036854775808)
    assert(!(small > 9223372036854775808))
}

test "assert_eq compares a U64 against a literal above Int max" {
    let t: U64 = 9223372036854775808
    assert_eq(t, 9223372036854775808)
}

test "a generic body keeps a literal above Int max under each instance" {
    assert_eq("{u64_tail_sub(1)}", "9223372036854775807")
    assert_eq("{u64_tail_sub("a")}", "9223372036854775807")
}

test "a U64 match arm literal pattern above Int max matches its value" {
    assert_eq(u64_band(18446744073709551615), "max")
    assert_eq(u64_band(9223372036854775808), "half")
    assert_eq(u64_band(5), "other")
}

test "a U64 range pattern with bounds above Int max matches its values" {
    assert_eq(u64_range(18446744073709551615), "high")
    assert_eq(u64_range(9223372036854775808), "high")
    assert_eq(u64_range(9223372036854775807), "low")
}

test "each integer type holds its limits as literals" {
    let i64min: I64 = -9223372036854775808
    let i64max: I64 = 9223372036854775807
    let intmin: Int = -9223372036854775808
    let i32min: I32 = -2147483648
    let i32max: I32 = 2147483647
    let i16min: I16 = -32768
    let i16max: I16 = 32767
    let i8min: I8 = -128
    let i8max: I8 = 127
    let u64max: U64 = 18446744073709551615
    let u32max: U32 = 4294967295
    let u16max: U16 = 65535
    let u8max: U8 = 255
    assert_eq("{i64min} {i64max} {intmin}", "-9223372036854775808 9223372036854775807 -9223372036854775808")
    assert_eq("{i32min} {i32max} {i16min} {i16max} {i8min} {i8max}", "-2147483648 2147483647 -32768 32767 -128 127")
    assert_eq("{u64max} {u32max} {u16max} {u8max}", "18446744073709551615 4294967295 65535 255")
}

test "U64 overflow names its operands as unsigned values" {
    assert_panics(matching: "18446744073709551615 + 1") {
        let m: U64 = 18446744073709551615
        let _ = m + 1
    }
}

fn emit_fixture() -> Str {
    [
        "type Box \{ v: U64 }",
        "const K: U64 = 9223372036854775808",
        "fn id(x: U64) -> U64 \{ x }",
        "fn band(x: U64) -> Int \{",
        "    match x \{",
        "        9223372036854775808 => 1",
        "        9223372036854775809..=18446744073709551615 => 2",
        "        _ => 0",
        "    }",
        "}",
        "fn main() \{",
        "    let t: U64 = 5",
        "    let a: U64 = 9223372036854775808",
        "    let b = Box \{ v: 9223372036854775808 }",
        "    let mut c: U64 = 1",
        "    c += 9223372036854775808",
        "    let s = t + 9223372036854775808",
        "    let r = 9223372036854775808 + t",
        "    io.println(\"\{a} \{b.v} \{c} \{s} \{r} \{K} \{id(9223372036854775808)} \{band(t)} \{t < 9223372036854775808}\")",
        "}",
    ].join("\n")
}

fn occurrences(hay: Str, needle: Str) -> Int {
    hay.split(needle).len() - 1
}

// A bare decimal above the Int maximum is an unsigned constant in C only by a compiler
// extension, so every such literal must reach C spelled in its U64 type.
test "every U64 literal above Int max reaches C as an unsigned constant" {
    let c = compile_test_helpers.compile_and_emit_c(emit_fixture(), "u64_literal_emit")
    assert(c.contains("blink_main"))
    for digits in ["9223372036854775808", "9223372036854775809", "18446744073709551615"] {
        let all = occurrences(c, digits)
        assert(all > 0)
        assert_eq(occurrences(c, "UINT64_C({digits})"), all)
    }
}
