// A UE handler op returning `Result[Option[GenericStruct[Int]], E]` nests a generic-struct
// INSTANCE (QBox[Int]) as the element inside the Ok side's Option. That element must spell its
// mono stem (QBox_0Int) — the name the typedef and the handler/vtable side already use — not the
// base head (QBox). The op-return derivation recorded the base head, so the perform-site carrier
// conversion emitted the undeclared `blink_QBox` / `blink_Option_QBox` and a mismatched
// `blink_Result_Option_QBox_Err1` return type. Sibling of the top-level Option[GS] shape; here the
// element sits one level deeper, inside the Result's Ok Option.

import compile_test_helpers

fn src() -> Str {
    #"import std.io

type QBox[T] { val: T, tag: Int }
type Err1 { code: Int }

effect Store {
    effect Lookup {
        fn find(name: Str) -> Result[Option[QBox[Int]], Err1]
    }
}

fn lookup(name: Str) -> Result[Option[QBox[Int]], Err1] ! Store.Lookup {
    store.find(name)
}

fn main() {
    with handler Store {
        fn find(name: Str) -> Result[Option[QBox[Int]], Err1] {
            Ok(Some(QBox { val: 42, tag: 7 }))
        }
    } {
        let opt = lookup("x").unwrap()
        let qb = opt.unwrap()
        io.println("val={qb.val} tag={qb.tag}")
    }
}
"#
}

test "a UE-op Result[Option[QBox[Int]], E] Ok element round-trips through the mono-stem carrier" {
    let r = compile_test_helpers.compile_and_run(src(), "d077h5_ue_result_nested")
    if !r.out.contains("val=42") { compile_test_helpers.expect_contains(r.out, "val=42", "UE Result[Option[QBox[Int]]] — got '{r.err_out}'") }
    assert(r.out.contains("val=42 tag=7"))
    assert_eq(r.exit_code, 0)
}
