// A closure passed as a fn-typed argument must have its unannotated params
// inferred from the declared fn signature, both as a plain HOF call and when
// nested inside another closure's body.

test "unannotated closure param is inferred from a fn-typed argument's signature" {
    let r = apply(fn(w) { w.concat("!") }, "hi")
    assert_eq(r, "hi!")
}

test "unannotated closure param stays correctly typed when nested under another closure" {
    let nums: List[Int] = [1, 2, 3]
    let mut out = ""
    nums.for_each(fn(_n) {
        out = apply(fn(w) { w.concat("!") }, "hi")
    })
    assert_eq(out, "hi!")
}

fn apply(f: fn(Str) -> Str, s: Str) -> Str { f(s) }
