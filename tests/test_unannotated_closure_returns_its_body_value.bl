// A closure with no `-> R` returns what its body computes. Called through a list element, a
// declared fn-typed parameter, or a typed `let`, the caller must read back that value.

fn rv_apply(f: fn(Int) -> Int) -> Int { f(1) }

test "a closure in a list literal returns its body value" {
    let fs = [fn(i: Int) { i }, fn(i: Int) { i * 10 }]
    assert_eq(fs.get(0).unwrap()(1), 1)
    assert_eq(fs.get(1).unwrap()(4), 40)
}

test "a closure in a list spread returns its body value" {
    let fs = [..[fn(i: Int) { i * 3 }]]
    assert_eq(fs.get(0).unwrap()(5), 15)
}

test "a closure passed where fn(Int) -> Int is declared returns its body value" {
    assert_eq(rv_apply(fn(i: Int) { i }), 1)
    assert_eq(rv_apply(fn(i) { i + 41 }), 42)
}

test "a closure bound to a typed let returns its body value" {
    let g: fn(Int) -> Int = fn(i: Int) { i * 7 }
    assert_eq(g(3), 21)
}

test "a closure returns the value of an early return" {
    let h = fn(i: Int) {
        if i > 0 { return i }
        0 - i
    }
    assert_eq(h(5), 5)
    assert_eq(h(-2), 2)
}
