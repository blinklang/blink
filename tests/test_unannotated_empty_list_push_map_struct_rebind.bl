// An unannotated `let mut a = []` later push()ed a Map[Str,Point] and then
// rebound (`let g = a`) must keep the map value's struct name, so
// g.get(0).unwrap().get(k) emits blink_Option_Point, not blink_Option_int
// over a blink_Point*.

test "unannotated empty-list push of Map[Str,Point] survives a rebind and reads back the struct field" {
    let mut a = []
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 7 })
    a.push(m)
    let g = a
    assert_eq(g.get(0).unwrap().get("k").unwrap().x, 7)
}

type Point { x: Int }
