// An unannotated HOF closure (map/fold/...) reachable through an if-expr
// branch that is itself a call argument must still have its return type
// inferred from its body tail, the same as the already-fixed bare-tail,
// let-RHS, interpolation-part, and struct-field-value positions.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an unannotated map closure inside an if-expr call argument infers its return type",
    reason: "tc_walk_nested_hof_bodies has no IfExpr arm, so the closure inside the branch keeps a Void Fn tid and typechecking never assigns the branch's inner nodes a type, tripping an internal NodeCarriesNoType error",
    ticket: "1z5pfn",
) {
    let src = #"
import std.io

fn take(xs: List[Int]) -> Int {
    let mut t = 0
    for v in xs { t = t + v }
    t
}

fn main() ! IO {
    let a: List[Int] = [1, 2, 3]
    let c = true
    let t = take(if c { a.map(fn(x) { x * 2 }) } else { [] })
    io.println("t {t}")
}
"#
    let r = compile_and_run(src, "_unannotated_hof_closure_in_if_branch_argument")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "t 12\n")
}
