// A `let` with NO type annotation whose RHS is a call to a fn with a concrete
// `-> List[Tree[Int]]` return type must keep the element's mono instance
// through `.get(i).unwrap()` and a subsequent match, not erase to the bare
// unemitted enum head.

type Tree[T] {
    Leaf(value: T)
    Branch(left: Tree[T], right: Tree[T])
}

fn make() -> List[Tree[Int]] { [Tree.Leaf(1), Tree.Leaf(2)] }

test "unannotated let over a fn call returning List[GenericEnum[T]] keeps the element mono instance" {
    let xs = make()
    let t = xs.get(0).unwrap()
    match t {
        Leaf(v) => assert_eq(v, 1)
        Branch(_l, _r) => assert(false)
    }
}
