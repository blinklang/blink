import compile_test_helpers

// An un-annotated spawn closure takes its Handle payload from its body, and that body is first
// inferred from outside the closure's scope. A tail that reads a body-local comes back open
// (`Handle[?]`), so the spawn call must take the payload the in-scope walk finds.

test "a spawn body ending in a method on a body-local awaits its value" {
    let h = async.spawn(fn() {
        let xs: [Int] = [1, 2, 3]
        xs.len()
    })
    assert_eq(h.await, 3)
}

test "an inline await of such a spawn yields its value" {
    let n = async.spawn(fn() {
        let xs: [Int] = [1, 2, 3]
        xs.len()
    }).await
    assert_eq(n, 3)
}

test "a spawn body ending in an Option built from a body-local awaits the Option" {
    let h = async.spawn(fn() {
        let p = "v"
        Some(p.concat("-s"))
    })
    assert_eq(h.await.unwrap(), "v-s")
}

test "a spawn body ending in an open empty List still reports E0301" {
    let src = "fn main() \{\n    let h = async.spawn(fn() \{\n        let p = \"v\"\n        let _q = p.len()\n        []\n    })\n    io.println(\"\{h.await.len()}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "spawn_body_open_list", "E0301")
}
