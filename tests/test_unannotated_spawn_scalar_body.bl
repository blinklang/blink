// dt8zj2: an un-annotated spawn closure whose body is a bare scalar/string/list LITERAL (not a
// call returning a compound, which test_3z72k1 covers) must take its task return type from the
// inferred body, not a forced int64_t. A bare `"..."` body once emitted an int64_t task fn while
// the body returned char* -> gcc [-Wint-conversion]. These pin the literal-body reproduction.

test "an un-annotated spawn inferring a bare Str awaits the string" {
    let h = async.spawn(fn() {
        "inferred string"
    })
    assert_eq(h.await, "inferred string")
}

test "an un-annotated spawn inferring a bare Int awaits the int" {
    let h = async.spawn(fn() {
        40 + 2
    })
    assert_eq(h.await, 42)
}

test "an un-annotated spawn inferring a List literal awaits the list" {
    let h = async.spawn(fn() {
        [1, 2, 3]
    })
    let r = h.await
    assert_eq(r.len(), 3)
}
