// Spec §2.20: a panic in production code terminates the process with exit code 101.
// Every way to panic takes that exit: the builtins, a runtime-raised panic, an
// assertion failure outside a test, and a panic on a spawned task. env.exit picks its
// own code, and a test binary keeps the runner's exit rule (§8.10).

import compile_test_helpers.{compile_and_run, compile_and_run_test_json, run_via_cli}

test "panic in main exits 101 with its report on stderr" {
    let r = compile_and_run("fn main() \{\n    panic(\"boom\")\n}\n", "_uncaught_101_panic")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("panic: boom"))
}

test "a panic in a helper fn exits 101 and keeps earlier stdout" {
    let src = "fn deep(n: Int) -> Int \{\n    if n > 3 \{ panic(\"n out of range: \{n}\") }\n    n\n}\n\nfn main() ! IO \{\n    io.println(\"before\")\n    io.println(\"\{deep(9)}\")\n}\n"
    let r = compile_and_run(src, "_uncaught_101_helper")
    assert_eq(r.exit_code, 101)
    assert(r.out.contains("before"))
    assert(r.err_out.contains("n out of range: 9"))
}

test "blink run passes the program's exit 101 through and reports no compiler error" {
    let r = run_via_cli("fn main() \{\n    panic(\"boom\")\n}\n", "uncaught_101", "")
    let diag = "exit \{r.exit_code}; captured:\n\{r.out}\{r.err_out}"
    assert_eq(r.exit_code, 101, diag)
    assert(r.err_out.contains("panic: boom"), diag)
    assert(!r.err_out.contains("internal compiler error"), diag)
}

test "todo in main exits 101" {
    let r = compile_and_run("fn main() \{\n    todo()\n}\n", "_uncaught_101_todo")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("not yet implemented"))
}

test "unreachable in main exits 101" {
    let r = compile_and_run("fn main() \{\n    unreachable()\n}\n", "_uncaught_101_unreachable")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("unreachable"))
}

test "unwrap of None exits 101" {
    let r = compile_and_run("fn main() ! IO \{\n    let xs = [1]\n    io.println(\"\{xs.get(5).unwrap()}\")\n}\n", "_uncaught_101_unwrap")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.len() > 0)
}

test "a list index out of bounds raised by the runtime exits 101" {
    let src = "fn main() ! IO \{\n    let mut xs = [1]\n    let i = xs.len() + 3\n    xs.set(i, 2)\n    io.println(\"\{xs.len()}\")\n}\n"
    let r = compile_and_run(src, "_uncaught_101_oob")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("out of bounds"))
}

test "integer overflow exits 101" {
    let src = "fn main() ! IO \{\n    let a = 9223372036854775807\n    io.println(\"\{a + [1].len()}\")\n}\n"
    let r = compile_and_run(src, "_uncaught_101_overflow")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("overflow"))
}

test "a failing assert in main exits 101" {
    let r = compile_and_run("fn main() \{\n    assert(1 == 2)\n}\n", "_uncaught_101_assert")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("assertion failed: assert(1 == 2)"))
}

test "a panic on a spawned task exits 101" {
    let src = "fn main() ! IO \{\n    async.scope \{\n        let h = async.spawn(fn() -> Int \{\n            panic(\"from the task\")\n        })\n        io.println(\"\{h.await}\")\n    }\n}\n"
    let r = compile_and_run(src, "_uncaught_101_task")
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("from the task"))
}

test "env.exit(1) still exits 1" {
    let r = compile_and_run("fn main() ! Env \{\n    env.exit(1)\n}\n", "_uncaught_101_env_exit")
    assert_eq(r.exit_code, 1)
}

test "a test binary with a panicking test exits 1, not 101" {
    let src = "test \"boom\" \{\n    panic(\"boom\")\n}\n\ntest \"fine\" \{\n    assert(true)\n}\n"
    let r = compile_and_run_test_json(src, "_uncaught_101_runner")
    let diag = "exit \{r.exit_code}; captured:\n\{r.out}\{r.err_out}"
    assert_eq(r.exit_code, 1, diag)
    assert(r.out.contains("\"passed\":1"), diag)
}
