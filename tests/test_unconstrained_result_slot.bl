// An unconstrained Result/Option carrier slot must be error[CannotInferType] (E0301),
// uniformly with the bare-None case — discharging decisions/under-determined-types.md
// (6-0, STRICT, no carve-out) for the Result carrier.
//
// An unspecified carrier slot mints a fresh metavar (like None), so an unconstrained slot
// trips the E0301 region boundary, while a slot a context constrains — an annotation, a
// declared return on a direct tail, or a concrete arg position — unifies and pins with no
// annotation needed.

import compile_test_helpers
import std.io

fn assert_has(c: Str, needle: Str, label: Str) {
    if !c.contains(needle) { io.println("FAIL: {label} — missing '{needle}'") }
    assert(c.contains(needle))
}

fn assert_lacks(c: Str, needle: Str, label: Str) {
    if c.contains(needle) { io.println("FAIL: {label} — forbidden '{needle}' present") }
    assert(!c.contains(needle))
}

// ── the enforcement: unconstrained slots become E0301 ─────────────────────────

test "an unconstrained Ok Err-slot reports E0301" {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let x = Ok(3) }\n", "8tphh5_ok")
    assert_has(out, "E0301", "unconstrained Ok / CannotInferType")
    assert_lacks(out, "I0001", "unconstrained Ok / not an ICE")
}

test "an unconstrained Err Ok-slot reports E0301" {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let x = Err(\"boom\") }\n", "8tphh5_err")
    assert_has(out, "E0301", "unconstrained Err / CannotInferType")
    assert_lacks(out, "I0001", "unconstrained Err / not an ICE")
}

// Uniformity with the decision's own example: the Result carrier now behaves like None.
test "unconstrained Ok and bare None both report E0301" {
    let ok_out = compile_test_helpers.compile_and_capture("fn main() \{ let x = Ok(3) }\n", "8tphh5_uok")
    let none_out = compile_test_helpers.compile_and_capture("fn main() \{ let n = None }\n", "8tphh5_unone")
    assert_has(ok_out, "E0301", "Ok / uniform with None")
    assert_has(none_out, "E0301", "None / baseline")
}

// ── the constrained directions still compile (metavar unifies, no annotation burden) ──

test "an annotated let pins the Err slot — no E0301" {
    let src = "fn main() \{ let x: Result[Int, Str] = Ok(3)\n assert(x.is_ok()) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "8tphh5_ann")
    assert_lacks(out, "E0301", "annotated let / no under-determined error")
    assert_lacks(out, "I0001", "annotated let / no ICE")
    let r = compile_test_helpers.compile_and_run(src, "8tphh5_ann_run")
    if r.exit_code != 0 { io.println("FAIL: annotated let — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

test "a declared return pins the Err slot — no E0301" {
    let src = "fn mk() -> Result[Int, Str] \{ Ok(3) }\nfn main() \{ assert(mk().is_ok()) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "8tphh5_ret")
    assert_lacks(out, "E0301", "declared return / no under-determined error")
    assert_lacks(out, "I0001", "declared return / no ICE")
    let r = compile_test_helpers.compile_and_run(src, "8tphh5_ret_run")
    if r.exit_code != 0 { io.println("FAIL: declared return — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

// A concretely-typed parameter position constrains the Err slot backward — the same
// check_arg_value unify seam 3dpshm relies on. The mint is what gives it an α to bind.
test "a concretely typed param position pins the Err slot — no E0301" {
    let mut src = "fn consume(r: Result[Int, Str]) -> Int \{ match r \{ Ok(v) => v Err(e) => e.len() } }\n"
    src = src.concat("fn main() \{ let x = Ok(3)\n assert(consume(x) == 3) }\n")
    let out = compile_test_helpers.compile_and_capture(src, "8tphh5_arg")
    assert_lacks(out, "E0301", "arg position / no under-determined error")
    assert_lacks(out, "I0001", "arg position / no ICE")
    let r = compile_test_helpers.compile_and_run(src, "8tphh5_arg_run")
    if r.exit_code != 0 { io.println("FAIL: arg position — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

test "E0301 is in the error catalog" {
    compile_test_helpers.verify_catalog_entry("E0301", "CannotInferType")
}
