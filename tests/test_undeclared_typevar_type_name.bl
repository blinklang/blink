// A typevar-shaped type name (a single uppercase letter) is a type variable only
// where an enclosing generic declaration binds it. A non-generic function has no
// such binding, so a bare `T` in a return or parameter annotation names no type
// and is rejected like any other unknown name (error[UnknownType], E0507). It is
// not silently treated as an implicit, unbound type variable — Blink has no
// implicit generalization of free type variables in a signature.
//
// Contrast decisions/under-determined-types.md (E0301, CannotInferType): that
// governs a DECLARED type param nothing constrains (e.g. `fn mk[T]() -> RGT[T]`
// called with no pin). A name with no declaration at all is unknown, not
// under-determined — the two must not be conflated, so the declared-type-param
// controls below must stay clear of E0507.

import compile_test_helpers

// ── the hole: an undeclared typevar-shaped name is E0507, not an implicit typevar ──

test "a bare typevar-shaped return name in a non-generic fn is E0507" {
    compile_test_helpers.expect_compile_error("fn mk() -> T \{ 0 }\nfn main() \{ }\n", "undecl_tv_ret", "E0507")
}

test "a bare typevar-shaped param name in a non-generic fn is E0507" {
    compile_test_helpers.expect_compile_error("fn take(x: T) \{ }\nfn main() \{ }\n", "undecl_tv_param", "E0507")
}

// ── anchor: an ordinary unknown name already behaves this way ──

test "an unknown multi-char return type name is E0507" {
    compile_test_helpers.expect_compile_error("fn mk() -> Widget \{ 0 }\nfn main() \{ }\n", "undecl_widget", "E0507")
}

// ── controls: a DECLARED type param must still resolve, never E0507 ──

test "a declared type param used in param and return is not E0507" {
    let src = "fn id[T](x: T) -> T \{ x }\nfn main() \{ let n = id(5) assert(n == 5) }\n"
    compile_test_helpers.expect_no_error(src, "decl_tv_generic", "E0507")
}

test "a declared return-only type param resolves and is not E0507" {
    let src = "type RGT[T] \{ s: Set[T] }\nfn mk[T]() -> RGT[T] \{ RGT \{ s: Set() } }\nfn main() \{ let e: RGT[Int] = mk() assert(e.s.len() == 0) }\n"
    compile_test_helpers.expect_no_error(src, "decl_tv_retonly", "E0507")
}
