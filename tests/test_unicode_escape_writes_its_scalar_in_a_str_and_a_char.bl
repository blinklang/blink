// `\u{H}` writes the Unicode scalar value with hex code H, 1 to 6 digits with leading zeros
// allowed, in a Str and in a Char. Its `{` is part of the escape and never opens an
// interpolation hole. A char literal holds one scalar, so a raw multi-byte char is one Char
// (sections/02_syntax.md §2.4, "Unicode escapes").

import compile_test_helpers

fn program() -> Str {
    [
        "fn main() \{",
        #"    io.println("\u{41}\u{042}\u{0043}|\u{1F600}|\u{e9}|a\u{7b}b\u{7d}")"#,
        #"    let a = '\u{41}'"#,
        #"    let smile = '\u{1f600}'"#,
        #"    let e = 'é'"#,
        #"    let raw_smile = '😀'"#,
        #"    let nul = '\u{0}'"#,
        #"    io.println("{a.to_int()} {smile.to_int()} {e.to_int()} {raw_smile.to_int()} {nul.to_int()}")"#,
        "}",
        "",
    ].join("\n")
}

test "a unicode escape writes its scalar in a Str and in a Char" {
    let r = compile_test_helpers.compile_and_run(program(), "unicode_escape_scalar")
    assert_eq(r.err_out, "")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "ABC|😀|é|a\{b}\n65 128512 233 128512 0\n")
}
