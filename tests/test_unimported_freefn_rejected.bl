import compile_test_helpers

// Spec §3.2.3 + §10.6: stdlib free functions are NOT in the prelude. A bare
// call to one without an explicit `import` must be an undefined-function error
// (E0504 / UndefinedFunction). fsmwz2 — emptying the prelude flips this from a
// clean compile to the rejection the spec requires.
fn main() {
    let bad_source = "fn main() \{\n    let _ = list_map([1, 2, 3], fn(x: Int) -> Int \{ x * 2 \})\n}\n"
    let output = compile_test_helpers.compile_and_capture(bad_source, "_test_unimported_freefn")
    compile_test_helpers.expect_error(output, "UndefinedFunction", "bare list_map without import is UndefinedFunction")
    compile_test_helpers.expect_error(output, "E0504", "bare list_map without import is E0504")
}
