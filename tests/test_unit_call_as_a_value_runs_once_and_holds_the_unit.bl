// A call that returns the unit `()` has no C value: its C shape is a `void` function. Where
// such a call is written as a value -- a struct field, a variant field, an argument -- the
// call still runs, once, for its effect, and the slot holds the unit's placeholder word.
// Placing the `void` call itself in the slot is a C compile error.

import compile_test_helpers.{compile_and_run}

test "a struct literal field filled by a unit call builds and reads its other field" {
    let src = #"
import std.io

type F { tag: Int, v: () }

fn nothing() -> () {}

fn main() ! IO {
    let f = F { tag: 6, v: nothing() }
    io.println("{f.tag}")
}
"#
    let r = compile_and_run(src, "_unit_call_struct_field")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "6\n")
}

test "a unit call in a struct field runs exactly once" {
    let src = #"
import std.io

type F { tag: Int, v: () }

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let f = F { tag: 6, v: nothing() }
    io.println("{f.tag}")
}
"#
    let r = compile_and_run(src, "_unit_call_struct_field_once")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n6\n")
}

test "a generic struct instantiated at the unit takes a unit call for its field" {
    let src = #"
import std.io

type Box[T] { v: T, n: Int }

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let b = Box { v: nothing(), n: 4 }
    io.println("{b.n}")
}
"#
    let r = compile_and_run(src, "_unit_call_generic_struct_field")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n4\n")
}

test "a struct-style variant field filled by a unit call runs it once" {
    let src = #"
import std.io

type E { V { x: (), y: Int } }

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let e = E.V { x: nothing(), y: 5 }
    match e {
        E.V { x, y } => io.println("y {y}")
    }
}
"#
    let r = compile_and_run(src, "_unit_call_variant_field")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\ny 5\n")
}

test "a unit call passed as an argument runs once before the callee" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn take(u: (), n: Int) -> Int { n }

fn main() ! IO {
    io.println("{take(nothing(), 3)}")
}
"#
    let r = compile_and_run(src, "_unit_call_argument")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n3\n")
}

test "a unit literal in a struct field still builds" {
    let src = #"
import std.io

type F { tag: Int, v: () }

fn main() ! IO {
    let f = F { tag: 6, v: () }
    io.println("{f.tag}")
}
"#
    let r = compile_and_run(src, "_unit_literal_struct_field")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "6\n")
}

test "a unit call passed to a closure runs once before the closure" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let take = fn(u: (), n: Int) -> Int { n }
    io.println("{take(nothing(), 7)}")
}
"#
    let r = compile_and_run(src, "_unit_call_closure_argument")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n7\n")
}

test "a unit call passed to a closure held in a struct field runs once" {
    let src = #"
import std.io

type H { f: fn((), Int) -> Int }

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let h = H { f: fn(u: (), n: Int) -> Int { n } }
    io.println("{h.f(nothing(), 8)}")
}
"#
    let r = compile_and_run(src, "_unit_call_field_closure_argument")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n8\n")
}
