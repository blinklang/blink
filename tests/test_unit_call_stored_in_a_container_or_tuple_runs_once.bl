// A call that returns the unit `()` has no C value: its C shape is a `void` function. Where
// such a call is written as an element -- pushed, set or inserted into a container, written
// in a container or tuple literal, or passed to an effect operation -- the call still runs,
// once, for its effect, and the slot holds the unit's placeholder word. Placing the `void`
// call itself in the slot is a C compile error.

import compile_test_helpers.{compile_and_run}

test "a unit call pushed onto a list runs once and adds one element" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let mut xs: List[()] = []
    xs.push(nothing())
    io.println("{xs.len()}")
}
"#
    let r = compile_and_run(src, "_unit_store_push")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n1\n")
}

test "a unit call set into a list slot runs once and keeps the length" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let mut xs: List[()] = [()]
    xs.set(0, nothing())
    io.println("{xs.len()}")
}
"#
    let r = compile_and_run(src, "_unit_store_set")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n1\n")
}

test "a unit call inserted as a map value runs once and adds the key" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let mut m: Map[Str, ()] = Map()
    m.insert("a", nothing())
    io.println("{m.len()} {m.contains_key("a")}")
}
"#
    let r = compile_and_run(src, "_unit_store_map_insert")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n1 true\n")
}

test "a unit call written in a list literal runs once, in element order" {
    let src = #"
import std.io

fn nothing(tag: Str) -> () { io.println(tag) }

fn main() ! IO {
    let xs: List[()] = [nothing("first"), (), nothing("second")]
    io.println("{xs.len()}")
}
"#
    let r = compile_and_run(src, "_unit_store_list_literal")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "first\nsecond\n3\n")
}

test "a unit call written in a tuple literal runs once and the other element reads back" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let t = (nothing(), 3)
    io.println("{t.1}")
}
"#
    let r = compile_and_run(src, "_unit_store_tuple_literal")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n3\n")
}

test "a unit call passed to an effect operation runs once before the handler" {
    let src = #"
import std.io

effect Tally {
    effect Count {
        fn add(u: (), n: Int) -> Int
    }
}

fn nothing() -> () { io.println("side") }

fn run() -> Int ! Tally.Count, IO { tally.add(nothing(), 4) }

fn main() ! IO {
    let h = handler Tally {
        fn add(u: (), n: Int) -> Int { n + 1 }
    }
    with h {
        io.println("{run()}")
    }
}
"#
    let r = compile_and_run(src, "_unit_store_effect_arg")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\n5\n")
}

test "the unit literal in the same element positions still builds" {
    let src = #"
import std.io

fn main() ! IO {
    let mut xs: List[()] = [(), ()]
    xs.push(())
    xs.set(0, ())
    let mut m: Map[Str, ()] = Map()
    m.insert("a", ())
    let t = ((), 3)
    io.println("{xs.len()} {m.len()} {t.1}")
}
"#
    let r = compile_and_run(src, "_unit_store_literal_control")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3 1 3\n")
}
