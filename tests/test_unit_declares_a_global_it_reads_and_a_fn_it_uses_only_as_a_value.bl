// A per-module unit holds the declaration of each symbol of another module its C names. A read
// of another module's global and a fn passed as a value, never called by name, name their
// symbols as a call does, so the unit declares both and builds. An unused pub fn added to that
// module compiles that module's unit alone, and the binary still reads the global and calls
// the fn.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"global_and_fn_value_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/lib.bl", [
        #"pub let mut counter = 0"#,
        #""#,
        #"pub fn bump() {"#,
        #"    counter = counter + 1"#,
        #"}"#,
        #""#,
        #"pub fn helper(n: Int) -> Int {"#,
        #"    n + 40"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/reader.bl", [
        #"import lib.{counter}"#,
        #""#,
        #"pub fn read_count() -> Int {"#,
        #"    counter * 100"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/passer.bl", [
        #"import lib.{helper}"#,
        #""#,
        #"fn apply(f: fn(Int) -> Int, x: Int) -> Int {"#,
        #"    f(x)"#,
        #"}"#,
        #""#,
        #"pub fn pass_helper() -> Int {"#,
        #"    apply(helper, 2)"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import lib.{bump}"#,
        #"import passer.{pass_helper}"#,
        #"import reader.{read_count}"#,
        #""#,
        #"fn main() {"#,
        #"    bump()"#,
        #"    io.println("values {read_count()} {pass_helper()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink {args}"]).unwrap()
}

// The units a build compiled, read from its build.units trace, sorted.
fn units_compiled(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        let mark = "[dbg:build.units] compile "
        if line.starts_with(mark) {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len()).trim())
        }
    }
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap() > cur {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

fn build_units(tree: Str) -> List[Str] {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    units_compiled(r)
}

test "a unit declares a global it reads and a fn it passes as a value, and an unused pub fn added beside them compiles one unit" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_global_and_fn_value_{getpid()}"
    dev_tree(root, tree)
    let cold = build_units(tree)
    let out_cold = sh("{tree}/out/app")
    let reader_c = read_file("{tree}/out/app.units/reader.c")
    let passer_c = read_file("{tree}/out/app.units/passer.c")
    let lib = "{tree}/app/src/lib.bl"
    write_file(lib, "{read_file(lib)}\npub fn unused_fn() -> Int \{\n    7\n}\n")
    let lib_text = read_file(lib)
    let added = build_units(tree)
    let out_added = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(lib_text.contains("unused_fn"), "the edit did not apply: {lib_text}")
    assert(cold.contains("reader") && cold.contains("passer"), "the cold build did not compile every unit: {cold.join(",")}")
    assert(reader_c.contains("extern int64_t blink_lib_counter;"), "reader.c does not declare the global it reads:\n{reader_c}")
    assert(passer_c.contains("int64_t blink_lib_helper(int64_t n);"), "passer.c does not declare the fn it passes:\n{passer_c}")
    assert_eq(added.join(","), "lib")
    assert_eq(out_cold, "values 100 42")
    assert_eq(out_added, "values 100 42")
}
