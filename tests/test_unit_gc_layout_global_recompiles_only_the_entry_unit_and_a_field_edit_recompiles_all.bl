// A per-module unit holds a copy of the declarations it names, and a header with a line the
// scan cannot read goes into every unit whole, and into each unit's object key. A module-level
// global that holds a struct puts a guarded static GC layout function in the entry module's
// private header. The scan reads that block as one declaration, so no unit includes that
// header whole, the build's blink.build.unit_headers trace names none, and a private fn added to
// the entry module recompiles the entry unit alone.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"whole_header_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/lib.bl", [
        #"pub fn lib_value() -> Int {"#,
        #"    7"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import lib.{lib_value}"#,
        #""#,
        #"type Point {"#,
        #"    x: Int"#,
        #"    y: Int"#,
        #"}"#,
        #""#,
        #"type Cell {"#,
        #"    a: Int"#,
        #"    b: Str"#,
        #"}"#,
        #""#,
        #"let GRID: List[List[Point]] = [[Point { x: 11, y: 22 }]]"#,
        #""#,
        #"fn cell_text(c: Cell) -> Str {"#,
        #"    "{c.a} {c.b}""#,
        #"}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("values {GRID.get(0).unwrap().get(0).unwrap().y} {lib_value()} {cell_text(Cell { a: 1, b: "c" })}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=blink.build.units,blink.build.unit_headers build/blink {args}"]).unwrap()
}

// The units a build compiled, read from its blink.build.units trace, sorted.
fn units_compiled(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        let mark = "[trace:blink.build.units] compile "
        if line.starts_with(mark) {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len()).trim())
        }
    }
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap() > cur {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

// The lines of a build's blink.build.unit_headers trace, sorted.
fn whole_headers(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        let mark = "[trace:blink.build.unit_headers] whole "
        if line.starts_with(mark) {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len()).trim())
        }
    }
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap() > cur {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

fn build_app(tree: Str) -> ProcessResult ! Process.Spawn {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    r
}

test "a GC layout block puts no header in whole: a new global recompiles only the entry unit, a field edit every unit" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_whole_header_{getpid()}"
    dev_tree(root, tree)
    let cold = build_app(tree)
    let out_cold = sh("{tree}/out/app")
    let lib_c = fs.read("{tree}/out/app.units/lib.c").unwrap()
    let main_c = "{tree}/app/src/main.bl"
    fs.write(main_c, "{fs.read(main_c).unwrap()}\nfn helper_added() -> Int \{\n    3\n}\n").unwrap()
    let main_text = fs.read(main_c).unwrap()
    let added = build_app(tree)
    let out_added = sh("{tree}/out/app")
    // A global of a struct the program already has adds a layout block to the entry module's
    // private header and leaves the types header as it was. Only the entry unit names it.
    let types_before = fs.read("{tree}/out/app.units/blink.types.h").unwrap()
    fs.write(main_c, "{fs.read(main_c).unwrap()}\nlet CELLS: List[List[Cell]] = [[Cell \{ a: 4, b: \"held\" }]]\n").unwrap()
    let held = build_app(tree)
    let types_held = fs.read("{tree}/out/app.units/blink.types.h").unwrap()
    let priv_held = fs.read("{tree}/out/app.units/__main__.priv.h").unwrap()
    let main_c_held = fs.read("{tree}/out/app.units/__main__.c").unwrap()
    let lib_c_held = fs.read("{tree}/out/app.units/lib.c").unwrap()
    // A pointer field changes Point's layout block. It changes the types header too, which
    // every unit's key covers, so every unit compiles; the block itself reaches only the unit
    // that names it.
    fs.write(main_c, fs.read(main_c).unwrap().replace("    y: Int\n", "    y: Int\n    tag: Str\n").replace("Point \{ x: 11, y: 22 }", "Point \{ x: 11, y: 22, tag: \"t\" }")).unwrap()
    let field = build_app(tree)
    let out_field = sh("{tree}/out/app")
    let main_c_field = fs.read("{tree}/out/app.units/__main__.c").unwrap()
    let lib_c_field = fs.read("{tree}/out/app.units/lib.c").unwrap()
    let field_text = fs.read(main_c).unwrap()
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(main_text.contains("helper_added"), "the edit did not apply: {main_text}")
    let whole = whole_headers(cold)
    assert_eq(whole.join("\n"), "")
    assert(!lib_c.contains("#include \"__main__.priv.h\""), "lib.c includes the whole header:\n{lib_c}")
    assert_eq(units_compiled(added).join(","), "__main__")
    assert_eq(out_cold, "values 22 7 1 c")
    assert_eq(out_added, "values 22 7 1 c")

    assert(types_held == types_before, "a global of a declared struct changed the types header")
    assert(priv_held.contains("static BLINK_UNUSED GC_descr blink_gc_layout_Cell(void) \{"), "no Cell layout block in __main__.priv.h:\n{priv_held}")
    assert(main_c_held.contains("blink_gc_layout_Cell()"), "__main__.c does not name the Cell layout fn:\n{main_c_held}")
    assert_eq(lib_c_held, lib_c)
    assert_eq(units_compiled(held).join(","), "__main__")
    assert_eq(whole_headers(held).join("\n"), "")

    assert(field_text.contains("tag: Str"), "the field edit did not apply: {field_text}")
    assert(main_c_field.contains("offsetof(blink_Point, b_tag)"), "__main__.c lacks the new layout span:\n{main_c_field}")
    assert_eq(lib_c_field, lib_c)
    assert_eq(units_compiled(field).join(","), "__main__,lib")
    assert_eq(out_field, "values 22 7 1 c")
}
