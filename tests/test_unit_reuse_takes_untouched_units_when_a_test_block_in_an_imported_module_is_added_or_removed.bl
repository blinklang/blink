// A test block of a module other than the entry is not part of the program a build makes, so a
// per-module build that adds or removes one emits only the unit of the module that holds it,
// and takes every other unit from the last build. The test body calls a generic and holds a
// lambda, which a build that lowered it would print, and another is the only caller of a private
// fn of its module, which no unit may lower on its account. A test added above a module's code
// moves the source line in that unit's panic text, so the build must still emit the unit of the
// module that holds the test. Each build runs with
// BLINK_EMIT_REUSE_VERIFY=1, so every unit it writes or takes is byte-equal to a cold emit, and
// after each edit the units and the output equal those of a build with no last build.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"test_block_reuse_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/base.bl", [
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s}]""#,
        #"}"#,
        #""#,
        #"pub fn pair_left[T](a: T, b: T) -> T {"#,
        #"    a"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/mid.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn mid_value() -> Str {"#,
        #"    tag("mid")"#,
        #"}"#,
        #""#,
        #"fn mid_twice(n: Int) -> Int {"#,
        #"    n * 2"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/leaf.bl", [
        #"import base.{pair_left, tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag(pair_left(["leaf"].get(0).unwrap(), "x"))"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #"import mid.{mid_value}"#,
        #"import leaf.{leaf_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{tag("main")} {mid_value()} {leaf_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both, and the module filters.
fn blink_in(tree: Str, args: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_EMIT_REUSE_VERIFY=1 BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=blink.build.units build/blink {args}"]).unwrap()
}

fn build_into(tree: Str, out: Str) -> ProcessResult ! Process.Spawn {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/{out}/app --per-module")
    assert(r.success(), "per-module build into {out} failed: {r.out}{r.err_out}")
    r
}

// The modules whose units the build took from the last build, from its blink.build.units trace.
fn reused_units(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        if line.starts_with("[trace:blink.build.units] reuse unit ") {
            // Sorted, so the build's unit order does not reach the assertion.
            let name = line.byte_slice("[trace:blink.build.units] reuse unit ".byte_len(), line.byte_len())
            out.push(name)
            let mut at = out.len() - 1
            while at > 0 && out.get(at - 1).unwrap() > name {
                out.set(at, out.get(at - 1).unwrap())
                at = at - 1
            }
            out.set(at, name)
        }
    }
    out
}

// One edit's result: the units the build took, the C files and headers that differ from a
// build with none to take, and whether the two binaries print the same.
fn warm_and_cold(tree: Str, what: Str) -> Str ! Process.Spawn {
    let warm = build_into(tree, "out")
    process.run("sh", ["-c", "rm -rf {tree}/cold"]).unwrap()
    let _cold = build_into(tree, "cold")
    let differ = sh("cd {tree} && for f in cold/app.units/*.c cold/app.units/*.h; do b=$(basename $f); cmp -s $f out/app.units/$b || echo $b; done; for f in out/app.units/*.c out/app.units/*.h; do [ -e cold/app.units/$(basename $f) ] || echo extra:$(basename $f); done")
    let warm_out = sh("{tree}/out/app")
    let same_out = warm_out == sh("{tree}/cold/app")
    "{what}: took {reused_units(warm).join(",")}; differ [{differ.split("\n").join(" ")}]; prints {warm_out}, same as cold {same_out}"
}

fn append(tree: Str, file: Str, text: Str) ! FS.Write, FS.Read {
    let path = "{tree}/app/src/{file}"
    fs.write(path, "{fs.read(path).unwrap()}{text}").unwrap()
}

test "a test block added to or removed from an imported module emits only that module's unit" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_test_block_unit_reuse_{getpid()}"
    dev_tree(root, tree)
    let _first = build_into(tree, "out")
    let leaf_before = fs.read("{tree}/app/src/leaf.bl").unwrap()
    let base_before = fs.read("{tree}/app/src/base.bl").unwrap()
    let probe = "\ntest \"pair\" \{\n    let inc = fn(x: Int) -> Int \{ x + 1 }\n    assert_eq(pair_left(inc(1), 3), 2)\n    assert_eq(pair_left(\"a\", \"b\"), \"a\")\n}\n"
    let mut seen: List[Str] = []
    append(tree, "leaf.bl", probe)
    seen.push(warm_and_cold(tree, "test added to leaf"))
    fs.write("{tree}/app/src/leaf.bl", leaf_before).unwrap()
    seen.push(warm_and_cold(tree, "test removed from leaf"))
    // Above leaf_value, the test moves the line its unwrap panic names, so leaf's C changes.
    fs.write("{tree}/app/src/leaf.bl", leaf_before.replace("import base.\{pair_left, tag}\n", "import base.\{pair_left, tag}\n{probe}")).unwrap()
    seen.push(warm_and_cold(tree, "test added above the code of leaf"))
    fs.write("{tree}/app/src/leaf.bl", leaf_before).unwrap()
    seen.push(warm_and_cold(tree, "test removed from above the code of leaf"))
    // The test is the only user of mid_twice, so no build of the program lowers it.
    let mid_before = fs.read("{tree}/app/src/mid.bl").unwrap()
    append(tree, "mid.bl", "\ntest \"twice\" \{\n    assert_eq(mid_twice(2), 4)\n}\n")
    seen.push(warm_and_cold(tree, "test that alone calls a private fn added to mid"))
    fs.write("{tree}/app/src/mid.bl", mid_before).unwrap()
    seen.push(warm_and_cold(tree, "test that alone calls a private fn removed from mid"))
    // base is imported by every module.
    append(tree, "base.bl", probe)
    seen.push(warm_and_cold(tree, "test added to base"))
    fs.write("{tree}/app/src/base.bl", base_before).unwrap()
    seen.push(warm_and_cold(tree, "test removed from base"))
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert_eq(seen.join("\n"), [
        "test added to leaf: took __main__,base,mid; differ []; prints [main] [mid] [leaf], same as cold true",
        "test removed from leaf: took __main__,base,mid; differ []; prints [main] [mid] [leaf], same as cold true",
        "test added above the code of leaf: took __main__,base,mid; differ []; prints [main] [mid] [leaf], same as cold true",
        "test removed from above the code of leaf: took __main__,base,mid; differ []; prints [main] [mid] [leaf], same as cold true",
        "test that alone calls a private fn added to mid: took __main__,base,leaf; differ []; prints [main] [mid] [leaf], same as cold true",
        "test that alone calls a private fn removed from mid: took __main__,base,leaf; differ []; prints [main] [mid] [leaf], same as cold true",
        "test added to base: took __main__,leaf,mid; differ []; prints [main] [mid] [leaf], same as cold true",
        "test removed from base: took __main__,leaf,mid; differ []; prints [main] [mid] [leaf], same as cold true",
    ].join("\n"))
}
