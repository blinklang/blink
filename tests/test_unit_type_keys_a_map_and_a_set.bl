// `()` is the 0-tuple, and a tuple is hashable exactly when every element is, so `()` keys a
// Map and a Set like any other hashable type. It has one value: every insert of `()` lands
// on the same entry, and a member of type `()` never tells two keys apart.
@derive(Eq, Hash)
type Tagged { tag: Int, u: () }

@derive(Eq, Hash)
type Shape { Marked { u: () } Plain }

fn distinct[K](xs: List[K]) -> Int {
    let mut s: Set[K] = Set()
    for x in xs { s.insert(x) }
    s.len()
}

test "a unit key holds one entry" {
    let mut m: Map[(), Int] = Map()
    m.insert((), 1)
    m.insert((), 2)
    assert_eq(m.len(), 1)
    assert_eq(m.get(()) ?? 0, 2)
    assert(m.contains_key(()))
}

test "a unit set holds one element" {
    let mut s: Set[()] = Set()
    assert(s.insert(()))
    assert(!s.insert(()))
    assert_eq(s.len(), 1)
    assert(s.contains(()))
}

test "a unit element leaves a tuple key to its other elements" {
    let mut m: Map[(Int, ()), Str] = Map()
    m.insert((1, ()), "one")
    m.insert((2, ()), "two")
    m.insert((1, ()), "uno")
    assert_eq(m.len(), 2)
    assert_eq(m.get((1, ())) ?? "", "uno")
}

test "a generic set at the unit type holds one element" {
    assert_eq(distinct([(), (), ()]), 1)
}

test "a derived struct with a unit field keys on its other fields" {
    let mut m: Map[Tagged, Int] = Map()
    m.insert(Tagged { tag: 1, u: () }, 10)
    m.insert(Tagged { tag: 2, u: () }, 20)
    m.insert(Tagged { tag: 1, u: () }, 11)
    assert_eq(m.len(), 2)
    assert_eq(m.get(Tagged { tag: 1, u: () }) ?? 0, 11)
    assert(Tagged { tag: 3, u: () } == Tagged { tag: 3, u: () })
}

test "a derived enum with a unit payload keys on its variant" {
    let mut s: Set[Shape] = Set()
    s.insert(Shape.Marked { u: () })
    s.insert(Shape.Marked { u: () })
    s.insert(Shape.Plain)
    assert_eq(s.len(), 2)
    assert(s.contains(Shape.Marked { u: () }))
}
