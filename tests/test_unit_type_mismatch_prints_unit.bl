// A diagnostic says a type back the way the user writes it. The unit type is written `()`,
// so a mismatch that involves it prints `()`, alone or inside another type, while the FFI
// pointee marker inside `Ptr[_]` stays `Void`.

import compile_test_helpers

fn mismatches() -> Str {
    let src = #"
import blink.ffi { Ptr }

fn nothing() -> () {
    ()
}

@trusted(audit: "unit-mismatch-row")
fn pointee(p: Ptr[Void]) -> Int {
    p
}

fn main() {
    let _x: Int = nothing()
    let _y: Str = ()
    let _z: List[Int] = [()]
}
"#
    compile_test_helpers.compile_and_capture(src, "unit_type_mismatch_prints_unit")
}

test "a unit value against a declared type prints ()" {
    let out = mismatches()
    compile_test_helpers.expect_contains(out, "declared type Int but got ()", "call returning ()")
    compile_test_helpers.expect_contains(out, "declared type Str but got ()", "unit literal")
}

test "a unit element inside a container prints ()" {
    let out = mismatches()
    compile_test_helpers.expect_contains(out, "but got List[()]", "List[()]")
}

test "the FFI pointee marker inside Ptr stays Void" {
    let out = mismatches()
    compile_test_helpers.expect_contains(out, "Ptr[Void]", "Ptr[Void]")
}

test "no mismatch names Void outside Ptr" {
    let out = mismatches()
    let bare = out.replace("Ptr[Void]", "")
    if bare.contains("Void") { io.eprintln(out) }
    assert(!bare.contains("Void"))
}
