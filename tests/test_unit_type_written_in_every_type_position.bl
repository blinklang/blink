// `()` is the unit type in every type position: a field, a type argument, a tuple element, a
// variant payload, an alias, a param, a return, a fn type and a call's type argument. The
// formatter's idempotency and semantic passes run over this file, so it also proves that
// `blink fmt` keeps `()` and that the formatted program means the same thing.

type Holder {
    unit: ()
    units: List[()]
    pair: ((), Int)
}

type Event {
    Tick(()),
    Stop
}

type Done = Result[(), Str]

fn take(x: (), f: fn(()) -> ()) -> () {
    f(x)
}

fn run(cb: fn() -> ()) -> Done {
    cb()
    Ok(())
}

test "() is accepted in every type position" {
    let a: () = ()
    let h = Holder { unit: a, units: [(), ()], pair: ((), 3) }
    assert_eq(h.units.len(), 2)
    assert_eq(h.pair.1, 3)
    let e: Event = Event.Tick(())
    let tick = match e {
        Event.Tick(_) => true
        Event.Stop => false
    }
    assert(tick)
    let mut hits = 0
    take(
        (),
        fn(_u: ()) -> () {
            hits = hits + 1
        }
    )
    assert_eq(hits, 1)
    let o: Option[()] = Some(())
    assert(o.is_some())
    let c = channel.new[()](buffer: 1)
    c.send(())
    let f: fn() -> () = fn() -> () { }
    let r: Result[(), Str] = run(f)
    assert(r.is_ok())
}
