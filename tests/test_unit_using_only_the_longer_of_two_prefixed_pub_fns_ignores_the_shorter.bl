// A per-module unit holds the declaration of each symbol its C names, matched on whole C
// identifiers. A unit that calls only the longer of two pub fns whose C names share a prefix
// holds no declaration of the shorter one, so a changed signature of the shorter fn leaves that
// unit's C and object as they were.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"prefix_pair_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/lib.bl", [
        #"pub fn tally(n: Int) -> Int {"#,
        #"    n + 1"#,
        #"}"#,
        #""#,
        #"pub fn tally_all(n: Int) -> Int {"#,
        #"    n * 10"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/user.bl", [
        #"import lib.{tally_all}"#,
        #""#,
        #"pub fn user_value() -> Int {"#,
        #"    tally_all(3)"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    fs.write("{tree}/app/src/main.bl", [
        #"import lib.{tally}"#,
        #"import user.{user_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("values {tally(1)} {user_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=blink.build.units build/blink {args}"]).unwrap()
}

// The units a build compiled, read from its blink.build.units trace, sorted.
fn units_compiled(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        let mark = "[trace:blink.build.units] compile "
        if line.starts_with(mark) {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len()).trim())
        }
    }
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap() > cur {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

fn build_units(tree: Str) -> List[Str] ! Process.Spawn {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.success(), "per-module build failed: {r.out}{r.err_out}")
    units_compiled(r)
}

test "a changed signature of the shorter of two prefixed pub fns does not recompile a unit that calls only the longer" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_prefix_pair_{getpid()}"
    dev_tree(root, tree)
    let cold = build_units(tree)
    let out_cold = sh("{tree}/out/app")
    let user_c = fs.read("{tree}/out/app.units/user.c").unwrap()
    let lib = "{tree}/app/src/lib.bl"
    fs.write(lib, fs.read(lib).unwrap().replace("tally(n: Int) -> Int \{\n    n + 1", "tally(n: Int, -- k: Int = 5) -> Int \{\n    n + k")).unwrap()
    let lib_text = fs.read(lib).unwrap()
    let changed = build_units(tree)
    let out_changed = sh("{tree}/out/app")
    process.run("sh", ["-c", "rm -rf {tree}"])?
    assert(lib_text.contains("n + k"), "the edit did not apply: {lib_text}")
    assert(cold.contains("user"), "the cold build did not compile the user unit: {cold.join(",")}")
    assert(user_c.contains("blink_lib_tally_1all("), "user.c does not declare the longer fn:\n{user_c}")
    assert(!user_c.contains("blink_lib_tally("), "user.c declares the shorter fn it never calls:\n{user_c}")
    assert_eq(changed.join(","), "__main__,lib")
    assert_eq(out_cold, "values 2 30")
    assert_eq(out_changed, "values 6 30")
}
