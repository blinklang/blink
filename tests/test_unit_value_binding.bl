// Binding the one value of the unit type to a name.
//
// `()` is an ordinary inhabited, encodable type: it has exactly one value and a
// representation, so a name can hold it. Four spellings produce it, and each has to bind
// the same way — the producer runs for its effect, and the name holds the single value.
//
// Each test below observes the effect through a List, which is a reference, so a call that
// ran is visible to the caller. That is what separates "the binding compiled" from "the
// producer ran": a fix that quietly dropped the call would still typecheck.

fn push_untyped(xs: List[Int]) {
    xs.push(1)
}

fn push_marked(xs: List[Int]) -> Void {
    xs.push(2)
}

test "a call with no declared return type binds its unit value and still runs" {
    let mut xs: List[Int] = []
    let _a = push_untyped(xs)
    assert_eq(xs.len(), 1)
    assert_eq(xs.get(0).unwrap(), 1)
}

test "a call declared to return Void binds its unit value and still runs" {
    let mut xs: List[Int] = []
    let _b = push_marked(xs)
    assert_eq(xs.len(), 1)
    assert_eq(xs.get(0).unwrap(), 2)
}

test "two unit calls bound in sequence both run" {
    let mut xs: List[Int] = []
    let _a = push_untyped(xs)
    let _b = push_marked(xs)
    assert_eq(xs.len(), 2)
    assert_eq(xs.get(0).unwrap(), 1)
    assert_eq(xs.get(1).unwrap(), 2)
}

// A block whose tail is a `let` produces no value expression, so the block is unit-typed
// and the same binding applies. Every statement of the body still runs.
test "a block whose tail binds a name binds the unit value and runs the body" {
    let mut xs: List[Int] = []
    let _picked = {
        xs.push(3)
        let _p = 5
    }
    assert_eq(xs.len(), 1)
    assert_eq(xs.get(0).unwrap(), 3)
}

// The unit expression written directly. This one already bound correctly, and the test is
// here so that the seam the other spellings now share cannot regress it.
test "the unit expression binds directly" {
    let _u = ()
    assert(true)
}
