// A Unix socket address holds a path of at most 107 bytes (sun_path). A longer path is refused
// with -1. Copied short, it would bind at another path than the one the caller named, and a
// client that connects by the full path would never find it.

// A short root outside TMPDIR: the 107-byte cut must fall inside the long directory name.
let DIR = "/tmp/bsk_{getpid()}"

fn long_dir() -> Str {
    let mut sb = StringBuilder.new()
    sb.write(DIR)
    sb.write("/")
    let mut i = 0
    while i < 120 {
        sb.write("a")
        i = i + 1
    }
    sb.to_str()
}

test "listen on a path longer than sun_path returns -1 and binds nothing" {
    let dir = long_dir()
    let _ = process_run("sh", ["-c", "rm -rf {DIR}; mkdir -p {dir}"])
    let fd = unix_socket_listen("{dir}/s.sock")
    // The first 107 bytes of the path end inside the long directory name, in DIR.
    let left = process_run("sh", ["-c", "find {DIR} -type s | wc -l"]).out.trim()
    if fd >= 0 { unix_socket_close(fd) }
    assert_eq(fd, -1)
    assert_eq(left, "0")
}

test "connect to a path longer than sun_path returns -1" {
    let dir = long_dir()
    let _ = process_run("sh", ["-c", "rm -rf {DIR}; mkdir -p {dir}"])
    let fd = unix_socket_connect("{dir}/s.sock")
    if fd >= 0 { unix_socket_close(fd) }
    assert_eq(fd, -1)
}

test "a path that fits is bound at that path" {
    let _ = process_run("sh", ["-c", "rm -rf {DIR}; mkdir -p {DIR}"])
    let fd = unix_socket_listen("{DIR}/s.sock")
    let there = file_exists("{DIR}/s.sock")
    if fd >= 0 { unix_socket_close(fd) }
    assert(fd >= 0)
    assert(there)
}
