// A blink.toml lint set to an unknown level gives its InvalidLintLevel error once per check,
// which then fails. With no blink.lock, the check first resolves dependencies, and that loads the
// manifest a second time; the second load must not give the error again. The fixture lives under a fresh temporary
// directory, since the test tree itself sits inside a project.

import std.process.{ProcessResult}

let WARNING = "invalid lint level `loud` for `W0703`"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn setup(dir: Str) {
    let _ = sh("rm -rf {dir}; mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lints]\nW0703 = \"loud\"\n")
    write_file("{dir}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
}

fn check(dir: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {dir} && $B check src/main.bl")
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "an unknown lint level warning shows once when the check resolves dependencies" {
    let dir = sh("mktemp -d /tmp/blink_lint_level_once_nolock.XXXXXX").out.trim()
    setup(dir)
    let r = check(dir)
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("resolving dependencies"))
    assert_eq(count("{r.out}{r.err_out}", WARNING), 1)
}

test "an unknown lint level warning shows once when a lock is present" {
    let dir = sh("mktemp -d /tmp/blink_lint_level_once_lock.XXXXXX").out.trim()
    setup(dir)
    // A lock no older than blink.toml keeps dependency resolution out of the check.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    let r = check(dir)
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 1)
    assert(!r.err_out.contains("resolving dependencies"))
    assert_eq(count("{r.out}{r.err_out}", WARNING), 1)
}
