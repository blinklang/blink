// A blink.toml section the manifest does not know gives its warning once per check, also when
// the check first resolves dependencies and so loads the manifest twice in one process. Each
// load must find the section again: a load that remembered it from the one before would leave
// the check with no warning at all. The fixture lives under a fresh temporary directory, since
// the test tree itself sits inside a project.

import std.process.{ProcessResult}

let WARNING = "unknown section `[bogus]` in blink.toml"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "an unknown manifest section warning shows once when the check resolves dependencies" {
    let dir = sh("mktemp -d /tmp/blink_unknown_section_once.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[bogus]\nx = 1\n")
    write_file("{dir}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B check src/main.bl")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 0)
    assert(r.err_out.contains("resolving dependencies"))
    assert_eq(count("{r.out}{r.err_out}", WARNING), 1)
    assert(!r.out.contains(WARNING))
}
