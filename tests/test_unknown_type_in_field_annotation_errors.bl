// An unresolved type name in an annotation would lower through resolve_type_parts'
// fallback to make_typevar(name), a fabricated answer. The name-resolution walker reports
// E0507 for it instead, in struct fields and enum-variant payloads as well as in fn
// params, returns and lets. The check lives in the walker, not in that fallback, which is
// shared with Self, primitive sentinels and effect phantom args.
//
// The two type-parameter cases are the controls on that check: a
// generic type parameter — single- or multi-letter — must NEVER be reported as unknown.

import compile_test_helpers

// ── An unknown type in a struct field annotation is E0507 ───────────────────────────

test "unknown type in a struct field annotation is E0507" {
    let src = "type H \{ x: Frobnicate }\nfn main() \{ let _ = H \{ x: 5 } }\n"
    compile_test_helpers.expect_compile_error(src, "e_struct_field_unknown_type", "E0507")
}

// ── An unknown type in an enum variant payload is E0507 ─────────────────────────────

test "unknown type in an enum variant payload is E0507" {
    let src = "type E \{ V(inner: Frobnicate) }\nfn main() \{ }\n"
    compile_test_helpers.expect_compile_error(src, "e_enum_field_unknown_type", "E0507")
}

// ── CONTROL: a single-letter generic type parameter is not an unknown type ───────────

test "a single-letter generic struct type parameter does not error E0507" {
    let src = "type Box[T] \{ val: T }\nfn main() \{ let _ = Box \{ val: 5 } }\n"
    compile_test_helpers.expect_no_error(src, "e_generic_struct_T_ok", "E0507")
}

// ── CONTROL: a multi-letter generic type parameter is not an unknown type either ─────

test "a multi-letter generic struct type parameter does not error E0507" {
    let src = "type Bag[Elem] \{ val: Elem }\nfn main() \{ let _ = Bag \{ val: 5 } }\n"
    compile_test_helpers.expect_no_error(src, "e_generic_struct_Elem_ok", "E0507")
}
