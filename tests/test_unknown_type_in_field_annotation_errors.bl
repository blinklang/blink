// Phase 1.2 (tid-sole-authority): an unresolved type name in an annotation lowers
// through resolve_type_parts' fallback to make_typevar(name) — a fabricated answer.
// Name-resolution reports E0507 for the annotation positions it walks (fn params,
// returns, lets) but it does NOT walk struct fields, enum-variant payloads, or alias
// underlyings, so an unknown type in those positions is silently accepted.
//
// The two field/payload cases below document that KNOWN GAP: they assert the current
// (wrong) silent-accept. The fix belongs in the name-resolution walker, not in
// resolve_type_parts' fallback (which is shared with Self / primitive sentinels /
// effect phantom-args and would false-positive on them). When it lands, flip these two
// from expect_no_error to expect_compile_error "E0507". Tracked in br note on this file.
//
// The two type-parameter cases are the controls that constrain that future fix: a
// generic type parameter — single- or multi-letter — must NEVER be reported as unknown.

import compile_test_helpers

// ── KNOWN GAP: unknown type in a struct field annotation is silently accepted ────────

test "unknown type in a struct field annotation is currently accepted (known gap)" {
    let src = "type H \{ x: Frobnicate }\nfn main() \{ let _ = H \{ x: 5 } }\n"
    compile_test_helpers.expect_no_error(src, "e_struct_field_unknown_type", "E0507")
}

// ── KNOWN GAP: unknown type in an enum variant payload is silently accepted ──────────

test "unknown type in an enum variant payload is currently accepted (known gap)" {
    let src = "type E \{ V(inner: Frobnicate) }\nfn main() \{ }\n"
    compile_test_helpers.expect_no_error(src, "e_enum_field_unknown_type", "E0507")
}

// ── CONTROL: a single-letter generic type parameter is not an unknown type ───────────

test "a single-letter generic struct type parameter does not error E0507" {
    let src = "type Box[T] \{ val: T }\nfn main() \{ let _ = Box \{ val: 5 } }\n"
    compile_test_helpers.expect_no_error(src, "e_generic_struct_T_ok", "E0507")
}

// ── CONTROL: a multi-letter generic type parameter is not an unknown type either ─────

test "a multi-letter generic struct type parameter does not error E0507" {
    let src = "type Bag[Elem] \{ val: Elem }\nfn main() \{ let _ = Bag \{ val: 5 } }\n"
    compile_test_helpers.expect_no_error(src, "e_generic_struct_Elem_ok", "E0507")
}
