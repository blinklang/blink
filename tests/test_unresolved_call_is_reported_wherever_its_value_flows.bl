// A method call nothing resolves is a name error (sections/05_memory_compile_errors.md
// §6.3.3), and §6.3.5 puts that report before codegen. Where the call's value flows must
// not decide whether the user sees E0505 or a compiler crash on the value's missing type.

import compile_test_helpers

fn error_count(output: Str) -> Int {
    output.split("\"severity\":\"error\"").len() - 1
}

fn expect_one_unresolved(src: Str, tag: Str, needle: Str) {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    assert(out.contains("E0505"))
    assert(out.contains(needle))
    assert(!out.contains("internal compiler error"))
    assert(error_count(out) == 1)
}

test "an unresolved call read inside an interpolation is reported once" {
    let src = "import std.io\nfn main() \{\n    let xs: List[Int] = [1]\n    io.println(\"\{xs.concat([2]).len()}\")\n}\n"
    expect_one_unresolved(src, "unres_interp", "'.concat' on type List[Int]")
}

test "an unresolved call inside a list literal is reported" {
    let src = "fn main() \{\n    let xs: List[Int] = [1]\n    let _l = [xs.concat([2])]\n}\n"
    expect_one_unresolved(src, "unres_list_lit", "'.concat' on type List[Int]")
}

test "an unresolved call whose binding is read later is reported" {
    let src = "import std.io\nfn main() \{\n    let n: Int = 3\n    let m = n.bogus()\n    io.println(\"\{m}\")\n}\n"
    expect_one_unresolved(src, "unres_bound_read", "'.bogus' on type Int")
}

test "a missing module member whose binding is read later is reported" {
    let src = "import std.libc.\{read_bytes}\nfn main() \{\n    let r = libc.read_byte(0, 8)\n    let _s = r\n}\n"
    expect_one_unresolved(src, "unres_module_bound", "no member 'read_byte' on module 'libc'")
}

test "an unresolved call passed as an argument is reported" {
    let src = "fn size(ys: List[Int]) -> Int \{ ys.len() }\nfn main() \{\n    let xs: List[Int] = [1]\n    let _n = size(xs.concat([2]))\n}\n"
    expect_one_unresolved(src, "unres_arg", "'.concat' on type List[Int]")
}

// The receiver of `.len()` is the unresolved call's own value, which has no type to name.
// One mistake, one error.
test "a call chained onto an unresolved call adds no second error" {
    let src = "fn main() \{\n    let xs: List[Int] = [1]\n    let _n = xs.concat([2]).len()\n}\n"
    expect_one_unresolved(src, "unres_chained", "'.concat' on type List[Int]")
}

// A type parameter's methods are decided per instance, so an uninstantiated generic body
// has nothing to report against.
test "a method on a type parameter in an uninstantiated generic is not reported" {
    let src = "fn width[T](x: T) -> Int \{ x.len() }\nfn main() \{ }\n"
    let out = compile_test_helpers.compile_and_capture(src, "unres_typevar")
    assert(!out.contains("E0505"))
    assert(error_count(out) == 0)
}
