import compile_test_helpers

// mrwgz4: an unresolved method on a KNOWN struct/enum type is now caught at
// typecheck (E0505 UnresolvedMethod), not just by the codegen backstop. The
// non-display case must error generically — with NO `impl Display` help, which
// would be nonsensical for a method that has nothing to do with Display.

test "unresolved method on a known struct type is E0505 at typecheck" {
    let src = "type T \{ x: Int }\nfn main() \{\n    let t = T \{ x: 1 }\n    t.no_such()\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "_unresolved_method")
    assert(out.contains("E0505"))
    // Typecheck knows the real receiver type, so the message names `T` — not the
    // degraded `type Void` the codegen backstop produced once the CT was lowered.
    assert(out.contains("on type T"))
    // Generality pin: the Display help must NOT ride along on unrelated methods.
    assert(!out.contains("impl Display for T"))
}
