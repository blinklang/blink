// A closure literal that omits '-> T' is emitted with C return type `void`, so its tail
// expression's value is silently discarded. Typecheck still infers the closure's real
// return type from the body tail (so `v == 20` below typechecks against Int with no
// diagnostic), but codegen emits the closure itself as a void-returning function and the
// call site casts the function pointer to `int64_t (*)(...)`, reading whatever is left in
// the return register instead of the computed value. No diagnostic fires at any stage.

import compile_test_helpers.{compile_and_run}

test "calling an untyped closure through its tail expression yields the computed value, not garbage" {
    let src = #"
import std.io

fn main() ! IO {
    let f = fn(x: Int) { x * 10 }
    let v = f(2)
    if v == 20 { io.println("ok") } else { io.println("bad") }
}
"#
    let r = compile_and_run(src, "_untyped_closure_tail_value_discarded")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok\n")
}
