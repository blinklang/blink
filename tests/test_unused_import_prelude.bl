// yze3de: a selective import whose every name resolves to a prelude module
// (e.g. `import std.traits.{StrOps}`) is redundant, not dead — the name is
// already prelude-visible. Suppress UnusedImport (W0602) for that case only.
// Mixed lines, or genuinely-unused non-prelude imports, still warn.

import compile_test_helpers

test "prelude-only selective import does not warn" {
    let src = "import std.traits.\{StrOps}\nfn main() \{ io.println(\"ok\") }\n"
    compile_test_helpers.expect_no_error(src, "unused_prelude_strops", "W0602")
}

test "genuinely unused non-prelude import still warns" {
    let src = "import compile_test_helpers\nfn main() \{ io.println(\"ok\") }\n"
    compile_test_helpers.expect_compile_error(src, "unused_nonprelude", "W0602")
}
