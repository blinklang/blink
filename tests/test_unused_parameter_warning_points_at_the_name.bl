// A parameter's place is its name, so a warning or a help that points at a parameter shows
// the name, not the `,` or `)` after it.
import lower_test_helpers.{probe}
import diagnostics.{diag_entries}

fn unused_at(stem: Str, src: Str) -> List[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO, Env.Write, Process.Spawn {
    let program = probe(stem, src)
    assert(program >= 0)
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.name == "UnusedVariable" { out.push("{d.line}:{d.col}: {d.message}") }
    }
    out
}

test "an unused parameter is named at its name" {
    let src = #"fn pick(first: Int, second: Int) -> Int {
    second
}

fn main() {
    let _ = pick(1, 2)
}
"#
    assert_eq(unused_at("up_plain_param", src), ["1:9: variable `first` is never read"])
}

test "an unused mut parameter is named at its name, after the mut" {
    let src = #"fn pick(mut first: Int, second: Int) -> Int {
    second
}

fn main() {
    let _ = pick(1, 2)
}
"#
    assert_eq(unused_at("up_mut_param", src), ["1:13: variable `first` is never read"])
}

test "an unused parameter with a default is named at its name" {
    let src = #"fn pick(second: Int, -- first: Int = 4) -> Int {
    second
}

fn main() {
    let _ = pick(1)
}
"#
    assert_eq(unused_at("up_default_param", src), ["1:25: variable `first` is never read"])
}
