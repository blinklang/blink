// A read of an Option or Result checks the tag and then reads the payload, so it names the
// receiver twice. The receiver's expression must still run once, and the value read must be
// the value the receiver had where it stands in the expression, not a value a later operand
// assigned.

let mut calls = 0

fn counted_some(v: Int) -> Option[Int] {
    calls += 1
    Some(v)
}

fn counted_ok(v: Int) -> Result[Int, Str] {
    calls += 1
    Ok(v)
}

test "a list element read through unwrap gives each element" {
    let flags = [true, false, true, true]
    let mut set = 0
    let mut i = 0
    while i < flags.len() {
        if flags.get(i).unwrap() { set += 1 }
        i += 1
    }
    assert_eq(set, 3)
}

test "a local the program named reads its value through unwrap" {
    let o = Some(7)
    let r: Result[Int, Str] = Ok(9)
    assert_eq(o.unwrap() + r.unwrap(), 16)
}

test "a receiver with a side effect runs once under unwrap" {
    calls = 0
    let v = counted_some(4).unwrap()
    assert_eq(v, 4)
    assert_eq(calls, 1)
}

test "a receiver with a side effect runs once under Result unwrap" {
    calls = 0
    let a = counted_some(2).unwrap()
    let b = counted_ok(3).unwrap()
    assert_eq(a + b, 5)
    assert_eq(calls, 2)
}

test "side-effecting receivers in one expression each run once, left to right" {
    calls = 0
    let total = counted_some(10).unwrap() * 100 + counted_some(calls).unwrap()
    assert_eq(total, 1001)
    assert_eq(calls, 2)
}

test "a later operand that assigns the receiver does not change the value read" {
    let mut x = Some(5)
    let r = x.unwrap() + if true {
        x = None
        1
    } else {
        0
    }
    assert_eq(r, 6)
    assert(x.is_none())
}

test "a later operand that replaces the list does not change the element read" {
    let mut xs = [4, 5]
    let r = xs.get(1).unwrap() + if true {
        xs = [40, 50]
        1
    } else {
        0
    }
    assert_eq(r, 6)
    assert_eq(xs.get(1).unwrap(), 50)
}

test "a missing element read through unwrap still panics" {
    let flags = [true]
    assert_panics(matching: "None") {
        let _ = flags.get(3).unwrap()
    }
}
