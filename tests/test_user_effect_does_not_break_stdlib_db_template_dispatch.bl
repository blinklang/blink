import compile_test_helpers.{compile_and_run}

// Declaring a user effect anywhere in the entry module must not break builtin
// method dispatch inside a stdlib module that merely gets imported (std.db's
// sqlite backend uses a Template[C] effect operation internally).

test.failing(
    "a user effect in the entry module does not break std.db template dispatch",
    reason: "a user-declared effect in the entry module makes the stdlib db_sqlite module's Template vtable dispatch fail to resolve its members at codegen, producing a C compile error, even though the program never calls into db",
) {
    let src = #"
import std.db { DB }

pub effect Tpl {
    effect Run {
        fn run(t: Int) -> Int
    }
}

fn main() ! IO {
    io.println("never touches db")
}
"#
    let r = compile_and_run(src, "_user_effect_stdlib_db_dispatch")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "never touches db\n")
}
