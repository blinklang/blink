import compile_test_helpers.{run_via_cli}

// Declaring a user effect anywhere in the entry module must not break builtin
// method dispatch inside a stdlib module that merely gets imported (std.db's
// sqlite backend uses a Template[C] effect operation internally). The program
// runs through the CLI because only the CLI links std.db's native sqlite3 library.

test "a user effect in the entry module does not break std.db template dispatch" {
    let src = #"
import std.db { DB }

pub effect Tpl {
    effect Run {
        fn run(t: Int) -> Int
    }
}

fn main() ! IO {
    io.println("never touches db")
}
"#
    let r = run_via_cli(src, "_user_effect_stdlib_db_dispatch", "")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "never touches db\n")
}
