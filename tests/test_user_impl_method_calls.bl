// `.method()` on a struct or enum receiver resolving through every dispatch shape codegen
// answers below a hand-written impl: the sealed Display synthesis, a derive-synthesized
// method (Debug, Eq), the target-directed From/into() conversion, a nominal free function
// named by convention after its receiver's declared type (Duration, Instant), and a
// closure-typed struct field invoked like a method.

type Point {
    x: Int
    y: Int
}

impl Display for Point {
    fn fmt(self, sb: StringBuilder) {
        sb.write("Point({self.x}, {self.y})")
    }
}

type Shade {
    Red
    Green
}

impl Display for Shade {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Red => { sb.write("red") }
            Green => { sb.write("green") }
        }
    }
}

test "explicit .display() on a struct with a written Display impl" {
    let p = Point { x: 1, y: 2 }
    assert_eq(p.display(), "Point(1, 2)")
}

test "explicit .display() on an enum with a written Display impl" {
    let s = Shade.Green
    assert_eq(s.display(), "green")
}

@derive(Debug)
type Tally { count: Int }

@derive(Debug)
type Outcome { Win, Loss }

test "explicit .debug() on a struct with a derived Debug" {
    let t = Tally { count: 3 }
    assert_eq(t.debug(), "Tally \{ count: 3 }")
}

test "explicit .debug() on an enum with a derived Debug" {
    let o = Outcome.Win
    assert_eq(o.debug(), "Win")
}

@derive(Eq)
type Pair { a: Int, b: Int }

@derive(Eq)
type Side { Left, Right }

test "explicit .eq() on a struct with a derived Eq" {
    let p1 = Pair { a: 1, b: 2 }
    let p2 = Pair { a: 1, b: 2 }
    let p3 = Pair { a: 1, b: 3 }
    assert(p1.eq(p2))
    assert(!p1.eq(p3))
}

test "explicit .eq() on an enum with a derived Eq" {
    let l = Side.Left
    let r = Side.Right
    assert(l.eq(Side.Left))
    assert(!l.eq(r))
}

type Cel { deg: Int }
type Far { deg: Int }

impl From[Cel] for Far {
    fn from(c: Cel) -> Far {
        Far { deg: c.deg * 9 / 5 + 32 }
    }
}

test "explicit .into() reaches the matching From impl" {
    let c = Cel { deg: 100 }
    let f: Far = c.into()
    assert_eq(f.deg, 212)
}

type Hook {
    name: Str
    action: fn(Int) -> Int
}

test "a closure-typed struct field is callable like a method" {
    let h = Hook { name: "double", action: fn(x: Int) -> Int { x * 2 } }
    assert_eq(h.action(21), 42)
}

test "a nominal builtin method named by convention after its receiver's type" {
    let d = Duration.ms(50)
    assert_eq(d.to_ms(), 50)
    assert_eq(d.to_nanos(), 50000000)
}
