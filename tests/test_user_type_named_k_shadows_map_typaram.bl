// A user-defined type named K (or any name that also appears as a stdlib generic
// type parameter, such as map.bl's [K, V]) must not be resolved against the
// global type registry when checking the stdlib's own generic signatures. The
// type parameter K is a bound name local to map.bl's functions and should be
// exempt from the nominal Hash-key check entirely.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a user type named K does not poison lib/std/map.bl's generic K type param",
    reason: "the Map-key Hash validator resolves a generic type parameter's name against the global type registry instead of recognizing it as a bound type parameter, so a same-named user type (K) is mistaken for map.bl's own [K, V] key type and rejected as not implementing Hash, even though the user program never uses Map at all",
    ticket: "gthqjm",
) {
    let src = #"
import std.io
pub type K { n: Int }
pub fn main() ! IO { io.println("ok") }
"#
    let r = compile_and_run(src, "_user_type_named_k_shadows_map_typaram")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok\n")
}
