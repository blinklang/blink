// Some, None, Ok and Err are variants of the builtin Option and Result, not reserved words, so a
// user enum may declare variants with those names. A bare variant pattern resolves against the
// scrutinee type alone (§3.4 patterns), so a user `Some(val: T)` must neither type the binder of
// an Option match elsewhere in the program (std included) nor be found for a user scrutinee
// whose own enum declares the name. Each program also uses the builtin carriers to prove they
// still work beside the user enum.

import compile_test_helpers.{compile_and_run, run_xmod}

test "a user generic enum with a variant named Some leaves std's Option intact" {
    let src = #"
import std.io

type Opt[T] { Nada, Some(val: T) }

fn first(xs: List[Int]) -> Int {
    match xs.get(0) {
        Some(v) => v
        None => -1
    }
}

fn main() {
    let o = Opt.Some(5)
    match o {
        Opt.Some(v) => io.println("{v}")
        Opt.Nada => io.println("none")
    }
    io.println("{first([7])} {first([])} {[3].get(0) ?? 0}")
}
"#
    let r = compile_and_run(src, "_user_variant_some_generic")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n7 -1 3\n")
}

test "a user non-generic enum with a variant named Some leaves std's Option intact" {
    let src = #"
import std.io

type Pick { Some(n: Int), Nada }

fn main() {
    let p = Pick.Some(9)
    match p {
        Pick.Some(n) => io.println("{n}")
        Pick.Nada => io.println("nada")
    }
    match [4].get(0) {
        Some(v) => io.println("std {v}")
        None => io.println("none")
    }
}
"#
    let r = compile_and_run(src, "_user_variant_some_plain")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "9\nstd 4\n")
}

test "a user enum with a variant named None leaves std's Option intact" {
    let src = #"
import std.io

type Opt[T] { None, Has(val: T) }

fn main() {
    let n: Opt[Int] = Opt.None
    match n {
        Opt.Has(v) => io.println("{v}")
        Opt.None => io.println("user none")
    }
    match [1, 2].get(5) {
        Some(v) => io.println("{v}")
        None => io.println("std none")
    }
    io.println("{[8].get(0) ?? -1}")
}
"#
    let r = compile_and_run(src, "_user_variant_none")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "user none\nstd none\n8\n")
}

test "user enums with variants named Ok and Err leave std's Result intact" {
    let src = #"
import std.io

type Outcome[T, E] { Ok(v: T), Err(e: E) }
type Plain { Ok, Err(code: Int) }

fn parse(s: Str) -> Result[Int, Str] {
    if s == "" { return Err("empty") }
    Ok(s.len())
}

fn twice(s: Str) -> Result[Int, Str] {
    let n = parse(s)?
    Ok(n * 2)
}

fn show(r: Result[Int, Str]) -> Str {
    match r {
        Ok(v) => "std ok {v}"
        Err(e) => "std err {e}"
    }
}

fn main() {
    let a: Outcome[Int, Str] = Outcome.Err("bad")
    match a {
        Outcome.Ok(v) => io.println("ok {v}")
        Outcome.Err(e) => io.println("err {e}")
    }
    let p = Plain.Err(4)
    match p {
        Plain.Ok => io.println("plain ok")
        Plain.Err(c) => io.println("plain err {c}")
    }
    io.println(show(twice("abc")))
    io.println(show(twice("")))
}
"#
    let r = compile_and_run(src, "_user_variant_ok_err")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "err bad\nplain err 4\nstd ok 6\nstd err empty\n")
}

test "a bare Some pattern over a user enum scrutinee names the user variant" {
    let src = #"
import std.io

type Opt[T] { Nada, Some(val: T) }

fn show(o: Opt[Int]) -> Str {
    match o {
        Some(v) => "user {v}"
        Nada => "nada"
    }
}

fn main() {
    io.println(show(Opt.Some(3)))
    io.println(show(Opt.Nada))
    match Some(5) {
        Some(v) => io.println("std {v}")
        None => io.println("none")
    }
}
"#
    let r = compile_and_run(src, "_user_variant_some_bare_pattern")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "user 3\nnada\nstd 5\n")
}

test "a bare variant pattern shared by two user enums binds from the scrutinee's enum" {
    let src = #"
import std.io

type A { Hit(n: Int), Miss }
type B[T] { Hit(v: T, k: Int), Miss }
type C { Spot { n: Int }, Gone }
type D[T] { Spot { v: T, k: Int }, Gone }

fn fa(a: A) -> Int {
    match a {
        Hit(n) => n
        Miss => 0
    }
}

fn fb(b: B[Str]) -> Str {
    match b {
        Hit(v, k) => "{v}{k}"
        Miss => "-"
    }
}

fn fd(d: D[Str]) -> Str {
    match d {
        Spot { v, k } => "{v}{k}"
        Gone => "-"
    }
}

fn main() {
    let c = C.Spot { n: 6 }
    match c {
        C.Spot { n } => io.println("{n}")
        C.Gone => io.println("gone")
    }
    io.println("{fa(A.Hit(1))} {fb(B.Hit("x", 2))} {fb(B.Miss)} {fd(D.Spot { v: "y", k: 3 })}")
}
"#
    let r = compile_and_run(src, "_user_variant_shared_two_enums")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "6\n1 x2 - y3\n")
}

test "a user enum with variants named Some and Err in an imported module leaves the builtins intact" {
    let helper = #"
pub type Opt[T] { Nada, Some(val: T) }
pub type Res[T, E] { Ok(v: T), Err(e: E) }

pub fn show(o: Opt[Int]) -> Str {
    match o {
        Some(v) => "user {v}"
        Nada => "nada"
    }
}

pub fn std_first(xs: List[Int]) -> Int {
    match xs.get(0) {
        Some(v) => v
        None => -1
    }
}
"#
    let entry = #"
import std.io
import shapes.kinds.{Opt, Res, show, std_first}

fn main() {
    io.println(show(Opt.Some(4)))
    let r: Res[Int, Str] = Res.Err("e")
    match r {
        Res.Ok(v) => io.println("{v}")
        Res.Err(e) => io.println("user err {e}")
    }
    io.println("{std_first([8])} {std_first([])}")
    match [2].get(0) {
        Some(v) => io.println("std {v}")
        None => io.println("none")
    }
}
"#
    let r = run_xmod(entry, "shapes", "kinds", helper, "user_variant_builtin_xmod")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "user 4\nuser err e\n8 -1\nstd 2\n")
}

test "bare None, Ok and Err patterns over user enum scrutinees name the user variants" {
    let src = #"
import std.io

type Opt[T] { None, Has(val: T) }
type Outcome { Ok, Err(code: Int) }

fn f(o: Opt[Int]) -> Int {
    match o {
        Has(v) => v
        None => -1
    }
}

fn g(o: Outcome) -> Int {
    match o {
        Ok => 0
        Err(c) => c
    }
}

fn main() {
    io.println("{f(Opt.Has(2))} {f(Opt.None)} {g(Outcome.Ok)} {g(Outcome.Err(7))}")
}
"#
    let r = compile_and_run(src, "_user_variant_bare_nullary_patterns")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2 -1 0 7\n")
}
