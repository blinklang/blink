// A generic struct's bare base has no typedef of its own, so spelling a binding as
// `blink_Box` names a C symbol that was never emitted. The enum arm of this same path already
// reads the instance off the tid; the struct arm spells c_type_c_name(struct_type) and gets
// the base.
//
// The if-expression path emits the same shape correctly, so the two result temps in one
// function disagree — which is why the control row below matters as much as the failing one.

import compile_test_helpers
import std.io

fn match_src() -> Str {
    #"import std.io

type Box[T] {
    v: T
}

fn main() {
    let m = match 1 {
        1 => Box { v: 5 }
        _ => Box { v: 6 }
    }
    io.println("v={m.v}")
}
"#
}

test "a match arm yielding a generic struct instance names the mono typedef" {
    let c = compile_test_helpers.compile_and_emit_c(match_src(), "v8kd2r_match")
    if c.contains("blink_Box _") { io.println("FAIL: match temp declared as the bare generic base") }
    assert(!c.contains("blink_Box _"))
}

test "a match arm yielding a generic struct instance compiles and runs" {
    let r = compile_test_helpers.compile_and_run(match_src(), "v8kd2r_match_run")
    if !r.out.contains("v=5") { io.println("FAIL: match struct instance — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("v=5"))
}

// The sibling path that already flips correctly. It pins the answer the match path has to
// agree with, so a fix cannot satisfy one temp by changing what both mean.
fn if_src() -> Str {
    #"import std.io

type Box[T] {
    v: T
}

fn main() {
    let m = if true { Box { v: 5 } } else { Box { v: 6 } }
    io.println("v={m.v}")
}
"#
}

test "the if-expression sibling keeps working" {
    let r = compile_test_helpers.compile_and_run(if_src(), "v8kd2r_if_run")
    if !r.out.contains("v=5") { io.println("FAIL: if struct instance — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("v=5"))
}
