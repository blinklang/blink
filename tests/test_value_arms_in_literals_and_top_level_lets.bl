// An if, a match or a block is a value wherever an expression is (sections/02_syntax.md), so
// it runs as one as a struct or brace-variant field (a struct that leaves another field to its
// default included) and as a top-level `let` initializer (§2.12.1). The declared type is the
// expected type of each arm (sections/03_types.md 3.3), so an empty Map(), Set() or [] in an
// arm takes its element types from a field, a let annotation or a return type.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn expect_runs(src: Str, want: Str) {
    let dir = sh("mktemp -d /tmp/blink_value_arms.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", src)
    let mut ok = true
    let c = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B check src/main.bl < /dev/null 2>&1")
    if !c.success() {
        io.eprintln("blink check: {c.end}\n{c.out}")
        ok = false
    }
    for args in ["run --no-per-module", "run --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if !r.success() || !r.out.trim().ends_with(want) {
            io.eprintln("blink {args}: {r.end}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

fn expect_rejects(src: Str, code: Str) {
    let dir = sh("mktemp -d /tmp/blink_value_arms.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", src)
    let mut ok = true
    for args in ["check", "build --no-per-module", "build --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if r.success() || !r.out.contains("error[{code}]") || r.out.contains("internal compiler error") {
            io.eprintln("blink {args}: {r.end}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

test "a struct literal that leaves a field to its default runs an if, a match and a block field" {
    expect_runs(#"type S {
    a: Int = 3
    b: Int
}
fn main() {
    let c = true
    let s = S { b: if c { 1 } else { 2 } }
    let t = S { b: match c {
        true => 4
        false => 5
    } }
    let u = S { b: { let x = 6
        x + 1 } }
    io.println("{s.a} {s.b} {t.b} {u.a} {u.b}")
}
"#, "3 1 4 3 7")
}

test "a brace variant literal runs an if, a match and a block field" {
    expect_runs(#"type Box[T] { v: List[T] }
type V {
    B { b: Box[Int], n: Int }
    C
}
fn len_of(v: V) -> Int {
    match v {
        V.B { b, n } => b.v.len() * 10 + n
        V.C => 99
    }
}
fn main() {
    let c = true
    let x = V.B { b: if c { Box { v: [1] } } else { Box { v: [2, 3] } }, n: 1 }
    let y = V.B { b: Box { v: [] }, n: match c {
        true => 2
        false => 0
    } }
    let z = V.B { n: { let k = 3
        k }, b: { Box { v: [4, 5] } } }
    io.println("{len_of(x)} {len_of(y)} {len_of(z)}")
}
"#, "11 2 23")
}

test "a top-level let runs an if, a match and a block initializer" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
let FLAG = true
let A: Box[Int] = if FLAG { mk([]) } else { mk([1]) }
let B: Box[Int] = { mk([]) }
let C: Int = match FLAG {
    true => 5
    false => 6
}
let D = { let t = 2
    t * 4 }
fn main() {
    io.println("{A.v.len()} {B.v.len()} {C} {D}")
}
"#, "0 0 5 8")
}

test "a field's type reaches an empty Map, Set and list in each if arm" {
    expect_runs(#"type W {
    m: Map[Str, Int]
    s: Set[Int]
    l: List[Str]
}
fn main() {
    let c = true
    let w = W {
        m: if c { Map() } else { Map() },
        s: if c { Set() } else { Set() },
        l: if c { [] } else { [] },
    }
    io.println("{w.m.len()} {w.s.len()} {w.l.len()}")
}
"#, "0 0 0")
}

test "a field's type reaches an empty Map, Set and list in each match arm and block tail" {
    expect_runs(#"type W {
    m: Map[Str, Int]
    s: Set[Int]
    l: List[Str]
}
fn main() {
    let c = true
    let w = W {
        m: match c {
            true => Map()
            false => { Map() }
        },
        s: { { Set() } },
        l: match c {
            true => []
            false => []
        },
    }
    io.println("{w.m.len()} {w.s.len()} {w.l.len()}")
}
"#, "0 0 0")
}

test "a brace variant and a generic struct field reach an empty container in each arm" {
    expect_runs(#"type G[K] { m: Map[K, Int] }
type V {
    B { m: Map[Str, Int] }
    C
}
fn n_of(v: V) -> Int {
    match v {
        V.B { m } => m.len()
        V.C => 9
    }
}
fn main() {
    let c = true
    let v = V.B { m: if c { Map() } else { Map() } }
    let g: G[Str] = G { m: match c {
        true => Map()
        false => Map()
    } }
    io.println("{n_of(v)} {g.m.len()}")
}
"#, "0 0")
}

test "a struct literal passed as an argument or returned reaches an empty container in each arm" {
    expect_runs(#"type W { s: Set[Str] }
fn size(w: W) -> Int { w.s.len() }
fn make(c: Bool) -> W {
    W { s: if c { Set() } else { Set() } }
}
fn main() {
    let c = true
    io.println("{size(W { s: if c { Set() } else { Set() } })} {make(c).s.len()}")
}
"#, "0 0")
}

test "a let annotation and a return type reach an empty container in each arm" {
    expect_runs(#"fn pick(c: Bool) -> Map[Str, Int] {
    if c { Map() } else { Map() }
}
fn tags(c: Bool) -> Set[Int] {
    match c {
        true => Set()
        false => { Set() }
    }
}
fn main() {
    let c = true
    let m: Map[Str, Int] = if c { Map() } else { Map() }
    let s: Set[Int] = match c {
        true => Set()
        false => Set()
    }
    let l: List[Int] = { [] }
    io.println("{m.len()} {s.len()} {l.len()} {pick(c).len()} {tags(c).len()}")
}
"#, "0 0 0 0 0")
}

test "a closure in a top-level let initializer is defined before the code that sets the global" {
    expect_runs(#"let BASE = 10
let add = fn(n: Int) -> Int { n + BASE }
let maybe = Some(fn(n: Int) -> Int { n * 2 })
let all = [fn(n: Int) -> Int { n - 1 }]
let chosen = if BASE > 5 { fn(n: Int) -> Int { n + 100 } } else { fn(n: Int) -> Int { n } }
fn main() {
    let f = add
    let g = maybe.unwrap()
    let h = all.get(0).unwrap()
    let k = chosen
    io.println("{f(1)} {g(4)} {h(9)} {k(1)}")
}
"#, "11 8 8 101")
}

test "a closure in a top-level let lowers outside every generic instance" {
    expect_runs(#"fn wrap[T](x: T) -> List[T] { [x] }
fn later(n: Int) -> Int { n * 3 }
let add = fn(n: Int) -> Int { wrap(n).len() + later(n) }
fn main() {
    let f = add
    io.println("{f(2)} {wrap(1).len()}")
}
"#, "7 1")
}

test "a with arena value in a top-level let runs in its module's init function" {
    expect_runs(#"let made = with arena { let xs = [1, 2, 3]
    xs.len() }
let shout = if made > 1 { with arena { "x".to_upper() } } else { "n" }
fn main() {
    io.println("{made} {shout}")
}
"#, "3 X")
}

test "a warning inside a top-level let initializer leaves the global typed" {
    expect_runs(#"let f = fn(n: Int) -> Int {
    return n + 1
    n + 2
}
let g = { let k = fn(n: Int) -> Int {
        return n * 2
        n
    }
    k(2) }
fn main() {
    let h = f
    io.println("{h(1)} {g}")
}
"#, "2 4")
}

test "a block in a hole of a top-level string let is typed" {
    expect_runs(#"let T = "y{ ({ let t = 3
    t }) }"
fn main() {
    io.println(T)
}
"#, "y3")
}

test "a return type reaches an empty container in each arm of an early return" {
    expect_runs(#"fn early(c: Bool) -> Map[Str, Int] {
    if !c { return if c { Map() } else { Map() } }
    Map()
}
fn looped(c: Bool) -> Set[Int] {
    for i in [1] { return match c {
        true => Set()
        false => Set()
    } }
    Set()
}
fn main() {
    io.println("{early(false).len()} {looped(true).len()}")
}
"#, "0 0")
}

test "a top-level let checks a block's tail against its annotation" {
    expect_rejects(#"let x: Str = { let h = 5
    h }
fn main() {
    io.println(x)
}
"#, "TypeError")
}

test "a top-level let checks that its if arms agree" {
    expect_rejects(#"let FLAG = false
let x = if FLAG { let h = 5
    h } else { 2.5 }
fn main() {
    io.println("{x}")
}
"#, "TypeError")
}

test "a top-level let checks an operator again once a closure's result is known" {
    expect_rejects(#"let s = [1].map(fn(x) { "a" }).get(0).unwrap() + 1
fn main() {
    io.println("{s}")
}
"#, "StrPlusUnsupported")
}

test "a return in a top-level let initializer stops the build before C" {
    let dir = sh("mktemp -d /tmp/blink_value_arms.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", #"let x = { if true { return 1 }
    2 }
fn main() {
    io.println("{x}")
}
"#)
    let mut ok = true
    for args in ["build --no-per-module", "build --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if r.success() || r.out.contains("C compilation failed") {
            io.eprintln("blink {args}: {r.end}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}
