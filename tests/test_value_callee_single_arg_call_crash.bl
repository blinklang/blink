// Calling through a struct FIELD holding a function value, where the call
// passes EXACTLY ONE argument, crashes the compiler outright during
// typecheck with no diagnostic: `parser: node_name(-1) out of bounds`,
// exit code 2. The trigger is the argument COUNT specifically: a zero-argument
// call through the same value-callee construct, and a two-argument call
// through it, both compile and run correctly. Only the one-argument form
// crashes.

import compile_test_helpers.{compile_and_run}

test.failing(
    "calling a fn-typed struct field with exactly one argument does not crash the compiler",
    reason: "typecheck asks for the name of a parenthesized field callee, which has none, so the compiler aborts with 'node_name(-1) out of bounds' on the one-argument call; zero and two arguments compile",
) {
    let src = #"
import std.io
type H { f: fn(x: Int) -> Int }
fn main() {
    let h = H { f: fn(x: Int) -> Int { x + 1 } }
    io.println("{(h.f)(2)}")
}
"#
    let r = compile_and_run(src, "_value_callee_single_arg_call_crash")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
