// Calling through a struct FIELD holding a function value, where the call
// passes EXACTLY ONE argument, crashes the compiler outright during
// typecheck with no diagnostic: `parser: node_name(-1) out of bounds`,
// exit code 2. Confirmed this is precisely about the argument COUNT, not
// merely "at least one argument" as originally suspected: the zero-argument
// form ((h.f)()) and the two-argument form ((h.on_error)(1, "msg"), the
// exact shape already covered by tests/test_total_stamp_typecheck_holes.bl's
// "a call through a fn-typed field is typed and its arguments checked" row)
// both compile and run correctly. Only the one-argument form crashes.

import compile_test_helpers.{compile_and_run}

test.failing(
    "calling a fn-typed struct field with exactly one argument does not crash the compiler",
    reason: "the argument-checking path for a call through a parenthesized FieldAccess callee asks node_name of the callee, which has no name node, so a -1 reaches node_name and aborts the compiler with 'node_name(-1) out of bounds' during typecheck instead of compiling; only the one-argument call form triggers it, zero and two arguments both compile fine",
    ticket: "ta55kp",
) {
    let src = #"
import std.io
type H { f: fn(x: Int) -> Int }
fn main() {
    let h = H { f: fn(x: Int) -> Int { x + 1 } }
    io.println("{(h.f)(2)}")
}
"#
    let r = compile_and_run(src, "_value_callee_single_arg_call_crash")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
