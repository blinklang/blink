// A while test runs once per turn, a match guard once per arm tried, and the right operand
// of `&&`, `||` or `??` only when the left one decided nothing. An `if`, a `match` or a
// block written inside any of them has to be computed there, each time it runs, and not
// once above the statement.

fn id(x: Int) -> Int {
    x
}

type Shape {
    Circle(r: Int)
    Square(side: Int)
}

test "a match inside a while test is computed every turn" {
    let r = 2
    let mut n = 0
    while id(match r {
        2 => n
        _ => 100
    }) < 3 {
        n = n + 1
    }
    assert_eq(n, 3)
}

test "a block inside a while test is computed every turn" {
    let mut n = 0
    let mut seen = 0
    while id({
        seen = seen + 1
        n * 2
    }) < 6 {
        n = n + 1
    }
    assert_eq(n, 3)
    assert_eq(seen, 4)
}

test "an if inside a while test is computed every turn" {
    let mut n = 0
    while id(if n > 10 { 0 } else { n }) < 4 { n = n + 1 }
    assert_eq(n, 4)
}

test "a block inside a match guard reads the arm binders" {
    let s = Shape.Square(4)
    let got = match s {
        Circle(r) if id({
            let w = r * 2
            w
        }) == 8 => "circle"
        Square(side) if id({
            let w = side * 2
            w
        }) == 8 => "square eight"
        _ => "other"
    }
    assert_eq(got, "square eight")
}

test "a guard computed per arm tried runs only for arms the pattern admits" {
    let mut runs = 0
    let v = 7
    let got = match v {
        1 if id({
            runs = runs + 1
            1
        }) == 1 => "one"
        n if id(match n {
            7 => {
                runs = runs + 10
                0
            }
            _ => 1
        }) == 1 => "not seven"
        _ => "fell through"
    }
    assert_eq(got, "fell through")
    assert_eq(runs, 10)
}

test "a match inside a guard of a match statement" {
    let r = 2
    let mut out = ""
    match r {
        x if id(match x {
            2 => 9
            _ => 0
        }) == 9 => { out = "guard {x}" }
        _ => { out = "no" }
    }
    assert_eq(out, "guard 2")
}

test "a match on the right of && runs only when the left is true" {
    let mut runs = 0
    let mut k = 0
    while k < 3 && id(match k {
        _ => {
            runs = runs + 1
            k
        }
    }) < 5 {
        k = k + 1
    }
    assert_eq(k, 3)
    assert_eq(runs, 3)
}

test "a block on the right of || runs only when the left is false" {
    let mut runs = 0
    let a = true || id({
        runs = runs + 1
        1
    }) == 1
    let b = false || id({
        runs = runs + 10
        1
    }) == 1
    assert(a)
    assert(b)
    assert_eq(runs, 10)
}

test "a match as the default of ?? runs only on None" {
    let mut runs = 0
    let some: Option[Int] = Some(4)
    let none: Option[Int] = None
    let x = some ?? match runs {
        _ => {
            runs = runs + 1
            0
        }
    }
    let y = none ?? match runs {
        _ => {
            runs = runs + 10
            7
        }
    }
    assert_eq(x, 4)
    assert_eq(y, 7)
    assert_eq(runs, 10)
}
