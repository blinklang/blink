// A list literal that holds a spread runs its elements and spreads left to right
// (sections/02_syntax.md 2.16 and the evaluation-order rule for literals). An `if`, a
// `match` or a block written in value position anywhere in it -- as the spread source, or
// as a plain element before, between or after spreads -- is a value like any other, and
// the literal copies each spread source at the place the spread is written.

fn note(mut log: List[Str], tag: Str, v: List[Int]) -> List[Int] {
    log.push(tag)
    v
}

fn noted(mut log: List[Str], tag: Str, v: Int) -> Int {
    log.push(tag)
    v
}

fn grow(mut l: List[Int]) -> Option[Int] {
    l.push(9)
    Some(l.len())
}

fn spread_then_try(mut xs: List[Int]) -> Option[List[Int]] {
    Some([..xs, grow(xs)?])
}

fn total(xs: List[Int]) -> Int {
    let mut s = 0
    for x in xs {
        s = s + x
    }
    s
}

fn spread_if_returned(c: Bool, a: List[Int], b: List[Int]) -> List[Int] {
    return [..if c { a } else { b }, 9]
}

fn spread_match_tail(c: Bool, xs: List[Int]) -> List[Int] {
    [..xs, match c {
        true => 1
        false => 0
    }]
}

test "an if as a spread source" {
    let c = true
    let a = [1]
    let b = [2]
    let d = [3]
    assert_eq([..if c { a } else { b }, ..d], [1, 3])
    assert_eq([..if !c { a } else { b }, ..d], [2, 3])
}

test "an if element after a spread" {
    let c = true
    let xs = [1, 2]
    assert_eq([..xs, if c { 2 } else { 0 }], [1, 2, 2])
    assert_eq([..xs, if !c { 2 } else { 0 }], [1, 2, 0])
}

test "an if spread source followed by an if element" {
    let c = true
    let a = [1]
    let b = [2]
    assert_eq([..if c { a } else { b }, if c { 3 } else { 4 }], [1, 3])
    assert_eq([..if !c { a } else { b }, ..a, if !c { 3 } else { 4 }], [2, 1, 4])
}

test "an if element before a spread" {
    let c = true
    let xs = [1, 2]
    assert_eq([if c { 5 } else { 0 }, ..xs], [5, 1, 2])
}

test "an if element between two spreads" {
    let c = false
    let xs = [1, 2]
    let ys = [3]
    assert_eq([..xs, if c { 5 } else { 6 }, ..ys], [1, 2, 6, 3])
}

test "a match as a spread source and as an element" {
    let n = 2
    let xs = [1, 2]
    let picked = [..match n {
        1 => [10]
        _ => [20, 21]
    }, ..xs]
    assert_eq(picked, [20, 21, 1, 2])
    let tail = [0, ..xs, match n {
        2 => 7
        _ => 8
    }, 4]
    assert_eq(tail, [0, 1, 2, 7, 4])
}

test "a block as a spread source and as an element" {
    let xs = [1, 2]
    let src = [..{
        let t = [8, 9]
        t
    }, ..xs]
    assert_eq(src, [8, 9, 1, 2])
    let elem = [..xs, {
        let t = 3
        t + 1
    }]
    assert_eq(elem, [1, 2, 4])
}

test "a nested list spreads an if" {
    let c = true
    let a = [1]
    let b = [2]
    assert_eq([..[..if c { a } else { b }, 4], 5], [1, 4, 5])
    assert_eq([..[0, ..a], if c { 6 } else { 7 }], [0, 1, 6])
}

test "elements and spreads run left to right" {
    let mut log: List[Str] = []
    let c = true
    let xs = [1, 2]
    let got = [..note(log, "a", xs), if c { noted(log, "b", 3) } else { 0 }, ..note(log, "c", [4])]
    assert_eq(got, [1, 2, 3, 4])
    assert_eq(log, ["a", "b", "c"])
    let mut log2: List[Str] = []
    let got2 = [noted(log2, "a", 0), ..if c { note(log2, "b", xs) } else { [] }, noted(log2, "c", 9)]
    assert_eq(got2, [0, 1, 2, 9])
    assert_eq(log2, ["a", "b", "c"])
}

test "a spread copies its source where it is written, before a later arm writes it" {
    let c = true
    let mut xs = [1, 2]
    let got = [..xs, if c {
        xs.push(9)
        1
    } else {
        0
    }]
    assert_eq(got, [1, 2, 1])
    assert_eq(xs, [1, 2, 9])
    let mut ys = [5]
    let picked = [..if c { ys } else { [] }, if c {
        ys.push(6)
        7
    } else {
        0
    }]
    assert_eq(picked, [5, 7])
    assert_eq(ys, [5, 6])
}

test "a spread copies its source before a later element's guard writes it" {
    assert_eq(spread_then_try([1, 2]), Some([1, 2, 3]))
}

test "a branch that panics stops the literal after the work ahead of it" {
    let c = true
    let xs = [1, 2]
    let fine = [..xs, if c { 3 } else { panic("not taken") }]
    assert_eq(fine, [1, 2, 3])
    assert_panics(matching: "taken") {
        let _never = [..xs, if c { panic("taken") } else { 0 }]
    }
    assert_panics(matching: "source") {
        let _never = [..if c { panic("source") } else { xs }, 4]
    }
}

test "the literal as a call argument and a return value" {
    let c = true
    let xs = [1, 2]
    assert_eq(total([..xs, if c { 10 } else { 0 }]), 13)
    assert_eq(total([..if c { xs } else { [] }, ..xs]), 6)
    assert_eq(spread_if_returned(true, [1], [2]), [1, 9])
    assert_eq(spread_if_returned(false, [1], [2]), [2, 9])
    assert_eq(spread_match_tail(true, [4]), [4, 1])
}
