// An `if` is an expression, so it can stand where a value is written in any statement. The
// order in which it runs against the other parts of that statement is §2.22: `place = rhs`
// runs `rhs`, then reads the place's root, then stores; `place op= rhs` reads the place
// first, then runs `rhs`; a call and a struct literal run their parts as written.

type S {
    a: Int
    t: Str
}

type P {
    n: Int
}

type Outer {
    p: P
    k: Int
}

let mut g_s: S = S { a: 0, t: "" }
let mut g_list: List[Int] = [10, 20, 30]

fn first_of(s: S) -> Int { s.a }

fn text_of(s: S) -> Str { s.t }

fn pick(c: Bool) -> Int {
    if c { 1 } else { 2 }
}

test "an if assigned to a field of a local stores the selected arm" {
    let line = "x"
    let mut s = S { a: 0, t: "" }
    s.t = if line == "" { "" } else { line.concat("!") }
    assert_eq(s.t, "x!")
}

test "an if assigned to a field of a module global stores the selected arm" {
    let line = "x"
    g_s.t = if line == "" { "e" } else { "g" }
    assert_eq(g_s.t, "g")
}

test "an if assigned to a nested field stores the selected arm" {
    let c = 1
    let mut o = Outer { p: P { n: 0 }, k: 3 }
    o.p.n = if c > 0 { 5 } else { 6 }
    assert_eq(o.p.n, 5)
    assert_eq(o.k, 3)
}

test "an if assigned to a field runs its arm before the store reads the root" {
    let c = 1
    let mut s = S { a: 0, t: "" }
    let record = fn() -> Int {
        s.t = "seen"
        5
    }
    s.a = if c > 0 { record() } else { 0 }
    assert_eq(s.a, 5)
    assert_eq(s.t, "seen")
}

test "a compound assign to a local reads the local before its if runs" {
    let c = 1
    let mut n = 1
    let bump = fn() -> Int {
        n = n + 10
        0
    }
    n += if c > 0 { bump() } else { 0 }
    assert_eq(n, 1)
}

test "a compound assign to a field reads the field before its if runs" {
    let c = 1
    let mut o = Outer { p: P { n: 1 }, k: 0 }
    let bump = fn() -> Int {
        o.p.n = o.p.n + 10
        0
    }
    o.p.n += if c > 0 { bump() } else { 0 }
    assert_eq(o.p.n, 1)
}

test "a compound assign to a field adds the selected arm" {
    let c = 1
    let mut o = Outer { p: P { n: 1 }, k: 0 }
    o.p.n += if c > 0 { 5 } else { 6 }
    assert_eq(o.p.n, 6)
}

test "a compound assign to a field of a module global adds the selected arm" {
    let c = 1
    g_s.a = 2
    g_s.a += if c > 0 { 40 } else { 0 }
    assert_eq(g_s.a, 42)
}

test "an if as an element write argument stores the selected arm" {
    let c = 1
    let mut xs = [1, 2, 3]
    xs.set(1, if c > 0 { 9 } else { 8 })
    assert_eq(xs.get(1).unwrap(), 9)
    g_list = [10, 20, 30]
    g_list.set(2, if c > 0 { 7 } else { 8 })
    assert_eq(g_list.get(2).unwrap(), 7)
}

test "an if struct literal field after a global read" {
    let c = 1
    g_list = [10, 20, 30]
    assert_eq(first_of(S { a: g_list.get(1).unwrap(), t: if c > 0 { "a" } else { "b" } }), 20)
    g_s.a = 4
    assert_eq(text_of(S { a: g_s.a, t: if c > 0 { "q" } else { "r" } }), "q")
}

test "a global read in the arm of an if struct literal field" {
    let c = 1
    g_list = [10, 20, 30]
    assert_eq(first_of(S { a: if c > 0 { g_list.get(2).unwrap() } else { -1 }, t: "" }), 30)
}

test "an if struct literal field before a global read" {
    let c = 1
    g_list = [10, 20, 30]
    let s = S { a: if c > 0 { 3 } else { 4 }, t: "{g_list.len()}" }
    assert_eq(s.a, 3)
    assert_eq(s.t, "3")
}

test "an if call argument after a global read" {
    let c = 1
    g_list = [10, 20, 30]
    assert_eq(pick(g_list.len() > 0) + if c > 0 { 100 } else { 200 }, 101)
    assert_eq(g_list.get(0).unwrap() + pick(if c > 0 { true } else { false }), 11)
}
