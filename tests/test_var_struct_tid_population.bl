// A plain (non-generic, non-transparent) struct- or enum-typed variable must
// carry its declared tid in ScopeVar.ty, recovered from the named-type registry
// at set_var_struct time, so sv_struct_tid_first names the struct from the tid
// instead of falling back to the flat sname channel. Covers a struct local bound
// from a literal, from a function return, from a field-access temp, and a nested
// struct field; plus a payloadless enum local. The change is emit-C byte-identical
// corpus-wide, so this is a behavioral guard that the struct/enum name survives
// through the tid path, not a channel-attribution test (a runtime .bl test cannot
// see which channel produced an identical name). Guards the tid-population step of
// the tid-sole-authority migration (sv.ty from lookup_named_type in set_var_struct).

type Point { x: Int, y: Int }
type Line { a: Point, b: Point }

type Color { Red, Green, Blue }

fn make_point() -> Point {
    Point { x: 10, y: 20 }
}

fn struct_local_from_literal() -> Int {
    let p = Point { x: 3, y: 4 }
    p.x + p.y
}

fn struct_local_from_return() -> Int {
    let p = make_point()
    p.x + p.y
}

fn struct_local_from_field() -> Int {
    let l = Line { a: Point { x: 1, y: 2 }, b: Point { x: 5, y: 8 } }
    let start = l.a
    let finish = l.b
    start.x + start.y + finish.x + finish.y
}

fn enum_local() -> Int {
    let c = Color.Green
    match c {
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
    }
}

test "plain struct local from a literal names Point via the tid" {
    assert_eq(struct_local_from_literal(), 7)
}

test "plain struct local from a function return names Point via the tid" {
    assert_eq(struct_local_from_return(), 30)
}

test "plain struct local from a field-access temp names Point via the tid" {
    assert_eq(struct_local_from_field(), 16)
}

test "payloadless enum local names Color via the tid" {
    assert_eq(enum_local(), 2)
}
