// A paren payload may fill fields by position, by label in any order, or by position and then
// label (sections/03_types.md §3.4 *Variant Construction*). Each well-formed form builds and
// stores every field where the declaration puts it.

type Figure {
    Circle(radius: Float, tag: Int)
    Dot
}

type Ring {
    Band(tag: Int, radius: Float)
}

type Pair {
    P(Int, Str)
}

fn show(f: Figure) -> Str {
    match f {
        Circle(r, t) => "Circle radius={r} tag={t}"
        Dot => "Dot"
    }
}

fn band(r: Ring) -> Str {
    match r {
        Band(t, rad) => "Band tag={t} radius={rad}"
    }
}

test "every well-formed paren payload stores each field where the declaration puts it" {
    assert_eq(show(Figure.Circle(1.5, 2)), "Circle radius=1.5 tag=2")
    assert_eq(show(Figure.Circle(1.5, tag: 3)), "Circle radius=1.5 tag=3")
    assert_eq(show(Figure.Circle(tag: 4, radius: 2.5)), "Circle radius=2.5 tag=4")
    assert_eq(show(Figure.Circle(radius: 3.5, tag: 5)), "Circle radius=3.5 tag=5")
    assert_eq(show(Circle(4.5, tag: 6)), "Circle radius=4.5 tag=6")
    assert_eq(band(Ring.Band(1, radius: 2.5)), "Band tag=1 radius=2.5")
    assert_eq(band(Ring.Band(radius: 3.5, tag: 7)), "Band tag=7 radius=3.5")
    match Pair.P(8, "eight") {
        P(n, s) => assert_eq("{n} {s}", "8 eight")
    }
}

fn main() {
    io.println(show(Figure.Circle(1.5, tag: 3)))
    io.println(show(Figure.Circle(tag: 4, radius: 2.5)))
    io.println(band(Ring.Band(1, radius: 2.5)))
}
