// Below --debug an object's key names an absolute vendored include dir by its last part, and
// the compile maps the dir to that name. A dir the map cannot spell, and a relative dir, keep
// their spelling and take no map.

import build_objcache.{header_lines_named, vendored_dir_maps, vendored_dir_name, vendored_dir_spellings}

test "an absolute dir goes by its last part, with or without a trailing slash" {
    assert_eq(vendored_dir_name("/a/b/mylib"), "mylib")
    assert_eq(vendored_dir_name("/a/b/mylib/"), "mylib")
    assert_eq(vendored_dir_name("/a/b/mylib//"), "mylib")
}

test "a relative dir, the root, a dot dir and a dir with an equals sign keep their spelling" {
    assert_eq(vendored_dir_name("vendor/mylib"), "vendor/mylib")
    assert_eq(vendored_dir_name("/"), "/")
    assert_eq(vendored_dir_name("/a/.."), "/a/..")
    assert_eq(vendored_dir_name("/a/."), "/a/.")
    assert_eq(vendored_dir_name("/a/k=v"), "/a/k=v")
}

test "the map ends in a slash so it matches only files inside the dir" {
    assert_eq(vendored_dir_maps(["/a/b/mylib/", "vendor/x", "/a/k=v", "/c/sqlite3"]), ["-fmacro-prefix-map=/a/b/mylib/=mylib/", "-fmacro-prefix-map=/c/sqlite3/=sqlite3/"])
}

test "header lines spell each dir as the map does only when asked" {
    let root = "{env.cwd()}/.tmp/vendored_dir_name_lines_{getpid()}"
    let dir = "{root}/mylib"
    shell_exec("rm -rf {dir} && mkdir -p {dir}")
    write_file("{dir}/a.h", "int a;\n")
    let by_path = header_lines_named([dir], false) ?? []
    let by_name = header_lines_named([dir], true) ?? []
    shell_exec("rm -rf {root}")
    assert_eq(by_path.len(), 1)
    assert_eq(by_name.len(), 1)
    let sha = by_path.get(0).unwrap().split("=").get(1).unwrap()
    assert_eq(by_path.get(0).unwrap(), "{dir}/a.h={sha}")
    assert_eq(by_name.get(0).unwrap(), "mylib/a.h={sha}")
}

test "dirs that share a name keep their paths and take no map" {
    let dirs = ["/x/a/inc", "/y/b/inc/", "/z/mylib"]
    assert_eq(vendored_dir_spellings(dirs), ["/x/a/inc", "/y/b/inc/", "mylib"])
    assert_eq(vendored_dir_maps(dirs), ["-fmacro-prefix-map=/z/mylib/=mylib/"])
}

test "an absolute dir named like a relative dir keeps its path" {
    assert_eq(vendored_dir_spellings(["inc", "/x/inc", "/x/other"]), ["inc", "/x/inc", "other"])
}

test "a dir inside another and the dir around it keep their paths" {
    assert_eq(vendored_dir_spellings(["/x/inc", "/x/inc/sub", "/x/incl"]), ["/x/inc", "/x/inc/sub", "incl"])
}

test "header lines of dirs that share a name spell each by its path" {
    let root = "{env.cwd()}/.tmp/vendored_dir_one_name_lines_{getpid()}"
    shell_exec("rm -rf {root} && mkdir -p {root}/a/inc {root}/b/inc")
    write_file("{root}/a/inc/pick.h", "int a;\n")
    write_file("{root}/b/inc/pick.h", "int b;\n")
    let lines = header_lines_named(["{root}/a/inc", "{root}/b/inc"], true) ?? []
    shell_exec("rm -rf {root}")
    assert_eq(lines.len(), 2)
    assert(lines.get(0).unwrap().starts_with("{root}/a/inc/pick.h="), lines.get(0).unwrap())
    assert(lines.get(1).unwrap().starts_with("{root}/b/inc/pick.h="), lines.get(1).unwrap())
}
