// vfgp72 -- operator -> Eq/Ord trait desugaring (sections/03_types.md:1790-1807).
//   a == b  -> a.eq(b)         a != b -> a.ne(b)
//   a <  b  -> a.cmp(b) == Less   a >  b -> ...== Greater
//   a <= b  -> a.cmp(b) != Greater  a >= b -> ...!= Less
//
// Covers: @derive(Eq) struct/enum ==, @derive(Ord) struct/enum </>/<=/>=,
// builtin Instant/Duration/Bytes operators, scalar same-type comparisons, and
// the enum-vs-Int representation exception (03_types.md:1093).
//
// Scope: single-module. Cross-module @derive(Eq/Ord) operators inherit the
// pre-existing cross-TU derive-emit gap (br znad0f) — out of scope for vfgp72.

import std.time.{Duration_ms}
import std.bytes

@derive(Eq)
type Point { x: Int, y: Int }

test "derive Eq struct ==" {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    let c = Point { x: 1, y: 3 }
    assert(a == b)
    assert(a != c)
    assert(!(a == c))
}

@derive(Eq)
@derive(Ord)
type Ver { major: Int, minor: Int }

test "derive Ord struct relational" {
    let v1 = Ver { major: 1, minor: 0 }
    let v2 = Ver { major: 1, minor: 5 }
    let v3 = Ver { major: 2, minor: 0 }
    assert(v1 < v2)
    assert(v2 < v3)
    assert(v3 > v1)
    assert(v1 <= v1)
    assert(v1 >= v1)
    assert(v2 >= v1)
    assert(!(v1 > v2))
}

@derive(Eq)
@derive(Ord)
type Level { Low, Mid, High }

test "derive Ord enum relational by variant index" {
    assert(Level.Low < Level.High)
    assert(Level.High > Level.Mid)
    assert(Level.Mid <= Level.Mid)
    assert(Level.Mid >= Level.Low)
    assert(!(Level.High < Level.Low))
}

test "builtin Instant ==/< via nanos" {
    let t1: Instant = time.read()
    let t2: Instant = time.read()
    // t1 was read first, so t1 <= t2 on a monotonic clock.
    assert(t1 == t1)
    assert(!(t1 != t1))
    assert(t1 <= t2)
}

test "builtin Duration relational" {
    let small: Duration = Duration_ms(5)
    let big: Duration = Duration_ms(50)
    assert(small < big)
    assert(big > small)
    assert(small <= small)
    assert(small == small)
    assert(small != big)
}

test "builtin Bytes ==" {
    let a: Bytes = Bytes.from_str("hello")
    let b: Bytes = Bytes.from_str("hello")
    let c: Bytes = Bytes.from_str("world")
    assert(a == b)
    assert(a != c)
}

test "scalar same-type comparisons" {
    let x: U32 = 5
    assert(x < 10)
    assert(10 > x)
    let y: U32 = 7
    assert(x < y)
    let ca: Char = 'a'
    let cb: Char = 'b'
    assert(ca < cb)
    let fa: Float = 1.5
    assert(fa > 0.0)
    assert(fa < 2.0)
    assert(true == true)
    assert(false != true)
    assert("a" < "b")
    let o1: Option[Int] = Some(1)
    let o2: Option[Int] = Some(1)
    assert(o1 == o2)
}

type Mode { Off, On }

test "enum-vs-Int representation exception" {
    let m = Mode.On
    assert(m == 1)
    assert(0 == Mode.Off)
    assert(m > 0)
}
