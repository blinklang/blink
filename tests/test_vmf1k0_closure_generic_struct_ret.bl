// br vmf1k0: a closure whose declared return type is a generic struct INSTANCE must
// spell the monomorphized name, not the bare mono head.
//
//     type GKV[K, V] { m: Map[K, V] }
//     fn a() -> GKV[Int, Str] {
//         let c = fn() -> GKV[Int, Str] { GKV { m: mkmap() } }
//         c()
//     }
//
//   error: unknown type name 'blink_GKV'
//   static blink_GKV __closure_0(const blink_closure* __self) {
//   blink_GKV _cls_ret_0 = ((blink_GKV(*)(const blink_closure*))c->fn_ptr)(c);
//
// EVERYTHING AROUND THE CLOSURE IS ALREADY CORRECT, which is what localizes this: the
// blink_GKV_Int_Str typedef is emitted, the struct literal lowers to it, and the
// enclosing fn a() returns blink_GKV_Int_Str. Only the closure's own return type keeps
// the bare head.
//
// Root cause: src/codegen_closures.bl sets `closure_ret_struct = ret_str` from
// node_return_type, which is the BARE name — the `[Int, Str]` arguments live in the
// annotation's element sublist, not in the name. That one binding then spells BOTH
// broken sites: the definition line directly, and the call-site cast through
// expr_closure_sig. So the two C errors are one defect, and a fix that repairs only
// the definition would leave the cast mismatched — hence a row for each below.
//
// WHY THIS WAS INVISIBLE UNTIL NOW. It is pre-existing, not a regression. The struct
// literal inside the closure used to ICE first with I0001 UnsolvedTypeVarAtCodegen
// (mono args 'BLINK_I0001_erased_slot,BLINK_I0001_erased_slot'), so codegen never
// reached the closure's return type. br qnpb2d made the tid authoritative at the
// struct-literal mono seam, which resolves that slot and exposes this one.
// tests/test_5htahp_concrete_field_return_mono.bl pinned the old ICE for this exact
// shape; that row is retargeted here to assert the shape works.
//
// A CLEAN cc IS NOT THE BAR (CLAUDE.md). The bare-head bug happens to fail loudly at
// cc, but the adjacent failure mode — a closure return that monomorphizes its NAME
// while leaving the Map field's KEY ops unresolved — compiles cleanly and corrupts at
// runtime (the br hnyqe4 signature). 256 and 512 both carry a 0x00 low byte, so under
// the string hasher they collide as the empty string and the second insert overwrites
// the first. Every row here therefore asserts blink_kops_i64 present AND blink_kops_str
// absent, and the runtime row round-trips both keys as the independent witness.
//
// SCOPE OF THAT WITNESS — read before strengthening it. The runtime row witnesses the
// KEY path only. The VALUE side of `g.m.get(256).unwrap() == "lo"` currently lowers to
// blink_Option_int over a `const char*` and compares POINTERS, and it passes only
// because string literals intern. That is br sqbb99, a PRE-EXISTING defect that
// reproduces identically on the pre-qnpb2d baseline: a local bound from a call
// returning a generic-struct instance (`let g = a()`) loses the Map value type, while
// the annotated twin (`let g: GKV[Int, Str] = ...`) is correct. Replace the literal
// with a computed string ("l".concat("o")) and this row SEGFAULTS — on both compilers.
// So do not read the value comparison as an assertion about V, and do not "fix" it here
// by making it non-interned: that would turn this file red for an unrelated bug. When
// sqbb99 lands, tighten it to a computed string and it becomes a real value witness too.

import compile_test_helpers
import std.io

fn assert_has(c: Str, needle: Str, label: Str) {
    if !c.contains(needle) { io.println("FAIL: {label} — missing '{needle}'") }
    assert(c.contains(needle))
}

fn assert_lacks(c: Str, needle: Str, label: Str) {
    if c.contains(needle) { io.println("FAIL: {label} — forbidden '{needle}' present") }
    assert(!c.contains(needle))
}

fn gkv_decl() -> Str {
    "type GKV[K, V] \{ m: Map[K, V] }\n"
}

fn mkmap_annotated() -> Str {
    let mut s = "fn mkmap() -> Map[Int, Str] \{\n"
    s = s.concat("    let m: Map[Int, Str] = Map()\n")
    s = s.concat("    m\n")
    s = s.concat("}\n")
    s
}

// The ticket's MVCE verbatim.
fn src_closure_ret() -> Str {
    let mut s = gkv_decl()
    s = s.concat(mkmap_annotated())
    s = s.concat("fn a() -> GKV[Int, Str] \{\n")
    s = s.concat("    let c = fn() -> GKV[Int, Str] \{ GKV \{ m: mkmap() } }\n")
    s = s.concat("    c()\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let g = a()\n")
    s = s.concat("    g.m.insert(256, \"lo\")\n")
    s = s.concat("    g.m.insert(512, \"hi\")\n")
    s = s.concat("    assert(g.m.get(256).unwrap() == \"lo\")\n")
    s = s.concat("    assert(g.m.get(512).unwrap() == \"hi\")\n")
    s = s.concat("    assert(g.m.len() == 2)\n")
    s = s.concat("}\n")
    s
}

test "a closure returning a generic struct instance spells the monomorphized return type" {
    let c = compile_test_helpers.compile_and_emit_c(src_closure_ret(), "vmf1k0_ret_c")
    // The mono instance's own typedef name, read structurally from the emitted C rather
    // than spelled literally — the mangling scheme is not what this row pins.
    let names = compile_test_helpers.mono_typedef_names(c, "GKV")
    if names.len() != 1 { io.println("FAIL: GKV mono instances — want 1, got {names.len()}") }
    assert(names.len() == 1)
    let gkv = names.get(0).unwrap()
    assert(gkv.contains("Int") && gkv.contains("Str"))
    // The definition line. Anchored on `static ` + that exact name so a substring of
    // the correct spelling cannot satisfy it.
    assert_has(c, "static {gkv} __closure_", "closure definition return type")
    assert_lacks(c, "static blink_GKV __closure_", "closure definition keeps the bare head")
}

test "the closure call-site cast agrees with the definition" {
    let c = compile_test_helpers.compile_and_emit_c(src_closure_ret(), "vmf1k0_cast_c")
    // Driven by the same closure_ret_struct binding as the definition, via
    // expr_closure_sig — a fix that repairs only the definition leaves this mismatched
    // and the C still refuses to compile.
    assert_lacks(c, "blink_GKV(*)(", "call-site cast keeps the bare head")
    assert_lacks(c, "blink_GKV _cls_ret_", "call-site temp keeps the bare head")
}

// Per CLAUDE.md the `_Void` grep is a LOWER BOUND: the tid producers erase by passing
// the binder through unchanged (blink_GKV_K, br pt4hsy) and a def-side field can erase
// under a fully correct mono name (blink_map_void, br w4c0py). All three families.
test "the closure return type does not erase its binders" {
    let c = compile_test_helpers.compile_and_emit_c(src_closure_ret(), "vmf1k0_erase_c")
    assert_lacks(c, "_Void", "string-producer erasure spelling")
    assert_lacks(c, "blink_GKV_K", "bare-binder passthrough")
    assert_lacks(c, "blink_map_void", "erased Map carrier field")
    assert_lacks(c, "UnsolvedTypeVarAtCodegen", "loud ICE")
}

// The wrong-kops class compiles cleanly, so this is the only static detector.
test "the closure's Map field keeps its Int key ops" {
    let c = compile_test_helpers.compile_and_emit_c(src_closure_ret(), "vmf1k0_kops_c")
    assert_has(c, "blink_kops_i64", "Int key ops selected")
    assert_lacks(c, "blink_kops_str", "string hasher would collide 256 and 512")
}

// The independent witness: both keys carry a 0x00 low byte and would collide as the
// empty string under the string hasher, so a clean cc with the wrong kops still fails
// here.
test "the closure-returned map round-trips both colliding keys at runtime" {
    let r = compile_test_helpers.compile_and_run(src_closure_ret(), "vmf1k0_ret_run")
    if r.exit_code != 0 {
        io.println("FAIL: closure generic-struct return runtime — {r.err_out}")
    }
    assert(r.exit_code == 0)
}

// DECISIONS.md:343 / sections/03_types.md:1153 (6-0): distinct instantiations never
// collapse onto one C symbol. A fix that reached for the mono name by any route that
// forgets the arguments again — or that memoizes one closure's answer for the next —
// would merge these two.
fn src_two_instantiations() -> Str {
    let mut s = "type Box[T] \{ v: T }\n"
    s = s.concat("fn a() -> Box[Int] \{\n")
    s = s.concat("    let c = fn() -> Box[Int] \{ Box \{ v: 7 } }\n")
    s = s.concat("    c()\n")
    s = s.concat("}\n")
    s = s.concat("fn b() -> Box[Str] \{\n")
    s = s.concat("    let c = fn() -> Box[Str] \{ Box \{ v: \"s\" } }\n")
    s = s.concat("    c()\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    assert(a().v == 7)\n")
    s = s.concat("    assert(b().v == \"s\")\n")
    s = s.concat("}\n")
    s
}

test "two closures returning different instantiations keep distinct C symbols" {
    let c = compile_test_helpers.compile_and_emit_c(src_two_instantiations(), "vmf1k0_floor_c")
    let names = compile_test_helpers.mono_typedef_names(c, "Box")
    if names.len() != 2 { io.println("FAIL: Box mono instances — want 2, got {names.len()}") }
    assert(names.len() == 2)
    let first = names.get(0).unwrap()
    let second = names.get(1).unwrap()
    assert(first != second)
    // Each distinct instance also owns a distinct closure definition line.
    assert_has(c, "static {first} __closure_", "first Box closure")
    assert_has(c, "static {second} __closure_", "second Box closure")
    assert_lacks(c, "static blink_Box __closure_", "bare head for either")
    assert_lacks(c, "_Void", "erasure")
    assert_lacks(c, "blink_Box_T ", "bare-binder passthrough")
}

test "both closure instantiations run" {
    let r = compile_test_helpers.compile_and_run(src_two_instantiations(), "vmf1k0_floor_run")
    if r.exit_code != 0 {
        io.println("FAIL: two-instantiation closure runtime — {r.err_out}")
    }
    assert(r.exit_code == 0)
}

// A NON-generic struct return must keep the bare head — that spelling is correct
// there, and the fix must not start appending an empty mono suffix. This is the guard
// against "always route through mono_name_from_ann and hope it returns something".
fn src_non_generic() -> Str {
    let mut s = "type Plain \{ n: Int }\n"
    s = s.concat("fn a() -> Plain \{\n")
    s = s.concat("    let c = fn() -> Plain \{ Plain \{ n: 3 } }\n")
    s = s.concat("    c()\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{ assert(a().n == 3) }\n")
    s
}

test "a non-generic struct return still spells the bare name" {
    let c = compile_test_helpers.compile_and_emit_c(src_non_generic(), "vmf1k0_plain_c")
    assert_has(c, "static blink_Plain __closure_", "non-generic keeps the bare name")
    assert_lacks(c, "blink_Plain_ ", "no empty mono suffix")
    let r = compile_test_helpers.compile_and_run(src_non_generic(), "vmf1k0_plain_run")
    if r.exit_code != 0 { io.println("FAIL: non-generic closure runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}
