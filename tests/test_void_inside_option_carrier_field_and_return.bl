// A genuine Void type argument inside a carrier (Option[Void]) used as a
// monomorphized struct field, or as a monomorphized function's return type,
// must compile and behave like any other Option[T].

import compile_test_helpers.{compile_and_run}

test.failing(
    "Option[Void] as a monomorphized struct field compiles and runs",
    reason: "emit_option_typedef returns early for a Void inner and never emits blink_Option_void, while the field is declared with that name and the literal is spelled blink_Option_int instead — cc rejects the mismatched, undefined type",
    ticket: "7s0pqn",
) {
    let src = #"
import std.io

type QBox[T] {
    v: Option[T]
}

fn main() {
    let b: QBox[Void] = QBox { v: None }
    io.println("{b.v.is_none()}")
}
"#
    let r = compile_and_run(src, "_void_option_carrier_struct_field")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "true\n")
}

test.failing(
    "Option[Void] as a monomorphized generic function's return type compiles and runs",
    reason: "the same Void-in-Option-carrier defect on the mono return position: blink_Option_void is referenced but never defined, and the literal is spelled blink_Option_int",
    ticket: "7s0pqn",
) {
    let src = #"
import std.io

fn wrap[T](x: T) -> Option[T] { Some(x) }

fn main() {
    let o = wrap(())
    io.println("{o.is_some()}")
}
"#
    let r = compile_and_run(src, "_void_option_carrier_generic_return")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "true\n")
}
