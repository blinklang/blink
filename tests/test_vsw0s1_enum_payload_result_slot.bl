// A positional data-enum variant whose declared payload is a compound generic
// (`V(Result[P, Int])`) must pin the constructor argument value to that declared
// type. The positional ctor path emitted the Ok(...) value with its own inferred
// tid (err slot defaulted to str -> blink_Result_P_str) while the enum field _0
// is the declared blink_Result_P_int, producing an incompatible-types C error.
// The struct-style ctor path already retargets the value-context annotation to
// the variant field; the positional path must do the same.

import compile_test_helpers

fn src_result_payload_int_slot() -> Str {
    #"import std.io

type P { x: Int, y: Int }
type E { V(Result[P, Int]) }

fn main() {
    let e = E.V(Ok(P { x: 5, y: 6 }))
    match e {
        E.V(r) => {
            match r {
                Ok(v) => io.println("x={v.x} y={v.y}")
                Err(_) => io.println("err")
            }
        }
    }
}
"#
}

test "positional enum payload Result[P,Int] pins the Ok value's err slot to the declared type" {
    let r = compile_test_helpers.compile_and_run(src_result_payload_int_slot(), "vsw0s1_result")
    if !r.out.contains("x=5 y=6") {
        compile_test_helpers.expect_contains(r.out, "x=5 y=6", "enum payload Result slot — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("x=5 y=6"))
    assert(!r.out.contains("err"))
    assert_eq(r.exit_code, 0)
}

fn src_result_payload_err_slot() -> Str {
    #"import std.io

type P { x: Int, y: Int }
type E { V(Result[P, Int]) }

fn main() {
    let e = E.V(Err(99))
    match e {
        E.V(r) => {
            match r {
                Ok(_) => io.println("ok")
                Err(code) => io.println("code={code}")
            }
        }
    }
}
"#
}

test "positional enum payload Result[P,Int] carries the Err(Int) slot" {
    let r = compile_test_helpers.compile_and_run(src_result_payload_err_slot(), "vsw0s1_err")
    if !r.out.contains("code=99") {
        compile_test_helpers.expect_contains(r.out, "code=99", "enum payload Result err slot — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("code=99"))
    assert(!r.out.contains("ok"))
    assert_eq(r.exit_code, 0)
}
