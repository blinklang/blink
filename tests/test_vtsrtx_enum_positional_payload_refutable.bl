// A refutable sub-pattern inside a data-enum POSITIONAL payload must gate the
// match arm. pattern_condition's data-enum positional branch returned only
// `.tag == N`, ignoring the payload sub-patterns entirely, so `E.V(5)` matched
// any `E.V(_)` and an earlier literal arm swallowed values it should not.
// The fix ANDs in each payload sub-pattern's condition through
// `{scrut}.data.{variant}.{field}`, mirroring the struct-style path; tuple
// element conditions route through per-element field access.

import compile_test_helpers

fn src_scalar_literal() -> Str {
    #"import std.io

type E { V(Int) }

fn main() {
    let e = E.V(3)
    match e {
        E.V(5) => io.println("five")
        E.V(x) => io.println("other={x}")
    }
}
"#
}

fn src_string_literal() -> Str {
    #"import std.io

type Tag { T(Str) }

fn main() {
    let t = Tag.T("no")
    match t {
        Tag.T("yes") => io.println("yes")
        Tag.T(s) => io.println("other={s}")
    }
}
"#
}

fn src_range_literal() -> Str {
    #"import std.io

type N { W(Int) }

fn main() {
    let n = N.W(50)
    match n {
        N.W(0..10) => io.println("low")
        N.W(x) => io.println("high={x}")
    }
}
"#
}

fn src_multi_field() -> Str {
    #"import std.io

type Pair { P(Int, Int) }

fn main() {
    let p = Pair.P(1, 9)
    match p {
        Pair.P(1, 2) => io.println("one-two")
        Pair.P(a, b) => io.println("other={a},{b}")
    }
}
"#
}

fn src_tuple_element_literal() -> Str {
    #"import std.io

type E { V((Int, Int)) }

fn main() {
    let e = E.V((3, 4))
    match e {
        E.V((3, 9)) => io.println("three-nine")
        E.V((a, b)) => io.println("other={a},{b}")
    }
}
"#
}

fn src_nested_tuple_literal() -> Str {
    #"import std.io

type E { V((Int, (Int, Int))) }

fn main() {
    let e = E.V((1, (2, 3)))
    match e {
        E.V((1, (9, 9))) => io.println("match")
        E.V((a, (b, c))) => io.println("other={a},{b},{c}")
    }
}
"#
}

fn src_option_payload() -> Str {
    #"import std.io

type E { V(Option[Int]) }

fn main() {
    let e = E.V(Some(5))
    match e {
        E.V(None) => io.println("none-arm")
        E.V(Some(x)) => io.println("some={x}")
    }
}
"#
}

fn src_variant_name_collision() -> Str {
    #"import std.io

type Color { Red, Green, Blue }

type Light { Off, Red }

type Box { Has(Light) }

fn main() {
    let b = Box.Has(Light.Red)
    match b {
        Box.Has(Red) => io.println("red-arm")
        Box.Has(x) => io.println("other")
    }
}
"#
}

test "data-enum positional scalar literal sub-pattern gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_scalar_literal(), "vtsrtx_scalar")
    if !r.out.contains("other=3") {
        compile_test_helpers.expect_contains(r.out, "other=3", "scalar literal gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("other=3"))
    assert(!r.out.contains("five"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional string literal sub-pattern gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_string_literal(), "vtsrtx_string")
    if !r.out.contains("other=no") {
        compile_test_helpers.expect_contains(r.out, "other=no", "string literal gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("other=no"))
    assert(!r.out.contains("yes"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional range sub-pattern gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_range_literal(), "vtsrtx_range")
    if !r.out.contains("high=50") {
        compile_test_helpers.expect_contains(r.out, "high=50", "range gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("high=50"))
    assert(!r.out.contains("low"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional multi-field literal sub-pattern gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_multi_field(), "vtsrtx_multi")
    if !r.out.contains("other=1,9") {
        compile_test_helpers.expect_contains(r.out, "other=1,9", "multi-field gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("other=1,9"))
    assert(!r.out.contains("one-two"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional tuple element literal sub-pattern gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_tuple_element_literal(), "vtsrtx_tuple")
    if !r.out.contains("other=3,4") {
        compile_test_helpers.expect_contains(r.out, "other=3,4", "tuple element gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("other=3,4"))
    assert(!r.out.contains("three-nine"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional nested tuple literal sub-pattern gates without crashing" {
    let r = compile_test_helpers.compile_and_run(src_nested_tuple_literal(), "vtsrtx_nested")
    if !r.out.contains("other=1,2,3") {
        compile_test_helpers.expect_contains(r.out, "other=1,2,3", "nested tuple gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("other=1,2,3"))
    assert(!r.out.contains("match"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional Option payload carrier sub-pattern gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_option_payload(), "vtsrtx_option")
    if !r.out.contains("some=5") {
        compile_test_helpers.expect_contains(r.out, "some=5", "option payload gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("some=5"))
    assert(!r.out.contains("none-arm"))
    assert_eq(r.exit_code, 0)
}

test "data-enum positional bare-variant sub-pattern resolves against the field enum" {
    let r = compile_test_helpers.compile_and_run(src_variant_name_collision(), "vtsrtx_collision")
    if !r.out.contains("red-arm") {
        compile_test_helpers.expect_contains(r.out, "red-arm", "variant collision gate — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("red-arm"))
    assert(!r.out.contains("other"))
    assert_eq(r.exit_code, 0)
}
