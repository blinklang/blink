import test_vy5113_tuple_import_carrier_helper
import test_vy5113_tuple_import_carrier_helper.{Cmd}

type Model { count: Int }

fn upd(m: Model) -> (Model, Option[Cmd]) {
    (m, Some(Cmd.Quit))
}

test "tuple Option[Cmd] carrier unifies across defining module and selective import" {
    let m = test_vy5113_tuple_import_carrier_helper.run_with(Model { count: 5 }, upd)
    assert_eq(m.count, 5)
}
