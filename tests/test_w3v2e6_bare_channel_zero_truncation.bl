// br w3v2e6, the data-loss half: a sent 0 truncates a bare channel's for-in drain.
//
// An un-annotated `Channel(n)` has no element type (that inference is w3v2e6's other half and
// is spec-blocked — bare `Channel(n)` appears in no spec section, and 8vcj2c's E0301 boundary
// may say an un-annotated element is an ERROR rather than something to infer). So codegen falls
// back to reinterpreting the element as an 8-byte word: `send` emitted
// `blink_channel_send(ch, (void*)(intptr_t)x)`.
//
// For x == 0 that payload IS NULL, and NULL is blink_channel_recv's end-of-stream sentinel. The
// for-in drain breaks on it, so a sent 0 ended the stream — silently, and taking every value
// behind it as well:
//
//     let ch = Channel(4); ch.send(5); ch.send(0); ch.send(7); ch.close()
//     for v in ch { io.println("v={v}") }      // printed v=5 and stopped: 0 and 7 vanished
//
// br hgd2az fixed this for a channel whose element IS known (it boxes, and a box address is
// never NULL) and left the fallback reinterpreting — its own comment on the drain claimed the
// NULL test was "only sound because send now boxes", which is true only on the boxed side.
//
// THE FIX IS DECISION-INDEPENDENT and does not need w3v2e6's inference answer: the fallback now
// boxes the SAME 8-byte payload it used to send inline, so the address is never NULL while the
// payload word, and every reinterpretation of it, is unchanged. That is why rows 6 and 7 below
// pin the still-wrong answers rather than asserting fixed ones — a bare Str channel prints a
// pointer both before and after, and a bare Float channel must keep failing LOUDLY in the C
// compiler rather than being silently truncated into an integer box.

import std.process.{ProcessResult}

fn emit_c(tag: Str, src: Str) -> Str {
    let bl_path = ".tmp/_w3v2e6_{tag}.bl"
    write_file(bl_path, src)
    let _ = process_run("build/blink", ["build", bl_path, "--emit", "c"])
    let c_src = read_file("build/_w3v2e6_{tag}.c")
    shell_exec("rm -f {bl_path} build/_w3v2e6_{tag}.c")
    c_src
}

fn run_src(tag: Str, src: Str) -> ProcessResult {
    let bl_path = ".tmp/_w3v2e6_{tag}.bl"
    let bin = ".tmp/_w3v2e6_{tag}"
    write_file(bl_path, src)
    let build = process_run("build/blink", ["build", bl_path, "-o", bin])
    if build.exit_code != 0 {
        shell_exec("rm -f {bl_path}")
        return build
    }
    let r = process_run(bin, [])
    shell_exec("rm -f {bl_path} {bin}")
    r
}

test "a leading zero does not truncate a bare channel's for-in drain" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.send(0)\n    ch.send(1)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n    io.println(\"done\")\n\}\n"
    let r = run_src("lead", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=0"))
    assert(r.out.contains("v=1"))
    assert(r.out.contains("done"))
}

// The value BEHIND the zero is the one that shows this is truncation and not a bad rendering
// of a single element: before the fix this drained `5` and stopped, losing both 0 and 7.
test "a mid-stream zero does not truncate the values behind it" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.send(5)\n    ch.send(0)\n    ch.send(7)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("mid", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=5"))
    assert(r.out.contains("v=0"))
    assert(r.out.contains("v=7"))
}

// The mechanism, not just the outcome: a behavioral row alone would pass if the drain stopped
// treating NULL as end-of-stream, which would break a genuinely closed channel instead.
test "the bare-channel send fallback boxes instead of reinterpreting the value as a pointer" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.send(0)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let c = emit_c("box", src)
    assert(!c.contains("blink_channel_send(ch, (void*)(intptr_t)"))
    assert(c.contains("blink_channel_send(ch, (void*)__chbox_"))
}

// Controls that pin what must NOT move.

test "the .recv() path on a bare channel still reads zero back" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.send(0)\n    ch.send(1)\n    ch.close()\n    io.println(\"a=\{ch.recv()\} b=\{ch.recv()\}\")\n\}\n"
    let r = run_src("recv", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("a=0 b=1"))
}

// A closed, empty channel must still end the drain and still answer the element's zero value
// through .recv() (what it SHOULD answer is br yzan52, a spec question). Boxing moves the NULL
// test from the payload to the box address, so this is the row that proves the sentinel survived.
test "a closed empty bare channel still ends the drain and reads back zero" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n    io.println(\"drained\")\n    io.println(\"empty=\{ch.recv()\}\")\n\}\n"
    let r = run_src("closed", src)
    assert_eq(r.exit_code, 0)
    assert(!r.out.contains("v="))
    assert(r.out.contains("drained"))
    assert(r.out.contains("empty=0"))
}

// The compiler's own shape (src/cli.bl:2169-2170): a 1-slot bare channel used as a mutable cell
// whose stored value is legitimately 0. It worked before only because TWO bugs cancelled — the
// payload 0 became NULL and .recv()'s NULL case answers the zero value — so it is correct by
// accident on the old path and correct by construction on the new one. `blink test --parallel`'s
// dot-column counter is this code.
test "a one-slot bare channel used as a zero-valued mutable cell round-trips" {
    let src = "fn main() \{\n    let cell = Channel(1)\n    cell.send(0)\n    let a = cell.recv()\n    cell.send(a + 1)\n    let b = cell.recv()\n    cell.send(b + 1)\n    io.println(\"a=\{a\} b=\{b\} c=\{cell.recv()\}\")\n\}\n"
    let r = run_src("cell", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("a=0 b=1 c=2"))
}

test "an annotated Channel[Int] still drains a zero" {
    let src = "fn main() \{\n    let ch: Channel[Int] = Channel(4)\n    ch.send(0)\n    ch.send(1)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("ann", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=0"))
    assert(r.out.contains("v=1"))
}

// R6 — PINS A STILL-WRONG ANSWER, deliberately. A bare channel carrying a Str reinterprets the
// element as an integer and prints a pointer, before AND after this fix, because the fallback
// has no element type to consult — that is w3v2e6's inference half. Asserting the ABSENCE of
// "hello" rather than the garbage number, since the pointer value varies per run. When the
// inference lands this row goes red, which is the point: it must not slide in silently.
test "a bare Str channel still reinterprets its element (w3v2e6 inference half, not fixed here)" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.send(\"hello\")\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("bstr", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v="))
    assert(!r.out.contains("v=hello"))
}

// R7 — the loudness control. A bare Float element fails in the C compiler ("cannot convert to a
// pointer type"). Boxing must keep the cast that produces that error INSIDE the box assignment:
// a `int64_t` box would have accepted the double and silently truncated it, trading a loud
// failure for a wrong value. That is the one way this fix could have made things worse.
test "a bare Float channel still fails loudly rather than truncating into a box" {
    let src = "fn main() \{\n    let ch = Channel(4)\n    ch.send(1.5)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("bfl", src)
    assert(r.exit_code != 0)
}
