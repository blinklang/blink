// A mono enum whose variant payload is a Tuple must lower the variant field to the
// tuple carrier type (blink_Tuple2_P_P), the same as a Tuple field on a struct does,
// AND a match binding over that payload must carry the tuple carrier tag so a
// positional read (`t.0`) resolves. Two defects: emit_enum_typedef's variant-field
// C-type spelling had no "Tuple" case (field declared `void`), and the variant-field
// binders never set_var_struct the tuple tag (so `t.0` rendered `<value>`).

import compile_test_helpers

fn src_ctor_tuple() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E { V((P, P)) }

fn main() {
    let e = E.V((P { x: 7, y: 8 }, P { x: 9, y: 10 }))
    match e {
        E.V(t) => io.println("a={t.0.x} b={t.1.y}")
    }
}
"#
}

fn src_structlit_tuple() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E {
    V { pair: (P, P) }
}

fn main() {
    let e = E.V { pair: (P { x: 1, y: 2 }, P { x: 3, y: 4 }) }
    match e {
        E.V { pair } => io.println("a={pair.0.x} b={pair.1.y}")
    }
}
"#
}

test "mono enum ctor Tuple payload lowers the variant field to the tuple carrier type" {
    let r = compile_test_helpers.compile_and_run(src_ctor_tuple(), "w6nqwx_ctor_tuple")
    if !r.out.contains("a=7 b=10") {
        compile_test_helpers.expect_contains(r.out, "a=7 b=10", "enum ctor tuple payload — got '{r.err_out}'")
    }
    assert(r.out.contains("a=7 b=10"))
    assert_eq(r.exit_code, 0)
}

test "mono enum struct-literal Tuple payload lowers the variant field to the tuple carrier type" {
    let r = compile_test_helpers.compile_and_run(src_structlit_tuple(), "w6nqwx_structlit_tuple")
    if !r.out.contains("a=1 b=4") {
        compile_test_helpers.expect_contains(r.out, "a=1 b=4", "enum structlit tuple payload — got '{r.err_out}'")
    }
    assert(r.out.contains("a=1 b=4"))
    assert_eq(r.exit_code, 0)
}
