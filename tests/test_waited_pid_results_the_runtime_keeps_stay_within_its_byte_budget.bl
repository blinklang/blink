// The runtime keeps waited results so a second wait can return them. Without a byte budget it
// kept one per table slot, so a program that spawns many children with large output held them
// all: about 318 MB of peak memory for 4097 children printing 64 KiB each, where it needs 4 MB.
import std.process.{spawn}
test "many waited children with large output leave the peak memory near one child's output" {
    let mut i = 0
    while i < 400 {
        let r = spawn("sh", ["-c", "printf '%0262144d' 0"]).wait()
        assert_eq(r.out.len(), 262144)
        i = i + 1
    }
    // The shell's parent is this test binary, so its VmHWM is our peak resident memory.
    let hwm = spawn("sh", ["-c", "awk '/^VmHWM:/ \{print $2\}' /proc/$PPID/status"]).wait()
    let kb = hwm.out.trim().to_int()
    assert(kb > 0, "no VmHWM read: out={hwm.out} err={hwm.err_out}")
    // 400 kept results would be 100 MiB; the 1 MiB budget leaves room for the GC heap.
    assert(kb < 40000, "peak resident memory {kb} kB")
}
