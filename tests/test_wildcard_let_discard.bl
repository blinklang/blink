type Color {
    Red
    Green
    Blue
}

fn side_effect(x: Int) -> Int {
    x + 1
}

fn discards_in_fn() -> Int {
    let _ = side_effect(1)
    let _ = side_effect(2)
    let _ = Color.Red
    42
}

test "multiple wildcard discards in one scope" {
    let _ = side_effect(10)
    let _ = side_effect(20)
    let _ = Color.Green
    assert_eq(1, 1)
}

test "wildcard discards inside a fn" {
    assert_eq(discards_in_fn(), 42)
}
