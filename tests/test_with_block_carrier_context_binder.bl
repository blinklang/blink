// A `with` block resource whose BlockHandler Context is a carrier type
// (Option[X]) must spell the binder's C type from that carrier's own type
// argument, not erase it to void.

import compile_test_helpers.{compile_and_run}

test "with-block binder over an Option carrier Context compiles and reads the value" {
    let src = #"
import std.io

type Res { id: Int }
fn make_res(id: Int) -> Res { Res { id: id } }
impl BlockHandler for Res {
    type Context = Option[Int]
    fn enter(self) -> Option[Int] { Some(self.id) }
    fn exit(self, ok: Bool) { }
}
fn main() ! IO {
    with make_res(5) as o {
        io.println("got={o.unwrap()}")
    }
}
"#
    let r = compile_and_run(src, "_with_block_carrier_context_binder")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "got=5\n")
}
