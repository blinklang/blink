// A `with` block used as a value whose tail statement is not a value expression. The block
// answers nothing, so the binding gets nothing; what the tests below pin is that the block's
// effect still happens and the compiler still emits it.

test "a with-arena block bound to a name runs its tail statement" {
    let mut acc = 0
    let _r = with arena {
        acc = acc + 1
    }
    assert_eq(acc, 1)
}

test "a with-arena block bound to a name runs every statement of its body" {
    let mut acc = 0
    let _r = with arena {
        acc = acc + 10
        acc = acc + 1
    }
    assert_eq(acc, 11)
}

test "a with-arena block whose tail IS a value answers with it" {
    let mut acc = 0
    let r = with arena {
        acc = acc + 1
        acc + 1
    }
    assert_eq(r, 2)
}
