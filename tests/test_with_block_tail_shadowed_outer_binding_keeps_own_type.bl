// A `with` block whose tail names a block-local that shadows an outer binding of the
// same name must not let the outer binding be stamped with the shadowing tail's type.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an outer binding is unaffected by a with-block tail that shadows its name",
    reason: "speculative infer_type runs before the with-block's own scope is pushed, so it resolves the shadowing tail name to the outer binding and stamps the outer binding with the inner (wrong) type",
    ticket: "5x6h23",
) {
    let src = #"
import std.io

fn main() ! IO {
    let v = 1
    let x = with arena {
        let mut v: List[Str] = []
        v.push("a")
        v.push("b")
        v
    }
    io.println("outer={v} inner_len={x.len()} first={x.get(0).unwrap()}")
}
"#
    let r = compile_and_run(src, "_with_block_tail_shadowed_outer_binding_keeps_own_type")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "outer=1 inner_len=2 first=a\n")
}
