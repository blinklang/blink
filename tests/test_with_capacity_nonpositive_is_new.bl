// Every with_capacity constructor (List, StringBuilder) treats n <= 0 as new(): the result
// is the same as new() gives, and nothing panics (sections/03_types.md *Capacity*).

test "List.with_capacity(0) is the same as List.new()" {
    let fresh: List[Int] = List.new()
    let mut xs: List[Int] = List.with_capacity(0)
    assert_eq(xs.len(), 0)
    assert_eq(xs.capacity(), fresh.capacity())
    xs.push(1)
    xs.push(2)
    assert_eq(xs.len(), 2)
    assert_eq(xs.get(1).unwrap(), 2)
}

test "List.with_capacity(n) with n < 0 is the same as List.new()" {
    let fresh: List[Str] = List.new()
    let mut xs: List[Str] = List.with_capacity(-5)
    assert_eq(xs.len(), 0)
    assert_eq(xs.capacity(), fresh.capacity())
    let mut i = 0
    while i < 20 {
        xs.push("s{i}")
        i = i + 1
    }
    assert_eq(xs.len(), 20)
    assert_eq(xs.get(19).unwrap(), "s19")
}

test "List.with_capacity takes the most negative Int without a panic" {
    let n = -9223372036854775807 - 1
    let xs: List[Int] = List.with_capacity(n)
    assert_eq(xs.len(), 0)
}

test "StringBuilder.with_capacity(0) is the same as StringBuilder.new()" {
    let fresh = StringBuilder.new()
    let mut sb = StringBuilder.with_capacity(0)
    assert_eq(sb.len(), 0)
    assert_eq(sb.capacity(), fresh.capacity())
    sb.write("hello")
    assert_eq(sb.to_str(), "hello")
}

test "StringBuilder.with_capacity(n) with n < 0 is the same as StringBuilder.new()" {
    let fresh = StringBuilder.new()
    let mut sb = StringBuilder.with_capacity(-1)
    assert_eq(sb.len(), 0)
    assert_eq(sb.capacity(), fresh.capacity())
    sb.write("abc")
    assert_eq(sb.to_str(), "abc")
}
