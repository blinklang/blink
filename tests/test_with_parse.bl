// A with-item without `as` must be a Handler[E] or a BlockHandler, so an Int handed to
// `with` parses and is then refused with E0839.

import compile_test_helpers

let int_handler_fns = "fn make_handler() -> Int \{\n    42\n}\n\nfn make_handler2() -> Int \{\n    43\n}\n\n"

test "single with handler" {
    let src = "{int_handler_fns}fn main() \{\n    let h = make_handler()\n\n    with h \{\n        assert_eq(h, 42)\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "with_parse_single", "E0839")
}

test "multiple with handlers" {
    let src = "{int_handler_fns}fn main() \{\n    with make_handler(), make_handler2() \{\n        assert(true)\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "with_parse_multiple", "E0839")
}

test "with arena, b = rhs without as emits clean diagnostic (no panic)" {
    let src = "fn main() \{\n    with arena, b = 42 \{\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "no_as", "E1100")
}

test "with arena, b = rhs as without binding name emits diagnostic (no panic)" {
    let src = "fn main() \{\n    with arena, b = 42 as \{\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "no_bind", "E1100")
}
