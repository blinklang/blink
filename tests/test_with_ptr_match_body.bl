// Regression: a Bytes.with_ptr closure whose body is a single bare `match`
// (now a bare MatchExpr statement, not ExprStmt-wrapped) must be accepted as a
// single-expression body, not rejected with WithPtrBodyTooComplex.
test "with_ptr body of a single match expr is accepted and returns its value" {
    let b = Bytes.new()
    b.push(7)
    let sel = 0
    let r = b.with_ptr(fn(p) {
        match sel {
            0 => b.len()
            _ => 0
        }
    })
    assert_eq(r, 1)
}
