// `Bytes.with_ptr` takes its closure by position, and a label names no keyword parameter
// (E0511, section 2.13). Each spelling of a label is the same error.

import compile_test_helpers

fn rejects(label: Str, tag: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let src = "fn main() \{\n let b = Bytes.from_str(\"ab\")\n let n: Int = b.with_ptr({label}: fn(p) \{ 1 })\n assert(n == 1)\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0511", tag)
    compile_test_helpers.expect_contains(out, "`Bytes.with_ptr` takes no keyword arguments", tag)
    assert(!out.contains("internal compiler error"), out)
}

test "a label on the closure is E0511" {
    rejects("f", "wpk_f")
    rejects("body", "wpk_body")
}

test "the same closure by position runs" {
    let b = Bytes.from_str("ab")
    let n: Int = b.with_ptr(fn(p) { 1 })
    assert_eq(n, 1)
}
