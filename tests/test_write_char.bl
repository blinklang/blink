import compile_test_helpers

// br 78b3jr: StringBuilder.write_char(Char) emitted C that passed a raw
// Char (int32_t) to blink_sb_write_char(const char*), failing to compile,
// and also raised a spurious W0501 UnknownMethod because write_char was
// missing from is_builtin_method.

test "StringBuilder.write_char(Char) compiles, runs, and emits the char" {
    let src = "fn main() \{\n    let mut sb = StringBuilder.new()\n    sb.write_char('x')\n    io.println(sb.to_str())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_write_char_run")
    assert(r.exit_code == 0)
    assert(r.out.contains("x"))
}

test "StringBuilder.write_char(Char) raises no UnknownMethod warning" {
    let src = "fn main() \{\n    let mut sb = StringBuilder.new()\n    sb.write_char('x')\n    io.println(sb.to_str())\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "_write_char_warn")
    assert(!out.contains("W0501"))
    assert(!out.contains("UnknownMethod"))
}
