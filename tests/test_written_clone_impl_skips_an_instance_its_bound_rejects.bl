// A written `impl[T: Clone] Clone for G[T]` holds only where `T: Clone` holds
// (sections/03_types.md §3.6.1 *Clone Semantics*). A program that also builds `G` at a type
// with no Clone gets no clone() at that instance, and the instances that do hold still clone.

type NoClone { a: Int }

@derive(Clone)
type HasClone { a: Int }

type Holder[T] { v: T }

impl[T: Clone] Clone for Holder[T] {
    fn clone(self) -> Holder[T] { Holder { v: self.v.clone() } }
}

test "a written clone runs where its bound holds beside an instance where it does not" {
    let plain = Holder { v: NoClone { a: 1 } }
    let held = Holder { v: HasClone { a: 2 } }
    assert_eq(plain.v.a, 1)
    assert_eq(held.clone().v.a, 2)
}
