// `()` is the unit type, and `Void` is only the pointee marker of an FFI pointer: a written
// `Void` outside `Ptr[_]` is E0828 VoidOutsidePtr (sections/03_types.md, "`()` is not
// `Void`"; sections/07_trust_modules_metadata.md). The parser keeps the two spellings apart,
// so the check has what it needs, but lib/std still writes `Void` outside `Ptr`, so the
// diagnostic is not reported yet.

import compile_test_helpers

test.failing(
    "a written Void outside Ptr is E0828",
    reason: "E0828 VoidOutsidePtr is never reported: lib/std still writes Void outside Ptr, and moving it to () comes first",
) {
    let src = "fn main() \{\n    let v: Void = ()\n}\n"
    compile_test_helpers.expect_compile_error(src, "void_outside_ptr_let", "E0828")
}

test "a written () is not E0828" {
    let src = "fn main() \{\n    let _v: () = ()\n}\n"
    compile_test_helpers.expect_no_error(src, "unit_is_not_void_outside_ptr", "E0828")
}

test "Ptr[Void] is not E0828" {
    let src = "import blink.ffi \{ Ptr }\n\n@trusted(audit: \"void-pointee-row\")\nfn raw(p: Ptr[Void]) -> Ptr[Void] \{\n    p\n}\n\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "void_pointee_is_not_void_outside_ptr", "E0828")
}
