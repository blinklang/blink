// xexddt: a closure that captures a by-value aggregate reads the capture's C kind
// through capture_ct. The flat kind channel (tp_get_kind) stamps CT_INT on a
// captured data enum, so the box write-site takes the scalar `(intptr_t)` branch and
// emits `(void*)(intptr_t)s` on a `blink_Shape` struct — invalid C. capture_ct now
// leads with the tid (via capture_sname): a data enum names an aggregate, so the kind
// is CT_STRUCT and the value is boxed by value. A transparent newtype has no aggregate
// C struct, so capture_sname declines it and capture_ct keeps the scalar flat kind —
// the value stays a bare int64_t and is never mis-boxed as a struct.

type Shape { Circle(Int), Square(Int) }

fn area_of(s: Shape) -> Int {
    match s {
        Circle(r) => r * r * 3
        Square(w) => w * w
    }
}

fn make_shape_thunk(s: Shape) -> fn() -> Int {
    fn() -> Int { area_of(s) }
}

test "a by-value data-enum capture boxes as a struct, not a scalar int" {
    let f = make_shape_thunk(Circle(10))
    assert_eq(f(), 300)
    let g = make_shape_thunk(Square(6))
    assert_eq(g(), 36)
}

type Point { x: Int, y: Int }

fn sum_of(p: Point) -> Int { p.x + p.y }

fn make_point_thunk(p: Point) -> fn() -> Int {
    fn() -> Int { sum_of(p) }
}

test "a by-value struct capture still boxes as a struct" {
    let f = make_point_thunk(Point { x: 3, y: 4 })
    assert_eq(f(), 7)
}

type Errno { Errno(Int) }

fn code_of(e: Errno) -> Int {
    match e {
        Errno(n) => n
    }
}

fn make_errno_thunk(e: Errno) -> fn() -> Int {
    fn() -> Int { code_of(e) }
}

test "a by-value transparent-newtype capture stays a bare scalar" {
    let f = make_errno_thunk(Errno(42))
    assert_eq(f(), 42)
}
