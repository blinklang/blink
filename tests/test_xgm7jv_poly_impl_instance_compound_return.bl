// xgm7jv: a polymorphic trait impl over List[T] whose method returns a COMPOUND
// OVER the binder (`-> Option[T]`) instantiated at a struct-INSTANCE element
// (`List[LBox[Int]]`) once erased the concrete inner — the call-site carrier bound
// the default `blink_Option_int` while the def side monomorphized
// `blink_Option_LBox_Int` (invalid-initializer mismatch), and the arg param erased
// to a bare `LBox`.
//
// Fixed by the struct-instance tid-capture work (phybxe/kffj8d/gw4cyh + the
// wkwj7e/pktmea carriers) — verified tid-correct (csvresolve=0, monotid arg_tid=0,
// C carrier blink_Option_LBox_Int). This is the REGRESSION FENCE: a runtime test
// that reaches its asserts proves the concrete instance inner (LBox[Int]) survives
// through both the return carrier and the arg param.
//
// DISTINCT from 4c3gts (bare `-> T` return over a COMPOUND element): here the
// RETURN is the compound and the ELEMENT is a struct instance.

type LBox[T] { v: T }

trait Wrap[T] {
    fn wrap_one(self, x: T) -> Option[T]
}

impl[T] Wrap[T] for List[T] {
    fn wrap_one(_self, x: T) -> Option[T] { Some(x) }
}

test "poly impl -> Option[T] over a struct-instance element LBox[Int]" {
    let xs: List[LBox[Int]] = [LBox { v: 1 }]
    let w = xs.wrap_one(LBox { v: 42 })
    let b = w.unwrap()
    assert_eq(b.v, 42)
}

test "poly impl -> Option[T] over a struct-instance element LBox[Str]" {
    let xs: List[LBox[Str]] = [LBox { v: "a" }]
    let w = xs.wrap_one(LBox { v: "hi" })
    let b = w.unwrap()
    assert_eq(b.v, "hi")
}
