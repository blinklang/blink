// xr0qrn: a `let` binding annotated `Result[A, B]` where one side is a user
// struct must keep BOTH sides' carrier types through an Ok(...)/Err(...)
// construction. The bug dropped the "other" side's type at construction (the
// annotated-construction path only consulted cg_expect_arg_ann, set at call/
// field/method sites but NOT for lets), so the emitted C carrier collapsed to
// blink_Result_int_void and the match binding (`Err(p)`) declared `p` as void.
//
// The decisive cases are LET-annotation-driven constructions — the existing
// tests/test_struct_result.bl only exercises Ok/Err inside functions that
// RETURN a Result, where the function-return-type fallback hides the bug.

type P { name: Str, age: Int }
type Q { code: Int }

test "Result[Int, P]: Err(struct) keeps carrier" {
    let a: Result[Int, P] = Err(P { name: "x", age: 1 })
    match a {
        Ok(_) => assert(false)
        Err(p) => assert_eq(p.name, "x")
    }
}

test "Result[Int, P]: Ok(scalar) with struct err side" {
    let a: Result[Int, P] = Ok(7)
    match a {
        Ok(n) => assert_eq(n, 7)
        Err(_) => assert(false)
    }
}

test "Result[P, Int]: Ok(struct) keeps carrier, scalar err side" {
    let a: Result[P, Int] = Ok(P { name: "y", age: 2 })
    match a {
        Ok(p) => assert_eq(p.name, "y")
        Err(_) => assert(false)
    }
}

test "Result[P, Q]: both struct, Err side" {
    let a: Result[P, Q] = Err(Q { code: 42 })
    match a {
        Ok(_) => assert(false)
        Err(q) => assert_eq(q.code, 42)
    }
}

test "Result[P, Q]: both struct, Ok side" {
    let a: Result[P, Q] = Ok(P { name: "z", age: 3 })
    match a {
        Ok(p) => assert_eq(p.name, "z")
        Err(_) => assert(false)
    }
}
