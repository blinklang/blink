// xr0qrn: a `let` binding annotated `Result[A, B]` where one side is a user
// struct must keep BOTH sides' carrier types through an Ok(...)/Err(...)
// construction. The bug dropped the "other" side's type at construction (the
// annotated-construction path only consulted cg_expect_arg_ann, set at call/
// field/method sites but NOT for lets), so the emitted C carrier collapsed to
// blink_Result_int_void and the match binding (`Err(p)`) declared `p` as void.
//
// The decisive cases are LET-annotation-driven constructions — the existing
// tests/test_struct_result.bl only exercises Ok/Err inside functions that
// RETURN a Result, where the function-return-type fallback hides the bug.

type P { name: Str, age: Int }
type Q { code: Int }

test "Result[Int, P]: Err(struct) keeps carrier" {
    let a: Result[Int, P] = Err(P { name: "x", age: 1 })
    match a {
        Ok(_) => assert(false)
        Err(p) => assert_eq(p.name, "x")
    }
}

test "Result[Int, P]: Ok(scalar) with struct err side" {
    let a: Result[Int, P] = Ok(7)
    match a {
        Ok(n) => assert_eq(n, 7)
        Err(_) => assert(false)
    }
}

test "Result[P, Int]: Ok(struct) keeps carrier, scalar err side" {
    let a: Result[P, Int] = Ok(P { name: "y", age: 2 })
    match a {
        Ok(p) => assert_eq(p.name, "y")
        Err(_) => assert(false)
    }
}

test "Result[P, Q]: both struct, Err side" {
    let a: Result[P, Q] = Err(Q { code: 42 })
    match a {
        Ok(_) => assert(false)
        Err(q) => assert_eq(q.code, 42)
    }
}

test "Result[P, Q]: both struct, Ok side" {
    let a: Result[P, Q] = Ok(P { name: "z", age: 3 })
    match a {
        Ok(p) => assert_eq(p.name, "z")
        Err(_) => assert(false)
    }
}

// nfxz5m: the function-return Ok-construction fallback hardcoded the err-side
// carrier to CT_STRING when the err side is a scalar (struct-only err_struct
// is empty), so `Result[P, Int]` + `Ok(struct)` emitted a `_str` carrier on the
// err side while the fn was declared `_int` — uncompilable C. The let-annotated
// path (above) doesn't exercise this; only a fn that RETURNS the Result does.

fn make_ok_pint() -> Result[P, Int] {
    Ok(P { name: "x", age: 8 })
}

test "Result[P, Int]: fn-return Ok(struct) keeps scalar Int err carrier" {
    let r = make_ok_pint()
    match r {
        Ok(p) => assert_eq(p.age, 8)
        Err(_) => assert(false)
    }
}

fn make_ok_pstr() -> Result[P, Str] {
    Ok(P { name: "x", age: 8 })
}

test "Result[P, Str]: fn-return Ok(struct) keeps Str err carrier" {
    let r = make_ok_pstr()
    match r {
        Ok(p) => assert_eq(p.age, 8)
        Err(_) => assert(false)
    }
}

// nfxz5m (sibling): the arity-0 Ok() path had the identical hardcoded-CT_STRING
// err fallback. `Result[Void, Int]` + bare `Ok()` emitted a `_str` err carrier
// while the fn was declared `_int`.

fn make_ok_void_int() -> Result[Void, Int] {
    Ok()
}

test "Result[Void, Int]: fn-return bare Ok() keeps scalar Int err carrier" {
    let r = make_ok_void_int()
    match r {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
}
