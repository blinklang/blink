// br yavhwc: the VALUE path (emit_tuple_lit + the Some constructor + the bare-var
// carrier) now recurses an OPTION carrier whose inner is itself a compound (a Map, or a
// nested Option/Result over faithful leaves), spelling it with the SAME tc_tid_inner_tag
// the tid path uses. So an Option tuple element carrying a Map or a nested compound now
// RIDES the tid path — tc_tid_inner_tag_faithful admits it and tc_tid_tuple_elem_encodable
// no longer defers to the string CSV.
//
// Each RIDE case is a byte-stability tripwire: the tid carrier the generic-fn mono mints
// must match the value-constructed tuple, or the mono param erases to void and the emitted
// C fails to compile — which the Gen1==Gen2 fixed point (task regen) would catch. Mirrors
// test_9myrp2_compound_inner_tid_path.bl (the one-level List/Set/Bytes inners) for the
// families yavhwc newly reconciled.
//
// SCOPE UPDATE: the two families this file originally deferred both RIDE now.
//   - a RESULT carrier with a DIRECT Map ok/err side (Result[Map,_], Result[_,Map],
//     Option[Result[Map,_]], ...): br e3js70 made the construction/param/reassignment speller
//     spell the Result-Map carrier STRUCTURED (Result_Map_str_int_int, identical C layout to
//     the old bare "map"), so the carve-out is gone and it rides.
//   - a struct / bare-enum leaf: br 6q5mz2 added a TK_STRUCT/TK_ENUM arm to
//     tc_tid_inner_tag_faithful; the ride branch in emit_tuple_lit spells the inner via
//     tc_tid_inner_tag (the SAME speller the tid path uses), so it's byte-equal by construction.
// STILL DEFERS: an ENUM INSTANCE leaf (dbzy4r, blocked on 82ajft).

type AnaqcPoint {
    x: Int,
    y: Int,
}

fn take_int[T](_x: T) -> Int {
    99
}

// Option[Map[Str,Int]] inner: the anaqc3 deferred case, now RIDES. The value path (the
// Some constructor + the bare-var carrier) spells Option_Map_str_int via the map var's
// key/val, byte-identical to the tid and annotation paths → Tuple2_Option_Map_str_int_int.
test "(Option[Map[Str, Int]], Int) rides the tid path" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let p = (Some(m), 7)
    assert_eq(take_int(p), 99)
}

// Option[Option[Int]] nested: the value path recurses the inner Option → Option_Option_int.
test "(Option[Option[Int]], Int) rides the tid path" {
    let inner: Option[Int] = Some(5)
    let o: Option[Option[Int]] = Some(inner)
    let p = (o, 7)
    assert_eq(take_int(p), 99)
}

// Option[Result[List[Int], Int]] nested: recurses two levels — Option over a Result whose
// Ok leaf is a List (erased to bare "list") → Option_Result_list_int. The Result's direct
// sides are List/Int (both faithful, neither a Map), so tc_tid_inner_tag_faithful admits it
// and the whole element rides.
test "(Option[Result[List[Int], Int]], Int) rides the tid path" {
    let r: Result[List[Int], Int] = Ok([1, 2, 3])
    let o: Option[Result[List[Int], Int]] = Some(r)
    let p = (o, 7)
    assert_eq(take_int(p), 99)
}

// Driven through a generic fn over List[(Option[Map[Str,Int]], Int)] — the exact seed
// chain that forced the string CSV before yavhwc (the resolve_tparam blocker shape,
// Tuple2_Option_Map_str_int_int).
fn count_opt_map(xs: List[(Option[Map[Str, Int]], Int)]) -> Int {
    xs.len()
}

test "generic-fn over List[(Option[Map[Str, Int]], Int)] seeds the tid carrier" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let a: Option[Map[Str, Int]] = Some(m)
    let xs: List[(Option[Map[Str, Int]], Int)] = [(a, 1)]
    assert_eq(count_opt_map(xs), 1)
}

// RIDE (was the Result-Map carve-out; br e3js70): a top-level Result tuple element with a
// DIRECT Map inner now RIDES the tid path. tc_tid_tuple_elem_encodable's TK_RESULT arm no
// longer rejects a direct Map side — the construction/param/reassignment speller spells the
// Result-Map carrier STRUCTURED (Result_Map_str_int_int), byte-identical to the tid path,
// so the value-constructed tuple (Tuple2_Result_Map_str_int_int_int) matches the mono param.
// The Gen1==Gen2 fixed point (task regen) is the byte-equality tripwire.
test "(Result[Map[Str, Int], Int], Int) rides the tid path" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let r: Result[Map[Str, Int], Int] = Ok(m)
    let p = (r, 7)
    assert_eq(take_int(p), 99)
}

// RIDE: Map in the ERR position — exercises the second Result inner (t.inner2 == Map).
test "(Result[Int, Map[Str, Int]], Int) rides the tid path" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let r: Result[Int, Map[Str, Int]] = Err(m)
    let p = (r, 7)
    assert_eq(take_int(p), 99)
}

// RIDE: Option[Result[Map,_]] — a Result-direct-Map wrapped in an Option. Now CONSTRUCTABLE
// (br e3js70) and rides via the predicate's TK_RESULT branch (the Option arm delegates to
// it). On clean main this failed to compile: the Some constructor's annotation-consult
// structured the Option's inner Result (Option_Result_Map_str_int_int) while the Result
// value carrier stayed bare blink_Result_map_int → C "incompatible types". The structured
// construction speller reconciles both sides to Result_Map_str_int_int.
test "(Option[Result[Map[Str, Int], Int]], Int) rides the tid path" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let r: Result[Map[Str, Int], Int] = Ok(m)
    let o: Option[Result[Map[Str, Int], Int]] = Some(r)
    let p = (o, 7)
    assert_eq(take_int(p), 99)
}

// RIDE (was the struct-inner deferral guard; br 6q5mz2): a same-module struct inner
// (Option[AnaqcPoint]) now RIDES. tc_tid_inner_tag_faithful gained a TK_STRUCT arm — when
// the element rides, emit_tuple_lit spells the inner via tc_tid_inner_tag (the SAME speller
// the tid path uses; both bottom out at c_type_tag_for_struct for a non-generic struct),
// the equivalence br 637sy9 proved for a DIRECT struct tuple element. The Gen1==Gen2 fixed
// point is the byte-equality tripwire.
test "(Option[AnaqcPoint], Int) rides the tid path" {
    let pt = AnaqcPoint { x: 1, y: 2 }
    let p = (Some(pt), 7)
    assert_eq(take_int(p), 99)
}
