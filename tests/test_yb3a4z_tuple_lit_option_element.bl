// Bug yb3a4z: an Option/Result element in a tuple LITERAL match scrutinee emitted
// `void _tup_0 = ...` because the TupleLit fast-path only captured a carrier when
// the element type was CT_STRUCT. An Option element is CT_OPTION, so elem_sname
// was "", the temp was declared `void`, and the binder re-emitted `void`. Fix
// captures Option/Result element carriers in the fast-path.

test "tuple literal with Option element binds and reads inner" {
    let r = match (Some(5), 9) {
        (a, n) => {
            let inner = match a { Some(v) => v None => 0 }
            inner + n
        }
    }
    assert_eq(r, 14)
}

test "tuple literal with Result element binds and reads inner" {
    let r = match (Ok(3), 9) {
        (a, n) => {
            let inner = match a { Ok(v) => v Err(e) => 0 }
            inner + n
        }
    }
    assert_eq(r, 12)
}
