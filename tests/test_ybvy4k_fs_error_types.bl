// ybvy4k (fs-result-surface Stage 1): FsError and FsOp are the typed error
// surface for `fs.*`, reached through `import std.fs` — the sibling of NetError
// reached through `import std.net`. They are NOT prelude (a prior draft made them
// so, which leaked std.errno into every program); a caller must import std.fs.
// std.errno is imported here only to build the transparent `code` field.
import std.fs.{FsError, FsOp}
import std.errno.{Errno}
import compile_test_helpers

test "FsOp resolves through import std.fs" {
    let op: FsOp = FsOp.ListDir
    match op {
        FsOp.ListDir => assert(true)
        _ => assert(false)
    }
}

test "FsError is a struct with op/path/code, reached through import std.fs" {
    let e = FsError { op: FsOp.Read, path: "/etc/app.toml", code: Errno(2) }
    assert_eq(e.path, "/etc/app.toml")
    match e.op {
        FsOp.Read => assert(true)
        _ => assert(false)
    }
    match e.code {
        Errno(rc) => assert_eq(rc, 2)
    }
}

test "FsError rides a Result err arm" {
    let r: Result[Str, FsError] = Err(FsError { op: FsOp.Write, path: "/x", code: Errno(13) })
    match r {
        Ok(_) => assert(false)
        Err(e) => {
            assert_eq(e.path, "/x")
            match e.code {
                Errno(rc) => assert_eq(rc, 13)
            }
        }
    }
}

// The regression guard for the whole "not prelude" decision: without `import
// std.fs`, FsError does not leak into scope — naming it is an unknown type.
test "FsError is unavailable without import std.fs" {
    let src = "fn take(e: FsError) \{ let _ = e }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "fserror_unimported")
    compile_test_helpers.expect_contains(out, "unknown type 'FsError'", "fserror_unimported")
}
