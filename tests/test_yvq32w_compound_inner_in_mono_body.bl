// yvq32w: compound-inner (Map / List[Map]) type annotations declared INSIDE a
// monomorphized generic fn body must resolve their typevar inners against the
// concrete args. These exercise the def-side sites that read cg_mono_concrete_args
// (set_list_elem_map_ann codegen_stmt.bl:146-147 / emit_let_binding's Map branch
// :3053-3054). The migration onto cg_mono_arg_tids must stay observationally a
// no-op — every instance below keeps running with the correct key/value types.
//
// jsmbtn's premise ("non-Int MAP-VALUE typevar collapses to Int") is STALE — the
// tid-primary migration fixed the scalar case (m3 below). jsmbtn's real, still-open
// half is the struct-instance value case: a generic caller building a struct literal
// whose field is its own unbound type param (Box{value: inner}, inner: T) never mints
// that literal's instance tid (tc_struct_lit_instance_tid, typecheck.bl:2418-2435) —
// tracked separately as br gq131c, deliberately excluded here so this stays a clean
// green byte-identity golden.

fn build_map[K, V](k: K, v: V) -> Map[K, V] {
    let mut m: Map[K, V] = Map()
    m.insert(k, v)
    m
}

fn build_list_of_maps[K, V](k: K, v: V) -> List[Map[K, V]] {
    let mut ls: List[Map[K, V]] = []
    let mut m: Map[K, V] = Map()
    m.insert(k, v)
    ls.push(m)
    ls
}

fn main() {
    // Str->Int map built inside the mono body (Int value = default, correct today).
    let m1 = build_map("a", 41)
    assert(m1.get("a").unwrap() == 41, "str->int map inner resolved")

    // Int-keyed Str->Int variant — distinct key mono, Int value.
    let m2 = build_map(9, 100)
    assert(m2.get(9).unwrap() == 100, "int->int map inner resolved")

    // Int-keyed Str-valued variant — scalar non-Int map VALUE (jsmbtn's scalar half).
    let m3 = build_map(7, "seven")
    assert(m3.get(7).unwrap() == "seven", "int->str map inner resolved")

    // List[Map[Str,Int]] declared inside the body (146/147 site).
    let lm = build_list_of_maps("x", 5)
    assert(lm.len() == 1, "list of maps length")
    assert(lm.get(0).unwrap().get("x").unwrap() == 5, "list-of-maps inner element usable")

    io.println("ok")
}
