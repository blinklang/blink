// br z89rdf — the fn-signature PARAM positions (format_params / format_impl_params) now spell
// their C type from the param node's tid, with the flat param_c_type kept only where the tid
// declines or erases to void. The census showed the tid AGREES byte-identically for every param
// shape (scalar, struct/enum instance, Option/Result, List/Map/Bytes, closure), so the flip is
// output-identical while making the tid authoritative.
//
// The RETURN positions follow the OTHER rule: void is a legal answer, so the tid leads whenever it
// spells anything (empty decline falls back to the flat carrier) — a void-return fn must still emit
// `void`. Today the return-annotation node carries no published tid, so the return flip is a
// decline-to-flat no-op; this pins that a void return keeps `void` and a struct-instance return
// keeps its mono carrier through the guarded path.

import compile_test_helpers
import std.io

fn sig_src() -> Str {
    #"import std.io

type Point { x: Int y: Int }

fn noop(a: Int) { let _ = a + 1 }
fn mk() -> Point { return Point { x: 1, y: 2 } }
fn addp(p: Point, k: Int) -> Int { return p.x + k }

fn main() {
    noop(3)
    let p = mk()
    io.println("{addp(p, 2)}")
}
"#
}

test "void-return fn still spells void through the guarded return position" {
    let c = compile_test_helpers.compile_and_emit_c(sig_src(), "z89rdf_void")
    if !c.contains("void blink_u_noop(") {
        io.println("FAIL: void-return fn not spelled void")
    }
    assert(c.contains("void blink_u_noop("))
}

test "struct-instance return spells its mono carrier" {
    let c = compile_test_helpers.compile_and_emit_c(sig_src(), "z89rdf_ret")
    assert(c.contains("blink_Point blink_u_mk("))
}

test "scalar and struct params spell from the tid" {
    let c = compile_test_helpers.compile_and_emit_c(sig_src(), "z89rdf_param")
    if !c.contains("int64_t a") {
        io.println("FAIL: Int param not spelled int64_t")
    }
    assert(c.contains("int64_t a"))
    assert(c.contains("blink_Point p, int64_t k"))
}

test "signature-position fn compiles and runs" {
    let r = compile_test_helpers.compile_and_run(sig_src(), "z89rdf_run")
    if r.exit_code != 0 {
        io.println("FAIL: did not run cleanly (exit {r.exit_code})")
        io.println(r.err_out)
    }
    assert(r.exit_code == 0)
    assert(r.out.contains("3"))
}
