import compile_test_helpers

// z9gkt3 / s663bm: a `.map` over a List[compound] whose closure returns a
// BY-VALUE struct or compound carrier (blink_Option_*, blink_Result_*) would hit
// the pre-existing int64-return-coercion miscompile (s663bm) — SysV returns the
// value in RAX:RDX and the int64 cast drops the payload eightbyte, segfaulting on
// read-back. z9gkt3 guards THIS case loudly (E0505) rather than extend the silent
// miscompile the removed guard used to cover. Remove this guard + test once
// s663bm boxes the by-value return.

test "map over List[Option[Int]] returning Option[Int] is guarded loudly" {
    let src = "fn main() \{ let c: List[Option[Int]] = [Some(1)]\n let r = c.map(fn(x: Option[Int]) -> Option[Int] \{ x }) }\n"
    compile_test_helpers.expect_compile_error(src, "z9gkt3_map_compound_ret", "E0505")
}

// A scalar closure return over the same compound source is fine (single-register
// return, no miscompile) — must NOT be caught by the guard.
test "map over List[Option[Int]] returning a scalar is allowed" {
    let src = "fn main() \{ let c: List[Option[Int]] = [Some(1)]\n let r = c.map(fn(x: Option[Int]) -> Bool \{ x.is_some() }) }\n"
    compile_test_helpers.expect_no_error(src, "z9gkt3_map_scalar_ret", "E0505")
}
