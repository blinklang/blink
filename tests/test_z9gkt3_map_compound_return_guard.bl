import compile_test_helpers

// A closure that returns an Option by value must hand back the whole value, payload
// included. Reading the payload back after .map proves no half of it was dropped.
test "map over List[Option[Int]] returning Option[Int] keeps the payload" {
    let src = "fn main() \{ let c: List[Option[Int]] = [Some(1)]\n let r = c.map(fn(x: Option[Int]) -> Option[Int] \{ x })\n io.println(\"\{r.get(0).unwrap().unwrap()}\") }\n"
    let r = compile_test_helpers.compile_and_run(src, "z9gkt3_map_compound_ret")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "1")
}

// A scalar closure output over the same compound source must not draw E0505 either.
test "map over List[Option[Int]] returning a scalar is allowed" {
    let src = "fn main() \{ let c: List[Option[Int]] = [Some(1)]\n let r = c.map(fn(x: Option[Int]) -> Bool \{ x.is_some() }) }\n"
    compile_test_helpers.expect_no_error(src, "z9gkt3_map_scalar_ret", "E0505")
}
