type SomeErr {
    code: Int
}

fn handle[E](r: Result[Int, E]) -> Int {
    match r {
        Ok(v) => { return v }
        Err(e) => { return e.code }
    }
}

fn handle_scalar[E](r: Result[Int, E]) -> Int {
    match r {
        Ok(v) => { return v }
        Err(e) => { return e }
    }
}

fn handle_ok[T](r: Result[T, Int]) -> T {
    match r {
        Ok(v) => { return v }
        Err(e) => { return e }
    }
}

test "infer E from Err(struct) arg" {
    let n = handle(Err(SomeErr { code: 3 }))
    assert_eq(n, 3)
}

test "infer E from Err(scalar) arg" {
    let n = handle_scalar(Err(99))
    assert_eq(n, 99)
}

test "ok-position inference still works" {
    let n = handle_ok(Ok(7))
    assert_eq(n, 7)
}
