// br zmc3q1 — a Map whose VALUE is a List[Struct] lost the list element's struct name.
// The map .get() CT_LIST arm propagated only the element KIND (get_map_value_list_elem),
// never the struct name, so the element read back as a scalar and any field access failed
// to C-compile ("request for member 'y' in something not a structure or union"). The arm
// now recovers the element struct from the authoritative map tid and stamps it on the
// returned Option, so the field access round-trips.

type Point {
    x: Int
    y: Int
}

test "a Map value that is a List[Struct] keeps its element struct name" {
    let mut m: Map[Str, List[Point]] = Map()
    m.insert("k", [Point { x: 3, y: 9 }])
    let got = m.get("k").unwrap().get(0).unwrap().y
    assert_eq(got, 9)
}

test "the same value list survives a second element and index" {
    let mut m: Map[Str, List[Point]] = Map()
    m.insert("k", [Point { x: 1, y: 2 }, Point { x: 5, y: 7 }])
    let p = m.get("k").unwrap().get(1).unwrap()
    assert_eq(p.x + p.y, 12)
}

fn mk_carrier() -> Result[Map[Str, List[Point]], Str] {
    let mut m: Map[Str, List[Point]] = Map()
    m.insert("k", [Point { x: 3, y: 9 }])
    Ok(m)
}

test "the same map bound through an annotated carrier payload keeps its element struct" {
    let m2: Map[Str, List[Point]] = mk_carrier().unwrap()
    let got = m2.get("k").unwrap().get(0).unwrap().y
    assert_eq(got, 9)
}
