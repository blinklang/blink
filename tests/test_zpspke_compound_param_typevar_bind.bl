import compile_test_helpers

// zpspke — a generic fn whose type parameter T appears only inside a COMPOUND
// param (List[T] / Option[T] / Map[K,V] / Result[T,E] / (T, ...)) must still
// bind T from the argument so the substituted return type is concrete. Before
// the fix, build_typevar_binds only bound T from a param that was ITSELF a bare
// typevar, so the return `(T, Int)` kept T un-substituted: a downstream
// mistype like `takes_str(t.0)` (t.0: Int) typechecked against a raw typevar
// (compatible with anything) and leaked to a raw gcc `const char*` vs int64_t
// error with NO Blink diagnostic. After the fix it must be rejected as E0300.
//
// NOTE: embedded `src` strings deliberately avoid string interpolation — an
// unescaped `{...}` inside these literals would be lexed as interpolation in
// THIS file. The mistype is forced via `let _ = takes_str(t.0)` instead.

// ── Negative: mistyped element must be rejected by typecheck (E0300) ──

test "List[T] param: mistyped tuple element rejected" {
    let src = "fn first[T](xs: List[T]) -> (T, Int) \{ (xs.get(0).unwrap(), 1) }\nfn takes_str(s: Str) -> Int \{ s.len() }\nfn main() \{ let t = first([1, 2, 3])\n let _ = takes_str(t.0) }\n"
    compile_test_helpers.expect_compile_error(src, "zpspke_list_mistype", "E0300")
}

test "Option[T] param: mistyped tuple element rejected" {
    let src = "fn peek[T](o: Option[T]) -> (T, Int) \{ (o.unwrap(), 1) }\nfn takes_str(s: Str) -> Int \{ s.len() }\nfn main() \{ let o: Option[Int] = Some(5)\n let t = peek(o)\n let _ = takes_str(t.0) }\n"
    compile_test_helpers.expect_compile_error(src, "zpspke_option_mistype", "E0300")
}

test "Result[T,E] param: mistyped tuple element rejected" {
    let src = "fn okval[T](r: Result[T, Str]) -> (T, Int) \{ (r.unwrap(), 1) }\nfn takes_str(s: Str) -> Int \{ s.len() }\nfn main() \{ let r: Result[Int, Str] = Ok(9)\n let t = okval(r)\n let _ = takes_str(t.0) }\n"
    compile_test_helpers.expect_compile_error(src, "zpspke_result_mistype", "E0300")
}

test "Map[K,V] param: mistyped tuple element rejected" {
    let src = "fn firstval[K, V](m: Map[K, V]) -> (V, Int) \{ (m.get(\"a\").unwrap(), 1) }\nfn takes_str(s: Str) -> Int \{ s.len() }\nfn main() \{ let m: Map[Str, Int] = Map()\n m.insert(\"a\", 41)\n let t = firstval(m)\n let _ = takes_str(t.0) }\n"
    compile_test_helpers.expect_compile_error(src, "zpspke_map_mistype", "E0300")
}

test "tuple param: mistyped tuple element rejected" {
    let src = "fn swap[A, B](p: (A, B)) -> (B, A) \{ (p.1, p.0) }\nfn takes_str(s: Str) -> Int \{ s.len() }\nfn main() \{ let p = (1, \"x\")\n let t = swap(p)\n let _ = takes_str(t.1) }\n"
    compile_test_helpers.expect_compile_error(src, "zpspke_tuple_mistype", "E0300")
}

// ── Positive: correctly-typed element still compiles + runs ──

fn first_list[T](xs: List[T]) -> (T, Int) { (xs.get(0).unwrap(), 1) }
fn peek_option[T](o: Option[T]) -> (T, Int) { (o.unwrap(), 1) }
fn okval_result[T](r: Result[T, Str]) -> (T, Int) { (r.unwrap(), 1) }
fn firstval_map[K, V](m: Map[K, V]) -> (V, Int) { (m.get("a").unwrap(), 1) }

fn takes_int(x: Int) -> Int { x + 100 }

test "List[T] param binds T=Int; correct use compiles + runs" {
    let t = first_list([1, 2, 3])
    assert_eq(takes_int(t.0), 101)
    assert_eq(t.1, 1)
}

test "Option[T] param binds T=Int; correct use compiles + runs" {
    let o: Option[Int] = Some(5)
    let t = peek_option(o)
    assert_eq(takes_int(t.0), 105)
}

test "Result[T,E] param binds T=Int; correct use compiles + runs" {
    let r: Result[Int, Str] = Ok(9)
    let t = okval_result(r)
    assert_eq(takes_int(t.0), 109)
}

test "Map[K,V] param binds V=Int; correct use compiles + runs" {
    let m: Map[Str, Int] = Map()
    m.insert("a", 41)
    let t = firstval_map(m)
    assert_eq(takes_int(t.0), 141)
}
