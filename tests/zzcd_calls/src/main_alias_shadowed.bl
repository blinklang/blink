// Loads the file whose alias binds `zzcd_tag` to another module's `zzcd_pick`, alongside the
// module that declares a real `zzcd_tag`. The alias belongs to the file that wrote it, so the
// real declaration of the same spelling is not what that file's bare call means.

import zzcd_user.{zzcd_via_alias}
import zzcd_tagger

fn main() {
    let v = zzcd_via_alias()
    let w = zzcd_tagger.zzcd_tag(5)
    assert(v == 1)
    assert(w == 15)
}
