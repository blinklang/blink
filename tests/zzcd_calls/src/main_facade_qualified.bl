// Calls through the facade module's own qualifier. zzcd_facade declares nothing itself; it
// re-exports zzcd_tagger with `pub import`, so the qualifier names a module that forwards
// the declaration rather than the module that owns it.

import zzcd_facade

fn main() {
    let v = zzcd_facade.zzcd_tag(5)
    assert(v == 15)
}
