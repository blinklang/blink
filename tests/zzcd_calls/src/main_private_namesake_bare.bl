// The same private declaration, called bare. The reader owns this name, so nothing about
// another module's namesake reaches it.

import zzcd_vault.{zzcd_vault_size}

fn zzcd_stash(x: Int) -> Int {
    x + 2
}

fn main() {
    let mine = zzcd_stash(1)
    assert(mine == 3)
    assert(zzcd_vault_size() == 8)
}
