// Calls another module's private function by qualifier while declaring its own private
// function of the same bare name. The reader's own declaration says nothing about what the
// qualified module exports, so the call is still reaching a name it cannot see.

import zzcd_vault

fn zzcd_stash(x: Int) -> Int {
    x + 2
}

fn main() {
    let mine = zzcd_stash(1)
    let theirs = zzcd_vault.zzcd_stash(1)
    assert(mine == 3)
    assert(theirs == 2)
}
