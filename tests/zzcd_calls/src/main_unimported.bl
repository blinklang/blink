// Uses a pub name from zzcd_left without importing zzcd_left. The module is loaded, because
// zzcd_user imports it, but this file never asked for the name.

import zzcd_user.{zzcd_via_alias}

fn main() {
    let v = zzcd_left_tag()
    let w = zzcd_via_alias()
    assert(v == 11)
    assert(w == 1)
}
