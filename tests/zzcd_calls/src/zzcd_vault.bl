// Declares a name without pub, so no import can select it and no qualifier can reach it.
// A reader that happens to declare the same spelling privately must not gain access to
// this one.

let zzcd_vault_code: Int = 7

fn zzcd_stash(x: Int) -> Int {
    x + 1
}

pub fn zzcd_vault_size() -> Int {
    zzcd_stash(zzcd_vault_code)
}
