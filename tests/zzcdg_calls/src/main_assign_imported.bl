// The same assignment, with zzcdg_count properly selected. Tightening the unimported case
// must not reject a file whose import list names what it assigns.

import zzcdg_owner.{zzcdg_count, zzcdg_read}

fn bump() {
    zzcdg_count = zzcdg_read() + 1
}

fn main() {
    bump()
    assert(zzcdg_count == 1)
}
