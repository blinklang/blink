// Assigns to zzcdg_count without importing it. A read of an unimported name is already
// rejected with ImportNotSelected; a plain `=` assignment to the same unimported name must
// be rejected the same way, not silently accepted and left to fail later in codegen.

import zzcdg_owner.{zzcdg_read}

fn bump() {
    zzcdg_count = zzcdg_read() + 1
}

fn main() {
    bump()
}
