import zzds_lib.{Q, Cell, Shade}

fn show(r: Result[Q, Str]) -> Str {
    match r {
        Ok(q) => "{q.v}"
        Err(e) => "err {e}"
    }
}

fn main() {
    let f = Q.from_json
    io.println(show(f(#"{"v":5}"#)))
    let h: fn(Str) -> Result[Cell[Int], Str] = Cell.from_json
    match h(#"{"v":7}"#) {
        Ok(c) => io.println("{c.v}")
        Err(e) => io.println("err {e}")
    }
    let g = Shade.from_str
    match g("dark") {
        Some(s) => io.println(s.to_str())
        None => io.println("none")
    }
}
