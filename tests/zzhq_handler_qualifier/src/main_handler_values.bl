import zzhq_log
import zzhq_log.{Log}

type H = Handler[zzhq_log.Log]

type Box {
    h: Handler[zzhq_log.Log]
}

fn by_param(h: Handler[zzhq_log.Log]) {
    with h { zzhq_log.note() }
}

fn by_alias(h: H) {
    with h { zzhq_log.note() }
}

fn by_projection(h: Handler[Log.Emit]) {
    with h { log.log("emit") }
}

fn main() {
    let h: Handler[zzhq_log.Log] = handler Log { fn log(msg: Str) { io.println("v:{msg}") } }
    by_param(h)
    by_alias(h)
    let b = Box { h: handler zzhq_log.Log { fn log(msg: Str) { io.println("b:{msg}") } } }
    by_param(b.h)
    by_projection(h)
}
