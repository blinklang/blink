import zzin_lib.{ZiOther, ZiE}

type ZiW {
    w: Int
}

impl ZiOther for ZiW {
    fn zo(self) -> Int {
        self.w
    }
}

type ZiH {
    p: zzin_lib.ZiPt
}

fn zi_bounded[U: zzin_lib.ZiOther](u: U) -> Int {
    u.zo()
}

fn zi_round(p: zzin_lib.ZiPt) -> zzin_lib.ZiPt {
    p
}

fn main() {
    let h = ZiH { p: zi_round(zzin_lib.ZiPt { v: 1 }) }
    let e = ZiE.ZiA
    assert(h.p.v + zi_bounded(ZiW { w: 2 }) + zzin_lib.zi_f() == 4)
    assert(e == ZiE.ZiA)
}
