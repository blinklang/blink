// Declares private items whose names zzpn_open declares pub. No other module may reach these.

fn zzpn_f() -> Int {
    1
}

type ZzpnT {
    x: Int
}

let ZZPN_K: Int = 3

trait ZzpnTr {
    fn zzpn_m(self) -> Int
}

fn zzpn_only() -> Int {
    7
}

pub fn zzpn_hidden_sum() -> Int {
    let t = ZzpnT { x: zzpn_f() }
    t.x + ZZPN_K + zzpn_only()
}
