// One spelling in two namespaces of one module, pub in one and private in the other. A type and
// a value do not collide (§2.12.1), and a variant lives in its enum's namespace, so the private
// one must not hide the pub one, nor the pub one open the private one.

pub type ZzpnKind {
    ZzpnKA
    ZzpnKB
}

type ZzpnWrap {
    ZzpnKind(ZzpnKind)
    ZzpnWNone
}

pub fn zzpn_kind_a() -> ZzpnKind {
    ZzpnKind.ZzpnKA
}

pub type ZzpnTv {
    x: Int
}

let ZzpnTv: Int = 4

type ZzpnPt {
    x: Int
}

pub let ZzpnPt: Int = 2

pub type ZzpnExpr {
    ZzpnNeg
    ZzpnPos
}

type ZzpnNeg {
    ZzpnN1
    ZzpnN2
}

pub fn zzpn_spaces_sum() -> Int {
    let _w = ZzpnWrap.ZzpnWNone
    let _n = ZzpnNeg.ZzpnN1
    let p = ZzpnPt { x: ZzpnTv }
    p.x
}
