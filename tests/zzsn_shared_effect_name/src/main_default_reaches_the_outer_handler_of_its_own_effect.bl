import zzsn_lib

effect Note {
    effect Put {
        fn put(s: Str) -> Str
    }
}

fn mine() -> Str ! Note { note.put("m") }

fn main() {
    let a = with handler zzsn_lib.Note {
        fn put(x: Int) -> Int { x + 1 }
    } {
        with handler zzsn_lib.Note {
            fn put(x: Int) -> Int { default.put(x) * 2 }
        } {
            zzsn_lib.go()
        }
    }
    let b = with handler Note {
        fn put(s: Str) -> Str { "{s}!" }
    } {
        with handler Note {
            fn put(s: Str) -> Str { "<{default.put(s)}>" }
        } {
            mine()
        }
    }
    io.println("{a} {b}")
}
