import zzsn_dice

@handle_all
effect Dice {
    effect Toss {
        fn toss() -> Int
        fn coin() -> Bool
    }
}

fn main() {
    let a = with handler zzsn_dice.DICE {
        fn roll(sides: Int) -> Int { sides }
    } {
        zzsn_dice.go()
    }
    let b = with handler Dice.Toss {
        fn toss() -> Int { 1 }
    } {
        dice.toss()
    }
    io.println("{a} {b}")
}
