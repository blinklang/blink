import zzsn_mark

@handle_all
effect Mark {
    effect Put {
        fn put(x: Int) -> Int
        fn coin() -> Bool
    }
}

fn mine() -> Int ! Mark { mark.put(2) }

fn main() {
    let a = with handler zzsn_mark.Mark {
        fn put(x: Int) -> Int { x + 1 }
    } {
        zzsn_mark.go()
    }
    let b = with handler Mark {
        fn put(x: Int) -> Int { x * 3 }
    } {
        mine()
    }
    io.println("{a} {b}")
}
