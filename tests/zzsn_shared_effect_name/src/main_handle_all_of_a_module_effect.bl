import zzsn_mark_all

effect Mark {
    effect Put {
        fn put(x: Int) -> Int
    }
}

fn mine() -> Int ! Mark { mark.put(2) }

fn main() {
    let a = with handler zzsn_mark_all.Mark {
        fn put(x: Int) -> Int { x + 1 }
    } {
        zzsn_mark_all.go()
    }
    let b = with handler Mark {
        fn put(x: Int) -> Int { x * 3 }
    } {
        mine()
    }
    io.println("{a} {b}")
}
