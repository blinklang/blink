import zzsn_arena

effect Arena {
    effect Grow {
        fn grow() -> Int
    }
}

fn g() -> Int ! Arena {
    arena.grow()
}

fn main() ! IO {
    let v = with handler Arena {
        fn grow() -> Int { 41 }
    } {
        g()
    }
    let w = with handler zzsn_arena.Arena {
        fn grow() -> Int { 7 }
    } {
        zzsn_arena.lg()
    }
    io.println("{v} {w}")
}
