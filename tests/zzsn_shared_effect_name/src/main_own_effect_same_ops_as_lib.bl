import zzsn_lib

effect Note {
    effect Put {
        fn put(x: Int) -> Int
    }
}

fn mine() -> Int ! Note { note.put(10) }

fn main() {
    let a = with handler zzsn_lib.Note {
        fn put(x: Int) -> Int { x + 1 }
    } {
        zzsn_lib.go()
    }
    let b = with handler Note {
        fn put(x: Int) -> Int { x * 2 }
    } {
        mine()
    }
    io.println("{a} {b}")
}
