import zzsn_lib
import zzsn_twin

fn both() -> Int ! zzsn_lib.Note, zzsn_twin.Note { zzsn_lib.go() + zzsn_twin.go() }

fn main() {
    let n = with handler zzsn_lib.Note {
        fn put(x: Int) -> Int { x + 1 }
    } {
        with handler zzsn_twin.Note {
            fn put(x: Int) -> Int { x * 10 }
        } {
            both()
        }
    }
    io.println("{n}")
}
