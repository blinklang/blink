import zzsn_lib.{Note as LibNote}

effect Note {
    effect Put {
        fn put(s: Str) -> Str
    }
}

fn lib_put() -> Int ! LibNote.Put { note.put(2) }

fn own_put() -> Str ! Note.Put { note.put("o") }

fn main() {
    let a = with handler LibNote.Put {
        fn put(x: Int) -> Int { x + 1 }
    } {
        lib_put()
    }
    let b = with handler Note.Put {
        fn put(s: Str) -> Str { "{s}?" }
    } {
        own_put()
    }
    io.println("{a} {b}")
}
