import zzsn_lib
import zzsn_twin

fn main() {
    let a = with handler zzsn_lib.Note {
        fn put(x: Int) -> Int { x + 1 }
    } {
        zzsn_lib.go_twice()
    }
    let b = with handler zzsn_twin.Note {
        fn put(x: Int) -> Int { x * 10 }
    } {
        zzsn_twin.go()
    }
    io.println("{a} {b}")
}
