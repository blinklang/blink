// Declares a second `ZzstCrate_make` over zzst_shared's type. Loaded together with
// zzst_shared by main_static_collision.bl, this makes two declarations of the identical
// mangled spelling coexist in the same program's declaration set.
import zzst_shared.{ZzstCrate}

pub fn ZzstCrate_make(n: Int) -> ZzstCrate {
    ZzstCrate { v: n + 100 }
}
