// One of two independent modules that each declare a type of the same name with an
// associated function of the same name. Neither program below loads both modules at once;
// each proves a qualified static call lowers to this file's own declaration, not a
// coincidentally-shared spelling.

pub type ZzstBox { v: Int }

pub fn ZzstBox_make(n: Int) -> ZzstBox {
    ZzstBox { v: n }
}
