// A type one module declares and a second module (zzst_extra) adds another associated
// function of the same name to. Both are loaded into the one program below, so the
// program's declaration set genuinely holds two functions named `ZzstCrate_make` — the
// scenario a program-wide name scan cannot tell apart, but the call's own recorded
// declaration can.

pub type ZzstCrate { v: Int }

pub fn ZzstCrate_make(n: Int) -> ZzstCrate {
    ZzstCrate { v: n }
}
