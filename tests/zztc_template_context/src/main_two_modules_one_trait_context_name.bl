import zztc_lib
import zztc_other

fn ident[C](t: Template[C]) -> Template[C] { t }

fn mine(t: Template[zztc_lib.Mark]) -> Int { zztc_lib.marked(ident(t)) }

fn theirs(t: Template[zztc_other.Mark]) -> Int { zztc_other.marked(ident(t)) }

fn main() {
    io.println("{mine("a {1}")} {theirs(zztc_other.mk_marked("b {1} {2}"))}")
}
