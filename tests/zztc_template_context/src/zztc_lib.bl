pub effect Log { }

pub effect Q { }

pub type E[T] {
    L(T)
    N
}

pub fn cnt(e: E[Template[Log]]) -> Int {
    match e {
        E.L(t) => t.count()
        E.N => 0
    }
}

pub fn holes(t: Template[Log]) -> Int { t.count() }

pub trait Mark { fn m(self) -> Int }

pub fn marked(t: Template[Mark]) -> Int { t.count() }
