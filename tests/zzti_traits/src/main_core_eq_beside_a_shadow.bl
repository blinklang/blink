// This file imports the module that shadows Eq without selecting the shadow, so `Eq` here is
// the prelude's. The program holds a derived core eq and the shadow's eq on zzti_sim's
// Ticker, and both link.

import zzti_sim

type Q {
    n: Int
}

impl Eq for Q {
    fn eq(self, other: Q) -> Bool {
        self.n == other.n
    }
}

@derive(Eq)
type P {
    x: Int
}

fn main() {
    let q = Q { n: zzti_sim.tick() } == Q { n: 1 }
    let p = P { x: 1 } == P { x: 1 }
    let ticker = zzti_sim.ticker_is(zzti_sim.Ticker { n: 3 }, 3)
    let bound = zzti_sim.through_bound(zzti_sim.Ticker { n: 4 }, 4)
    io.println("{q} {p} {ticker} {bound}")
}
