// zzti_shown's W holds the module's own Display and, from zzti_shown_core, the prelude
// Display. Interpolation reaches the prelude's; the module's own call reaches its own.

import zzti_shown
import zzti_shown_core

fn main() {
    let w = zzti_shown.W { n: 7 }
    io.println("{zzti_shown.shown(w)} {zzti_shown_core.rendered(w)} {w}")
}
