// zzti_tk's Ticker holds the module's own Eq and, from zzti_tk_core, the prelude Eq. Each
// call reaches the impl of the trait its own scope names, and both impls link.

import zzti_tk
import zzti_tk_core

fn core_bound[T: Eq](a: T, b: T) -> Bool {
    a == b
}

fn main() {
    let t = zzti_tk.Ticker { n: 2 }
    let u = zzti_tk.Ticker { n: 2 }
    let named = zzti_tk.is_n(t, 2)
    let named_no = zzti_tk.is_n(t, 3)
    let bound = zzti_tk.through_bound(t, 2)
    let bound_named = zzti_tk.through_bound_named(t, 3)
    let same = zzti_tk_core.same(t, u)
    let differ = zzti_tk_core.differ(t, u)
    let here = t == u
    let cb = core_bound(t, zzti_tk.Ticker { n: 5 })
    io.println("{named} {named_no} {bound} {bound_named} {same} {differ} {here} {cb}")
}
