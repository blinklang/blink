// Two modules each declare a trait `Tr` with its own contract. This file selects zzti_a's,
// so its impl answers to that contract, and zzti_b's impls keep theirs.

import zzti_a.{Tr}
import zzti_b

type L {
    k: Int
}

impl Tr for L {
    fn t(self) -> Int {
        self.k * 10
    }
}

fn main() {
    let a = zzti_a.a_t(zzti_a.A { v: 1 })
    let b = zzti_b.b_t(zzti_b.B { s: "b" })
    let l = zzti_a.via_a(L { k: 2 })
    let vb = zzti_b.via_b(zzti_b.B { s: "c" })
    io.println("{a} {b} {l} {vb}")
}
