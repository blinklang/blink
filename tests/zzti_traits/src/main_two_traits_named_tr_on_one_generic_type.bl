// zzti_bx's Bx[T] holds zzti_a's Tr and zzti_b's Tr through per-instance impls. Each module's
// qualified call and bound reaches the impl of its own trait.

import zzti_a
import zzti_b
import zzti_bx
import zzti_bxb

fn main() {
    let b = zzti_bx.Bx { v: "s", k: 4 }
    io.println("{zzti_bx.named(b)} {zzti_bxb.named(b)} {zzti_a.via_a(b)} {zzti_b.via_b(b)}")
}
