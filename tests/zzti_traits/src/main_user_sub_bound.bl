type Pt {
    v: Int
}

trait Base {
    fn base(self) -> Int
}

trait Sub: Base {
    fn one(self) -> Int
}

impl Base for Pt {
    fn base(self) -> Int {
        self.v
    }
}

impl Sub for Pt {
    fn one(self) -> Int {
        1
    }
}

fn f[U: Sub](u: U) -> Int {
    u.base() + u.one()
}

fn main() {
    io.println("{f(Pt { v: 1 })}")
}
