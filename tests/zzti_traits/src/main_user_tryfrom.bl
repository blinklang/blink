trait TryFrom[T] {
    fn try_from(value: T) -> Result[Self, Str]
}

type W {
    n: Int
}

impl TryFrom[Int] for W {
    fn try_from(value: Int) -> Result[W, Str] {
        if value < 0 { return Err("negative") }
        Ok(W { n: value })
    }
}

fn main() {
    match W.try_from(3) {
        Ok(w) => io.println("{w.n}")
        Err(e) => io.println(e)
    }
}
