// A second trait spelled `Tr`, with a contract unlike the one in zzti_a.

pub trait Tr {
    fn t(self, k: Int) -> Str
}

pub type B {
    s: Str
}

impl Tr for B {
    fn t(self, k: Int) -> Str {
        "{self.s}{k}"
    }
}

pub fn b_t(x: B) -> Str {
    x.t(2)
}

pub fn via_b[T: Tr](x: T) -> Str {
    x.t(3)
}
