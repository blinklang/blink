// A generic type with an impl of zzti_a's Tr. zzti_bxb gives it zzti_b's Tr as well, so each
// instance holds two per-instance impls of one spelling.

import zzti_a.{Tr}

pub type Bx[T] {
    v: T
    k: Int
}

impl[T] Tr for Bx[T] {
    fn t(self) -> Int {
        self.k * 10
    }
}

pub fn named[T](b: Bx[T]) -> Int {
    Tr.t(b)
}
