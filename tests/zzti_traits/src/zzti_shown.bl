// A trait spelled like the prelude's Display, whose `fmt` has another contract.
// zzti_shown_core gives W the prelude Display too, so the calls here name their trait.

pub trait Display {
    fn fmt(self) -> Str
}

pub type W {
    n: Int
}

impl Display for W {
    fn fmt(self) -> Str {
        "local{self.n}"
    }
}

pub fn shown(w: W) -> Str {
    Display.fmt(w)
}
