// Declares a trait named like the prelude's Eq, with another contract. The shadow has
// module scope: it changes what `Eq` means here and in a file that selects it, nowhere else.

pub trait Eq {
    fn eq(self, other: Int) -> Bool
}

pub type Ticker {
    n: Int
}

impl Eq for Ticker {
    fn eq(self, other: Int) -> Bool {
        self.n == other
    }
}

pub fn tick() -> Int {
    1
}

pub fn ticker_is(t: Ticker, n: Int) -> Bool {
    t.eq(n)
}

pub fn through_bound[T: Eq](a: T, n: Int) -> Bool {
    a.eq(n)
}
