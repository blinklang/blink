// Declares a trait named like the prelude's Eq. zzti_tk_core gives Ticker the prelude Eq as
// well, and both impls live in this package, so an unqualified `.eq` on Ticker has two
// owners here (sections/03_types.md §3.6 *Impl visibility*). The calls name their trait.

pub trait Eq {
    fn eq(self, other: Int) -> Bool
}

pub type Ticker {
    n: Int
}

impl Eq for Ticker {
    fn eq(self, other: Int) -> Bool {
        self.n == other
    }
}

pub fn is_n(t: Ticker, n: Int) -> Bool {
    Eq.eq(t, n)
}

pub fn through_bound[T: Eq](a: T, n: Int) -> Bool {
    a.eq(n)
}

pub fn through_bound_named[T: Eq](a: T, n: Int) -> Bool {
    Eq.eq(a, n)
}
