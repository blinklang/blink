// Gives zzti_tk's Ticker the prelude Eq. This module does not select the shadow, so `Eq`
// here is the prelude's.

import zzti_tk.{Ticker}

impl Eq for Ticker {
    fn eq(self, other: Ticker) -> Bool {
        self.n == other.n
    }
}

pub fn same(a: Ticker, b: Ticker) -> Bool {
    a == b
}

pub fn differ(a: Ticker, b: Ticker) -> Bool {
    a != b
}
