// Traits a bound in another file names, selected or qualified.

pub type ZPt {
    v: Int
}

pub trait ZTr[T] {
    fn zput(self, x: T) -> T
}

pub trait ZOther {
    fn zo(self) -> Int
}

trait ZHidden {
    fn zh(self) -> Int
}

impl ZTr[Int] for ZPt {
    fn zput(self, x: Int) -> Int {
        x + self.v
    }
}

impl ZOther for ZPt {
    fn zo(self) -> Int {
        self.v
    }
}

impl ZHidden for ZPt {
    fn zh(self) -> Int {
        self.v
    }
}
